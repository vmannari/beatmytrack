# Godot caches are reproducible; .uid files belong in Git.
.godot/
**/.godot/
build/
temp/
.tools/
__pycache__/
*.pyc
# Python tooling also runs from the repository root.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/
.coverage
.coverage.*
htmlcov/
/dist/
.DS_Store
Thumbs.db
# Machine paths and signing material never belong in source control.
local.config.ps1
/.aws/
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.apk
*.aab
export_credentials.cfg
**/android/build/
game/android/.build_version

# Local IDE state and temporary audit/editor files.
/.idea/
/temp_typography_audit.txt
/tmp/
/game/tmp/
# Reproducible Godot test profiles and shader caches within evidence captures.
/docs/evidence/**/profiles/
/docs/evidence/**/appdata/
/docs/evidence/**/shader_cache/
/docs/evidence/**/disposable-storage/
# Temporary repositories used to verify evidence checkpoints.
/docs/evidence/garage-carousel-delivery-2026-10-28/checkpoint/
/docs/evidence/guardrail-ends-2026-10-27/patch-check/
/docs/evidence/object-properties-2026-10-28/checkpoint/
/game/platform/windows/~*.TMP
# Godot hot-reload copies of native extensions (keep shipped DLLs tracked).
/game/platform/**/~*.dll
/game/platform/**/~*.TMP

# Local recording caches produced by the download-cost tests.
/game/recordings-track_*/

# Oversized duplicate checkpoints; source changes and validation reports are tracked.
/docs/evidence/compact-kits-quality-2026-10-14/task-only.patch
/docs/evidence/garage-tuning-layout-2026-10-14/task-only.patch
