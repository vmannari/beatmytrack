{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Music: Open workbench",
      "problemMatcher": [],
      "command": "python",
      "type": "process",
      "args": [
        "tools/music_generator/serve.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "MRT2: Verify GPU",
      "problemMatcher": [],
      "command": "wsl",
      "type": "process",
      "args": [
        "-d",
        "Ubuntu",
        "--",
        "bash",
        "tools/music_generator/scripts/run_from_windows_repo.sh",
        "python",
        "tools/music_generator/verify.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "MRT2: Smoke test",
      "problemMatcher": [],
      "command": "wsl",
      "type": "process",
      "args": [
        "-d",
        "Ubuntu",
        "--",
        "bash",
        "tools/music_generator/scripts/run_from_windows_repo.sh",
        "python",
        "tools/music_generator/generate.py",
        "concepts",
        "--config",
        "tools/music_generator/configs/smoke.yaml",
        "--limit",
        "1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "MRT2: Generate concepts",
      "problemMatcher": [],
      "command": "wsl",
      "type": "process",
      "args": [
        "-d",
        "Ubuntu",
        "--",
        "bash",
        "tools/music_generator/scripts/run_from_windows_repo.sh",
        "python",
        "tools/music_generator/generate.py",
        "concepts",
        "--config",
        "tools/music_generator/configs/concepts.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "MRT2: Generate Grass pair",
      "problemMatcher": [],
      "command": "wsl",
      "type": "process",
      "args": [
        "-d",
        "Ubuntu",
        "--",
        "bash",
        "tools/music_generator/scripts/run_from_windows_repo.sh",
        "python",
        "tools/music_generator/generate.py",
        "layers",
        "--config",
        "tools/music_generator/configs/grass.yaml",
        "--names",
        "00_focus",
        "05_breakthrough",
        "--variants",
        "1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "MRT2: Prepare audition pair",
      "problemMatcher": [],
      "command": "wsl",
      "type": "process",
      "args": [
        "-d",
        "Ubuntu",
        "--",
        "bash",
        "tools/music_generator/scripts/run_from_windows_repo.sh",
        "python",
        "tools/music_generator/prepare.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "MRT2: Test toolkit",
      "problemMatcher": [],
      "command": "wsl",
      "type": "process",
      "args": [
        "-d",
        "Ubuntu",
        "--",
        "bash",
        "tools/music_generator/scripts/run_from_windows_repo.sh",
        "python",
        "tools/music_generator/test_toolkit.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
