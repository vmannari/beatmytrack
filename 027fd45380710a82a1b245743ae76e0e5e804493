"""Use the repository entry point; restore only our exact generated metadata."""
from pathlib import Path
import json
import os
import re
import subprocess
import time

root=Path.cwd()
out=root/'docs/evidence/editor-ux-improvements-2026-10-28'
profile=root/'build/editor-ux-improvements-2026-10-28/preferred-check-profile'
profile.mkdir(parents=True,exist_ok=True)
paths=['game/project.godot','game/core/build_identity.gd']
before={p:(root/p).read_bytes() for p in paths}
for p,data in before.items(): (out/('preferred-before-'+Path(p).name)).write_bytes(data)
env={k:v for k,v in os.environ.items() if not k.startswith('BMT_')}
env.update(APPDATA=str(profile),LOCALAPPDATA=str(profile))
command=['powershell.exe','-NoProfile','-ExecutionPolicy','Bypass','-File','scripts/dev.ps1','-Action','CheckScript',
         '-ScriptPath','res://core/app.gd','-CommandTimeoutSeconds','60']
start=time.monotonic()
with (out/'preferred-check.log').open('wb') as log:
    child=subprocess.Popen(command,env=env,stdout=log,stderr=subprocess.STDOUT)
    code=child.wait(timeout=100)
receipt_path=root/f'build/logs/CheckScript-{child.pid}/client-build-identity.json'
restored={}
if receipt_path.exists():
    receipt=json.loads(receipt_path.read_text(encoding='utf-8-sig'))
    (out/'preferred-generated-identity.json').write_text(json.dumps(receipt,indent=2))
    expected_identity=('extends RefCounted\n# Generated by scripts/dev.ps1. Never recompute during gameplay.\n'
                       f'const ID: String = "{receipt["build_id"]}"\n'
                       f'const SOURCE_SHA256: String = "{receipt["source_sha256"]}"\n'
                       f'const GARAGE_PREVIEW_SHA256: String = "{receipt["garage_preview_sha256"]}"\n').encode()
    expected_project=re.sub(rb'(?m)^config/version="[^"\r\n]*"\r?$',
                            ('config/version="'+receipt['build_id']+'"').encode(),before[paths[0]])
    expected={paths[0]:expected_project,paths[1]:expected_identity}
    for p in paths:
        current=(root/p).read_bytes()
        (out/('preferred-generated-'+Path(p).name)).write_bytes(current)
        restored[p]=current==expected[p]
        if restored[p]: (root/p).write_bytes(before[p])
result={'command':command,'exit':code,'seconds':round(time.monotonic()-start,3),'metadata_restored_if_owned':restored}
(out/'preferred-check.json').write_text(json.dumps(result,indent=2))
print(json.dumps(result))
