{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Track of the Day verified daily standings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["day","starts_at","ends_at","server_now","version_id","vehicle_id","board_id","tick_rate","population","items","player","next_cursor"],
  "properties": {
    "day": {"type":"integer","minimum":0},
    "starts_at": {"type":"integer","minimum":0},
    "ends_at": {"type":"integer","minimum":0},
    "server_now": {"type":"integer","minimum":0},
    "version_id": {"type":"string","format":"uuid"},
    "vehicle_id": {"type":"string","maxLength":80},
    "board_id": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "tick_rate": {"const":120},
    "population": {"type":"integer","minimum":0},
    "items": {"type":"array","maxItems":50,"items":{"$ref":"#/$defs/standing"}},
    "player": {"oneOf":[{"type":"null"},{"$ref":"#/$defs/standing"}]},
    "next_cursor": {"type":["string","null"],"maxLength":400}
  },
  "$defs": {
    "standing": {
      "type":"object","additionalProperties":false,
      "required":["player_id","display_name","country_code","time_ticks","achieved_at","rank","gap_ticks"],
      "properties": {
        "player_id":{"type":"string","format":"uuid"},
        "display_name":{"type":"string","maxLength":40},
        "country_code":{"type":"string","maxLength":2},
        "time_ticks":{"type":"integer","minimum":1,"maximum":216000},
        "achieved_at":{"type":"integer","minimum":0},
        "rank":{"type":"integer","minimum":1},
        "gap_ticks":{"type":"integer","minimum":0,"maximum":216000}
      }
    }
  }
}
