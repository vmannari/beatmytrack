+			if not _notice_route_bins.has(key): _notice_route_bins[key] = PackedInt32Array()
+			_notice_route_bins[key].append(index)
+
+func _prepare_notice_layers(track: NativeTrack) -> void:
+	if track.creator_bridges.is_empty(): return
