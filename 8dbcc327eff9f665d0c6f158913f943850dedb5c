+		var b: Vector2 = track.route[(i+1)%track.route.size()]
+		var steps: int = maxi(1,ceili(a.distance_to(b)/0.25))
+		_notice_layer_offsets[i*2] = _notice_route_layers.size()
+		_notice_layer_offsets[i*2+1] = steps
