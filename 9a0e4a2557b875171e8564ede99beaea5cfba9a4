+"""
+    DOC.write_bytes(document.encode("utf-8"))
+    assert all((ROOT/s).exists() for t in TASKS for s in t["sources"])
+    checks={"task_count":len(TASKS),"category_count":len(AREAS),"area_task_counts":dict(counts),
