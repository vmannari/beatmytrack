{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Race comparison manifest v1 \u2014 proposal",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "track_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "physics_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "rules_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "laps": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
    },
    "direction": {
      "enum": [
        "forward",
        "reverse"
      ]
    },
    "start_mode": {
      "enum": [
        "standing"
      ]
    },
    "competition": {
      "enum": [
        "class",
        "spec"
      ]
    },
    "constraint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "assist_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  },
  "required": [
    "schema_version",
    "track_hash",
    "physics_version",
    "rules_version",
    "laps",
    "direction",
    "start_mode",
    "competition",
    "constraint_id",
    "assist_policy"
  ]
}
