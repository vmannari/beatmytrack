{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Run submission envelope v1 \u2014 proposal",
  "description": "Claims only. The server recomputes legality, time, reward eligibility and grants.",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "ticket": {
      "type": "string",
      "minLength": 32,
      "maxLength": 4096
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replay_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replay_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "client_build": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "client_time_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "input_ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 72000
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "ticket",
    "manifest_hash",
    "replay_hash",
    "replay_bytes",
    "client_build",
    "client_time_ms",
    "input_ticks"
  ]
}
