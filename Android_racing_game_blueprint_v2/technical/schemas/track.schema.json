{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Track geometry contract v1 \u2014 proposal",
  "description": "Structural bounds only; a separate validator must prove closed directed connectivity, legal surface and completion. Metadata such as title is outside this geometry hash.",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kit_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "point": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x_mm": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "y_mm": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "required": [
            "x_mm",
            "y_mm"
          ]
        },
        "heading_mdeg": {
          "type": "integer",
          "minimum": 0,
          "maximum": 359999
        }
      },
      "required": [
        "point",
        "heading_mdeg"
      ]
    },
    "road": {
      "type": "array",
      "minItems": 4,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "piece": {
            "enum": [
              "straight",
              "bend_left",
              "bend_right",
              "hairpin",
              "chicane"
            ]
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x_mm": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y_mm": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": [
              "x_mm",
              "y_mm"
            ]
          },
          "heading_mdeg": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359999
          }
        },
        "required": [
          "id",
          "piece",
          "origin",
          "heading_mdeg"
        ]
      }
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "a": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x_mm": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y_mm": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": [
              "x_mm",
              "y_mm"
            ]
          },
          "b": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x_mm": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y_mm": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": [
              "x_mm",
              "y_mm"
            ]
          }
        },
        "required": [
          "id",
          "a",
          "b"
        ]
      }
    },
    "decorations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x_mm": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y_mm": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": [
              "x_mm",
              "y_mm"
            ]
          },
          "heading_mdeg": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359999
          }
        },
        "required": [
          "asset_id",
          "origin",
          "heading_mdeg"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kit_version",
    "spawn",
    "road",
    "gates",
    "decorations"
  ]
}
