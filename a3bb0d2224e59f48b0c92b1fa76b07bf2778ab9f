+import subprocess
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/backend-resource-optimisation-2026-10-28'
+candidate=json.loads((WORK/'candidate.json').read_text())
+SCOPE=WORK/('checkpoint-'+secrets.token_hex(4));BEFORE=SCOPE/'before';AFTER=SCOPE/'after'
+BEFORE.mkdir(parents=True);AFTER.mkdir()
+existing=['backend/bmt_backend/'+n for n in candidate['changed']]+[
+    'backend/tests/test_automatic_test_drivers.py','backend/tests/test_predictive_drivers.py']
