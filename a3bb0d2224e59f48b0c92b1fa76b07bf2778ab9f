+    'backend/tests/test_resource_native.py','docs/BACKEND_RESOURCE_OPTIMISATION_2026_10_28.md']
+helpers=[p.relative_to(ROOT).as_posix() for p in WORK.glob('*.py')]
+shared=['AGENTS.md','DEVELOPMENT_STATUS.md','docs/PHASE_0_PLAN.md','backend/deploy/README.md']
+for name in existing:
+    target=BEFORE/name;target.parent.mkdir(parents=True,exist_ok=True)
