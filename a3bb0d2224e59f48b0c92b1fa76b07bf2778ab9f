+
+from sqlalchemy import text
+
+from bmt_backend.app import create_admin_app
+from bmt_backend.discovery_projection import health
+from bmt_backend.operations import competition_health
+
+app=create_admin_app()
+try:
+    for _ in range(12):
+        value=competition_health(app);discovery=health(app.state.session_factory)
+        if value['status']=='ready' and value['available_workers']>=1 and all(x['ready'] for x in discovery['partitions']):break
+        time.sleep(2)
+    else:raise RuntimeError('Matching worker/discovery readiness unavailable')
