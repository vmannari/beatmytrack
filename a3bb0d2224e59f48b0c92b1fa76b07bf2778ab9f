+"""Own a local PostgreSQL fixture and exact-image worker profile container."""
+import json
+import secrets
+import subprocess
+import time
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/backend-resource-optimisation-2026-10-28'
+cfg=json.loads((ROOT/'.tools/gcp-staging/config.json').read_text(encoding='utf-8-sig'));docker=cfg['docker']
+image=json.loads((WORK/'candidate.json').read_text())['image']
+label=secrets.token_hex(16);network='bmt-opt-profile-'+label[:8];pg=network+'-pg';profile=network+'-profile';password=secrets.token_hex(24)
+
+
+def unix(p):return '/mnt/'+p.drive[0].lower()+p.as_posix()[2:]
+def call(args,timeout=60):
+ r=subprocess.run([*docker,*args],capture_output=True,text=True,encoding='utf-8',errors='replace',check=False,timeout=timeout)
+ if r.returncode:
+  (WORK/'last-command.private.log').write_text(r.stdout+r.stderr,encoding='utf-8')
+  raise RuntimeError('Owned diagnostic command failed; inspect private log')
+ return r.stdout
+
+
+envfile=WORK/'profile.private.env';pgenv=WORK/'pg.private.env'
+envfile.write_text('BMT_ENVIRONMENT=test\nBMT_DATABASE_URL=postgresql+psycopg://postgres:'+password+'@'+pg+':5432/profile\nBMT_WORKLOAD_ROLE=worker\nBMT_TELEMETRY_ENABLED=true\nBMT_TEST_DRIVERS_ENABLED=false\nBMT_OBJECT_BACKEND=local\nBMT_OBJECT_DIR=/tmp/objects\nBMT_DATABASE_POOL_SIZE=2\nBMT_DATABASE_POOL_OVERFLOW=0\nBMT_PERSISTENT_VERIFIER=true\n',encoding='utf-8')
+pgenv.write_text('POSTGRES_PASSWORD='+password+'\nPOSTGRES_DB=profile\n',encoding='utf-8')
+envfile.write_text(envfile.read_text()+'BMT_PROFILE_IMAGE='+image+'\n',encoding='utf-8')
+pg_created=False;profile_created=False
+call(['network','create','--internal','--label','bmt.cpu-mem='+label,network])
+try:
+ call(['run','-d','--rm','--pull=never','--name',pg,'--network',network,'--label','bmt.cpu-mem='+label,
+       '--cpus=1','--memory=768m','--env-file',unix(pgenv),'--tmpfs','/var/lib/postgresql/data:rw,size=512m','postgres:17-bookworm']);pg_created=True
+ for _ in range(60):
+  r=subprocess.run([*docker,'exec',pg,'pg_isready','-U','postgres'],capture_output=True,check=False,timeout=10)
+  if r.returncode==0:break
+  time.sleep(.25)
+ else:raise RuntimeError('Synthetic PostgreSQL did not become ready')
+ call(['run','-d','--name',profile,'--pull=never','--network',network,'--label','bmt.cpu-mem='+label,
+       '--cpus=1','--memory=1536m','--pids-limit=256','--env-file',unix(envfile),
+       '--mount','type=bind,src='+unix(WORK/'container_profile.py')+',dst=/analysis/container_profile.py,readonly',
+       '--mount','type=bind,src='+unix(OUT)+',dst=/results','--entrypoint','python',image,'/analysis/container_profile.py']);profile_created=True
+ (WORK/'local-state.json').write_text(json.dumps({'container':profile,'network':network,'label':label},indent=2))
+ started=time.monotonic()
+ while time.monotonic()-started<600:
+  details=json.loads(call(['inspect',profile]))[0]
+  if not details['State']['Running']:
+   output=call(['logs',profile]);(OUT/'local-profile-console.log').write_text(output,encoding='utf-8')
+   assert details['State']['ExitCode']==0 and not details['State'].get('OOMKilled'),'Local diagnostic failed; inspect owned fixture logs'
+   print(output[-4500:],flush=True);break
+  if (OUT/'local-process-profile.json').exists() and not (WORK/'intermediate-notified').exists():
+   (WORK/'intermediate-notified').touch();print('Intermediate idle and generation process accounting is available.',flush=True)
+  time.sleep(3)
+ else:raise RuntimeError('Owned profile exceeded 600-second diagnostic bound')
+finally:
+ for name,created in ((profile,profile_created),(pg,pg_created)):
+  if not created:continue
+  actual=json.loads(call(['inspect',name]))[0]
+  assert actual['Config']['Labels'].get('bmt.cpu-mem')==label
+  call(['rm','--force',name])
+ actual=json.loads(call(['network','inspect',network]))[0]
+ assert actual['Labels'].get('bmt.cpu-mem')==label
+ call(['network','rm',network])
+ (OUT/'local-fixture-cleanup.json').write_text(json.dumps({'owned_container_and_database_removed':True,
+       'network_removed':True,'live_database_used':False,'live_services_changed':False,'cpu_limit':1,'diagnostic_memory_mib':1536},indent=2))
diff --git a/build/backend-resource-optimisation-2026-10-28/release.py b/build/backend-resource-optimisation-2026-10-28/release.py
