+        'filter':'metric.type="run.googleapis.com/'+suffix+'" AND resource.labels.location="'+d.REGION+'"',
+        'interval.startTime':utc(start),'interval.endTime':utc(at),'pageSize':1000})
+    assert not result.get('nextPageToken'),'Observation exceeded bounded metric page'
+    series=[]
+    for row in result.get('timeSeries',[]):
+        labels=row.get('resource',{}).get('labels',{})
+        workload=labels.get('worker_pool_name') or labels.get('service_name')
+        if workload not in [d.BASE+'-'+suffix for suffix in ('api','studio','worker')]:continue
+        points=[]
+        for p in row.get('points',[]):
+            value=p['value'];distribution=value.get('distributionValue')
+            raw=(distribution.get('mean') if int(distribution.get('count',0)) else None) if distribution else value.get('doubleValue',value.get('int64Value'))
+            if raw is not None:points.append({'at':p['interval']['endTime'],'value':float(raw)})
+        values=[p['value'] for p in points]
+        if values:
+            settled=[p['value'] for p in points if datetime.fromisoformat(p['at'].replace('Z','+00:00')).timestamp()>=settled_after]
+            series.append({'workload':workload,'revision':labels.get('revision_name'),'points':points,
+                'samples':len(values),'min':min(values),'median':statistics.median(values),'max':max(values),
+                'after_initial_two_minutes':{'cutoff':utc(settled_after),'samples':len(settled),
+                    'min':min(settled) if settled else None,'median':statistics.median(settled) if settled else None,
+                    'max':max(settled) if settled else None}})
+    return suffix,series
+with ThreadPoolExecutor(max_workers=4) as pool:
+    metrics=dict(pool.map(metric,['container/cpu/utilizations','container/memory/utilizations','container/memory/usage','container/instance_count']))
+revision=d.state['worker_revision'].rsplit('/',1)[-1]
+counts=Counter();entries=0;complete=False;params={'resourceNames':['projects/'+d.PROJECT],
+    'filter':'resource.type="cloud_run_worker_pool" AND resource.labels.worker_pool_name="'+d.BASE+'-worker" AND resource.labels.revision_name="'+revision+'" AND timestamp>="'+d.state['worker_updated_at']+'"',
+    'orderBy':'timestamp desc','pageSize':1000}
+allowed={'driver_generation_started','driver_generation_stopped','driver_generation_timed_out','worker_iteration_failed',
+    'verification_complete','verification_failed','worker_started','worker_draining','worker_stopped','service_child_exited'}
+for _ in range(5):
+    page=call('POST','https://logging.googleapis.com/v2/entries:list',json=params)
+    for row in page.get('entries',[]):
+        entries+=1;event=row.get('jsonPayload',{}).get('event')
+        counts[event if event in allowed else 'other']+=1
+    if not page.get('nextPageToken'):complete=True;break
+    params['pageToken']=page['nextPageToken']
+result={'captured_at':utc(at),'metric_window_start':utc(start),'worker_updated_at':d.state['worker_updated_at'],
+    'new_worker_revision':revision,'metrics':metrics,'new_revision_logs':{'entries':entries,'complete':complete,'counts':dict(counts)},
+    'scope':'Read-only Monitoring samples and bounded allowlisted event totals; distribution values are sampled means, not exact instantaneous peaks; short post-rollout window is not sustained-load acceptance.'}
+(OUT/'live-after.json').write_text(json.dumps(result,indent=2))
+print(json.dumps({'captured_at':result['captured_at'],'new_worker_metrics':{k:[{x:y for x,y in row.items() if x!='points'} for row in v if row['revision']==revision] for k,v in metrics.items()},'logs':result['new_revision_logs']}))
