+++ b/build/backend-resource-optimisation-2026-10-28/release.py
@@ -0,0 +1,236 @@
+"""Image-only rollout of local-generation and backend resource optimisations."""
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+import secrets
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+import requests
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/backend-resource-optimisation-2026-10-28'
+spec=importlib.util.spec_from_file_location('cloud_release',ROOT/'build/studio-usage-deploy-2026-10-27/deploy.py')
+d=importlib.util.module_from_spec(spec);spec.loader.exec_module(d)
+d.WORK=WORK;d.OUT=OUT;d.STATE=WORK/'release.private.json'
+d.state=json.loads(d.STATE.read_text()) if d.STATE.exists() else {}
+TASK='backend-resource-optimisation-20261028'
+candidate=json.loads((WORK/'candidate.json').read_text())
+KINDS={'api':'services','studio':'services','worker':'workerPools'}
+
+
+def unchanged_template(old,new,kind):
+    a=copy.deepcopy(d.definition(old));b=copy.deepcopy(d.definition(new))
+    if kind=='jobs':
+        ca=a['template']['template']['containers'];cb=b['template']['template']['containers']
+    else:ca=a['template']['containers'];cb=b['template']['containers']
+    cb[0]['image']=ca[0]['image']
+    for x in (a,b):
+        x['template'].pop('revision',None)
+        if kind=='services':x.pop('traffic',None)
+        if kind=='workerPools':x.pop('instanceSplits',None)
+    assert a==b,'Workload settings changed beyond the image'
+
+
+def guarded():
+    assert not d.LOCK.exists() or json.loads(d.LOCK.read_text()).get('task')==TASK,'Another rollout owns the update lock'
+    for suffix,kind in KINDS.items():
+        live=d.describe(d.BASE+'-'+suffix,kind)
+        allowed={d.state['before'][suffix]['template']['containers'][0]['image'],d.state.get('image')}
+        assert live['template']['containers'][0]['image'] in allowed,'Concurrent workload image update'
+        unchanged_template(d.state['before'][suffix],live,kind)
+
+
+d.guarded=guarded
+
+
+def prepare():
+    assert not d.state,'Prepared release already exists'
+    before={suffix:d.describe(d.BASE+'-'+suffix,kind) for suffix,kind in KINDS.items()}
+    assert before['studio']['template']['containers'][0]['image']==candidate['parent']
+    jobs=d.api('GET',f'https://run.googleapis.com/v2/projects/{d.PROJECT}/locations/{d.REGION}/jobs')
+    owned=[r for r in jobs.get('jobs',[]) if r['name'].rsplit('/',1)[-1].startswith(d.BASE+'-')]
+    assert len(owned)==7 and not jobs.get('nextPageToken'),'Unexpected job inventory'
+    policies={suffix:json.loads(d.gc('run','services','get-iam-policy',d.BASE+'-'+suffix,'--region='+d.REGION,
+        '--format=json',label='before-'+suffix+'-iam')) for suffix in ('api','studio')}
+    d.state.update(before=before,jobs_before=owned,policies=policies,local_image=candidate['image'],
+        package_hashes=candidate['hashes'],connections_prepared=True,prepared_at=datetime.now(timezone.utc).isoformat(),
+        service_account=before['studio']['template']['serviceAccount'])
+    d.save();guarded()
+    receipt={'services':{k:{'revision':v.get('latestReadyRevision'),'image':v['template']['containers'][0]['image'],
+        'limits':v['template']['containers'][0].get('resources',{}).get('limits'),'scaling':v.get('scaling')} for k,v in before.items()},
+        'existing_jobs':len(owned),'schema_change':False,'read_only':True}
+    d.write(OUT/'release-preflight.json',receipt);print(json.dumps(receipt),flush=True)
+
+
+def push():
+    proof=json.loads((WORK/'exact-tests-passed.json').read_text())
+    assert proof['passed'] and proof['hashes']==candidate['hashes'],'Final immutable candidate needs exact-image validation'
+    guarded();d.state.update(tests_passed=True,local_image=candidate['image'],package_hashes=candidate['hashes']);d.save()
+    if not d.LOCK.exists():
+        with d.LOCK.open('x') as f:json.dump({'task':TASK,'image':candidate['image']},f)
+    registry=d.REGION+'-docker.pkg.dev'
+    remote=registry+'/'+d.PROJECT+'/'+d.BASE+'-images/backend:resources-20261028-'+hashlib.sha256(json.dumps(candidate['hashes'],sort_keys=True).encode()).hexdigest()[:12]
+    auth=WORK/'docker-auth.private';auth.mkdir(exist_ok=True)
+    try:
+        token=d.gc('auth','print-access-token',label='push-token')
+        d.command([*d.DOCKER,'--config',d.unix(auth),'login',registry,'--username=oauth2accesstoken','--password-stdin'],
+            'registry-login',input_data=token)
+        d.command([*d.DOCKER,'tag',candidate['image'],remote],'remote-tag')
+        d.command([*d.DOCKER,'--config',d.unix(auth),'push',remote],'push',timeout=600)
+        digests=json.loads(d.command([*d.DOCKER,'image','inspect',remote,'--format={{json .RepoDigests}}'],'image-digest'))
+        d.state['image']=next(v for v in digests if v.startswith(registry+'/'+d.PROJECT+'/'));d.save()
+    finally:
+        credential=auth/'config.json'
+        if credential.exists():assert credential.resolve().parent==auth.resolve();credential.unlink()
+    print(json.dumps({'image':d.state['image']}),flush=True)
+
+
+def api_checks(url):
+    result={}
+    for path,code in [('/health',200),('/ready',200),('/v1/bootstrap',200),('/v1/dev/test-drivers/batches/active',401),
+        ('/v1/admin/usage-costs',404),('/admin',404)]:
+        response=requests.get(url+path,verify=str(d.CA),timeout=(5,55),allow_redirects=False)
+        assert response.status_code==code,(path,response.status_code)
+        if path=='/v1/bootstrap':assert response.json()['test_driver_local_runner_version']==1
+        result[path]=code
+    return result
+
+
+def canary():
+    guarded();assert d.state.get('image')
+    for suffix in ('api','studio'):
+        if suffix in d.state.get('canaries',{}):continue
+        tag='bro-'+suffix+'-'+secrets.token_hex(3)
+        d.gc('run','services','update',d.BASE+'-'+suffix,'--region='+d.REGION,'--image='+d.state['image'],
+            '--no-traffic','--tag='+tag,'--format=json',label=suffix+'-canary',timeout=300)
+        live=d.describe(d.BASE+'-'+suffix);unchanged_template(d.state['before'][suffix],live,'services')
+        route=next(r for r in live['trafficStatuses'] if r.get('tag')==tag)
+        checks=api_checks(route['uri']) if suffix=='api' else d.private_checks(route['uri'])
+        assert any(r.get('percent')==100 and r['revision'].rsplit('/',1)[-1]==d.state['before'][suffix]['latestReadyRevision'].rsplit('/',1)[-1] for r in live['trafficStatuses'])
+        d.state.setdefault('canaries',{})[suffix]={'tag':tag,'url':route['uri'],'revision':route['revision']};d.save()
+        d.write(OUT/(suffix+'-canary-checks.json'),checks)
+        print(json.dumps({'canary':suffix,'revision':route['revision'],'checks':checks,'normal_traffic_preserved':True}),flush=True)
+
+
+def rollout():
+    guarded();assert set(d.state.get('canaries',{}))=={'api','studio'} and d.state.get('tests_passed')
+    if not d.LOCK.exists():
+        with d.LOCK.open('x') as f:json.dump({'task':TASK,'image':d.state['image']},f)
+    # Stop automatic generation first. Normal Cloud Run revision replacement
+    # uses the worker's existing drain/cleanup fences; instance/resources stay.
+    d.gc('run','worker-pools','update',d.BASE+'-worker','--region='+d.REGION,'--image='+d.state['image'],
+        '--format=json',label='worker-rollout',timeout=300)
+    worker=d.describe(d.BASE+'-worker','workerPools');unchanged_template(d.state['before']['worker'],worker,'workerPools')
+    assert d.state['before']['worker']['instanceSplits']==[{'type':'INSTANCE_SPLIT_ALLOCATION_TYPE_LATEST','percent':100}]
+    d.gc('run','worker-pools','update-instance-split',d.BASE+'-worker','--region='+d.REGION,
+        '--to-latest','--format=json',label='worker-promotion',timeout=180)
+    d.state['worker_revision']=worker['latestReadyRevision'];d.state['worker_updated_at']=datetime.now(timezone.utc).isoformat();d.save()
+    for job in d.state['jobs_before']:
+        name=job['name'].rsplit('/',1)[-1]
+        current=d.describe(name,'jobs');unchanged_template(job,current,'jobs')
+        assert current['template']['template']['containers'][0]['image'] in (job['template']['template']['containers'][0]['image'],d.state['image'])
+        d.gc('run','jobs','update',name,'--region='+d.REGION,'--image='+d.state['image'],'--format=json',label=name+'-update',timeout=180)
+        unchanged_template(job,d.describe(name,'jobs'),'jobs')
+    for suffix,route in d.state['canaries'].items():
+        checks=api_checks(route['url']) if suffix=='api' else d.private_checks(route['url'])
+        d.gc('run','services','update-traffic',d.BASE+'-'+suffix,'--region='+d.REGION,
+            '--to-revisions='+route['revision'].rsplit('/',1)[-1]+'=100','--format=json',label=suffix+'-promote',timeout=180)
+        d.write(OUT/(suffix+'-promotion-checks.json'),checks)
+    d.state['promoted']=True;d.save();print(json.dumps({'promoted':True,'worker_revision':d.state['worker_revision'],'jobs_updated':7}),flush=True)
+
+
+def probe():
+    assert d.state.get('promoted')
+    # Reuse the bounded, read-only aggregate probe already in the immutable
+    # Studio parent. It checks actual usage sources and SQL connection headroom.
+    route=d.state['canaries']['studio']
+    d.state.update(candidate_revision=route['revision'],candidate_url=route['url']);d.save()
+    d.probe()
+    health_probe()
+
+
+def health_probe(collect_only=False):
+    assert d.state.get('promoted')
+    current=d.describe(d.BASE+'-studio');template=current['template'];container=template['containers'][0]
+    name=d.state['health_probe_job'] if collect_only else d.BASE+'-opt-health-'+secrets.token_hex(3)
+    task={'serviceAccount':template['serviceAccount'],'timeout':'180s','maxRetries':0,
+        'containers':[{'image':d.state['image'],'command':['python'],'args':['-c',(WORK/'live_health_probe.py').read_text()],
+            'env':container.get('env',[]),'resources':{'limits':{'cpu':'1','memory':'768Mi'}},
+            **({'volumeMounts':container['volumeMounts']} if container.get('volumeMounts') else {})}],
+        **({'volumes':template['volumes']} if template.get('volumes') else {})}
+    resource={'labels':{'bmt-task':'backend-opt-health'},'template':{'taskCount':1,'parallelism':1,'template':task}}
+    if not collect_only:
+        operation=d.api('POST',f'https://run.googleapis.com/v2/projects/{d.PROJECT}/locations/{d.REGION}/jobs',params={'jobId':name},body=resource)
+        d.wait_operation(operation)
+        d.state['health_probe_job']=name;d.save()
+        d.gc('run','jobs','execute',name,'--region='+d.REGION,'--wait','--format=json',label='health-probe',timeout=240)
+    for _ in range(6):
+        entries=d.api('POST','https://logging.googleapis.com/v2/entries:list',body={'resourceNames':['projects/'+d.PROJECT],
+            'filter':'resource.type="cloud_run_job" AND resource.labels.job_name="'+name+'" AND jsonPayload.event="backend_resource_probe"',
+            'orderBy':'timestamp desc','pageSize':5})
+        if entries.get('entries'):break
+        time.sleep(2)
+    assert entries.get('entries'),'Health aggregate log is not visible yet'
+    value=entries['entries'][0]['jsonPayload'];assert value['status']=='ready' and value['available_workers']>=1
+    assert value['schema']=='0070_reward_cache_revisions' and value['partitions_ready']==16
+    d.write(OUT/'live-health.json',value)
+    actual=d.describe(name,'jobs');assert actual['labels']['bmt-task']=='backend-opt-health'
+    d.gc('run','jobs','delete',name,'--region='+d.REGION,label='health-probe-cleanup')
+    d.state['health_probe_removed']=True;d.save();print(json.dumps(value),flush=True)
+
+
+def finish():
+    assert d.state.get('promoted') and d.state.get('probe_passed') and d.state.get('health_probe_removed')
+    guarded()
+    for suffix,route in d.state['canaries'].items():
+        d.gc('run','services','update-traffic',d.BASE+'-'+suffix,'--region='+d.REGION,'--remove-tags='+route['tag'],
+            '--format=json',label=suffix+'-tag-cleanup')
+        live=d.describe(d.BASE+'-'+suffix);unchanged_template(d.state['before'][suffix],live,'services')
+        assert any(r.get('percent')==100 and r['revision'].rsplit('/',1)[-1]==route['revision'].rsplit('/',1)[-1] for r in live['trafficStatuses'])
+        policy=json.loads(d.gc('run','services','get-iam-policy',d.BASE+'-'+suffix,'--region='+d.REGION,'--format=json',label=suffix+'-final-iam'))
+        assert policy==d.state['policies'][suffix]
+    worker=d.describe(d.BASE+'-worker','workerPools');assert worker['template']['containers'][0]['image']==d.state['image']
+    assert worker['instanceSplits']==d.state['before']['worker']['instanceSplits']
+    assert sum(r.get('percent',0) for r in worker.get('instanceSplitStatuses',[]) if r.get('revision','').rsplit('/',1)[-1]==d.state['worker_revision'].rsplit('/',1)[-1])==100
+    for job in d.state['jobs_before']:
+        current=d.describe(job['name'].rsplit('/',1)[-1],'jobs');unchanged_template(job,current,'jobs')
+        assert current['template']['template']['containers'][0]['image']==d.state['image']
+    assert json.loads(d.LOCK.read_text())['task']==TASK;d.LOCK.unlink()
+    d.state.update(complete=True,finished_at=datetime.now(timezone.utc).isoformat());d.save()
+    receipt={'image':d.state['image'],'api_revision':d.state['canaries']['api']['revision'],
+        'studio_revision':d.state['canaries']['studio']['revision'],'worker_revision':d.state['worker_revision'],
+        'existing_jobs_updated':7,'settings_and_invoker_iam_preserved':True,'canonical_bundle_changed':False,'schema_changed':False,
+        'probe_removed':d.state.get('probe_job_removed'),'finished_at':d.state['finished_at']}
+    d.write(OUT/'deployment.json',receipt);print(json.dumps(receipt),flush=True)
+
+
+def staged_check():
+    assert not d.state.get('promoted')
+    guarded();checks={}
+    for suffix in ('api','studio'):
+        live=d.describe(d.BASE+'-'+suffix)
+        old=d.state['before'][suffix]['latestReadyRevision'].rsplit('/',1)[-1]
+        assert any(r.get('percent')==100 and r['revision'].rsplit('/',1)[-1]==old for r in live['trafficStatuses'])
+        policy=json.loads(d.gc('run','services','get-iam-policy',d.BASE+'-'+suffix,'--region='+d.REGION,'--format=json',label=suffix+'-staged-iam'))
