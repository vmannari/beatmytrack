extends SceneTree
## Actual graphics batches stay bounded and restore every scene node on return.
const PREPARATION = preload("res://race/world_render_preparation.gd")
var checks: int = 0
var failures: int = 0
class Stage extends Node3D:
	var camera: Camera3D

func _initialize() -> void: run.call_deferred()
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures += 1; print("FAIL: ",label)

func run() -> void:
	root.size = Vector2i(640,360)
	var stage := Stage.new(); root.add_child(stage)
	stage.camera = Camera3D.new(); stage.add_child(stage.camera)
	stage.camera.position = Vector3(0,20,0)
	stage.camera.rotation.x = -PI/2; stage.camera.projection = Camera3D.PROJECTION_ORTHOGONAL; stage.camera.size = 24
	var sun := DirectionalLight3D.new(); stage.add_child(sun); sun.rotation_degrees = Vector3(-60,-30,0)
	var meshes: Array[MeshInstance3D] = []
	for index: int in range(36):
		var node := MeshInstance3D.new(); node.mesh = BoxMesh.new()
		node.position = Vector3(index%9-4.0,0,index/9-1.5)
		var material := StandardMaterial3D.new(); material.albedo_color = Color.from_hsv(float(index)/36,0.7,0.8)
		if index/12 == 1: material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		if index/12 == 2: material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		node.material_override = material; stage.add_child(node); meshes.append(node)
	var keys: Dictionary = {}
	for node: MeshInstance3D in meshes: keys[PREPARATION._key(node)] = true
	check(keys.size() == 3,"fixture contains three distinct material programs")
	var before: PackedByteArray
	if DisplayServer.get_name() != "headless":
		for frame: int in range(4): await RenderingServer.frame_post_draw
		before = root.get_texture().get_image().get_data()
	var preparation = PREPARATION.new(); stage.add_child(preparation)
	preparation.isolate_batches = true
	PREPARATION.warmed.clear()
	preparation.hold(stage)
	check(meshes.all(func(node: MeshInstance3D) -> bool: return not node.visible),"all live geometry is held")
	var observed: Dictionary = {"draws":0,"maximum":0,"keys":{},"bounded":true}
	var draw: Callable = func() -> bool:
		observed.draws += 1
		var drawn: Dictionary = {}
		var count: int = 0
		for node: MeshInstance3D in meshes:
			if node.visible:
				count += 1; drawn[PREPARATION._key(node)] = true
		observed.maximum = maxi(observed.maximum,count)
		observed.bounded = observed.bounded and count <= 8 and drawn.size() <= 2
		for key: String in drawn: observed["keys"][key] = true
		if DisplayServer.get_name() == "headless": await process_frame
		else: await RenderingServer.frame_post_draw
		return true
	check(await preparation.prepare(draw,func() -> bool: return true),"practice preparation completes")
	check(observed.draws == 2 and observed.bounded and observed["keys"] == keys,"each actual program receives one bounded isolated draw")
	check(meshes.all(func(node: MeshInstance3D) -> bool: return node.visible and is_zero_approx(node.extra_cull_margin)),"every mesh and culling margin returns")
	if DisplayServer.get_name() != "headless":
		for frame: int in range(4): await RenderingServer.frame_post_draw
		check(before == root.get_texture().get_image().get_data(),"final rendered scene remains pixel exact")
	var draws_before: int = observed.draws
	preparation.hold(stage)
	check(preparation.pending.is_empty(),"a repeated practice has no unprepared programs")
	check(await preparation.prepare(draw,func() -> bool: return true),"warm practice restores the held scene")
	check(observed.draws == draws_before and meshes.all(func(node: MeshInstance3D) -> bool: return node.visible),"warm practice adds no submissions and restores every mesh")
	PREPARATION.warmed.clear()
	preparation.hold(stage)
	var gate: Dictionary = {"open":true}
	var cancelled_draw: Callable = func() -> bool:
		gate.open = false
		await process_frame
		return true
	check(not await preparation.prepare(cancelled_draw,func() -> bool: return gate.open),"cancellation aborts after the active batch")
	check(PREPARATION.warmed.is_empty(),"cancelled batches do not publish program readiness")
	preparation.queue_free(); await process_frame
	check(meshes.all(func(node: MeshInstance3D) -> bool: return node.visible and is_zero_approx(node.extra_cull_margin)),"cancelled teardown restores every held node and margin")
	stage.queue_free(); await process_frame
	print("PRACTICE_RENDER_BATCHES: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
