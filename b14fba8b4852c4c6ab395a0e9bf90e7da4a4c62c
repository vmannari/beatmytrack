+func wait_for_run(run_id: String, ticket_id: String) -> Dictionary:
+	var wait_ms: int = clampi(int(_capabilities.get("run_wait_ms",0)),0,2000)
+	if wait_ms == 0 or not signed_in(): return _failure("WAIT_UNAVAILABLE")
