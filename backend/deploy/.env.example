# Copy this to .env and set real values, or run python init_env.py.
# Passwords must be URL-safe; 32 random hex bytes are recommended.
COMPOSE_PROJECT_NAME=bmt
POSTGRES_PASSWORD=
BMT_DB_PASSWORD=
BMT_PUBLIC_BASE_URL=https://race.example.com
BMT_GOOGLE_CLIENT_IDS=
BMT_GOOGLE_WEB_CLIENT_ID=
BMT_PORT=8080
# Exact immediate DSM proxy IP(s) as seen inside the API container; NEVER '*'.
BMT_TRUSTED_PROXY_IPS=127.0.0.1
# SHA256 of vendor/godot, checked against the source provider independently.
GODOT_SHA256=
BMT_IMAGE=bmt-backend:local
# Tune only after measuring the deployed workload.
BMT_MAX_QUEUED_RUNS=128
BMT_WORKER_STALE_SECONDS=300
BMT_WORKER_SHUTDOWN_GRACE_SECONDS=5
BMT_READINESS_CACHE_SECONDS=2
BMT_READINESS_STORAGE_CACHE_SECONDS=30
BMT_READINESS_TIMEOUT_SECONDS=2
BMT_RETENTION_DAYS=90
# Cloud Run supplies ADC through its runtime service account; never ship key files.
# These are optional outside the generated GCP staging environment.
BMT_OBJECT_BACKEND=local
BMT_GCS_BUCKET=
BMT_GCS_PREFIX=bmt/v1
# Optional: BMT_BACKUP_MARKER_PATH must point to a read-only mounted COMPLETE
# marker from the latest successful backup. A Compose override must add the mount.

# Use legacy across a fleet until old API targets drain; then enable compact.
BMT_TRANSPORT_PROFILE=compact
BMT_REFRESH_RECOVERY_SECONDS=120
BMT_WORKER_CONTRACT_WAIT_SECONDS=7200

# First-party product observations are OFF until explicitly reviewed and enabled.
# Apply the same settings to the API and a separately configured product worker;
# this file does not create that service or activate live collection.
# Matching artifacts require schema 0025_product_telemetry after 0024_lap_personal_bests.
BMT_TELEMETRY_ENABLED=false
# Pending client receipt budget: 50..1000000. Server authority remains separate.
BMT_TELEMETRY_CLIENT_BACKLOG=50000
# Rows per separate projector pass: 1..1000; one DB connection/no pool overflow.
BMT_TELEMETRY_PROCESSOR_BATCH=500
# Raw client window 1..30 days; receipt cleanup also preserves a one-day retry grace.
BMT_TELEMETRY_RAW_DAYS=7
# Prepared reporting floor: 14..366 days; unavailable earlier coverage is not zero.
BMT_TELEMETRY_FACT_DAYS=180
# After approved migration/configuration:
# python -m bmt_backend.product_worker --once  (one bounded pass)
# python -m bmt_backend.product_worker         (separate long-running service)

# Optional bounded client counters; also requires BMT_TELEMETRY_ENABLED=true.
BMT_CLIENT_QUALITY_ENABLED=false
