{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private account deletion disclosure, read only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "player_id", "server_now", "publishing_slots", "coins", "banked_resumes", "cosmetic_unlocks", "pending_purchases", "ad_free", "ad_free_until", "ad_free_forever"],
  "properties": {
    "schema_version": {"const": 1},
    "player_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "server_now": {"type": "integer", "minimum": 1, "maximum": 253402300799},
    "publishing_slots": {"$ref": "#/$defs/balance"},
    "coins": {"$ref": "#/$defs/balance"},
    "banked_resumes": {"$ref": "#/$defs/balance"},
    "cosmetic_unlocks": {"$ref": "#/$defs/balance"},
    "pending_purchases": {"$ref": "#/$defs/balance"},
    "ad_free": {"type": "boolean"},
    "ad_free_until": {"type": "integer", "minimum": 0, "maximum": 253402300799},
    "ad_free_forever": {"type": "boolean"}
  },
  "$defs": {"balance": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}},
  "$comment": "ad_free must equal ad_free_forever OR ad_free_until > server_now. Shared by the authenticated GET /v1/privacy/deletion-preview and verified web-session response. Never grants resources or changes deletion retry authorization."
}
