{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bmt-admin-player-grant-v1",
  "title": "Audited player support grant",
  "description": "Owner-only additive grant for an active player. Preview binds player, product, quantity, time and state for five minutes. Product IDs must also occur in the server grant catalogue. Slots/resumes permit 1–1000; other products permit one. Command identity is permanent in admin_audit. Grants do not represent store payments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "product_id", "preview_at", "expected_hash", "reason", "acknowledged"],
  "properties": {
    "command_id": {"type": "string", "format": "uuid", "minLength": 36, "maxLength": 36},
    "product_id": {"type": "string", "minLength": 1, "maxLength": 100, "anyOf": [
      {"enum": ["publishing_slots", "resumes", "creator_slot_1", "creator_slots_5", "creator_slots_10", "ad_free_month", "ad_free_forever"]},
      {"pattern": "^(kit/compact/[a-z0-9_]+/[a-z0-9_]+|livery/[a-z0-9_]+)$"}
    ]},
    "quantity": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1},
    "preview_at": {"type": "integer", "minimum": 0},
    "expected_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 8, "maxLength": 500, "description": "Trimmed reason must have at least eight characters."},
    "acknowledged": {"const": true}
  },
  "allOf": [{"if": {"properties": {"product_id": {"not": {"enum": ["publishing_slots", "resumes"]}}}},
    "then": {"properties": {"quantity": {"const": 1}}}}]
}
