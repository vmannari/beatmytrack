{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Beat my track discovery page v2",
  "required": [
    "items",
    "total",
    "offset",
    "snapshot",
    "page_cursor",
    "next_cursor",
    "page_size",
    "expires_in"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "track_id",
          "version_id",
          "content_hash",
          "name",
          "creator",
          "points",
          "discovery_index",
          "verified_finishers"
        ],
        "properties": {
          "track_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "name": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "maxItems": 96,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "discovery_index": {
            "type": "integer",
            "minimum": 0
          },
          "verified_finishers": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Visible match count at snapshot creation; later hides leave stable unavailable positions."
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "page_cursor": {
      "type": "string",
      "maxLength": 400
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400
    },
    "page_size": {
      "const": 20
    },
    "expires_in": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800
    }
  }
}
