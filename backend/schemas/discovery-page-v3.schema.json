{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beat my track discovery page v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bmt-discovery-page-v3"
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "track_id",
          "version_id",
          "content_hash",
          "name",
          "creator",
          "verified_finishers"
        ],
        "properties": {
          "track_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "name": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "maxItems": 96,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "verified_finishers": {
            "type": "integer",
            "minimum": 0
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "anyOf": [
          {
            "required": [
              "points"
            ]
          },
          {
            "required": [
              "preview_hash"
            ]
          }
        ]
      }
    },
    "total": {
      "type": "null"
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400
    },
    "previous_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400
    },
    "page_cursor": {
      "type": "string",
      "maxLength": 400
    },
    "expires_in": {
      "type": "integer",
      "minimum": 0
    },
    "anchored": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "items",
    "total",
    "has_more",
    "next_cursor",
    "previous_cursor",
    "page_cursor",
    "expires_in",
    "anchored"
  ]
}
