{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Beat my track discovery query v2",
  "properties": {
    "search": {
      "type": "string",
      "maxLength": 80
    },
    "search_kind": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "theme": {
      "type": "string",
      "maxLength": 40
    },
    "minimum_rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "age_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 36500
    },
    "race_count": {
      "enum": [
        "any",
        "low",
        "medium",
        "high"
      ],
      "description": "Compatibility key for distinct verified-driver bands."
    },
    "race_history": {
      "enum": [
        "any",
        "raced",
        "unraced"
      ],
      "description": "Client-supplied local completed-race collection."
    },
    "ids": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 50000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "raced_ids": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "section": {
      "enum": [
        "all",
        "favorites",
        "saved"
      ]
    },
    "feed": {
      "enum": [
        "recommended",
        "new",
        "popular",
        "rated",
        "trending"
      ]
    },
    "sort": {
      "enum": [
        "recommended",
        "name",
        "creator",
        "score",
        "plays",
        "new"
      ]
    },
    "cursor": {
      "type": "string",
      "maxLength": 400
    },
    "offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "fresh": {
      "type": "boolean"
    },
    "exclude": {
      "type": "string",
      "maxLength": 80
    },
    "locate_version": {
      "type": "string",
      "maxLength": 36
    }
  }
}
