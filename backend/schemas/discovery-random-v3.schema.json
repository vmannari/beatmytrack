{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beat my track discovery random v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "items",
    "complete"
  ],
  "properties": {
    "schema": {
      "const": "bmt-discovery-random-v3"
    },
    "items": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "track_id",
          "version_id",
          "content_hash",
          "name",
          "creator",
          "points",
          "verified_finishers"
        ],
        "properties": {
          "track_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "name": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "maxItems": 96,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "verified_finishers": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "complete": {
      "const": true
    }
  }
}
