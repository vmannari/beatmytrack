{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beat my track entitlements v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["publishing_slots", "ad_free", "ad_free_until", "ad_free_forever", "free_rewinds", "max_rewinds_per_race", "purchase_simulation", "store_available", "server_now"],
  "properties": {
    "publishing_slots": {"type": "integer", "minimum": 0},
    "ad_free": {"type": "boolean"},
    "ad_free_until": {"type": "integer", "minimum": 0},
    "ad_free_forever": {"type": "boolean"},
    "free_rewinds": {"type": "boolean"},
    "max_rewinds_per_race": {"const": 3},
    "purchase_simulation": {"type": "boolean"},
    "store_available": {"const": false},
    "server_now": {"type": "integer", "minimum": 0}
  }
}
