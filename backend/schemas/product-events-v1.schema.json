                  },
                  "rejected_events": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "store_opened"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "offer_exposed"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "product_id": {
                    "enum": [
                      "ad_free_forever",
                      "ad_free_month",
                      "creator_slot_1",
                      "creator_slots_10",
                      "creator_slots_5"
                    ]
                  }
                },
                "required": [
                  "product_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "purchase_requested"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "product_id": {
                    "enum": [
                      "ad_free_forever",
                      "ad_free_month",
                      "creator_slot_1",
                      "creator_slots_10",
                      "creator_slots_5"
                    ]
                  }
                },
                "required": [
                  "product_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "quality_summary"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "device_class",
                  "scene",
                  "samples",
                  "slow",
                  "b0",
                  "b1",
                  "b2",
                  "b3",
                  "b4",
                  "b5",
                  "b6",
                  "b7"
                ],
                "properties": {
                  "device_class": {
                    "enum": [
                      "android_arm64",
                      "android_other",
                      "desktop",
                      "other"
                    ]
                  },
                  "scene": {
                    "enum": [
                      "race",
                      "menu",
                      "editor"
                    ]
                  },
                  "samples": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "slow": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "b0": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "b1": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "b2": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "b3": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "b4": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "b5": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "b6": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "b7": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "segment_summary"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "track_version_id",
                  "segment",
                  "cell_x",
                  "cell_y",
                  "samples",
                  "slow"
                ],
                "properties": {
                  "track_version_id": {
                    "$ref": "#/$defs/uuid"
                  },
                  "segment": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  },
                  "cell_x": {
                    "type": "integer",
                    "minimum": -5000,
                    "maximum": 5000
                  },
                  "cell_y": {
                    "type": "integer",
                    "minimum": -5000,
                    "maximum": 5000
                  },
                  "samples": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "slow": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "process_exit"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "device_class",
                  "exit_reason"
                ],
                "properties": {
                  "device_class": {
                    "enum": [
                      "android_arm64",
                      "android_other",
                      "desktop",
                      "other"
                    ]
                  },
                  "exit_reason": {
                    "enum": [
                      4,
                      5,
                      6
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "id",
        "status"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 49
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid4"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "accepted",
            "duplicate",
            "rejected"
          ]
        },
        "reason": {
          "enum": [
            "INVALID_EVENT",
            "CLOCK_OUTSIDE_WINDOW",
            "ID_CONFLICT"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    },
    "ackBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "events"
      ],
      "properties": {
        "schema": {
          "const": "bmt-product-acks-v1"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/acknowledgement"
          }
        }
      }
    }
  }
