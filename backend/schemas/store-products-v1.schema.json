{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beat my track store products v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["products", "store_available", "simulation_configured"],
  "properties": {
    "store_available": {"const": false},
    "simulation_configured": {"type": "boolean"},
    "products": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "slots", "price_eur", "kind", "enabled", "revision"],
        "properties": {
          "id": {"enum": ["creator_slot_1", "creator_slots_5", "creator_slots_10", "ad_free_month", "ad_free_forever"]},
          "title": {"type": "string", "maxLength": 80},
          "slots": {"enum": [0, 1, 5, 10]},
          "price_eur": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
          "kind": {"enum": ["consumable", "non_consumable"]},
          "enabled": {"type": "boolean"},
          "revision": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
