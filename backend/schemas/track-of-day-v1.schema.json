{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beat my track Track of the Day v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["day", "starts_at", "ends_at", "server_now", "policy", "reason", "status", "track"],
  "properties": {
    "day": {"type": "integer", "minimum": 0},
    "starts_at": {"type": "integer", "minimum": 0},
    "ends_at": {"type": "integer", "minimum": 0},
    "server_now": {"type": "integer", "minimum": 0},
    "policy": {"const": "track-of-day-v1"},
    "reason": {"enum": ["top", "trending", "startup_repeat", "empty", "exhausted"]},
    "status": {"enum": ["ready", "unavailable"]},
    "track": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "discovery-page-v3.schema.json#/properties/items/items"}
      ]
    }
  }
}
