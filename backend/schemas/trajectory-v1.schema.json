{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bmt-trajectory-v1",
  "title": "Completed race trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "input_count",
    "race_proof"
  ],
  "properties": {
    "schema": {
      "const": "bmt-trajectory-v1"
    },
    "input_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 216000
    },
    "race_proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "samples"
          ],
          "properties": {
            "schema": {
              "const": "bmt-race-path-v1"
            },
            "samples": {
              "type": "array",
              "minItems": 2,
              "maxItems": 36012,
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 216000
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  }
                ],
                "items": false
              }
            },
            "incidents": {
              "$ref": "#/$defs/incidents"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "count",
            "data"
          ],
          "properties": {
            "schema": {
              "const": "bmt-packed-path-v1"
            },
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 36012
            },
            "data": {
              "type": "string",
              "contentEncoding": "base64",
              "maxLength": 1008336
            },
            "incidents": {
              "$ref": "#/$defs/incidents"
            }
          },
          "$comment": "Negotiated race_path_wire_version=1; count exact 21-byte little-endian records: uint32 tick, Float64 x/y, uint8 metadata (bit 0 layer, bits 1/2 integer x/y). Other bits are zero. Bounded decoder checks length, finiteness, domains and flag integrality before normalizing to bmt-race-path-v1 and computing the existing replay digest."
        }
      ]
    },
    "rewinds": {
      "$ref": "replay-v2.schema.json#/properties/rewinds"
    },
    "ghost": {
      "type": "object"
    }
  },
  "$comment": "Only timestamped positions/layers are needed for acceptance. Rewind events use the existing authorized-receipt contract; final duration is input_count minus discarded ticks. Five ordinary laps / one creator lap, ordered gates, correct start/finish, bounded sample gaps and speed. Ghosts are optional presentation, checked/stored separately. Input-only recordings have no race-verification fallback.",
  "$defs": {
    "incidents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ticks",
        "collision_count",
        "off_track"
      ],
      "properties": {
        "schema": {
          "const": "bmt-race-incidents-v1"
        },
        "ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 216000
        },
        "collision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 216000
        },
        "off_track": {
          "type": "boolean"
        }
      }
    }
  }
}
