{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "properties": {
        "vehicle_id": {
          "enum": [
            "compact",
            "pickup",
            "classic",
            "formula",
            "kart",
            "forklift",
            "electric",
            "hovercraft"
          ],
          "title": "Vehicle Id",
          "type": "string"
        },
        "livery": {
          "$ref": "#/$defs/Livery"
        },
        "customisation": {
          "$ref": "#/$defs/Parts"
        }
      },
      "required": [
        "vehicle_id",
        "livery",
        "customisation"
      ],
      "title": "Appearance",
      "type": "object"
    },
    "Livery": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "title": "Version",
          "type": "integer"
        },
        "colors": {
          "$ref": "#/$defs/Pigments"
        },
        "pattern": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "stickers": {
          "$ref": "#/$defs/Panels"
        }
      },
      "required": [
        "version",
        "colors",
        "pattern",
        "stickers"
      ],
      "title": "Livery",
      "type": "object"
    },
    "Panels": {
      "additionalProperties": false,
      "properties": {
        "hood": {
          "$ref": "#/$defs/Sticker"
        },
        "roof": {
          "$ref": "#/$defs/Sticker"
        }
      },
      "required": [
        "hood",
        "roof"
      ],
      "title": "Panels",
      "type": "object"
    },
    "Parts": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "hood": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Hood",
          "type": "string"
        },
        "aero": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Aero",
          "type": "string"
        },
        "rims": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Rims",
          "type": "string"
        },
        "body": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "version",
        "hood",
        "aero",
        "rims",
        "body"
      ],
      "title": "Parts",
      "type": "object"
    },
    "Pigments": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "pattern": "^[0-9a-f]{6}$",
          "title": "Body",
          "type": "string"
        },
        "accent": {
          "pattern": "^[0-9a-f]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "detail": {
          "pattern": "^[0-9a-f]{6}$",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "body",
        "accent",
        "detail"
      ],
      "title": "Pigments",
      "type": "object"
    },
    "Sticker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "size": {
          "maximum": 0.95,
          "minimum": 0.2,
          "title": "Size",
          "type": "number"
        },
        "rotation": {
          "maximum": 180,
          "minimum": -180,
          "title": "Rotation",
          "type": "number"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "size",
        "rotation"
      ],
      "title": "Sticker",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "appearance": {
      "$ref": "#/$defs/Appearance"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#/$defs/Appearance"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "appearance",
    "previous"
  ],
  "title": "SaveAppearance",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bmt:vehicle-appearance-sync-v1",
  "description": "PUT /v1/me/appearances; previous is the last acknowledged car or null. Catalog IDs receive additional runtime validation. GET returns a private appearances map with at most the five known vehicle IDs."
}
