+	check(float(metrics.new_launch[str(20.0)]) < 1.2,"balanced electric launch reaches 72 kph within 1.2 seconds")
+	# The owner's follow-up rejects the initial exaggerated drift. Keep a measured
+	# power slide, with an upper bound and settled light-pedal cornering.
+	check(float(metrics.new_corner.peak_slip_degrees) > 12 and float(metrics.new_corner.peak_slip_degrees) < 24 and float(metrics.new_corner.peak_slip_degrees) > float(metrics.old_corner.peak_slip_degrees)*2,"hard rear-wheel power produces a moderate slide rather than a spin")
