+	var profile: Vector2 = pocket_profile(v,depth)
+	var point: Vector2 = pocket_perimeter(rect.grow(-profile.x),maxf(0.004,radius-profile.x),u)
+	return Vector3(point.x,point.y,rear_z(point.x,point.y)-profile.y)
