+	var target := Vector3((heights.x+heights.y+heights.z+heights.w)*0.25,
+		atan2((heights.x+heights.y-heights.z-heights.w)*0.5,config.wheelbase),
+		atan2((heights.y+heights.w-heights.x-heights.z)*0.5,config.track_width))
