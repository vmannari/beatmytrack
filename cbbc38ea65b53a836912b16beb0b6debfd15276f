+			kerb_probe.heading = lerp_angle(previous_heading,state.heading,t)
+			heights = ground.kerb_heights(kerb_probe,config)
+			for wheel: int in range(4): rise += maxf(0.0,heights[wheel]-last[wheel])*0.25
+			last = heights
