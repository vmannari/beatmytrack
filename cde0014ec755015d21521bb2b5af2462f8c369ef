{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Track slot gift purchase fields v1",
  "description": "Optional recipient fields on simulation purchase and verified Google Play requests. Omit or pass null for self-purchases. Buyer authentication and verified payment remain mandatory; the receipt permanently binds buyer, product and recipient. Simulated gifts require both accounts to be eligible development accounts.",
  "type": "object",
  "required": ["product_id", "recipient_player_id"],
  "properties": {
    "product_id": {"enum": ["creator_slot_1", "creator_slots_5", "creator_slots_10"]},
    "recipient_player_id": {"type": "string", "format": "uuid"}
  }
}
