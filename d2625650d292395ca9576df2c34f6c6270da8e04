+def count_encodings(monkeypatch):
+    calls = []
+    original = storage.canonical_json
+
+    def encode(data):
+        calls.append(data)
+        return original(data)
+
+    monkeypatch.setattr(storage, "canonical_json", encode)
+    return calls
+
