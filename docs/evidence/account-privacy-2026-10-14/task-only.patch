+                    route.continue_()
+                else:
+                    external.append("blocked external provider fixture asset")
+                    route.abort()
+            context.route("**/*", boundary)
+            page = context.new_page()
+            page.on("pageerror", lambda error: errors.append(str(error)))
+            page.goto(base + "/privacy")
