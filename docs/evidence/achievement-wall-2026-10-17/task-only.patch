+void fragment() {
+	vec2 cell = vec2(mod(state.x,10.0),floor(state.x/10.0)*5.0+state.y);
+	vec4 face = texture(medals,(cell+UV)/vec2(10.0,20.0));
+	ALBEDO = face.rgb * state.z;
+	ALPHA = face.a;
+	ALPHA_SCISSOR_THRESHOLD = 0.15;
+}
