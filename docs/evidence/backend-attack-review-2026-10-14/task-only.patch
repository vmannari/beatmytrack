+@pytest.mark.parametrize("raw", [
+    b'{"display_name":"a","display_name":"b"}',
+    b'{"display_name":1e400}', b'{"display_name":"\\ud800"}',
+    b'{"display_name":NaN}', b'[' * 33 + b'0' + b']' * 33,
