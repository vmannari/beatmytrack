+        .outerjoin(StudioCoinEntry, StudioCoinEntry.id == opening)
+        .where(CoinWallet.player_id == player_id, Player.disabled.is_(False), Player.deleted_at.is_(None))
+        .order_by(CosmeticUnlock.item_id)).all()
