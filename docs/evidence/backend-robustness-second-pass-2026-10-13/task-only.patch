+    failing = [True]
+
+    def sync(path):
+        if Path(path) != adapter.root and failing[0]:
+            raise OSError("Synthetic directory sync unavailable")
+        actual(path)
+
+    monkeypatch.setattr(storage, "sync_directory", sync)
+    value = {"proof": "immutable"}
