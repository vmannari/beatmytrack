+            if entry["pending"].get(key) == value:
+                entry["pending"].pop(key, None)
+        entry.update(written=time.monotonic(), build=stored_build)
+        memory.move_to_end(worker_id)
+        while len(memory) > 64:
+            memory.popitem(last=False)
+
