+    assert response.status_code == 503
+    assert "BMT_STUDIO_ANALYSIS_DATABASE_URL" in response.json()["detail"]
+    assert response.headers["retry-after"] == "5"
+    assert not any("studio_analysis" in statement for statement in queries)
