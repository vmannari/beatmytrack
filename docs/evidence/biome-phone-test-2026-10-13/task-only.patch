+<!doctype html><meta charset="utf-8"><title>Phone bank captures</title>
+<style>body{margin:24px;background:#152026;color:#eee;font:16px system-ui}img{display:block;width:100%;max-width:1400px}button,input{margin:12px 12px 12px 0}output{font-variant-numeric:tabular-nums}</style>
+<h1>Actual phone bank captures</h1><p>Three sparse screenshots from real bank excursions. No interpolation or native video; use the slider to inspect the captured states. This visual run includes readbacks and is excluded from performance results.</p>
+<img id="frame" alt="Actual phone bank screenshot"><button id="prev">Previous</button><button id="next">Next</button><input id="slider" type="range" min="0" max="2" value="0"><output id="caption"></output>
+<script>const frames=[{"file": "motion-frames/winter-000.png", "start_seconds": 6.0362483, "end_seconds": 7.729358899999999}, {"file": "motion-frames/winter-001.png", "start_seconds": 7.8353847, "end_seconds": 10.7721389}, {"file": "motion-frames/winter-002.png", "start_seconds": 13.6835848, "end_seconds": 15.2965912}]; const slider=document.getElementById('slider');function show(){const f=frames[Number(slider.value)];document.getElementById('frame').src=f.file;document.getElementById('caption').textContent=`Capture ${Number(slider.value)+1}: requested at ${f.start_seconds.toFixed(2)}s, received at ${f.end_seconds.toFixed(2)}s`;}slider.oninput=show;document.getElementById('prev').onclick=()=>{slider.value=Math.max(0,Number(slider.value)-1);show()};document.getElementById('next').onclick=()=>{slider.value=Math.min(frames.length-1,Number(slider.value)+1);show()};show();</script>
