diff --git a/game/backend/shader_profile_telemetry.gd b/game/backend/shader_profile_telemetry.gd
new file mode 100644
--- /dev/null
+++ b/game/backend/shader_profile_telemetry.gd
@@ -0,0 +1,34 @@
+extends RefCounted
+const FIELDS: Array[String] = ["schema_version","context","biome","renderer","car","simple","graphics","status","observed","missing","dropped","late_compile_us","misses"]
+const PHASES: Array[String] = ["loading","countdown","driving","results"]
+static func integer(value: Variant, maximum: int) -> bool:
+	return (value is int or value is float) and is_finite(float(value)) and value == int(value) and value >= 0 and value <= maximum
+
+static func normalize(value: Variant) -> Dictionary:
+	if not value is Dictionary or value.size() != FIELDS.size() or not value.has_all(FIELDS): return {}
+	var hex := RegEx.create_from_string("^[a-f0-9]{64}$")
+	var mask := RegEx.create_from_string("^[a-f0-9]{16}$")
+	if not value.context is String or hex.search(value.context) == null or not integer(value.schema_version,1) or value.schema_version != 1: return {}
+	if value.biome not in ["pine","winter","desert","storm","night_city","unknown"] or value.renderer != "gl_compatibility" or value.status not in ["matched","unprofiled"]: return {}
+	if value.car not in VehicleCatalog.IDS+["unknown"] or not value.simple is bool: return {}
+	if not value.graphics is Dictionary or value.graphics.size() != 3: return {}
+	for field: String in ["shadow_quality","render_resolution","anti_aliasing"]:
+		if not preload("res://presentation/graphics_preferences.gd").valid(field,value.graphics.get(field)): return {}
+	for field: String in ["observed","missing","dropped","late_compile_us"]:
+		if not integer(value[field],3600000000 if field == "late_compile_us" else 1000000 if field == "dropped" else 4096): return {}
+	if value.missing > value.observed or not value.misses is Array or value.misses.size() > mini(16,int(value.missing)): return {}
+	var seen: Dictionary = {}
+	for row: Variant in value.misses:
+		if not row is Dictionary or row.size() != 8 or not row.has_all(["key","shader","variant","specialization","reason","phase","compile_phase","compile_us"]): return {}
+		if not row.key is String or hex.search(row.key) == null or seen.has(row.key): return {}
+		if not row.shader is String or hex.search(row.shader) == null or not integer(row.variant,255): return {}
+		if not row.specialization is String or mask.search(row.specialization) == null: return {}
+		if row.reason not in ["unlisted","late_compile"]: return {}
+		if row.phase not in PHASES or row.compile_phase not in PHASES+["cached","outside"] or not integer(row.compile_us,60000000): return {}
+		seen[row.key] = true
+	var result: Dictionary = value.duplicate(true)
+	for field: String in ["schema_version","observed","missing","dropped","late_compile_us"]: result[field] = int(result[field])
+	for row: Dictionary in result.misses:
+		row.variant = int(row.variant)
+		row.compile_us = int(row.compile_us)
+	return result
diff --git a/game/tests/test_biome_shader_profiles.gd b/game/tests/test_biome_shader_profiles.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_biome_shader_profiles.gd
@@ -0,0 +1,81 @@
+extends SceneTree
+const Profile = preload("res://rendering/biome_shader_profile.gd")
+const Wire = preload("res://backend/shader_profile_telemetry.gd")
+var checks: int = 0
+var failures: int = 0
+class Client extends Node:
+	var player: Dictionary = {"id":"fixture-player"}
+	var supported: bool = true
+	func base_url() -> String: return "https://offline.invalid"
+	func shader_profiles_supported() -> bool: return supported
+func check(value: bool, description: String) -> void:
+	checks += 1
+	if not value: failures += 1; push_error(description)
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var context: Dictionary = {"biome":"pine","renderer":"gl_compatibility","settings":{"msaa":0,"detail":"full"}}
+	var entry: Dictionary = {"shader":"a".repeat(64),"variant":0,"specialization":"000000000000001f"}
+	var manifest: Dictionary = {"schema_version":1,"revision":Profile.REVISION,"profiles":{Profile.identity(context):{"context":context.duplicate(true),"entries":[entry]}}}
+	check(not Profile.select_profile(manifest,context).is_empty(),"exact biome/settings selects profile")
+	check(not Profile.select_profile(JSON.parse_string(JSON.stringify(manifest)),context).is_empty(),"profile JSON round trip matches live context")
+	for field: String in ["biome","renderer","settings"]:
+		var changed: Dictionary = context.duplicate(true)
+		changed[field] = "different"
+		check(Profile.select_profile(manifest,changed).is_empty(),"changed "+field+" retains conservative fallback")
+	var stale: Dictionary = manifest.duplicate(true); stale.revision = "old"
+	check(Profile.select_profile(stale,context).is_empty(),"engine revision invalidates profile")
+	check(Profile.identity({"a":1,"b":2}) == Profile.identity({"b":2,"a":1}),"stable dictionary-order identity")
+	for broken: Variant in [null,{},[{}],[entry,entry],[{"shader":"bad","variant":0,"specialization":"0000000000000000"}],[{"shader":"a".repeat(64),"variant":0.5,"specialization":"0000000000000000"}]]:
+		check(not Profile.valid_entries(broken),"malformed entries rejected")
+	var observations: Array = []
+	for n: int in range(22):
+		observations.append({"key":str(n).sha256_text(),"shader":"a".repeat(64),"variant":n,"specialization":"0000000000000000","missing":true,"phase":"driving","compile_phase":"loading" if n == 0 else "driving","compile_us":1000})
+	var data: Dictionary = {"context":"b".repeat(64),"profile_context":{"biome":"pine","renderer":"gl_compatibility"},"status":"matched","observations":observations,"dropped":0}
+	var report: Dictionary = Profile.summary(data)
+	check(report.missing == 22 and report.misses.size() == 16,"miss count survives bounded details")
+	check(report.late_compile_us == 21000,"loading cost is not attributed to driving")
+	var recreated: Dictionary = data.duplicate(true)
+	recreated.observations = [{"key":"c".repeat(64),"shader":"a".repeat(64),"variant":0,"specialization":"0000000000000000","missing":false,"listed":true,"phase":"loading","compile_phase":"cached","compile_us":0}]
+	var later: Dictionary = recreated.observations[0].duplicate()
+	later.merge({"missing":true,"phase":"driving","compile_phase":"driving","compile_us":2000},true)
+	recreated.observations.append(later)
+	check(Profile.summary(recreated).missing == 1 and Profile.summary(recreated).misses[0].reason == "late_compile","recreated known variant retains its later preparation miss")
+	check(report.misses[0].compile_phase == "driving","late misses take detail priority")
+	check(not Wire.normalize(report).is_empty(),"bounded summary validates")
+	var restored: Dictionary = Wire.normalize(JSON.parse_string(JSON.stringify(report)))
+	check(restored.observed is int and restored.misses[0].variant is int and restored.misses[0].compile_us is int,"persisted JSON restores integer wire types")
+	for field: String in ["context","biome","renderer","status","observed","misses"]:
+		var broken: Dictionary = report.duplicate(true); broken[field] = null
+		check(Wire.normalize(broken).is_empty(),"invalid summary "+field+" rejected")
+	var extra: Dictionary = report.duplicate(true); extra["driver_serial"] = "not-allowed"
+	check(Wire.normalize(extra).is_empty(),"unapproved telemetry properties rejected")
+	var duplicate: Dictionary = report.duplicate(true); duplicate.misses[1] = duplicate.misses[0].duplicate()
+	check(Wire.normalize(duplicate).is_empty(),"duplicate details rejected")
+	var client := Client.new()
+	var telemetry := preload("res://backend/product_telemetry.gd").new()
+	telemetry.client = client
+	telemetry._scope = (client.base_url()+"/"+str(client.player.id)).sha256_text()
+	telemetry._allowed = false
+	check(telemetry.observe_shader_profile(report,telemetry._scope),"negotiated scoped telemetry enqueues")
+	check(telemetry.queue.size() == 1 and telemetry._thread == null,"capture does not start race-time IO")
+	check(not telemetry.observe_shader_profile(report,"stale-account"),"old account cannot own diagnostics")
+	telemetry.enabled = false
+	check(not telemetry.observe_shader_profile(report,telemetry._scope),"analytics opt-out suppresses telemetry")
+	telemetry.enabled = true; client.supported = false
+	check(not telemetry.observe_shader_profile(report,telemetry._scope),"old backend does not receive unknown event")
+	telemetry._persisted_ids[telemetry.queue[0].event.id] = true
+	check(telemetry.batch_payload().events.is_empty(),"persisted diagnostics wait through capability rollback")
+	telemetry.free(); client.free()
+	if Engine.has_singleton("BMTShaderProfiles"):
+		var native: Object = Engine.get_singleton("BMTShaderProfiles")
+		check(native.begin("bad",[],false) == 0,"native rejects invalid scope")
+		var token: int = native.begin("a".repeat(64),[entry],true)
+		check(token > 0,"native accepts validated profile")
+		check(native.begin("b".repeat(64),[],false) == 0,"second owner cannot replace active scope")
+		native.end(token+1)
+		check(not native.snapshot(token).is_empty(),"stale owner cannot terminate active scope")
+		check(not native.finish(token).is_empty(),"owner atomically takes final report")
+		check(native.snapshot(token).is_empty(),"owner releases its telemetry scope")
+	print("BIOME_SHADER_PROFILES_COMPLETE %d checks, %d failures" % [checks,failures])
+	quit(1 if failures else 0)
diff --git a/game/tests/profile_biome_shader_profiles.gd b/game/tests/profile_biome_shader_profiles.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/profile_biome_shader_profiles.gd
@@ -0,0 +1,77 @@
+extends "res://tests/test_shared_graphics_first_laps.gd"
+const Profiles = preload("res://rendering/biome_shader_profile.gd")
+var shader_reports: Array = []
+var omitted: Dictionary = {}
+func run() -> void:
+	if "--observe-only" in OS.get_cmdline_user_args():
+		Profiles._manifest = {}; Profiles._loaded = true
+	if "--omit-profile-entry" in OS.get_cmdline_user_args():
+		Profiles._manifest = JSON.parse_string(FileAccess.get_file_as_string(Profiles.MANIFEST))
+		Profiles._loaded = true
+		for profile: Dictionary in Profiles._manifest.profiles.values():
+			if profile.context.biome != "pine" or profile.context.car != "compact": continue
+			var counts: Dictionary = {}
+			for entry: Dictionary in profile.entries: counts[entry.shader] = int(counts.get(entry.shader,0))+1
+			for index: int in range(profile.entries.size()):
+				var entry: Dictionary = profile.entries[index]
+				if counts[entry.shader] > 1:
+					omitted = entry.duplicate(); profile.entries.remove_at(index); break
+		check(not omitted.is_empty(),"positive control omits one measured variant of a still-known shader")
+	await super.run()
+
+func race(vehicle: String, theme: String, interruption: String = "complete") -> void:
+	if "--biomes-only" in OS.get_cmdline_user_args() and (vehicle != "compact" or interruption != "complete"): return
+	await super.race(vehicle,theme,interruption)
+
+func first_emission(game: Node) -> void:
+	check(game.shader_profile.token > 0,"engine shader observer owns actual race scope")
+	if "--require-profiles" in OS.get_cmdline_user_args():
+		check(game.shader_profile.status == "matched" and game.shader_profile.snapshot().selective,"reviewed biome profile actually enables selective preparation")
+	var output: String = OS.get_environment("BMT_GRAPHICS_OUTPUT")
+	var theme: String = str(game.native_track.metadata.theme)
+	if not output.is_empty():
+		game.process_mode = Node.PROCESS_MODE_DISABLED
+		Engine.time_scale = 0.0
+		for _frame: int in range(6): await process_frame; await RenderingServer.frame_post_draw
+		root.get_texture().get_image().save_png(output.path_join(theme+"-ready.png"))
+		Engine.time_scale = 1.0
+	var ready: Dictionary = game.shader_profile.snapshot()
+	if not omitted.is_empty():
+		var found: bool = false
+		for event: Dictionary in ready.observations:
+			found = found or (event.shader == omitted.shader and event.variant == omitted.variant and event.specialization == omitted.specialization and event.missing)
+		check(found,"omitted required variant renders through fallback and is reported")
+	await super.first_emission(game)
+	if "--inject-shader-miss" in OS.get_cmdline_user_args():
+		var shader := Shader.new()
+		shader.code = "shader_type canvas_item; // BMT deliberate late miss\nvoid fragment(){COLOR=vec4(0.5,0.1,0.2,1.0);}"
+		var material := ShaderMaterial.new(); material.shader = shader
+		var control := ColorRect.new(); control.size = Vector2(32,32); control.material = material
+		root.add_child(control)
+		await process_frame
+		await RenderingServer.frame_post_draw
+		var injected: Dictionary = game.shader_profile.snapshot()
+		var found: bool = false
+		for event: Dictionary in injected.observations:
+			found = found or (event.missing and event.compile_phase == "driving" and event.compile_us > 0)
+		check(found,"deliberate driving-time compilation is reported as a costly miss")
+		control.queue_free()
+		await process_frame
+	var final: Dictionary = game.shader_profile.snapshot()
+	if "--pause-profile-control" in OS.get_cmdline_user_args():
+		var previous: int = game.shader_profile.token
+		var original_context: String = game.shader_profile.context_key
+		game.paused = true
+		game.shader_profile._process(0.0)
+		check(game.shader_profile.token == 0,"pause closes the driving observation before menu rendering")
+		var old: Variant = game.preference_records.settings.get("shadow_quality")
+		game.preference_records.settings.shadow_quality = "off"
+		game.paused = false
+		game.shader_profile._process(0.0)
+		check(game.shader_profile.token > previous and game.shader_profile.context_key == original_context,"resume starts a fresh scope using applied graphics rather than staged settings")
+		if old == null: game.preference_records.settings.erase("shadow_quality")
+		else: game.preference_records.settings.shadow_quality = old
+	shader_reports.append({"ready":ready,"final":final,"summary":Profiles.summary(final)})
+	if not output.is_empty():
+		FileAccess.open(output.path_join("profiles.json"),FileAccess.WRITE).store_string(JSON.stringify(shader_reports,"\t"))
+	print("BIOME_SHADER_PROFILE ",JSON.stringify(Profiles.summary(final)))
diff --git a/backend/bmt_backend/shader_profiles.py b/backend/bmt_backend/shader_profiles.py
new file mode 100644
--- /dev/null
+++ b/backend/bmt_backend/shader_profiles.py
@@ -0,0 +1,82 @@
+"""Bounded shader preparation diagnostics; no source text or device identifier."""
+import re
+
+from fastapi import APIRouter, Query, Request
+from sqlalchemy import select
+
+from .admin import Access, Window
+from .admin_ranges import calendar_range
+from .studio_queries import read_snapshot
+from .telemetry_models import ProductEvent
+from .track_models import now
+
+router = APIRouter(tags=["shader preparation"])
+
+FIELDS = {"schema_version", "context", "biome", "renderer", "car", "simple", "graphics", "status", "observed",
+          "missing", "dropped", "late_compile_us", "misses"}
+PHASES = {"loading", "countdown", "driving", "results"}
+HEX = re.compile(r"[a-f0-9]{64}\Z")
+
+
+def validate(value):
+    def check(condition):
+        if not condition:
+            raise ValueError("INVALID_EVENT")
+
+    def integer(number, maximum):
+        return type(number) is int and 0 <= number <= maximum
+
+    def digest(text):
+        return isinstance(text, str) and HEX.fullmatch(text) is not None
+
+    check(isinstance(value, dict) and set(value) == FIELDS)
+    check(type(value["schema_version"]) is int and value["schema_version"] == 1)
+    check(digest(value["context"]))
+    check(isinstance(value["biome"], str) and value["biome"] in {"pine", "winter", "desert", "storm", "night_city", "unknown"})
+    check(value["renderer"] == "gl_compatibility" and value["status"] in ("matched", "unprofiled"))
+    check(value["car"] in ("compact", "pickup", "classic", "formula", "kart", "electric", "forklift", "hovercraft", "unknown"))
+    check(type(value["simple"]) is bool)
+    settings = value["graphics"]
+    check(isinstance(settings, dict) and set(settings) == {"shadow_quality", "render_resolution", "anti_aliasing"})
+    check(settings["shadow_quality"] in ("auto", "off", "low", "medium", "high"))
+    check(settings["render_resolution"] in ("auto", "50", "67", "75", "100"))
+    check(settings["anti_aliasing"] in ("auto", "off", "fxaa", "msaa_2x", "msaa_4x"))
+    for field in ("observed", "missing", "dropped", "late_compile_us"):
+        check(integer(value[field], 3600000000 if field == "late_compile_us" else 1000000 if field == "dropped" else 4096))
+    check(value["missing"] <= value["observed"])
+    check(isinstance(value["misses"], list) and len(value["misses"]) <= min(16, value["missing"]))
+    seen = set()
+    for row in value["misses"]:
+        check(isinstance(row, dict) and set(row) == {"key", "shader", "variant", "specialization", "reason", "phase", "compile_phase", "compile_us"})
+        check(digest(row["key"]) and row["key"] not in seen)
+        check(digest(row["shader"]) and integer(row["variant"], 255))
+        check(row["reason"] in ("unlisted", "late_compile"))
+        check(isinstance(row["specialization"], str) and re.fullmatch(r"[a-f0-9]{16}", row["specialization"]) is not None)
+        check(isinstance(row["phase"], str) and row["phase"] in PHASES)
+        check(isinstance(row["compile_phase"], str) and row["compile_phase"] in PHASES | {"cached", "outside"})
+        check(integer(row["compile_us"], 60000000))
+        seen.add(row["key"])
+    return value
+
+
+@router.get("/v1/admin/shader-profiles")
+def report(request: Request, role: Access, window: Window,
+           biome: str = Query("", max_length=24), context: str = Query("", max_length=64),
+           limit: int = Query(100, ge=1, le=500)):
+    first, until = window or calendar_range(7)
+    with request.app.state.session_factory() as session:
+        read_snapshot(session)
+        candidates = session.scalars(select(ProductEvent).where(
+            ProductEvent.source == "client", ProductEvent.name == "shader_profile",
+            ProductEvent.occurred_at >= first, ProductEvent.occurred_at < until,
+            ProductEvent.received_at >= now()-request.app.state.settings.telemetry_raw_days*86400)
+            .order_by(ProductEvent.occurred_at.desc(), ProductEvent.id.desc()).limit(1001)).all()
+        # Filter only this bounded indexed window; no unbounded raw-event scan.
+        selected = [event for event in candidates[:1000]
+                    if (not biome or event.properties.get("biome") == biome)
+                    and (not context or event.properties.get("context") == context)]
+        return {"items": [{"occurred_at": event.occurred_at, "build_id": event.build_id,
+                           "platform": event.platform, **event.properties} for event in selected[:limit]],
+                "truncated": len(candidates) > 1000 or len(selected) > limit,
+                "candidates": min(len(candidates), 1000), "role": role,
+                "coverage": "Opt-in supported-engine reports only; bounded recent raw receipts, not fleet-wide absence proof."}
