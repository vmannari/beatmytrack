+<!-- /BIOME-SHADER-PROFILES-20261106 -->
+
+'''
+for name in ['AGENTS.md','DEVELOPMENT_STATUS.md']:
+    path=root/name
+    content=path.read_bytes()
+    assert b'<!-- BIOME-SHADER-PROFILES-20261106 -->' not in content
