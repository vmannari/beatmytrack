+++ b/docs/evidence/biome-shader-profiles-2026-11-06/run_check.py
@@ -0,0 +1,74 @@
+"""Bounded, offline native loading review with private profiles and source receipts."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+p = argparse.ArgumentParser(allow_abbrev=False)
+p.add_argument('label')
+p.add_argument('script')
+p.add_argument('--frozen', action='store_true')
+p.add_argument('--profile', default='')
+p.add_argument('--renderer', default='gl_compatibility')
+p.add_argument('--timeout', type=int, default=360)
+p.add_argument('--headless', action='store_true')
+p.add_argument('--verbose', action='store_true')
+p.add_argument('--native', action='store_true')
+p.add_argument('--engine', default='C:/apps/Godot 4.7.2/Godot_v4.7.2-stable_win64_console.exe')
+p.add_argument('--themes', default='pine')
+args, extra = p.parse_known_args()
+evidence = Path(__file__).resolve().parent
+root = evidence.parents[2]
+project = Path(json.loads((evidence/'frozen-project.json').read_text())['project']) if args.frozen else root/'game'
+profile = root / 'build/biome-shader-profiles-20261106' / (args.profile or args.label)
+profile.mkdir(parents=True, exist_ok=True)
+config = profile / 'Circuit01Lab/backend.cfg'
+config.parent.mkdir(exist_ok=True)
+config.write_text('[backend]\nurl=""\n', encoding='utf-8')
+env = os.environ.copy()
+env.update(APPDATA=str(profile), BMT_API_URL='', BMT_LOADING_OUTPUT=str(evidence / (args.label+'.json')))
+output=evidence/args.label
+output.mkdir(exist_ok=True)
+env.update(LOCALAPPDATA=str(profile),BMT_GRAPHICS_OUTPUT=str(output),BMT_GRAPHICS_THEMES=args.themes,
+    BMT_NATIVE_TRACE='1' if args.native else '0',BMT_NATIVE_EXTENSION=str(evidence/'harness/program_probe.gdextension'),
+    BMT_PREP_MODE='capture',BMT_PREP_JOBS=str(output/'jobs'),BMT_PREP_BINARIES=str(output/'binaries'),BMT_PREP_REPORT=str(output/'native-report.json'))
+assert hashlib.sha256(Path('C:/apps/Godot 4.7.2/Godot_v4.7.2-stable_win64.exe').read_bytes()).hexdigest()=='ab1824f85bfd8e0e4128182c000c4003a3e042245b2967848d089b2a04b22424'
+command = [sys.executable, str(root / 'scripts/run_no_crash_dialog.py'), '--',
+    args.engine, '--path', str(project),
+    '--audio-driver', 'Dummy', '--rendering-method', args.renderer,
+    *(['--headless'] if args.headless else []), *(['--verbose'] if args.verbose else []), '--script', args.script, '--', *extra]
+
+def hashes():
+    paths = [path for path in project.rglob('*') if path.is_file()
+             and '.godot' not in path.parts and path.suffix in ('.gd', '.gdshader', '.gdshaderinc', '.tscn', '.scn')]
+    paths.append(project/'project.godot')
+    paths.append(project/'rendering/biome_shader_profiles.json')
+    return {str(path.relative_to(project)).replace('\\','/'): hashlib.sha256(path.read_bytes()).hexdigest() for path in paths}
+
+receipt = dict(command=command, engine_sha256=hashlib.sha256(Path(args.engine).read_bytes()).hexdigest(), profile=str(profile), before=hashes())
+began = time.monotonic()
+with (evidence/(args.label+'.log')).open('w', encoding='utf-8') as log:
+    process = subprocess.Popen(command, env=env, cwd=root, stdout=log, stderr=subprocess.STDOUT)
+    receipt['owned_process_id'] = process.pid
+    (evidence/(args.label+'-running.json')).write_text(json.dumps(receipt, indent=2), encoding='utf-8')
+    try:
+        receipt['exit_code'] = process.wait(timeout=args.timeout)
+    except subprocess.TimeoutExpired:
+        subprocess.run(['taskkill','/PID',str(process.pid),'/T','/F'], capture_output=True, check=False)
+        process.wait(timeout=20)
+        receipt['exit_code'] = 124
+receipt['process_exit_code'] = receipt['exit_code']
+receipt['script_errors'] = [line for line in (evidence/(args.label+'.log')).read_text(encoding='utf-8',errors='replace').splitlines() if line.startswith(('SCRIPT ERROR:','SHADER ERROR:'))]
+if receipt['exit_code']==0 and receipt['script_errors']: receipt['exit_code']=1
+receipt.update(elapsed_seconds=time.monotonic()-began, after=hashes())
+receipt['changed_sources'] = [path for path in receipt['before'].keys() | receipt['after'].keys()
+                            if receipt['before'].get(path) != receipt['after'].get(path)]
+(evidence/(args.label+'-receipt.json')).write_text(json.dumps(receipt, indent=2), encoding='utf-8')
+print(json.dumps({key: receipt[key] for key in ('exit_code','elapsed_seconds','changed_sources')}))
+sys.exit(receipt['exit_code'])
+
+
