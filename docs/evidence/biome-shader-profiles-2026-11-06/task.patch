+extends Node
+## One race-owned native profile. Ordinary engines retain full preparation.
+## Exact shader identity is generated by the engine, including expanded sources.
+const REVISION: String = "bmt-biome-gles3-1"
+const GraphicsPreferences = preload("res://presentation/graphics_preferences.gd")
+const MANIFEST: String = "res://rendering/biome_shader_profiles.json"
+const MAX_ENTRIES: int = 4096
+const MAX_MISSES: int = 16
+static var _manifest: Dictionary = {}
+static var _loaded: bool = false
+var native: Object
+var token: int = 0
+var context: Dictionary = {}
+var context_key: String = ""
+var status: String = "unsupported"
+var telemetry: Node
+var captured_scope: String = ""
+var _phase: String = "loading"
+var _suspended: bool = false
+var _game: WeakRef
+var report: Dictionary = {}
+
+static func context_for(game: Node) -> Dictionary:
+	var track: NativeTrack = game.native_track
+	var biome: String = str(track.metadata.get("theme","pine")) if track != null else "unknown"
+	var settings: Dictionary = game.preference_records.settings if game.preference_records != null else {}
+	var viewport: Viewport = game.get_viewport()
+	return {"revision":REVISION,"engine":Engine.get_version_info().string,"engine_hash":Engine.get_version_info().hash,
+		"engine_profile_source":Engine.get_singleton("BMTShaderProfiles").source_revision() if Engine.has_singleton("BMTShaderProfiles") else "",
+		"renderer":RenderingServer.get_current_rendering_method(),"driver":RenderingServer.get_video_adapter_api_version(),
+		"adapter":RenderingServer.get_video_adapter_name(),"vendor":RenderingServer.get_video_adapter_vendor(),
+		"biome":biome,"car":game.vehicle_id,"simple":game.car.simple_model if is_instance_valid(game.car) else bool(settings.get("simple_car_models",false)),
+		"graphics":game._graphics.duplicate(),"msaa":viewport.msaa_3d,
+		"screen_aa":viewport.screen_space_aa,"hdr":viewport.use_hdr_2d}
+
+static func identity(value: Dictionary) -> String:
+	# JSON's sorted keys make this stable across processes and dictionary order.
+	return JSON.stringify(_canonical(value),"",true).sha256_text()
+
+static func _canonical(value: Variant) -> Variant:
+	# Godot restores JSON numbers as floats. Render-context integers must retain
+	# the same identity after disk round trips, without coercing booleans/text.
+	if value is float and is_finite(value) and absf(value) <= 9007199254740991.0 and value == int(value): return int(value)
+	if value is Dictionary:
+		var result: Dictionary = {}
+		for key: Variant in value: result[key] = _canonical(value[key])
+		return result
+	if value is Array:
+		var result: Array = []
+		for item: Variant in value: result.append(_canonical(item))
+		return result
+	return value
+
+static func valid_entries(value: Variant) -> bool:
+	if not value is Array or value.size() > MAX_ENTRIES: return false
+	var hex64 := RegEx.create_from_string("^[a-f0-9]{64}$")
+	var hex16 := RegEx.create_from_string("^[a-f0-9]{16}$")
+	var seen: Dictionary = {}
+	for entry: Variant in value:
+		if not entry is Dictionary or entry.size() != 3 or not entry.has_all(["shader","variant","specialization"]): return false
+		if not entry.shader is String or hex64.search(entry.shader) == null: return false
+		if not entry.specialization is String or hex16.search(entry.specialization) == null: return false
+		if not (entry.variant is int or entry.variant is float) or not is_finite(float(entry.variant)) or entry.variant != int(entry.variant) or entry.variant < 0 or entry.variant > 255: return false
+		var key: String = identity(entry)
+		if seen.has(key): return false
+		seen[key] = true
+	return true
+
+static func select_profile(manifest: Dictionary, value: Dictionary) -> Dictionary:
+	if manifest.get("schema_version") != 1 or manifest.get("revision") != REVISION or not manifest.get("profiles") is Dictionary: return {}
+	var candidate: Variant = manifest.profiles.get(identity(value),{})
+	if not candidate is Dictionary or not candidate.get("context") is Dictionary or identity(candidate.context) != identity(value) or not valid_entries(candidate.get("entries")): return {}
+	return candidate
+
+func begin(game: Node, sink: Node = null) -> void:
+	set_process(false)
+	_phase = "loading"
+	_suspended = false
+	_game = weakref(game)
+	telemetry = sink
+	if is_instance_valid(telemetry): captured_scope = telemetry._scope
+	if DisplayServer.get_name() == "headless" or RenderingServer.get_current_rendering_method() != "gl_compatibility" or not Engine.has_singleton("BMTShaderProfiles"): return
+	native = Engine.get_singleton("BMTShaderProfiles")
+	if native.revision() != REVISION: native = null; return
+	context = context_for(game)
+	context_key = identity(context)
+	if not _loaded:
+		_loaded = true
+		var file := FileAccess.open(MANIFEST,FileAccess.READ)
+		if file != null and file.get_length() <= 4194304:
+			var parsed: Variant = JSON.parse_string(file.get_as_text())
+			if parsed is Dictionary: _manifest = parsed
+	var profile: Dictionary = select_profile(_manifest,context)
+	status = "matched" if not profile.is_empty() else "unprofiled"
+	token = native.begin(context_key,profile.get("entries",[]),not profile.is_empty())
+	if token == 0: status = "busy"
+	set_process(token != 0)
+
+func _process(_delta: float) -> void:
+	var game: Node = _game.get_ref() if _game != null else null
+	if not is_instance_valid(game) or native == null: return
+	# Pause-menu rendering is not driving work. Close the observation before
+	# its UI draws; resume with actual applied graphics, not staged preferences.
+	if game.paused:
+		if token != 0:
+			finish()
+			_suspended = true
+			set_process(true)
+		return
+	if _suspended: begin(game,telemetry)
+	if token == 0: return
+	var next: String = "loading" if not game.preparation_complete else "results" if game.track_session != null and game.track_session.finished else "countdown" if game.countdown_ticks > 0 else "driving"
+	if next != _phase:
+		_phase = next
+		native.set_phase(token,_phase)
+
+func snapshot() -> Dictionary:
+	if token == 0 or native == null: return {}
+	var data: Dictionary = native.snapshot(token)
+	data["profile_context"] = context.duplicate(true)
+	data["status"] = status
+	return data
+
+func finish() -> void:
+	if token == 0: return
+	report = native.finish(token)
+	if not report.is_empty():
+		report["profile_context"] = context.duplicate(true)
+		report["status"] = status
+	token = 0
+	set_process(false)
+	if is_instance_valid(telemetry): telemetry.observe_shader_profile(summary(report),captured_scope)
+
+static func summary(data: Dictionary) -> Dictionary:
+	if data.is_empty(): return {}
+	var unique: Dictionary = {}
+	var misses: Array = []
+	var missing: int = 0
+	var late_us: int = 0
+	for event: Dictionary in data.get("observations",[]):
+		if event.compile_phase in ["countdown","driving","results"]: late_us += int(event.compile_us)
+		if not unique.has(event.key): unique[event.key] = event; continue
+		var previous: Dictionary = unique[event.key]
+		var late: bool = event.compile_phase in ["countdown","driving","results"] and event.compile_us > 0
+		var previous_late: bool = previous.compile_phase in ["countdown","driving","results"] and previous.compile_us > 0
+		if (event.missing and not previous.missing) or (late and not previous_late) or (late == previous_late and event.missing == previous.missing and event.compile_us > previous.compile_us): unique[event.key] = event
+	for event: Dictionary in unique.values():
+		if not event.missing: continue
+		missing += 1
+		misses.append({"key":event.key,"shader":event.shader,"variant":event.variant,"specialization":event.specialization,
+			"reason":"late_compile" if event.get("listed",false) else "unlisted",
+			"phase":event.phase,"compile_phase":event.compile_phase,"compile_us":clampi(int(event.compile_us),0,60000000)})
+	# Preserve the most actionable late misses when the detail budget is full.
+	misses.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
+		var rank: Array[String] = ["driving","countdown","results","loading","cached","outside"]
+		var left: int = rank.find(a.compile_phase)
+		var right: int = rank.find(b.compile_phase)
+		if left != right: return left < right
+		if a.compile_us != b.compile_us: return a.compile_us > b.compile_us
+		return a.key < b.key)
+	if misses.size() > MAX_MISSES: misses.resize(MAX_MISSES)
+	return {"schema_version":1,"context":data.context,"biome":data.profile_context.biome,"renderer":data.profile_context.renderer,
+		"car":data.profile_context.get("car","unknown"),"simple":data.profile_context.get("simple",false),
+		"graphics":data.profile_context.get("graphics",GraphicsPreferences.DEFAULTS).duplicate(),
+		"status":data.status,"observed":unique.size(),"missing":missing,"dropped":clampi(int(data.get("dropped",0)),0,1000000),
+		"late_compile_us":clampi(int(data.get("late_compilation_us",late_us)),0,3600000000),"misses":misses}
+
+func _exit_tree() -> void:
+	finish()
