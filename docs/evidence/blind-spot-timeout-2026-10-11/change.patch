index 1b2e0161..8fadb378 100644
--- a/game/backend/backend_client.gd
+++ b/game/backend/backend_client.gd
@@ -177,6 +177,13 @@ func _renew_session(generation: int, path: String = "", method: HTTPClient.Metho
 	var began: int = Time.get_ticks_msec()
 	while _refresh_busy:
 		if generation != _session_generation: return _failure("ACCOUNT_CHANGED")
+		# Renewal may already be complete while its owner's original read is
+		# still being retried under the rotation lock. A race can use that new
+		# credential without waiting for the unrelated response or releasing
+		# either lock. Keep the exact ticket payload and operation key.
+		if method == HTTPClient.METHOD_POST and _race_ticket_path(path) and not _access_token.is_empty() and _access_token != used_access:
+			var ticket: Dictionary = _checked(await _send(path,method,payload,true,key),path,method)
+			return ticket if generation == _session_generation else _failure("ACCOUNT_CHANGED")
 		if Time.get_ticks_msec()-began >= 35000:
 			var waiting: Dictionary = _failure("SESSION_ROTATION_BUSY")
 			waiting.not_delivered = true
