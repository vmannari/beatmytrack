+++ b/game/tests/capture_breakable_props.gd
@@ -0,0 +1,114 @@
+extends SceneTree
+## Diagnostic stages generated by canonical contacts, plus the actual editor palette.
+const OUTPUT: String = "res://../docs/evidence/breakable-props-2026-10-12/"
+var folder: String
+var checks: int = 0
+var failures: int = 0
+var config: HandlingConfig
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok: failures += 1; print("FAIL: ",label)
+func clear(_p: Vector2, _radius: float, _deck: bool) -> Vector3: return Vector3.ZERO
+func step(state: VehicleState, objects: Array) -> void:
+	LightProps.step(state,objects,clear,state.position,VehicleSimulation.STEP,config.mass,config.collision_radius)
+	state.tick += 1
+func settle(state: VehicleState, objects: Array) -> void:
+	state.position = Vector2(100,100); state.velocity = Vector2.ZERO
+	for i: int in range(400): step(state,objects)
+func hit(state: VehicleState, objects: Array, index: int, speed: float) -> void:
+	var p := Vector2(state.light_props[index][0],state.light_props[index][1])
+	state.position = p-Vector2(0.30,0); state.velocity = Vector2(speed,0); state.heading = PI*0.5
+	step(state,objects); settle(state,objects)
+func frames(count: int) -> void:
+	for i: int in range(count): await RenderingServer.frame_post_draw
+func capture(name: String) -> void:
+	await frames(4)
+	check(root.get_texture().get_image().save_png(folder+"/"+name+".png") == OK,"capture "+name)
+func run() -> void:
+	if DisplayServer.get_name() == "headless": push_error("Use TestScript -Graphical"); quit(1); return
+	folder = ProjectSettings.globalize_path(OUTPUT+RenderingServer.get_current_rendering_method()); DirAccess.make_dir_recursive_absolute(folder)
+	root.size = Vector2i(1280,720); config = VehicleCatalog.config("compact")
+	var document: Dictionary = TrackDocument.create_default(); document["automatic_scenery"] = false
+	document.name = "Hay and crate practice"
+	document.objects = [{"kind":"hay_bale","position":[-3,0],"rotation":15},{"kind":"crate","position":[3,0],"rotation":345}]
+	var track: NativeTrack = TrackCompiler.compile(document)
+	check(track != null,"capture document validates: "+str(TrackDocument.validate(document)))
+	if track == null: quit(1); return
+	var objects: Array = track.hazard_objects
+	var state := VehicleState.new(); state.position = Vector2(100,100); step(state,objects)
+	var intact: Dictionary = RewindHistory.properties(state)
+	var stage := Node3D.new(); root.add_child(stage)
+	var visual := NativeTrackVisual.new(); stage.add_child(visual); visual._build_placed_objects(track)
+	VisualGeometry.box(stage,Vector3(80,0.08,60),Vector3(0,-0.08,0),VisualGeometry.material(Color("636b5b")))
+	var car := CarVisual.new(); car.position = Vector3(0,0,5); car.rotation.y = PI*0.5; stage.add_child(car)
+	var light := DirectionalLight3D.new(); light.rotation_degrees = Vector3(-48,-32,0); light.light_color = Color("fff0d9"); light.shadow_enabled = true; stage.add_child(light)
+	var environment := WorldEnvironment.new(); environment.environment = Environment.new()
+	environment.environment.background_mode = Environment.BG_COLOR; environment.environment.background_color = Color("1b2b32")
+	environment.environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR; environment.environment.ambient_light_energy = 0.45; environment.environment.ambient_light_color = Color("c6d6df"); stage.add_child(environment)
+	var camera := Camera3D.new(); camera.projection = Camera3D.PROJECTION_ORTHOGONAL; camera.size = 14; stage.add_child(camera)
+	camera.look_at_from_position(Vector3(9,14,19),Vector3(3,0,0)); camera.current = true
+	visual.update_light_props(state); fit(camera,visual,car); await capture("intact")
+	hit(state,objects,0,10); hit(state,objects,1,9)
+	var snapshot: Array = state.snapshot(); visual.update_light_props(state)
+	check(state.snapshot() == snapshot,"deformed/cracked presentation leaves canonical state exact")
+	fit(camera,visual,car); await capture("deformed-and-cracked")
+	hit(state,objects,0,20); hit(state,objects,1,12)
+	visual.update_light_props(state); fit(camera,visual,car); await capture("shrinking-hay-broken-wood")
+	check(float(state.prop_destruction[0][0]) > 0 and state.prop_destruction[1][0] == 0,"captures contain shrunken bale and canonically broken crate")
+	detail(camera,visual.light_instances[0]); await capture("worn-bale-detail")
+	detail(camera,visual.get_node("WoodFragments")); await capture("wood-debris-detail")
+	hit(state,objects,0,20); visual.update_light_props(state); fit(camera,visual,car); await capture("loose-hay-and-wood")
+	check(not visual.light_instances[0].visible and not visual.light_instances[1].visible,"fully destroyed cores are hidden")
+	check((visual.get_node("LooseHayFragments") as MultiMeshInstance3D).multimesh.instance_count > 0 and (visual.get_node("WoodFragments") as MultiMeshInstance3D).multimesh.instance_count == 6,"canonical scatter renders in two exact debris batches")
+	# Rehydrate a prepared scene containing damaged meshes and both batch buffers.
+	var cache = preload("res://track/prepared_world_cache.gd")
+	var key: Array = ["breakable-capture",track.content_hash]
+	cache.remember(key,visual,track)
+	var restored := NativeTrackVisual.new(); stage.add_child(restored)
+	check(cache.restore(key,restored),"prepared scenery includes breakable bindings")
+	visual.hide(); RewindHistory.restore(state,intact); restored.update_light_props(state)
+	check(restored.light_instances[0].visible and restored.light_instances[1].visible,"cached damaged cores restore intact after rewind")
+	check((restored.get_node("WoodFragments") as MultiMeshInstance3D).multimesh.instance_count == 0,"cached wood buffers clear for intact state")
+	fit(camera,restored,car); await capture("rewind-restored")
+	stage.queue_free(); await process_frame
+	var app: Node = load("res://core/app.gd").new()
+	var local: String = "user://breakable_capture_"+TrackLibrary.unique_id()
+	app.set("library",TrackLibrary.new(local)); app.set("records",LocalRecords.new(local+"/records.json"))
+	root.add_child(app); await process_frame
+	app.set("document",document); app.call("_show_screen","create"); await process_frame; app.call("_editor_category","objects")
+	var browser: ObjectBrowser = app.get("object_browser"); browser.category = "Props"; browser.page = 0; browser.choose("hay_bale")
+	for width: int in [1280,960]:
+		root.size = Vector2i(width,width*9/16); await frames(5); await capture("editor-palette-"+str(width))
+		check(root.get_visible_rect().encloses(browser.get_global_rect()),"new palette fits "+str(width))
+	var library: TrackLibrary = app.get("library")
+	check(library.save_document(document) == OK and library.load_document(document.id).objects == JSON.parse_string(JSON.stringify(document.objects)),"hay and existing crate kind save/reload exactly")
+	app.queue_free(); await process_frame
+	print("BREAKABLE_CAPTURE: %d checks, %d failures; %s" % [checks,failures,folder])
+	quit(1 if failures else 0)
+
+func fit(camera: Camera3D, visual: NativeTrackVisual, car: CarVisual) -> void:
+	var bounds: AABB = ObjectThumbnail._mesh_bounds(visual).merge(ObjectThumbnail._mesh_bounds(car))
+	var center: Vector3 = bounds.get_center()
+	camera.look_at_from_position(center+Vector3(9,14,19),center)
+	var low := Vector3(INF,INF,INF); var high := Vector3(-INF,-INF,-INF)
+	for i: int in range(8):
+		var point: Vector3 = camera.basis.transposed()*(bounds.get_endpoint(i)-center)
+		low = low.min(point); high = high.max(point)
+	var extent: Vector3 = high-low
+	camera.size = maxf(extent.y,extent.x/(1280.0/720))*1.25
+
+func detail(camera: Camera3D, node: Node3D) -> void:
+	var bounds: AABB = ObjectThumbnail._mesh_bounds(node)
+	var center: Vector3 = bounds.get_center()
+	camera.look_at_from_position(center+Vector3(9,14,19),center)
+	var low := Vector3(INF,INF,INF); var high := Vector3(-INF,-INF,-INF)
+	for i: int in range(8):
+		var point: Vector3 = camera.basis.transposed()*(bounds.get_endpoint(i)-center)
+		low = low.min(point); high = high.max(point)
+	var extent: Vector3 = high-low
+	camera.size = maxf(2.7,maxf(extent.y,extent.x/(1280.0/720))*1.22)
+	var in_frame: bool = true
+	for i: int in range(8):
+		if not root.get_visible_rect().has_point(camera.unproject_position(bounds.get_endpoint(i))): in_frame = false
+	check(in_frame,"actual projected detail bounds stay inside the captured viewport")
