+        target.write_text(source,encoding='utf-8',newline='\n')
+    git('add','-f','.')
+    git('commit','-q','-m','Bridge contact audio scoped baseline')
+    base = git('rev-parse','HEAD')
+for name in list(modified)+added:
+    target = repo/name
+    target.parent.mkdir(parents=True,exist_ok=True)
+    target.write_text(read(name),encoding='utf-8',newline='\n')
+git('add','-f','.')
+if resume: git('commit','-q','--amend','--no-edit')
+else: git('commit','-q','-m','Replace false bridge glass crashes with bounded soft body contacts')
+patch = subprocess.run(['git','-C',str(repo),'diff','--binary',base,'HEAD'],check=True,capture_output=True).stdout
+(out/'task-only.patch').write_bytes(patch)
