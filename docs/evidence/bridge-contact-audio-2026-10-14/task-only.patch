+    (root/name).write_text(source,encoding='utf-8',newline='\n')
+for name in ['game/vehicle/vehicle_audio.gd','game/vehicle/visible_contact_audio.gd']:
+    modified[name] = (out/'before'/name).read_text(encoding='utf-8')
+added = ['game/tests/test_bridge_contact_audio.gd','game/tests/test_bridge_audio_baseline.gd','game/tests/test_bridge_audio_baseline_wall.gd',
