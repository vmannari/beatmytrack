+from pathlib import Path
+import hashlib
+import json
+import wave
+import numpy as np
+
+root = Path(__file__).resolve().parents[1]
+out = root / 'docs/evidence/bridge-contact-audio-2026-10-14'
+
+def pcm(path):
+    with wave.open(str(path), 'rb') as stream:
+        rate = stream.getframerate()
+        assert stream.getsampwidth() == 2
+        samples = np.frombuffer(stream.readframes(stream.getnframes()), dtype='<i2').astype(float)/32768
+        return samples.reshape(-1, stream.getnchannels()), rate
+
+report = {'native': [], 'notes': 'Actual desktop mixer captures and deterministic event/source checks; no subjective or phone listening acceptance claim.'}
+before = json.loads((out/'before/gl_compatibility/bridge-sweeps.json').read_text())
+assert len(before) == 180 and all(row['physical_hits']==0 for row in before)
+report['baseline_false_crashes'] = sum(row['crash_sounds'] for row in before)
+assert report['baseline_false_crashes'] == 113
+for renderer in ['gl_compatibility', 'mobile']:
+    folder = out/'after'/renderer
+    rows = json.loads((folder/'bridge-sweeps.json').read_text())
+    assert len(rows) == 180
+    assert all(row['physical_hits']==0 and row['crash_sounds']==0 and row['bridge_cues']==2 for row in rows)
+    events = json.loads((folder/'native-events.json').read_text())
+    assert len(events)==2 and all(event['clip']=='chassis' and event['gain']<.23 for event in events)
+    mixed, rate = pcm(folder/'bridge-driving.wav')
+    body, _ = pcm(folder/'bridge-body.wav')
+    crash, _ = pcm(folder/'bridge-crash.wav')
+    peak = float(np.max(np.abs(mixed)))
+    assert .01<peak<.95, peak
+    assert float(np.max(np.abs(crash)))==0, 'Clear bridge must contain no glass/crash layer'
+    assert float(np.max(np.abs(body)))>.001, 'Replacement contact must be audible'
+    assert float(np.max(np.abs(mixed[-rate//5:])))==0, 'Final pause must be exactly silent'
+    report['native'].append(dict(renderer=renderer, sweeps=len(rows), soft_contacts=sum(row['bridge_cues'] for row in rows),
+                                 false_crashes=0, seconds=len(mixed)/rate, peak_dbfs=float(20*np.log10(peak)),
+                                 body_peak=float(np.max(np.abs(body))), crash_peak=0, pause_peak=0, events=events))
+old_crash, _ = pcm(out/'before/gl_compatibility/bridge-crash.wav')
+report['baseline_native_crash_peak'] = float(np.max(np.abs(old_crash)))
+assert report['baseline_native_crash_peak']>.01
+for item in json.loads((out/'audio-bank-before.json').read_text(encoding='utf-8-sig')):
+    assert hashlib.sha256(Path(item['Path']).read_bytes()).hexdigest().upper()==item['Hash'], item['Path']
+report['unchanged_bank_files'] = len(json.loads((out/'audio-bank-before.json').read_text(encoding='utf-8-sig')))
+(out/'audio-review.json').write_text(json.dumps(report,indent=2)+'\n', encoding='utf-8')
+print(json.dumps(report,indent=2))
