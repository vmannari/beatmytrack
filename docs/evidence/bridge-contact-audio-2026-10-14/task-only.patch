+         'docs/BRIDGE_CONTACT_AUDIO_2026_10_14.md','build/run_bridge_contact_audio.ps1','build/prepare_bridge_audio_baseline.py',
+         'build/review_bridge_contact_audio.py','build/checkpoint_bridge_contact_audio.py']
+
+def git(*args):
+    return subprocess.run(['git','-C',str(repo),*args],check=True,capture_output=True).stdout.decode().strip()
+
+resume = repo.exists()
+repo.mkdir(parents=True,exist_ok=True)
+if resume:
+    assert git('rev-list','--count','HEAD')=='2'
+    assert git('show','-s','--format=%s','HEAD^')=='Bridge contact audio scoped baseline'
