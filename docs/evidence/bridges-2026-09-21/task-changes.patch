+func _capture_ramp() -> void:
+	var world := Node3D.new()
+	root.add_child(world)
+	var span: Dictionary = RoadPieces.create("bridge",Vector2(-16,0),0,10)
+	span.length = 32.0
+	CreatorBridgeVisual.build(world,[span])
+	VisualGeometry.box(world,Vector3(90,0.1,60),Vector3(0,-0.1,0),VisualGeometry.material(Color("627157")))
+	var car := CarVisual.new()
+	world.add_child(car)
