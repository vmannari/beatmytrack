+		check(camera.zoom_multiplier > 1.0 and camera.zoom_multiplier < 1.01, "acceleration starts a gentle zoom at %d fps" % fps)
+		for frame: int in range(fps - 1): camera.follow(Vector2.ZERO, Vector2(0, 60), 0.0, 1.0 / fps)
