+		var outer_a: Vector3=center+Vector3(sin(a),0,cos(a))*outer_radius
+		var inner_b: Vector3=center+Vector3(sin(b),0,cos(b))*inner_radius
+		var outer_b: Vector3=center+Vector3(sin(b),0,cos(b))*outer_radius
