+++ b/game/tests/bake_car_detail_reductions.gd
@@ -0,0 +1,160 @@
+extends SceneTree
+## CLV02: export exact frame geometry, or stage verified index-only recipes.
+const Detail=preload("res://vehicle/car_detail_reduction.gd")
+const WORK: String="res://../build/car-detail-reduction-2026-11-14"
+const OUT: String="res://../docs/evidence/car-detail-reduction-2026-11-14"
+const Compact=preload("res://tests/support/car_static_reduction_bake.gd")
+var contexts: Dictionary={}
+var geometry_file: FileAccess
+var publish: bool=false
+var proposals: Dictionary={}
+var observations: Array=[]
+var current_car: CarVisual
+var stage_directory: String=WORK.path_join("staged")
+
+func _initialize() -> void: run.call_deferred()
+
+func packed_mesh(source: Mesh) -> ArrayMesh:
+	if source is ArrayMesh: return source
+	var packets: Array=[]
+	for surface: int in range(source.get_surface_count()):
+		var packet: Dictionary=RenderingServer.mesh_get_surface(source.get_rid(),surface)
+		packet.material=source.surface_get_material(surface)
+		packet.aabb=source.get_aabb()
+		packets.append(packet)
+	var result:=ArrayMesh.new()
+	result.set("_surfaces",packets)
+	result.custom_aabb=source.get_aabb()
+	return result
+
+func reduced(source: Mesh, surfaces: Dictionary) -> ArrayMesh:
+	var original: ArrayMesh=packed_mesh(source)
+	var packets: Array=original.get("_surfaces").duplicate(true)
+	for surface_text: String in surfaces:
+		var surface: int=int(surface_text)
+		var packet: Dictionary=packets[surface]
+		var arrays: Array=source.surface_get_arrays(surface)
+		var indices: PackedInt32Array=arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX]!=null else PackedInt32Array()
+		if indices.is_empty():
+			for index: int in range(arrays[Mesh.ARRAY_VERTEX].size()): indices.append(index)
+		var removed: Dictionary={}
+		for index: float in surfaces[surface_text]: removed[int(index)]=true
+		var keep:=PackedInt32Array()
+		for triangle: int in range(indices.size()/3):
+			if not removed.has(triangle): keep.append_array(indices.slice(triangle*3,triangle*3+3))
+		assert(not keep.is_empty())
+		var stride: int=2 if int(packet.vertex_count)<=65536 else 4
+		var raw:=PackedByteArray()
+		raw.resize(keep.size()*stride)
+		for at: int in range(keep.size()):
+			if stride==2: raw.encode_u16(at*stride,keep[at])
+			else: raw.encode_u32(at*stride,keep[at])
+		packet.index_data=raw;packet.index_count=keep.size()
+		packet.format=int(packet.format)|Mesh.ARRAY_FORMAT_INDEX
+		packet.erase("lods")
+	var result:=ArrayMesh.new()
+	result.set("_surfaces",packets)
+	result.custom_aabb=source.get_aabb()
+	return Compact.new().compact(result)
+
+func export_group(group: Dictionary) -> void:
+	if contexts.has(group.code): return
+	var rows: Array=[]
+	for entry: Dictionary in group.entries:
+		var part: MeshInstance3D=entry.part
+		var mesh: Mesh=part.mesh
+		var surfaces: Array=[]
+		for surface: int in range(mesh.get_surface_count()):
+			var arrays: Array=mesh.surface_get_arrays(surface)
+			var vertices: PackedVector3Array=arrays[Mesh.ARRAY_VERTEX]
+			for at: int in range(vertices.size()): vertices[at]=entry.pose*vertices[at]
+			var indices: PackedInt32Array=arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX]!=null else PackedInt32Array()
+			if indices.is_empty():
+				for at: int in range(vertices.size()): indices.append(at)
+			var vertex_offset: int=geometry_file.get_position()
+			geometry_file.store_buffer(vertices.to_byte_array())
+			var index_offset: int=geometry_file.get_position()
+			geometry_file.store_buffer(indices.to_byte_array())
+			surfaces.append({"vertex_offset":vertex_offset,"vertex_count":vertices.size(),"index_offset":index_offset,"index_count":indices.size()})
+		var physical_frame: Node3D=Detail.frame_for(current_car,part,false)
+		var role: String="body" if physical_frame==current_car.body else "wheel" if physical_frame in current_car.rolling_wheels or physical_frame in current_car.front_wheels or physical_frame in current_car.rear_wheels else str(physical_frame.name)
+		var shared: String=var_to_bytes([group.vehicle,entry.source,role,Detail.relative_pose(physical_frame,part)]).hex_encode().sha256_text()
+		rows.append({"ordinal":rows.size(),"code":entry.code,"source":entry.source,"shared":shared,"path":str(current_car.get_path_to(part)),"kind":mesh.get_class(),"frame":group.code,"surfaces":surfaces,"opaque":entry.opaque,"cull_mode":int(entry.state[0][2]) if entry.opaque else 0,"cast_shadow":part.cast_shadow,"layers":part.layers,"morphs":mesh.get_blend_shape_count() if mesh is ArrayMesh else 0,"triangles":mesh.get_faces().size()/3,"protected":entry.protected})
+	contexts[group.code]={"vehicle":group.vehicle,"code":group.code,"parts":rows}
+
+func stage_group(group: Dictionary) -> void:
+	if contexts.has(group.code) or not proposals.has(group.code): return
+	contexts[group.code]=true
+	var changes: Dictionary=proposals[group.code]
+	var parts: Dictionary={}
+	for entry: Dictionary in group.entries:
+		if not changes.has(entry.code): continue
+		assert(not entry.protected and entry.opaque)
+		var row: Dictionary=changes[entry.code]
+		var part: MeshInstance3D=entry.part
+		assert(part.mesh.get_faces().size()/3==int(row.before))
+		if row.hidden:
+			parts[entry.code]={"source":entry.source,"hidden":true}
+			continue
+		var result: ArrayMesh=reduced(part.mesh,row.surfaces)
+		if result.get_aabb()!=part.mesh.get_aabb(): printerr("DETAIL_BOUNDS ",part.name," ",part.mesh.get_class()," before=",part.mesh.get_aabb()," after=",result.get_aabb())
+		assert(result.get_aabb()==part.mesh.get_aabb())
+		assert(result.get_faces().size()/3==int(row.after))
+		result.set_meta("car_detail_source",entry.source)
+		# Active finishes belong to each instance. A valid inert fallback also
+		# keeps engine shader-parameter introspection safe during mesh replacement.
+		for surface: int in range(result.get_surface_count()): result.surface_set_material(surface,StandardMaterial3D.new())
+		var file: String=group.vehicle+"_"+entry.source+"_"+Detail.mesh_key(result).left(20)+".res"
+		assert(ResourceSaver.save(result,stage_directory.path_join(file),ResourceSaver.FLAG_COMPRESS)==OK)
+		parts[entry.code]={"source":entry.source,"mesh":file}
+	var recipe: Dictionary={"schema":Detail.SCHEMA,"context":group.code,"parts":parts}
+	var file: String=stage_directory.path_join(group.vehicle+"_"+group.code+".json")
+	FileAccess.open(file,FileAccess.WRITE).store_string(JSON.stringify(recipe,"\t"))
+	observations.append({"vehicle":group.vehicle,"context":group.code,"changed_parts":parts.size()})
+
+func collect(group: Dictionary) -> void:
+	if publish: stage_group(group)
+	else: export_group(group)
+
+func run() -> void:
+	publish="--stage" in OS.get_cmdline_user_args()
+	var selected: PackedStringArray=[]
+	for argument: String in OS.get_cmdline_user_args():
+		if argument.begins_with("--stage-dir="): stage_directory=argument.trim_prefix("--stage-dir=")
+		if argument.begins_with("--vehicles="): selected=argument.trim_prefix("--vehicles=").split(",")
+	assert(stage_directory.begins_with(WORK+"/staged"))
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(stage_directory))
+	if publish: proposals=JSON.parse_string(FileAccess.get_file_as_string(WORK.path_join("proposals.json")))
+	else: geometry_file=FileAccess.open(WORK.path_join("geometry.bin"),FileAccess.WRITE)
+	preload("res://vehicle/modular_car_base.gd").enabled=false
+	preload("res://vehicle/modular_car_kits.gd").enabled=false
+	preload("res://vehicle/prepared_car_cache.gd").enabled=false
+	preload("res://ui/garage_car_cache.gd").enabled=false
+	Detail.offline=collect
+	for id: String in VehicleCatalog.IDS:
+		if not selected.is_empty() and id not in selected: continue
+		for editable: bool in [false,true]:
+			var car:=CarVisual.new()
+			current_car=car
+			car.vehicle_id=id;car.editable_kits=editable;car.cache_rest_pose=false
+			car.livery=VehicleLivery.defaults(id)
+			root.add_child(car)
+			while not car.model_ready: await process_frame
+			if editable:
+				for category: String in VehicleCustomisation.CATEGORIES:
+					for option: Array in VehicleCustomisation.options(category,id).slice(1):
+						var selection: Dictionary=car.customisation.duplicate()
+						selection[category]=option[0]
+						car.change_kit_parts(selection)
+					var stock: Dictionary=car.customisation.duplicate()
+					stock[category]="stock"
+					car.change_kit_parts(stock)
+			car.free();await process_frame
+		print("DETAIL_CONTEXTS ",id," stage=",publish," count=",contexts.size())
+	Detail.offline=Callable()
+	if not publish:
+		geometry_file.close()
+		FileAccess.open(WORK.path_join("contexts.json"),FileAccess.WRITE).store_string(JSON.stringify(contexts))
+	else: FileAccess.open(OUT.path_join("recipes.json"),FileAccess.WRITE).store_string(JSON.stringify(observations,"\t"))
+	print("DETAIL_CONTEXTS_COMPLETE stage=",publish," contexts=",contexts.size())
+	quit()
diff --git a/game/tests/bake_compact_plate_texture.gd b/game/tests/bake_compact_plate_texture.gd
new file mode 100644
index 0000000000000000000000000000000000000000..a0a7f201c14eadc226e34ca467753fd82d468d19
--- /dev/null
+++ b/game/tests/bake_compact_plate_texture.gd
@@ -0,0 +1,58 @@
+extends SceneTree
+## CLV03: rasterise the existing licensed flat glyphs, with no generated artwork.
+const DIRECTORY: String="res://assets/vehicles/compact_plate_v1"
+func _initialize() -> void: bake.call_deferred()
+
+func bake() -> void:
+	var viewport:=SubViewport.new()
+	viewport.size=Vector2i(1024,512)
+	viewport.own_world_3d=true
+	viewport.render_target_update_mode=SubViewport.UPDATE_ALWAYS
+	viewport.msaa_3d=Viewport.MSAA_4X
+	root.add_child(viewport)
+	var world:=Node3D.new()
+	viewport.add_child(world)
+	var environment:=WorldEnvironment.new()
+	environment.environment=Environment.new()
+	environment.environment.background_mode=Environment.BG_COLOR
+	environment.environment.background_color=Color.BLACK
+	environment.environment.tonemap_mode=Environment.TONE_MAPPER_LINEAR
+	world.add_child(environment)
+	# Build only the exact existing TextMesh resources, without car construction.
+	var wrapper:=CarVisual.new()
+	wrapper.body=Node3D.new()
+	wrapper.add_child(wrapper.body)
+	var white:=StandardMaterial3D.new()
+	white.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
+	white.albedo_color=Color.WHITE
+	CompactRearDesign._text(wrapper,"RearPlateLetters","BMT 01",0.0020,Vector3(0,CompactRearDesign.PLATE_CENTER-0.010,2.129),white)
+	CompactRearDesign._text(wrapper,"RearPlateHeader","BEAT MY TRACK",0.00048,Vector3(0,CompactRearDesign.PLATE_CENTER+0.070,2.129),white)
+	wrapper.remove_child(wrapper.body)
+	world.add_child(wrapper.body)
+	wrapper.free()
+	var camera:=Camera3D.new()
+	camera.projection=Camera3D.PROJECTION_ORTHOGONAL
+	camera.size=0.206
+	camera.position=Vector3(0,CompactRearDesign.PLATE_CENTER,3)
+	world.add_child(camera)
+	camera.look_at(Vector3(0,CompactRearDesign.PLATE_CENTER,2))
+	camera.current=true
+	for frame: int in range(12): await process_frame;await RenderingServer.frame_post_draw
+	var image: Image=viewport.get_texture().get_image()
+	image.resize(512,256,Image.INTERPOLATE_LANCZOS)
+	image.convert(Image.FORMAT_L8)
+	var covered: int=0
+	for value: int in image.get_data():
+		if value>127: covered+=1
+	if covered<100 or covered>512*256/2:
+		push_error("Plate glyph coverage invalid: "+str(covered));quit(1);return
+	image.generate_mipmaps()
+	DirAccess.make_dir_recursive_absolute(DIRECTORY)
+	for entry: Array in [["ink",image]]:
+		var texture:=ImageTexture.create_from_image(entry[1])
+		var error: Error=ResourceSaver.save(texture,DIRECTORY.path_join(entry[0]+".res"),ResourceSaver.FLAG_COMPRESS)
+		if error!=OK: push_error("Plate bake failed "+str(error));quit(1);return
+	image.save_png("res://../docs/evidence/car-detail-reduction-2026-11-14/plate-ink.png")
+	viewport.queue_free();await process_frame
+	print("PLATE_TEXTURE 512x256 L8 with mipmaps; source BarlowCondensed-SemiBold.ttf; exact existing TextMesh placement")
+	quit()
diff --git a/game/tests/capture_car_detail_baseline.gd b/game/tests/capture_car_detail_baseline.gd
new file mode 100644
index 0000000000000000000000000000000000000000..45ecb8b25a2cd67fbb8b5961df3e5dc9d007208a
--- /dev/null
+++ b/game/tests/capture_car_detail_baseline.gd
@@ -0,0 +1,72 @@
+extends "res://tests/measure_car_simplification.gd"
+## CLV01: self-contained visual models; never restore old production assets.
+const DETAIL_WORK: String="res://../build/car-detail-reduction-2026-11-14"
+const DETAIL_OUT: String="res://../docs/evidence/car-detail-reduction-2026-11-14"
+var detail_rows: Array=[]
+
+func _initialize() -> void: capture_detail_baseline.call_deferred()
+
+func detach_snapshot(car: CarVisual) -> Node3D:
+	var holder: Node3D=car.duplicate()
+	holder.set_script(null)
+	var meshes: Dictionary={}
+	var materials: Dictionary={}
+	for part: MeshInstance3D in holder.find_children("*","MeshInstance3D",true,false):
+		if part.mesh==null: continue
+		if not meshes.has(part.mesh):
+			var mesh: Mesh=part.mesh.duplicate()
+			if part.mesh is ImmediateMesh:
+				var converted:=ArrayMesh.new()
+				for surface: int in range(part.mesh.get_surface_count()):
+					converted.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,part.mesh.surface_get_arrays(surface))
+					converted.surface_set_material(surface,part.mesh.surface_get_material(surface))
+				mesh=converted
+			for surface: int in range(mesh.get_surface_count()):
+				var material: Material=mesh.surface_get_material(surface)
+				if material==null: continue
+				if not materials.has(material): materials[material]=material.duplicate()
+				mesh.surface_set_material(surface,materials[material])
+			meshes[part.mesh]=mesh
+		part.mesh=meshes[part.mesh]
+		var override: Material=part.material_override
+		if override!=null:
+			if not materials.has(override): materials[override]=override.duplicate()
+			part.material_override=materials[override]
+		for surface: int in range(part.mesh.get_surface_count()):
+			var override_surface: Material=part.get_surface_override_material(surface)
+			if override_surface==null: continue
+			if not materials.has(override_surface): materials[override_surface]=override_surface.duplicate()
+			part.set_surface_override_material(surface,materials[override_surface])
+	for child: Node in holder.find_children("*","Node",true,false): child.owner=holder
+	return holder
+
+func capture_detail_baseline() -> void:
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(DETAIL_WORK))
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(DETAIL_OUT))
+	for id: String in VehicleCatalog.IDS:
+		for mode: String in ["stock","fitted","full"]:
+			var car:=CarVisual.new()
+			car.vehicle_id=id;car.simple_model=mode!="full";car.cache_rest_pose=false
+			car.customisation=VehicleCustomisation.defaults();car.livery=VehicleLivery.defaults(id)
+			if mode=="fitted":
+				for category: String in VehicleCustomisation.CATEGORIES: car.customisation[category]=VehicleCustomisation.options(category,id)[-1][0]
+			var hits: int=Base.hits
+			var kit_hits: int=Kits.hits
+			root.add_child(car)
+			while not car.model_ready: await process_frame
+			check(Base.hits==hits+1,"baseline actual prepared base "+id+mode)
+			if mode=="fitted": check(Kits.hits==kit_hits+4,"baseline four fitted hits "+id)
+			var row: Dictionary={"vehicle":id,"mode":mode,"inventory":inventory(car,false),"selection":car.customisation.duplicate()}
+			var holder: Node3D=detach_snapshot(car)
+			var scene:=PackedScene.new()
+			check(scene.pack(holder)==OK,"baseline scene pack")
+			var path: String=DETAIL_WORK.path_join(id+"-"+mode+"-before.scn")
+			check(ResourceSaver.save(scene,path,ResourceSaver.FLAG_COMPRESS)==OK,"baseline detached scene save")
+			holder.free()
+			row["scene"]=path
+			detail_rows.append(row)
+			print("DETAIL_BASELINE ",id," ",mode," triangles=",row.inventory.triangles)
+			car.free();await process_frame
+	FileAccess.open(DETAIL_OUT.path_join("before.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures,"rows":detail_rows},"\t"))
+	print("DETAIL_BASELINE_COMPLETE ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/capture_car_detail_editable_before.gd b/game/tests/capture_car_detail_editable_before.gd
new file mode 100644
index 0000000000000000000000000000000000000000..24a35a33992cefe00d1069986265a1a5e983b013
--- /dev/null
+++ b/game/tests/capture_car_detail_editable_before.gd
@@ -0,0 +1,26 @@
+extends SceneTree
+## Original editable prepared bases are still untouched before the refresh.
+const OUT: String="res://../docs/evidence/car-detail-reduction-2026-11-14"
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	var controls: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(OUT.path_join("before-controls.json")))
+	var rows: Array=[]
+	var failures: int=0
+	for id: String in VehicleCatalog.IDS:
+		var path: String="res://assets/vehicles/modular_car_bases_v1/"+id+"_simple_editable.scn"
+		var holder: Node3D=load(path).instantiate()
+		var data: Dictionary=holder.get_meta("modular_car_base",{})
+		for file: String in ["game/vehicle/car_visual.gd","game/vehicle/racing_car_models.gd","game/vehicle/compact_rear_design.gd","game/vehicle/prepared_asset_dependencies.json"]:
+			if id not in preload("res://vehicle/prepared_asset_sources.gd").vehicles_for(file): continue
+			if data.get("sources",{}).get(file,"")!=controls.sources[file]:
+				failures+=1;printerr("EDITABLE_BEFORE_SOURCE_MISMATCH ",id," ",file)
+		root.add_child(holder)
+		var triangles: int=0;var surfaces: int=0
+		for part: MeshInstance3D in holder.find_children("*","MeshInstance3D",true,false):
+			if part.mesh==null or not part.is_visible_in_tree() or part.cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY: continue
+			triangles+=part.mesh.get_faces().size()/3;surfaces+=part.mesh.get_surface_count()
+		rows.append({"vehicle":id,"triangles":triangles,"surfaces":surfaces,"scene_sha256":FileAccess.get_sha256(path),"recorded_before_sources_match":failures==0})
+		print("EDITABLE_BEFORE ",id," triangles=",triangles," surfaces=",surfaces)
+		holder.free()
+	FileAccess.open(OUT.path_join("editable-before.json"),FileAccess.WRITE).store_string(JSON.stringify({"failures":failures,"rows":rows},"\t"))
+	quit(1 if failures else 0)
diff --git a/game/tests/capture_car_detail_models.gd b/game/tests/capture_car_detail_models.gd
new file mode 100644
index 0000000000000000000000000000000000000000..bcaea4935498f4bea2dbb64c9ab381e3039d78d4
--- /dev/null
+++ b/game/tests/capture_car_detail_models.gd
@@ -0,0 +1,172 @@
+extends SceneTree
+## CLV03/CLV04: paired detached baselines and current source/prepared models.
+const WORK: String="res://../build/car-detail-reduction-2026-11-14"
+const OUT: String="res://../docs/evidence/car-detail-reduction-2026-11-14"
+const Base=preload("res://vehicle/modular_car_base.gd")
+const Kits=preload("res://vehicle/modular_car_kits.gd")
+var checks: int=0
+var failures: int=0
+var pairs: Array=[]
+
+func _initialize() -> void: capture.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks+=1
+	if not ok: failures+=1;printerr("DETAIL_NATIVE_FAIL ",label)
+
+func triangles(node: Node) -> int:
+	var total: int=0
+	if node is MeshInstance3D and node.is_visible_in_tree() and node.cast_shadow!=GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY: total+=node.mesh.get_faces().size()/3
+	for child: Node in node.get_children(): total+=triangles(child)
+	return total
+
+func settle(view: CarShowroom) -> void:
+	view.invalidate_render()
+	for frame: int in range(8): await process_frame;await RenderingServer.frame_post_draw
+
+func crop(models: Array, camera: Camera3D, size: Vector2i) -> Array:
+	var low:=Vector2(INF,INF);var high:=Vector2(-INF,-INF)
+	for model: Node3D in models:
+		var parts: Array=model.find_children("*","MeshInstance3D",true,false)
+		if model is MeshInstance3D: parts.append(model)
+		for part: MeshInstance3D in parts:
+			if part.mesh==null or not part.visible or part.cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY: continue
+			for corner: int in range(8):
+				var pixel: Vector2=camera.unproject_position(part.global_transform*part.mesh.get_aabb().get_endpoint(corner))
+				low=low.min(pixel);high=high.max(pixel)
+	var rectangle:=Rect2i(Vector2i(low.floor())-Vector2i(8,8),Vector2i((high-low).ceil())+Vector2i(17,17)).intersection(Rect2i(Vector2i.ZERO,size))
+	return [rectangle.position.x,rectangle.position.y,rectangle.size.x,rectangle.size.y]
+
+func pair(view: CarShowroom, before_model: Node3D, after_model: Node3D, label: String, directory: String) -> Dictionary:
+	before_model.show();after_model.hide()
+	await settle(view)
+	var before: Image=view.showroom_viewport.get_texture().get_image()
+	var stable: bool=false
+	var repeated: Image=before
+	for attempt: int in range(4):
+		await settle(view)
+		repeated=before
+		var next: Image=view.showroom_viewport.get_texture().get_image()
+		stable=before.get_data()==next.get_data();before=next
+		if stable: break
+	check(stable,"stable reference "+label)
+	var prior: int=view.showroom_viewport.get_render_info(Viewport.RENDER_INFO_TYPE_VISIBLE,Viewport.RENDER_INFO_PRIMITIVES_IN_FRAME)
+	before_model.hide();after_model.show()
+	await settle(view)
+	var after: Image=view.showroom_viewport.get_texture().get_image()
+	var current: int=view.showroom_viewport.get_render_info(Viewport.RENDER_INFO_TYPE_VISIBLE,Viewport.RENDER_INFO_PRIMITIVES_IN_FRAME)
+	after_model.hide();before_model.show()
+	await settle(view)
+	var restored: Image=view.showroom_viewport.get_texture().get_image()
+	for attempt: int in range(4):
+		if before.get_data()==restored.get_data(): break
+		await settle(view);restored=view.showroom_viewport.get_texture().get_image()
+	var exact: bool=before.get_data()==restored.get_data()
+	check(exact,"exact restoration "+label)
+	check(before.save_png(directory.path_join(label+"-before.png"))==OK,"before image")
+	check(after.save_png(directory.path_join(label+"-after.png"))==OK,"after image")
+	if not stable: repeated.save_png(directory.path_join(label+"-repeat.png"))
+	if not exact: restored.save_png(directory.path_join(label+"-restored.png"))
+	before_model.show();after_model.show()
+	var rectangle: Array=crop([before_model,after_model],view.camera,view.showroom_viewport.size)
+	before_model.hide()
+	return {"label":label,"crop":rectangle,"before_image":label+"-before.png","after_image":label+"-after.png","stable_reference":stable,"restored_exact":exact,"repeat_image":label+"-repeat.png" if not stable else "","restoration_image":label+"-restored.png" if not exact else "","visible_primitives_before":prior,"visible_primitives_after":current}
+
+func ghost_for(model: Node3D) -> MeshInstance3D:
+	var tool:=SurfaceTool.new()
+	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
+	PersonalGhost._append_meshes(model,model.global_transform.affine_inverse(),tool)
+	tool.generate_normals();tool.index()
+	var ghost:=MeshInstance3D.new()
+	ghost.mesh=tool.commit();ghost.transform=model.transform
+	ghost.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	var material:=ShaderMaterial.new()
+	material.shader=PersonalGhost.finish_shader();ghost.material_override=material
+	return ghost
+
+func capture() -> void:
+	Engine.time_scale=0.0
+	var source: bool="--source" in OS.get_cmdline_user_args()
+	var rgb_probe: bool="--rgb-plate-probe" in OS.get_cmdline_user_args()
+	Base.enabled=not source;Kits.enabled=not source
+	preload("res://vehicle/prepared_car_cache.gd").enabled=not source
+	preload("res://ui/garage_car_cache.gd").enabled=false
+	var directory: String=OUT.path_join(("source-" if source else "prepared-")+RenderingServer.get_current_rendering_method()+("-rgb-probe" if rgb_probe else ""))
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(directory))
+	for id: String in VehicleCatalog.IDS:
+		var only: String=""
+		for argument: String in OS.get_cmdline_user_args():
+			if argument.begins_with("--vehicle="): only=argument.trim_prefix("--vehicle=")
+		if not only.is_empty() and only!=id: continue
+		for mode: String in (["stock"] if "--stock-only" in OS.get_cmdline_user_args() else ["stock","fitted"]):
+			var view:=CarShowroom.new()
+			view.vehicle_id=id;view.simple_model=true;view.read_only=true;view.size=Vector2(1000,760)
+			view.livery=VehicleLivery.defaults(id);view.customisation=VehicleCustomisation.defaults()
+			if mode=="fitted":
+				for category: String in VehicleCustomisation.CATEGORIES: view.customisation[category]=VehicleCustomisation.options(category,id)[-1][0]
+			var hits: int=Base.hits
+			var kit_hits: int=Kits.hits
+			root.add_child(view)
+			while not view.showroom_ready or not view.car.model_ready: await process_frame
+			if rgb_probe:
+				for part: MeshInstance3D in view.car.find_children("*","MeshInstance3D",true,false):
+					for surface: int in range(part.mesh.get_surface_count()):
+						var material: Material=part.get_active_material(surface)
+						if not material is StandardMaterial3D or material.albedo_texture==null or "compact_plate_v1" not in material.albedo_texture.resource_path: continue
+						var replacement: StandardMaterial3D=material.duplicate()
+						var paper: Image=material.albedo_texture.get_image();paper.convert(Image.FORMAT_RGB8)
+						var ink: Image=material.emission_texture.get_image();ink.convert(Image.FORMAT_RGB8)
+						replacement.albedo_texture=ImageTexture.create_from_image(paper)
+						replacement.emission_texture=ImageTexture.create_from_image(ink)
+						part.set_surface_override_material(surface,replacement)
+						part.material_override=null
+						print("PLATE_RGB_PROBE ",part.name," ",part.get_active_material(surface)," uv_scale=",replacement.uv1_scale)
+			if "--uv-plate-probe" in OS.get_cmdline_user_args():
+				for part: MeshInstance3D in view.car.find_children("*","MeshInstance3D",true,false):
+					if str(part.name)!="RearPlateFace": continue
+					print("PLATE_UV_PROBE material=",part.get_active_material(0))
+					var material:=ShaderMaterial.new()
+					var shader:=Shader.new()
+					shader.code="shader_type spatial; render_mode unshaded; uniform sampler2D paper: filter_linear_mipmap; void fragment(){ ALBEDO=texture(paper,UV).rrr; }"
+					material.shader=shader
+					material.set_shader_parameter("paper",(part.get_active_material(0) as StandardMaterial3D).albedo_texture)
+					part.material_override=material
+			if not source:
+				check(Base.hits==hits+1,"actual prepared base "+id+mode)
+				if mode=="fitted": check(Kits.hits==kit_hits+4,"actual four fitted modules "+id)
+			var old: Node3D=load(WORK.path_join(id+"-"+mode+"-before.scn")).instantiate()
+			view.car.get_parent().add_child(old)
+			# The detached baseline was captured outside a showroom. Give its
+			# original glazing the same studio uniforms as the current car.
+			ShowroomStudio._studio_glass(old,{})
+			old.show();view.car.show()
+			var before_count: int=triangles(old);var after_count: int=triangles(view.car)
+			var key: DirectionalLight3D=view.car.get_parent().find_child("StudioKey",true,false)
+			key.shadow_enabled=true
+			var soft_shadow: Node3D=view.car.get_parent().find_child("PreparedStudioShadow",true,false)
+			soft_shadow.hide()
+			var views: Array=[["front",-0.70,0.31,1.15],["rear",2.45,0.31,1.15],["distance",-0.4,1.02,3.1]]
+			if id=="compact": views.append(["plate",PI,0.13,0.48])
+			for shot: Array in views:
+				view.yaw=shot[1];view.elevation=shot[2];view.zoom=shot[3];view._orbit()
+				if shot[0]=="plate":
+					view.camera.position=Vector3(0,CompactRearDesign.PLATE_CENTER,3.2)*HandlingConfig.BODY_SCALE
+					view.camera.look_at(Vector3(0,CompactRearDesign.PLATE_CENTER,2.127)*HandlingConfig.BODY_SCALE)
+				var row: Dictionary=await pair(view,old,view.car,id+"-"+mode+"-"+shot[0],directory)
+				row.merge({"vehicle":id,"mode":mode,"view":shot[0],"master_before":before_count,"master_after":after_count,"real_shadows":true})
+				pairs.append(row)
+			if mode=="stock" and "--stock-only" not in OS.get_cmdline_user_args():
+				old.show();view.car.show()
+				var before_ghost: MeshInstance3D=ghost_for(old)
+				var after_ghost: MeshInstance3D=ghost_for(view.car)
+				view.car.get_parent().add_child(before_ghost);view.car.get_parent().add_child(after_ghost)
+				old.hide();view.car.hide();key.shadow_enabled=false
+				view.yaw=-0.4;view.elevation=1.02;view.zoom=3.1;view._orbit()
+				var row: Dictionary=await pair(view,before_ghost,after_ghost,id+"-ghost-distance",directory)
+				row.merge({"vehicle":id,"mode":"ghost","view":"distance","master_before":before_ghost.mesh.get_faces().size()/3,"master_after":after_ghost.mesh.get_faces().size()/3,"real_shadows":false})
+				pairs.append(row)
+				before_ghost.free();after_ghost.free()
+			view.free();await process_frame
+		print("DETAIL_NATIVE ",id," pairs=",pairs.size())
+	FileAccess.open(directory.path_join("comparisons.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures,"pairs":pairs},"\t"))
+	print("DETAIL_NATIVE_COMPLETE ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/finalize_car_detail_materials.gd b/game/tests/finalize_car_detail_materials.gd
new file mode 100644
index 0000000000000000000000000000000000000000..7ea6043629d0a839b3a9ecc035a5502362936988
--- /dev/null
+++ b/game/tests/finalize_car_detail_materials.gd
@@ -0,0 +1,31 @@
+extends SceneTree
+## Finalise immutable recipe resources; ordered geometry bytes stay exact.
+const Detail=preload("res://vehicle/car_detail_reduction.gd")
+const WORK: String="res://../build/car-detail-reduction-2026-11-14/material-stage"
+const OUT: String="res://../docs/evidence/car-detail-reduction-2026-11-14/material-finalisation.json"
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(WORK))
+	var rows: Array=[]
+	for file: String in DirAccess.get_files_at(Detail.ROOT):
+		if not file.ends_with(".res"): continue
+		var path: String=Detail.ROOT.path_join(file)
+		var mesh: ArrayMesh=load(path)
+		var before: String=Detail.mesh_key(mesh)
+		var packets: Array=mesh.get("_surfaces").duplicate(true)
+		var missing: int=0
+		for surface: int in range(mesh.get_surface_count()):
+			if mesh.surface_get_material(surface)==null: missing+=1
+			mesh.surface_set_material(surface,StandardMaterial3D.new())
+		var exact: bool=true
+		for surface: int in range(packets.size()):
+			var after: Dictionary=mesh.get("_surfaces")[surface].duplicate()
+			var original: Dictionary=packets[surface].duplicate()
+			after.erase("material");original.erase("material")
+			exact=exact and var_to_bytes(after)==var_to_bytes(original)
+		assert(exact)
+		assert(ResourceSaver.save(mesh,WORK.path_join(file),ResourceSaver.FLAG_COMPRESS)==OK)
+		rows.append({"file":file,"source_sha256":FileAccess.get_sha256(path),"geometry_key":before,"exact_geometry":exact,"missing_intrinsic_materials":missing,"staged_sha256":FileAccess.get_sha256(WORK.path_join(file))})
+	FileAccess.open(OUT,FileAccess.WRITE).store_string(JSON.stringify(rows,"\t"))
+	print("DETAIL_MATERIAL_FINALISE ",rows.size()," exact geometry resources")
+	quit()
diff --git a/game/tests/measure_car_detail_results.gd b/game/tests/measure_car_detail_results.gd
