diff --git a/game/tests/test_car_loading_native_pairs.gd b/game/tests/test_car_loading_native_pairs.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_car_loading_native_pairs.gd
@@ -0,0 +1,102 @@
+extends SceneTree
+## Isolate this pass under the current finish, including concurrent art edits.
+const OUT: String="res://../docs/evidence/car-loading-improvements-2026-11-13/paired/"
+var checks: int=0
+var failures: int=0
+var rows: Array=[]
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, message: String) -> void:
+	checks+=1
+	if not ok: failures+=1;printerr("CAR_LOADING_NATIVE_FAIL ",message)
+func settle(view: CarShowroom) -> void:
+	view.invalidate_render()
+	for frame: int in range(16): await process_frame;await RenderingServer.frame_post_draw
+func difference(a: Image,b: Image) -> Dictionary:
+	a.convert(Image.FORMAT_RGBA8);b.convert(Image.FORMAT_RGBA8)
+	var x: PackedByteArray=a.get_data()
+	var y: PackedByteArray=b.get_data()
+	var changed: int=0
+	var significant: int=0
+	var total: int=0
+	var peak: int=0
+	if x!=y:
+		for at: int in range(0,x.size(),4):
+			var delta: int=0
+			for channel: int in range(3):
+				var value: int=absi(int(x[at+channel])-int(y[at+channel]))
+				total+=value;delta=maxi(delta,value)
+			if delta>0: changed+=1
+			if delta>8: significant+=1
+			peak=maxi(peak,delta)
+	return {"exact":x==y,"changed_pixels":changed,"significant_pixels":significant,"max_delta":peak,"mean_255":float(total)/(a.get_width()*a.get_height()*3)}
+func switch_meshes(changes: Dictionary, on: bool, car: CarVisual, input: float) -> void:
+	for node: MeshInstance3D in changes:
+		node.mesh=changes[node][1 if on else 0]
+		for surface: int in range(node.mesh.get_surface_count()): node.set_surface_override_material(surface,changes[node][2][surface])
+	var fixed: MeshInstance3D=car.find_child("DriverStaticSuit",true,false)
+	if fixed!=null: fixed.visible=not on
+	if car.vehicle_id=="kart":
+		preload("res://vehicle/kart_steering.gd").present(car.find_child("SteeringAssembly",true,false),car.find_child("TomkartDriver",true,false),input)
+func pair(view: CarShowroom,changes: Dictionary,label: String,input: float) -> void:
+	switch_meshes(changes,true,view.car,input)
+	var reference: Image
+	var stable: bool=false
+	# First-use Vulkan lighting can finish after the model-ready notification.
+	# Require repeated real draws to converge; retain a bounded failure path.
+	for attempt: int in range(8):
+		await settle(view)
+		var candidate: Image=view.showroom_viewport.get_texture().get_image()
+		if reference!=null and reference.get_data()==candidate.get_data(): stable=true;reference=candidate;break
+		reference=candidate
+	check(stable,"stable reference "+label)
+	switch_meshes(changes,false,view.car,input)
+	await settle(view)
+	var result: Image=view.showroom_viewport.get_texture().get_image()
+	var delta: Dictionary=difference(reference,result)
+	delta["view"]=label
+	rows.append(delta)
+	# Keep exactness as a diagnostic. Morph/static GPU paths can round an
+	# otherwise encoded-identical point differently. Use the existing vehicle
+	# appearance bounds from test_vehicle_mesh_simplification.gd unchanged.
+	check(delta.mean_255<0.25,"retained appearance energy "+label)
+	check(float(delta.significant_pixels)/(reference.get_width()*reference.get_height())<0.005,"retained visible-pixel bound "+label)
+	switch_meshes(changes,true,view.car,input)
+	await settle(view)
+	var restored: Dictionary=difference(reference,view.showroom_viewport.get_texture().get_image())
+	check(restored.max_delta<=1,"reference restored "+label)
+	delta["restoration"]=restored
+	reference.save_png(OUT+RenderingServer.get_current_rendering_method()+"/"+label+"-reference.png")
+	result.save_png(OUT+RenderingServer.get_current_rendering_method()+"/"+label+"-optimised.png")
+func run() -> void:
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT+RenderingServer.get_current_rendering_method()))
+	for id: String in ["compact","kart","forklift","electric","hovercraft"]:
+		var view := CarShowroom.new()
+		view.vehicle_id=id;view.simple_model=true;view.read_only=true
+		view.livery=VehicleLivery.defaults(id);view.customisation=VehicleCustomisation.defaults()
+		view.size=Vector2(1000,760)
+		var prior_hits: int=preload("res://vehicle/modular_car_base.gd").hits
+		root.add_child(view)
+		while not view.showroom_ready or not view.car.model_ready: await process_frame
+		check(preload("res://vehicle/modular_car_base.gd").hits==prior_hits+1,"actual current prepared base "+id)
+		var changes: Dictionary={}
+		for node: MeshInstance3D in view.car.find_children("*","MeshInstance3D",true,false):
+			var materials: Array=[]
+			for surface: int in range(node.mesh.get_surface_count()): materials.append(node.get_active_material(surface))
+			var reference: Mesh=node.mesh.duplicate()
+			if str(node.name)=="TomkartDriver": reference=load("res://assets/vehicles/kart_refined_v1/tomkart_driver_v1/driver.res")
+			changes[node]=[node.mesh,reference,materials]
+		for shot: Array in [["front",-0.70,0.31],["rear",2.45,0.31],["side",-PI/2,0.15],["overhead",-0.4,1.02]]:
+			view.yaw=shot[1];view.elevation=shot[2];view.zoom=1.05 if id in ["compact","forklift"] else 0.85
+			view._orbit()
+			await pair(view,changes,id+"-"+shot[0],0.0)
+		if id=="kart":
+			for input: float in [-1.0,-0.5,0.0,0.5,1.0]:
+				for shot: Array in [["cockpit",-0.7,0.5],["overhead",-0.4,1.02]]:
+					view.yaw=shot[1];view.elevation=shot[2];view.zoom=0.66
+					view._orbit()
+					await pair(view,changes,"kart-steer-"+shot[0]+"-"+str(input),input)
+		view.free()
+		await process_frame
+	FileAccess.open(OUT+RenderingServer.get_current_rendering_method()+"/report.json",FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures,"rows":rows},"\t"))
+	print("CAR_LOADING_NATIVE ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/test_car_loading_app.gd b/game/tests/test_car_loading_app.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_car_loading_app.gd
@@ -0,0 +1,83 @@
+extends SceneTree
+## Actual five-car Garage/race integration in disposable local storage.
+var checks: int = 0
+var failures: int = 0
+var output: String
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks+=1
+	if not ok: failures+=1; printerr("SIMPLIFIED_APP_FAIL ",label)
+func settle(frames: int = 10) -> void:
+	for frame: int in range(frames):
+		await process_frame
+		await RenderingServer.frame_post_draw
+func triangles(node: Node) -> int:
+	var count: int = 0
+	if node is MeshInstance3D and node.is_visible_in_tree() and node.cast_shadow!=GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY: count+=node.mesh.get_faces().size()/3
+	for child: Node in node.get_children(): count+=triangles(child)
+	return count
+func run() -> void:
+	OS.set_environment("BMT_API_URL","")
+	output="res://../docs/evidence/car-loading-improvements-2026-11-13/app-"+RenderingServer.get_current_rendering_method()
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output))
+	root.size=Vector2i(1280,720)
+	for id: String in ["compact","kart","forklift","electric","hovercraft"]:
+		var folder: String = ProjectSettings.globalize_path("res://../build/car-loading-improvements-2026-11-13/app/"+TrackLibrary.unique_id())
+		DirAccess.make_dir_recursive_absolute(folder)
+		var app: Node = load("res://core/app.tscn").instantiate()
+		app.records=LocalRecords.new(folder.path_join("records.json"))
+		app.records.settings.selected_car=id
+		app.library=TrackLibrary.new(folder)
+		app.cloud_root_override=folder.path_join("cloud")
+		root.add_child(app)
+		while not app.startup_complete: await process_frame
+		VehicleCatalog.selected=id
+		app._show_screen("garage")
+		await settle()
+		var page: GaragePage = app.root_ui.find_child("GaragePage",true,false)
+		check(page!=null,"actual Garage loads "+id)
+		page.open_car(VehicleCatalog.IDS.find(id))
+		while not page.showroom.showroom_ready or not page.showroom.car.model_ready: await process_frame
+		while page.showroom.get("preparing")==true: await process_frame
+		await settle()
+		check(page.showroom.car.vehicle_id==id,"Garage car identity "+id)
+		var direct := CarVisual.new()
+		direct.vehicle_id=id
+		root.add_child(direct)
+		while not direct.model_ready: await process_frame
+		check(triangles(page.showroom.car)==triangles(direct),"current Garage/direct geometry "+id)
+		var expected_triangles: int = triangles(direct)
+		direct.free()
+		check(root.get_texture().get_image().save_png(output+"/"+id+"-garage.png")==OK,"Garage capture "+id)
+		var track: NativeTrack = NativeTrack.read("res://resources/tracks/ellipse.json")
+		await app._start_race(track,true,true)
+		await settle(20)
+		var game: Node = app.game
+		game.set_physics_process(false)
+		game.countdown_label.hide()
+		check(game.handling.vehicle_id==id and game.car.vehicle_id==id,"race car and handling identity "+id)
+		check(game.handling.snapshot()==VehicleCatalog.config(id).snapshot(),"complete canonical race tune "+id)
+		check(triangles(game.car)==expected_triangles,"race retains current production geometry "+id)
+		if id=="kart":
+			var wheel: Node3D = game.car.find_child("SteeringAssembly",true,false)
+			var driver: MeshInstance3D = game.car.find_child("TomkartDriver",true,false)
+			for input: float in [-1.0,0.0,1.0,0.0]:
+				# A window can lose focus during parallel native runs. Advance the
+				# fixture tick so the paused-presentation cache sees changed state.
+				game.sim.state.tick+=1
+				game.sim.state.steering=input
+				game._present_frame(1.0/60.0)
+				check(wheel.basis.is_equal_approx(preload("res://vehicle/kart_steering.gd").REST*Basis(Vector3.UP,-input*PI/3)),"actual race steering wheel")
+				var weight: float = 0
+				for shape: int in range(driver.mesh.get_blend_shape_count()): weight+=driver.get_blend_shape_value(shape)
+				check(is_equal_approx(weight,absf(input)),"actual race ten-pose driver")
+		check(root.get_texture().get_image().save_png(output+"/"+id+"-race.png")==OK,"race capture "+id)
+		app.queue_free()
+		app=null
+		await settle(12)
+		print("CAR_SIMPLIFICATION_APP_CAR ",id)
+	FileAccess.open(output+"/report.json",FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures}))
+	load("res://soundtrack/audio_world.gd").instance().queue_free()
+	await settle(18)
+	print("CAR_SIMPLIFICATION_APP ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/measure_car_loading_assets.gd b/game/tests/measure_car_loading_assets.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/measure_car_loading_assets.gd
@@ -0,0 +1,49 @@
+extends SceneTree
+## Read the stored assemblies directly; this does not prewarm the App benchmark.
+const OUT: String="res://../docs/evidence/car-loading-improvements-2026-11-13/"
+func _initialize() -> void: run.call_deferred()
+func payload(mesh: Mesh) -> int:
+	var bytes: int=0
+	for surface: int in range(mesh.get_surface_count()):
+		var packet: Dictionary=mesh.get("_surfaces")[surface] if mesh is ArrayMesh else RenderingServer.mesh_get_surface(mesh.get_rid(),surface)
+		for field: String in ["vertex_data","attribute_data","skin_data","index_data","blend_shapes"]: bytes+=packet.get(field,PackedByteArray()).size()
+		var lods: Array=packet.get("lods",[])
+		for at: int in range(1,lods.size(),2): bytes+=lods[at].size()
+	return bytes
+func dependencies(path: String, result: Dictionary) -> void:
+	if result.has(path): return
+	result[path]=FileAccess.get_file_as_bytes(path).size()
+	for declaration: String in ResourceLoader.get_dependencies(path):
+		var file: String=declaration.split("::")[-1]
+		if file.begins_with("res://") and FileAccess.file_exists(file): dependencies(file,result)
+func run() -> void:
+	var phase: String="after"
+	for arg: String in OS.get_cmdline_user_args():
+		if arg.begins_with("--phase="): phase=arg.trim_prefix("--phase=")
+	var rows: Array=[]
+	for id: String in ["compact","kart","forklift","electric","hovercraft"]:
+		for quality: String in ["simple","full"]:
+			for mode: String in ["fixed","editable"]:
+				var path: String="res://assets/vehicles/modular_car_bases_v1/"+id+"_"+quality+"_"+mode+".scn"
+				var scene: PackedScene=ResourceLoader.load(path,"PackedScene",ResourceLoader.CACHE_MODE_IGNORE_DEEP)
+				assert(scene!=null)
+				var holder: Node=scene.instantiate()
+				var meshes: Dictionary={}
+				var bytes: int=0
+				var surfaces: int=0
+				var triangles: int=0
+				for node: MeshInstance3D in holder.find_children("*","MeshInstance3D",true,false):
+					if node.mesh==null: continue
+					if not meshes.has(node.mesh): bytes+=payload(node.mesh); meshes[node.mesh]=true
+					if node.cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY: continue
+					surfaces+=node.mesh.get_surface_count()
+					triangles+=node.mesh.get_faces().size()/3
+				var deps: Dictionary={}
+				dependencies(path,deps)
+				var stored: int=0
+				for size: int in deps.values(): stored+=size
+				rows.append({"id":id,"quality":quality,"mode":mode,"raw_bytes":bytes,"unique_meshes":meshes.size(),"surfaces":surfaces,"triangles":triangles,"disk_dependency_bytes":stored,"dependencies":deps})
+				holder.free()
+	FileAccess.open(OUT+phase+"-assets.json",FileAccess.WRITE).store_string(JSON.stringify(rows,"\t"))
+	print("CAR_LOADING_ASSET_METRICS ",rows.size()," assemblies")
+	quit()
diff --git a/game/tests/test_car_loading_wash.gd b/game/tests/test_car_loading_wash.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_car_loading_wash.gd
@@ -0,0 +1,287 @@
+extends SceneTree
+const IDS: Array[String] = ["compact","kart","forklift","electric","hovercraft"]
+## Isolated local storage; real models, race lifecycle, hit-tested mouse/touch washing.
+var checks: int = 0
+var failures: int = 0
+var output: String = "res://../docs/evidence/car-wash-2026-10-11"
+var records: LocalRecords
+
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		print("FAIL: ", label)
+
+func settle() -> void:
+	for i: int in range(10): await process_frame
+	if DisplayServer.get_name() != "headless": await RenderingServer.frame_post_draw
+
+func run() -> void:
+	OS.set_environment("BMT_API_URL", "")
+	for argument: String in OS.get_cmdline_user_args():
+		if argument.begins_with("--evidence-root="): output = argument.trim_prefix("--evidence-root=").path_join("existing-wash")
+	if RenderingServer.get_current_rendering_method() == "mobile": output += "/mobile"
+	var directory: String = "user://car_wash_" + TrackLibrary.unique_id()
+	DirAccess.make_dir_recursive_absolute(directory)
+	records = LocalRecords.new(directory.path_join("records.json"))
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output))
+	for id: String in IDS:
+		var car := CarVisual.new()
+		car.vehicle_id = id
+		root.add_child(car)
+		var effect := VehicleWeathering.new()
+		effect.configure(car, "pine", VehicleCatalog.config(id))
+		effect.dirt_amount = 0.8
+		effect.mud_amount = 1.0
+		effect.deposit_color = VehicleWeathering.COLORS.pine
+		effect.snow_amount = 0.7
+		effect.melt(2.0)
+		check(is_equal_approx(effect.snow_amount, 0.45) and effect.smudge > 0.0 and effect.dirt_amount == 0.8, id + " snow melts into existing dirt")
+		effect.melt(8.0)
+		check(effect.snow_amount == 0.0 and effect.dirt_amount == 0.8 and effect.smudge > 0.4, id + " snow disappears without removing dirt")
+		var point: Vector3 = effect.bounds.position + effect.bounds.size * Vector3(1.0, 0.2, 0.6)
+		var before: PackedByteArray = effect.wash_image.get_data()
+		effect.wash(point, 0.15)
+		var partial: PackedByteArray = effect.wash_image.get_data()
+		check(partial != before, id + " local wash changes volume")
+		var cleaned: int = 0
+		for index: int in range(partial.size()):
+			if partial[index] > 0: cleaned += 1
+		check(cleaned > 0 and cleaned < VehicleCondition.CELLS / 4, id + " wash is a patch")
+		for z: int in range(16):
+			for y: int in range(16): check(partial[y * 256 + z * 16] == 0, id + " opposite side remains dirty")
+		effect.wash(point, 0.8)
+		check(effect.wash_image.get_data() != partial, id + " continued washing cleans progressively")
+		var saved: Dictionary = effect.snapshot()
+		check(VehicleCondition.save(records, id, saved) == OK, id + " atomic local save")
+		var reopened := LocalRecords.new(records.path)
+		reopened.load_records()
+		var recovered: Dictionary = VehicleCondition.read(reopened, id)
+		check(recovered.get("wash") == saved.wash and recovered.get("color") == saved.color and recovered.get("version") == saved.version, id + " restart preserves exact wash and palette")
+		for field: String in ["dirt", "snow", "wetness", "mud", "smudge"]:
+			check(absf(float(recovered.get(field, -1)) - float(saved[field])) < 0.000000001, id + " restart preserves " + field)
+		effect.configure(car, "desert", VehicleCatalog.config(id))
+		check(effect.snapshot() == saved, id + " biome change retains condition")
+		var state := VehicleState.new()
+		state.velocity = Vector2(0, 20)
+		var track := NativeTrack.new()
+		track.metadata = {"theme": "desert"}
+		track.cell_size = 10.0
+		track.grid_width = 10
+		track.grid_height = 10
+		track.half_extent = Vector2(50, 50)
+		track.cells.resize(100)
+		track.cells.fill(0)
+		track.deck_cells.resize(100)
+		track.deck_cells.fill(-1)
+		effect.present(state, track, false)
+		state.tick = 120
+		var canonical: Array = state.snapshot().duplicate(true)
+		effect.present(state, track, false)
+		check(effect.wash_image.get_data() != partial and effect.wash_image.get_data() != Marshalls.base64_to_raw(saved.wash), id + " later driving coats washed areas again")
+		check(state.snapshot() == canonical, id + " re-coating does not change canonical state")
+		effect.reset()
+		effect.snow_amount = 0.6
+		effect.melt(8.0)
+		check(effect.smudge == 0.0 and effect.dirt_amount == 0.0 and not effect.installed, id + " clean car snow melts without inventing dirt")
+		car.queue_free()
+		await process_frame
+	check(records.settings.vehicle_conditions.size() == IDS.size() and records.records.is_empty(), "all five scoped cars remain independent; no PB writes")
+	var invalid: Dictionary = records.settings.vehicle_conditions.duplicate(true)
+	invalid.compact.dirt = INF
+	check(not VehicleCondition.valid_collection(invalid), "reject nonfinite local dirt")
+	invalid = records.settings.vehicle_conditions.duplicate(true)
+	invalid.compact.version = 2
+	check(not VehicleCondition.valid_collection(invalid), "reject unknown cosmetic version")
+	await race_lifecycle()
+	await garage()
+	if DisplayServer.get_name() != "headless": await app_capture()
+	print("CAR_WASH: %d checks, %d failures" % [checks, failures])
+	quit(1 if failures else 0)
+
+func race_lifecycle() -> void:
+	var game: Node = load("res://core/game.tscn").instantiate()
+	game.initial_track = loop_track()
+	game.vehicle_id = "compact"
+	game.preference_records = records
+	game.production_mode = true
+	root.add_child(game)
+	game.set_process(false)
+	game.set_physics_process(false)
+	var before: Dictionary = game.car_weathering.snapshot()
+	check(before == VehicleCondition.read(records, "compact"), "race restores local condition")
+	game.restart()
+	check(game.car_weathering.snapshot() == before, "retry preserves cosmetic condition")
+	game.car_weathering.snow_amount = 0.5
+	var canonical: Array = game.sim.state.snapshot().duplicate(true)
+	game._begin_finish()
+	game.car_weathering.melt(8.0)
+	game._complete_finish()
+	check(game.sim.state.snapshot() == canonical, "finish/melt never changes scored state")
+	check(VehicleCondition.read(records, "compact").snow == 0.0, "completed race persists melted snow")
+	game.car_weathering.dirt_amount = 0.92
+	game.queue_free()
+	await process_frame
+	check(VehicleCondition.read(records, "compact").dirt == 0.92, "abandoned race saves before next menu")
+
+func garage() -> void:
+	root.size = Vector2i(1280, 720)
+	VehicleCatalog.selected = "compact"
+	var page := GaragePage.new()
+	page.records = records
+	page.circuit_title = "CIRCUIT / 5 LAPS"
+	page.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	root.add_child(page)
+	await settle()
+	var view: CarShowroom = page.showroom
+	view.set_process(false)
+	view.yaw = -PI * 0.5
+	view.elevation = 0.12
+	view.set_zoom(0.85)
+	check(view.weathering.snapshot() == VehicleCondition.read(records, "compact"), "garage displays raced condition")
+	page.open_car(0)
+	page._show_section("care")
+	# The lightweight wash requirement no longer hides the 0.32s slide behind
+	# livery-gallery construction. Project the hit only once the pane settles.
+	await create_timer(GaragePage.MENU_MOVE_SECONDS + 0.05).timeout
+	await settle()
+	page._toggle_wash()
+	check(view.wash_mode and page.wash_button.text == "Done", "explicit wash mode")
+	var target: Vector3 = Vector3(-0.9, 0.50, 0.1)
+	var pixel: Vector2 = view.camera.unproject_position(view.car.body.global_transform * target) * view.size / Vector2(view.showroom_viewport.size)
+	check(view.pick_body_point(pixel) != null, "ray hits actual door mesh")
+	check(view.pick_body_point(Vector2(-100, -100)) == null, "missed car cannot wash")
+	var mask: PackedByteArray = view.weathering.wash_image.get_data()
+	var motion := InputEventMouseMotion.new()
+	motion.position = pixel
+	motion.relative = Vector2(12, 0)
+	motion.button_mask = MOUSE_BUTTON_MASK_LEFT
+	var yaw: float = view.yaw
+	view.gui_input.emit(motion)
+	check(view.yaw == yaw, "wash drag does not orbit")
+	var dirty_image: Image
+	if DisplayServer.get_name() != "headless":
+		view.wash_pointer_valid = false
+		view.wash_effect.hide() # Compare original paint with all transient wash feedback hidden.
+		await settle()
+		dirty_image = root.get_texture().get_image()
+	if DisplayServer.get_name() != "headless": await capture("garage-dirty", page)
+	var press := InputEventMouseButton.new()
+	press.button_index = MOUSE_BUTTON_LEFT
+	press.position = pixel
+	press.pressed = true
+	view.gui_input.emit(press)
+	for i: int in range(40): view._process(0.05)
+	check(view.weathering.wash_image.get_data() != mask, "held mouse wash cleans real hit")
+	if DisplayServer.get_name() != "headless":
+		view.wash_pointer_valid = false
+		view.wash_effect.hide()
+		await settle()
+		var washed_image: Image = root.get_texture().get_image()
+		var actual: Vector2i = Vector2i(view.get_global_rect().position + pixel)
+		print("WASH_PIXEL: ", actual, " ", dirty_image.get_pixelv(actual), " -> ", washed_image.get_pixelv(actual))
+		check(dirty_image.get_pixelv(actual).b < washed_image.get_pixelv(actual).b - 0.02, "washing visibly reveals original blue door paint")
+		view.wash_pointer_valid = true
+		view.wash_effect.show()
+	if DisplayServer.get_name() != "headless": await capture("garage-partly-washed", page)
+	press.pressed = false
+	view.gui_input.emit(press)
+	check(VehicleCondition.read(records, "compact") == view.weathering.snapshot(), "mouse release commits wash")
+	var touch := InputEventScreenTouch.new()
+	touch.index = 0
+	touch.position = pixel
+	touch.pressed = true
+	view.gui_input.emit(touch)
+	check(view.washing, "one finger washes")
+	touch.index = 1
+	touch.position = pixel + Vector2(80, 0)
+	view.gui_input.emit(touch)
+	check(not view.washing, "second finger switches to orbit")
+	var drag := InputEventScreenDrag.new()
+	drag.index = 1
+	drag.position = pixel + Vector2(100, 10)
+	view.gui_input.emit(drag)
+	check(view.yaw != yaw, "two fingers rotate in wash mode")
+	touch.canceled = true
+	view.gui_input.emit(touch)
+	check(not view.washing and view.touches.is_empty(), "canceled touch stops washing")
+	var newer: Dictionary = VehicleCondition.read(records, "compact")
+	newer.dirt = 0.97
+	check(VehicleCondition.save(records, "compact", newer) == OK, "newer local race state")
+	page._save_condition()
+	check(VehicleCondition.read(records, "compact").dirt == 0.97, "cached garage never overwrites newer condition")
+	page._reset()
+	check(view.weathering.dirt_amount == 0.97, "reset paint does not wash dirt")
+	page.queue_free()
+	await process_frame
+	var reopened := LocalRecords.new(records.path)
+	reopened.load_records()
+	check(VehicleCondition.read(reopened, "compact").dirt == 0.97, "garage exit retains local condition")
+
+func capture(label: String, page: GaragePage) -> void:
+	await settle()
+	check(root.get_texture().get_image().save_png(output.path_join(label + ".png")) == OK, label + " screenshot")
+	for dimensions: Vector2i in [Vector2i(960, 540), Vector2i(1600, 720)]:
+		root.size = dimensions
+		await settle()
+		check(root.get_visible_rect().encloses(page.wash_button.get_global_rect()), "wash action fits " + str(dimensions.x))
+		check(root.get_texture().get_image().save_png(output.path_join(label + "-" + str(dimensions.x) + ".png")) == OK, label + " responsive capture")
+	root.size = Vector2i(1280, 720)
+	await settle()
+
+func loop_track() -> NativeTrack:
+	var document: Dictionary = TrackDocument.create_blank()
+	document.theme = "desert"
+	var point := Vector2(-28, -18)
+	var heading: float = 0.0
+	for kind: String in ["straight", "hairpin", "straight", "hairpin"]:
+		var piece: Dictionary = RoadPieces.create(kind, point, heading)
+		piece.length = 56.0 if kind == "straight" else 0.0
+		piece.radius = 18.0
+		document.pieces.append(piece)
+		var pose: Dictionary = RoadPieces.end_pose(piece)
+		point = pose.position
+		heading = pose.heading
+	document = RoadPieces.route_from_pieces(document).document
+	document.start_line = {"position": [0.0, -18.0], "heading": 0.0}
+	return TrackCompiler.compile(JSON.parse_string(JSON.stringify(document)))
+
+func app_capture() -> void:
+	var directory: String = records.path.get_base_dir()
+	var app: Node = load("res://core/app.tscn").instantiate()
+	app.records = records
+	app.library = TrackLibrary.new(directory.path_join("tracks"))
+	app.cloud_root_override = directory.path_join("cloud")
+	root.add_child(app)
+	while not app.startup_complete: await process_frame
+	VehicleCatalog.selected = "compact"
+	app._show_screen("garage")
+	await settle()
+	var page: GaragePage = app.root_ui.find_child("GaragePage", true, false)
+	page.open_car(0)
+	while page.showroom==null or not page.showroom.showroom_ready or not page.showroom.car.model_ready: await process_frame
+	while page.progressive_entry and page.showroom.preparing and not page.showroom.interaction_ready: await process_frame
+	page._show_section("care")
+	# The incoming action row takes 0.32 seconds, independent of frame rate.
+	while page._menu_motion != null and page._menu_motion.is_running(): await process_frame
+	await settle()
+	# Menu action rows can be retained outside root_ui during the page move.
+	# Use the current page's actual bound action, after its live car is ready.
+	var button: Button = page.wash_button
+	check(button!=null and button.name=="GarageWash","real care action is available")
+	if button==null:
+		app.queue_free()
+		return
+	button.pressed.emit()
+	var view: CarShowroom = page.showroom
+	check(view.wash_mode, "real app enters Wash")
+	var swipe: Node = app.root_ui.get_node("MenuPageSwipe")
+	check(swipe._owns_gesture(app.root_ui, view.get_global_rect().get_center()), "wash owns gestures over menu paging")
+	for dimensions: Vector2i in [Vector2i(1280, 720), Vector2i(960, 540), Vector2i(1600, 720)]:
+		root.size = dimensions
+		await settle()
+		check(root.get_visible_rect().encloses(button.get_global_rect()), "real app Wash action fits " + str(dimensions.x))
+		check(root.get_texture().get_image().save_png(output.path_join("garage-app-" + str(dimensions.x) + ".png")) == OK, "real app capture " + str(dimensions.x))
+	app.queue_free()
+	await process_frame
