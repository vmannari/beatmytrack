 	var packed := PackedScene.new()
 	var error: Error = packed.pack(holder)
 	if error==OK: error = ResourceSaver.save(packed,path,ResourceSaver.FLAG_COMPRESS)
 	holder.free()
+	print("CAR_LOD_REUSE ",path," exact_masters=",reused)
 	return error
