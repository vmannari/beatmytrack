+	if not editable_kits: return
+	if not kit_frames.has(category): kit_frames[category] = []
+	kit_frames[category].append(frame)
+
+func wheel_kit_frame(rotor: Node3D) -> Node3D:
+	if editable_kits:
+		for frame: Node3D in kit_frames.get("rims",[]):
+			if frame.get_parent()==rotor: return frame
+	return rotor
+
+func change_kit_parts(value: Dictionary) -> void:
+	var previous: Dictionary = customisation
+	customisation = value.duplicate(true)
+	for category: String in VehicleCustomisation.CATEGORIES:
+		if previous[category]==value[category]: continue
+		if preload("res://vehicle/prepared_car_cache.gd").enabled and preload("res://vehicle/modular_car_kits.gd").apply(self,category,str(value[category])):
+			continue
+		for frame: Node3D in kit_frames.get(category,[]):
+			frame.get_parent().remove_child(frame)
+			frame.queue_free()
+		kit_frames[category] = []
+		if vehicle_id == "super_rally":
+			_builder("super_rally_model").kit(self,category)
+			_reduce_changed_kit(category)
+			if batch_parts:
+				for frame: Node3D in kit_frames[category]: VisualGeometry.batch_static_parts(frame)
+			continue
+		if vehicle_id=="electric":
+			_builder("electric_kits").build(self,category)
+			_reduce_changed_kit(category)
+			if batch_parts:
+				for frame: Node3D in kit_frames[category]: VisualGeometry.batch_static_parts(frame)
+			continue
+		if vehicle_id=="forklift":
+			_builder("forklift_kits").build(self,category)
+			_reduce_changed_kit(category)
+			if batch_parts:
+				for frame: Node3D in kit_frames[category]: VisualGeometry.batch_static_parts(frame)
+			continue
+		if vehicle_id=="hovercraft":
+			if category=="rims": _builder("hovercraft_sport_drive").rebuild_fans(self)
+			else: _builder("hovercraft_kits").build(self,category)
+			_reduce_changed_kit(category)
+			if batch_parts:
+				for frame: Node3D in kit_frames[category]: VisualGeometry.batch_static_parts(frame)
+			continue
+		if vehicle_id=="kart":
+			var kart = _builder("kart_model")
+			match category:
+				"hood": kart.build_nose(self)
+				"aero": kart.build_bumper(self)
+				"body": kart.build_pods(self)
+				"rims":
+					for rotor: Node3D in rolling_wheels: kart.build_rims(self,rotor,signf((rotor.get_parent() as Node3D).position.x))
+			_reduce_changed_kit(category)
+			if batch_parts:
+				for frame: Node3D in kit_frames[category]: VisualGeometry.batch_static_parts(frame)
+			continue
+		match category:
+			"hood": _builder("compact_coachwork").build_hood(self,paint_materials.body,paint_materials.accent)
+			"aero": _builder("compact_kits").build_aero(self)
+			"body": _builder("compact_kits").build_body(self)
+			"rims":
+				var trim: Material = CompactFinish.rubber(Color("171e21"))
+				var alloy: Material = CompactFinish.alloy(Color("657177"))
+				var bright: Material = CompactFinish.alloy(Color("b5b8ae"))
+				for rotor: Node3D in rolling_wheels:
+					var side: float = signf((rotor.get_parent() as Node3D).position.x)
+					var frame: Node3D = new_kit_frame("rims",rotor)
+					if _builder("compact_kits").choice(self,"rims")=="stock":
+						var hub := VisualGeometry.cylinder(frame,0.228,0.16,Vector3.ZERO,trim,true)
+						hub.rotation.z = PI*0.5
+						for spoke: int in range(8):
+							var a: float = spoke*TAU/8.0
+							_seam(frame,Vector3(side*0.085,sin(a)*0.08,cos(a)*0.08),Vector3(side*0.148,sin(a)*0.222,cos(a)*0.222),0.032,alloy)
+						_builder("compact_detail").rim_detail(frame,side,alloy,trim,bright)
+					else: _builder("compact_kits").build_wheel(self,frame,side)
+					var brake: Node3D = new_kit_frame("rims",rotor.get_parent())
+					if _builder("compact_kits").choice(self,"rims")!="stock": _builder("compact_kits").build_caliper(brake,side)
+		_reduce_changed_kit(category)
+		for frame: Node3D in kit_frames[category]: VisualGeometry.batch_static_parts(frame)
+	if vehicle_id=="hovercraft": _builder("car_static_reduction").apply(self)
+	graphics = LiveryGraphics.new()
+	graphics.configure(self)
+
+func _reduce_changed_kit(category: String) -> void:
+	# Match construction-time reduction before batching newly fitted primitives.
+	# Offline modules and a direct fitted build must describe the same model.
+	if simple_model:
+		for frame: Node3D in kit_frames[category]: _builder("racing_car_models")._reduce_primitives(frame,true)
+		if vehicle_id!="hovercraft": _builder("car_static_reduction").apply(self,kit_frames.get(category,[]))
+		_builder("car_coarse_reduction").apply(self,kit_frames.get(category,[]))
+		_builder("car_detail_reduction").apply(self,kit_frames.get(category,[]))
+
+
+func present(point: Vector2, angle: float, state: VehicleState, frame: DriveFrame) -> void:
+	# Use interpolated travel, so repeated redraws cannot spin stationary tires.
+	var travel := Vector2.ZERO
+	if wheel_last_tick >= 0 and state.tick >= wheel_last_tick and state.tick - wheel_last_tick <= 30:
+		travel = point - wheel_last_point
+	else:
+		for rotor: Node3D in rolling_wheels:
+			rotor.rotation.x = 0.0
+	wheel_last_point = point
+	wheel_last_tick = state.tick
+	position = VisualGeometry.world(point)
+	rotation.y = -angle
+	if vehicle_id == "kart":
+		if not is_instance_valid(kart_steering_wheel):
+			kart_steering_wheel = body.find_child("SteeringAssembly",true,false)
+			kart_steering_driver = body.find_child("TomkartDriver",true,false)
+		preload("res://vehicle/kart_steering.gd").present(kart_steering_wheel,kart_steering_driver,state.steering)
+	if vehicle_id == "hovercraft":
+		var fan: Node3D = body.get_node_or_null("FanRotor")
+		if fan != null:
+			var left: Node3D = fan.get_node_or_null("FanRotorLeft")
+			var right: Node3D = fan.get_node_or_null("FanRotorRight")
+			var spin: float = wrapf(state.tick*0.29,-PI,PI)
+			if left != null and right != null:
+				left.rotation.z = spin
+				right.rotation.z = -spin
+			else: fan.rotation.z = spin
+		for part: String in ["RudderLeft","RudderRight"]:
+			var rudder: Node3D = body.get_node_or_null(NodePath(part))
+			if rudder != null: rudder.rotation.y = -state.steering*0.42
+	for wheel: Node3D in front_wheels:
+		wheel.rotation.y = -state.steering * (0.60 if vehicle_id == "kart" else 0.4)
+	if vehicle_id == "forklift":
+		var speed_fraction: float = clampf(absf(state.velocity.dot(state.forward())) / 24.0, 0.0, 1.0)
+		for wheel: Node3D in rear_wheels:
+			wheel.rotation.y = state.steering * rear_steering_config.steering_angle * (1.0 - rear_steering_config.high_speed_steering_reduction * speed_fraction)
+	for i: int in range(rolling_wheels.size()):
+		var rotor: Node3D = rolling_wheels[i]
+		var pivot: Node3D = rotor.get_parent() as Node3D
+		var heading: float = angle - pivot.rotation.y
+		var distance: float = travel.dot(Vector2(sin(heading), cos(heading)))
+		rotor.rotation.x = wrapf(rotor.rotation.x - distance / wheel_radii[i], -PI, PI)
+	var braking: bool = frame.brake > 0
+	if vehicle_id == "electric":
+		braking = frame.throttle < 62 and state.velocity.length() > 0.5 and state.jump_height == 0.0 and state.roll_ticks == 0
+	if braking != rear_braking:
+		rear_braking = braking
+		_update_rear_lights()
+
+
+func _update_rear_lights() -> void:
+	# Self-lit lenses reuse the existing material/batch: no extra Light3D or pass.
+	brake_material.albedo_color = Color("f17158") if rear_braking else Color("802d2b")
+	brake_material.emission_enabled = true
+	brake_material.emission = Color("e02b1d")
+	brake_material.emission_energy_multiplier = 2.2 if rear_braking else 0.65
+
+
+func register_rolling_wheel(pivot: Node3D, radius: float) -> void:
+	# Steering remains on the parent; tires, hubs and spokes roll around local X.
+	var rotor := Node3D.new()
+	rotor.name = "WheelSpin"
+	var meshes: Array[Node] = pivot.get_children()
+	pivot.add_child(rotor)
+	for mesh: Node in meshes:
+		mesh.reparent(rotor, false)
+	rolling_wheels.append(rotor)
+	wheel_radii.append(radius * HandlingConfig.BODY_SCALE)
+	wheel_rest_positions.append(pivot.position)
+
+
+func present_suspension(state: VehicleState, road_pitch: float, dry_contact: bool = true, surface_rumble: float = 0.0, kerb_heights: Vector4 = Vector4.ZERO, bump_heights: Vector4 = Vector4.ZERO, bump_track: bool = false, bump_pose: Vector3 = Vector3.ZERO, terrain_heights: Vector4 = Vector4.ZERO, terrain_pose: Vector3 = Vector3.ZERO) -> void:
+	# Consume snapshots once, independent of display rate; never write to simulation.
+	if last_tick < 0 or state.tick < last_tick or state.tick - last_tick > 30:
+		suspension = Vector3.ZERO
+		suspension_speed = Vector3.ZERO
+		terrain_suspension = Vector3.ZERO
+		terrain_suspension_speed = Vector3.ZERO
+		spark_cooldown = 0.0
+		for spark: Dictionary in sparks:
+			spark.life = 0.0
+			spark.mesh.visible = false
+		last_tick = state.tick
+		last_velocity = state.velocity
+		last_slope = road_pitch
+		was_rolling = state.roll_ticks > 0
+		was_airborne = state.jump_height > 0.0
+		last_jump_velocity = state.jump_velocity
+	if state.tick > last_tick:
+		var dt: float = (state.tick - last_tick) / 120.0
+		var acceleration: Vector2 = (state.velocity - last_velocity) / dt
+		var airborne: bool = state.jump_height > 0.0
+		var slope_rate: float = (road_pitch - last_slope) / dt
+		var impact: float = maxf(0.0, -last_jump_velocity) if was_airborne and not airborne else 0.0
+		if was_airborne and not airborne and state.bridge_descending: impact = preload("res://vehicle/bridge_flight.gd").landing_feedback(state)
+		var target := Vector3(0.0, clampf(acceleration.dot(state.forward()) * 0.004, -0.085, 0.065), clampf(acceleration.dot(state.right()) * 0.005, -0.10, 0.10))
+		if airborne:
+			target = Vector3(0.035, 0.0, 0.0)
+		elif not was_airborne:
+			target.x = clampf(-slope_rate * state.velocity.dot(state.forward()) * 0.002, -0.075, 0.05)
+			target.y -= clampf(slope_rate * 0.012, -0.035, 0.035)
+		if was_rolling and state.roll_ticks == 0:
+			suspension_speed.x -= 0.85
+			suspension_speed.z += state.roll_direction * 0.24
+		if state.roll_ticks > 0:
+			target = Vector3.ZERO
+			suspension = Vector3.ZERO
+			suspension_speed = Vector3.ZERO
+		if impact > 0.0:
+			suspension_speed.x -= minf(impact * 0.16, 1.2)
+			suspension_speed.y -= minf(impact * 0.035, 0.20)
+		spark_cooldown = maxf(0.0, spark_cooldown - dt)
+		_update_sparks(dt)
+		for step: int in range(state.tick - last_tick):
+			# Heave/pitch settle over more than one diminishing movement;
+			# lateral roll retains its accepted steering response.
+			suspension_speed += ((target - suspension) * Vector3(90.0,110.0,150.0) - suspension_speed * Vector3(9.0,10.0,15.0)) / 120.0
+			suspension += suspension_speed / 120.0
+			suspension.x = clampf(suspension.x, -0.11, 0.06)
+			suspension.y = clampf(suspension.y, -0.12, 0.12)
+			suspension.z = clampf(suspension.z, -0.12, 0.12)
+			var terrain_target: Vector3 = terrain_pose if not airborne and state.roll_ticks == 0 else Vector3.ZERO
+			terrain_suspension_speed += ((terrain_target-terrain_suspension)*Vector3(85.0,100.0,100.0)-terrain_suspension_speed*Vector3(12.0,13.0,13.0))/120.0
+			terrain_suspension += terrain_suspension_speed/120.0
+		var hard_ramp: bool = not was_airborne and absf(road_pitch) > 0.12 and absf(slope_rate) * state.velocity.length() > 16.0
+		if dry_contact and not airborne and state.velocity.length() > 9.0 and spark_cooldown == 0.0 and (impact > 3.0 or hard_ramp):
+			_emit_sparks(state, road_pitch)
+			spark_cooldown = 0.4
+		last_tick = state.tick
+		last_velocity = state.velocity
+		last_jump_velocity = state.jump_velocity
+		was_rolling = state.roll_ticks > 0
+		was_airborne = airborne
+		last_slope = road_pitch
+	var compliance: float = 0.30 if vehicle_id == "kart" else 1.0
+	# Loose ground agitates the sprung body without changing the canonical pose.
+	# Tick-derived phases keep the result independent of render frame rate.
+	var rumble: float = clampf(surface_rumble, 0.0, 1.0)
+	var phase: float = state.tick / 120.0
+	var surface_heave: float = (sin(phase * 55.0) + sin(phase * 31.0) * 0.35) * MAX_SURFACE_HEAVE * rumble
+	var surface_roll: float = (sin(phase * 43.0) + cos(phase * 29.0) * 0.30) * MAX_SURFACE_ROLL * rumble
+	body.position.y = (suspension.x + terrain_suspension.x) * compliance / HandlingConfig.BODY_SCALE + surface_heave
+	var body_pitch: float = state.bump_transfer.x if bump_track and state.jump_height == 0.0 and state.roll_ticks == 0 else suspension.y
+	body.rotation.x = (body_pitch + ramp_body_pitch + terrain_suspension.y) * compliance
+	body.rotation.z = (suspension.z + terrain_suspension.z) * compliance + surface_roll
+	# The canonical spring moves the chassis; each tyre follows its own contact
+	# instead of inheriting that rigid plane. Keep diagonal/single-wheel contact.
+	var kerb_pose: Vector3 = state.kerb_offset if state.jump_height == 0.0 and state.roll_ticks == 0 else Vector3.ZERO
+	var kerb_basis := Basis.from_euler(Vector3(kerb_pose.y,0.0,kerb_pose.z))
+	for i: int in range(rolling_wheels.size()):
+		var rest: Vector3 = wheel_rest_positions[i]
+		var wheel: Node3D = rolling_wheels[i].get_parent() as Node3D
+		var contact_index: int = (0 if rest.z < 0.0 else 2) + (0 if rest.x < 0.0 else 1)
+		var height: float = kerb_heights[contact_index] if state.jump_height == 0.0 and state.roll_ticks == 0 else 0.0
+		wheel.position.y = (rest.y + (height-kerb_pose.x)/HandlingConfig.BODY_SCALE - kerb_basis.x.y*rest.x - kerb_basis.z.y*rest.z)/kerb_basis.y.y
+		if state.jump_height == 0.0 and state.roll_ticks == 0:
+			wheel.position.y += terrain_heights[contact_index]/HandlingConfig.BODY_SCALE
+	# Accentuate the existing damped response, preserving the contacted side and
+	# axle. The kart retains its stiffer chassis; canonical handling is untouched.
+	body.rotation.x += kerb_pose.y * 0.70 * compliance
+	body.rotation.z += kerb_pose.z * 0.70 * compliance
+	if bump_heights != Vector4.ZERO:
+		var basis := Basis.from_euler(Vector3(bump_pose.y,0,bump_pose.z))
+		for i: int in range(rolling_wheels.size()):
+			var rest: Vector3 = wheel_rest_positions[i]
+			var wheel: Node3D = rolling_wheels[i].get_parent() as Node3D
+			var slot: int = (0 if rest.z < 0.0 else 2)+(0 if rest.x < 0.0 else 1)
+			wheel.position.y += ((bump_heights[slot]-bump_pose.x)/HandlingConfig.BODY_SCALE-basis.x.y*rest.x-basis.z.y*rest.z)/basis.y.y
+	if vehicle_id == "electric":
+		# Its low wheel arches leave less visual travel than the shared body.
+		# Ease the sprung shell before applying the final clearance correction.
+		body.rotation.x = 0.035*tanh(body.rotation.x/0.035)
+		body.rotation.z = 0.035*tanh(body.rotation.z/0.035)
+		body.position.y = maxf(body.position.y,-0.025)
+		_keep_electric_body_clear_of_tires()
+
+
+func _keep_electric_body_clear_of_tires() -> void:
+	# The wheels keep their road contacts while the sprung body pitches, rolls
+	# and heaves independently. Lift only the rendered body when that motion
+	# would push a tire through the wheel opening.
+	var BODY: Script = _builder("electric_reference_body")
+	const TIRE_RINGS: Array[Vector2] = [Vector2(-0.14,0.32),Vector2(-0.075,0.37),Vector2(0.075,0.37),Vector2(0.14,0.32)]
+	if electric_tire_angles.is_empty():
+		for index: int in range(32):
+			var angle: float = TAU*float(index)/32.0
+			electric_tire_angles.append(Vector2(sin(angle),cos(angle)))
+	for _pass: int in range(3):
+		var inverse: Transform3D = body.transform.affine_inverse()
+		var lift := 0.0
+		for rotor: Node3D in rolling_wheels:
+			var wheel: Node3D = rotor.get_parent() as Node3D
+			var local_wheel: Transform3D = inverse*wheel.transform
+			for ring: Vector2 in TIRE_RINGS:
+				for direction: Vector2 in electric_tire_angles:
+					var point: Vector3 = local_wheel*Vector3(ring.x,ring.y*direction.x,ring.y*direction.y)
+					if point.y > 0.24:
+						lift = maxf(lift,point.y-BODY.wheel_bottom(point.z)+0.004)
+		if lift <= 0.0: break
+		body.position.y += lift/maxf(inverse.basis.y.y,0.5)
+
+
+# Conservative cross-section of the wheels, body, mirrors and roof in model metres.
+const ROLL_OUTLINE: Array[Vector2] = [Vector2(-0.975,0.0), Vector2(0.975,0.0),
+	Vector2(-0.975,0.76), Vector2(0.975,0.76), Vector2(-1.04,1.15), Vector2(1.04,1.15),
+	Vector2(-0.63,1.515), Vector2(0.63,1.515)]
+
+func present_roll(state: VehicleState, interpolation: float = 1.0) -> void:
+	if state.roll_ticks <= 0: return
+	var elapsed: float = VehicleSimulation.ROLL_DURATION_TICKS - state.roll_ticks - (1.0 - interpolation)
+	var phase: float = clampf(elapsed / VehicleSimulation.ROLL_DURATION_TICKS, 0.0, 1.0)
+	# Load the outside tires before tipping, accelerate through the roll, then land.
+	var turn: float = phase - 0.075 * sin(TAU * phase)
+	var roll: float = state.roll_direction * TAU * turn
+	var low: float = INF
+	var outline: Array[Vector2] = ROLL_OUTLINE
+	if chassis_id=="compact" and customisation != VehicleCustomisation.defaults():
+		outline = ROLL_OUTLINE.duplicate()
+		if customisation.body in ["rally","club"] or customisation.body in _builder("compact_kit_variants").BODIES:
+			if customisation.body in _builder("compact_kit_variants").BODIES:
+				outline.append_array([Vector2(-1.15,0.25),Vector2(1.15,0.25),Vector2(-1.15,0.90),Vector2(1.15,0.90)])
+			else:
+				outline.append_array([Vector2(-1.10,0.37),Vector2(1.10,0.37),Vector2(-1.10,0.85),Vector2(1.10,0.85)])
+		if customisation.aero!="stock":
+			var half: float = 0.92 if customisation.aero=="wing" else 0.65
+			var height: float = 1.89 if customisation.aero=="wing" else 1.64
+			if customisation.aero in _builder("compact_aero").PROFILES:
+				var extent: Vector2 = _builder("compact_aero").roll_extent(customisation.aero)
+				half = extent.x
+				height = extent.y
+			outline.append_array([Vector2(-half,height),Vector2(half,height)])
+	if vehicle_id == "super_rally":
+		outline = [Vector2(-1.08,0.27),Vector2(1.08,0.27),Vector2(-1.08,0.98),Vector2(1.08,0.98),Vector2(-0.58,1.42),Vector2(0.58,1.42)]
+		if customisation.aero != "stock":
+			var extent: Vector2 = _builder("super_rally_model").aero_extent(customisation.aero)
+			outline.append_array([Vector2(-extent.x,extent.y),Vector2(extent.x,extent.y)])
+	if chassis_id != "compact":
+		var half_width: float = 1.05 if vehicle_id == "pickup" else 1.16 if vehicle_id == "formula" else 0.96
+		var height: float = 2.89 if vehicle_id == "forklift" else 1.96 if vehicle_id == "pickup" else 0.91 if vehicle_id == "formula" else 1.36
+		outline = [Vector2(-half_width,0),Vector2(half_width,0),Vector2(-half_width,0.75),Vector2(half_width,0.75),Vector2(-0.76,height),Vector2(0.76,height)]
+	if vehicle_id == "kart":
+		outline = [Vector2(-0.86,0),Vector2(0.86,0),Vector2(-0.86,0.44),Vector2(0.86,0.44),Vector2(-0.23,1.16),Vector2(0.23,1.16)]
+	for point: Vector2 in outline:
+		low = minf(low, sin(roll) * point.x + cos(roll) * point.y)
+	var support: float = maxf(0.0, -low) * HandlingConfig.BODY_SCALE
+	# Keep the mass center over its simulated path instead of orbiting the floor origin.
+	var right_axis: Vector3 = basis.x.normalized()
+	position += right_axis * sin(roll) * (0.40 if vehicle_id == "kart" else 0.70) * HandlingConfig.BODY_SCALE
+	position.y += support + 0.06 * pow(sin(TAU * phase), 2.0)
+	rotation.z = roll
+
+
+func _emit_sparks(state: VehicleState, slope: float) -> void:
+	if sparks.is_empty():
+		var material := VisualGeometry.material(Color("ffd078"))
+		material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+		for i: int in range(24):
+			var mesh := VisualGeometry.box(self, Vector3(0.035, 0.035, 0.19), Vector3.ZERO, material)
+			mesh.top_level = true
+			mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+			mesh.visible = false
+			sparks.append({"mesh":mesh, "life":0.0, "velocity":Vector3.ZERO})
+	var travel: Vector3 = VisualGeometry.world(state.velocity).normalized()
+	for i: int in range(8):
+		var spark: Dictionary = sparks[spark_cursor]
+		spark_cursor = (spark_cursor + 1) % sparks.size()
+		var side: float = -1.0 if i % 2 == 0 else 1.0
+		var local := Vector3(side * 0.65, 0.07, -1.65 if slope >= 0.0 else 1.65)
+		spark.mesh.global_position = global_transform * local
+		spark.velocity = -travel * (2.0 + i * 0.45) + global_basis.x.normalized() * side * (0.6 + i * 0.13) + Vector3.UP * (1.0 + i * 0.13)
+		spark.life = 0.22 + i * 0.018
+		spark.mesh.visible = true
+		spark.mesh.scale = Vector3.ONE
+		spark.mesh.look_at(spark.mesh.global_position + spark.velocity)
+
+
+func _update_sparks(dt: float) -> void:
+	for spark: Dictionary in sparks:
+		spark.life = maxf(0.0, spark.life - dt)
+		spark.mesh.visible = spark.life > 0.0
+		if spark.life > 0.0:
+			spark.velocity += Vector3.DOWN * 9.8 * dt
+			spark.mesh.global_position += spark.velocity * dt
+			spark.mesh.scale = Vector3.ONE * minf(1.0, spark.life * 12.0)
+
+
+func _shell(parent: Node3D, sections: Array[Vector3], surface: Material) -> void:
+	var tool := SurfaceTool.new()
+	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var rings: Array[PackedVector3Array] = []
+	for section: Vector3 in sections:
+		var w: float = section.x
+		var y: float = section.y
+		var length: float = section.z
+		rings.append(PackedVector3Array([Vector3(-w + 0.16, y, -length), Vector3(w - 0.16, y, -length),
+			Vector3(w, y, -length + 0.22), Vector3(w, y, length - 0.22), Vector3(w - 0.16, y, length),
+			Vector3(-w + 0.16, y, length), Vector3(-w, y, length - 0.22), Vector3(-w, y, -length + 0.22)]))
+	for row: int in range(rings.size() - 1):
+		for i: int in range(8):
+			var j: int = (i + 1) % 8
+			for vertex: Vector3 in [rings[row][i], rings[row + 1][j], rings[row + 1][i], rings[row][i], rings[row][j], rings[row + 1][j]]:
+				tool.add_vertex(vertex)
+	var top: PackedVector3Array = rings.back()
+	for i: int in range(1, 7):
+		for vertex: Vector3 in [top[0], top[i], top[i + 1]]:
+			tool.add_vertex(vertex)
+	tool.generate_normals()
+	var instance := MeshInstance3D.new()
+	instance.mesh = tool.commit()
+	instance.material_override = surface
+	parent.add_child(instance)
+	# Close the shell at its actual lower outline. Reversed top winding faces
+	# downwards, so a rolling car cannot expose the backfaces of its bodywork.
+	var bottom: PackedVector3Array = rings.front()
+	var floor_tool := SurfaceTool.new()
+	floor_tool.begin(Mesh.PRIMITIVE_TRIANGLES)
+	for i: int in range(1, 7):
+		for vertex: Vector3 in [bottom[0], bottom[i + 1], bottom[i]]:
+			floor_tool.set_normal(Vector3.DOWN)
+			floor_tool.add_vertex(vertex)
+	var underside := MeshInstance3D.new()
+	underside.name = "BlackUnderside"
+	underside.mesh = floor_tool.commit()
+	underside.material_override = underside_material
+	parent.add_child(underside)
+
+
+func _seam(parent: Node3D, start: Vector3, end: Vector3, width: float, surface: Material) -> void:
+	if vehicle_id=="compact" and simple_model and str(parent.name) in ["DoorSeamsLeft","DoorSeamsRight","TailgatePanelSeam"]:
+		_builder("compact_seam_strip").add(parent,start,end,width,surface)
+		return
+	var stroke := VisualGeometry.box(parent,Vector3(width,width,start.distance_to(end)),(start+end)*0.5,surface)
+	var up: Vector3 = Vector3.RIGHT if absf((end-start).normalized().dot(Vector3.UP)) > 0.99 else Vector3.UP
+	stroke.basis = Basis.looking_at(end-start,up)
+
+
+func _hatchback(paint: Material, glass: Material, trim: Material, blue: Material) -> void:
+	# Broad roof, long side glazing and a sloping rear hatch; +Z is the tail.
+	_builder("compact_coachwork").build_cabin(self,paint,blue)
+	var roof_paint := CompactFinish.paint(Color("c5baa0"))
+	accent_roof = roof_paint
+	_builder("compact_coachwork").build_roof(self,roof_paint)
+	_builder("compact_glazing").sheet(self,true,trim)
+	_builder("compact_glazing").sheet(self,false,trim)
+	var door_bevels: Array[float] = [0.035,0.025,0.025,0.055]
+	var quarter_bevels: Array[float] = [0.025,0.070,0.045,0.025]
+	for side: float in [-1.0,1.0]:
+		var suffix: String="Left" if side<0 else "Right"
+		# Both openings share their sill, roof rail, pillar and dark gasket.
+		_builder("compact_glazing").window(self,_builder("compact_coachwork").side_window_corners(side,true),Vector3(side,0.277,0),trim,0.0,door_bevels,null,"DoorWindow"+suffix)
+		_builder("compact_glazing").window(self,_builder("compact_coachwork").side_window_corners(side,false),Vector3(side,0.277,0),trim,0.0,quarter_bevels,null,"QuarterWindow"+suffix)
+		_seam(body,Vector3(side*0.70,1.02,-0.92),Vector3(side*0.12,1.04,-0.93),0.022,trim)
+	# A fine inset perimeter crease defines the pressed roof's rolled edge.
+	var roof_line := CompactFinish.paint(Color("b3aa95"))
+	var roof_highlight := CompactFinish.paint(Color("dcd1b6"))
+	paint_variants.append({"material":roof_line,"slot":"accent","darken":0.14})
+	paint_variants.append({"material":roof_highlight,"slot":"accent","darken":0.02})
+	var perimeter: Array[Vector2] = [Vector2(-0.44,-0.38),Vector2(0.44,-0.38),Vector2(0.60,-0.16),Vector2(0.60,0.94),Vector2(0.44,1.16),Vector2(-0.44,1.16),Vector2(-0.60,0.94),Vector2(-0.60,-0.16)]
+	for i: int in range(perimeter.size()):
+		var a: Vector2 = perimeter[i]
+		var b: Vector2 = perimeter[(i+1)%perimeter.size()]
+		var pa: Vector3 = _builder("compact_coachwork").roof_point(a.x/0.63,(a.y+0.4)/1.58)
+		var pb: Vector3 = _builder("compact_coachwork").roof_point(b.x/0.63,(b.y+0.4)/1.58)
+		_seam(body,pa+Vector3.UP*0.001,pb+Vector3.UP*0.001,0.004,roof_line)
+		var inset_a: Vector2 = Vector2(0,0.39).lerp(a,0.986)
+		var inset_b: Vector2 = Vector2(0,0.39).lerp(b,0.986)
+		_seam(body,_builder("compact_coachwork").roof_point(inset_a.x/0.63,(inset_a.y+0.4)/1.58)+Vector3.UP*0.001,_builder("compact_coachwork").roof_point(inset_b.x/0.63,(inset_b.y+0.4)/1.58)+Vector3.UP*0.001,0.003,roof_highlight)
+
+
+func _panel(points: Array[Vector3], normal: Vector3, surface: Material) -> void:
+	var tool := SurfaceTool.new()
+	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var indices: Array[int] = [0,1,2,0,2,3]
+	if (points[1]-points[0]).cross(points[2]-points[0]).dot(normal) > 0:
+		indices = [0,2,1,0,3,2]
+	for index: int in indices:
+		tool.set_normal(normal.normalized())
+		tool.add_vertex(points[index])
+	var node := MeshInstance3D.new()
+	node.mesh = tool.commit()
+	node.material_override = surface
+	body.add_child(node)
