diff --git a/game/tests/support/car_pass10_showroom.gd b/game/tests/support/car_pass10_showroom.gd
new file mode 100644
index 0000000000000000000000000000000000000000..9e4492786d8b7a456d7f45f934ae354d59e8a2a5
