+				output.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,source.surface_get_arrays(surface))
+				witnesses.append([]);contacts.append([]);after+=source.surface_get_arrays(surface)[Mesh.ARRAY_INDEX].size()/3
