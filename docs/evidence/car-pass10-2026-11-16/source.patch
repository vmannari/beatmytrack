+
+def error(points,tree,limit):
+    maximum=0.0
+    for p in points:
+        hit=tree.find_nearest(p)
+        if hit[0] is None:return float('inf')
+        maximum=max(maximum,hit[3])
+        if maximum>limit:return maximum
