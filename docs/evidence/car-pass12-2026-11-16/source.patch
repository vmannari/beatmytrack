+            field=0.0
+            for f in candidate:
+                point=sum((p[i] for i in f),Vector())/3;hit=old.find_nearest(point)
+                error=max(error,hit[3]);old_f=faces[hit[2]];weights=bary(hit[0],*(p[i] for i in old_f))
