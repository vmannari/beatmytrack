+command = ["C:/apps/Godot 4.7.2/Godot_v4.7.2-stable_win64_console.exe", "--headless", "--audio-driver", "Dummy", "--path", str(fixture), "--script", str(root/"game/tests/test_car_step10_dependencies.gd")]
