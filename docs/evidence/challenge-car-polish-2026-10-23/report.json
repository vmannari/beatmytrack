{
  "date": "2026-10-23",
  "requirements": {
    "CCP01": "Widen car cards to fill the full available row, with responsive swipe slots.",
    "CCP02": "Remove the car title, description and other right-hand copy; retain necessary source timing in the action dock.",
    "CCP03": "Keep the same environment, viewport and exact camera pose across car selection.",
    "CCP04": "Reuse the original GarageCarReveal and CarShowroom replacement animation.",
    "CCP05": "Offer verified personal-best creation for one-to-one and group challenges without requiring another race.",
    "R01": "Exact finished-result tickets, five cars/saved cosmetics, source/account fences, target-free unseeded groups, explicit race intent and existing 3x3 behavior.",
    "G01": "Native Compatibility and desktop Mobile views, every car, compact responsive layouts, and transition-phase captures.",
    "Q01": "Focused and integrated native checks, real canonical HTTP personal-best and race-first flows, original garage animation regression, parser, source fingerprints and task-only checkpoint."
  },
  "implementation": {
    "layout": "Adaptive card widths distribute whole-pixel remainders across visible slots; all five cards fill wide screens, and smaller screens retain horizontal swiping. The actual model occupies the full content width.",
    "showroom": "GarageEnvironment, fixed Garage camera/framing and a retained hero CarShowroom replace per-car studio reconstruction. Selecting a different car calls the original replace_car.",
    "animation": "Existing 0.26s hide / 0.38s reveal light sweep. Read-only views process only while replacing a car; completion/hiding returns them to one-shot rendering. Read-only animation does not run weathering/wash behavior.",
    "personal_best": "Single-track ordinary groups now query the existing authoritative source endpoint. Use personal best includes its source_run_id and does not launch a race; group Create & race omits it. No backend/schema changes are required.",
    "result_pinning": "A finished-result context continues to send only its exact source_ticket_id; no PB fallback or alternate car models are offered.",
    "provenance": "All geometry, Garage environment, reveal shaders and cosmetics are existing authored assets; no new external or generated assets."
  },
