+		check(ChallengesClient.code_from(bad).is_empty(),"malformed code is rejected: "+bad)
+	for mutation: String in ["duplicate","nonfinite","overflow","laps","unknown_car","joined"]:
+		var bad: Dictionary = sample.duplicate(true)
+		match mutation:
