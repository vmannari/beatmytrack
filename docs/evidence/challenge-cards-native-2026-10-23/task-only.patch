+func _rivalry_ghost(index: int, choice: int, wait_for_recording: bool = false) -> Dictionary:
+	if choice == 3: return {}
+	var target: Dictionary = rivalry.model.ghost_target(index,choice)
+	var driver: String = str(target.get("driver_id",""))
+	if wait_for_recording: return await rivalry.ghost(index,driver)
+	rivalry.prefetch_ghost(index,driver)
+	return rivalry.cached_ghost(index,driver)
+
+func _start_rivalry_race(index: int, choice: int) -> void:
+	if cloud_starting or not online.client.signed_in() or rivalry.model.sample: return
+	if index < 0 or index >= rivalry.model.tracks.size(): return
+	var navigation: int = _navigation_generation
+	var original_scope: String = rivalry.scope()
+	var original_group: String = rivalry.model.group_id
+	var original_week: int = rivalry.model.week
+	var original_version: String = str(rivalry.model.tracks[index].entry.get("version_id",""))
+	cloud_starting = true
+	_rivalry()
+	var loading: RaceLoading = _open_race_loading()
+	var loading_id: int = loading.get_instance_id()
+	var metadata: Dictionary = rivalry.model.tracks[index].entry
+	var points := PackedVector2Array()
+	for point: Array in metadata.get("points", []): points.append(Vector2(point[0], point[1]))
+	loading.configure(str(metadata.get("name", "Weekly Rivalry")), str(metadata.get("theme", "pine")), points)
+	loading.stage("Connecting race…")
+	await _present_race_loading()
+	if not _race_loading_matches(loading_id): return
+	if navigation != _navigation_generation or original_scope != rivalry.scope():
+		cloud_starting = false
+		_close_race_loading(loading_id)
+		return
+	# A background refresh can be syncing appearance before it emits changed.
+	# Retain this explicit start instead of silently losing its first tap.
+	while rivalry.busy:
+		await get_tree().process_frame
+		if not _race_loading_matches(loading_id): return
+		if navigation != _navigation_generation or original_scope != rivalry.scope():
+			_close_race_loading(loading_id)
+			return
+	var same_track: bool = index < rivalry.model.tracks.size() and str(rivalry.model.tracks[index].entry.get("version_id","")) == original_version
+	var same_week: bool = rivalry.model.group_id == original_group and rivalry.model.week == original_week
+	var available: bool = same_track and bool(rivalry.model.tracks[index].get("available",true))
+	if rivalry.cached_snapshot or rivalry.snapshot_scope != original_scope or not same_week or not available or rivalry.model.completed or rivalry.model.status != "active":
+		_close_race_loading(loading_id)
+		_rivalry()
+		_notice(rivalry.error if not rivalry.error.is_empty() else "Rivalry changed while preparing the race. Open the track and try again.")
+		return
+	_rivalry_ghost(index,choice) # Fetch presentation in parallel with required race data.
+	var issued: Dictionary = await rivalry.ticket(index)
+	if not _race_loading_matches(loading_id): return
+	if navigation != _navigation_generation or original_scope != rivalry.scope():
+		cloud_starting = false
+		_close_race_loading(loading_id)
+		return
+	if issued.is_empty():
+		cloud_starting = false
+		_close_race_loading(loading_id)
+		if rivalry.error.is_empty(): rivalry.error = "Could not connect the race. Refresh Rivalry and try again."
+		_rivalry()
+		_notice(rivalry.error)
+		return
+	var entry: Dictionary = cloud.entry_from_metadata(rivalry.model.tracks[index].entry)
+	loading.stage("Downloading track…")
+	var downloaded: Dictionary = await cloud.download_document(entry)
+	if not _race_loading_matches(loading_id): return
+	if navigation != _navigation_generation or original_scope != rivalry.scope():
+		cloud_starting = false
+		_close_race_loading(loading_id)
+		return
+	if downloaded.is_empty():
+		cloud_starting = false
+		_close_race_loading(loading_id)
+		rivalry.error = cloud.last_error if not cloud.last_error.is_empty() else "Track download failed. Check your connection and try again."
+		_rivalry()
+		_notice(rivalry.error)
+		return
+	loading.stage("Preparing track…")
+	await _present_race_loading()
+	if not _race_loading_matches(loading_id): return
+	if navigation != _navigation_generation or original_scope != rivalry.scope():
+		cloud_starting = false
+		_close_race_loading(loading_id)
+		return
+	var track: NativeTrack = await online.client._background(cloud.compile_document.bind(entry,downloaded))
+	if not _race_loading_matches(loading_id): return
+	if navigation != _navigation_generation or original_scope != rivalry.scope():
+		cloud_starting = false
+		_close_race_loading(loading_id)
+		return
+	if track == null:
+		cloud_starting = false
+		_close_race_loading(loading_id)
+		rivalry.error = "Track could not be prepared. Try again."
+		_rivalry()
+		_notice(rivalry.error)
+		return
+	loading.stage("Loading ghost…")
+	var recording: Dictionary = await _rivalry_ghost(index,choice,true)
+	if not _race_loading_matches(loading_id): return
+	cloud_starting = false
+	_close_race_loading(loading_id)
+	if navigation != _navigation_generation or original_scope != rivalry.scope(): return
+	rivalry_track = index
+	rivalry_ghost_choice = choice
+	rivalry_recording = recording
+	rivalry_result_pending = false
+	rivalry_race_details = {}
+	rivalry.result_ticket = ""
+	rivalry.result_state = ""
+	selected_track = track
+	await _start_race(track,false,false,issued)
+
+func _ensure_garage_parking() -> void:
+	if not is_instance_valid(_garage_parking):
+		_garage_parking = VBoxContainer.new()
+		_garage_parking.name = "RetainedGarage"
+		_garage_parking.process_mode = Node.PROCESS_MODE_DISABLED
+		menu_layer.add_child(_garage_parking)
+		menu_layer.move_child(_garage_parking,0)
+		MenuStyle.fill(_garage_parking)
+		_set_menu_preview_input(_garage_parking,true)
+		_garage_parking.hide()
+
+func _park_garage() -> void:
+	if not is_instance_valid(_retained_garage): return
+	_ensure_garage_parking()
+	if _retained_garage.get_parent() != _garage_parking:
+		_retained_garage.reparent(_garage_parking,false)
+
+func _prepare_garage_covered() -> void:
+	if is_instance_valid(_retained_garage) and _retained_garage.records == records: return
+	if screen != "restoring": _show_screen("restoring")
+	# Draw the ordinary startup cover before the one-time native construction.
+	# This deliberately pays the original cold cost at startup, not under menu
+	# input. No geometry/material/render settings or preview fidelity changes.
+	var generation: int = _navigation_generation
+	var owner_records: LocalRecords = records
+	await get_tree().process_frame
+	if DisplayServer.get_name() != "headless": await RenderingServer.frame_post_draw
+	if not is_inside_tree() or generation != _navigation_generation or owner_records != records: return
+	if is_instance_valid(_retained_garage) and _retained_garage.records != records:
+		_retained_garage.get_parent().remove_child(_retained_garage)
+		_retained_garage.queue_free()
+		_retained_garage = null
+	_ensure_garage_parking()
+	_garage(_garage_parking)
+	# Submit the original views under the opaque cover too, so first menu use
+	# does not inherit their first shader draw. The parking slot cannot take input.
+	_garage_parking.show()
+	for _frame: int in range(4):
+		await get_tree().process_frame
+		if not is_inside_tree() or generation != _navigation_generation or owner_records != records: return
+		# The parking branch is inactive. Present its container-managed rectangles
+		# explicitly so the covered draws use real view sizes, rather than 1x1s.
+		_retained_garage._present_menu_layout()
+		if DisplayServer.get_name() != "headless": await RenderingServer.frame_post_draw
+		if not is_inside_tree() or generation != _navigation_generation or owner_records != records: return
+	_garage_parking.hide()
+
+func _rebuild_profile_menu(destination: String) -> void:
+	_show_screen("restoring")
+	var generation: int = _navigation_generation
