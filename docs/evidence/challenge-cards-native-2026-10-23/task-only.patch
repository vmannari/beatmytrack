+	menu_neighbors.clear()
+	content = null
+	menu_body = null
+	menu_body_slot = null
+	menu_body_backgrounds.clear()
+	root_ui.visible = true
+	for child: Node in root_ui.get_children():
+		root_ui.remove_child(child)
+		child.queue_free()
+	var background := ColorRect.new()
+	background.color = Color.WHITE
