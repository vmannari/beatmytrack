{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:beat-my-track:challenge-create-v1",
  "title": "Create a challenge from a pinned track or completed race",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_id",
    "vehicle_id"
  ],
  "properties": {
    "version_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "vehicle_id": {
      "enum": [
        "compact",
        "pickup",
        "classic",
        "formula",
        "kart"
      ]
    },
    "mode": {
      "enum": [
        "beat",
        "group",
        "3x3"
      ],
      "default": "beat"
    },
    "visibility": {
      "enum": [
        "private",
        "public"
      ],
      "default": "private"
    },
    "duration_seconds": {
      "enum": [
        86400,
        259200,
        604800
      ],
      "default": 604800
    },
    "attempt_limit": {
      "enum": [
        null,
        1,
        3,
        5
      ],
      "default": null
    },
    "source_run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36
    },
    "source_ticket_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36
    },
    "version_ids": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "not": {
    "type": "object",
    "required": [
      "source_run_id",
      "source_ticket_id"
    ],
    "properties": {
      "source_run_id": {
        "type": "string"
      },
      "source_ticket_id": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "3x3"
          }
        }
      },
      "then": {
        "required": [
          "version_ids",
          "attempt_limit"
        ],
        "properties": {
          "version_ids": {
            "type": "array"
          },
          "attempt_limit": {
            "const": 3
          }
        }
      },
      "else": {
        "properties": {
          "version_ids": {
            "type": "null"
          }
        }
      }
    }
  ]
}
