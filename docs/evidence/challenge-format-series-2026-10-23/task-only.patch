+func _undo() -> void:
+	if history.is_empty(): return
+	redo_history.append(EDITOR_HISTORY.capture(document,history.back()))
+	document = EDITOR_HISTORY.restore(history.pop_back())
+	EDITOR_HISTORY.trim(history,redo_history)
+	_restore_editor_history()
+
+func _redo() -> void:
+	if redo_history.is_empty(): return
+	history.append(EDITOR_HISTORY.capture(document,redo_history.back()))
+	document = EDITOR_HISTORY.restore(redo_history.pop_back())
+	EDITOR_HISTORY.trim(history,redo_history)
