@@ -0,0 +1,364 @@
+"""Offline rear bumper crown and supported trunk shut lines."""
+import numpy as np
+
+import challenger_clean_panels as panels
+from challenger_exterior_geometry import records
+from challenger_side_surface import ramp, unit
+
+
+class RearSurface:
+    def __init__(self, body, profile=None):
+        if profile is not None:
+            self.bumper = np.asarray(profile['bumper'])
+            self.deck = np.asarray(profile['deck'])
+            return
+        from mathutils.bvhtree import BVHTree
+
+        points, faces, _ = panels._read(body)
+        tree = BVHTree.FromPolygons(points.tolist(), faces.tolist(), all_triangles=True)
+        bumper, deck = [], []
+        for x in np.linspace(0, .755, 77):
+            for y in np.linspace(.605, .748, 31):
+                hit, *_ = tree.ray_cast((float(x), float(y), 3), (0, 0, -1), 1)
+                if hit is not None:
+                    bumper.append([x, y, hit.z])
+            for z in np.linspace(1.48, 2.065, 61):
+                if x > .64:
+                    continue
+                hit, *_ = tree.ray_cast((float(x), 2, float(z)), (0, -1, 0), 1.2)
+                if hit is not None:
+                    deck.append([x, z, hit.y])
+        bumper, deck = np.asarray(bumper), np.asarray(deck)
+        self.bumper = self.fit(self.bumper_terms(bumper[:, 0], bumper[:, 1]), bumper[:, 2])
+        self.deck = self.fit(self.deck_terms(deck[:, 0], deck[:, 1]), deck[:, 2])
+
+    @staticmethod
+    def fit(matrix, values):
+        keep = np.ones(len(values), dtype=bool)
+        for _ in range(4):
+            result = np.linalg.lstsq(matrix[keep], values[keep], rcond=None)[0]
+            residual = abs(matrix @ result - values)
+            keep = residual < max(.0025, float(np.percentile(residual, 90)))
+        return result
+
+    @staticmethod
+    def bumper_terms(x, y):
+        x, y = np.broadcast_arrays(x, y)
+        v = (y - .70) / .10
+        return np.stack([x**i * v**j for i in [0, 2] for j in range(4)], axis=-1)
+
+    @staticmethod
+    def deck_terms(x, z):
+        x, z = np.broadcast_arrays(x, z)
+        v = (z - 1.8) / .4
+        return np.stack([x**i * v**j for i in [0, 2, 4] for j in range(4)], axis=-1)
+
+    def bumper_z(self, x, y):
+        return self.bumper_terms(x, y) @ self.bumper
+
+    def deck_y(self, x, z):
+        return self.deck_terms(x, z) @ self.deck
+
+    def deck_normal(self, x, z):
+        e = .00002
+        dx = (self.deck_y(x + e, z) - self.deck_y(x - e, z)) / (2 * e)
+        dz = (self.deck_y(x, z + e) - self.deck_y(x, z - e)) / (2 * e)
+        return unit(np.stack([-dx, np.ones_like(dx), -dz], axis=-1))
+
+    def roll(self, x, t):
+        """Cubic section tangent to the bumper face and horizontal lamp shelf."""
+        x, t = np.broadcast_arrays(x, t)
+        y0 = self.shelf_y(x)-.020
+        z0 = self.bumper_z(x, y0)
+        e = .00002
+        slope = (self.bumper_z(x, y0 + e) - self.bumper_z(x, y0 - e)) / (2 * e)
+        a = np.stack([y0, z0], axis=-1)
+        b = a + np.stack([np.full_like(x, .012), slope * .012], axis=-1)
+        d = np.stack([self.shelf_y(x), z0 - .013], axis=-1)
+        c = d + [0, .008]
+        t = t[..., None]
+        return a * (1-t)**3 + 3*b*(1-t)**2*t + 3*c*(1-t)*t*t + d*t**3
+
+    @staticmethod
+    def shelf_y(x):
+        corner = np.clip(abs(x)-.755, 0, .0549)
+        return .7635+.055-np.sqrt(.055**2-corner**2)
+
+    def bumper_point(self, points):
+        p = np.asarray(points)
+        x, y, z = p.T
+        q = p.copy()
+        q[:, 2] = self.bumper_z(x, y)
+        y0 = self.shelf_y(x)-.020
+        top = y >= y0
+        t = np.clip((y-y0)/.020, 0, 1)
+        # Closest section parameter distributes the existing roll vertices
+        # coherently without adding edge loops or collapsing the flat shelf.
+        for _ in range(7):
+            e = .0001
+            curve = self.roll(x, t)
+            tangent = (self.roll(x, t+e)-self.roll(x, t-e))/(2*e)
+            second = (self.roll(x, t+e)-2*curve+self.roll(x, t-e))/(e*e)
+            delta = curve-p[:, 1:]
+            divisor = np.sum(tangent*tangent+delta*second, axis=1)
+            step = np.sum(delta*tangent, axis=1)/np.maximum(divisor, 1e-8)
+            t = np.clip(t-step, 0, 1)
+        q[top, 1:] = self.roll(x[top], t[top])
+        shelf = top & (z < self.roll(x, np.ones_like(x))[:, 1])
+        q[shelf, 1] = self.shelf_y(x[shelf])
+        q[shelf, 2] = z[shelf]
+        on_join = top & (abs(z-self.roll(x, np.ones_like(x))[:, 1])<2e-7)
+        q[on_join, 1] = self.shelf_y(x[on_join])
+        q[on_join, 2] = z[on_join]
+        return q, t, shelf
+
+    def bumper_map(self, p):
+        weight = (ramp(2.04, 2.11, p[:, 2]) * ramp(.57, .62, p[:, 1])
+                  * (1-ramp(.77, .825, abs(p[:, 0])))
+                  * (1-ramp(self.shelf_y(p[:, 0])+.015, self.shelf_y(p[:, 0])+.035, p[:, 1])))
+        face = p[:, 1] < self.shelf_y(p[:, 0])-.020
+        error = abs(self.bumper_z(p[:, 0], p[:, 1])-p[:, 2])
+        weight *= np.where(face, 1-ramp(.012, .022, error), 1)
+        selected = weight > 0
+        q = p.copy()
+        target, _, _ = self.bumper_point(p[selected])
+        q[selected] += weight[selected, None]*(target-p[selected])
+        return q
+
+    def fair_bumper(self, values):
+        v = np.asarray(values).reshape(-1, 6).copy()
+        p = v[:, :3].copy()
+        v[:, :3] = self.bumper_map(p)
+        selected = ((p[:, 2]>2.04) & (p[:, 1]>.57) & (abs(p[:, 0])<.825)
+                    & (p[:, 1]<self.shelf_y(p[:, 0])+.035))
+        points = p[selected]
+        e = .00002
+        columns = []
+        for axis in range(3):
+            step = np.eye(3)[axis]*e
+            columns.append((self.bumper_map(points+step)-self.bumper_map(points-step))/(2*e))
+        a, b, c = columns
+        normal = v[selected, 3:]
+        guide = (normal[:, 0, None]*np.cross(b, c)+normal[:, 1, None]*np.cross(c, a)
+                 +normal[:, 2, None]*np.cross(a, b))
+        valid = np.linalg.norm(guide, axis=1) > 1e-10
+        normal[valid] = unit(guide[valid])
+        q = v[selected, :3]
+        shelf = ((abs(q[:, 1]-self.shelf_y(q[:, 0]))<1e-7)
+                 & (q[:, 2]<=self.roll(q[:, 0], np.ones(len(q)))[:, 1]+1e-7)
+                 & (abs(q[:, 0])<.755))
+        normal[shelf] = [0, 1, 0]
+        v[selected, 3:] = normal
+        return v.reshape(-1, 3, 6), float(np.linalg.norm(v[:, :3]-p, axis=1).max())
+
+    def bumper_rows(self, values, simple):
+        """Give broad source triangles stations at the face and shelf joins."""
+        def split(face, distance, level=None):
+            if min(distance)>=-1e-9 or max(distance)<=1e-9:
+                return [face]
+            pieces = []
+            for sign in [-1, 1]:
+                polygon = []
+                for i, a in enumerate(face):
+                    j = (i+1)%3
+                    if distance[i]*sign>=0:
+                        polygon.append(a)
+                    if distance[i]*distance[j]<0:
+                        t = distance[i]/(distance[i]-distance[j])
+                        if level is not None:
+                            low, high = 0., 1.
+                            for _ in range(24):
+                                t = (low+high)*.5
+                                q = a+(face[j]-a)*t
+                                if level(q[None, :3])[0]*distance[i]>0:
+                                    low = t
+                                else:
+                                    high = t
+                        polygon.append(a+(face[j]-a)*t)
+                pieces.extend(np.asarray([polygon[0], polygon[i], polygon[i+1]]) for i in range(1, len(polygon)-1))
+            return pieces
+        result = []
+        for face in values:
+            p = face[:, :3]
+            if p[:, 2].min()<1.95 or p[:, 2].max()<2.10 or p[:, 1].max()<.655 or p[:, 1].min()>.80:
+                result.append(face)
+                continue
+            pieces = [face]
+            cuts = [(0, -.755), (0, .755), (1, .69)]
+            if not simple:
+                cuts.append((1, .7435))
+            for axis, position in cuts:
+                pieces = [part for piece in pieces for part in split(piece, piece[:, axis]-position)]
+            for piece in pieces:
+                p = piece[:, :3]
+                end = self.roll(p[:, 0], np.ones(3))[:, 1]
+                if p[:, 1].min()<.745:
+                    result.append(piece)
+                    continue
+                def level(q):
+                    return q[:, 2]-self.roll(q[:, 0], np.ones(len(q)))[:, 1]
+                result.extend(split(piece, p[:, 2]-end, level))
+        result = np.asarray(result)
+        from challenger_front_surface import split_boundary_edges
+        center = result[:, :, :3].mean(1)
+        band = result[(center[:, 2]>1.95) & (center[:, 1]>.64) & (center[:, 1]<.81)]
+        return split_boundary_edges(result, band)
+
+    def rebuild_deck(self, values):
+        from mathutils import Vector
+        from mathutils.geometry import delaunay_2d_cdt
+
+        values = np.asarray(values).copy()
+        v = values.reshape(-1, 6)
+        p = v[:, :3].copy()
+        target = self.deck_y(p[:, 0], p[:, 2])
+        front = 1.48-.06*(p[:, 0]/.78)**2
+        weight = (ramp(front-.04, front, p[:, 2]) * (1-ramp(2.03, 2.07, p[:, 2]))
+                  * (1-ramp(.78, .81, abs(p[:, 0]))) * ramp(.96, .985, p[:, 1]))
+        # Only the exterior deck and its shallow gutter share this chart.
+        weight *= 1-ramp(.018, .035, abs(target-p[:, 1]))
+        v[:, 1] += weight*(target-p[:, 1])
+        guide = self.deck_normal(v[:, 0], v[:, 2])
+        continuous = np.sum(v[:, 3:]*guide, axis=1) > .1
+        normal_weight = weight*continuous
+        v[:, 3:] = unit(v[:, 3:]*(1-normal_weight[:, None])+guide*normal_weight[:, None])
+        kept = []
+        parameter = (v[:, 2]-front)/(2.03-front)
+        extended = np.c_[v, parameter].reshape(-1, 3, 7)
+        for face in extended:
+            kept.extend(panels._subtract_box(face, [(0, -.78, .78), (6, 0, 1), (1, .98, 1.2)]))
+        kept = np.asarray(kept)
+        # Keep every clipped edge station, so the replacement shares the exact
+        # boundary triangles of the surrounding rear quarters.
+        boundary = kept.reshape(-1, 7)
+        x, y = boundary[:, :2].T
+        v = boundary[:, 6]
+        border = (((abs(abs(x)-.78)<1e-7) & (v>=-1e-7) & (v<=1+1e-7)
+                   | ((abs(v)<1e-7) | (abs(v-1)<1e-7)) & (abs(x)<=.78+1e-7)) & (y>.98))
+        b = boundary[border].copy()
+        front = 1.48-.06*(b[:, 0]/.78)**2
+        b[:, 2] = front+b[:, 6]*(2.03-front)
+        b[:, 1] = self.deck_y(b[:, 0], b[:, 2])
+        b[:, 3:6] = self.deck_normal(b[:, 0], b[:, 2])
+        boundary[border] = b
+        samples = b[:, [0, 6]].tolist()
+        samples += [[x, v] for x in np.linspace(-.78, .78, 9) for v in np.linspace(0, 1, 4)]
+        uv = np.unique(np.round(samples, 7), axis=0)
+        constraints = []
+        for axis, value in [(0, -.78), (0, .78), (1, 0), (1, 1)]:
+            ids = np.flatnonzero(abs(uv[:, axis]-value)<1e-7)
+            ids = ids[np.argsort(uv[ids, 1-axis])]
+            constraints.extend(zip(ids[:-1].tolist(), ids[1:].tolist()))
+        uv, _, faces, *_ = delaunay_2d_cdt([Vector(q) for q in uv], constraints, [], 0, 1e-8, False)
+        uv = np.asarray(uv)
+        front = 1.48-.06*(uv[:, 0]/.78)**2
+        z = front+uv[:, 1]*(2.03-front)
+        generated = np.c_[uv[:, 0], self.deck_y(uv[:, 0], z), z, self.deck_normal(uv[:, 0], z)]
+        patch = generated[np.asarray(faces)]
+        flip = np.cross(patch[:, 1, :3]-patch[:, 0, :3], patch[:, 2, :3]-patch[:, 0, :3])[:, 1] < 0
+        patch[flip] = patch[flip, ::-1]
+        return np.concatenate([kept[:, :, :6], patch]), {'source_triangles': len(values), 'retained_triangles': len(kept), 'new_deck_triangles': len(patch)}
+
+    def profile(self):
+        return {'bumper': self.bumper.tolist(), 'deck': self.deck.tolist()}
+
+    @staticmethod
+    def weld_deck(values):
+        """Merge sub-millimetre clipping fragments within one smooth deck chart."""
+        from mathutils.kdtree import KDTree
+
+        unique, inverse, count = np.unique(values.reshape(-1, 6), axis=0, return_inverse=True, return_counts=True)
+        p = unique[:, :3]
+        front = 1.48-.06*(p[:, 0]/.78)**2
+        selected = np.flatnonzero((abs(p[:, 0])<.811) & (p[:, 2]>front-.01)
+                                  & (p[:, 2]<2.04) & (p[:, 1]>.98))
+        tree = KDTree(len(selected))
+        for i in selected:
+            tree.insert(p[i], int(i))
+        tree.balance()
+        anchors = np.arange(len(unique))
+        for i in selected[np.argsort(-count[selected], kind='stable')]:
+            if anchors[i]!=i:
+                continue
+            for _, j, _ in tree.find_range(p[i], .00075):
+                if anchors[j]==j and unique[i, 3:] @ unique[j, 3:]>.9994:
+                    anchors[j] = i
+        return unique[anchors[inverse]].reshape(-1, 3, 6)
+
+
+def trunk_seam(exports):
+    """Append producer-paired ribbon stations fitted to the actual rear skin."""
+    from mathutils.bvhtree import BVHTree
+
+    body = next(obj for obj in exports if obj.name == 'body__paint')
+    contour = next(obj for obj in exports if obj.name == 'body__contour')
+    points, faces, _ = panels._read(body)
+    tree = BVHTree.FromPolygons(points.tolist(), faces.tolist(), all_triangles=True)
+    mesh = contour.data
+    pairs = {}
+    for loop in mesh.loops:
+        point = mesh.vertices[loop.vertex_index].co
+        pairs[tuple(point)] = (tuple(mesh.uv_layers[0].data[loop.index].uv), tuple(mesh.uv_layers[1].data[loop.index].uv))
+    next_pair = max(int(abs(pair[0][0]))-1+int(pair[1][0])*1024 for pair in pairs.values())+1
+    # The aft line remains beneath the original spoiler. The forward line
+    # follows the rear glass base and the two long sides retain the factory width.
+    path = []
+    for x in np.linspace(-.688, .688, 13):
+        path.append([x, 1.487-.051*(x/.688)**2])
+    for z in np.linspace(1.436, 2.025, 9)[1:]:
+        path.append([.688+.004*((z-1.436)/.589)**2, z])
+    for x in np.linspace(.692, -.692, 13)[1:]:
+        path.append([x, 2.025])
+    for z in np.linspace(2.025, 1.436, 9)[1:-1]:
+        path.append([-.688-.004*((z-1.436)/.589)**2, z])
+    path = np.asarray(path)
+    rows = []
+    for i, center in enumerate(path):
+        tangent = path[(i+1)%len(path)]-path[i-1]
+        across = np.array([-tangent[1], tangent[0]])/np.linalg.norm(tangent)
+        row = []
+        for side in [-1, 1]:
+            x, z = center+across*side*.00125
+            hit, normal, *_ = tree.ray_cast((float(x), 2, float(z)), (0, -1, 0), 1.2)
+            assert hit is not None, 'Trunk seam station requires actual paint support '+str((x,z))
+            p = np.asarray(hit)+np.asarray(normal)*.0018
+            row.append(np.r_[p, normal])
+            blender = (float(np.float32(p[0])), float(np.float32(-p[2])), float(np.float32(p[1])))
+            pairs[blender] = ((side*(next_pair%1024+1), 0), (next_pair//1024, 0))
+        rows.append(row)
+        next_pair += 1
+    additions = []
+    for i, a in enumerate(rows):
+        b = rows[(i+1)%len(rows)]
+        additions.extend([[a[0], b[1], b[0]], [a[0], a[1], b[1]]])
+    panels._write(contour, np.concatenate([records(contour), additions]))
+    mesh = contour.data
+    uv = mesh.uv_layers.new(name='ContourPair')
+    block = mesh.uv_layers.new(name='ContourPairBlock')
+    from mathutils.kdtree import KDTree
+    keys = list(pairs)
+    lookup = KDTree(len(keys))
+    for index, key in enumerate(keys):
+        lookup.insert(key, index)
+    lookup.balance()
+    for loop in mesh.loops:
+        p = mesh.vertices[loop.vertex_index].co
+        _, index, distance = lookup.find(p)
+        assert distance < .0000003, 'Contour pair identity must survive quantisation'
+        identity = pairs[keys[index]]
+        uv.data[loop.index].uv = identity[0]
+        block.data[loop.index].uv = identity[1]
+    return len(rows)
+
+
+def refine(exports, simple, profile=None):
+    body = next(obj for obj in exports if obj.name == 'body__paint')
+    field = RearSurface(body, profile)
+    values, displacement = field.fair_bumper(field.bumper_rows(records(body), simple))
+    values, statistics = field.rebuild_deck(values)
+    values = field.weld_deck(values)
+    panels._write(body, panels._symmetric(values))
+    statistics['bumper_maximum_displacement_mm'] = displacement*1000
+    statistics['trunk_seam_stations'] = trunk_seam(exports)
+    statistics['body_triangles_after'] = len(body.data.polygons)
+    return field.profile(), statistics
