+def close_upper_deck(obj):
+    """Close small retained donor cracks above the new rear quarter loft."""
+    from collections import Counter,defaultdict
+    from mathutils import Vector
+    from mathutils.geometry import tessellate_polygon
+    values=records(obj);flat=values.reshape(-1,6)
+    keys,inverse=np.unique(np.round(flat[:,:3],4),axis=0,return_inverse=True)
+    positions=np.zeros_like(keys);normals=np.zeros_like(keys);counts=np.zeros(len(keys))
+    np.add.at(positions,inverse,flat[:,:3]);np.add.at(normals,inverse,flat[:,3:]);np.add.at(counts,inverse,1)
+    positions/=counts[:,None];normals=normalise(normals)
+    edges=Counter()
+    for face in inverse.reshape(-1,3):
+        for aa,bb in zip(face,np.roll(face,-1)):
+            if aa!=bb:edges[tuple(sorted((int(aa),int(bb))))]+=1
+    adjacent=defaultdict(set)
+    for (aa,bb),count in edges.items():
+        if count==1:adjacent[aa].add(bb);adjacent[bb].add(aa)
+    # Cycle basis also separates cracks which touch at a shared seam vertex.
+    remaining=set(adjacent);cycles=[]
+    while remaining:
+        root=min(remaining);stack=[root];previous={root:root};used={root:set()}
+        while stack:
+            vertex=stack.pop()
+            for other in sorted(adjacent[vertex]):
+                if other not in used:
+                    previous[other]=vertex;stack.append(other);used[other]={vertex}
+                elif other not in used[vertex]:
+                    common=used[other];cycle=[other,vertex];cursor=previous[vertex]
+                    while cursor not in common:cycle.append(cursor);cursor=previous[cursor]
+                    cycle.append(cursor);cycles.append(cycle);used[other].add(vertex)
+        remaining-=set(previous)
+    added=[];closed=[]
+    for cycle in cycles:
+        q=positions[cycle];centre=q.mean(0);span=np.ptp(q,axis=0)
+        if not (centre[0]>.65 and centre[1]>.975 and centre[2]>1.55 and q[:,1].min()>.970 and q[:,1].max()>.985):continue
+        if len(cycle)<3 or len(cycle)>128 or span[0]>.16 or span[1]>.12 or span[2]>.65:continue
+        area=np.linalg.norm(np.sum(np.cross(q-q[0],np.roll(q,-1,axis=0)-q[0]),axis=0))*.5
+        if not .000001<area<.015:continue
+        vectors=[Vector(point) for point in q]
+        lookup={tuple(np.round(point,6)):i for i,point in enumerate(q)}
+        faces=[]
+        for triangle in tessellate_polygon([vectors]):
+            face=[]
+            for point in triangle:
+                index=int(point) if np.isscalar(point) else lookup[tuple(np.round(point,6))]
+                point=q[index];normal=normals[cycle[index]].copy()
+                if normal[1]<0:normal=-normal
+                face.append(np.r_[point,normal])
+            faces.append(np.asarray(face))
+        added.extend(orient(faces,np.array([.25,1,0])));closed.append({'vertices':len(cycle),'area_square_metres':float(area)})
+    if added:panel._write(obj,panel._symmetric(np.concatenate([values,np.asarray(added)])))
+    return {'closed_loops':closed,'added_right_hand_triangles':len(added),'topology_weld_tolerance_metres':.0001}
+
+
+def fair_upper_deck(obj):
+    """Fair the retained deck around its closed corner cracks in height."""
+    from mathutils.bvhtree import BVHTree
+    p,f,_=panel._read(obj);skin=BVHTree.FromPolygons(p.tolist(),f.tolist(),all_triangles=True)
+    left,front,back=.700,1.450,2.150
+    def width(z):return rear_edge(.980,np.maximum(z,1.750))
+    def height(x,z):
+        hit,*_=skin.ray_cast((float(x),3,float(z)),(0,-1,0),4)
+        return max(.980,float(hit.y)) if hit is not None else 1.015
+    zz=np.linspace(front,back,65);uu=np.linspace(0,1,33)
+    side=np.polynomial.polynomial.polyfit((zz-front)/(back-front),[height(left,z) for z in zz],3)
+    first=np.polynomial.polynomial.polyfit(uu,[height(left+(float(width(front))-left)*u,front) for u in uu],3)
+    last=np.polynomial.polynomial.polyfit(uu,[height(left+(float(width(back))-left)*u,back) for u in uu],3)
+    val=np.polynomial.polynomial.polyval
+    c0,c1=height(left,front),height(left,back)
+    def boundary(poly,t,a,b):return val(t,poly)+(1-t)*(a-val(0,poly))+t*(b-val(1,poly))
+    def transform(points):
+        x,y,z=points.T;u=(x-left)/np.maximum(width(z)-left,.05);v=(z-front)/(back-front)
+        h=(1-u)*boundary(side,v,c0,c1)+u*.980+(1-v)*boundary(first,u,c0,.980)+v*boundary(last,u,c1,.980)
+        h-=((1-u)*(1-v)*c0+(1-u)*v*c1+u*.980)
+        h=np.clip(h,.980,1.085)
+        w=panel.ramp(0,.10,u)*(1-panel.ramp(.90,1,u))*panel.ramp(0,.10,v)*(1-panel.ramp(.90,1,v))
+        w*=panel.ramp(.975,.990,y)*(1-panel.ramp(1.10,1.15,y))
+        return y+(h-y)*w,w
+    values=records(obj).reshape(-1,6);original=values[:,:3].copy();new_y,weights=transform(original)
+    selected=np.flatnonzero(weights>1e-10);points=original[selected];e=.00003
+    gradients=[]
+    for axis in range(3):
+        plus=points.copy();minus=points.copy();plus[:,axis]+=e;minus[:,axis]-=e
+        gradients.append((transform(plus)[0]-transform(minus)[0])/(2*e))
+    n=values[selected,3:];den=np.maximum(abs(n[:,1]),.15)
+    dx=gradients[0]+gradients[1]*(-n[:,0]/den);dz=gradients[2]+gradients[1]*(-n[:,2]/den)
+    values[selected,3:]=normalise(np.c_[-dx,np.ones(len(selected)),-dz]);values[:,1]=new_y
+    triangles=values.reshape(-1,3,6)
+    cross=np.cross(triangles[:,1,:3]-triangles[:,0,:3],triangles[:,2,:3]-triangles[:,0,:3])
+    involved=weights.reshape(-1,3).max(1)>0
+    reverse=involved&(np.sum(cross*triangles[:,:,3:].mean(1),axis=1)<0)
+    triangles[reverse]=triangles[reverse,::-1,:]
+    panel._write(obj,panel._symmetric(triangles))
+    displacement=abs(new_y-original[:,1])
+    assert float(displacement.max())<.035,'Upper-deck fairing must remain local'
+    return {'vertices':len(selected),'maximum_displacement_mm':float(displacement.max())*1000,'common_height_tangent':True}
+
+
+def seat_stock_spoiler(paint,aero):
+    """Seat the retained stock spoiler's lower envelope on the repaired deck."""
+    from mathutils.bvhtree import BVHTree
+    p,f,_=panel._read(paint);deck=BVHTree.FromPolygons(p.tolist(),f.tolist(),all_triangles=True)
+    ap,af,_=panel._read(aero);wing=BVHTree.FromPolygons(ap.tolist(),af.tolist(),all_triangles=True)
+    width=float(abs(ap[:,0]).max());xs=np.linspace(0,width*.995,49);gaps=[];valid=[]
+    for x in xs:
+        local=[]
+        for z in np.linspace(float(ap[:,2].min())+.0001,float(ap[:,2].max())-.0001,33):
+            low,*_=wing.ray_cast((float(x),0,float(z)),(0,1,0),2)
+            hit,*_=deck.ray_cast((float(x),2,float(z)),(0,-1,0),2)
+            if low is not None and hit is not None and hit.y>.97:local.append(low.y-hit.y)
+        if local:valid.append(x);gaps.append(min(local))
+    assert len(valid)>len(xs)*.8,'The stock spoiler must have a supported lower envelope'
+    sections=np.asarray(valid);offset=.001-np.asarray(gaps)
+    def shift(x):return curve(np.clip(abs(x),sections[0],sections[-1]),sections,offset)+.0003
+    values=records(aero).reshape(-1,6);x=values[:,0].copy();delta=shift(x);e=.00003
+    derivative=(shift(x+e)-shift(x-e))/(2*e)
+    values[:,1]+=delta;values[:,3]-=derivative*values[:,4];values[:,3:]=normalise(values[:,3:])
+    assert float(abs(delta).max())<.035,'Spoiler seating must remain local'
+    panel._write(aero,panel._symmetric(values.reshape(-1,3,6)))
+    final_gaps=np.asarray(gaps)+shift(np.asarray(valid))
+    assert float(final_gaps.min())>-.001 and float(final_gaps.max())<.008,'Spoiler contact must remain supported'
+    return {'maximum_seating_mm':float(abs(delta).max())*1000,'supported_sections':len(valid),'minimum_original_gap_mm':float(min(gaps))*1000,'final_minimum_gap_mm':float(final_gaps.min())*1000,'final_maximum_gap_mm':float(final_gaps.max())*1000}
+
+
+def compact_paint(obj,simple):
+    """Dissolve redundant coplanar rows, keeping the authored curved features."""
+    import bpy,bmesh
+    # Dissolution keeps source positions. Restore their own normal splits by
+    # position and tangent domain; nearest-face transfer can select a buried
+    # return at a coincident panel boundary and create a false dent in paint.
+    source_normals={}
+    for loop in obj.data.loops:
+        key=tuple(round(float(v),7) for v in obj.data.vertices[loop.vertex_index].co)
+        normal=np.asarray(obj.data.corner_normals[loop.index].vector[:])
+        source_normals.setdefault(key,[]).append(normal)
+    before=len(obj.data.polygons)
+    bm=bmesh.new();bm.from_mesh(obj.data)
+    bmesh.ops.remove_doubles(bm,verts=list(bm.verts),dist=.0000001)
+    bmesh.ops.dissolve_degenerate(bm,edges=list(bm.edges),dist=.0000001)
+    for edge in bm.edges:
+        for vertex in edge.verts:
+            x,height,z=vertex.co.x,vertex.co.z,-vertex.co.y
+            if (height>1.10 or (abs(x)>.65 and -.99<z<-.48 and height>.87)
+                    or (z>1.70 and height>.950) or (z>1.90 and height>.870)):
+                edge.seam=True
+    angle=9.0 if simple else 2.5
+    bmesh.ops.dissolve_limit(bm,angle_limit=math.radians(angle),verts=list(bm.verts),edges=list(bm.edges),
+                             use_dissolve_boundaries=False,delimit={'SEAM'})
+    bmesh.ops.triangulate(bm,faces=list(bm.faces),quad_method='BEAUTY',ngon_method='BEAUTY')
+    bm.to_mesh(obj.data);bm.free()
+    obj.data.update();normals=[None]*len(obj.data.loops)
+    for polygon in obj.data.polygons:
+        polygon.use_smooth=True;direction=np.asarray(polygon.normal[:])
+        for index in polygon.loop_indices:
+            vertex=obj.data.vertices[obj.data.loops[index].vertex_index]
+            key=tuple(round(float(v),7) for v in vertex.co)
+            assert key in source_normals,'Dissolution must retain measured source positions'
+            candidates=source_normals[key]
+            normals[index]=max(candidates,key=lambda n:float(n@direction))
+    obj.data.normals_split_custom_set(normals)
+    panel.mirror_object(obj)
+    return {'before_triangles':before,'after_triangles':len(obj.data.polygons),'maximum_dissolve_angle_degrees':angle,'vertex_collapse':False}
+
