+def finish(exports,hood,lattice,simple):
+    paint=next(o for o in exports if o.name=='body__paint')
+    stats={}
+    stats['nose']=nose(paint,hood,lattice,simple)
+    stats['upper_wing_fairing']=fair_upper_wings(paint,hood,lattice,simple)
+    # The return's curved XY boundary has valid triangles on the join plane.
+    # Construct it last so the side-volume cut cannot discard those triangles.
+    stats['rear']=rear_fascia(paint,lattice,simple)
+    rear_layers(exports)
+    stats['upper_deck_closure']=close_upper_deck(paint)
+    stats['upper_deck_fairing']=fair_upper_deck(paint)
+    stats['stock_spoiler_seating']=seat_stock_spoiler(paint,next(o for o in exports if o.name=='aero__accent'))
+    values=records(paint)
+    cross=np.cross(values[:,1,:3]-values[:,0,:3],values[:,2,:3]-values[:,0,:3])
+    centre=values[:,:,:3].mean(1)
+    affected=(centre[:,2]<-2.095)|((centre[:,2]>1.70)&(centre[:,0]>.60)&(centre[:,1]>.85))
+    flip=(np.sum(cross*values[:,:,3:].mean(1),axis=1)<0)&affected
+    values[flip]=values[flip,::-1,:]
+    panel._write(paint,values)
+    stats['outward_faces_corrected']=int(flip.sum())
+    from mathutils.bvhtree import BVHTree
+    pp,ff,_=panel._read(paint);skin=BVHTree.FromPolygons(pp.tolist(),ff.tolist(),all_triangles=True)
+    marker=next(o for o in exports if o.name=='body__amber')
+    values=records(marker).reshape(-1,6)
+    for v in values:
+        if abs(v[0])<.70:continue
+        sign=math.copysign(1,v[0])
+        hit,normal,*_=skin.ray_cast((sign*2,float(v[1]),float(v[2])),(-sign,0,0),4)
+        if hit is not None:v[0]=hit.x+sign*.003;v[3:]=np.asarray(normal)
+    panel._write(marker,values.reshape(-1,3,6))
+    # A complete recessed backing prevents the newly round corners from
+    # exposing the garage behind the narrower old optical carrier.
+    from challenger_detail_geometry import disk
+    dark=next(o for o in exports if o.name=='body__dark')
+    from challenger_detail_geometry import rounded
+    for opening in [aperture(),resample(rounded(0,.408,1.220,.170,.050,14),.022)]:
+        p,f=disk(opening,lambda x,y:float(front_z(x,y)+.140),spacing=.045)
+        p=np.asarray(p);f=np.asarray(f);n=np.tile([0,0,-1],(len(p),1))
+        panel._write(dark,panel._symmetric(np.concatenate([records(dark),np.c_[p[f].reshape(-1,3),n[f].reshape(-1,3)].reshape(-1,3,6)])))
+    return stats
