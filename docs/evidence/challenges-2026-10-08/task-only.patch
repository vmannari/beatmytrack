+def test_concurrent_final_duel_slot_and_duplicate_membership(challenge_domain):
+    d = challenge_domain
+    if not d.postgres:
+        pytest.skip("Row-lock proof uses the isolated PostgreSQL fixture")
+    version = setup(d)
+    normal_run(d, version)
+    challenge = create(d, version)
