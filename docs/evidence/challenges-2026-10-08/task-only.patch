+            headers=headers(d, "Bob", key)), ("concurrent-join-a", "concurrent-join-b")))
+    assert all(response.status_code == 200 for response in results)
+    with d.factory() as session:
+        assert session.get(Challenge, group["id"]).member_count == 2
