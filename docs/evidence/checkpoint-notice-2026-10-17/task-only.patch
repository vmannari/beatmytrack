+	for point: Vector2 in path:
+		if result.size() >= 3:
+			var travelled: float = 0.0
+			for index: int in range(result.size()-3,-1,-1):
+				travelled += result[index].distance_to(result[index+1])
+				if travelled > 20.0: break
