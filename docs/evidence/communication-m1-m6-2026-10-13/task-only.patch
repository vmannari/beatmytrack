+		_forget_saved_session()
+		return _failure("SIGN_IN_REQUIRED")
+	if str(config.get_value("session", "url", "")) != _base_url:
+		clear_session()
+		return _failure("SIGN_IN_REQUIRED")
+	var token: String = str(config.get_value("session", "refresh_token", ""))
