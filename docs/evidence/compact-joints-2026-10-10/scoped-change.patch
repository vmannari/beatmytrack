+
+static func _attach_sheet(car: CarVisual,front: bool,glass: bool,resource: ArrayMesh,trim: Material) -> void:
+	var mesh := MeshInstance3D.new()
+	mesh.name=("Front" if front else "Rear")+("GlassSheet" if glass else "GlazingSeal")
