{
  "$defs": {
    "Query": {
      "additionalProperties": false,
      "properties": {
        "search": {
          "default": "",
          "maxLength": 80,
          "title": "Search",
          "type": "string"
        },
        "search_kind": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Search Kind",
          "type": "integer"
        },
        "theme": {
          "default": "all",
          "maxLength": 40,
          "title": "Theme",
          "type": "string"
        },
        "minimum_rating": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Minimum Rating",
          "type": "number"
        },
        "age_days": {
          "default": 0,
          "maximum": 36500,
          "minimum": 0,
          "title": "Age Days",
          "type": "integer"
        },
        "race_count": {
          "default": "any",
          "pattern": "^(any|low|medium|high)$",
          "title": "Race Count",
          "type": "string"
        },
        "race_history": {
          "default": "any",
          "pattern": "^(any|raced|unraced)$",
          "title": "Race History",
          "type": "string"
        },
        "raced_ids": {
          "items": {
            "maxLength": 80,
            "type": "string"
          },
          "maxItems": 50000,
          "title": "Raced Ids",
          "type": "array"
        },
        "ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 80,
                "type": "string"
              },
              "maxItems": 50000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ids"
        },
        "section": {
          "default": "all",
          "pattern": "^(all|favorites|saved)$",
          "title": "Section",
          "type": "string"
        },
        "feed": {
          "default": "recommended",
          "pattern": "^(recommended|daily|new|popular|rated|trending)$",
          "title": "Feed",
          "type": "string"
        },
        "sort": {
          "default": "recommended",
          "pattern": "^(recommended|name|creator|score|plays|new)$",
          "title": "Sort",
          "type": "string"
        },
        "fresh": {
          "default": false,
          "title": "Fresh",
          "type": "boolean"
        }
      },
      "title": "Query",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query": {
      "anyOf": [
        {
          "$ref": "#/$defs/Query"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cursor": {
      "default": "",
      "maxLength": 400,
      "title": "Cursor",
      "type": "string"
    },
    "exclude": {
      "default": "",
      "maxLength": 80,
      "title": "Exclude",
      "type": "string"
    },
    "locate_version": {
      "default": "",
      "maxLength": 36,
      "title": "Locate Version",
      "type": "string"
    }
  },
  "title": "Beat my track discovery request v3",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "required": [
        "query"
      ],
      "not": {
        "required": [
          "cursor"
        ]
      },
      "properties": {
        "query": {
          "$ref": "#/$defs/Query"
        }
      }
    },
    {
      "required": [
        "cursor"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "query"
            ]
          },
          {
            "required": [
              "locate_version"
            ]
          }
        ]
      },
      "properties": {
        "cursor": {
          "minLength": 1
        }
      }
    }
  ]
}
