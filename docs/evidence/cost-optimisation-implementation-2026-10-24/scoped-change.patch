+extends RefCounted
+## Install-time copies are usable only for the server's exact current content hash.
+const ROOT: String = "res://resources/cloud_tracks"
+static var _index: Dictionary = {}
+static var _loaded: bool = false
+static var _mutex := Mutex.new()
+
+static func path(content_hash: String) -> String:
+	if content_hash.length() != 64 or not content_hash.is_valid_hex_number(): return ""
+	_mutex.lock()
+	if not _loaded:
+		_loaded = true
+		var file := FileAccess.open(ROOT.path_join("index.json"),FileAccess.READ)
+		if file != null and file.get_length() <= 65536:
+			var value: Variant = JSON.parse_string(file.get_as_text())
+			if value is Dictionary and value.get("schema") == "bmt-bundled-tracks-v1" and value.get("documents") is Dictionary: _index = value.documents
+	var filename: String = content_hash+".json"
+	var result: String = ROOT.path_join(filename) if _index.get(content_hash) == filename else ""
+	_mutex.unlock()
+	return result
diff --git a/game/backend/ghost_wire.gd b/game/backend/ghost_wire.gd
--- /dev/null
+++ b/game/backend/ghost_wire.gd
@@ -0,0 +1,22 @@
+extends RefCounted
+## Lossless Float64 presentation decoder. Never used by score verification.
+const CACHE = preload("res://backend/recording_cache.gd")
+const STRIDE: int = 56
+
+static func decode(value: Variant) -> Dictionary:
+	if not value is Dictionary: return {}
+	if value.get("schema") != "bmt-packed-ghost-v1": return CACHE.valid(value)
+	if not (value.get("count") is int or value.get("count") is float) or float(value.count) != floorf(float(value.count)): return {}
+	var count: int = int(value.count)
+	if count < 2 or count > 36007 or not value.get("data") is String or value.data.length() > 3*1024*1024: return {}
+	var text: String = value.data
+	if text.length()%4 != 0 or RegEx.create_from_string("^[A-Za-z0-9+/]*={0,2}$").search(text) == null: return {}
+	var compressed: PackedByteArray = Marshalls.base64_to_raw(text)
+	var body: PackedByteArray = compressed.decompress_dynamic(36007*STRIDE,FileAccess.COMPRESSION_GZIP)
+	if body.size() != count*STRIDE: return {}
+	var poses: Array = []
+	for index: int in range(count):
+		var row: Array = []
+		for component: int in range(7): row.append(body.decode_double(index*STRIDE+component*8))
+		poses.append(row)
+	return CACHE.valid({"ticks":value.get("ticks"),"poses":poses})
