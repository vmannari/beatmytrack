diff --git a/backend/bmt_backend/cost_archives.py b/backend/bmt_backend/cost_archives.py
--- /dev/null
+++ b/backend/bmt_backend/cost_archives.py
@@ -0,0 +1,235 @@
+"""Exact encrypted cold receipts; hot-row removal follows durable publication."""
+import base64
+import gzip
+import hashlib
+import os
+import re
+import uuid
+import zlib
+from collections import defaultdict
+
+from cryptography.exceptions import InvalidTag
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+from fastapi import HTTPException
+from sqlalchemy import select, tuple_, update
+
+from .object_models import ArchiveChunk, ArchiveKey, CoinArchiveMetric
+from .packed_storage import insert
+from .storage import canonical_json
+from .track_models import IdempotencyRecord, OperationState, Run, digest, now
+
+MAX_ARCHIVE_BYTES = 6 * 1024 * 1024
+
+
+def retry_key(player_id, scope, key):
+    match = re.fullmatch(r"v2\.([0-9]{10})\.[0-9a-f]{48}", key)
+    return match[1] + hashlib.sha256(canonical_json([player_id, scope, key])).hexdigest() if match else ""
+
+
+def actor_key(session, player_id):
+    from .identity_models import Player
+    key = session.get(ArchiveKey, player_id)
+    if key is not None:
+        return key.secret
+    # First-key creation shares the account deletion writer's lock. A deleted
+    # account cannot acquire a replacement key after cryptographic erasure.
+    player = session.scalar(select(Player).where(Player.id == player_id).with_for_update(skip_locked=True))
+    if player is None or player.deleted_at is not None or player.disabled:
+        return None
+    key = session.get(ArchiveKey, player_id)
+    if key is None:
+        secret = os.urandom(32)
+        key = ArchiveKey(player_id=player_id, secret=secret, key_id=hashlib.sha256(secret).hexdigest())
+        session.add(key)
+        session.flush()
+    return key.secret
+
+
+def encrypt(secret, identity, value):
+    nonce = os.urandom(12)
+    encoded = AESGCM(secret).encrypt(nonce, gzip.compress(canonical_json(value), compresslevel=3, mtime=0), identity.encode("ascii"))
+    return {"key_id": hashlib.sha256(secret).hexdigest(), "nonce": base64.b64encode(nonce).decode("ascii"),
+            "data": base64.b64encode(encoded).decode("ascii")}
+
+
+def decrypt(secret, identity, value):
+    import json
+    try:
+        if value.get("key_id") != hashlib.sha256(secret).hexdigest():
+            raise ValueError("Archive key identity differs")
+        plain = AESGCM(secret).decrypt(base64.b64decode(value["nonce"], validate=True),
+            base64.b64decode(value["data"], validate=True), identity.encode("ascii"))
+        decoder = zlib.decompressobj(16+zlib.MAX_WBITS)
+        decoded = decoder.decompress(plain, 8*1024*1024+1)
+        if len(decoded) > 8*1024*1024 or not decoder.eof or decoder.unused_data:
+            raise ValueError("Archived record exceeds bounds")
+        result = json.loads(decoded)
+        if not isinstance(result, dict):
+            raise TypeError("Invalid archived record")
+        return result
+    except (ValueError, KeyError, TypeError, InvalidTag, zlib.error) as error:
+        raise OSError("Private archive failed integrity") from error
+
+
+def cold_response(session, player_id, scope, key, body):
+    identity = retry_key(player_id, scope, key)
+    if not identity or int(identity[:10]) > now()-session.info.get("cost_archive_days", 7)*86400:
+        return None
+    chunks = session.scalars(select(ArchiveChunk).where(ArchiveChunk.kind == "retry",
+        ArchiveChunk.lower <= identity, ArchiveChunk.upper >= identity)
+        .order_by(ArchiveChunk.created_at.desc(), ArchiveChunk.digest).limit(33)).all()
+    if len(chunks) > 32:
+        raise HTTPException(503, "RETRY_ARCHIVE_LOOKUP_BUSY")
+    if not chunks:
+        return None
+    blobs = session.info.get("cost_archive_blobs")
+    secret = session.get(ArchiveKey, player_id)
+    if blobs is None or secret is None:
+        raise HTTPException(503, "RETRY_ARCHIVE_UNAVAILABLE")
+    for chunk in chunks:
+        stored = blobs.get_json_in_session(session, chunk.digest) if hasattr(blobs, "get_json_in_session") else blobs.get_json(chunk.digest)
+        record = stored.get("records", {}).get(identity)
+        if record is None:
+            continue
+        record = decrypt(secret.secret, identity, record)
+        if record.get("request_hash") != digest(body):
+            raise HTTPException(409, "Idempotency-Key already used for different content")
+        response = record.get("response")
+        if not isinstance(response, dict):
+            raise OSError("Invalid archived retry response")
+        if response.get("retired"):
+            raise HTTPException(410, "Attempt history expired; this request will not be repeated")
+        from .resume_models import ResumeRace, ResumeReceipt
+        from .track_models import RunTicket
+        for name, model in (("run_id", Run), ("ticket_id", RunTicket), ("race_id", ResumeRace), ("receipt_id", ResumeReceipt)):
+            if response.get(name) and session.get(model, response[name]) is None:
+                raise HTTPException(410, "Attempt history expired; this request will not be repeated")
+        return response
+    return None
+
+
+def _lease(session, kind, stamp):
+    identity = "cost-archive:" + kind
+    session.execute(insert(session)(OperationState).values(id=identity, updated_at=stamp, details={})
+        .on_conflict_do_nothing(index_elements=[OperationState.id]))
+    state = session.scalar(select(OperationState).where(OperationState.id == identity).with_for_update(skip_locked=True))
+    if state is None or state.details.get("until", 0) > stamp:
+        return None
+    token = str(uuid.uuid4())
+    state.details = {**state.details, "token": token, "until": stamp+60}
+    return state, token
+
+
+def archive_once(factory, blobs, *, kind="retry", days=7, limit=500, at=None):
+    from .economy_models import CoinReward
+    from .studio_platform_models import StudioCoinEntry
+    if kind not in ("retry", "reward") or not 7 <= days <= 90 or not 1 <= limit <= 1000:
+        raise ValueError("Invalid archive work budget")
+    stamp = now() if at is None else at
+    cutoff = stamp-days*86400
+    records, snapshots, size = {}, [], 128
+    with factory() as session:
+        owned = _lease(session, kind, stamp)
+        if owned is None:
+            return False
+        state, token = owned
+        cursor = state.details.get("cursor", "")
+        if kind == "retry":
+            statement = select(IdempotencyRecord).where(IdempotencyRecord.archive_key > cursor,
+                IdempotencyRecord.archive_key != "", IdempotencyRecord.archive_key < str(cutoff), IdempotencyRecord.created_at < cutoff)
+            statement = statement.order_by(IdempotencyRecord.archive_key).limit(limit)
+        else:
+            statement = select(CoinReward).where(CoinReward.created_at < cutoff).order_by(CoinReward.created_at, CoinReward.run_id).limit(limit)
+        finance_by_owner = {}
+        if kind == "reward":
+            reward_rows = session.scalars(statement).all()
+            references = ["run/"+row.run_id for row in reward_rows]
+            finance_rows = session.scalars(select(StudioCoinEntry).where(StudioCoinEntry.kind == "earned",
+                StudioCoinEntry.reference.in_(references))).all() if references else []
+            finance_by_owner = {(row.player_id, row.reference): {"id": row.id, "reference": row.reference,
+                "kind": row.kind, "amount": row.amount, "created_at": row.created_at, "detail": row.detail} for row in finance_rows}
+            source_rows = reward_rows
+        else:
+            source_rows = session.scalars(statement.execution_options(yield_per=1))
+        last = cursor
+        secrets = {}
+        for row in source_rows:
+            identity = row.archive_key if kind == "retry" else row.run_id
+            last = identity
+            if row.player_id not in secrets:
+                secrets[row.player_id] = actor_key(session, row.player_id)
+            secret = secrets[row.player_id]
+            if secret is None:
+                continue
+            plain = {"player_id": row.player_id, "scope": row.scope, "key": row.key, "created_at": row.created_at,
+                "request_hash": row.request_hash, "response": row.response} if kind == "retry" else {
+                "player_id": row.player_id, "amount": row.amount, "rows": row.rows, "created_at": row.created_at,
+                "finance": finance_by_owner.get((row.player_id, "run/"+row.run_id))}
+            encoded = encrypt(secret, identity, plain)
+            length = len(canonical_json(encoded)) + len(identity) + 8
+            if size + length > MAX_ARCHIVE_BYTES:
+                break
+            size += length
+            records[identity] = encoded
+            snapshots.append((row.player_id, row.scope, row.key, row.request_hash, digest(row.response))) if kind == "retry" else snapshots.append((row.run_id, row.amount, digest(row.rows)))
+        if not records:
+            state.details = {"until": 0, "cursor": "" if last == cursor else last}
+            session.commit()
+            return False
+        session.commit()  # Release account/lease locks before durable object publication.
+    stored_hash = blobs.put_json({"schema": "bmt-private-cost-archive-v1", "kind": kind, "records": records})
+    with factory() as session:
+        state = session.scalar(select(OperationState).where(OperationState.id == "cost-archive:"+kind).with_for_update())
+        if state.details.get("token") != token or state.details.get("until", 0) <= now():
+            return False
+        if kind == "retry":
+            keys = [(player, scope, key) for player, scope, key, _, _ in snapshots]
+            rows = session.scalars(select(IdempotencyRecord).where(tuple_(IdempotencyRecord.player_id,
+                IdempotencyRecord.scope, IdempotencyRecord.key).in_(keys)).with_for_update(skip_locked=True)).all()
+            actual = {(r.player_id, r.scope, r.key): r for r in rows}
+            unchanged = len(rows) == len(snapshots) and all(actual[(p, s, k)].request_hash == h
+                and digest(actual[(p, s, k)].response) == response_hash for p, s, k, h, response_hash in snapshots)
+        else:
+            ids = [key for key, _, _ in snapshots]
+            rows = session.scalars(select(CoinReward).where(CoinReward.run_id.in_(ids)).with_for_update(skip_locked=True)).all()
+            actual = {r.run_id: r for r in rows}
+            unchanged = len(rows) == len(snapshots) and all(actual[key].amount == amount and digest(actual[key].rows) == rows_hash
+                for key, amount, rows_hash in snapshots)
+        if not unchanged:
+            state.details = {"until": 0, "cursor": cursor}
+            session.commit()
+            return False  # Erasure/retention won; never publish stale retry answers.
+        session.add(ArchiveChunk(digest=stored_hash, kind=kind, lower=min(records), upper=max(records), records=len(records), created_at=stamp))
+        if kind == "reward":
+            session.execute(update(Run).where(Run.id.in_(ids)).values(reward_archive_hash=stored_hash))
+            finance = session.scalars(select(StudioCoinEntry).where(StudioCoinEntry.reference.in_(["run/"+key for key in ids]),
+                StudioCoinEntry.kind == "earned").with_for_update()).all()
+            totals = defaultdict(lambda: [0, 0])
+            for entry in finance:
+                totals[entry.created_at, entry.kind][0] += entry.amount
+                totals[entry.created_at, entry.kind][1] += 1
+                session.delete(entry)
+            for (at_second, entry_kind), (amount, count) in totals.items():
+                statement = insert(session)(CoinArchiveMetric).values(at=at_second, kind=entry_kind, amount=amount, count=count)
+                session.execute(statement.on_conflict_do_update(index_elements=[CoinArchiveMetric.at, CoinArchiveMetric.kind],
+                    set_={"amount": CoinArchiveMetric.amount+amount, "count": CoinArchiveMetric.count+count}))
+        for row in rows:
+            session.delete(row)
+        state.details = {"until": 0, "cursor": last if kind == "retry" else ""}
+        state.updated_at = stamp
+        session.commit()
+    return True
+
+
+def backfill_retry_keys(factory, limit=500):
+    """Bounded upgrade for pre-cutover v2 rows; legacy keys remain permanent."""
+    with factory() as session:
+        rows = session.scalars(select(IdempotencyRecord).where(IdempotencyRecord.archive_key == "",
+            IdempotencyRecord.key.startswith("v2.")).order_by(IdempotencyRecord.created_at)
+            .limit(limit).with_for_update(skip_locked=True)).all()
+        for row in rows:
+            value = retry_key(row.player_id, row.scope, row.key)
+            # Malformed historical keys cannot be admitted by the current API.
+            row.archive_key = value or "invalid"
+        session.commit()
+        return bool(rows)
diff --git a/backend/bmt_backend/cost_maintenance.py b/backend/bmt_backend/cost_maintenance.py
--- /dev/null
+++ b/backend/bmt_backend/cost_maintenance.py
@@ -0,0 +1,74 @@
+"""Fair, bounded background cost work with foreground backlog and backup guards."""
+import time
+
+from sqlalchemy import delete, select
+
+from .cost_archives import archive_once, backfill_retry_keys
+from .maintenance import retain
+from .object_garbage import collect_once as garbage_once
+from .object_models import ArchiveChunk, ObjectGarbageCandidate
+from .packed_storage import insert
+from .track_models import OperationState, Run, now
+
+
+class CostMaintenance:
+    def __init__(self, factory, blobs, settings):
+        self.factory, self.blobs, self.settings = factory, blobs, settings
+        self.turn = 0
+        self.check_at, self.foreground_busy = 0.0, False
+        self.retention_at, self.legacy_at = 0.0, 0.0
+        self.legacy_cursor = {"packed": False, "cursor": None}
+
+    def step(self):
+        tick = time.monotonic()
+        if tick >= self.check_at:
+            with self.factory() as session:
+                oldest = session.scalar(select(Run.created_at).where(Run.status.in_(("queued", "verifying")))
+                    .order_by(Run.created_at).limit(1))
+                backup = session.get(OperationState, "object-maintenance")
+                self.foreground_busy = ((oldest is not None and now()-oldest > self.settings.world_ranking_max_queue_age_seconds)
+                    or (backup is not None and backup.updated_at > now()))
+            self.check_at = tick+2
+        if self.foreground_busy:
+            return False
+        role = self.turn % 8
+        self.turn += 1
+        if role in (0, 1):
+            return archive_once(self.factory, self.blobs, kind="reward" if role == 0 else "retry",
+                                days=self.settings.cost_archive_days, limit=self.settings.cost_archive_batch)
+        if role == 2:
+            return garbage_once(self.factory, self.blobs)
+        if role == 3:
+            if tick < self.retention_at:
+                return False
+            result = retain(self.factory, self.blobs, self.settings.retention_days, apply=True, online=True, scan_objects=False)
+            more = any(result[name] >= 1000 for name in ("runs", "tickets", "resume_races"))
+            self.retention_at = tick + (0 if more else 60)
+            return more
+        if role == 4:
+            return self.blobs.compact_once()
+        if role == 5:
+            return self.blobs.collect_once() or self.blobs.io.cleanup_temporary(now()-86400)
+        if role == 6:
+            return backfill_retry_keys(self.factory, self.settings.cost_archive_batch) or expire_retry_archives(self.factory)
+        if tick < self.legacy_at:
+            return False
+        result = retain(self.factory, self.blobs, self.settings.retention_days, apply=True, online=True,
+                        object_cursor=self.legacy_cursor, scan_limit=100)
+        self.legacy_cursor = result["next_object_cursor"] or {"packed": False, "cursor": None}
+        self.legacy_at = tick + (5 if result["objects_deferred"] else 86400)
+        return result["objects_deferred"]
+
+
+def expire_retry_archives(factory, *, limit=100):
+    # The server rejects these keys before archive lookup. Reward archives remain.
+    cutoff = str(now()-100*86400)
+    with factory() as session:
+        rows = session.scalars(select(ArchiveChunk.digest).where(ArchiveChunk.kind == "retry", ArchiveChunk.upper < cutoff)
+            .order_by(ArchiveChunk.upper).limit(limit)).all()
+        if rows:
+            session.execute(insert(session)(ObjectGarbageCandidate).values([{"digest": key, "due_at": now()} for key in rows])
+                .on_conflict_do_nothing(index_elements=[ObjectGarbageCandidate.digest]))
+            session.execute(delete(ArchiveChunk).where(ArchiveChunk.digest.in_(rows)))
+            session.commit()
+        return bool(rows)
diff --git a/backend/bmt_backend/ghost_http.py b/backend/bmt_backend/ghost_http.py
--- /dev/null
+++ b/backend/bmt_backend/ghost_http.py
@@ -0,0 +1,33 @@
+"""Current authorization stays in routes; immutable bytes need not be redownloaded."""
+import hashlib
+import re
+
+from fastapi import HTTPException
+from fastapi.responses import JSONResponse, Response
+
+from .storage import canonical_json
+
+
+def recording_response(request, run_id, content_hash, player_id, *, metadata=False, expected_run_id="", encoding="json"):
+    if encoding not in ("json", "packed"):
+        raise HTTPException(422, "UNSUPPORTED_GHOST_ENCODING")
+    if not re.fullmatch(r"[0-9a-f]{64}", content_hash):
+        raise OSError("Invalid recording digest")
+    if expected_run_id and expected_run_id != run_id:
+        raise HTTPException(409, "GHOST_TARGET_CHANGED")
+    value = {"run_id": run_id, "content_hash": content_hash, "player_id": player_id}
+    tag = '"' + hashlib.sha256(canonical_json(value)).hexdigest() + ("-metadata" if metadata else "-"+encoding) + '"'
+    headers = {"ETag": tag, "Cache-Control": "private, no-cache, must-revalidate", "Vary": "Authorization, Accept-Encoding"}
+    if request.headers.get("if-none-match") == tag:
+        return Response(status_code=304, headers=headers)
+    if metadata:
+        return JSONResponse(value, headers=headers)
+    def prepare():
+        recording = request.app.state.blobs.get_json(content_hash)
+        if encoding == "packed":
+            from .ghost_wire import compact
+            recording = compact(recording)
+        return canonical_json({**value, "recording": recording})
+    cache = getattr(request.app.state, "immutable_payloads", None)
+    body = cache.get(("ghost", run_id, content_hash, encoding), prepare) if cache else prepare()
+    return Response(body, media_type="application/json", headers=headers)
diff --git a/backend/bmt_backend/ghost_wire.py b/backend/bmt_backend/ghost_wire.py
--- /dev/null
+++ b/backend/bmt_backend/ghost_wire.py
@@ -0,0 +1,19 @@
+"""Optional exact Float64 presentation encoding; scores/proofs are untouched."""
+import base64
+import gzip
+import struct
+
+from .storage import canonical_json
+from .verifier import validate_ghost
+
+
+def compact(recording):
+    validate_ghost(recording, recording["ticks"])
+    body = b"".join(struct.pack("<7d", *row) for row in recording["poses"])
+    value = {"schema": "bmt-packed-ghost-v1", "ticks": recording["ticks"], "count": len(recording["poses"]),
+             "data": base64.b64encode(gzip.compress(body, compresslevel=3, mtime=0)).decode("ascii")}
+    def wire(data):
+        raw = canonical_json(data)
+        return len(gzip.compress(raw, compresslevel=3, mtime=0)) if len(raw) >= 1024 else len(raw)
+    # Do not increase transfers for tiny or unusually compressible JSON ghosts.
+    return value if wire(value) < .95*wire(recording) else recording
diff --git a/backend/bmt_backend/http_costs.py b/backend/bmt_backend/http_costs.py
--- /dev/null
+++ b/backend/bmt_backend/http_costs.py
@@ -0,0 +1,59 @@
+"""Bounded all-request cost counters; routine success detail is independently sampled."""
+import json
+import logging
+import threading
+import time
+
+log = logging.getLogger("bmt.requests")
+LIMITS = (10, 25, 50, 100, 250, 500, 1000, 5000)
+
+
+class HttpCostCounters:
+    def __init__(self, settings, *, clock=time.monotonic):
+        self.interval = settings.http_metrics_interval_seconds
+        self.sample = settings.http_success_sample_per_mille
+        self.clock, self.lock = clock, threading.Lock()
+        self.started, self.rows = clock(), {}
+
+    def observe(self, value):
+        tick = self.clock()
+        emitted = None
+        key = value["route"], value["method"], value["status"]
+        with self.lock:
+            if tick-self.started >= self.interval:
+                emitted = self._snapshot(tick)
+                self.rows, self.started = {}, tick
+            if key not in self.rows and len(self.rows) >= 512:
+                key = "other", "OTHER", 0
+            row = self.rows.setdefault(key, {"requests": 0, "request_wire_bytes": 0, "response_wire_bytes": 0,
+                                            "duration_ms": 0.0, "max_ms": 0.0, "latency_buckets": [0]*9})
+            row["requests"] += 1
+            for name in ("request_wire_bytes", "response_wire_bytes", "duration_ms"):
+                row[name] += value[name]
+            row["max_ms"] = max(row["max_ms"], value["duration_ms"])
+            bucket = next((i for i, limit in enumerate(LIMITS) if value["duration_ms"] <= limit), len(LIMITS))
+            row["latency_buckets"][bucket] += 1
+        if emitted and emitted["rows"]:
+            # One bounded summary per interval, not an event per successful request.
+            log.info(json.dumps(emitted, separators=(",", ":")))
+        sampled = int(value["request_id"].replace("-", "")[-8:], 16) % 1000 < self.sample
+        if value["status"] >= 400 or value["duration_ms"] >= 1000 or sampled:
+            log.info(json.dumps({**value, "success_sample_per_mille": self.sample}, separators=(",", ":")))
+
+    def _snapshot(self, tick):
+        return {"event": "http_cost_summary", "interval_seconds": round(tick-self.started, 3),
+                "body_bytes_after_compression": True, "latency_limits_ms": list(LIMITS),
+                "rows": [{"route": route, "method": method, "status": status, **row,
+                          "latency_buckets": list(row["latency_buckets"])}
+                         for (route, method, status), row in self.rows.items()]}
+
+    def snapshot(self):
+        with self.lock:
+            return self._snapshot(self.clock())
+
+    def flush(self):
+        with self.lock:
+            value = self._snapshot(self.clock())
+            self.rows, self.started = {}, self.clock()
+        if value["rows"]:
+            log.info(json.dumps(value, separators=(",", ":")))
diff --git a/backend/bmt_backend/immutable_payloads.py b/backend/bmt_backend/immutable_payloads.py
--- /dev/null
+++ b/backend/bmt_backend/immutable_payloads.py
@@ -0,0 +1,50 @@
+"""Bounded process-local immutable representations and shared in-flight preparation."""
+import threading
+from collections import OrderedDict
+from concurrent.futures import Future, TimeoutError
+
+from fastapi import HTTPException
+
+
+class ImmutablePayloadCache:
+    def __init__(self, maximum_bytes=32*1024*1024, maximum_entries=256, parallel=4):
+        self.maximum_bytes, self.maximum_entries, self.parallel = maximum_bytes, maximum_entries, parallel
+        self.lock, self.entries, self.pending = threading.Lock(), OrderedDict(), {}
+        self.bytes = 0
+
+    def get(self, key, produce):
+        with self.lock:
+            if key in self.entries:
+                value = self.entries.pop(key)
+                self.entries[key] = value
+                return value
+            owner = key not in self.pending
+            if owner:
+                if len(self.pending) >= self.parallel:
+                    raise HTTPException(503, "CONTENT_PREPARATION_BUSY", headers={"Retry-After": "1"})
+                self.pending[key] = Future()
+            future = self.pending[key]
+        if not owner:
+            try:
+                return future.result(timeout=1.5)
+            except TimeoutError as error:
+                raise HTTPException(503, "CONTENT_PREPARATION_BUSY", headers={"Retry-After": "1"}) from error
+        try:
+            value = produce()
+            if not isinstance(value, bytes):
+                raise TypeError("Immutable representation must be bytes")
+            with self.lock:
+                if len(value) <= self.maximum_bytes:
+                    self.entries[key] = value
+                    self.bytes += len(value)
+                    while self.bytes > self.maximum_bytes or len(self.entries) > self.maximum_entries:
+                        _, removed = self.entries.popitem(last=False)
+                        self.bytes -= len(removed)
+                future.set_result(value)
+            return value
+        except BaseException as error:
+            future.set_exception(error)
+            raise
+        finally:
+            with self.lock:
+                self.pending.pop(key, None)
diff --git a/backend/bmt_backend/object_garbage.py b/backend/bmt_backend/object_garbage.py
--- /dev/null
+++ b/backend/bmt_backend/object_garbage.py
@@ -0,0 +1,56 @@
+"""Indexed object retirement candidates avoid repeated full-bucket scans."""
+from sqlalchemy import select, union_all
+
+from .maintenance import ArchiveChunk, PublicationIntent, PublicationUpload, RankingArchive, Run, TrackVersion
+from .object_models import ObjectGarbageCandidate, ObjectPin
+from .packed_storage import insert
+from .track_models import OperationState, now
+
+
+def referenced(session, keys):
+    return set(session.scalars(union_all(
+        select(ArchiveChunk.digest).where(ArchiveChunk.digest.in_(keys)),
+        select(RankingArchive.digest).where(RankingArchive.digest.in_(keys)),
+        select(TrackVersion.content_hash).where(TrackVersion.content_hash.in_(keys)),
+        select(Run.replay_hash).where(Run.replay_hash.in_(keys)),
+        select(Run.ghost_hash).where(Run.ghost_hash.in_(keys)),
+        select(PublicationIntent.content_hash).where(PublicationIntent.content_hash.in_(keys), PublicationIntent.evidence_retired.is_(False)),
+        select(PublicationIntent.replay_hash).where(PublicationIntent.replay_hash.in_(keys), PublicationIntent.evidence_retired.is_(False)),
+        select(PublicationUpload.content_hash).where(PublicationUpload.content_hash.in_(keys), PublicationUpload.evidence_retired.is_(False)),
+        select(PublicationUpload.replay_hash).where(PublicationUpload.replay_hash.in_(keys), PublicationUpload.evidence_retired.is_(False)),
+    )))
+
+
+def collect_once(factory, blobs, *, limit=100, at=None):
+    if not 1 <= limit <= 1000:
+        raise ValueError("Invalid object retirement budget")
+    stamp = now() if at is None else at
+    with factory() as session:
+        pause = session.get(OperationState, "object-maintenance")
+        if pause is not None and pause.updated_at > stamp:
+            return False
+        keys = session.scalars(select(ObjectGarbageCandidate.digest).where(ObjectGarbageCandidate.due_at <= stamp)
+            .order_by(ObjectGarbageCandidate.due_at, ObjectGarbageCandidate.digest).limit(limit)).all()
+        # Preserve publication's Pin -> Candidate lock order across replicas.
+        for key in sorted(keys):
+            session.execute(insert(session)(ObjectPin).values(digest=key, expires_at=0)
+                .on_conflict_do_nothing(index_elements=[ObjectPin.digest]))
+            pin = session.scalar(select(ObjectPin).where(ObjectPin.digest == key).with_for_update())
+            candidate = session.scalar(select(ObjectGarbageCandidate).where(ObjectGarbageCandidate.digest == key)
+                .with_for_update(skip_locked=True))
+            if candidate is None:
+                continue
+            if pin.expires_at > stamp:
+                candidate.due_at = pin.expires_at+60
+                continue
+            if referenced(session, [key]):
+                session.delete(candidate)
+                continue
+            removed = blobs.store.delete_in_session(session, key) if hasattr(blobs.store, "delete_in_session") else blobs.delete(key)
+            if removed is False:
+                candidate.due_at = stamp+60
+                continue
+            session.delete(candidate)
+            session.delete(pin)
+        session.commit()
+        return bool(keys)
diff --git a/backend/bmt_backend/pack_io.py b/backend/bmt_backend/pack_io.py
--- /dev/null
+++ b/backend/bmt_backend/pack_io.py
@@ -0,0 +1,172 @@
+"""Private immutable pack IO. Normal reads retrieve one compressed record range."""
+import base64
+import hashlib
+import os
+import re
+import stat
+import tempfile
+from xml.etree import ElementTree
+
+
+class PackIO:
+    def __init__(self, store, maximum):
+        self.store, self.maximum = store, maximum
+
+    def key(self, digest):
+        if not re.fullmatch(r"[0-9a-f]{64}", digest):
+            raise ValueError("Invalid pack digest")
+        return f"packs/{digest[:2]}/{digest}.pack"
+
+    def put(self, digest, body):
+        if len(body) > self.maximum or hashlib.sha256(body).hexdigest() != digest:
+            raise ValueError("Invalid pack bytes")
+        store, key = self.store, self.key(digest)
+        if hasattr(store, "root"):
+            path = store.root / key
+            path.parent.mkdir(parents=True, exist_ok=True)
+            fd, temporary = tempfile.mkstemp(prefix=".pending-pack-", dir=store.root)
+            try:
+                with os.fdopen(fd, "wb") as stream:
+                    from .storage import lock_temporary
+                    if not lock_temporary(stream):
+                        raise OSError("Pack temporary file is busy")
+                    stream.write(body)
+                    stream.flush()
+                    os.fsync(stream.fileno())
+                if path.exists():
+                    if self.get(digest, 0, len(body)) != body:
+                        raise OSError("Existing pack differs")
+                else:
+                    os.replace(temporary, path)
+                    from .storage import sync_directory
+                    sync_directory(path.parent)
+                    sync_directory(path.parent.parent)
+                    sync_directory(store.root)
+            finally:
+                if os.path.exists(temporary):
+                    os.unlink(temporary)
+            return
+        key = store.prefix + key
+        if hasattr(store, "bucket"):
+            status, reply = store._request("POST", upload=True, body=body,
+                query={"uploadType": "media", "name": key, "ifGenerationMatch": "0", "fields": "name,size,md5Hash"},
+                extra_headers={"Content-Type": "application/octet-stream"})
+            if status in (200, 201):
+                metadata = store._metadata(reply)
+                checksum = base64.b64encode(hashlib.md5(body, usedforsecurity=False).digest()).decode("ascii")
+                if metadata.get("name") != key or metadata.get("size") != str(len(body)) or metadata.get("md5Hash") != checksum:
+                    raise OSError("Pack acknowledgement failed integrity")
+                return
+        else:
+            status, _ = store._request("PUT", key, body=body, extra={"if-none-match": "*", "content-type": "application/octet-stream"})
+            if status in (200, 201):
+                return
+        if status == 412 and self.get(digest, 0, len(body)) == body:
+            return
+        raise OSError("Immutable pack upload failed")
+
+    def get(self, digest, offset, length):
+        if type(offset) is not int or type(length) is not int or offset < 0 or length <= 0 or offset + length > self.maximum:
+            raise ValueError("Invalid pack range")
+        store, key = self.store, self.key(digest)
+        if hasattr(store, "root"):
+            with (store.root / key).open("rb") as stream:
+                stream.seek(offset)
+                body = stream.read(length)
+        else:
+            arguments = {"extra_headers": {"Range": f"bytes={offset}-{offset+length-1}"}} if hasattr(store, "bucket") else {
+                "extra": {"range": f"bytes={offset}-{offset+length-1}"}}
+            status, body = store._request("GET", store.prefix + key, limit=length,
+                **({"query": {"alt": "media"}} if hasattr(store, "bucket") else {}), **arguments)
+            if status != 206:
+                raise OSError("Pack range unavailable")
+        if len(body) != length:
+            raise OSError("Truncated pack range")
+        return body
+
+    def delete(self, digest):
+        store, key = self.store, self.key(digest)
+        if hasattr(store, "root"):
+            (store.root / key).unlink(missing_ok=True)
+            return
+        if hasattr(store, "bucket"):
+            status, reply = store._request("GET", store.prefix + key, query={"fields": "generation,name"})
+            if status == 404:
+                return
+            if status != 200:
+                raise OSError("Pack metadata unavailable")
+            metadata = store._metadata(reply)
+            generation = str(metadata.get("generation", ""))
+            if metadata.get("name") != store.prefix + key or not re.fullmatch(r"[1-9][0-9]*", generation):
+                raise OSError("Invalid pack generation")
+            status, _ = store._request("DELETE", store.prefix + key, query={"ifGenerationMatch": generation})
+        else:
+            status, _ = store._request("DELETE", store.prefix + key)
+        if status not in (200, 204, 404):
+            raise OSError("Pack deletion failed")
+
+    def list(self, cursor=None, limit=1000):
+        """Physical pack listing for consistent provider backups, not player reads."""
+        if type(limit) is not int or not 1 <= limit <= 1000 or (cursor is not None and (type(cursor) is not str or not cursor or len(cursor) > 4096)):
+            raise ValueError("Invalid physical pack cursor")
+        store = self.store
+        prefix = store.prefix + "packs/"
+        if hasattr(store, "bucket"):
+            query = {"prefix": prefix, "maxResults": str(limit), "fields": "items(name,size),nextPageToken"}
+            if cursor:
+                query["pageToken"] = cursor
+            status, body = store._request("GET", query=query, limit=1024*1024)
+            if status != 200:
+                raise OSError("Pack listing unavailable")
+            value = store._metadata(body)
+            entries = [(row.get("name"), row.get("size")) for row in value.get("items", [])]
+            following = value.get("nextPageToken")
+        else:
+            query = {"list-type": "2", "max-keys": str(limit), "prefix": prefix}
+            if cursor:
+                query["continuation-token"] = cursor
+            status, body = store._request("GET", query=query, limit=1024*1024)
+            if status != 200:
+                raise OSError("Pack listing unavailable")
+            value = ElementTree.fromstring(body)
+            entries = [(row.findtext("{*}Key"), row.findtext("{*}Size")) for row in value.findall("{*}Contents")]
+            following = value.findtext("{*}NextContinuationToken")
+        if len(entries) > limit or (following and (not isinstance(following, str) or len(following) > 4096 or following == cursor)):
+            raise OSError("Invalid physical pack listing")
+        rows = []
+        for name, size in entries:
+            match = re.fullmatch(re.escape(prefix) + r"([0-9a-f]{2})/([0-9a-f]{64})\.pack", name or "")
+            if not match or not match[2].startswith(match[1]) or not 8 <= int(size) <= self.maximum:
+                raise OSError("Invalid physical pack entry")
+            rows.append({"digest": match[2], "bytes": int(size)})
+        return rows, following
+
+    def cleanup_temporary(self, cutoff, limit=100):
+        if not hasattr(self.store, "root"):
+            return False
+        removed = 0
+        inspected = 0
+        from .storage import lock_temporary
+        # Root holds 256 shard directories, not the complete packed-object history.
+        with os.scandir(self.store.root) as entries:
+            for entry in entries:
+                inspected += 1
+                if inspected > 1000:
+                    break
+                if not entry.name.startswith(".pending-pack-") or not entry.is_file(follow_symlinks=False):
+                    continue
+                if removed >= limit:
+                    break
+                info = entry.stat(follow_symlinks=False)
+                if info.st_mtime >= cutoff:
+                    continue
+                try:
+                    with open(entry.path, "r+b") as stream:
+                        current = os.fstat(stream.fileno())
+                        if not stat.S_ISREG(current.st_mode) or current.st_mtime >= cutoff or not lock_temporary(stream):
+                            continue
+                    os.unlink(entry.path)
+                    removed += 1
+                except FileNotFoundError:
+                    continue
+        return bool(removed)
diff --git a/backend/bmt_backend/packed_storage.py b/backend/bmt_backend/packed_storage.py
--- /dev/null
+++ b/backend/bmt_backend/packed_storage.py
@@ -0,0 +1,322 @@
+"""Durable SQL intake, bounded independent gzip frames and atomic pack publication."""
+import gzip
+import hashlib
+import uuid
+from contextlib import nullcontext
+
+from sqlalchemy import delete, select
+from sqlalchemy.dialects.postgresql import insert as pg_insert
+from sqlalchemy.dialects.sqlite import insert as sqlite_insert
+
+from .object_models import ObjectPack, ObjectPartition, PackedObject
+from .pack_io import PackIO
+from .storage import MAX_BLOB_BYTES, canonical_json, decode_blob_json
+from .track_models import OperationState, now
+
+PARTITIONS = 16
+MAGIC = b"BMTPACK1"
+
+
+def insert(session):
+    return sqlite_insert if session.bind.dialect.name == "sqlite" else pg_insert
+
+
+class PackedBlobStore:
+    def __init__(self, store, factory, settings):
+        self.store, self.factory, self.settings = store, factory, settings
+        self.io = PackIO(store, settings.object_pack_bytes)
+
+    def close(self):
+        if hasattr(self.store, "close"):
+            self.store.close()
+
+    def put_json(self, data):
+        raw = canonical_json(data)
+        if len(raw) > MAX_BLOB_BYTES:
+            raise ValueError("Object exceeds limit")
+        digest = hashlib.sha256(raw).hexdigest()
+        encoded = gzip.compress(raw, compresslevel=3, mtime=0)
+        if len(encoded) + len(MAGIC) > self.settings.object_pack_bytes:
+            return self.store.put_json(data)
+        stripe = int(digest[:2], 16) % PARTITIONS
+        with self.factory() as session:
+            session.execute(insert(session)(ObjectPartition).values(id=stripe, pending_bytes=0, lease_until=0, lease_token="", batch=[])
+                .on_conflict_do_nothing(index_elements=[ObjectPartition.id]))
+            partition = session.scalar(select(ObjectPartition).where(ObjectPartition.id == stripe).with_for_update())
+            if session.get(PackedObject, digest) is not None:
+                return digest
+            if (partition.pending_bytes + len(encoded) > self.settings.object_pending_bytes_per_partition
+                    or partition.pending_records >= self.settings.object_pending_records_per_partition):
+                raise OSError("Durable object intake is full; retry after packed storage drains")
+            session.add(PackedObject(digest=digest, partition=stripe, created_at=now(), pending=encoded,
+                                    pack_digest=None, offset=0, length=len(encoded)))
+            partition.pending_bytes += len(encoded)
+            partition.pending_records += 1
+            session.commit()  # The acknowledgement survives API/worker process loss.
+        return digest
+
+    def get_json(self, digest, *, session=None):
+        self.io.key(digest)
+        with nullcontext(session) if session is not None else self.factory() as db:
+            row = db.get(PackedObject, digest)
+            location = (row.pending, row.pack_digest, row.offset, row.length) if row else None
+        if location is None:
+            return self.store.get_json(digest)  # Existing individually stored objects remain readable.
+        pending, pack, offset, length = location
+        body = pending if pending is not None else self.io.get(pack, offset, length)
+        return decode_blob_json(body, digest)
+
+    def get_json_in_session(self, session, digest):
+        return self.get_json(digest, session=session)
+
+    def delete(self, digest, *, session=None):
+        self.io.key(digest)
+        found = False
+        external = session is not None
+        with nullcontext(session) if external else self.factory() as db:
+            stripe = int(digest[:2], 16) % PARTITIONS
+            partition = db.scalar(select(ObjectPartition).where(ObjectPartition.id == stripe).with_for_update())
+            row = db.get(PackedObject, digest)
+            if row:
+                found = True
+                if digest in (partition.batch if partition else []):
+                    return False  # An in-flight publication owns these bytes; collect on a later pass.
+                if row.pending is not None:
+                    partition.pending_bytes -= row.length
+                    partition.pending_records -= 1
+                elif row.pack_digest:
+                    pack = db.scalar(select(ObjectPack).where(ObjectPack.digest == row.pack_digest).with_for_update())
+                    pack.dead_bytes += row.length
+                db.delete(row)
+                if not external:
+                    db.commit()
+        if not found:
+            self.store.delete(digest)
+        return True
+
+    def delete_in_session(self, session, digest):
+        return self.delete(digest, session=session)
+
+    def list_objects(self, cursor, limit):
+        if type(limit) is not int or not 1 <= limit <= 1000:
+            raise ValueError("Invalid packed object scan limit")
+        if cursor is not None and (type(cursor) is not dict or set(cursor) != {"packed", "cursor"} or type(cursor["packed"]) is not bool):
+            raise ValueError("Invalid packed object cursor")
+        if cursor is None or cursor["packed"]:
+            after = cursor["cursor"] if cursor else ""
+            if type(after) is not str or (after and (len(after) != 64 or any(c not in "0123456789abcdef" for c in after))):
+                raise ValueError("Invalid packed object cursor")
+            with self.factory() as session:
+                rows = session.execute(select(PackedObject.digest, PackedObject.created_at, PackedObject.length)
+                    .where(PackedObject.digest > after).order_by(PackedObject.digest).limit(limit)).all()
+            result = [{"digest": row.digest, "modified": row.created_at, "bytes": row.length} for row in rows]
+            return result, {"packed": True, "cursor": rows[-1].digest} if len(rows) == limit else {"packed": False, "cursor": None}
+        rows, next_cursor = self.store.list_objects(cursor["cursor"], limit)
+        return rows, {"packed": False, "cursor": next_cursor} if next_cursor else None
+
+    def flush_once(self, *, at=None, force=False):
+        stamp = now() if at is None else at
+        token = str(uuid.uuid4())
+        with self.factory() as session:
+            partitions = session.scalars(select(ObjectPartition.id).where(ObjectPartition.pending_bytes > 0,
+                ObjectPartition.lease_until <= stamp).order_by(ObjectPartition.id).limit(PARTITIONS)).all()
+            chosen = None
+            for stripe in partitions:
+                partition = session.scalar(select(ObjectPartition).where(ObjectPartition.id == stripe,
+                    ObjectPartition.lease_until <= stamp).with_for_update(skip_locked=True))
+                if partition is None:
+                    continue
+                statement = select(PackedObject.digest, PackedObject.created_at, PackedObject.length).where(
+                    PackedObject.partition == stripe, PackedObject.pending.is_not(None))
+                if partition.batch:
+                    statement = statement.where(PackedObject.digest.in_(partition.batch))
+                rows = session.execute(statement.order_by(PackedObject.created_at, PackedObject.digest)
+                    .limit(self.settings.object_pack_records)).all()
+                if not rows:
+                    continue
+                if not force and not partition.batch and len(rows) < self.settings.object_pack_records and rows[0].created_at > stamp-self.settings.object_pack_flush_seconds:
+                    continue
+                selected, size = [], len(MAGIC)
+                for row in rows:
+                    if size + row.length > self.settings.object_pack_bytes:
+                        break
+                    selected.append(row.digest)
+                    size += row.length
+                partition.batch = selected
+                partition.lease_token, partition.lease_until = token, stamp + 60
+                payloads = dict(session.execute(select(PackedObject.digest, PackedObject.pending)
+                    .where(PackedObject.digest.in_(selected))).all())
+                chosen = stripe, [(key, payloads[key]) for key in selected]
+                session.commit()
+                break
+        if chosen is None:
+            return False
+        stripe, selected = chosen
+        body, offsets = bytearray(MAGIC), {}
+        for digest, encoded in selected:
+            decode_blob_json(encoded, digest)
+            offsets[digest] = len(body), len(encoded)
+            body.extend(encoded)
+        pack_digest = hashlib.sha256(body).hexdigest()
+        self._register_pack(pack_digest, len(body), len(selected), stamp)
+        # The durable claimed digest list makes an interrupted upload deterministic.
+        self.io.put(pack_digest, bytes(body))
+        with self.factory() as session:
+            partition = session.scalar(select(ObjectPartition).where(ObjectPartition.id == stripe).with_for_update())
+            if partition.lease_token != token or partition.lease_until <= now():
+                return False
+            session.execute(insert(session)(ObjectPack).values(digest=pack_digest, size=len(body), records=len(selected),
+                dead_bytes=0, retire_after=0, created_at=stamp, hold_until=stamp+60).on_conflict_do_nothing(index_elements=[ObjectPack.digest]))
+            pack = session.get(ObjectPack, pack_digest)
+            pack.retire_after, pack.hold_until = 0, 0
+            for key, (offset, length) in offsets.items():
+                row = session.get(PackedObject, key)
+                if row is None or row.pending is None:
+                    raise OSError("Claimed durable intake changed")
+                row.pack_digest, row.offset, row.pending = pack_digest, offset, None
+                partition.pending_bytes -= length
+                partition.pending_records -= 1
+            partition.batch, partition.lease_until, partition.lease_token = [], 0, ""
+            session.commit()  # Locations switch together; readers still see pending bytes until commit.
+        return True
+
+    def _register_pack(self, digest, size, records, stamp):
+        # Register upload intent first: lost acknowledgements cannot leak an untracked pack.
+        with self.factory() as session:
+            session.execute(insert(session)(ObjectPack).values(digest=digest, size=size, records=records,
+                dead_bytes=0, retire_after=0, created_at=stamp, hold_until=stamp+60)
+                .on_conflict_do_update(index_elements=[ObjectPack.digest], set_={"hold_until": stamp+60}))
+            session.commit()
+
+    def compact_once(self, *, at=None):
+        stamp = now() if at is None else at
+        token = str(uuid.uuid4())
+        with self.factory() as session:
+            pause = session.get(OperationState, "object-maintenance")
+            if pause is not None and pause.updated_at > stamp:
+                return False
+            pack = session.scalar(select(ObjectPack).where(ObjectPack.dead_bytes >= ObjectPack.size/2,
+                ObjectPack.retire_after == 0, ObjectPack.created_at < stamp-600)
+                .order_by(ObjectPack.created_at).limit(1))
+            if pack is None:
+                return False
+            rows = session.execute(select(PackedObject.digest, PackedObject.offset, PackedObject.length,
+                PackedObject.partition).where(PackedObject.pack_digest == pack.digest)
+                .order_by(PackedObject.offset).limit(129)).all()
+            if not rows:
+                return False
+            if len(rows) > 128:
+                raise OSError("Pack record bound exceeded")
+            stripe = rows[0].partition
+            partition = session.scalar(select(ObjectPartition).where(ObjectPartition.id == stripe,
+                ObjectPartition.lease_until <= stamp).with_for_update(skip_locked=True))
+            if partition is None or partition.batch:
+                return False
+            if any(row.partition != stripe for row in rows):
+                raise OSError("Invalid pack partition")
+            partition.lease_token, partition.lease_until = token, stamp+60
+            old_digest, size = pack.digest, pack.size
+            session.commit()
+        old = self.io.get(old_digest, 0, size)
+        if hashlib.sha256(old).hexdigest() != old_digest or not old.startswith(MAGIC):
+            raise OSError("Pack compaction failed integrity")
+        body, offsets = bytearray(MAGIC), {}
+        for row in rows:
+            encoded = old[row.offset:row.offset+row.length]
+            decode_blob_json(encoded, row.digest)
+            offsets[row.digest] = len(body), row.length
+            body.extend(encoded)
+        digest = hashlib.sha256(body).hexdigest()
+        self._register_pack(digest, len(body), len(rows), stamp)
+        self.io.put(digest, bytes(body))
+        with self.factory() as session:
+            partition = session.scalar(select(ObjectPartition).where(ObjectPartition.id == stripe).with_for_update())
+            if partition.lease_token != token or partition.lease_until <= now():
+                return False
+            old_pack = session.scalar(select(ObjectPack).where(ObjectPack.digest == old_digest).with_for_update())
+            new_pack = session.get(ObjectPack, digest)
+            new_pack.retire_after, new_pack.hold_until = 0, 0
+            for key, (offset, length) in offsets.items():
+                row = session.get(PackedObject, key)
+                if row is None or row.pack_digest != old_digest:
+                    new_pack.dead_bytes += length
+                    continue
+                row.pack_digest, row.offset = digest, offset
+                old_pack.dead_bytes += length
+            old_pack.retire_after = stamp + max(600, self.settings.job_lease_seconds+60)
+            partition.lease_token, partition.lease_until = "", 0
+            session.commit()
+        return True
+
+    def collect_once(self, *, at=None):
+        stamp = now() if at is None else at
+        with self.factory() as session:
+            pause = session.get(OperationState, "object-maintenance")
+            if pause is not None and pause.updated_at > stamp:
+                return False
+            live = select(PackedObject.digest).where(PackedObject.pack_digest == ObjectPack.digest).exists()
+            pack = session.scalar(select(ObjectPack).where(~live, ObjectPack.created_at < stamp-600, ObjectPack.hold_until <= stamp)
+                .order_by(ObjectPack.created_at).limit(1).with_for_update(skip_locked=True))
+            if pack is None:
+                return False
+            digest = pack.digest
+            if not pack.retire_after:
+                pack.retire_after = stamp + max(600, self.settings.job_lease_seconds+60)
+                session.commit()
+                return True
+            if pack.retire_after > stamp:
+                return False
+            self.io.delete(digest)
+            session.execute(delete(ObjectPack).where(ObjectPack.digest == digest))
+            session.commit()
+            return True
+
+
+def main():
+    import logging
+    import signal
+    import threading
+    from dataclasses import replace
+
+    from sqlalchemy.exc import SQLAlchemyError
+
+    from .config import Settings
+    from .cost_maintenance import CostMaintenance
+    from .database_privileges import verify_runtime
+    from .db import make_engine, make_session_factory
+    from .observability import configure_logging
+    from .storage import make_blob_store
+
+    settings = Settings.from_env()
+    configure_logging()
+    if not settings.object_packing_enabled:
+        raise ValueError("Packed storage worker requires explicit enablement")
+    if settings.workload_role != "worker":
+        raise ValueError("Packed storage daemon requires the worker credential role")
+    engine = make_engine(settings.database_url, replace(settings, database_pool_size=1, database_pool_overflow=0))
+    verify_runtime(engine, settings)
+    factory = make_session_factory(engine)
+    blobs = make_blob_store(settings, factory)
+    maintenance = CostMaintenance(factory, blobs, settings)
+    stop = threading.Event()
+    for signum in (signal.SIGINT, signal.SIGTERM):
+        signal.signal(signum, lambda *_args: stop.set())
+    delay = .05
+    try:
+        while not stop.is_set():
+            try:
+                # Intake always drains, even while expensive maintenance yields.
+                flushed = blobs.flush_once()
+                worked = maintenance.step() or flushed
+                delay = .05 if worked else min(2, delay*2)
+            except (OSError, SQLAlchemyError) as error:
+                logging.getLogger("bmt.packs").error("packed_storage_dependency_unavailable", extra={"exception_type": type(error).__name__})
+                delay = 2
+            stop.wait(delay)
+    finally:
+        blobs.close()
+        engine.dispose()
+
+
+if __name__ == "__main__":
+    main()
