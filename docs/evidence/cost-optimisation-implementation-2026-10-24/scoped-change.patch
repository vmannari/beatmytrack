@@ -0,0 +1,34 @@
+extends RefCounted
+## Reusable route artwork; authority and volatile metadata still arrive in every page.
+var cache = preload("res://backend/menu_snapshot_cache.gd").new()
+
+func configure(directory: String, scope: String) -> void:
+	cache.max_entries = 64
+	cache.max_age_seconds = 31536000
+	cache.configure(directory.path_join(scope.sha256_text()+".json") if not directory.is_empty() else "",scope)
+
+func known() -> Array:
+	var result: Array = []
+	var keys: Array = cache.entries.keys()
+	keys.reverse()
+	for key: String in keys:
+		if not cache.read(key).is_empty(): result.append(key)
+		if result.size() == 32: break
+	return result
+
+func restore(page: Dictionary) -> bool:
+	if not page.get("items") is Array: return false
+	for item: Variant in page.items:
+		if not item is Dictionary: return false
+		var hash: String = str(item.get("preview_hash",""))
+		if hash.is_empty(): continue
+		if hash.length() != 64 or not hash.is_valid_hex_number(): return false
+		if not item.has("points"):
+			var saved: Dictionary = cache.read(hash)
+			if not saved.get("points") is Array: return false
+			item.points = saved.points
+		elif not item.points is Array or item.points.size() > 96:
+			return false
+		else:
+			cache.remember(hash,{"points":item.points})
+	return true
diff --git a/game/backend/recording_cache.gd b/game/backend/recording_cache.gd
--- /dev/null
+++ b/game/backend/recording_cache.gd
@@ -0,0 +1,108 @@
+extends RefCounted
+## Disposable, bounded, account-scoped presentation bytes. No race authority.
+const MAX_BYTES: int = 8388608
+const DISK_BYTES: int = 67108864
+const MAX_FILES: int = 64
+const MAGIC: String = "bmt-recording-cache-v1"
+static var _access: Dictionary = {}
+static var _loaded_access: Dictionary = {}
+static var _saved_access: Dictionary = {}
+static var _access_mutex := Mutex.new()
+
+static func _accessed(directory: String, path: String, touch: bool = false) -> int:
+	_access_mutex.lock()
+	if not _loaded_access.has(directory):
+		var saved: Dictionary = preload("res://backend/atomic_json.gd").read(directory.path_join("access.json"),65536)
+		for name: String in saved:
+			if name.ends_with(".ghost") and name.length() == 70 and (saved[name] is float or saved[name] is int): _access[directory.path_join(name)] = int(saved[name])
+		_loaded_access[directory] = true
+	var stamp: int = int(Time.get_unix_time_from_system()*1000.0)
+	if touch: _access[path] = stamp
+	var value: int = int(_access.get(path,0))
+	while _access.size() > MAX_FILES*4: _access.erase(_access.keys()[0])
+	while _loaded_access.size() > 16: _loaded_access.erase(_loaded_access.keys()[0])
+	while _saved_access.size() > 16: _saved_access.erase(_saved_access.keys()[0])
+	if touch and stamp-int(_saved_access.get(directory,0)) >= 60000:
+		var entries: Dictionary = {}
+		for candidate: String in _access:
+			if candidate.get_base_dir() == directory: entries[candidate.get_file()] = _access[candidate]
+		preload("res://backend/atomic_json.gd").write(directory.path_join("access.json"),entries,65536)
+		_saved_access[directory] = stamp
+	_access_mutex.unlock()
+	return value
+
+static func valid(recording: Variant) -> Dictionary:
+	if not recording is Dictionary or not recording.has_all(["poses","ticks"]) or not recording.poses is Array or recording.poses.size() < 2 or recording.poses.size() > 36007: return {}
+	var previous: float = -1.0
+	for pose: Variant in recording.poses:
+		if not pose is Array or pose.size() != 7: return {}
+		for number: Variant in pose:
+			if not (number is float or number is int) or not is_finite(float(number)): return {}
+		for component: int in range(1,7):
+			if absf(float(pose[component])) > 100000.0: return {}
+		if float(pose[0]) <= previous: return {}
+		previous = float(pose[0])
+	if not (recording.ticks is float or recording.ticks is int) or not is_finite(float(recording.ticks)): return {}
+	if float(recording.ticks) <= 0 or float(recording.ticks) > PersonalGhostRun.MAX_TICKS or previous != float(recording.ticks) or float(recording.poses[0][0]) != 0.0: return {}
+	return recording
+
+static func _path(directory: String, scope: String, identity: String) -> String:
+	return directory.path_join((scope+"\n"+identity).sha256_text()+".ghost")
+
+static func _digest(body: PackedByteArray) -> String:
+	var context := HashingContext.new()
+	context.start(HashingContext.HASH_SHA256)
+	context.update(body)
+	return context.finish().hex_encode()
+
+static func read(directory: String, scope: String, identity: String) -> Dictionary:
+	if directory.is_empty(): return {}
+	var file := FileAccess.open(_path(directory,scope,identity),FileAccess.READ)
+	if file == null or file.get_length() < 64 or file.get_length() > MAX_BYTES+64: return {}
+	var digest: String = file.get_buffer(64).get_string_from_ascii()
+	var body: PackedByteArray = file.get_buffer(file.get_length()-64)
+	if body.is_empty() or _digest(body) != digest: return {}
+	var decoded: PackedByteArray = body.decompress_dynamic(MAX_BYTES,FileAccess.COMPRESSION_GZIP)
+	if decoded.is_empty(): return {}
+	var value: Variant = bytes_to_var(decoded)
+	if not value is Dictionary or value.get("schema") != MAGIC or value.get("scope") != scope or value.get("identity") != identity: return {}
+	var recording: Dictionary = valid(value.get("recording"))
+	if not recording.is_empty(): _accessed(directory,_path(directory,scope,identity),true)
+	return recording
+
+static func write(directory: String, scope: String, identity: String, recording: Dictionary) -> bool:
+	if directory.is_empty() or valid(recording).is_empty(): return false
+	var raw: PackedByteArray = var_to_bytes({"schema":MAGIC,"scope":scope,"identity":identity,"recording":recording})
+	if raw.size() > MAX_BYTES: return false
+	var body: PackedByteArray = raw.compress(FileAccess.COMPRESSION_GZIP)
+	if body.is_empty() or body.size() > MAX_BYTES or DirAccess.make_dir_recursive_absolute(directory) != OK: return false
+	var path: String = _path(directory,scope,identity)
+	var files: Array[Dictionary] = []
+	var total: int = body.size()+64
+	for name: String in DirAccess.get_files_at(directory):
+		if not name.ends_with(".ghost") or name == path.get_file(): continue
+		var candidate: String = directory.path_join(name)
+		var old := FileAccess.open(candidate,FileAccess.READ)
+		if old == null: continue
+		files.append({"path":candidate,"bytes":old.get_length(),"at":maxi(_accessed(directory,candidate),int(FileAccess.get_modified_time(candidate))*1000)})
+		total += old.get_length()
+		old.close()
+		if files.size() > MAX_FILES*2: return false
+	files.sort_custom(func(a: Dictionary,b: Dictionary) -> bool: return a.path < b.path if a.at == b.at else a.at < b.at)
+	while not files.is_empty() and (files.size() >= MAX_FILES or total > DISK_BYTES):
+		var oldest: Dictionary = files.pop_front()
+		if DirAccess.remove_absolute(oldest.path) != OK: return false
+		total -= int(oldest.bytes)
+	var temporary: String = path+"."+str(Time.get_ticks_usec())+".tmp"
+	var file := FileAccess.open(temporary,FileAccess.WRITE)
+	if file == null: return false
+	file.store_buffer(_digest(body).to_ascii_buffer())
+	file.store_buffer(body)
+	file.flush()
+	var ok: bool = file.get_error() == OK
+	file.close()
+	if ok and DirAccess.rename_absolute(temporary,path) == OK:
+		_accessed(directory,path,true)
+		return true
+	DirAccess.remove_absolute(temporary)
+	return false
diff --git a/game/backend/recording_downloads.gd b/game/backend/recording_downloads.gd
--- /dev/null
+++ b/game/backend/recording_downloads.gd
@@ -0,0 +1,56 @@
+extends RefCounted
+## Resolve current access/target before reusing immutable recording bytes.
+const CACHE = preload("res://backend/recording_cache.gd")
+static var _pending: Dictionary = {}
+
+static func fetch(client: Node, path: String, authorized: bool, expected_run_id: String = "") -> Dictionary:
+	var scope: String = client.base_url()+"/"+str(client.player.get("id",""))
+	var generation: int = int(client.get("_session_generation"))
+	var key: String = str(client.get_instance_id())+"/"+str(generation)+"/"+path+"/"+expected_run_id
+	if _pending.has(key):
+		var shared: Dictionary = _pending[key]
+		while not shared.done:
+			await client.get_tree().process_frame
+			if generation != int(client.get("_session_generation")): return {}
+		return shared.recording.duplicate(true) if _current(client,scope,generation,str(shared.get("owner",""))) else {}
+	if _pending.size() >= 16: return {}
+	var pending: Dictionary = {"done":false,"recording":{},"owner":""}
+	_pending[key] = pending
+	pending.recording = await _fetch(client,path,authorized,scope,generation,pending,expected_run_id)
+	pending.done = true
+	_pending.erase(key)
+	return pending.recording
+
+static func _current(client: Node, scope: String, generation: int, player_id: String = "") -> bool:
+	return generation == int(client.get("_session_generation")) and scope == client.base_url()+"/"+str(client.player.get("id","")) and (not is_instance_valid(client.get("safety")) or not client.safety.is_blocked(player_id))
+
+static func _fetch(client: Node, path: String, authorized: bool, scope: String, generation: int, pending: Dictionary, expected_run_id: String) -> Dictionary:
+	var modern: bool = int(client._capabilities.get("ghost_identity_version",0)) == 1
+	var suffix: String = "&" if "?" in path else "?"
+	var response: Dictionary = await client.request_api(path+suffix+"metadata=true" if modern else path,HTTPClient.METHOD_GET,{},"",authorized)
+	if not response.get("ok",false) or not _current(client,scope,generation): return {}
+	if not modern:
+		if not expected_run_id.is_empty() and str(response.data.get("run_id","")) != expected_run_id: return {}
+		pending.owner = str(response.data.get("player_id",""))
+		return CACHE.valid(response.data.get("recording")) if _current(client,scope,generation,pending.owner) else {}
+	var metadata: Dictionary = response.data
+	if not metadata.get("run_id") is String or not metadata.get("content_hash") is String or str(metadata.content_hash).length() != 64 or not str(metadata.content_hash).is_valid_hex_number(): return {}
+	if not expected_run_id.is_empty() and str(metadata.run_id) != expected_run_id: return {}
+	var owner: String = str(metadata.get("player_id",""))
+	pending.owner = owner
+	if not _current(client,scope,generation,owner): return {}
+	var identity: String = str(metadata.run_id)+"/"+str(metadata.content_hash)
+	var directory: String = str(client.get("recording_cache_directory"))
+	var cached: Variant = await client._background(CACHE.read.bind(directory,scope,identity))
+	if not _current(client,scope,generation,owner): return {}
+	if cached is Dictionary and not cached.is_empty():
+		client.recording_cache_hits += 1
+		return cached
+	var encoding: String = "&encoding=packed" if int(client._capabilities.get("ghost_wire_version",0)) == 1 else ""
+	response = await client.request_api(path+suffix+"expected_run_id="+str(metadata.run_id).uri_encode()+encoding,HTTPClient.METHOD_GET,{},"",authorized)
+	if not response.get("ok",false) or not _current(client,scope,generation,owner) or str(response.data.get("run_id","")) != str(metadata.run_id) or str(response.data.get("content_hash","")) != str(metadata.content_hash): return {}
+	var recording: Dictionary = await client._background(preload("res://backend/ghost_wire.gd").decode.bind(response.data.get("recording")))
+	if recording.is_empty(): return {}
+	client.recording_downloads += 1
+	await client._background(CACHE.write.bind(directory,scope,identity,recording))
+	return recording if _current(client,scope,generation,owner) else {}
