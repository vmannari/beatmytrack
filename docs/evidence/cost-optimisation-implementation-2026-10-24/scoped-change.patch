+            )
+        )
+        connection.execute(
+            text(
+                f"GRANT SELECT,UPDATE(revoked) ON {qschema}.session_families TO {identifier(roles['admin'])}"
+            )
+        )
+        connection.execute(
+            text(
+                f"GRANT EXECUTE ON FUNCTION {qschema}.bmt_redact_removed_audit(text) TO {identifier(roles['worker'])}"
+            )
+        )
+
