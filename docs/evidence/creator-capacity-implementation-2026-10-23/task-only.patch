+doc["objects"] = [{"kind": "grass_clump", "position": [i % 100 - 50, i // 100 - 20], "rotation": 0}
+                  for i in range(4096)]
+cases.append(("4096-props", copy.deepcopy(doc), True))
+doc["objects"].append(doc["objects"][0])
+cases.append(("4097-props", copy.deepcopy(doc), False))
