+<script>
+const renderer=document.querySelector('#renderer'),size=document.querySelector('#size'),section=document.querySelector('#section'),capture=document.querySelector('#capture'),caption=document.querySelector('#caption');
+let before=false,timer;
+function refresh(){const width=section.value.startsWith('part-')?'1280':size.value;capture.src=before?`before-${section.value==='patterns'?'patterns':'kits'}-1280.png`:`test_customisation_carousel-${renderer.value}/app-${section.value}-${width}.png`;caption.textContent=before?'Before — retained native 1280 × 720 capture':`After — ${renderer.options[renderer.selectedIndex].text}, ${width} pixels wide, ${section.options[section.selectedIndex].text}`;document.querySelector('#before').textContent=before?'Show after':'Show before (1280)';}
