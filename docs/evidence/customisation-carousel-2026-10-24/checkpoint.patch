+<select id="section" aria-label="Customisation type"><option value="kits">Hood</option><option value="part-aero">Rear aero (1280)</option><option value="part-rims">Rims (1280)</option><option value="part-body">Body kits (1280)</option><option value="patterns">Patterns</option></select>
