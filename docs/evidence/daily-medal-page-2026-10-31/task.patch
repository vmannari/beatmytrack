+		var branch := Rect2(center.x-radius*1.4,center.y-radius, radius*0.4,radius*2)
+		draw_texture_rect(LAUREL,branch,false,COLORS[4])
+		draw_set_transform(Vector2(size.x,0),0,Vector2(-1,1))
+		draw_texture_rect(LAUREL,branch,false,COLORS[4])
+		draw_set_transform(Vector2.ZERO)
