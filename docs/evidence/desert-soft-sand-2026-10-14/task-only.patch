@@ -0,0 +1,54 @@
+from pathlib import Path
+import hashlib
+import json
+import wave
+import numpy as np
+
+root = Path(__file__).resolve().parents[1]
+out = root / 'docs/evidence/desert-soft-sand-2026-10-14'
+
+def read(path):
+    with wave.open(str(path), 'rb') as stream:
+        rate = stream.getframerate()
+        channels = stream.getnchannels()
+        assert stream.getsampwidth() == 2
+        values = np.frombuffer(stream.readframes(stream.getnframes()), dtype='<i2').astype(float) / 32768
+    return values.reshape(-1, channels), rate
+
+def rms(values):
+    return float(np.sqrt(np.mean(values * values)))
+
+report = {'captures': [], 'notes': 'Controlled native desktop contact auditions; numerical checks do not establish subjective or phone listening acceptance.'}
+for renderer in ['gl_compatibility', 'mobile']:
+    folder = out / 'after' / renderer
+    mixed, rate = read(folder / 'driving.wav')
+    sand, sand_rate = read(folder / 'sand.wav')
+    kerb, _ = read(folder / 'kerb.wav')
+    engine, engine_rate = read(folder / 'engine.wav')
+    assert rate == sand_rate == engine_rate
+    peak = float(np.max(np.abs(mixed)))
+    assert .01 < peak < .95, peak
+    assert np.max(np.abs(mixed[-rate // 2:])) == 0, 'Pause must be exactly silent'
+    assert np.max(np.abs(kerb)) == 0, 'No hard kerb rumble may reach the mixer'
+    balance = []
+    for label, start, end in [('road', .7, 1.5), ('bank', 2.7, 4.5), ('loose_sand', 6.7, 8.5)]:
+        sand_slice = sand[round(start * rate):round(end * rate)]
+        sand_rms = rms(sand_slice)
+        engine_rms = rms(engine[round(start * rate):round(end * rate)])
+        relative_db = float(20 * np.log10(sand_rms / engine_rms))
+        assert relative_db < -3, (label, relative_db)
+        windows = [rms(sand_slice[i:i + rate // 50]) for i in range(0, len(sand_slice) - rate // 50, rate // 50)]
+        assert min(windows) > np.median(windows) * .15, 'No gaps or isolated rhythmic contact pulses'
+        balance.append(dict(surface=label, sand_rms=sand_rms, relative_to_engine_db=relative_db, min_20ms_rms=min(windows)))
+    print(renderer, balance)
+    assert balance[1]['sand_rms'] > balance[0]['sand_rms'], 'Bank sand should have more body than compacted road'
+    report['captures'].append(dict(renderer=renderer, seconds=len(mixed)/rate, peak_dbfs=float(20*np.log10(peak)), kerb_peak=0, pause_peak=0, balance=balance))
+before, _ = read(out / 'before/gl_compatibility/kerb.wav')
+report['baseline_kerb_peak'] = float(np.max(np.abs(before)))
+assert report['baseline_kerb_peak'] > .01, 'Baseline must reproduce the audible kerb path'
+hashes = json.loads((out / 'audio-bank-before.json').read_text(encoding='utf-8-sig'))
+for item in hashes:
+    assert hashlib.sha256(Path(item['Path']).read_bytes()).hexdigest().upper() == item['Hash'], item['Path']
+report['unchanged_audio_bank_files'] = len(hashes)
+(out / 'audio-review.json').write_text(json.dumps(report, indent=2) + '\n', encoding='utf-8')
+print(json.dumps(report, indent=2))
