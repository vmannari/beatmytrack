+param([string]$Renderer = 'gl_compatibility', [string]$Check = 'test_desert_soft_sand_audio', [switch]$Baseline, [switch]$Capture, [switch]$Headless)
+$ErrorActionPreference = 'Stop'
+$repoRoot = Split-Path -Parent $PSScriptRoot
+$env:APPDATA = Join-Path $repoRoot 'build/desert-soft-sand-user'
+New-Item -ItemType Directory -Force -Path $env:APPDATA | Out-Null
+$phase = if ($Baseline) { 'before' } else { 'after' }
+$evidence = "res://../docs/evidence/desert-soft-sand-2026-10-14/$phase/$Renderer"
+$logRoot = Join-Path $repoRoot "docs/evidence/desert-soft-sand-2026-10-14/$phase/$Renderer/logs"
+New-Item -ItemType Directory -Force -Path $logRoot | Out-Null
+$arguments = @("--evidence-dir=$evidence")
+if ($Baseline) { $arguments += '--baseline' }
+if ($Capture) { $arguments += '--capture' }
+try {
+    & (Join-Path $repoRoot 'scripts/dev.ps1') -Action TestScript -ScriptPath ('res://tests/'+$Check+'.gd') -Graphical:(-not $Headless) -RenderingMethod $Renderer -TestArgument $arguments -CommandTimeoutSeconds 90
+    if ($LASTEXITCODE -ne 0) { throw "Godot check failed with exit $LASTEXITCODE" }
+} finally {
+    $log = Join-Path $repoRoot "build/logs/TestScript-$PID/test-script.log"
+    if (Test-Path -LiteralPath $log) { Copy-Item -LiteralPath $log -Destination (Join-Path $logRoot ($Check+$(if ($Headless) { '-headless' })+'.log')) }
+}
