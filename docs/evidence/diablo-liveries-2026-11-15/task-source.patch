@@ -72,6 +72,10 @@ static func uniforms(finish: ShaderMaterial, value: Dictionary, id: String, enab
 	if is_panel:
 		var full_color: bool = premium.get("kind","")=="full_color"
 		finish.set_shader_parameter("premium_full_color",full_color)
