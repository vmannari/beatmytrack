+    op.create_table("discovery_storage",
+        sa.Column("id", sa.Integer(), primary_key=True),
+        sa.Column("member_rows", sa.BigInteger(), nullable=False),
+        sa.Column("member_bytes", sa.BigInteger(), nullable=False))
