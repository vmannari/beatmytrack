+$env:APPDATA = Join-Path (Get-Location) 'build/drift-haptics-2026-10-16/profile-import'
+powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Action Import -CommandTimeoutSeconds 150
