+$env:APPDATA = Join-Path (Get-Location) 'build/drift-haptics-2026-10-16/profile-driving'
+powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Action TestDriving -CommandTimeoutSeconds 120
