--- /dev/null
+++ b/backend/tests/test_earned_coins.py
@@ -0,0 +1,187 @@
+"""Persistent rewards/ownership through the real acceptance and HTTP boundaries."""
+# ruff: noqa: F811
+import json
+import uuid
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import pytest
+from sqlalchemy import func, select
+from test_domains import domain, headers, publish, race, submit, ticket, upload  # noqa: F401
+
+from bmt_backend.economy import PRICES, accept_verified, locked_wallet, previous_bests
+from bmt_backend.economy_models import CoinMilestone, CoinReward, CoinWallet, CosmeticUnlock
+from bmt_backend.track_models import Run, now
+from bmt_backend.worker import process_one
+
+
+def wallet(d, player="Creator"):
+    response = d.client.get("/v1/economy", headers=headers(d, player))
+    assert response.status_code == 200, response.text
+    return response.json()
+
+
+def fund(d, amount=2000, player="Creator"):
+    with d.factory() as session:
+        value = locked_wallet(session, d.players[player])
+        value.balance = amount
+        session.commit()
+
+
+def buy(d, item="livery/apex_twin", key=None, player="Creator", **extra):
+    return d.client.post("/v1/economy/purchases", json={"item_id": item, "expected_price":PRICES.get(item,500), **extra},
+                         headers=headers(d, player, key))
+
+
+def test_accepted_races_credit_once_and_only_improvements_earn_pb(domain):
+    version = upload(domain)
+    first = race(domain, version, frames=30)
+    assert wallet(domain)["balance"] == 100  # completion and first track
+    receipt = domain.client.get("/v1/economy/rewards/" + first["ticket_id"], headers=headers(domain)).json()
+    assert receipt["status"] == "credited" and receipt["amount"] == 100
+    with domain.factory() as session:
+        run = session.get(Run, first["run_id"])
+        accept_verified(session, run, previous_bests(session, run))
+        session.commit()
+        assert session.scalar(select(func.count()).select_from(CoinReward)) == 1
+    assert wallet(domain)["balance"] == 100
+    race(domain, version, frames=20)
+    assert wallet(domain)["balance"] == 350
+    race(domain, version, frames=20)
+    assert wallet(domain)["balance"] == 400
+    race(domain, version, frames=40)
+    assert wallet(domain)["balance"] == 450
+    assert wallet(domain, "Alice")["balance"] == 0
+
+
+def test_pending_rejected_and_other_owner_never_credit(domain):
+    version = upload(domain)
+    issued = ticket(domain, version)
+    submit(domain, issued, steering=-127)
+    path = "/v1/economy/rewards/" + issued["ticket_id"]
+    assert domain.client.get(path, headers=headers(domain)).json()["status"] == "pending"
+    assert domain.client.get(path, headers=headers(domain, "Alice")).status_code == 404
+    assert wallet(domain)["balance"] == 0
+    assert process_one(domain.app)
+    assert domain.client.get(path, headers=headers(domain)).json()["status"] == "unavailable"
+    assert wallet(domain)["balance"] == 0
+    assert domain.client.get("/v1/economy/rewards/" + str(uuid.uuid4()), headers=headers(domain)).status_code == 404
+
+
+def test_purchase_is_permanent_idempotent_and_server_priced(domain):
+    fund(domain)
+    key = str(uuid.uuid4())
+    first = buy(domain, key=key)
+    assert first.status_code == 200, first.text
+    assert first.json()["charged"] == 500
+    assert buy(domain, key=key).json() == first.json()
+    assert buy(domain).json()["charged"] == 0
+    assert wallet(domain)["balance"] == 1500
+    assert wallet(domain)["owned"] == ["livery/apex_twin"]
+    assert buy(domain, "kit/compact/hood/scoop", key=key).status_code == 409
+    assert buy(domain, "kit/compact/hood/scoop").json()["charged"] == 750
+    assert wallet(domain)["balance"] == 750
+    assert buy(domain, "livery/offset_gt", expected_price=1).json()["detail"] == "COSMETIC_PRICE_CHANGED"
+    assert wallet(domain)["balance"] == 750
+    assert len(wallet(domain)["owned"]) == 2
+    assert wallet(domain, "Alice")["owned"] == []
+    for extra in ({"price": 0}, {"balance": 999999}, {"owned": ["livery/offset_gt"]}):
+        assert buy(domain, **extra).status_code == 422
+    assert buy(domain, "kit/pickup/hood/scoop").status_code == 422
+    assert buy(domain, "livery/does_not_exist").status_code == 422
+    assert wallet(domain)["balance"] == 750
+
+
+def test_insufficient_exact_and_last_coin_balance(domain):
+    fund(domain, 499)
+    assert buy(domain).json()["detail"] == "INSUFFICIENT_COINS"
+    assert wallet(domain)["owned"] == [] and wallet(domain)["balance"] == 499
+    fund(domain, 500)
+    assert buy(domain).json()["wallet"]["balance"] == 0
+    assert buy(domain, "livery/offset_gt").status_code == 409
+    with domain.factory() as session:
+        assert session.scalar(select(func.count()).select_from(CosmeticUnlock)) == 1
+        assert session.get(CoinWallet, domain.players["Creator"]).balance == 0
+
+
+def test_parallel_purchases_cannot_double_spend(domain):
+    if not domain.postgres:
+        pytest.skip("StaticPool fixture shares one SQLite connection; PostgreSQL exercises row locks")
+    fund(domain, 750)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        responses = list(pool.map(lambda item: buy(domain, item),
+            ["kit/compact/hood/scoop", "kit/compact/hood/dome"]))
+    assert sorted(response.status_code for response in responses) == [200, 409]
+    assert wallet(domain)["balance"] == 0 and len(wallet(domain)["owned"]) == 1
+    fund(domain, 1000)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        responses = list(pool.map(lambda _: buy(domain), range(2)))
+    assert [response.status_code for response in responses] == [200, 200]
+    assert sum(response.json()["charged"] for response in responses) == 500
+    assert wallet(domain)["balance"] == 500
+
+
+def test_percentile_tiers_only_pay_for_new_thresholds(domain):
+    version = upload(domain)
+    race(domain, version, frames=80)
+    publish(domain, version)
+    race(domain, version, "Alice", frames=50)
+    race(domain, version, "Bob", frames=60)
+    first = race(domain, version, frames=40)
+    path = "/v1/economy/rewards/" + first["ticket_id"]
+    rows = domain.client.get(path, headers=headers(domain)).json()["rows"]
+    assert [row["amount"] for row in rows if "percentile" in row["title"]] == [50, 50]
+    second = race(domain, version, frames=30)
+    rows = domain.client.get("/v1/economy/rewards/" + second["ticket_id"], headers=headers(domain)).json()["rows"]
+    assert not any("percentile" in row["title"] for row in rows)
+
+
+def test_catalog_matches_shipped_liveries_and_parts():
+    root = Path(__file__).resolve().parents[2]
+    patterns = json.loads((root / "game/assets/liveries/catalog.json").read_text())
+    assert {"livery/" + pattern["id"] for pattern in patterns} == {item for item in PRICES if item.startswith("livery/")}
+    assert len(PRICES) == 87
+
+
+def test_history_retention_keeps_balance_unlocks_and_reward_receipts(domain):
+    from bmt_backend.maintenance import retain
+    version = upload(domain)
+    race(domain, version, frames=30)
+    race(domain, version, frames=20)
+    old = race(domain, version, frames=40)
+    before = wallet(domain)
+    with domain.factory() as session:
+        session.get(Run, old["run_id"]).finished_at = now() - 100 * 86400
+        session.commit()
+    result = retain(domain.factory, domain.app.state.blobs, days=90, apply=True, online=True)
+    assert result["runs"] == 1
+    assert wallet(domain) == before
+    with domain.factory() as session:
+        assert session.get(Run, old["run_id"]) is None
+        assert session.get(CoinReward, old["run_id"]).amount == 50
+
+
+def test_account_removal_erases_coin_data_without_changing_v1_stage_order(auth_app, auth_client, sign_in):
+    from test_privacy import auth, deletion_body, drain, seed
+    signed = sign_in()
+    _, _, run_id, *_ = seed(auth_app, signed)
+    player_id = signed["player"]["id"]
+    with auth_app.state.session_factory() as session:
+        value = locked_wallet(session, player_id)
+        value.balance = 50
+        session.add(CoinReward(run_id=run_id, player_id=player_id, amount=50, rows=[]))
+        session.add(CoinMilestone(player_id=player_id, scope="fixture", value=1))
+        session.add(CosmeticUnlock(player_id=player_id, item_id="livery/apex_twin", price=500))
+        session.commit()
+    response = auth_client.post("/v1/privacy/account-deletion", json=deletion_body(), headers=auth(signed))
+    assert response.status_code == 202, response.text
+    drain(auth_app)
+    with auth_app.state.session_factory() as session:
+        for model in (CoinWallet, CoinReward, CoinMilestone, CosmeticUnlock):
+            assert session.scalar(select(func.count()).select_from(model)) == 0
+
+
+def test_requires_authentication(auth_client):
+    assert auth_client.get("/v1/economy").status_code == 401
+    assert auth_client.post("/v1/economy/purchases", json={"item_id": "livery/apex_twin"},
+                            headers={"Idempotency-Key": str(uuid.uuid4())}).status_code == 401
diff --git a/game/backend/cosmetic_economy.gd b/game/backend/cosmetic_economy.gd
new file mode 100644
--- /dev/null
+++ b/game/backend/cosmetic_economy.gd
@@ -0,0 +1,207 @@
+extends Node
+## Guest saves are device-only. Authenticated grants/charges always come from the server.
+signal changed
+const Shop = preload("res://persistence/cosmetic_catalog.gd")
+const IO = preload("res://backend/atomic_json.gd")
+var records: LocalRecords
+var client: Node
+var wallet: Dictionary = {}
+var pending: Dictionary = {}
+var status: String = ""
+var busy: bool = false
+var refreshing: bool = false
+var scope: String = ""
+var _path: String = ""
+var _storage_ok: bool = true
+var _epoch: int = 0
+var _timer: Timer
+
+func _ready() -> void:
+	if not records.settings.has("cosmetic_legacy"):
+		records.settings.cosmetic_legacy = Shop.legacy(records.settings)
+		if records.save_records() != OK: status = "Could not save cosmetic ownership."
+	if client != null: client.identity_changed.connect(sync_identity)
+	sync_identity()
+	_timer = Timer.new()
+	_timer.wait_time = 15.0
+	_timer.timeout.connect(func() -> void:
+		if not pending.is_empty() and not busy: refresh())
+	add_child(_timer)
+	_timer.start()
+
+func authenticated() -> bool:
+	return client != null and client.signed_in()
+
+func _current_scope() -> String:
+	return str(client.base_url())+"/"+str(client.player.get("id","")) if authenticated() else "guest"
+
+func sync_identity() -> void:
+	var next: String = _current_scope()
+	if next == scope: return
+	scope = next
+	_epoch += 1
+	wallet = {}
+	pending = {}
+	busy = false
+	refreshing = false
+	_storage_ok = true
+	status = ""
+	_path = records.path.get_base_dir().path_join("economy/"+scope.sha256_text()+".json")
+	if authenticated():
+		var cached: Dictionary = IO.read(_path,65536)
+		if cached.has("_read_error"):
+			_storage_ok = false
+			status = "Coin purchase recovery could not be read. Check storage."
+		elif not cached.is_empty():
+			if Shop.valid_wallet(cached.get("wallet")): wallet = cached.wallet
+			var saved: Variant = cached.get("pending",{})
+			if saved is Dictionary and (saved.is_empty() or (saved.size() == 3 and saved.get("item_id") is String and Shop.items().has(saved.item_id) and saved.get("key") is String and saved.key.length() >= 8 and saved.key.length() <= 128 and Shop.whole(saved.get("expected_price"),1000000) and saved.expected_price > 0)):
+				pending = saved
+			else:
+				_storage_ok = false
+				status = "Coin purchase recovery could not be read. Check storage."
+	changed.emit()
+
+func balance() -> int:
+	return int(wallet.get("balance",0)) if authenticated() else int(_guest().balance)
+
+func _guest() -> Dictionary:
+	return records.settings.get("guest_coins",{"version":1,"balance":0,"owned":[],"sequence":0}).duplicate(true)
+
+func owns(id: String) -> bool:
+	if Shop.free_item(id) or id in records.settings.get("cosmetic_legacy",[]): return true
+	return id in (wallet.get("owned",[]) if authenticated() else _guest().owned)
+
+func price(id: String) -> int:
+	return int(wallet.get("prices",{}).get(id,Shop.items().get(id,0))) if authenticated() else int(Shop.items().get(id,0))
+
+func caption(id: String) -> String:
+	return "Free" if Shop.free_item(id) else "Owned" if owns(id) else "%d coins" % price(id)
+
+func erase_account(origin: String, player_id: String) -> bool:
+	var path: String = records.path.get_base_dir().path_join("economy/"+(origin+"/"+player_id).sha256_text()+".json")
+	var ok: bool = true
+	for suffix: String in ["",".tmp"]:
+		if FileAccess.file_exists(path+suffix) and DirAccess.remove_absolute(path+suffix) != OK: ok = false
+	return ok
+
+func _persist() -> bool:
+	return _storage_ok and IO.write(_path,{"wallet":wallet,"pending":pending},65536)
+
+func _accept(value: Variant) -> bool:
+	if not Shop.valid_wallet(value): return false
+	if wallet.is_empty() or int(value.revision) >= int(wallet.revision): wallet = value.duplicate(true)
+	return true
+
+func refresh() -> void:
+	sync_identity()
+	if not authenticated() or refreshing or busy: return
+	var expected: String = scope
+	var epoch: int = _epoch
+	refreshing = true
+	var response: Dictionary = await client.request_api("/economy",HTTPClient.METHOD_GET,{},"",true)
+	if _current_scope() != expected or epoch != _epoch: return
+	refreshing = false
+	if response.ok and _accept(response.data):
+		status = ""
+		if not _persist(): status = "Coin balance is online. Local recovery could not be saved."
+	elif response.get("status",0) == 404:
+		status = "Coin shop needs a server update."
+	else: status = "Could not refresh coins. Reconnect to buy."
+	changed.emit()
+	if not pending.is_empty() and _storage_ok: await _send_purchase()
+
+func purchase(id: String) -> bool:
+	sync_identity()
+	if busy or not Shop.items().has(id): return false
+	if owns(id): return true
+	if not authenticated():
+		var guest: Dictionary = _guest()
+		if int(guest.balance) < price(id):
+			status = "Not enough coins. Complete more races."
+			changed.emit()
+			return false
+		guest.balance = int(guest.balance)-price(id)
+		guest.owned.append(id)
+		records.settings.guest_coins = guest
+		var saved: bool = records.save_records() == OK
+		status = "" if saved else "Purchase could not be saved. No coins spent."
+		changed.emit()
+		return saved
+	if not pending.is_empty():
+		status = "Finishing your previous purchase."
+		changed.emit()
+		return false
+	pending = {"item_id":id,"key":client.new_operation_key(),"expected_price":price(id)}
+	if not _persist():
+		pending = {}
+		status = "Purchase could not be saved. No coins spent."
+		changed.emit()
+		return false
+	return await _send_purchase()
+
+func _send_purchase() -> bool:
+	if busy or pending.is_empty() or not authenticated(): return false
+	var expected: String = scope
+	var epoch: int = _epoch
+	var operation: Dictionary = pending.duplicate(true)
+	busy = true
+	status = "Completing purchase…"
+	changed.emit()
+	var response: Dictionary = await client.request_api("/economy/purchases",HTTPClient.METHOD_POST,{"item_id":operation.item_id,"expected_price":operation.expected_price},operation.key,true)
+	if _current_scope() != expected or epoch != _epoch: return false
+	busy = false
+	var success: bool = response.ok and response.data.get("item_id") == operation.item_id and _accept(response.data.get("wallet"))
+	if success:
+		pending = {}
+		status = "Purchased."
+	elif int(response.get("status",0)) in [400,401,403,404,410,422] or str(response.get("error","")) in ["INSUFFICIENT_COINS","COSMETIC_PRICE_CHANGED"]:
+		pending = {}
+		status = "Not enough coins. Complete more races." if str(response.get("error","")) == "INSUFFICIENT_COINS" else "Purchase unavailable. Refresh and try again."
+		if str(response.get("error","")) == "COSMETIC_PRICE_CHANGED": status = "Price changed. Refresh coins before buying."
+	else: status = "Purchase pending. We’ll retry automatically."
+	if not _persist(): status = "Purchase recovery could not be saved. Reconnect to check ownership."
+	changed.emit()
+	if str(response.get("error","")) in ["INSUFFICIENT_COINS","COSMETIC_PRICE_CHANGED"]: refresh.call_deferred()
+	return success
+
+func next_guest_sequence() -> int:
+	return int(_guest().sequence)+1
+
+func award_guest(sequence: int, facts: Dictionary, commit: bool = true) -> Dictionary:
+	if authenticated() or sequence <= 0 or not facts.get("complete",false): return {}
+	var guest: Dictionary = _guest()
+	if sequence <= int(guest.sequence): return {"status":"credited","amount":0,"rows":[]}
+	if sequence != int(guest.sequence)+1: return {}
+	var rows: Array[Dictionary] = RaceRewardPreview.build(facts)
+	var amount: int = mini(RaceRewardPreview.total(rows),Shop.MAX_COINS-int(guest.balance))
+	if amount != RaceRewardPreview.total(rows):
+		rows = [RaceRewardPreview.row("Wallet capacity",amount,"Credited",true,"coin")]
+	guest.balance = int(guest.balance)+amount
+	guest.sequence = sequence
+	records.settings.guest_coins = guest
+	if facts.get("track_id") is String:
+		var raced: Array = records.settings.get("raced_tracks",[]).duplicate()
+		if facts.track_id not in raced: raced.append(facts.track_id)
+		records.settings.raced_tracks = raced
+	# The real results flow commits staged coins together with its PB/history.
+	if not commit: return {"status":"staged","amount":amount,"rows":rows}
+	if records.save_records() != OK:
+		status = "Rewards could not be saved. Check storage."
+		changed.emit()
+		return {"status":"save_failed","amount":0,"rows":[]}
+	status = ""
+	changed.emit()
+	return {"status":"credited","amount":amount,"rows":rows}
+
+func reward_for(ticket: String) -> Dictionary:
+	if not authenticated() or ticket.is_empty(): return {"status":"unavailable","amount":0,"rows":[]}
+	var expected: String = _current_scope()
+	var epoch: int = _epoch
+	var response: Dictionary = await client.request_api("/economy/rewards/"+ticket,HTTPClient.METHOD_GET,{},"",true)
+	if _current_scope() != expected or epoch != _epoch: return {"status":"unavailable","amount":0,"rows":[]}
+	if response.ok:
+		if response.data.get("status") == "credited": refresh()
+		return response.data
+	if int(response.get("status",0)) in [401,403,404,410]: return {"status":"unavailable","amount":0,"rows":[]}
+	return {"status":"pending","amount":0,"rows":[]}
diff --git a/game/persistence/cosmetic_catalog.gd b/game/persistence/cosmetic_catalog.gd
