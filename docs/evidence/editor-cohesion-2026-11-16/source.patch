+		if selected and app.canvas.object_indices().size() > 1: title.text = GameText.message("Objects")
+		app.editor_status.text = GameText.message("Select") if app.canvas.mode == "objects" else GameText.message("Place")
+	if category == "objects":
+		app.object_controls_panel.get_parent().move_child(app.object_controls_panel,0)
+		for button: Button in app.editor_context.get_children():
+			if button.text == "Palette": button.hide()
+			else:
+				button.custom_minimum_size = Vector2(64,68)
+				EditorStyle.quiet(button)
+	elif category == "paint":
+		for button: Button in app.editor_context.get_children():
+			button.custom_minimum_size = Vector2(68,68)
+			EditorStyle.quiet(button,button.button_pressed)
