+static func arrange(app: Node) -> void:
+	if not is_instance_valid(app) or not is_instance_valid(app.canvas) or not is_instance_valid(app.root_ui): return
+	var overlay: Control = app.root_ui.find_child("EditorOverlay",true,false)
+	var dock: PanelContainer = app.root_ui.find_child("EditorToolDock",true,false)
+	var header: PanelContainer = app.root_ui.find_child("EditorTopBar",true,false)
+	if overlay == null or dock == null or header == null: return
+	var height: float = dock.get_combined_minimum_size().y
+	dock.offset_top = -12-height
+	var body: Control = dock.find_child("EditorDockBody",true,false)
+	var available: float = maxf(200,overlay.size.x-164)
+	if app.editor_palette.visible:
+		var scroll: ScrollContainer = app.editor_context.get_parent()
+		var width: float = 0
+		for child: Control in app.editor_context.get_children():
+			if child.visible: width += child.get_combined_minimum_size().x+6
+		var other: float = app.surface_toolbar.get_combined_minimum_size().x+12 if app.surface_toolbar.visible else app.object_controls_panel.get_combined_minimum_size().x+12 if app.object_controls_panel.visible else 0.0
+		scroll.custom_minimum_size.x = minf(width,maxf(140,available-other))
+		app.editor_palette.size_flags_horizontal = Control.SIZE_FILL if other > 0 else Control.SIZE_EXPAND_FILL
+	var identity: Control = app.root_ui.find_child("EditorIdentityAndHistory",true,false)
+	var name_label: Label = identity.find_child("TrackName",true,false)
+	var row: HBoxContainer = header.get_child(0)
+	var other_width: float = 0
+	for child: Control in row.get_children():
+		if child != identity and child.visible: other_width += child.get_combined_minimum_size().x+8
+	name_label.custom_minimum_size.x = clampf(header.size.x-other_width-88,72,180)
+	# Keep the same dock width and alignment across tools and selections.
+	body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	app.canvas.queue_redraw()
