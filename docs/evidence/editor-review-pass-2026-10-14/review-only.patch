+    "shared_host": true,
+    "phone_test_performed": false
+  },
+  "findings": [
+    {
+      "id": "EDR01",
+      "severity": "P1",
+      "area": "Save ordering and recovery",
+      "source": "game/core/app.gd:2680",
+      "related_sources": [
+        "game/core/app.gd:2644",
+        "game/editor/write_queue.gd:8",
+        "game/core/app.gd:3644"
+      ],
+      "finding": "The unchanged-WIP fast path does not supersede an older pending write. After moving an object away and back to the durable position before autosave completes, the old queued revision can overwrite WIP. Its receipt is ignored because it differs from the current document. The UI says Saved on device, exit sees no changes, and Load track restores the wrong position.",
+      "reproduction": "Actual isolated app: save a container at [0,0]; finish a move to [2,0] with the writer still queued; finish a return to [0,0] before advancing a frame; invoke the actual editor exit. Both renderers show queued=1, unsaved=false, save_error=OK and reopen [2,0]. The committed original remains [0,0].",
+      "recommendation": "Order the unchanged fast path against pending/active revisions. Remove or supersede stale queued revisions, and ensure any active write is followed by the desired final revision before acknowledging exit. Add both queued and already-running return-to-saved coverage."
+    },
+    {
+      "id": "EDR02",
+      "severity": "P2",
+      "area": "Populate cancellation",
+      "source": "game/editor/population_job.gd:16",
+      "related_sources": [
+        "game/editor/object_population_panel.gd:113",
+        "game/editor/track_compiler.gd:13"
+      ],
+      "finding": "The population job calls TrackCompiler.compile(candidate) without its cancellation callback. Closing or changing Populate during compilation discards the result only after the full compiler finishes. The panel waits for that obsolete job before starting its next preview.",
+      "reproduction": "A timed token expires 1ms after generation, immediately before the actual 96-piece Winter compile. The population wrapper checks it only before and after compilation: 524.623ms Compatibility / 535.863ms Mobile. The same compiler with the callback returns null in 6.603 / 6.268ms.",
+      "recommendation": "Pass the existing cancellation callback through the compiler and other long population preparation loops; clear retained cancellation references on all exits. Verify cancellation inside real preparation, rather than only with the existing synthetic waiting worker."
+    },
+    {
+      "id": "EDR03",
+      "severity": "P2",
+      "area": "Draft detail refresh",
+      "source": "game/ui/draft_browser.gd:143",
+      "related_sources": [
+        "game/ui/draft_browser.gd:178",
+        "game/ui/draft_browser.gd:195",
+        "game/ui/draft_browser.gd:202",
+        "game/ui/draft_browser.gd:204",
+        "game/backend/cloud_tracks.gd:173"
+      ],
+      "finding": "The gallery scan is off-thread, but every detail refresh reloads/restores the complete selected document and separately reads the same workflow for caption, publish availability, retry and revision-conflict status. Searching, selecting cards and resizing trigger this on the UI thread. A disabled publication can add a fifth status read.",
+      "reproduction": "A supported 16384-point map and its 252KB local workflow, normalized to the actual persisted JSON number representation: five warm detail refreshes each perform four existing workflow reads/parses; median 43.824ms Compatibility / 45.800ms Mobile. These timings include full document restore, fingerprints and control reconstruction; they are not attribution solely to JSON parsing.",
+      "recommendation": "Use the selected summary for presentation and load full documents only for actions that require them. Read lifecycle status once per refresh, reuse its derived fields, and retain verified immutable status data without accepting stale workflow updates."
+    },
+    {
+      "id": "EDR04",
+      "severity": "P2",
+      "area": "Prop cache GPU readback",
+      "source": "game/editor/placed_object_batches.gd:215",
+      "related_sources": [
+        "game/track/native_track_visual.gd:1433",
+        "game/track/native_track_visual.gd:1447"
+      ],
+      "finding": "get_meta(editor_prop_arrays, mesh.surface_get_arrays(0)) evaluates the default argument eagerly. Even props with retained pre-upload arrays read back their just-uploaded mesh when preparing a new pose/model. This bypasses the intended CPU-array reuse.",
+      "reproduction": "Isolated actual 12863-vertex container mesh; five samples of 96 accesses. Median eager expression 27.032ms Compatibility / 73.836ms Mobile, versus retained metadata alone 0.023 / 0.025ms. This is a component benchmark, not a full-placement or frame-rate measurement.",
+      "recommendation": "Branch on has_meta before calling surface_get_arrays, retaining the exact original pre-upload arrays. Where applicable, avoid uploading temporary baked prototype meshes just to recover their CPU geometry."
+    }
+  ],
+  "measurements": {
