+	paint_points.clear()
+	pending_stamp = false
+	dragging = false
+	panning = false
+	active_pointer = -99
+	touches.clear()
+	desktop_pan = false
+	pending_road_tap = false
+	pending_piece_accept = false
+	start_drag = false
+	pending_start_flip = false
+	bump_end_drag = -1
