+				pending_piece_accept = false
+				pending_start_flip = false
+				start_drag = false
+				pending_paint_accept = false
+				paint_handle = -1
+				drawing_run=false
+				run_draw.clear()
+				run_preview.clear()
+				if paint_mode == "free": paint_points.clear()
+				elif mode == "paint": paint_points = paint_before_gesture.duplicate(true)
+				pending_stamp = false
+				dragging = false
+		else:
