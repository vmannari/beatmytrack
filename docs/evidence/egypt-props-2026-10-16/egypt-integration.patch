+func captures() -> void:
+	root.size=Vector2i(1600,900); root.content_scale_size=root.size
+	var buttons := Control.new(); root.add_child(buttons)
+	for i: int in range(PropEgypt.KINDS.size()):
+		var kind: String=PropEgypt.KINDS[i]
