+</style>
+<h1>Electric: whole-car design pass</h1>
+<p>A curved canopy, a broader clean-tapered bonnet, integrated rear surfaces, fitted glazing and panel reveals, crisper wheels and flatter mirrors. <a href="../../ELECTRIC_DESIGN_PASS_2026_10_26.md">Changes, verification and limits</a>.</p>
+<div class="controls">
+<label>View<select id="view"><option value="front-quarter">Front three-quarter</option><option value="side">Side</option><option value="front">Front</option><option value="rear-quarter">Rear three-quarter</option><option value="rear">Rear</option><option value="top">Top</option><option value="bonnet">Bonnet</option><option value="roof">Roof and glazing</option><option value="wheel">Wheel</option><option value="tail-detail">Rear detail</option><option value="production-camera-studio">Default racing camera over studio</option></select></label>
+<label>Detail<select id="detail"><option value="full">Full</option><option value="simple">Simple</option></select></label>
+<label>Renderer<select id="renderer"><option value="native">Compatibility</option><option value="desktop-mobile">Mobile on desktop Vulkan</option></select></label>
+</div>
+<div class="compare"><img id="before" src="before-native/full-front-quarter.png" alt="Before: original electric car"><img id="after" class="after" src="native/full-front-quarter.png" alt="After: revised electric car"><div id="divider" class="divider"></div><span class="badge left">After · v11</span><span class="badge right">Before · v10</span></div>
+<label class="slider">Reveal the revision<input id="reveal" type="range" min="0" max="100" value="50" aria-label="Amount of after image visible"></label>
+<p><small>Matched neutral-grey studio views. Drag the slider or use its arrow keys. The production-camera option uses the unchanged camera profile over the diagnostic studio, not an actual race scene. “Mobile” here identifies the desktop renderer; it is not a device test.</small></p>
+<div class="grid"><figure><a id="before-link" href="before-native/full-front-quarter.png"><img id="before-whole" src="before-native/full-front-quarter.png" alt="Complete before view"></a><figcaption>Before · source-matched task-start model</figcaption></figure><figure><a id="after-link" href="native/full-front-quarter.png"><img id="after-whole" src="native/full-front-quarter.png" alt="Complete revised view"></a><figcaption>After · revised model, same pose and paint</figcaption></figure></div>
+<p><a href="app-native/garage-1280.png">Actual Garage</a> · <a href="app-native/race.png">Actual gameplay</a> · <a href="acceptance/test_electric_model/electric-headlights.png">Headlights</a> · <a href="report.json">Commands and evidence</a> · <a href="../electric-design-review-2026-10-26/comparison.html">Original EV comparison review</a></p>
+<p><small>Fictional vehicle, original authored game geometry. Reference manufacturers remain design references outside the game assets. Reload the project/game to see the new prepared model in an existing session.</small></p>
+<script>
+const $=id=>document.getElementById(id);
+function update(){const suffix=$('detail').value+'-'+$('view').value+'.png';const before='before-'+$('renderer').value+'/'+suffix;const after=$('renderer').value+'/'+suffix;for(const id of ['before','before-whole'])$(id).src=before;for(const id of ['after','after-whole'])$(id).src=after;$('before-link').href=before;$('after-link').href=after;}
+for(const id of ['view','detail','renderer'])$(id).addEventListener('change',update);
+$('reveal').addEventListener('input',()=>{const value=Number($('reveal').value);$('after').style.clipPath='inset(0 '+(100-value)+'% 0 0)';$('divider').style.left=value+'%';});
+update();
+</script></html>
diff --git a/docs/evidence/electric-design-pass-2026-10-26/build_checkpoint.py b/docs/evidence/electric-design-pass-2026-10-26/build_checkpoint.py
new file mode 100644
index 0000000..e849d6c
--- /dev/null
+++ b/docs/evidence/electric-design-pass-2026-10-26/build_checkpoint.py
@@ -0,0 +1,111 @@
+"""Freeze only this design pass and verify its binary patch outside the repository.
+
+Uses retained task-start/at-edit snapshots; never stages or changes the Git index.
+Run after report.json and the scoped root-document entries are complete.
+"""
+from pathlib import Path
+import hashlib
+import json
+import shutil
+import subprocess
+import tempfile
+
+EVIDENCE = Path(__file__).resolve().parent
+ROOT = EVIDENCE.parents[2]
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def relative(path):
+    return path.relative_to(ROOT).as_posix()
+
+
+def run(*args, cwd):
+    return subprocess.run(args, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def main():
+    runtime = ["electric_coachwork.gd", "electric_car_model.gd", "electric_glass.gdshader"]
+    fixtures = ["test_electric_model.gd", "test_electric_surface_finish.gd", "test_racing_car_models.gd", "test_electric_car_ui.gd", "bake_garage_cars.gd"]
+    helpers = ["test_electric_design_pass.gd", "bake_electric_design_shadows.gd", "bake_electric_design_art.gd", "probe_electric_design_hood.gd", "probe_electric_panel_reveal.gd", "probe_electric_shadow_frames.gd", "probe_electric_glass_colour.gd"]
+    paths = [ROOT / "game/vehicle" / n for n in runtime]
+    paths += [ROOT / "game/tests" / n for n in fixtures + helpers]
+    paths += [ROOT / "game/tests" / (n + ".uid") for n in helpers]
+    paths += list((ROOT / "game/assets/vehicles/electric_coachwork_v11").glob("*"))
+    paths += [ROOT / f"game/assets/vehicles/racing_simple_v1/electric_shadow_{i}.res" for i in range(5)]
+    paths += [ROOT / "game/assets/vehicles/racing_simple_v1/manifest.json"]
+    paths += [ROOT / n for n in ["game/assets/menu/electric_illustration_v1.png", "game/assets/news/vehicles/electric.png", "game/assets/menu/header_cars_v1/electric.png", "game/assets/garage/previews_v1/electric.png", "game/assets/garage/previews_v1/provenance.json", "game/assets/garage/cars_v1/electric.scn"]]
+    paths += list((ROOT / "game/assets/liveries/previews_v2/electric").glob("*.png"))
+    # Import descriptors did not change; new UID sidecars above are included.
+    paths += [ROOT / "docs/ELECTRIC_DESIGN_PASS_2026_10_26.md", ROOT / "AGENTS.md", ROOT / "DEVELOPMENT_STATUS.md"]
+    # Retain the evidence next to this independent checkpoint. A compact runtime
+    # patch avoids embedding hundreds of before/draft PNGs and old source copies.
+    for n in ["report.json", "before-after.html", "commands.json", "build_checkpoint.py", "source-comparison.json", "asset-verification.json", "glass-colour-comparison.json", "glass-colour-delta.json", "app-fixture-patch-context.json"]:
+        paths.append(EVIDENCE / n)
+    selected = sorted(set(p for p in paths if p.is_file()))
+    assert len(selected) > 900
+    excluded = {"game/vehicle/car_visual.gd", "game/vehicle/vehicle_simulation.gd", "game/resources/cars/electric.tres"}
+    assert excluded.isdisjoint(relative(p) for p in selected)
+    # Root docs and the shared App fixture use at-edit contexts, preserving
+    # concurrent additions already present when this task edited those files.
+    def baseline(p):
+        n = relative(p)
+        for directory in ["before-docs", "before-at-final-integration", "before"]:
+            candidate = EVIDENCE / directory / n
+            if candidate.is_file():
+                return candidate
+        return None
+
+    index_before = run("git", "diff", "--cached", "--binary", cwd=ROOT)
+    assert index_before.returncode == 0
+    with tempfile.TemporaryDirectory(prefix="bmt-edp-checkpoint-") as temporary:
+        work = Path(temporary).resolve()
+        # TemporaryDirectory's eventual recursive cleanup is constrained here.
+        assert work.parent == Path(tempfile.gettempdir()).resolve()
+        assert work.name.startswith("bmt-edp-checkpoint-")
+        before, after, applied = [work / n for n in ["before", "after", "applied"]]
+        for folder in [before, after, applied]:
+            folder.mkdir()
+        changed = []
+        for p in selected:
+            n = relative(p)
+            old = baseline(p)
+            final = EVIDENCE / "after-docs" / n if n in ["AGENTS.md", "DEVELOPMENT_STATUS.md"] else p
+            if old is not None and old.read_bytes() == final.read_bytes():
+                continue
+            for tree, source in [(before, old), (after, final), (applied, old)]:
+                if source is not None:
+                    target = tree / n
+                    target.parent.mkdir(parents=True, exist_ok=True)
+                    shutil.copyfile(source, target)
+            changed.append({"path": n, "before_sha256": sha(old) if old else None, "after_sha256": sha(final)})
+        diff = run("git", "-c", "core.autocrlf=false", "diff", "--no-index", "--binary", "--", "before", "after", cwd=work)
+        assert diff.returncode == 1, diff.stderr.decode(errors="replace")
+        lines = []
+        for line in diff.stdout.splitlines(keepends=True):
+            if line.startswith((b"diff --git ", b"--- ", b"+++ ")):
+                for prefix in [b"a/before/", b"a/after/", b"b/before/", b"b/after/"]:
+                    line = line.replace(prefix, prefix[:2])
+            lines.append(line)
+        patch = b"".join(lines)
+        patch_path = EVIDENCE / "task-only.patch"
+        patch_path.write_bytes(patch)
+        checked = run("git", "-c", "core.autocrlf=false", "apply", "--check", str(patch_path), cwd=applied)
+        assert checked.returncode == 0, checked.stderr.decode(errors="replace")
+        result = run("git", "-c", "core.autocrlf=false", "apply", str(patch_path), cwd=applied)
+        assert result.returncode == 0, result.stderr.decode(errors="replace")
+        for item in changed:
+            assert sha(applied / item["path"]) == item["after_sha256"], item["path"]
+        index_after = run("git", "diff", "--cached", "--binary", cwd=ROOT)
+        assert index_after.returncode == 0 and index_before.stdout == index_after.stdout
+        record = {"patch": "task-only.patch", "patch_sha256": sha(patch_path), "patch_bytes": len(patch), "changed_files": len(changed), "git_apply_check": 0, "git_apply": 0, "byte_exact_files": len(changed), "shared_index_unchanged": True, "staged_committed_reset": False, "evidence_note": "Native before/after views, original snapshots and intermediate failures remain adjacent to the patch; they are inventoried in evidence-hashes.json and not embedded as binary patch additions.", "files": changed}
+        (EVIDENCE / "checkpoint.json").write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
+    inventory = {p.relative_to(EVIDENCE).as_posix(): sha(p) for p in sorted(EVIDENCE.rglob("*")) if p.is_file() and p.name != "evidence-hashes.json" and "__pycache__" not in p.parts}
+    (EVIDENCE / "evidence-hashes.json").write_text(json.dumps(inventory, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({k: v for k, v in record.items() if k != "files"}))
+
+
+if __name__ == "__main__":
+    main()
