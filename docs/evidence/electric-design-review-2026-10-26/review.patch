+$('reference-image').src='references/'+ref;$('reference-image').alt='Official reference: '+name;$('reference-link').href='references/'+ref;$('reference-caption').textContent=name;
+const source=ref.startsWith('lucid')?lucid:ref.startsWith('taycan')?porsche:hyundai;
+$('credit').replaceChildren(document.createTextNode('Manufacturer reference · '));const link=document.createElement('a');link.href=source;link.textContent='Official source';$('credit').append(link);
+}
+for(const id of ['renderer','detail','view','reference'])$(id).addEventListener('change',update);
+update();
+</script>
