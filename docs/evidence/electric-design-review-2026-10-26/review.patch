+<label>Reference<select id="reference"><option value="lucid-air-front.webp">Lucid Air — front three-quarter</option><option value="lucid-air-street.webp">Lucid Air — road view</option><option value="lucid-air-dimensions.svg">Lucid Air — dimension drawings</option><option value="taycan-side.webp">Porsche Taycan — side</option><option value="ioniq6-1.jpg">Hyundai IONIQ 6 — front</option><option value="ioniq6-3.jpg">Hyundai IONIQ 6 — rear</option></select></label>
