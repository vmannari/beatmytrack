diff --git a/game/vehicle/electric_reference_body.gd b/game/vehicle/electric_reference_body.gd
index dc68277..4b48404 100644
--- a/game/vehicle/electric_reference_body.gd
+++ b/game/vehicle/electric_reference_body.gd
@@ -10,7 +10,12 @@ static func blend(a: float,b: float,t: float) -> float:
 	return lerpf(a,b,smoothstep(0.0,1.0,clampf(t,0.0,1.0)))
 
 static func shoulder(z: float) -> float:
-	if z < -0.90: return blend(0.75,0.97,(z+2.25)/1.35)
+	if z < -0.90:
+		# A continuous convex fall from the cowl instead of a swollen rear
+		# hump and a flat shelf where the old S-shaped shoulder met the nose.
+		var d: float=z+0.90
+		var curve: float=(0.97-0.035*1.35-0.790)/(1.35*1.35)
+		return 0.97+0.035*d-curve*d*d
 	if z < 1.70: return lerpf(0.97,0.93,(z+0.90)/2.60)
 	return blend(0.93,0.89,(z-1.70)/0.50)
 
@@ -57,10 +62,12 @@ static func hood_point(u: float,v: float) -> Vector3:
 	# Form the soft, swept shoulders in the metal rather than drawing dark
 	# stripes on a flat surface. The bonnet closes exactly to the nose cap.
 	var envelope: float=pow(sin(PI*v),2)
-	var ridge: float=0.018*exp(-pow((absf(a)-lerpf(0.55,0.72,v))/0.23,2))*envelope
-	var valley: float=0.004*exp(-pow((absf(a)-lerpf(0.37,0.54,v))/0.18,2))*envelope
-	var crown: float=lerpf(0.090,0.030,smoothstep(0.65,1.0,v))
-	return Vector3(a*top_width(z),shoulder(z)+crown*sqrt(maxf(0.0,1.0-a*a))+ridge-valley,z)
+	var ridge: float=0.024*exp(-pow((absf(a)-lerpf(0.55,0.72,v))/0.16,2))*envelope
+	var valley: float=0.006*exp(-pow((absf(a)-lerpf(0.37,0.54,v))/0.14,2))*envelope
+	# Restrained centre crown and defined shoulders. The quadratic transverse
+	# section also follows the windshield foot without pinched outer corners.
+	var crown: float=lerpf(0.038,0.030,v)
+	return Vector3(a*top_width(z),shoulder(z)+crown*(1.0-a*a)+ridge-valley,z)
 
 static func deck_point(u: float,v: float) -> Vector3:
 	var a: float=2.0*u-1.0
