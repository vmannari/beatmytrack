+++ b/docs/evidence/electric-low-speed-steering-2026-10-25/before/game__tests__test_electric_car_ui.gd.txt
@@ -0,0 +1,175 @@
+extends SceneTree
+## Actual Garage selection, save/reload, runtime race and native review images.
+var checks: int = 0
+var failures: int = 0
+const OUTPUT: String = "res://../docs/evidence/electric-car-2026-10-25/native"
+var output: String = OUTPUT
+
+func _initialize() -> void: run.call_deferred()
+
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		print("FAIL: "+label)
+
+func settle(count: int = 12) -> void:
+	for tick: int in range(count):
+		await process_frame
+		if DisplayServer.get_name() != "headless": await RenderingServer.frame_post_draw
+
+func capture(label: String) -> void:
+	if DisplayServer.get_name() == "headless": return
+	check(root.get_texture().get_image().save_png(output.path_join(label+".png")) == OK,"native capture "+label)
+
+func click(button: Button) -> void:
+	for down: bool in [true,false]:
+		var event := InputEventMouseButton.new()
+		event.position = button.get_global_rect().get_center()
+		event.button_index = MOUSE_BUTTON_LEFT
+		event.pressed = down
+		Input.parse_input_event(event)
+		await settle(2)
+
+func tap(button: Button) -> void:
+	for down: bool in [true,false]:
+		var event := InputEventScreenTouch.new()
+		event.index = 7
+		event.position = button.get_global_rect().get_center()
+		event.pressed = down
+		Input.parse_input_event(event)
+		await settle(2)
+
+func run() -> void:
+	OS.set_environment("BMT_API_URL","")
+	for argument: String in OS.get_cmdline_user_args():
+		if argument.begins_with("--evidence-root="): output = argument.trim_prefix("--evidence-root=")
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output))
+	root.size = Vector2i(1280,720)
+	if "--bake-art" in OS.get_cmdline_user_args():
