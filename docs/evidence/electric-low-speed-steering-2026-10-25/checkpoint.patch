+	front_recess(car,"ContinuousLightbarPocket",-0.90,0.90,0.754,0.804,0.030,trim)
+	patch(car.body,"ContinuousFrontLightbar",96,6,func(u: float,v: float) -> Vector3:
+		return lightbar_point(u,v),running_light,Vector3.FORWARD,car.simple_model)
+	for side: float in [-1.0,1.0]:
+		front_recess(car,"AirCurtain"+str(side),minf(side*0.90,side*0.96),maxf(side*0.90,side*0.96),0.35,0.57,0.06,trim)
