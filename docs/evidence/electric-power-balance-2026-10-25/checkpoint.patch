+static func side_surface(side: float, u: float, v: float) -> Vector3:
+	var y: float = side_level(v,lerpf(-2.13,2.09,u))
+	var z: float = side_station(u,y)
+	y = side_level(v,z)
+	z = side_station(u,y)
