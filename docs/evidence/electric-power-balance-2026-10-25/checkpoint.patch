+static func side_station(u: float, y: float) -> float:
+	var lead: float = lerpf(-0.74,-0.86,clampf((y-0.43)/0.55,0,1))
+	var stations: Array[float] = [-2.13,-1.90,-1.80,-1.65,-1.4,-1.2,-1.0,lead-0.018,lead-0.006,lead-0.003,lead,lead+0.003,lead+0.006,lead+0.018,0.242,0.254,0.257,0.26,0.263,0.266,0.278,0.932,0.944,0.947,0.95,0.953,0.956,0.968,1.10,1.3,1.5,1.7,1.9,2.09]
+	var t: float = u*(stations.size()-1)
+	var index: int = mini(floori(t),stations.size()-2)
+	return lerpf(stations[index],stations[index+1],t-index)
