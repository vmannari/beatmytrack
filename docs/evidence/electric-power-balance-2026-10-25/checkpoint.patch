+static func side_point(side: float, z: float, y: float, offset: float = 0.0) -> Vector3:
+	return Vector3(side*(width(y,z)+offset),y,z)
+
+static func hood_point(u: float, v: float) -> Vector3:
+	var across: float = lerpf(-1,1,u)
+	var front_y: float = nose_top(across)
+	var front_x: float = across*width(front_y,-2.13)
+	var front: Vector3 = Vector3(front_x,front_y,front_z(front_x,front_y))
+	var z: float = lerpf(front.z,-0.94,v)
+	var y: float = upper(z)+0.018*(1-across*across)
+	y += 0.012*smoothstep(0.42,0.58,absf(across))*(1-smoothstep(0.78,0.94,absf(across)))*sin(v*PI)
+	var at_front: float = 1-smoothstep(0,0.22,v)
+	y += (front.y-upper(front.z)-0.018*(1-across*across))*at_front
+	var x: float = across*width(upper(z),z)+(front.x-across*width(upper(front.z),front.z))*at_front
+	return Vector3(x,y,z)
