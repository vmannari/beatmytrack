+"""Pinned offline Godot checks with task-owned logs and evidence destinations."""
+from pathlib import Path
+import json
+import re
+import subprocess
+import sys
+
+PHASE = next((arg.split('=', 1)[1] for arg in sys.argv[1:] if arg.startswith('--phase=')), '')
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+GODOT = Path('C:/apps/Godot 4.7.2/Godot_v4.7.2-stable_win64_console.exe')
+DEFAULTS = ['electric_regen', 'electric_brake_release', 'electric_one_pedal',
+            'electric_190', 'electric_car', 'electric_character', 'electric_slide_access',
+            'electric_power', 'electric_power_balance', 'electric_powered_drift',
+            'electric_launch_drift', 'electric_held_authority', 'electric_low_speed_steering',
+            'electric_steering_response', 'electric_turning', 'electric_turn_radius',
+            'electric_corner_authority', 'electric_consistent_handling',
+            'electric_normal_tracks', 'handling', 'rewind', 'script_parse']
+
+
+def run(name):
+    destination = (OUT / PHASE / name) if PHASE else (OUT / name)
+    destination.mkdir(parents=True, exist_ok=True)
+    command = [str(GODOT), '--headless', '--path', str(ROOT / 'game'),
+               '--log-file', str(destination / 'engine.log'), '--script',
+               f'res://tests/test_{name}.gd', '--', f'--evidence-root={destination.as_posix()}']
+    try:
+        result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, timeout=240)
+        log = result.stdout + result.stderr
+        (destination / 'console.log').write_text(log, encoding='utf-8')
+        summaries = [line for line in log.splitlines() if re.search(r'checks|assertions|failures|SCRIPT ERROR|FAIL:|Parse Error', line)]
+        errors = [line for line in log.splitlines() if 'ERROR:' in line or 'WARNING:' in line]
+        receipt = {'name': name, 'command': command, 'exit_code': result.returncode,
+                   'summaries': summaries, 'diagnostics': errors,
+                   'script_errors': len(re.findall(r'SCRIPT ERROR:|Parse Error:', log))}
+    except subprocess.TimeoutExpired:
+        receipt = {'name': name, 'command': command, 'timeout_seconds': 240, 'exit_code': -1}
+    (destination / 'command.json').write_text(json.dumps(receipt, indent=2) + '\n')
+    # Long measurement rows remain in the log and per-suite JSON.
+    print(name, receipt['exit_code'], *(line[:240] for line in receipt.get('summaries', [])[-4:]), flush=True)
+    return receipt
+
+
+if __name__ == '__main__':
+    names = [arg for arg in sys.argv[1:] if not arg.startswith('--phase=')]
+    results = [run(name) for name in (names or DEFAULTS)]
+    (OUT / f'checks-{PHASE or "latest"}.json').write_text(json.dumps(results, indent=2) + '\n')
+    sys.exit(1 if any(r['exit_code'] or r.get('script_errors') for r in results) else 0)
diff --git a/docs/evidence/electric-regen-2026-10-27/verify_canonical.py b/docs/evidence/electric-regen-2026-10-27/verify_canonical.py
new file mode 100644
--- /dev/null
+++ b/docs/evidence/electric-regen-2026-10-27/verify_canonical.py
@@ -0,0 +1,45 @@
+"""Independently accept the recorded five-lap Electric19 race offline."""
+from pathlib import Path
+from types import SimpleNamespace
+import json
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+sys.path.insert(0, str(ROOT / 'backend'))
+from bmt_backend.runs import board_manifest
+from bmt_backend.track_models import digest
+from bmt_backend.verifier import GodotVerifier
+
+generated = json.loads((OUT / 'electric_over_under/over-under-race.json').read_text())
+assert generated['ok']
+race = generated['result']
+verifier = GodotVerifier(SimpleNamespace(
+    godot_bin=r'C:\apps\Godot 4.7.2\Godot_v4.7.2-stable_win64_console.exe',
+    game_project=ROOT / 'game', verifier_timeout_seconds=90))
+try:
+    result = verifier.verify_canonical_diagnostic(race['document'], race['replay'], 'electric')
+    assert result['time_ticks'] == race['time_ticks']
+    assert len(result['lap_ticks']) == 5
+    current = result['manifest']
+    assert current['physics_version'] == 'arcade-planar-0.75'
+    assert current['vehicles']['electric'] == {
+        'handling_version': 'electric-19',
+        'config_hash': '4a6003cae32137af7d3e64b714fa89d7be290259d78262f5749b0dac579dd4f0'}
+    old = json.loads((OUT / 'before/backend__tests__fixtures__verified_oval.json').read_text())['expected_manifest']
+    old['track_content_hash'] = current['track_content_hash']
+    assert old['physics_version'] == current['physics_version']
+    for car, values in old['vehicles'].items():
+        if car != 'electric':
+            assert current['vehicles'][car] == values
+        old_board = digest(board_manifest(SimpleNamespace(manifest=old), car))
+        new_board = digest(board_manifest(SimpleNamespace(manifest=current), car))
+        assert (old_board == new_board) == (car != 'electric'), car
+    receipt = {'input_count': len(race['replay']['frames']), 'time_ticks': result['time_ticks'],
+               'time_ms': result['time_ms'], 'lap_ticks': result['lap_ticks'],
+               'electric': current['vehicles']['electric'],
+               'six_other_car_boards_exact': True, 'electric_board_distinct': True}
+    (OUT / 'canonical-verification.json').write_text(json.dumps(receipt, indent=2) + '\n')
+    print(json.dumps(receipt))
+finally:
+    verifier.close()
