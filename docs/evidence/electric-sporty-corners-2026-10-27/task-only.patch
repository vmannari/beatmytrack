+static func cubic(a: float, b: float, c: float, d: float, t: float) -> float:
+	return pow(1-t,3)*a+3*pow(1-t,2)*t*b+3*(1-t)*t*t*c+t*t*t*d
+
+static func cubic_derivative(a: float, b: float, c: float, d: float, t: float) -> float:
+	return 3*pow(1-t,2)*(b-a)+6*(1-t)*t*(c-b)+3*t*t*(d-c)
+
+static func hermite(a: float, b: float, da: float, db: float, t: float) -> float:
+	return (2*t*t*t-3*t*t+1)*a+(t*t*t-2*t*t+t)*da+(-2*t*t*t+3*t*t)*b+(t*t*t-t*t)*db
+
+static func roof_width(t: float) -> float:
+	return lerpf(0.620,0.585,smoothstep(0,1,t))
+
+static func roof_edge(t: float) -> float:
+	return cubic(1.430,1.451,1.430,1.390,t)
+
+static func roof_crown(t: float) -> float:
+	return lerpf(0.045,0.085,t)
+
+static func canopy_z(rear: bool, v: float) -> float:
+	return cubic(1.70,1.48,1.08,0.80,v) if rear else cubic(-0.94,-0.76,-0.54,-0.27,v)
+
+static func canopy_top_tangent(u: float) -> float:
+	# Solve the side's endpoint derivative in the roof's actual tangent plane.
+	# Analytic derivatives avoid differentiating a numerically estimated normal
+	# again in the glass mesh, which otherwise amplifies float noise into ripples.
+	var gradient_x: float = -2*roof_crown(u)/roof_width(u)
+	var width_derivative: float = -0.035*6*u*(1-u)
+	var edge_derivative: float = cubic_derivative(1.430,1.451,1.430,1.390,u)
+	var gradient_z: float = (edge_derivative-gradient_x*width_derivative)/1.07
+	var dx: float = -(0.842-roof_width(u))*PI*0.5
+	var dz: float = lerpf(0.81,-0.84,u)
+	return gradient_x*dx+gradient_z*dz
+
+static func cabin_point(side: float, u: float, v: float) -> Vector3:
+	var z: float = lerpf(canopy_z(false,v),canopy_z(true,v),u)
+	var x: float = lerpf(0.842,roof_width(u),1-cos(v*PI*0.5))
+	var y: float = lerpf(raw_upper(z),roof_edge(u),sin(v*PI*0.5))+canopy_top_tangent(u)*(v-1)*v
+	return Vector3(side*x,y,z)
+
+static func screen_point(rear: bool, u: float, v: float) -> Vector3:
+	var across: float = lerpf(-1,1,u)
+	var t: float = 1.0 if rear else 0.0
+	var edge: Vector3 = cabin_point(1,t,v)
+	var gradient_z: float = (cubic_derivative(1.430,1.451,1.430,1.390,t)+0.040)/1.07
+	var centre_tangent: float = gradient_z*(-0.84 if rear else 0.81)
+	var crown: float = hermite(0.015 if rear else 0.018,roof_crown(t),0.045,centre_tangent-canopy_top_tangent(t),v)
+	return Vector3(across*edge.x,edge.y+crown*(1-across*across),edge.z)
+
+static func roof_point(u: float, v: float) -> Vector3:
+	var across: float = lerpf(-1,1,u)
+	return Vector3(across*roof_width(v),roof_edge(v)+roof_crown(v)*(1-across*across),lerpf(-0.27,0.80,v))
+
+static func sheet_normal(sample: Callable, u: float, v: float, hint: Vector3) -> Vector3:
+	var du: Vector3 = sample.call(minf(1,u+0.002),v)-sample.call(maxf(0,u-0.002),v)
+	var dv: Vector3 = sample.call(u,minf(1,v+0.002))-sample.call(u,maxf(0,v-0.002))
+	var n: Vector3 = du.cross(dv).normalized()
+	return -n if n.dot(hint)<0 else n
+
+static func sheet_frame(car: CarVisual, label: String, outer: Rect2, inner: Rect2, sample: Callable, material: Material, hint: Vector3, lift: float = 0, columns: int = 28, rows: int = 18) -> void:
+	# Four fitted borders leave an actual aperture. Avoid painting a complete
+	# second windscreen behind the glass, or a full opaque gasket beneath it.
+	for edge: int in range(4):
+		patch(car.body,label+str(edge),columns if edge%2 == 0 else rows,2,func(u: float,v: float) -> Vector3:
+			var a: Vector2 = rectangle_edge(outer,edge,u)
+			if outer != Rect2(0,0,1,1): a = rounded_uv(outer,a)
+			var b: Vector2 = rounded_uv(inner,rectangle_edge(inner,edge,u))
+			var uv: Vector2 = a.lerp(b,v)
+			return sample.call(uv.x,uv.y)+sheet_normal(sample,uv.x,uv.y,hint)*lift,material,hint,car.simple_model,Callable(),
+			func(u: float,v: float) -> Vector3:
+				var a: Vector2 = rectangle_edge(outer,edge,u)
+				if outer != Rect2(0,0,1,1): a = rounded_uv(outer,a)
+				var uv: Vector2 = a.lerp(rounded_uv(inner,rectangle_edge(inner,edge,u)),v)
+				return sheet_normal(sample,uv.x,uv.y,hint))
+
+static func rounded_uv(rect: Rect2, point: Vector2) -> Vector2:
+	var radius: float = minf(0.045,minf(rect.size.x,rect.size.y)*0.2)
+	var inner: Rect2 = rect.grow(-radius)
+	var closest: Vector2 = point.clamp(inner.position,inner.end)
+	var delta: Vector2 = point-closest
+	return closest+delta.normalized()*radius if delta.length_squared()>radius*radius else point
+
+static func side_window_uv(side: float, u: float, v: float) -> Vector2:
+	var level: float = lerpf(0.10,0.84,v)
+	var lead: Vector3 = cabin_point(side,0,level)
+	var tail: Vector3 = cabin_point(side,1,level)
+	return Vector2(lerpf(0.055,tail.z-lead.z-0.070,u)/(tail.z-lead.z),level)
+
+static func side_pane_uv(side: float, pane: int, u: float, v: float) -> Vector2:
+	var level: float = lerpf(0.10,0.84,v)
+	var lead: Vector3 = cabin_point(side,0,level)
+	var tail: Vector3 = cabin_point(side,1,level)
+	var split: float = lerpf(0.30,tail.z-0.070,0.65)
+	var a: float = lead.z+0.055 if pane == 0 else 0.30 if pane == 1 else split+0.016
+	var b: float = 0.235 if pane == 0 else split-0.016 if pane == 1 else tail.z-0.070
+	return Vector2((lerpf(a,b,u)-lead.z)/(tail.z-lead.z),level)
