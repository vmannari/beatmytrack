+			var across: float = lerpf(-0.80,0.80,u)
+			var y: float = lerpf(intake_bottom(across),intake_top(across),0.30+slat*0.34)+v*0.007
+			return front_point(across,y,0.045),trim,Vector3.FORWARD,car.simple_model)
