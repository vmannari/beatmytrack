+	patch(car.body,"RearDeck",48,8,func(u: float,v: float) -> Vector3:
+		return deck_point(u,v),paint,Vector3.UP,car.simple_model,Callable(),
+		func(u: float,v: float) -> Vector3:
+			if u<0.000001 or u>0.999999:
+				var point: Vector3 = deck_point(u,v)
+				return side_normal(point.y,point.z,-1 if u<0.5 else 1)
+			return sheet_normal(deck_point,u,v,Vector3.UP))
+	for rear: bool in [false,true]:
+		patch(car.body,"EndUndertrayRear" if rear else "EndUndertrayFront",80,8,func(u: float,v: float) -> Vector3:
+			var across: float = front_across(u)
+			var x: float = across*raw_width(0.31,2.09 if rear else FRONT_JOIN)
+			var outside: float = rear_z(x,0.31) if rear else front_z(x,0.31)
+			return Vector3(x,0.31,lerpf(outside,1.70 if rear else -1.70,v)),trim,Vector3.DOWN,car.simple_model)
