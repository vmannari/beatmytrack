+			var uv: Vector2 = hood_edge_uv(edge,u).lerp(hood_edge_uv(edge,u,0.006),v)
+			return raw_hood_point(uv.x,uv.y)-Vector3.UP*0.005,trim,Vector3.UP,car.simple_model)
