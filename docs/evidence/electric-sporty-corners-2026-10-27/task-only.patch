+## Model metres. Nose -Z, open wheel wells and continuous shared panel boundaries.
+const AXLE: float = 2.46 / (2.0 * HandlingConfig.BODY_SCALE)
+const HALF_TRACK: float = 1.48 / (2.0 * HandlingConfig.BODY_SCALE)
+const FRONT_JOIN: float = -1.94
+const FRONT_SHOULDER_Y: float = 0.94
+static var meshes: Dictionary = {}
+static var door_paths: Dictionary = {}
+static var reveal_queries: Dictionary = {}
+static var use_baked: bool = true
+const ASSET_ROOT: String = "res://assets/vehicles/electric_coachwork_v12"
+
+static func front_deform_weight(z: float) -> float:
+	return 1-smoothstep(FRONT_JOIN,-0.94,z)
+
+static func deform_front_point(point: Vector3) -> Vector3:
+	var w: float=front_deform_weight(point.z)
+	if w==0: return point
+	var shoulder: float=smoothstep(0.65,0.90,point.y)
+	# Keep the wheel opening and closed tubs on their original tyre circle.
+	var radius: float=Vector2(point.y-0.37,point.z+AXLE).length()
+	var arch_blend: float=smoothstep(0.43,0.55,radius)
+	return Vector3(point.x*(1-0.04*w*shoulder*arch_blend),point.y-0.08*w*arch_blend,point.z)
+
+static func deform_front_normal(point: Vector3, normal: Vector3) -> Vector3:
+	var w: float=front_deform_weight(point.z)
+	if w==0: return normal
+	var t: float=clampf((point.z-FRONT_JOIN)/(-0.94-FRONT_JOIN),0,1)
+	var dw: float=-6*t*(1-t)/(-0.94-FRONT_JOIN)
+	var h: float=clampf((point.y-0.65)/0.25,0,1)
+	var dh: float=6*h*(1-h)/0.25
+	var shoulder: float=h*h*(3-2*h)
+	var radial:=Vector2(point.y-0.37,point.z+AXLE)
+	var radius: float=maxf(0.000001,radial.length())
+	var a: float=clampf((radius-0.43)/0.12,0,1)
+	var arch_blend: float=a*a*(3-2*a)
+	var da: float=6*a*(1-a)/0.12
+	var drop_y: float=-0.08*w*da*radial.x/radius
+	var drop_z: float=-0.08*(dw*arch_blend+w*da*radial.y/radius)
+	# Inverse-transpose of the shared deformation Jacobian. All adjoining
+	# parts retain the same transported normal, including the rolled edge.
+	var nx: float=normal.x/(1-0.04*w*shoulder*arch_blend)
+	var ny: float=(normal.y+0.04*point.x*w*(dh*arch_blend+shoulder*da*radial.x/radius)*nx)/(1+drop_y)
+	var nz: float=normal.z+0.04*point.x*shoulder*(dw*arch_blend+w*da*radial.y/radius)*nx-drop_z*ny
+	return Vector3(nx,ny,nz).normalized()
+
+static func hood_point(u: float,v: float) -> Vector3:
+	return deform_front_point(raw_hood_point(u,v))
+
+static func hood_normal(u: float,v: float) -> Vector3:
+	return deform_front_normal(raw_hood_point(u,v),raw_hood_normal(u,v))
+
+static func lightbar_point(u: float,v: float) -> Vector3:
+	return deform_front_point(raw_lightbar_point(u,v))
+
+static func upper(z: float) -> float:
+	return raw_upper(z)-0.08*front_deform_weight(z)
+
+static func width(y: float,z: float) -> float:
+	var original_y: float=original_front_y(y,z)
+	return deform_front_point(Vector3(raw_width(original_y,z),original_y,z)).x
+
+static func skin_width(y: float,z: float) -> float:
+	var original_y: float=original_front_y(y,z)
+	return deform_front_point(Vector3(raw_skin_width(original_y,z),original_y,z)).x
+
+static func original_front_y(y: float,z: float) -> float:
+	var w: float=front_deform_weight(z)
+	if w==0: return y
+	var low: float=y
+	var high: float=y+0.08*w
+	for iteration: int in range(24):
+		var middle: float=(low+high)*0.5
+		if deform_front_point(Vector3(0,middle,z)).y<y: low=middle
+		else: high=middle
+	return (low+high)*0.5
+
+static func raw_upper(z: float) -> float:
+	if z < -0.94:
+		return 1.0-(1.0-FRONT_SHOULDER_Y)*pow((z+0.94)/(-0.94-FRONT_JOIN),2)
+	return 0.845 + 0.155*smoothstep(-2.30,-0.98,z) - 0.095*smoothstep(1.25,2.09,z)
+
+static func raw_skin_width(y: float, z: float) -> float:
+	var waist: float = 0.915 + 0.050*sin(clampf((y-0.29)/0.73,0,1)*PI)-0.065*smoothstep(0.82,1.02,y)
+	var fender: float = exp(-pow((z+AXLE)/0.45,2)) + exp(-pow((z-AXLE)/0.48,2))
+	var door_hollow: float = 0.043*exp(-pow((y-0.53)/0.14,2))*(1.0-clampf(fender,0,1))
+	# A shared quarter-circle shoulder turns the side into the hood/deck.
+	var radius: float = 0.055+0.070*(1-smoothstep(-1.70,-0.98,z))
+	# A serialized float32 boundary must remain exactly on the rolled edge.
+	# Otherwise its sub-micron Y error becomes a visible sqrt-shaped X gap.
+	var roll: float = radius if y>=raw_upper(z)-0.000001 else clampf(y-raw_upper(z)+radius,0,radius)
+	var shape: float = waist + 0.042*fender*smoothstep(0.34,0.77,y)-door_hollow-radius+sqrt(maxf(0,radius*radius-roll*roll))
+	return shape
+
+static func door_outline(front: bool) -> Array[Vector2]:
+	if door_paths.has(front): return door_paths[front]
+	var points: Array[Vector2] = [Vector2(-0.86,0.98),Vector2(0.26,0.98),Vector2(0.26,0.43),Vector2(-0.74,0.43)]
+	if not front: points = [Vector2(0.26,0.98),Vector2(0.95,0.98),Vector2(0.95,0.43),Vector2(0.26,0.43)]
+	var outline: Array[Vector2] = []
+	for index: int in range(4):
+		var corner: Vector2 = points[index]
+		var a: Vector2 = corner+(points[(index+3)%4]-corner).normalized()*0.028
+		var b: Vector2 = corner+(points[(index+1)%4]-corner).normalized()*0.028
+		for step: int in range(5):
+			var t: float = step/4.0
+			outline.append(a*pow(1-t,2)+2*corner*t*(1-t)+b*t*t)
+	door_paths[front] = outline
+	return outline
+
+static func door_depth(y: float, z: float) -> float:
+	if z < -0.88 or z > 0.97 or y < 0.415 or y > 0.995: return 0
+	var point := Vector2(z,y)
+	var distance: float = 1.0
+	for front: bool in [true,false]:
+		var outline: Array[Vector2] = door_outline(front)
+		for index: int in range(outline.size()):
+			var a: Vector2 = outline[index]
+			var edge: Vector2 = outline[(index+1)%outline.size()]-a
+			distance = minf(distance,point.distance_to(a+edge*clampf((point-a).dot(edge)/edge.length_squared(),0,1)))
+	return 0.0045*(1-smoothstep(0.0015,0.006,distance))
+
+static func raw_width(y: float, z: float) -> float:
+	return raw_skin_width(y,z)-door_depth(y,z)
+
+static func edge_roll(y: float, top: float, radius: float) -> float:
+	var rise: float = radius if y>=top-0.000001 else clampf(y-top+radius,0,radius)
+	return radius-sqrt(maxf(0,radius*radius-rise*rise))
+
+static func nose_top(across: float) -> float:
+	return lerpf(0.925,raw_upper(FRONT_JOIN),smoothstep(0,1,across*across))
+
+static func tail_top(across: float) -> float:
+	return raw_upper(2.09)+0.015*pow(1-across*across,2)
+
+static func front_z(x: float, y: float) -> float:
+	# The entire nose is an elliptical plan section with a convex bumper
+	# profile. Its corners turn into the wings well behind the old slab face.
+	var half_width: float = raw_width(y,FRONT_JOIN)
+	# A single convex profile places the foremost point at the light brow.
+	# Removing the separate upper roll and low bumper bulge removes the S bend.
+	var depth: float = -2.44+0.75*pow(y-0.85,2)
+	var ellipse: float = sqrt(maxf(0,1-pow(x/half_width,2)))
+	return FRONT_JOIN-(FRONT_JOIN-depth)*ellipse
+
+static func rear_z(x: float, y: float) -> float:
+	var half_width: float = raw_width(y,2.09)
+	var across: float = clampf(absf(x)/raw_width(raw_upper(2.09),2.09),0,1)
+	# A broad convex tail wraps into the quarters rather than a flat face
+	# with small rounded corners. Its lower tuck belongs to the same surface.
+	var depth: float = 2.36-0.14*(1-smoothstep(0.31,0.65,y))-edge_roll(y,tail_top(across),0.055)
+	depth -= 0.035*exp(-pow((y-0.57)/0.16,2))*(1-across*across)
+	return 2.09+(depth-2.09)*sqrt(maxf(0,1-pow(x/half_width,2)))
+
+static func face_normal(point: Vector3, rear_face: bool) -> Vector3:
+	var join: float = 2.09 if rear_face else FRONT_JOIN
+	if absf(point.x) > raw_width(point.y,join)-0.0001:
+		return side_normal(point.y,join,signf(point.x))
+	var surface: Callable = rear_z if rear_face else front_z
+	var dx: float = (surface.call(point.x+0.0001,point.y)-surface.call(point.x-0.0001,point.y))/0.0002
+	var dy: float = (surface.call(point.x,point.y+0.0001)-surface.call(point.x,point.y-0.0001))/0.0002
+	return Vector3(-dx,-dy,1).normalized() if rear_face else Vector3(dx,dy,-1).normalized()
+
+static func side_normal(y: float, z: float, side: float) -> Vector3:
+	if y>=raw_upper(z)-0.00001:
+		var upper_slope: float = (raw_upper(z+0.0001)-raw_upper(z-0.0001))/0.0002
+		return Vector3(0,1,-upper_slope).normalized()
+	var dy: float = (raw_width(y+0.0001,z)-raw_width(y-0.0001,z))/0.0002
+	if z>= -0.94:
+		# Panel reveals retain their real depth; broad paint uses the uncut
+		# coachwork normal so a narrow stamped gap cannot create a bright dent.
+		dy = (raw_skin_width(y+0.0001,z)-raw_skin_width(y-0.0001,z))/0.0002
+		var dz: float = (raw_skin_width(y,z+0.0001)-raw_skin_width(y,z-0.0001))/0.0002
+		return Vector3(side,-dy,-dz).normalized()
+	# Follow the moving shoulder when differentiating the rolled wing. At its
+	# square-root limit, fixed-Y differences produce sqrt(slope) instead of
+	# the actual longitudinal slope and leave a false crease in the highlight.
+	var ahead: float = raw_upper(z+0.0001)
+	var behind: float = raw_upper(z-0.0001)
+	var slope: float = (ahead-behind)/0.0002
+	if y>=raw_upper(z)-0.00001: return Vector3(0,1,-slope).normalized()
+	var along: float = (raw_width(y+ahead-raw_upper(z),z+0.0001)-raw_width(y+behind-raw_upper(z),z-0.0001))/0.0002
+	return Vector3(side,-dy,dy*slope-along).normalized()
+
+static func side_point(side: float, z: float, y: float, offset: float = 0.0) -> Vector3:
+	return Vector3(side*(raw_width(y,z)+offset),y,z)
+
+static func raw_hood_point(u: float, v: float) -> Vector3:
+	var across: float = lerpf(-1,1,u)
+	var front_y: float = nose_top(across)
+	var front_x: float = across*raw_width(front_y,FRONT_JOIN)
+	var front: Vector3 = Vector3(front_x,front_y,front_z(front_x,front_y))
+	var rear_y: float = 1.0+0.018*(1-across*across)
+	# Distribute the shoulder roll across the bonnet. The former 32nd-power
+	# blend forced most of its height change into a narrow strip beside the lid.
+	var edge: float = pow(across,4)
+	# Match a longitudinal (fixed-X) section of the actual nose, including
+	# its changing width; a constant-across tangent leaves an off-centre kink.
+	var slope: float = (front_z(front.x,front.y+0.0001)-front_z(front.x,front.y-0.0001))/0.0002
+	slope = clampf(slope,0.0,3.5)
