diff --git a/game/track/surface_shader_pruning.gd b/game/track/surface_shader_pruning.gd
new file mode 100644
--- /dev/null
+++ b/game/track/surface_shader_pruning.gd
@@ -0,0 +1,85 @@
+extends RefCounted
+## Remove unreachable bodies before Godot records native shader feature usage.
+## Conditions, else branches, public uniforms and active arithmetic stay intact.
+static func reduce(source: String, names: Array[String]) -> String:
+	if source.is_empty(): return source
+	var masked: String = _mask(source)
+	var constants: Dictionary = {}
+	var declarations := RegEx.new()
+	declarations.compile("(?m)^\\s*const\\s+bool\\s+(\\w+)\\s*=\\s*(true|false)\\s*;")
+	for found: RegExMatch in declarations.search_all(masked):
+		var name: String = found.get_string(1)
+		if name not in names: continue
+		var prefix: String = masked.substr(0,found.get_start())
+		if prefix.count("{") != prefix.count("}"): continue
+		# A local variable/parameter or a second conditional declaration makes
+		# the name ambiguous. Keep its original branches in that case.
+		var bindings := RegEx.new()
+		bindings.compile("\\bbool\\s+"+name+"\\b")
+		if bindings.search_all(masked).size() != 1: continue
+		bindings.compile("\\bbool\\s+[^;{}]*,\\s*"+name+"\\b")
+		if bindings.search(masked) != null: continue
+		var macros := RegEx.new()
+		macros.compile("(?m)^\\s*#\\s*(define|undef)\\s+"+name+"\\b")
+		if macros.search(masked) != null: continue
+		constants[name] = found.get_string(2) == "true"
+	var guards := RegEx.new()
+	guards.compile("\\bif\\s*\\(\\s*(!?)\\s*(\\w+)\\s*(?=\\)|&&)")
+	var edits: Array[Vector2i] = []
+	var until: int = -1
+	for found: RegExMatch in guards.search_all(masked):
+		if found.get_start() < until: continue
+		var flag: String = found.get_string(2)
+		if not constants.has(flag): continue
+		var value: bool = constants[flag]
+		if found.get_string(1) == "!": value = not value
+		if value: continue
+		var open: int = masked.find("(",found.get_start())
+		var depth: int = 1
+		var index: int = open+1
+		var ambiguous: bool = false
+		while index < masked.length() and depth > 0:
+			var char: String = masked[index]
+			if char == "(": depth += 1
+			elif char == ")": depth -= 1
+			elif char == "#" or (depth == 1 and char in ["|","^","?",","]): ambiguous = true
+			index += 1
+		if depth != 0 or ambiguous: continue
+		while index < masked.length() and masked[index] in [" ","\t","\n","\r"]: index += 1
+		if index >= masked.length() or masked[index] != "{": continue
+		open = index; depth = 1; index += 1
+		while index < masked.length() and depth > 0:
+			if masked[index] == "{": depth += 1
+			elif masked[index] == "}": depth -= 1
+			index += 1
+		if depth != 0: continue
+		# Preprocessor directives can affect text outside a runtime-false body.
+		if masked.substr(open+1,index-open-2).contains("#"): continue
+		edits.append(Vector2i(open+1,index-1))
+		until = index
+	# Reverse offsets keep nested and adjacent removals independent.
+	for edit_index: int in range(edits.size()-1,-1,-1):
+		var edit: Vector2i = edits[edit_index]
+		source = source.substr(0,edit.x)+source.substr(edit.y)
+	return source
+
+static func _mask(source: String) -> String:
+	# A same-length character mask keeps Unicode offsets valid while excluding
+	# comments and quoted include paths from brace and declaration matching.
+	var result: PackedStringArray = source.split("")
+	var index: int = 0
+	while index < result.size():
+		if source.substr(index,2) == "//":
+			while index < result.size() and source[index] != "\n": result[index] = " "; index += 1
+		elif source.substr(index,2) == "/*":
+			var end: int = source.find("*/",index+2)
+			end = source.length() if end < 0 else end+2
+			while index < end: result[index] = " "; index += 1
+		elif source[index] == '"':
+			result[index] = " "; index += 1
+			while index < result.size():
+				var char: String = source[index]; result[index] = " "; index += 1
+				if char == "\\" and index < result.size(): result[index] = " "; index += 1
+				elif char == '"': break
+		else: index += 1
+	return "".join(result)
diff --git a/game/tests/test_surface_shader_pruning.gd b/game/tests/test_surface_shader_pruning.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_surface_shader_pruning.gd
@@ -0,0 +1,58 @@
+extends SceneTree
+const PRUNE = preload("res://track/surface_shader_pruning.gd")
+var checks: int = 0
+var failures: int = 0
+const NAMES: Array[String] = ["fixed_test"]
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok: failures += 1; push_error(label)
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	var header := "const bool fixed_test = false;\n"
+	var body := "RADIANCE = vec4(1.0);"
+	var cases: Array = [
+		["if (fixed_test) {"+body+"} else { ALBEDO = vec3(0.2); }","if (fixed_test) {} else { ALBEDO = vec3(0.2); }"],
+		["if (fixed_test && (other || third)) {"+body+"}","if (fixed_test && (other || third)) {}"],
+		["if (fixed_test) {if (other) {"+body+"}}","if (fixed_test) {}"],
+		["if (fixed_test) {/* } é */ "+body+"}","if (fixed_test) {}"],
+		["if (fixed_test) {"+body+"} if (fixed_test) {"+body+"}","if (fixed_test) {} if (fixed_test) {}"]]
+	for pair: Array in cases:
+		var source: String = header+pair[0]
+		var result: String = PRUNE.reduce(source,NAMES)
+		check(result == header+pair[1],"false guard preserves surrounding code")
+		check(PRUNE.reduce(result,NAMES) == result,"pruning is idempotent")
+	for condition: String in ["!fixed_test","fixed_test || other","fixed_test && other || third","fixed_test && other ? a : b","fixed_test ^^ other","other && fixed_test","(fixed_test)"]:
+		var source: String = header+"if ("+condition+") {"+body+"}"
+		check(PRUNE.reduce(source,NAMES) == source,"active or unsupported condition stays exact: "+condition)
+	for source: String in ["",header+"if (fixed_test) "+body,header+"if (fixed_test) {"+body,
+		header+"void helper(bool fixed_test) {if (fixed_test) {"+body+"}}",
+		header+"void helper() {bool fixed_test = true; if (fixed_test) {"+body+"}}",
+		header+"void helper() {bool other = true, fixed_test = true; if (fixed_test) {"+body+"}}",
+		header+"void helper() {bool other = helper(), fixed_test = true; if (fixed_test) {"+body+"}}",
+		"void helper() {\n"+header+"if (fixed_test) {"+body+"}}",
+		header+"#define fixed_test other\nif (fixed_test) {"+body+"}",
+		header+"if (fixed_test) {\n#define EXTERNAL 1\n"+body+"}",
+		"// "+header+"if (fixed_test) {"+body+"}",
+		"/* "+header+"*/ if (fixed_test) {"+body+"}"]:
+		check(PRUNE.reduce(source,NAMES) == source,"empty, ambiguous, local and preprocessor cases stay exact")
+	var unknown := "const bool other = false;\nif (other) {"+body+"}"
+	check(PRUNE.reduce(unknown,NAMES) == unknown,"unknown constants stay exact")
+	var true_source := "const bool fixed_test = true;\nif (!fixed_test) {"+body+"}"
+	check(PRUNE.reduce(true_source,NAMES) == "const bool fixed_test = true;\nif (!fixed_test) {}","negated true guard is unreachable")
+	var names: Array[String] = SurfaceShaderVariants.FLAGS.duplicate()
+	for flag: String in SurfaceShaderVariants.MATERIAL_FLAGS: names.append("fixed_"+flag)
+	var compatibility: bool = RenderingServer.get_current_rendering_method() == "gl_compatibility"
+	for folded: bool in [false,true]:
+		for icy: bool in [false,true]:
+			var material := ShaderMaterial.new()
+			material.shader = load("res://track/creator_road.gdshader")
+			material.set_shader_parameter("icy_road",icy)
+			material.set_shader_parameter("winter_snow",not icy)
+			material.set_shader_parameter("asphalt_surface",true)
+			SurfaceShaderVariants.specialize(material,false,folded)
+			check(material.shader.code.contains("RADIANCE =") == (not compatibility or not folded or icy),"actual icy flag controls radiance, independently of snow flag")
+			var copy: ShaderMaterial = material.get_meta("surface_dynamic_material").duplicate()
+			SurfaceShaderVariants.specialize(copy,true,folded)
+			check(copy.shader == material.shader,"prepared and fresh paths share the same result")
+	print("SURFACE_SHADER_PRUNING: %d checks, %d failures" % [checks,failures])
+	quit(1 if failures else 0)
