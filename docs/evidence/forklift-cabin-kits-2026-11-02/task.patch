+				var x1: float = lerpf(-0.71,0.71,(i+1)/8.0)
+				beam(frame,"RoofArch",Vector3(x0,2.65+0.10*(1.0-pow(x0/0.71,2)),z),Vector3(x1,2.65+0.10*(1.0-pow(x1/0.71,2)),z),0.045,metal,simple,true)
