+		_face(tool,[outer[3],outer[2],inner[2],inner[3]],Vector3.UP)
+		if index == 0: _face(tool,[outer[0],outer[3],inner[3],inner[0]],Vector3.LEFT)
+		if index == steps-1: _face(tool,[outer[1],inner[1],inner[2],outer[2]],Vector3.RIGHT)
