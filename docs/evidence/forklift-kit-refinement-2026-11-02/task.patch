diff --git a/game/tests/capture_forklift_kit_refinement.gd b/game/tests/capture_forklift_kit_refinement.gd
new file mode 100644
index 0000000..e1dc839
--- /dev/null
+++ b/game/tests/capture_forklift_kit_refinement.gd
@@ -0,0 +1,86 @@
+extends SceneTree
+## Fixed, settled native views in an unmodified Garage world. No owner state.
+
+func _initialize() -> void: run.call_deferred()
+
+func run() -> void:
+	OS.set_environment("BMT_API_URL","")
+	root.size=Vector2i(1280,960)
+	root.content_scale_size=root.size
+	var output: String="res://../docs/evidence/forklift-kit-refinement-2026-11-02/review-gl"
+	var before: bool="--before" in OS.get_cmdline_user_args()
+	if before: output="res://../docs/evidence/forklift-kit-refinement-2026-11-02/before-review-gl"
+	var only: String=""
+	for arg: String in OS.get_cmdline_user_args():
+		if arg.begins_with("--output="): output=arg.trim_prefix("--output=")
+		if arg.begins_with("--only="): only=arg.trim_prefix("--only=")
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output))
+	var showroom:=CarShowroom.new()
+	showroom.vehicle_id="forklift"
+	showroom.garage_mode=true
+	showroom.livery=VehicleLivery.defaults("forklift")
+	root.add_child(showroom)
+	MenuStyle.fill(showroom)
+	while not showroom.showroom_ready: await process_frame
+	var count: int=0
+	for category: String in VehicleCustomisation.CATEGORIES:
+		for choice: Array in VehicleCustomisation.options(category,"forklift"):
+			if not only.is_empty() and category+"/"+str(choice[0]) not in only.split(","): continue
+			var parts: Dictionary=VehicleCustomisation.defaults()
+			parts[category]=choice[0]
+			showroom.apply_customisation(parts)
+			if before: await legacy_model(showroom,parts)
+			var target: Vector3
+			var offset: Vector3
+			match category:
+				"hood": target=Vector3(0,1.48,1.04); offset=Vector3(1.35,1.60,2.05)
+				"aero": target=Vector3(0,0.65,1.60); offset=Vector3(1.90,0.85,2.20)
+				"rims": target=Vector3(0.84,0.43,-0.98); offset=Vector3(1.20,0.28,-0.12)
+				"body": target=Vector3(0,2.02,0.10); offset=Vector3(-2.70,1.80,2.80)
+			var at: Vector3=showroom.car.body.global_transform*target
+			showroom.camera.look_at_from_position(at+showroom.car.body.global_transform.basis*offset,at)
+			showroom.invalidate_render()
+			if showroom.reflections!=null: showroom.reflections.sync()
+			for i: int in range(5): await process_frame
+			await RenderingServer.frame_post_draw
+			var pixels: Image=showroom.showroom_viewport.get_texture().get_image()
+			assert(pixels.save_png(output.path_join(category+"-"+str(choice[0])+".png"))==OK)
+			count+=1
+			print("FORKLIFT_KIT_CAPTURE ",category,"/",choice[0])
+	showroom.free()
+	print("FORKLIFT_KIT_REVIEW: ",count," captures")
+	quit()
+
+func legacy_model(showroom: CarShowroom, parts: Dictionary) -> void:
+	# Restore task-start builders only inside this isolated review process.
+	var model: GDScript=load("res://../docs/evidence/forklift-kit-refinement-2026-11-02/before/game/vehicle/forklift_model.gd")
+	var kits: GDScript=load("res://../docs/evidence/forklift-kit-refinement-2026-11-02/before/game/vehicle/forklift_kits.gd")
+	var car: CarVisual=showroom.car
+	car.graphics.restore_originals()
+	for category: String in VehicleCustomisation.CATEGORIES:
+		for frame: Node3D in car.kit_frames.get(category,[]):
+			frame.get_parent().remove_child(frame)
+			frame.free()
+	car.kit_frames.clear()
+	var positions: Array[Vector3]=car.wheel_rest_positions.duplicate()
+	var radii: Array[float]=car.wheel_radii.duplicate()
+	for rotor: Node3D in car.rolling_wheels:
+		var pivot: Node=rotor.get_parent()
+		car.remove_child(pivot)
+		pivot.free()
+	car.front_wheels.clear(); car.rear_wheels.clear(); car.rolling_wheels.clear()
+	car.wheel_radii.clear(); car.wheel_rest_positions.clear()
+	for child: Node in car.body.get_children(): child.free()
+	car.customisation=parts.duplicate(true)
+	model.build(car)
+	for i: int in range(positions.size()): model.wheel(car,positions[i],radii[i]/HandlingConfig.BODY_SCALE,0.32 if positions[i].z<0 else 0.25)
+	for category: String in VehicleCustomisation.CATEGORIES: kits.build(car,category)
+	await VisualGeometry.batch_static_parts(car)
+	await VisualGeometry.batch_car_parts(car)
+	car._update_rear_lights()
+	car.graphics=LiveryGraphics.new()
+	car.graphics.configure(car)
+	showroom.weathering=VehicleWeathering.new()
+	showroom.weathering.configure(car,"pine",VehicleCatalog.config("forklift"))
+	if showroom.reflections!=null: showroom.reflections.mark_stage(showroom.turntable)
+	showroom.invalidate_render()
diff --git a/game/tests/probe_forklift_kit_seams.gd b/game/tests/probe_forklift_kit_seams.gd
new file mode 100644
index 0000000..a45d2b5
--- /dev/null
+++ b/game/tests/probe_forklift_kit_seams.gd
@@ -0,0 +1,27 @@
+extends SceneTree
+const Surface=preload("res://vehicle/forklift_kit_surface.gd")
+
+func _initialize() -> void:
+	var holder:=Node3D.new()
+	root.add_child(holder)
+	var paint:=StandardMaterial3D.new()
+	var pockets: Array[Rect2]=[Rect2(-0.45,0.81,0.90,0.47)]
+	for simple: bool in [false,true]:
+		var node: MeshInstance3D=Surface.deck(holder,"probe",Rect2(-0.695,0.645,1.39,0.79),1.499,0.022,pockets,paint,paint,simple)
+		var faces: PackedVector3Array=node.mesh.get_faces()
+		var edges: Dictionary={}
+		for i: int in range(0,faces.size(),3):
+			for edge: int in range(3):
+				var a: Vector3=faces[i+edge]; var b: Vector3=faces[i+(edge+1)%3]
+				var sa: String=str(Vector3i(roundi(a.x*1000000),roundi(a.y*1000000),roundi(a.z*1000000)))
+				var sb: String=str(Vector3i(roundi(b.x*1000000),roundi(b.y*1000000),roundi(b.z*1000000)))
+				var key: String=sa+"/"+sb if sa<sb else sb+"/"+sa
+				if not edges.has(key): edges[key]=[]
+				edges[key].append([a,b])
+		var count: int=0
+		for key: String in edges:
+			if edges[key].size()!=2:
+				if count<24: print("SEAM ",simple," ",key," ",edges[key])
+				count+=1
+		print("SEAM_TOTAL ",simple," ",count)
+	quit()
diff --git a/game/tests/test_forklift_kit_construction.gd b/game/tests/test_forklift_kit_construction.gd
new file mode 100644
index 0000000..e09a9f9
--- /dev/null
+++ b/game/tests/test_forklift_kit_construction.gd
@@ -0,0 +1,83 @@
+extends "res://tests/review_forklift_model.gd"
+## Construction gates cover every custom assembly; appearance is reviewed separately.
+var checks: int = 0
+var failures: int = 0
+var certificates: Dictionary = {}
+
+func check(ok: bool, label: String) -> void:
+	checks+=1
+	if not ok:
+		failures+=1
+		print("FAIL: ",label)
+
+func run() -> void:
+	preload("res://vehicle/prepared_car_cache.gd").enabled=false
+	preload("res://vehicle/modular_car_base.gd").enabled=false
+	preload("res://vehicle/modular_car_kits.gd").enabled=false
+	preload("res://ui/garage_car_cache.gd").enabled=false
+	for simple: bool in [false,true]:
+		var car:=CarVisual.new()
+		car.vehicle_id="forklift"
+		car.simple_model=simple
+		car.editable_kits=true
+		car.batch_parts=false
+		car.cache_rest_pose=false
+		root.add_child(car)
+		while not car.model_ready: await process_frame
+		for category: String in VehicleCustomisation.CATEGORIES:
+			for option: Array in VehicleCustomisation.options(category,"forklift").slice(1):
+				var parts: Dictionary=VehicleCustomisation.defaults()
+				parts[category]=option[0]
+				car.graphics.restore_originals()
+				car.change_kit_parts(parts)
+				var label: String=category+"/"+str(option[0])+"/"+str(simple)
+				var bounds:=AABB()
+				var first: bool=true
+				var total: int=0
+				for frame: Node3D in car.kit_frames[category]:
+					var wheel_outer: float=-INF
+					var wheel_radial: float=0.0
+					var rotor_index: int=car.rolling_wheels.find(frame.get_parent())
+					var side: float=signf((frame.get_parent().get_parent() as Node3D).position.x) if category=="rims" else 0.0
+					for node: MeshInstance3D in frame.find_children("*","MeshInstance3D",true,false):
+						var data: Dictionary=topology(node)
+						var mesh_label: String=label+"/"+str(node.name)
+						check(data.boundary_edges==0 and data.inconsistent_edges==0,mesh_label+" closed consistent volume "+JSON.stringify(data))
+						check(data.normal_disagreements==0 and absf(data.signed_volume)>0.0000000001,mesh_label+" outward exterior normals "+JSON.stringify(data))
+						total+=data.triangles
+						var local: Transform3D=car.body.global_transform.affine_inverse()*node.global_transform
+						var box: AABB=local*node.mesh.get_aabb()
+						bounds=box if first else bounds.merge(box)
+						first=false
+						var finite: bool=true
+						for vertex: Vector3 in node.mesh.get_faces():
+							if not vertex.is_finite(): finite=false
+							if category=="rims":
+								var p: Vector3=frame.global_transform.affine_inverse()*node.global_transform*vertex
+								wheel_outer=maxf(wheel_outer,p.x*side)
+								wheel_radial=maxf(wheel_radial,Vector2(p.y,p.z).length())
+						check(finite,mesh_label+" finite vertices")
+					if category=="rims":
+						var width: float=0.32 if frame.get_parent().get_parent().position.z<0 else 0.25
+						var radius: float=car.wheel_radii[rotor_index]/HandlingConfig.BODY_SCALE
+						check(wheel_outer<=width*0.48+0.060,label+" centre remains within factory stud projection "+str(wheel_outer))
+						check(wheel_radial<=radius*0.64,label+" centre fits inside tyre bead "+str(wheel_radial))
+				if category=="hood":
+					check(bounds.position.y>=1.40 and bounds.end.y<=1.56,label+" lid remains within formed-cover envelope")
+					check(car.body.find_children("EngineLid","MeshInstance3D",true,false).is_empty(),label+" replaces the factory lid")
+					check(bounds.position.x>=-0.73 and bounds.end.x<=0.73 and bounds.position.z>=0.61 and bounds.end.z<=1.47,label+" fits the lid aperture")
+				if category=="aero":
+					check(bounds.position.y>=0.44 and bounds.end.y<=0.78 and bounds.position.x>=-0.84 and bounds.end.x<=0.84 and bounds.end.z<=1.79,label+" stays below lights and within bumper envelope")
+					check(car.body.find_children("RearBumper","MeshInstance3D",true,false).is_empty(),label+" replaces factory bumper")
+				if category=="body":
+					check(car.body.find_children("RearCabinBrace*","MeshInstance3D",true,false).is_empty(),label+" no decorative cross across operator sightline")
+					check(bounds.position.y>=1.01 and bounds.end.y<=2.75 and bounds.position.x>=-0.81 and bounds.end.x<=0.81,label+" bounded cabin and fitted feet")
+				check(total<14000,label+" bounded kit triangle count "+str(total))
+				certificates[label]={"triangles":total,"bounds":str(bounds)}
+		car.free()
+	var path: String="res://../docs/evidence/forklift-kit-refinement-2026-11-02/construction.json"
+	var file:=FileAccess.open(path,FileAccess.WRITE)
+	file.store_string(JSON.stringify({"checks":checks,"failures":failures,"assemblies":certificates},"\t"))
+	file.close()
+	print("FORKLIFT_KIT_CONSTRUCTION: ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
