+					yaw+=clampf(relative.cross(normal)*0.08,-1.8,1.8)
+				if float(row[10])<0.0 and approach>=1.6:
+					row[10]=0.0; row[11]=p.x; row[12]=p.y; row[13]=normal.angle(); row[14]=clampf(approach/12.0,0.3,1.0)
