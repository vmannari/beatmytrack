+ result={'tables':tables,'schema':c.execute(text('SELECT version_num FROM alembic_version')).scalar(),'pending':pending,'simulator_journal_sha256':hashlib.sha256(json.dumps(journal,sort_keys=True).encode()).hexdigest()}
