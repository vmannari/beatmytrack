+def snapshot(name):
+    before = d.r.get('data_before')
+    names = list(json.loads((ROOT / 'docs/evidence/achievements-backend-deploy-2026-10-17/data-before.json').read_text())['tables'])
+    names += ['studio_quarantines', 'admin_audit']
