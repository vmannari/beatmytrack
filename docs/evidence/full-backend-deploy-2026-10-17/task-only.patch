+    assert health['status'] == 'ready', health['status']
+    assert health['expected_build'] == {k: v for k, v in r['expected_manifest'].items() if k != 'max_frames'}
+    for name in ['api', 'worker']:
+        actual = inspect('bmt-pc-dev-' + name + '-1')
