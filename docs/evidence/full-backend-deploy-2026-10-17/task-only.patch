+"""Isolated regression probes for corrections found during the complete rollout."""
+import argparse
+import json
+import secrets
+import subprocess
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+WORK = ROOT / 'build/full-backend-deploy-2026-10-17'
+OUT = ROOT / 'docs/evidence/full-backend-deploy-2026-10-17'
+docker = ['wsl.exe', '-d', 'Ubuntu', '--cd', '/mnt/c/Codes/Godot/Beat my track', '--', 'docker']
+
+
+def run(args):
+    return subprocess.run([*docker, *args], capture_output=True, text=True, encoding='utf-8', check=True).stdout
+
+
+def linux(path): return '/mnt/' + path.drive[0].lower() + path.as_posix()[2:]
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--name', default='corrected-regressions')
+    p.add_argument('--postgres', action='store_true')
+    p.add_argument('tests', nargs='+')
+    args = p.parse_args()
+    assert args.name.replace('-', '').isalnum()
+    r = json.loads((OUT / 'rollout.json').read_text())
+    label = 'bmt.full-probe-owner=' + r['owner']
+    suffix = secrets.token_hex(4)
+    network, pg = 'bmt-full-probe-' + suffix, 'bmt-full-probe-pg-' + suffix
+    password = secrets.token_urlsafe(24)
+    created = False
+    try:
+        cmd = ['run', '--rm', '--entrypoint=python', '--label=' + label,
+            '--mount=type=bind,source=' + linux(WORK / 'frozen') + ',target=/test-work,readonly',
+            '--mount=type=bind,source=' + linux(ROOT / 'backend/tests') + ',target=/test-work/backend/tests,readonly',
+            '--mount=type=bind,source=' + linux(ROOT / 'backend/tests/fixtures') + ',target=/app/tests/fixtures,readonly',
+            '-e', 'PYTHONPATH=/app:/test-work:/test-work/backend/tests']
+        for name in ['tracks.py', 'runs.py']:
+            cmd += ['--mount=type=bind,source=' + linux(ROOT / 'backend/bmt_backend' / name) + ',target=/app/bmt_backend/' + name + ',readonly']
+        if args.postgres:
+            run(['network', 'create', '--internal', '--label=' + label, network])
+            run(['run', '--rm', '-d', '--name=' + pg, '--network=' + network, '--label=' + label,
+                 '-e', 'POSTGRES_USER=probe', '-e', 'POSTGRES_DB=probe', '-e', 'POSTGRES_PASSWORD=' + password, 'postgres:17'])
+            created = True
+            for _ in range(40):
+                ready = subprocess.run([*docker, 'exec', pg, 'pg_isready', '-U', 'probe'], capture_output=True, text=True)
+                if ready.returncode == 0: break
+                time.sleep(.3)
+            cmd += ['--network=' + network, '-e', 'BMT_TEST_DATABASE_URL=postgresql+psycopg://probe:' + password + '@' + pg + ':5432/probe']
+        else: cmd += ['--network=none']
+        tests = ['/test-work/backend/tests/' + s for s in args.tests]
+        result = subprocess.run([*docker, *cmd, r['local_tag'], '-m', 'pytest', *tests, '-q', '--tb=short', '--show-capture=no',
+            '-c', '/app/pyproject.toml', '-o', 'cache_dir=/tmp/probe-cache'], capture_output=True, text=True, encoding='utf-8', timeout=900)
+        output = (result.stdout + result.stderr).replace(password, '[REDACTED]')
+        (OUT / (args.name + '.log')).write_text(output, encoding='utf-8')
+        print(output[-9500:])
+        print('Probe exit:', result.returncode)
+    finally:
+        if created:
+            labels = json.loads(run(['inspect', pg, '--format={{json .Config.Labels}}']))
+            assert labels.get('bmt.full-probe-owner') == r['owner']
+            run(['stop', pg])
+            labels = json.loads(run(['network', 'inspect', network, '--format={{json .Labels}}']))
+            assert labels.get('bmt.full-probe-owner') == r['owner']
+            run(['network', 'rm', network])
+
+
+if __name__ == '__main__': main()
