+  else if(m.kind==='products')input=`<select id="${id}" data-setting="${esc(k)}" multiple size="5">${v.map(x=>`<option value="${esc(x)}" selected>${esc(x)}</option>`).join('')}</select><small>Use Move up / down to order the selected offer.</small><div><button type="button" class="btn" data-move-offer="up" data-target="${id}">Move up</button> <button type="button" class="btn" data-move-offer="down" data-target="${id}">Move down</button></div>`;
+  else input=`<input id="${id}" data-setting="${esc(k)}" type="number" step="1" min="${m.minimum}" max="${m.maximum}" value="${v??''}" ${m.kind==='optional_integer'?'placeholder="No additional cap"':'required'}>`;
+  return `<div class="gc-field" data-category="${esc(m.category)}"><label for="${id}">${esc(m.label)}</label>${input}${!experimental?`<small>Active: ${esc(gcText(gcState.active.policy[k]))} · Applies at ${esc(m.boundary.replaceAll('_',' '))}</small>`:''}</div>`;
