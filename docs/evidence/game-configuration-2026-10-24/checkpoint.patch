diff --git a/backend/schemas/game-configuration-v1.schema.json b/backend/schemas/game-configuration-v1.schema.json
new file mode 100644
--- /dev/null
+++ b/backend/schemas/game-configuration-v1.schema.json
@@ -0,0 +1,236 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "bmt-game-configuration-v1",
+  "title": "Effective noncanonical game configuration",
+  "type": "object",
+  "required": [
+    "schema_version",
+    "generation",
+    "control_revision",
+    "scope",
+    "server_now",
+    "expires_at",
+    "resolution_id",
+    "settings",
+    "assignments",
+    "restrictions"
+  ],
+  "properties": {
+    "schema_version": {
+      "const": 1
+    },
+    "generation": {
+      "type": "integer",
+      "minimum": 0
+    },
+    "control_revision": {
+      "type": "integer",
+      "minimum": 0
+    },
+    "scope": {
+      "type": "string"
+    },
+    "server_now": {
+      "type": "integer"
+    },
+    "expires_at": {
+      "type": "integer"
+    },
+    "resolution_id": {
+      "type": "string",
+      "pattern": "^[a-f0-9]{64}$"
+    },
+    "settings": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "ads.permitted",
+        "ads.interstitial_enabled",
+        "ads.trigger",
+        "ads.races",
+        "ads.active_seconds",
+        "ads.first_delay_seconds",
+        "ads.min_races",
+        "ads.min_seconds",
+        "ads.rewarded_cooldown_seconds",
+        "ads.session_cap",
+        "ads.rewarded_resume_enabled",
+        "features.challenge_creation",
+        "features.rivalry_entry",
+        "notice.message",
+        "notice.expires_at",
+        "store_order"
+      ],
+      "properties": {
+        "ads.permitted": {
+          "type": "boolean",
+          "description": "All advertising permitted",
+          "default": false
+        },
+        "ads.interstitial_enabled": {
+          "type": "boolean",
+          "description": "Automatic ads enabled",
+          "default": false
+        },
+        "ads.trigger": {
+          "enum": [
+            "either",
+            "both"
+          ],
+          "description": "Become due when",
+          "default": "either"
+        },
+        "ads.races": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 100,
+          "description": "Completed races threshold",
+          "default": 3
+        },
+        "ads.active_seconds": {
+          "type": "integer",
+          "minimum": 60,
+          "maximum": 7200,
+          "description": "Active time threshold (seconds)",
+          "default": 600
+        },
+        "ads.first_delay_seconds": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 7200,
+          "description": "First-ad delay (active seconds)",
+          "default": 0
+        },
+        "ads.min_races": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 100,
+          "description": "Minimum races between ads",
+          "default": 0
+        },
+        "ads.min_seconds": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 7200,
+          "description": "Minimum active seconds between ads",
+          "default": 0
+        },
+        "ads.rewarded_cooldown_seconds": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 7200,
+          "description": "Wait after rewarded ad (active seconds)",
+          "default": 0
+        },
+        "ads.session_cap": {
+          "type": [
+            "integer",
+            "null"
+          ],
+          "minimum": 1,
+          "maximum": 100,
+          "description": "Maximum automatic ads per session",
+          "default": null
+        },
+        "ads.rewarded_resume_enabled": {
+          "type": "boolean",
+          "description": "Rewarded Resume offered",
+          "default": true
+        },
+        "features.challenge_creation": {
+          "type": "boolean",
+          "description": "New challenge creation available",
+          "default": true
+        },
+        "features.rivalry_entry": {
+          "type": "boolean",
+          "description": "New Weekly Rivalry entry available",
+          "default": true
+        },
+        "notice.message": {
+          "type": "string",
+          "maxLength": 256,
+          "description": "Menu notice",
+          "default": ""
+        },
+        "notice.expires_at": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 4102444800,
+          "description": "Notice expiry (UTC Unix seconds, 0 for none)",
+          "default": 0
+        },
+        "store_order": {
+          "type": "array",
+          "minItems": 5,
+          "maxItems": 5,
+          "uniqueItems": true,
+          "items": {
+            "enum": [
+              "ad_free_forever",
+              "ad_free_month",
+              "creator_slot_1",
+              "creator_slots_5",
+              "creator_slots_10"
+            ]
+          },
+          "description": "Store offer order",
+          "default": [
+            "ad_free_forever",
+            "ad_free_month",
+            "creator_slot_1",
+            "creator_slots_5",
+            "creator_slots_10"
+          ]
+        }
+      }
+    },
+    "assignments": {
+      "type": "array",
+      "maxItems": 2,
+      "items": {
+        "type": "object",
+        "required": [
+          "experiment_id",
+          "variant",
+          "revision",
+          "layer",
+          "boundary"
+        ],
+        "properties": {
+          "experiment_id": {
+            "type": "string",
+            "format": "uuid"
+          },
+          "variant": {
+            "type": "string",
+            "pattern": "^[a-z][a-z0-9_-]{0,23}$"
+          },
+          "revision": {
+            "type": "integer",
+            "minimum": 0
+          },
+          "layer": {
+            "enum": [
+              "ads",
+              "presentation"
+            ]
+          },
+          "boundary": {
+            "enum": [
+              "race_result",
+              "menu_entry",
+              "store_entry"
+            ]
+          }
+        }
+      }
+    },
+    "restrictions": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      }
+    }
+  }
+}
