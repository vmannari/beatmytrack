+  const id=prefix+'-'+k.replaceAll('.','-'),v=values[k];let input;
+  if(m.kind==='boolean')input=`<select id="${id}" data-setting="${esc(k)}"><option value="true" ${v===true?'selected':''}>On</option><option value="false" ${v===false?'selected':''}>Off</option></select>`;
+  else if(m.kind==='enum')input=`<select id="${id}" data-setting="${esc(k)}">${m.values.map(x=>`<option value="${esc(x)}" ${v===x?'selected':''}>${x==='both'?'Both thresholds (AND)':x==='either'?'Either threshold (OR)':esc(x)}</option>`).join('')}</select>`;
