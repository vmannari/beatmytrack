diff --git a/backend/bmt_backend/public_ui/style-v1.css b/backend/bmt_backend/public_ui/style-v1.css
new file mode 100644
index 0000000..6c3a29f
--- /dev/null
+++ b/backend/bmt_backend/public_ui/style-v1.css
@@ -0,0 +1,175 @@
+@font-face { font-family: Barlow; font-style: normal; font-weight: 400; font-display: swap; src: url("/site/Barlow-Regular.ttf") format("truetype"); }
+@font-face { font-family: "Barlow Condensed"; font-style: normal; font-weight: 600; font-display: swap; src: url("/site/BarlowCondensed-SemiBold.ttf") format("truetype"); }
+:root {
+  color-scheme: dark;
+  --ink: #101b22;
+  --panel: #18252e;
+  --paper: #f2f0e9;
+  --muted: #b6c0c5;
+  --line: #34434b;
+  --yellow: #f4ce48;
+  font-family: Barlow, Arial, Helvetica, sans-serif;
+  color: var(--paper);
+  background: var(--ink);
+  line-height: 1.65;
+  scroll-behavior: smooth;
+}
+* { box-sizing: border-box; }
+body, figure { margin: 0; }
+body { min-width: 280px; }
+a { color: inherit; text-decoration: none; }
+a, summary { -webkit-tap-highlight-color: #f4ce4840; }
+a:focus-visible { outline: 3px solid var(--yellow); outline-offset: 6px; }
+main:focus { outline: none; }
+img { display: block; max-width: 100%; height: auto; }
+h1, h2, h3, p { margin-top: 0; }
+h1, h2 { font-family: "Barlow Condensed", Impact, "Arial Narrow", sans-serif; font-weight: 600; line-height: .98; letter-spacing: -.025em; }
+h2 { font-size: clamp(38px, 4.6vw, 64px); margin-bottom: 24px; }
+h3 { font-size: 21px; line-height: 1.3; margin-bottom: 10px; }
+p { margin-bottom: 20px; }
+.wrap { width: min(1280px, calc(100% - 96px)); margin-inline: auto; }
+.muted { color: var(--muted); }
+.small { font-size: 14px; }
+.eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; margin-bottom: 24px; }
+.skip-link { position: absolute; left: 20px; top: -80px; z-index: 10; background: var(--yellow); color: var(--ink); padding: 12px 20px; font-weight: 700; }
+.skip-link:focus { top: 12px; }
+.site-header { min-height: 98px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
+.wordmark { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; font-size: 19px; font-weight: 900; letter-spacing: -.06em; }
+.wordmark img { margin-right: 6px; }
+.wordmark span { color: var(--yellow); }
+nav { display: flex; align-items: center; gap: 30px; font-size: 13px; font-weight: 700; }
+nav a { display: inline-flex; align-items: center; min-height: 44px; padding-block: 10px; }
+nav a:hover, .text-link:hover { color: var(--yellow); }
+.nav-account { padding: 10px 18px; border: 1px solid #66747c; border-radius: 3px; }
+.nav-account span { margin-left: 12px; }
+.hero { display: grid; grid-template-columns: .9fr 1.1fr; min-height: 650px; padding-top: 25px; gap: 50px; align-items: center; }
+.hero-copy { padding-block: 25px 40px; }
+.hero .eyebrow { color: var(--muted); letter-spacing: .09em; }
+.status-dot { display: inline-block; height: 7px; width: 7px; background: var(--yellow); border-radius: 50%; margin-right: 7px; }
+h1 { font-size: clamp(58px, 6.8vw, 98px); margin-bottom: 26px; }
+h1 span, .feature-copy h2 span { color: var(--yellow); }
+.hero-intro { font-size: 20px; line-height: 1.5; max-width: 370px; margin-bottom: 12px; }
+.hero-copy > .muted { max-width: 400px; font-size: 15px; }
+.button { display: inline-flex; align-items: center; justify-content: space-between; gap: 32px; padding: 15px 23px; border-radius: 3px; font-size: 14px; font-weight: 700; line-height: 1.5; transition: background-color .15s; }
+.button.primary { background: var(--yellow); color: var(--ink); }
+.button.primary:hover { background: #ffe586; }
+.hero .button { margin-top: 9px; }
+.hero-art { align-self: stretch; display: flex; flex-direction: column; justify-content: center; min-width: 0; position: relative; }
+.hero-art > img { width: 100%; height: 100%; max-height: 690px; object-fit: cover; border-radius: 4px 4px 0 0; }
+.hero-art figcaption { background: #21313b; padding: 12px 16px; display: flex; justify-content: space-between; gap: 15px; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; border-bottom: 2px solid var(--yellow); }
+.hero-art figcaption span:first-child { color: var(--yellow); font-weight: 700; }
+.quick-facts { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 42px; padding-block: 28px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
+.quick-facts p { margin: 0; padding-left: 30px; border-left: 1px solid var(--line); }
+.quick-facts p:first-child { padding-left: 0; border: none; }
+.quick-facts strong { display: block; font-size: 16px; letter-spacing: .03em; }
+.quick-facts span { display: block; font-size: 13px; color: var(--muted); }
+.section { padding-block: 100px; scroll-margin-top: 28px; }
+.section-heading { display: grid; grid-template-columns: 150px 1fr .9fr; gap: 35px; align-items: start; margin-bottom: 40px; }
+.section-heading .eyebrow { color: var(--yellow); margin-top: 10px; }
+.section-heading h2 { margin: 0; }
+.section-heading > p:last-child { color: var(--muted); font-size: 16px; max-width: 330px; padding-top: 8px; }
+.race-layout { display: grid; grid-template-columns: 1.25fr .75fr; gap: 50px; align-items: center; }
+.screen { min-width: 0; }
+.screen img { width: 100%; border: 1px solid var(--line); border-radius: 3px; }
+.screen a { display: block; }
+.screen a:hover img { border-color: #a4a99e; }
+figcaption { font-size: 11px; color: var(--muted); padding-top: 12px; }
+.mode-list article { display: flex; gap: 20px; border-top: 1px solid var(--line); padding-block: 22px 18px; }
+.mode-list article:last-child { border-bottom: 1px solid var(--line); }
+.number { color: var(--yellow); font-size: 12px; padding-top: 3px; }
+.mode-list h3 { font-size: 19px; }
+.mode-list p { color: var(--muted); font-size: 14px; margin-bottom: 0; }
+.section-note { margin: 25px 0 0; max-width: 700px; color: var(--muted); font-size: 12px; }
+.worlds { background: var(--paper); color: var(--ink); }
+.worlds-inner { padding-block: 64px; display: grid; grid-template-columns: .7fr 1.3fr; gap: 70px; align-items: center; }
+.worlds-inner h2 { font-size: clamp(38px, 4vw, 56px); }
+.worlds-inner p:not(.eyebrow) { max-width: 340px; font-size: 15px; color: #43525a; }
+.worlds figure img { width: 100%; border-radius: 3px; }
+.worlds figcaption { color: #43525a; }
+.split-section { display: grid; grid-template-columns: .7fr 1.3fr; gap: 80px; align-items: center; }
+.feature-copy .eyebrow { color: var(--yellow); }
+.feature-copy > p:not(.eyebrow) { color: var(--muted); font-size: 15px; }
+.feature-list { list-style: none; padding: 0; margin: 26px 0 0; }
+.feature-list li { padding: 10px 0 10px 21px; border-top: 1px solid var(--line); position: relative; font-size: 13px; }
+.feature-list li::before { content: "↗"; color: var(--yellow); position: absolute; left: 0; }
+.garage-section { grid-template-columns: 1.3fr .7fr; padding-top: 0; }
+.account-section { background: var(--panel); border-block: 1px solid var(--line); padding-block: 80px; scroll-margin-top: 28px; }
+.account-inner { display: grid; grid-template-columns: 1.2fr .8fr; gap: 100px; align-items: center; }
+.account-inner .eyebrow { color: var(--yellow); }
+.account-inner > div:first-child > p:not(.eyebrow) { max-width: 530px; color: var(--muted); font-size: 15px; }
+.account-actions { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 30px; }
+.text-link { text-decoration: underline; text-underline-offset: 5px; font-size: 13px; font-weight: 700; }
+.account-details { border-left: 2px solid var(--yellow); padding: 7px 0 7px 30px; }
+.account-details h3 { margin-bottom: 20px; }
+.account-details p { color: var(--muted); font-size: 14px; }
+.site-footer { padding-block: 36px; display: flex; align-items: center; flex-wrap: wrap; gap: 20px 35px; }
+.site-footer .wordmark { font-size: 16px; }
+.site-footer p { color: var(--muted); font-size: 12px; margin: 0; }
+.site-footer nav { margin-left: auto; font-size: 12px; gap: 24px; }
+@media (min-width: 1500px) { .hero { gap: 80px; } }
+@media (max-width: 1100px) {
+  .wrap { width: calc(100% - 64px); }
+  nav { gap: 20px; }
+  .hero { gap: 30px; min-height: auto; }
+  h1 { font-size: 72px; }
+  .section-heading { grid-template-columns: 100px 1fr 1fr; gap: 25px; }
+  .race-layout, .split-section, .worlds-inner { gap: 35px; }
+  .account-inner { gap: 60px; }
+  .mode-list article { padding-block: 16px; gap: 12px; }
+}
+@media (max-width: 760px) {
+  .wrap { width: calc(100% - 40px); }
+  .site-header { padding-block: 20px; min-height: auto; flex-wrap: wrap; gap: 16px; }
+  .site-header .wordmark { font-size: 17px; }
+  .site-header nav { width: 100%; justify-content: space-between; gap: 10px; font-size: 12px; }
+  .nav-account { padding: 8px 10px; }
+  .nav-account span { margin-left: 5px; }
+  .hero { grid-template-columns: 1fr 1fr; gap: 24px; padding-top: 15px; }
+  h1 { font-size: clamp(44px, 7.8vw, 59px); }
+  .hero-copy { padding-block: 12px; }
+  .hero .eyebrow { font-size: 9px; margin-bottom: 18px; }
+  .hero-intro { font-size: 17px; }
+  .hero-copy > .muted { font-size: 13px; }
+  .hero-art > img { min-height: 450px; object-position: 44%; }
+  .hero-art figcaption { flex-direction: column; gap: 2px; font-size: 8px; }
+  .quick-facts { margin-top: 32px; padding-block: 22px; }
+  .quick-facts p { padding-left: 18px; }
+  .quick-facts strong { font-size: 13px; }
+  .quick-facts span { font-size: 11px; max-width: 140px; }
+  .section { padding-block: 65px; }
+  .section-heading { grid-template-columns: 1fr; gap: 12px; margin-bottom: 30px; }
+  .section-heading .eyebrow { margin: 0; }
+  .section-heading > p:last-child { max-width: 480px; margin: 0; }
+  .race-layout { grid-template-columns: 1fr; gap: 25px; }
+  .mode-list article { padding-block: 20px; gap: 20px; }
+  .worlds-inner, .split-section, .garage-section, .account-inner { grid-template-columns: 1fr; gap: 35px; }
+  .worlds-inner { padding-block: 50px; }
+  .worlds-inner p:not(.eyebrow) { max-width: 450px; margin: 0; }
+  .feature-copy h2 { max-width: 500px; line-height: 1.08; }
+  .garage-section { padding-top: 0; }
+  .garage-section .feature-copy { order: -1; }
+  .account-section { padding-block: 55px; }
+  .account-details { padding-left: 22px; }
+  .site-footer { gap: 16px; }
+  .site-footer nav { width: 100%; margin: 0; justify-content: flex-start; }
+}
+@media (max-width: 480px) {
+  .hero { grid-template-columns: 1fr; gap: 26px; }
+  h1 { font-size: clamp(55px, 13vw, 70px); }
+  .hero .eyebrow { font-size: 10px; }
+  .hero-copy > .muted { font-size: 14px; }
+  .hero-intro { max-width: 320px; font-size: 19px; }
+  .hero-art > img { min-height: 0; height: auto; aspect-ratio: 1 / .9; object-position: center 65%; }
+  .hero-art figcaption { flex-direction: row; }
+  .quick-facts { gap: 18px; }
+  .quick-facts p { padding: 0; border: 0; }
+  .quick-facts strong { font-size: 11px; letter-spacing: 0; }
+  .quick-facts span { font-size: 11px; line-height: 1.5; margin-top: 5px; }
+  .section-heading h2 { font-size: 43px; }
+  .feature-copy h2 { font-size: 42px; }
+  .account-actions { gap: 22px; align-items: flex-start; flex-direction: column; }
+}
+@media (prefers-reduced-motion: reduce) {
+  :root { scroll-behavior: auto; }
+  .button { transition: none; }
+}
