diff --git a/backend/bmt_backend/public_ui/index.html b/backend/bmt_backend/public_ui/index.html
new file mode 100644
index 0000000..520d105
--- /dev/null
+++ b/backend/bmt_backend/public_ui/index.html
@@ -0,0 +1,85 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Beat my track — Find your line. Make your track.</title>
+  <meta name="description" content="Meet Beat my track: overhead racing, five-lap time trials, a track creator, Weekly Rivalry and a Garage to make your car your own. Manage or delete your game account here.">
+  <meta name="theme-color" content="#101b22">
+  <meta property="og:title" content="Beat my track — Find your line. Make your track.">
+  <meta property="og:description" content="Chase a better lap. Build your own circuit. Give someone a time to beat.">
+  <meta property="og:type" content="website">
+  <link rel="icon" href="/site/mark-v1.svg" type="image/svg+xml">
+  <link rel="stylesheet" href="/site/style-v1.css">
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to content</a>
+  <header class="site-header wrap">
+    <a class="wordmark" href="/" aria-label="Beat my track home"><img src="/site/mark-v1.svg" width="38" height="38" alt="">BEAT <span>MY</span> TRACK</a>
+    <nav aria-label="Main navigation">
+      <a href="#game">The game</a>
+      <a href="#create">Create</a>
+      <a href="#garage">Garage</a>
+      <a class="nav-account" href="/account-deletion">Delete account <span aria-hidden="true">↗</span></a>
+    </nav>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <section class="hero wrap" aria-labelledby="hero-title">
+      <div class="hero-copy">
+        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> In development · Android &amp; Windows</p>
+        <h1 id="hero-title">FIND YOUR<br>LINE.<br><span>MAKE YOUR<br>TRACK.</span></h1>
+        <p class="hero-intro">A little car. A challenging corner. A lap you know you can improve.</p>
+        <p class="muted">Beat my track brings overhead racing, track building and friendly competition together. Chase your best time, then give someone a time to beat.</p>
+        <a class="button primary" href="#game">Discover the game <span aria-hidden="true">↓</span></a>
+      </div>
+      <figure class="hero-art">
+        <img src="/site/forest-drive-v1.webp" alt="Game artwork of a blue compact car approaching a winding road through a mountain forest" width="1254" height="1254" fetchpriority="high">
+        <figcaption><span>BEAT MY TRACK</span><span>Game artwork / Forest</span></figcaption>
+      </figure>
+    </section>
+
+    <div class="quick-facts wrap" aria-label="At a glance">
+      <p><strong>FIVE LAPS.</strong><span>A better line. A better time.</span></p>
+      <p><strong>YOUR CIRCUIT.</strong><span>Build it. Test it. Share it.</span></p>
+      <p><strong>ONE MORE GO.</strong><span>Unlimited ordinary racing.</span></p>
+    </div>
+
+    <section id="game" class="section wrap" aria-labelledby="race-title">
+      <div class="section-heading"><p class="eyebrow">01 / Race</p><h2 id="race-title">The next lap<br>could be your best.</h2><p>Read the road from above. Learn the braking points, feel the grip and find the line that brings it all together.</p></div>
+      <div class="race-layout">
+        <figure class="screen"><a href="/site/winter-race-v1.webp" aria-label="View the Winter racing screenshot at full size"><img src="/site/winter-race-v1.webp" alt="Actual overhead gameplay: a compact car on a snowy circuit, with lap timing and touch driving controls" width="1280" height="720" loading="lazy"></a><figcaption>Actual game screen · Winter circuit</figcaption></figure>
+        <div class="mode-list">
+          <article><span class="number" aria-hidden="true">01</span><div><h3>Free Race</h3><p>Pick a circuit and chase your personal best over five laps. Restart and try again whenever you like.</p></div></article>
+          <article><span class="number" aria-hidden="true">02</span><div><h3>Weekly Rivalry</h3><p>Take on a weekly selection of tracks with drivers of similar pace. Your best verified results count.</p></div></article>
+          <article><span class="number" aria-hidden="true">03</span><div><h3>Challenges</h3><p>Set a time and share an invitation for a one-to-one or group challenge on the same track and car.</p></div></article>
+        </div>
+      </div>
+      <p class="section-note">Local racing works without an online account. Online competitions and sharing need sign-in, an internet connection and an available game service.</p>
+    </section>
+
+    <section class="worlds" aria-labelledby="worlds-title">
+      <div class="wrap worlds-inner"><div><p class="eyebrow">A change of scenery</p><h2 id="worlds-title">Different roads.<br>Fresh challenges.</h2><p>Forest, Desert, Harbour and Winter bring different settings to the circuits you race and create.</p></div><figure><img src="/site/worlds-v1.webp" alt="Game environment artwork showing a green forest, sandy desert, industrial harbour and snowy winter landscape" width="1536" height="1024" loading="lazy"><figcaption>Environment artwork</figcaption></figure></div>
+    </section>
+
+    <section id="create" class="section wrap split-section" aria-labelledby="create-title">
+      <div class="feature-copy"><p class="eyebrow">02 / Create</p><h2 id="create-title">That corner<br>in your head?<br><span>Build it.</span></h2><p>Lay out roads, shape the surroundings and place the start line. Go from an idea to a circuit you can actually drive.</p><ul class="feature-list"><li>Combine straights, curves, hairpins and bridges.</li><li>Choose surfaces and add trackside objects.</li><li>Test your layout in untimed practice.</li><li>Keep local drafts or publish a validated track for others.</li></ul></div>
+      <figure class="screen"><a href="/site/track-editor-v1.webp" aria-label="View the track editor screenshot at full size"><img src="/site/track-editor-v1.webp" alt="Actual track editor showing an oval circuit, an editable start line and a palette of road pieces" width="1280" height="720" loading="lazy"></a><figcaption>Actual game screen · Track creator</figcaption></figure>
+    </section>
+
+    <section id="garage" class="section wrap split-section garage-section" aria-labelledby="garage-title">
+      <figure class="screen"><a href="/site/garage-v1.webp" aria-label="View the Garage screenshot at full size"><img src="/site/garage-v1.webp" alt="Actual Garage showing a blue-and-cream compact car and a catalogue of cosmetic hood options" width="1280" height="720" loading="lazy"></a><figcaption>Actual game screen · Garage customisation</figcaption></figure>
+      <div class="feature-copy"><p class="eyebrow">03 / Garage</p><h2 id="garage-title">Make it<br><span>your own.</span></h2><p>Explore cars with distinct handling, from the nimble Compact to the Kart, Formula, Electric and even a rear-steering Forklift.</p><p>Try paint, patterns, stickers and cosmetic parts in the Garage. Take a parking-hall test drive, or wash off the dirt from your last outing.</p><p class="small muted">Cosmetic options can require unlocks. Previewing a look does not purchase it.</p></div>
+    </section>
+
+    <section id="account" class="account-section" aria-labelledby="account-title">
+      <div class="wrap account-inner">
+        <div><p class="eyebrow">Your account &amp; privacy</p><h2 id="account-title">Your game.<br>Your choice.</h2><p>Read how your information is handled, or request deletion of your Beat my track online account here, even if you have uninstalled the game.</p><p>Verify with the Google identity you used in the game, review what you will lose and choose whether to confirm. Your Google account stays.</p><div class="account-actions"><a class="button primary" href="/account-deletion">Delete game account <span aria-hidden="true">↗</span></a><a class="text-link" href="/privacy">Read the privacy policy <span aria-hidden="true">↗</span></a></div></div>
+        <div class="account-details"><h3>Before you decide</h3><p>Deletion permanently removes your online account and remaining online benefits, including paid benefits.</p><p>Local tracks and local car customisation stay on your device. Published tracks and historical standings remain under “Removed account”.</p><p>The deletion page explains retained records and shows your remaining benefits before you confirm.</p><a class="text-link" href="/community-rules">Community rules <span aria-hidden="true">↗</span></a></div>
+      </div>
+    </section>
+  </main>
+
+  <footer class="site-footer wrap"><a class="wordmark" href="/">BEAT <span>MY</span> TRACK</a><p>Find your line. Make your track.</p><nav aria-label="Legal and account links"><a href="/privacy">Privacy</a><a href="/community-rules">Community rules</a><a href="/account-deletion">Delete account</a></nav></footer>
+</body>
+</html>
