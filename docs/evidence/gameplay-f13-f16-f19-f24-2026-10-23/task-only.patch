+	var rise: float = 0.0
+	if ground != null and not state.track_elevated and state.jump_height == 0.0:
+		kerb_probe.position = previous
+		kerb_probe.heading = previous_heading
+		var last: Vector4 = ground.kerb_heights(kerb_probe,config)
