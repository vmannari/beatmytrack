+extends SceneTree
+## Refresh UI launch figures after a canonical handling change; no rendering or saves.
+func _initialize() -> void:
+	run.call_deferred()
+
+func run() -> void:
+	var rows: Array[String] = []
+	for id: String in VehicleCatalog.IDS:
+		var config: HandlingConfig = VehicleCatalog.config(id,HandlingSelection.ORIGINAL_PLUS_INDEX)
+		var signature: String = JSON.stringify(config.snapshot()).sha256_text()
+		var simulation := VehicleSimulation.new(config)
+		var drive: DriveFrame = DriveFrame.sample(0,1,0)
+		var target: float = 60.0/3.6
+		var seconds: float = -1.0
+		if config.maximum_speed > target:
+			for tick: int in range(20*VehicleSimulation.TICK_RATE):
+				var before: float = simulation.state.velocity.length()
+				simulation.step(drive)
+				var after: float = simulation.state.velocity.length()
+				if after >= target:
+					seconds = (tick+inverse_lerp(before,after,target))*VehicleSimulation.STEP
+					break
+		rows.append("\t\"%s\":[\"%s\",%.12f]" % [id,signature,seconds])
+		simulation = null
+		drive = null
+		config = null
+	var source: String = "extends RefCounted\n# Generated by tests/bake_garage_performance.gd: clean, straight, unboosted 0–60 km/h.\nconst PHYSICS_VERSION: String = \"%s\"\nconst LAUNCHES: Dictionary = {\n%s\n}\n" % [VehicleSimulation.PHYSICS_VERSION,",\n".join(rows)]
+	var file := FileAccess.open("res://ui/garage_performance_data.gd",FileAccess.WRITE)
+	if file == null:
+		quit(1)
+		return
+	file.store_string(source)
+	file.close()
+	print("GARAGE_PERFORMANCE_BAKE ",rows.size()," cars")
+	quit.call_deferred()
