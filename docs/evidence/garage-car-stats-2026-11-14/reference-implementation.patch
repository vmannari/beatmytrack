+extends HBoxContainer
+## Garage-only header treatment; navigation restores the shared shell on exit.
+var app: Node
+var _nav: HBoxContainer
+var _amount: Label
+var _original: Dictionary = {}
+var _active: bool = false
+var _width: float = -1.0
+
+class Coin extends Control:
+	func _init() -> void:
+		custom_minimum_size = Vector2(24,24)
+		mouse_filter = Control.MOUSE_FILTER_IGNORE
+		size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	func _draw() -> void:
+		draw_circle(Vector2(12,12),11,Color("eaa718"))
+		draw_circle(Vector2(12,12),9,MenuStyle.ACCENT)
+		draw_string(MenuStyle.DISPLAY,Vector2(7,19),"$",HORIZONTAL_ALIGNMENT_LEFT,-1,20,Color("b67c13"))
+
+func _ready() -> void:
+	name = "GarageHeaderWallet"
+	_nav = get_parent()
+	_nav.move_child(self,app.account_button.get_index())
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	add_theme_constant_override("separation",8)
+	add_child(Coin.new())
+	_amount = MenuStyle.label("",24)
+	GameText.user_text(_amount)
+	add_child(_amount)
+	var divider := VSeparator.new()
+	divider.custom_minimum_size.x = 16
+	divider.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	add_child(divider)
+	for node: Control in _nav.get_children():
+		if node == self: continue
+		_remember(node)
+		if node.name == "MenuNavigation":
+			for tab: Control in node.get_children(): _remember(tab)
+	_remember(_nav)
+	_remember(_nav.get_parent())
+	_remember(_nav.get_parent().get_parent())
+	if app.cosmetic_economy != null: app.cosmetic_economy.changed.connect(_balance)
+	_balance()
+	visible = false
+	_process(0.0)
+
+func _remember(node: Control) -> void:
+	var data: Dictionary = {"minimum":node.custom_minimum_size,"styles":{},"colors":{},"sizes":{},"constants":{}}
+	for key: String in ["normal","hover","pressed","focus"]:
+		if node.has_theme_stylebox_override(key): data.styles[key] = node.get_theme_stylebox(key)
+	for key: String in ["font_color","font_hover_color","font_pressed_color"]:
+		if node.has_theme_color_override(key): data.colors[key] = node.get_theme_color(key)
+	if node.has_theme_font_size_override("font_size"): data.sizes.font_size = node.get_theme_font_size("font_size")
+	for key: String in ["separation","margin_top","margin_bottom","margin_left","margin_right"]:
+		if node.has_theme_constant_override(key): data.constants[key] = node.get_theme_constant(key)
+	_original[node] = data
+
+func _balance() -> void:
+	if not is_instance_valid(_amount): return
+	var signed_in: bool = app.cosmetic_economy != null and app.cosmetic_economy.authenticated()
+	_amount.text = _grouped(app.cosmetic_economy.balance()) if signed_in else "—"
+	tooltip_text = GameText.message("Account coins" if signed_in else "Sign in to earn coins")
+
+func _grouped(value: int) -> String:
+	var text: String = str(value)
+	var offset: int = text.length()-3
+	while offset > 0:
+		text = text.insert(offset,",")
+		offset -= 3
+	return text
+
+func _process(_delta: float) -> void:
+	if not is_instance_valid(app) or not is_instance_valid(app.root_ui): return
+	var active: bool = app.screen == "garage"
+	var width: float = get_viewport_rect().size.x
+	if active == _active and (not active or is_equal_approx(width,_width)): return
+	_active = active
+	_width = width
+	visible = active
+	if active: _fit(width < 1100)
+	else: _restore()
+
+func _fit(compact: bool) -> void:
+	_nav.add_theme_constant_override("separation",6 if compact else 12)
+	var layout: VBoxContainer = _nav.get_parent()
+	layout.add_theme_constant_override("separation",6)
+	var margin: MarginContainer = layout.get_parent()
+	margin.add_theme_constant_override("margin_top",10)
+	margin.add_theme_constant_override("margin_bottom",18)
+	margin.add_theme_constant_override("margin_left",16)
+	var brand: Control = _nav.get_child(0)
+	brand.custom_minimum_size = Vector2(136 if compact else 196,52)
+	var tabs: Control = app.root_ui.find_child("MenuNavigation",true,false)
+	for tab: Button in tabs.get_children():
+		var style: StyleBoxFlat = MenuStyle.box(Color.TRANSPARENT,6 if compact else 16)
+		style.set_corner_radius_all(0)
+		if tab.name == "Tab_garage":
+			style.border_color = MenuStyle.ACCENT
+			style.border_width_bottom = 2
+		tab.add_theme_stylebox_override("normal",style)
+		tab.custom_minimum_size.y = 52
+		tab.add_theme_font_size_override("font_size",19 if compact else 23)
+		tab.add_theme_color_override("font_color",MenuStyle.ACCENT if tab.name == "Tab_garage" else MenuStyle.MUTED)
+	var account: Button = app.account_button
+	account.custom_minimum_size = Vector2(174 if compact else 210,52)
+	for state: String in ["normal","hover","pressed","focus"]:
+		var style: StyleBoxFlat = account.get_theme_stylebox(state).duplicate()
+		style.content_margin_left = 88 if compact else 104
+		style.content_margin_right = 12
+		if state == "normal": style.bg_color = Color(0.04,0.08,0.10,0.55)
+		account.add_theme_stylebox_override(state,style)
+	var picture: Control = account.get_node_or_null("MenuProfileCar")
+	if picture != null:
+		picture.offset_right = 78 if compact else 94
+		picture.offset_top = -24 if compact else -28
+		picture.offset_bottom = 24 if compact else 28
+	var picker: Control = account.get_node_or_null("MenuCarPicker")
+	if picker != null: picker.offset_right = 84 if compact else 100
+	var settings: Button = app.root_ui.find_child("MenuSettings",true,false)
+	settings.add_theme_stylebox_override("normal",MenuStyle.box(Color.TRANSPARENT))
+	settings.custom_minimum_size = Vector2(52,52)
+
+func _restore() -> void:
+	for node: Control in _original:
+		if not is_instance_valid(node): continue
+		var data: Dictionary = _original[node]
+		node.custom_minimum_size = data.minimum
+		for key: String in ["normal","hover","pressed","focus"]:
+			if data.styles.has(key): node.add_theme_stylebox_override(key,data.styles[key])
+			else: node.remove_theme_stylebox_override(key)
+		for key: String in ["font_color","font_hover_color","font_pressed_color"]:
+			if data.colors.has(key): node.add_theme_color_override(key,data.colors[key])
+			else: node.remove_theme_color_override(key)
+		if data.sizes.has("font_size"): node.add_theme_font_size_override("font_size",data.sizes.font_size)
+		else: node.remove_theme_font_size_override("font_size")
+		for key: String in ["separation","margin_top","margin_bottom","margin_left","margin_right"]:
+			if data.constants.has(key): node.add_theme_constant_override(key,data.constants[key])
+			else: node.remove_theme_constant_override(key)
+	var tabs: Control = app.root_ui.find_child("MenuNavigation",true,false)
+	for tab: Button in tabs.get_children():
+		var id: String = str(tab.name).trim_prefix("Tab_")
+		var selected: bool = id == app.screen or (id == "tracks" and app.screen in ["rivalry","daily","challenges"]) or (id == "create" and app.screen == "biome")
+		tab.add_theme_stylebox_override("normal",MenuStyle.box(Color(1,1,1,0.07) if selected else Color.TRANSPARENT,16))
+		tab.add_theme_color_override("font_color",MenuStyle.ACCENT if selected else MenuStyle.MUTED)
+	var picture: Control = app.account_button.get_node_or_null("MenuProfileCar")
+	if picture != null:
+		picture.offset_right = 94
+		picture.offset_top = -28
+		picture.offset_bottom = 28
+	var picker: Control = app.account_button.get_node_or_null("MenuCarPicker")
+	if picker != null: picker.offset_right = 100
