@@ -0,0 +1,38 @@
+from pathlib import Path
+from PIL import Image, ImageChops, ImageDraw
+import json
+
+root = Path(__file__).resolve().parents[1]
+evidence = root / 'docs/evidence/garage-carousel-refresh-2026-10-14'
+comparisons = []
+for width in [960, 1280, 1600, 1720]:
+    name = f'garage-{width}.png'
+    before = Image.open(evidence / 'before/gl_compatibility' / name).convert('RGB')
+    after = Image.open(evidence / 'after/gl_compatibility' / name).convert('RGB')
+    assert before.size == after.size
+    pane = (0, 0, width, int(before.height * 0.66))
+    difference = ImageChops.difference(before.crop(pane), after.crop(pane))
+    bounds = difference.getbbox()
+    changed = sum(any(pixel) for pixel in difference.getdata())
+    comparisons.append({'width': width, 'compared_rect': pane, 'exact_pixels': bounds is None,
+                        'changed_pixels': changed, 'difference_bounds': bounds})
+
+before = Image.open(evidence / 'before/gl_compatibility/garage-1600.png').convert('RGB')
+after = Image.open(evidence / 'after/gl_compatibility/garage-1600.png').convert('RGB')
+sheet = Image.new('RGB', (1488, 356), '#101923')
+draw = ImageDraw.Draw(sheet)
+draw.text((12, 10), 'Before', fill='white')
+draw.text((12, 188), 'Updated garage and closer framing', fill='white')
+sheet.paste(before.crop((92, 492, 1580, 632)), (0, 30))
+sheet.paste(after.crop((92, 492, 1580, 632)), (0, 208))
+sheet.save(evidence / 'before-after-carousel.png')
+(evidence / 'pixel-comparison.json').write_text(json.dumps({
+    'main_view_comparisons': comparisons,
+    'carousel_framing_scale_before': 0.94,
+    'carousel_framing_scale_after': 0.84,
+    'camera_distance_reduction_percent': (1 - 0.84 / 0.94) * 100,
+    'scene_linear_magnification_percent': (0.94 / 0.84 - 1) * 100,
+    'note': 'Native screenshots are separate-time captures, including the existing animated record player and its reflection. RGB differences are reported without ignoring alpha or masking pixels. The magnification ratio follows camera distance at the same target plane; actual car pixels vary with perspective depth. Contact sheet crops unmodified native Godot screenshots.'
+}, indent=2) + '\n', encoding='utf-8')
+print('MAIN_PANE_DIFFERENCES:', [(entry['width'], entry['changed_pixels'], entry['difference_bounds']) for entry in comparisons])
+print('CAROUSEL_CAMERA_DISTANCE:', 0.84 / 0.94)
