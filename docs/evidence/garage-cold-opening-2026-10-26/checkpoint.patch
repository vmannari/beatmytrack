diff --git a/game/tests/test_garage_prepared_cars.gd b/game/tests/test_garage_prepared_cars.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_garage_prepared_cars.gd
@@ -0,0 +1,80 @@
+extends SceneTree
+const Prepared=preload("res://ui/garage_car_cache.gd")
+var checks: int=0
+var failures: int=0
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool,label: String) -> void:
+	checks+=1
+	if not ok: failures+=1;print("FAIL: ",label)
+func finish(material: Material) -> Array:
+	if material==null: return []
+	var result: Array=[material.get_class()]
+	if material is ShaderMaterial:
+		result.append(material.shader.code)
+		for item: Dictionary in material.shader.get_shader_uniform_list():
+			var value: Variant=material.get_shader_parameter(item.name)
+			if value is Texture2D:
+				var image: Image=value.get_image()
+				value=[image.get_size(),image.get_data()] if image!=null else null
+			result.append([item.name,value])
+	else:
+		for property: Dictionary in material.get_property_list():
+			if int(property.usage)&PROPERTY_USAGE_STORAGE and not str(property.name).begins_with("resource_") and property.name!="next_pass":
+				var value: Variant=material.get(property.name)
+				if value is Texture2D:
+					var image: Image=value.get_image()
+					value=[image.get_size(),image.get_data()] if image!=null else null
+				result.append([property.name,value])
+	result.append(finish(material.next_pass))
+	return result
+func shape(car: CarVisual) -> Array:
+	var value: Array=[car.wheel_radii,car.wheel_rest_positions,car.scale]
+	for node: Node3D in car.find_children("*","Node3D",true,false):
+		value.append([car.get_path_to(node),node.transform])
+		if node is MeshInstance3D:
+			value.append([node.layers,node.cast_shadow])
+			for surface: int in range(node.mesh.get_surface_count()):
+				value.append(node.mesh.surface_get_arrays(surface))
+				value.append(finish(node.get_active_material(surface)))
+	return value
+func make(id: String,prepared: bool) -> CarVisual:
+	var car:=CarVisual.new()
+	car.vehicle_id=id
+	car.livery=VehicleLivery.defaults(id)
+	car.editable_kits=id=="compact"
+	car.garage_template=prepared
+	root.add_child(car)
+	return car
+func difference(a: Variant,b: Variant,path: String="") -> void:
+	if a is Array and b is Array:
+		if a.size()!=b.size(): print("DETAIL_LENGTH ",path," ",a.size()," ",b.size())
+		for i: int in range(mini(a.size(),b.size())):
+			if typeof(a[i])!=typeof(b[i]) or a[i]!=b[i]: difference(a[i],b[i],path+"/"+str(i));return
+	else: print("DETAIL_VALUE ",path," ",a," / ",b)
+func run() -> void:
+	for id: String in VehicleCatalog.IDS:
+		var reference: CarVisual=make(id,false)
+		var original: Array=shape(reference)
+		var before: int=Prepared.hits
+		var restored: CarVisual=make(id,true)
+		check(Prepared.hits==before+1,"prepared native resource used "+id)
+		var rebuilt: Array=shape(restored)
+		check(original==rebuilt,"all geometry, articulation and finish values match "+id)
+		if original!=rebuilt:
+			difference(original,rebuilt,id)
+			if id=="electric":
+				for instance: CarVisual in [reference,restored]:
+					for mesh: Node in instance.find_children("*","MeshInstance3D",true,false):
+						if str(instance.get_path_to(mesh)).begins_with("FrontLeftWheel"): print("EV_SURFACE ",instance.garage_template," ",instance.get_path_to(mesh)," ",mesh.mesh.get_surface_count())
+			for i: int in range(mini(original.size(),rebuilt.size())):
+				if original[i]!=rebuilt[i]: print("MODEL_DIFFERENCE ",id," index=",i," original=",str(original[i]).left(220)," restored=",str(rebuilt[i]).left(220));break
+		var paint: Dictionary=VehicleLivery.defaults(id)
+		paint.colors.body="c72d34"
+		restored.apply_livery(paint)
+		check(shape(reference)==original,"preview paint cannot mutate reference materials "+id)
+		var other: CarVisual=make(id,true)
+		check(shape(other)==original,"future instance retains native stock finish "+id)
+		reference.free();restored.free();other.free()
+		await process_frame
+	print("GARAGE_PREPARED_CARS ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/test_garage_cold_opening.gd b/game/tests/test_garage_cold_opening.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_garage_cold_opening.gd
@@ -0,0 +1,122 @@
+extends SceneTree
+var checks: int=0
+var failures: int=0
+var output: String="res://../build/garage-cold-opening"
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool,label: String) -> void:
+	checks+=1
+	if not ok: failures+=1;print("FAIL: ",label)
+func frames(count: int=4) -> void:
+	for _i: int in range(count): await process_frame
+func run() -> void:
+	OS.set_environment("BMT_API_URL","")
+	for arg: String in OS.get_cmdline_user_args():
+		if arg.begins_with("--output="): output=arg.trim_prefix("--output=")
+	output=ProjectSettings.globalize_path(output)
+	DirAccess.make_dir_recursive_absolute(output)
+	root.size=Vector2i(1280,720)
+	var app: Node=load("res://core/app.tscn").instantiate()
+	var folder: String="user://garage-cold-"+TrackLibrary.unique_id()
+	app.library=TrackLibrary.new(folder.path_join("tracks"))
+	app.records=LocalRecords.new(folder.path_join("records.json"))
+	app.cloud_root_override=folder.path_join("cloud")
+	root.add_child(app)
+	while not app.startup_complete: await process_frame
+	var music: GameSoundtrack=GameSoundtrack.instance()
+	music.music_enabled=false;music.menu_player.stop();music.menu_player.stream=null
+	app._show_screen("tracks")
+	await frames(10)
+	var began: int=Time.get_ticks_usec()
+	app._show_screen("garage")
+	var dispatch: float=(Time.get_ticks_usec()-began)/1000.0
+	var page: GaragePage=app._retained_garage
+	check(dispatch<250,"Garage navigation returns in less than 250ms")
+	check(app.screen=="garage" and page.visible,"normal Garage page opens immediately")
+	check(page.showroom.preparing and page.showroom.car==null,"page does not construct a car in its navigation callback")
+	check(page.showroom.find_child("GarageOpeningPicture",true,false)!=null,"first frame already has the car picture")
+	check(page.thumbnails.size()==7,"all seven car cards exist on entry")
+	for id: String in page.thumbnails: check(page.thumbnails[id]._image.texture!=null,"immediate card "+id)
+	page._show_section("tuning")
+	check(page._opening_section=="tuning","tools requested before the world exists retain their destination")
+	page._show_section("cars")
+	while app.menu_page_motion!=null and app.menu_page_motion.is_running(): await process_frame
+	if DisplayServer.get_name()!="headless":
+		await RenderingServer.frame_post_draw
+		check(page.showroom.car==null,"incoming Garage picture draws before native construction begins")
+		check(root.get_texture().get_image().save_png(output.path_join("first-frame.png"))==OK,"capture first frame")
+	var first_ms: float=(Time.get_ticks_usec()-began)/1000.0
+	print("GARAGE_IMMEDIATE dispatch_ms=",dispatch," first_frame_ms=",first_ms)
+	# Navigation can leave before a single native shader is compiled.
+	app._show_screen("settings")
+	await frames(4)
+	check(app.screen=="settings","leave Garage while native preparation is pending")
+	app._show_screen("garage")
+	var frame_times: Array[float]=[]
+	var deadline: int=Time.get_ticks_msec()+120000
+	while not page.showroom.interaction_ready and page.showroom.preparing and Time.get_ticks_msec()<deadline: await process_frame
+	check(page.showroom.interaction_ready,"live geometry becomes interactive before full-finish preparation completes")
+	check(page.section=="cars" and page._opening_section.is_empty(),"later Cars navigation cancels an earlier deferred tools request")
+	var held_position: float=page.showroom.yaw
+	var active_max_ms: float=0.0
+	var active_frames: Array[float]=[]
+	for _i: int in range(24):
+		var tick: int=Time.get_ticks_usec()
+		var motion:=InputEventMouseMotion.new()
+		motion.position=Vector2(640,300)
+		page.showroom._input(motion)
+		page.showroom.rotate_view(Vector2(1,0))
+		await process_frame
+		var frame_ms: float=(Time.get_ticks_usec()-tick)/1000.0
+		active_frames.append(frame_ms)
+		active_max_ms=maxf(active_max_ms,frame_ms)
+	check(page.showroom.yaw!=held_position,"orbit responds while full finishes are still preparing")
+	check(active_max_ms<150,"active orbit frames stay below 150ms while shader preparation waits for idle")
+	print("GARAGE_ACTIVE_FRAMES ",active_frames)
+	page._show_section("tuning")
+	check(page.section=="tuning","Parts opens before full shader preparation finishes")
+	if DisplayServer.get_name()!="headless":
+		await RenderingServer.frame_post_draw
+		check(root.get_texture().get_image().save_png(output.path_join("early-live-studio.png"))==OK,"capture early live geometry")
+	page._show_section("cars")
+	# Rapid car previews must replace the preparation target without committing.
+	var equipped: String=VehicleCatalog.selected
+	page.preview_car(VehicleCatalog.IDS.find("pickup"))
+	page.preview_car(VehicleCatalog.IDS.find("electric"))
+	check(VehicleCatalog.selected==equipped,"preview during preparation does not equip or save the car")
+	while page.showroom.preparing and Time.get_ticks_msec()<deadline:
+		var tick: int=Time.get_ticks_usec()
+		await process_frame
+		frame_times.append((Time.get_ticks_usec()-tick)/1000.0)
+	check(not page.showroom.preparing,"real 3D studio completes its staged first draws")
+	check(page.showroom.vehicle_id=="electric" and page.showroom.car.vehicle_id=="electric","latest requested car replaces the earlier preparation target")
+	check(page.showroom.car.model_ready and page.showroom.camera!=null and page.showroom.reflections.views.size()==2,"full live car, camera and both reflections remain")
+	check(page.showroom.find_child("GarageOpeningPicture",true,false)==null,"temporary picture releases after live preparation")
+	page.showroom.rotate_view(Vector2(20,0))
+	check(page.showroom.yaw!=CarShowroom.DEFAULT_YAW,"live orbit remains available")
+	var studio: CarShowroom=page.showroom
+	app._show_screen("settings")
+	app._show_screen("garage")
+	check(page.showroom==studio and not studio.preparing,"subsequent Garage entry reuses the ready studio")
+	await frames(4)
+	check(studio.find_children("OpeningLiveGeometry","MeshInstance3D",true,false).is_empty(),"temporary live geometry is released after full preparation")
+	check(studio.find_children("*","SubViewport",true,false).size()==3,"steady Garage returns to its main view and two reflections")
+	for mesh: Node in studio.find_children("*","MeshInstance3D",true,false): check(mesh.layers!=8,"original geometry leaves the preparation-only layer")
+	if DisplayServer.get_name()!="headless":
+		await RenderingServer.frame_post_draw
+		check(root.get_texture().get_image().save_png(output.path_join("live-studio.png"))==OK,"capture settled live studio")
+	var elapsed: float=(Time.get_ticks_usec()-began)/1000.0
+	frame_times.sort()
+	var report: Dictionary={"dispatch_ms":dispatch,"first_frame_ms":first_ms,"live_ready_ms":studio.live_ready_ms,"active_orbit_max_ms":active_max_ms,"studio_ms":elapsed,"frame_max_ms":frame_times[-1] if not frame_times.is_empty() else 0,"checks":checks,"failures":failures}
+	var old: WeakRef=weakref(page)
+	app.records=LocalRecords.new(folder.path_join("another-records.json"))
+	app._show_screen("garage")
+	check(app._retained_garage!=page and app._retained_garage.records==app.records,"records owner replacement creates a separately owned opening job")
+	app.queue_free()
+	await frames(12)
+	check(old.get_ref()==null,"prior owner preparation and world are released")
+	report.checks=checks
+	report.failures=failures
+	var file:=FileAccess.open(output.path_join("report.json"),FileAccess.WRITE)
+	file.store_string(JSON.stringify(report,"  "))
+	print("GARAGE_COLD_OPENING ",JSON.stringify(report))
+	quit(1 if failures else 0)
diff --git a/game/tests/test_garage_opening_tools.gd b/game/tests/test_garage_opening_tools.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_garage_opening_tools.gd
@@ -0,0 +1,74 @@
+extends SceneTree
+var checks: int=0
+var failures: int=0
+var studio: CarShowroom
+var output: String="res://../build/garage-opening-tools"
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool,label: String) -> void:
+	checks+=1
+	if not ok: failures+=1;print("FAIL: ",label)
+func active_frame() -> void:
+	var motion:=InputEventMouseMotion.new()
+	studio._input(motion)
+	await process_frame
+	if DisplayServer.get_name()!="headless": await RenderingServer.frame_post_draw
+	else: studio._sync_live_finish()
+func bindings(label: String) -> void:
+	check(studio._facade!=null and not studio._facade.items.is_empty(),label+" has temporary live bindings")
+	for item: Dictionary in studio._facade.items:
+		var source: Object=item.source.get_ref()
+		if not is_instance_valid(source): continue
+		check(source.layers==8 and not source.visible,label+" keeps original finish reserved")
+		check(item.copy.mesh==source.mesh,label+" uses the same geometry")
+		check(item.copy.global_transform==source.global_transform,label+" follows the exact source transform")
+		if item.copy.global_transform!=source.global_transform: print("POSE_DIFFERENCE ",source.get_path()," local ",source.transform," proxy ",item.copy.transform," global ",source.global_transform," proxy ",item.copy.global_transform)
+		for surface: int in range(source.mesh.get_surface_count()):
+			var original: Material=source.get_active_material(surface)
+			var live: Material=item.copy.get_active_material(surface)
+			if original is ShaderMaterial and live is ShaderMaterial:
+				for parameter: String in ["paint_color","dirt_amount","snow_amount","garage_paint_progress","garage_kit_progress"]:
+					var expected: Variant=original.get_shader_parameter(parameter)
+					if expected!=null: check(live.get_shader_parameter(parameter)==expected,label+" retains "+parameter)
+func run() -> void:
+	for arg: String in OS.get_cmdline_user_args():
+		if arg.begins_with("--output="): output=arg.trim_prefix("--output=")
+	output=ProjectSettings.globalize_path(output)
+	DirAccess.make_dir_recursive_absolute(output)
+	root.size=Vector2i(1280,720)
+	studio=preload("res://ui/garage_opening_showroom.gd").new()
+	studio.garage_mode=true
+	studio.livery=VehicleLivery.defaults("compact")
+	studio.customisation=VehicleCustomisation.defaults()
+	root.add_child(studio)
+	MenuStyle.fill(studio)
+	var deadline: int=Time.get_ticks_msec()+60000
+	while not studio.interaction_ready and Time.get_ticks_msec()<deadline: await process_frame
+	check(studio.interaction_ready and studio.preparing,"live tools precede full native preparation")
+	var paint: Dictionary=studio.livery.duplicate(true)
+	paint.colors.body="c72d34"
+	studio.apply_livery(paint,true)
+	await active_frame()
+	bindings("paint sweep")
+	while studio.paint_motion!=null: await active_frame()
+	await active_frame()
+	bindings("paint settled")
+	var parts: Dictionary=VehicleCustomisation.defaults()
+	parts.aero="wing"
+	studio.apply_customisation(parts,true)
+	await active_frame()
+	bindings("parts sweep")
+	while studio.kit_motion!=null: await active_frame()
+	await active_frame()
+	bindings("parts settled")
+	studio.update_records({})
+	await active_frame()
+	bindings("record refreshed")
+	check(studio.car.customisation.aero=="wing","live main model has the requested rear aero")
+	check(studio.preparing,"input keeps cold full-finish work paused")
+	if DisplayServer.get_name()!="headless":
+		await RenderingServer.frame_post_draw
+		check(root.get_texture().get_image().save_png(output.path_join("early-painted-wing.png"))==OK,"capture live paint and fitted parts before full preparation")
+	studio.queue_free()
+	for _frame: int in range(12): await process_frame
+	print("GARAGE_OPENING_TOOLS ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/profile_garage_cold_open.gd b/game/tests/profile_garage_cold_open.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/profile_garage_cold_open.gd
@@ -0,0 +1,49 @@
+extends SceneTree
+## Isolated first-frame attribution. Variants alter only in-memory script copies.
+var output: String="res://../build/garage-cold-open"
+var variant: String="original"
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	OS.set_environment("BMT_API_URL","")
+	for arg: String in OS.get_cmdline_user_args():
+		if arg.begins_with("--output="): output=arg.trim_prefix("--output=")
+		if arg.begins_with("--variant="): variant=arg.trim_prefix("--variant=")
+	output=ProjectSettings.globalize_path(output)
+	DirAccess.make_dir_recursive_absolute(output)
+	var script: GDScript=load("res://ui/car_showroom.gd")
+	var source: String=script.source_code.replace("\r\n","\n")
+	var boundary: int=source.find("\nfunc refresh_thumbnail()")
+	var remaining: String=source.substr(boundary)
+	source=source.left(boundary)
+	source=source.replace("func _ready() -> void:\n","func _ready() -> void:\n\tvar cold_stamp: int=Time.get_ticks_usec()\n")
+	for marker: String in ["\tworld.add_child(car)","\telse: ShowroomStudio.build(world,car)","\tweathering.configure(car, \"pine\", VehicleCatalog.config(vehicle_id))","\tweathering.restore(condition)","\tif not read_only: _cache_pick_meshes(car)"]:
+		source=source.replace(marker,marker+"\n\tprint(\"COLD_STAGE "+marker.strip_edges().replace('"','')+" \",(Time.get_ticks_usec()-cold_stamp)/1000.0)\n\tcold_stamp=Time.get_ticks_usec()")
+	if variant=="no_reflections": source=source.replace("reflections.build(self,world,turntable)","reflections.owner=self # diagnostic: no reflection views")
+	if variant=="no_pick_meshes": source=source.replace("if not read_only: _cache_pick_meshes(car)","pass # diagnostic: no picking preparation")
+	script.source_code=source+remaining
+	if script.reload()!=OK: quit(1);return
+	if variant=="no_sky":
+		var lighting: GDScript=load("res://ui/garage_environment.gd")
+		lighting.source_code=lighting.source_code.replace("environment.environment.sky = ShowroomStudio.cached_sky","environment.environment.sky = null").replace("Environment.REFLECTION_SOURCE_SKY","Environment.REFLECTION_SOURCE_DISABLED")
+		assert(lighting.reload()==OK)
+	root.size=Vector2i(1280,720)
+	var began: int=Time.get_ticks_usec()
+	var view:=CarShowroom.new()
+	view.garage_mode=true
+	view.size=Vector2(1180,480)
+	root.add_child(view)
+	var report: Dictionary={"variant":variant,"call_ms":(Time.get_ticks_usec()-began)/1000.0,"frames":[]}
+	print("COLD_DISPATCH ",report.call_ms)
+	for index: int in range(12):
+		var tick: int=Time.get_ticks_usec()
+		if DisplayServer.get_name()!="headless": await RenderingServer.frame_post_draw
+		await process_frame
+		var frame: Dictionary={"frame":index,"ms":(Time.get_ticks_usec()-tick)/1000.0,"mesh":Performance.get_monitor(Performance.PIPELINE_COMPILATIONS_MESH),"surface":Performance.get_monitor(Performance.PIPELINE_COMPILATIONS_SURFACE),"draw":Performance.get_monitor(Performance.PIPELINE_COMPILATIONS_DRAW)}
+		report.frames.append(frame)
+		print("COLD_DRAW ",JSON.stringify(frame))
+	if DisplayServer.get_name()!="headless": root.get_texture().get_image().save_png(output.path_join("garage.png"))
+	view.queue_free()
+	for _i: int in range(8): await process_frame
+	var file:=FileAccess.open(output.path_join("profile.json"),FileAccess.WRITE)
+	file.store_string(JSON.stringify(report,"  "))
+	quit()
