diff --git a/game/ui/garage_car_cache.gd b/game/ui/garage_car_cache.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/garage_car_cache.gd
@@ -0,0 +1,96 @@
+extends RefCounted
+## Offline rest-pose geometry for the Garage. Meshes are shared; finishes are owned.
+const Cache=preload("res://vehicle/prepared_car_cache.gd")
+const DIRECTORY: String="res://assets/garage/cars_v1/"
+const SCHEMA: String="garage-rest-v1"
+static var enabled: bool=true
+static var hits: int=0
+static var source_hashes: Dictionary={}
+
+static func geometry_key(car: CarVisual) -> Array:
+	var config: HandlingConfig=VehicleCatalog.config(car.vehicle_id)
+	return [SCHEMA,car.vehicle_id,car.editable_kits,car.batch_parts,VisualGeometry.optimize_model_geometry,HandlingConfig.BODY_SCALE,config.wheelbase,config.track_width]
+
+static func geometry_sources() -> Dictionary:
+	var result: Dictionary={}
+	for file: String in DirAccess.get_files_at("res://vehicle"):
+		if not file.ends_with(".gd"): continue
+		if file in ["car_visual.gd","vehicle_models.gd","visual_geometry.gd"] or file.begins_with("compact_") or file.begins_with("electric_") or file.begins_with("kart_") or file.begins_with("forklift_"):
+			result[file]=FileAccess.get_sha256("res://vehicle/"+file)
+	return result
+
+static func restore(car: CarVisual) -> bool:
+	if not enabled or car.simple_model or car.customisation!=VehicleCustomisation.defaults(): return false
+	var path: String=DIRECTORY+car.vehicle_id+".scn"
+	if not ResourceLoader.exists(path): return false
+	var scene: PackedScene=load(path)
+	var holder: Node3D=scene.instantiate()
+	var data: Dictionary=holder.get_meta("garage_rest",{})
+	if OS.has_feature("editor") and FileAccess.file_exists("res://vehicle/car_visual.gd"):
+		if source_hashes.is_empty(): source_hashes=geometry_sources()
+		if data.get("sources",{})!=source_hashes:
+			holder.free()
+			return false
+	if data.get("key",[])!=geometry_key(car):
+		holder.free()
+		return false
+	var copies: Dictionary={"mutable":Cache._mutable_roles(data)}
+	Cache._isolate(holder,copies)
+	for child: Node in holder.get_children():
+		holder.remove_child(child)
+		Cache._own(child,null)
+		car.add_child(child)
+	holder.free()
+	car.body=car.get_node(data.body)
+	for field: String in ["front_wheels","rear_wheels","rolling_wheels","brake_lights"]:
+		var nodes: Array=car.get(field)
+		for path_to_node: NodePath in data[field]: nodes.append(car.get_node(path_to_node))
+	car.wheel_radii.assign(data.wheel_radii)
+	car.wheel_rest_positions.assign(data.wheel_rest_positions)
+	for field: String in ["brake_material","accent_roof","underside_material"]: car.set(field,Cache._material(data[field],copies))
+	for slot: String in data.paint_materials: car.paint_materials[slot]=Cache._material(data.paint_materials[slot],copies)
+	for declaration: Dictionary in data.paint_variants:
+		var value: Dictionary=declaration.duplicate()
+		value.material=Cache._material(declaration.material,copies)
+		car.paint_variants.append(value)
+	for category: String in data.kit_frames:
+		car.kit_frames[category]=[]
+		for path_to_node: NodePath in data.kit_frames[category]: car.kit_frames[category].append(car.get_node(path_to_node))
+	hits+=1
+	return true
+
+static func bake(car: CarVisual) -> Error:
+	var entry: Dictionary={}
+	for candidate: Dictionary in Cache.entries:
+		if candidate.key==Cache.key_for(car): entry=candidate;break
+	if entry.is_empty(): return ERR_CANT_CREATE
+	var copies: Dictionary={"mutable":Cache._mutable_roles(entry),"snapshots":entry.material_snapshots}
+	var holder: Node3D=Cache._instantiate(entry,copies)
+	# ImmediateMesh drawing commands are not stored by ResourceSaver. Preserve
+	# their actual surface arrays in a serializable mesh before packing.
+	for node: Node in holder.find_children("*","MeshInstance3D",true,false):
+		if not node.mesh is ImmediateMesh: continue
+		var saved:=ArrayMesh.new()
+		for index: int in range(node.mesh.get_surface_count()):
+			saved.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,node.mesh.surface_get_arrays(index))
+			saved.surface_set_material(index,node.mesh.surface_get_material(index))
+		node.mesh=saved
+	var data: Dictionary={"schema":SCHEMA,"sources":geometry_sources(),"key":geometry_key(car),"vehicle":car.vehicle_id,"editable":car.editable_kits,
+		"body":entry.body,"wheel_radii":entry.wheel_radii,"wheel_rest_positions":entry.wheel_rest_positions,
+		"paint_materials":{},"paint_variants":[],"kit_frames":entry.kit_frames}
+	for field: String in ["front_wheels","rear_wheels","rolling_wheels","brake_lights"]: data[field]=entry[field]
+	for field: String in ["brake_material","accent_roof","underside_material"]: data[field]=Cache._material(entry[field],copies)
+	for slot: String in entry.paint_materials: data.paint_materials[slot]=Cache._material(entry.paint_materials[slot],copies)
+	for declaration: Dictionary in entry.paint_variants:
+		var value: Dictionary=declaration.duplicate()
+		value.material=Cache._material(declaration.material,copies)
+		data.paint_variants.append(value)
+	holder.set_meta("garage_rest",data)
+	for child: Node in holder.get_children(): Cache._own(child,holder)
+	var scene:=PackedScene.new()
+	var error: Error=scene.pack(holder)
+	if error==OK:
+		DirAccess.make_dir_recursive_absolute(DIRECTORY)
+		error=ResourceSaver.save(scene,DIRECTORY+car.vehicle_id+".scn",ResourceSaver.FLAG_COMPRESS)
+	holder.free()
+	return error
diff --git a/game/ui/garage_opening_showroom.gd b/game/ui/garage_opening_showroom.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/garage_opening_showroom.gd
@@ -0,0 +1,288 @@
+extends "res://ui/car_showroom.gd"
+## Keep the ordinary Garage page usable while its real studio takes first draws.
+signal studio_prepared
+signal studio_interactive
+const FirstDraw=preload("res://ui/garage_first_draw.gd")
+var preparing: bool=true
+var can_begin_studio: Callable
+var _picture: TextureRect
+var _pending: Dictionary={}
+var _record_choice: Dictionary={}
+var _facade: RefCounted
+var _warm_view: SubViewport
+var _warm_camera: Camera3D
+var _last_input: int=0
+var interaction_ready: bool=false
+var opening_started: int=0
+var live_ready_ms: float=0.0
+var _loads: Array[String]=[]
+var _resources: Array[Resource]=[]
+var _lights: Array[Dictionary]=[]
+var _tree_ref: WeakRef
+var _first: Node
+var _motion_was_running: bool=false
+var _last_uploads: int=-1
+
+func _ready() -> void:
+	opening_started=Time.get_ticks_usec()
+	_tree_ref=weakref(get_tree())
+	set_process(false)
+	mouse_filter=Control.MOUSE_FILTER_STOP
+	_picture=TextureRect.new()
+	_picture.name="GarageOpeningPicture"
+	_picture.expand_mode=TextureRect.EXPAND_IGNORE_SIZE
+	_picture.stretch_mode=TextureRect.STRETCH_KEEP_ASPECT_COVERED
+	_picture.mouse_filter=Control.MOUSE_FILTER_IGNORE
+	_picture.texture=load("res://assets/garage/previews_v1/"+vehicle_id+".png")
+	add_child(_picture)
+	MenuStyle.fill(_picture)
+	child_entered_tree.connect(func(_child: Node) -> void: _cover.call_deferred())
+	weathering.restore(condition)
+	set_process_input(true)
+	RenderingServer.frame_pre_draw.connect(_sync_live_finish)
+	# Resource decoding may run off the UI thread; nodes and renderer stay owned.
+	for path: String in ["res://assets/garage/cars_v1/"+vehicle_id+".scn",GarageEnvironment.PREPARED_ARCHITECTURE]:
+		if ResourceLoader.exists(path) and ResourceLoader.load_threaded_request(path)==OK: _loads.append(path)
+	_begin_studio.call_deferred()
+
+func _cover() -> void:
+	if preparing and is_instance_valid(_picture) and _picture.get_index()!=get_child_count()-1:
+		move_child(_picture,get_child_count()-1)
+
+func _begin_studio() -> void:
+	await get_tree().process_frame
+	if not is_inside_tree() or is_queued_for_deletion(): return
+	while _current_studio():
+		while _current_studio() and not _entry_presented(): await get_tree().process_frame
+		if not _current_studio(): return
+		# Finish the incoming page's actual draw before submitting a native world.
+		if DisplayServer.get_name()!="headless": await RenderingServer.frame_post_draw
+		await get_tree().process_frame
+		if _entry_presented(): break
+	if not _current_studio(): return
+	for path: String in _loads:
+		while _current_studio() and ResourceLoader.load_threaded_get_status(path)==ResourceLoader.THREAD_LOAD_IN_PROGRESS: await get_tree().process_frame
+		if not _current_studio(): return
+		if ResourceLoader.load_threaded_get_status(path)==ResourceLoader.THREAD_LOAD_LOADED: _resources.append(ResourceLoader.load_threaded_get(path))
+	_loads.clear()
+	cooperative_build=true
+	await super._ready()
+	if not is_inside_tree() or is_queued_for_deletion(): return
+	# One MSAA level prevents renderer precompilation switching back and forth
+	# between the live view and its two reflection captures.
+	for view: SubViewport in reflections.views: view.msaa_3d=showroom_viewport.msaa_3d
+	_warm_view=SubViewport.new()
+	_warm_view.world_3d=showroom_viewport.find_world_3d()
+	_warm_view.size=Vector2i(64,64)
+	_warm_view.msaa_3d=showroom_viewport.msaa_3d
+	_warm_view.render_target_update_mode=SubViewport.UPDATE_DISABLED
+	add_child(_warm_view)
+	_warm_camera=Camera3D.new()
+	_warm_camera.cull_mask=8
+	_warm_view.add_child(_warm_camera)
+	_warm_camera.current=true
+	for light: Node in camera.get_parent().find_children("*","Light3D",true,false):
+		var copy: Node=light.duplicate()
+		copy.layers=8
+		copy.light_cull_mask=8
+		light.get_parent().add_child(copy)
+		_lights.append({"source":weakref(light),"mask":light.light_cull_mask,"copy":copy})
+		light.light_cull_mask&=7
+	while _current_studio():
+		if not _pending.is_empty():
+			var target: Dictionary=_pending
+			_pending={}
+			var previous: Node3D=turntable
+			super.replace_car(target.vehicle,target.paint,target.wear,target.parts)
+			super.finish_car_transition()
+			if is_instance_valid(previous) and previous!=turntable and previous.get_parent()!=null:
+				previous.get_parent().remove_child(previous)
+				previous.queue_free()
+		var first: Node=FirstDraw.new()
+		_first=first
+		add_child(first)
+		first.hold(car)
+		first.hold(camera.get_parent())
+		_facade=preload("res://ui/garage_opening_facade.gd").new()
+		_facade.build(first.pending)
+		move_child(_picture,get_child_count()-1)
+		showroom_viewport.render_target_update_mode=SubViewport.UPDATE_ONCE
+		reflections.request_draw()
+		if DisplayServer.get_name()!="headless": await RenderingServer.frame_post_draw
+		if not _current_studio(): return
+		if _pending.is_empty(): _picture.hide()
+		# Present the viewport texture once too: its first canvas resolve can be
+		# a different program from rendering the world behind the picture.
+		showroom_viewport.render_target_update_mode=SubViewport.UPDATE_ONCE
+		if DisplayServer.get_name()!="headless": await RenderingServer.frame_post_draw
+		if not _current_studio(): return
+		# Settle native render targets before accepting the first drag. The first
+		# world draw and its canvas presentation may submit work on separate frames.
+		for _settle: int in range(3):
+			await get_tree().process_frame
+			if not _current_studio(): return
+			super._process(0.0)
+			showroom_viewport.render_target_update_mode=SubViewport.UPDATE_ONCE
+			reflections.request_draw()
+			if DisplayServer.get_name()!="headless": await RenderingServer.frame_post_draw
+		interaction_ready=true
+		_last_input=Time.get_ticks_msec()
+		if live_ready_ms==0.0:
+			live_ready_ms=(Time.get_ticks_usec()-opening_started)/1000.0
+			print("GARAGE_LIVE_READY_MS ",live_ready_ms)
+		set_process(true)
+		studio_interactive.emit()
+		while not first.pending.is_empty() and _current_preparation():
+			# Do not even reveal a cold native material into the shadow pass while
+			# input is active. Wait before prepare() exposes its next group.
+			while _current_preparation() and (not is_visible_in_tree() or Time.get_ticks_msec()-_last_input<750): await get_tree().process_frame
+			if not _current_preparation(): break
+			await first.prepare(_draw_studio,_current_warm_batch)
+		if not _current_studio(): return
+		interaction_ready=false
+		_facade.restore()
+		_facade=null
+		# Release held visibility synchronously before the next generation holds it.
+		for job: Dictionary in first.pending:
+			var held: Object=job.node.get_ref()
+			if is_instance_valid(held): held.show()
+		first.pending.clear()
+		first.queue_free()
+		_first=null
+		if _pending.is_empty(): break
+	_warm_view.queue_free()
+	_warm_view=null
+	_restore_lights()
+	_resources.clear()
+	preparing=false
+
+	if not _record_choice.is_empty(): super.update_records(_record_choice)
+	_picture.queue_free()
+	_picture=null
+	set_process(true)
+	studio_prepared.emit()
+	invalidate_render()
+
+func _current_preparation() -> bool:
+	return _current_studio() and _pending.is_empty()
+
+func _entry_presented() -> bool:
+	return is_visible_in_tree() and (not can_begin_studio.is_valid() or can_begin_studio.call())
+
+func _current_warm_batch() -> bool:
+	return _current_preparation() and is_visible_in_tree() and Time.get_ticks_msec()-_last_input>=750
+
+func _current_studio() -> bool:
+	return is_inside_tree() and not is_queued_for_deletion()
+
+func _draw_studio() -> bool:
+	while _current_studio() and not is_visible_in_tree(): await get_tree().process_frame
+	# Compile full finishes only after the player pauses their interaction.
+	while _current_preparation() and Time.get_ticks_msec()-_last_input<750: await get_tree().process_frame
+	if not _current_preparation(): return false
+	_warm_camera.transform=camera.transform
+	_warm_camera.fov=camera.fov
+	_warm_camera.keep_aspect=camera.keep_aspect
+	_warm_view.render_target_update_mode=SubViewport.UPDATE_ONCE
+	showroom_viewport.render_target_update_mode=SubViewport.UPDATE_ONCE
+	reflections.request_draw()
+	if DisplayServer.get_name()!="headless": await RenderingServer.frame_post_draw
+	await get_tree().process_frame
+	return _current_studio()
+
+func replace_car(id: String,paint: Dictionary,wear: Dictionary,parts: Dictionary={}) -> void:
+	if preparing:
+		_pending={"vehicle":id,"paint":paint.duplicate(true),"wear":wear.duplicate(true),"parts":parts.duplicate(true)}
+		if _picture!=null:
+			_picture.texture=load("res://assets/garage/previews_v1/"+id+".png")
+			_picture.show()
+		return
+	super.replace_car(id,paint,wear,parts)
+
+func apply_livery(value: Dictionary,animate_paint: bool=false) -> void:
+	if preparing and interaction_ready:
+		super.apply_livery(value,animate_paint)
+		_refresh_facade()
+		return
+	if preparing:
+		if _pending.is_empty(): _pending={"vehicle":vehicle_id,"paint":livery.duplicate(true),"wear":condition.duplicate(true),"parts":customisation.duplicate(true)}
+		_pending.paint=value.duplicate(true)
+		return
+	super.apply_livery(value,animate_paint)
+
+func apply_customisation(value: Dictionary,animate_kit: bool=false) -> void:
+	if preparing and interaction_ready:
+		super.apply_customisation(value,animate_kit)
+		_refresh_facade()
+		return
+	if preparing:
+		if _pending.is_empty(): _pending={"vehicle":vehicle_id,"paint":livery.duplicate(true),"wear":condition.duplicate(true),"parts":customisation.duplicate(true)}
+		_pending.parts=value.duplicate(true)
+		return
+	super.apply_customisation(value,animate_kit)
+
+func update_records(settings: Dictionary) -> void:
+	if preparing:
+		_record_choice=settings.duplicate(true)
+		if interaction_ready:
+			super.update_records(settings)
+			_refresh_facade()
+	else: super.update_records(settings)
+
+func _drag(event: InputEvent) -> void:
+	if not preparing or interaction_ready: super._drag(event)
+
+func _input(event: InputEvent) -> void:
+	if preparing and is_visible_in_tree() and (event is InputEventMouse or event is InputEventScreenTouch or event is InputEventScreenDrag or event is InputEventKey): _last_input=Time.get_ticks_msec()
+
+func _process(delta: float) -> void:
+	if not preparing or interaction_ready: super._process(delta)
+	if DisplayServer.get_name()=="headless": _sync_live_finish()
+
+func _sync_live_finish() -> void:
+	# Tweens advance after node processing. Copy their current uniforms just
+	# before drawing so the live sweep uses the same progress as its source.
+	if interaction_ready and _facade!=null:
+		var motion: bool=(paint_motion!=null and paint_motion.is_running()) or (kit_motion!=null and kit_motion.is_running())
+		if motion or _motion_was_running: _refresh_facade()
+		elif weathering.parameter_uploads!=_last_uploads: _facade.sync_parameters()
+		else: _facade.sync_poses()
+		_motion_was_running=motion
+		_last_uploads=weathering.parameter_uploads
+
+func _refresh_facade() -> void:
+	if _facade!=null and is_instance_valid(_first):
+		_facade.refresh(camera.get_parent(),_first)
+
+func _exit_tree() -> void:
+	super._exit_tree()
+
+func _notification(what: int) -> void:
+	super._notification(what)
+	if what==NOTIFICATION_PREDELETE and RenderingServer.frame_pre_draw.is_connected(_sync_live_finish): RenderingServer.frame_pre_draw.disconnect(_sync_live_finish)
+	if what==NOTIFICATION_PREDELETE:
+		if _facade!=null:
+			_facade.restore()
+			_facade=null
+		_restore_lights()
+	if what==NOTIFICATION_PREDELETE and not _loads.is_empty():
+		_retire_loads(_loads.duplicate(),_tree_ref)
+		_loads.clear()
+
+func _restore_lights() -> void:
+	for item: Dictionary in _lights:
+		var light: Object=item.source.get_ref()
+		if is_instance_valid(light): light.light_cull_mask=item.mask
+		if is_instance_valid(item.copy):
+			if item.copy.get_parent()!=null: item.copy.get_parent().remove_child(item.copy)
+			item.copy.queue_free()
+	_lights.clear()
+
+static func _retire_loads(paths: Array[String],tree_ref: WeakRef) -> void:
+	var pending: Array[String]=[]
+	for path: String in paths:
+		var status: int=ResourceLoader.load_threaded_get_status(path)
+		if status==ResourceLoader.THREAD_LOAD_IN_PROGRESS: pending.append(path)
+		elif status==ResourceLoader.THREAD_LOAD_LOADED: ResourceLoader.load_threaded_get(path)
+	var tree: Object=tree_ref.get_ref()
+	if not pending.is_empty() and is_instance_valid(tree): tree.process_frame.connect(_retire_loads.bind(pending,tree_ref),CONNECT_ONE_SHOT)
diff --git a/game/ui/garage_first_draw.gd b/game/ui/garage_first_draw.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/garage_first_draw.gd
@@ -0,0 +1,63 @@
+extends Node
+## Garage-owned staging survives its retained page moving between menu slots.
+const Key=preload("res://race/world_render_preparation.gd")
+static var warmed: Dictionary={}
+var pending: Array[Dictionary]=[]
+func queue_geometry(node: GeometryInstance3D) -> bool:
+	var key: String=Key._key(node)
+	for index: int in range(pending.size()-1,-1,-1):
+		if pending[index].node.get_ref()==node: pending.remove_at(index)
+	if warmed.has(key):
+		node.show()
+		return false
+	pending.append({"node":weakref(node),"key":key})
+	node.hide()
+	return true
+func hold(world: Node) -> void:
+	for node: GeometryInstance3D in world.find_children("*","GeometryInstance3D",true,false):
+		if not node.is_visible_in_tree(): continue
+		var key: String=Key._key(node)
+		if warmed.has(key): continue
+		pending.append({"node":weakref(node),"key":key})
+		node.hide()
+func prepare(draw: Callable,current: Callable) -> bool:
+	while not pending.is_empty():
+		if not current.is_valid() or not current.call(): return false
+		var key: String=pending[0].key
+		var shown: int=0
+		var copies: Array[MeshInstance3D]=[]
+		var drawn_keys: Array[Dictionary]=[]
+		var camera: Camera3D=get_parent().get("camera")
+		for index: int in range(pending.size()-1,-1,-1):
+			if pending[index].key!=key or shown>=8: continue
+			var node: Object=pending[index].node.get_ref()
+			if is_instance_valid(node):
+				drawn_keys.append({"node":weakref(node),"key":Key._key(node)})
+				if node is MeshInstance3D:
+					var copy:=MeshInstance3D.new()
+					copy.set_meta("garage_opening_warm",true)
+					copy.mesh=node.mesh
+					copy.material_override=node.material_override
+					copy.material_overlay=node.material_overlay
+					copy.cast_shadow=node.cast_shadow
+					copy.layers=8
+					for surface: int in range(node.mesh.get_surface_count()): copy.set_surface_override_material(surface,node.get_surface_override_material(surface))
+					camera.get_parent().add_child(copy)
+					copy.global_transform=node.global_transform
+					var delta: Vector3=(node.to_local(camera.global_position)-node.get_aabb().get_center()).abs()
+					copy.extra_cull_margin=maxf(node.extra_cull_margin,maxf(delta.x,maxf(delta.y,delta.z))+camera.near+1.0)
+					copies.append(copy)
+			pending.remove_at(index)
+			shown+=1
+		var drawn: bool=await draw.call()
+		for copy: MeshInstance3D in copies:
+			if is_instance_valid(copy):
+				if copy.get_parent()!=null: copy.get_parent().remove_child(copy)
+				copy.queue_free()
+		if not current.is_valid() or not current.call(): return false
+		if drawn:
+			if warmed.size()>=512: warmed.clear()
+			for entry: Dictionary in drawn_keys:
+				var node: Object=entry.node.get_ref()
+				if is_instance_valid(node) and Key._key(node)==entry.key: warmed[entry.key]=true
+	return current.is_valid() and current.call()
diff --git a/game/ui/garage_opening_facade.gd b/game/ui/garage_opening_facade.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/garage_opening_facade.gd
@@ -0,0 +1,149 @@
+extends RefCounted
+## Temporary live geometry while the original full finishes take their first draws.
+var items: Array[Dictionary]=[]
+var shaders: Dictionary={}
+var materials: Dictionary={}
+
+func build(pending: Array[Dictionary]) -> void:
+	for job: Dictionary in pending:
+		var source: Object=job.node.get_ref()
+		if not source is MeshInstance3D: continue
+		var copy:=MeshInstance3D.new()
+		copy.name="OpeningLiveGeometry"
+		copy.set_meta("garage_opening_proxy",true)
+		copy.mesh=source.mesh
+		copy.transform=source.transform
+		copy.layers=source.layers
+		copy.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+		if source.material_override!=null: copy.material_override=_finish(source.material_override)
+		else:
+			for index: int in range(source.mesh.get_surface_count()): copy.set_surface_override_material(index,_finish(source.get_active_material(index)))
+		if source.material_overlay!=null: copy.material_overlay=_finish(source.material_overlay)
+		var parent: Node=source.get_parent()
+		if source.layers&4==0:
+			while parent.get_parent() is Node3D: parent=parent.get_parent()
+		parent.add_child(copy)
+		if parent!=source.get_parent(): copy.global_transform=source.global_transform
+		items.append({"source":weakref(source),"copy":copy,"layers":source.layers,"signature":_signature(source)})
+		source.layers=8
+
+func _signature(source: MeshInstance3D) -> Array:
+	var result: Array=[source.mesh,source.material_overlay]
+	for surface: int in range(source.mesh.get_surface_count()):
+		var material: Material=source.get_active_material(surface)
+		result.append(material)
+		result.append(material.shader if material is ShaderMaterial else null)
+	return result
+
+func refresh(world: Node,stage: Node) -> void:
+	var known: Dictionary={}
+	for index: int in range(items.size()-1,-1,-1):
+		var item: Dictionary=items[index]
+		var source: Object=item.source.get_ref()
+		if not is_instance_valid(source) or not source.is_inside_tree():
+			if is_instance_valid(item.copy):
+				if item.copy.get_parent()!=null: item.copy.get_parent().remove_child(item.copy)
+				item.copy.free()
+			items.remove_at(index)
+			continue
+		known[source]=true
+		# Kit rebuilding reapplies reflection membership to the whole turntable.
+		# Keep every held original outside the visible camera during preparation.
+		source.layers=8
+		source.hide()
+		var signature: Array=_signature(source)
+		if signature==item.signature: continue
+		item.signature=signature
+		item.copy.mesh=source.mesh
+		item.copy.material_overlay=_finish(source.material_overlay)
+		if source.material_override==null: item.copy.material_override=null
+		for surface: int in range(source.mesh.get_surface_count()):
+			var material: Material=source.get_active_material(surface)
+			materials.erase(material)
+			if source.material_override!=null: item.copy.material_override=_finish(material)
+			else: item.copy.set_surface_override_material(surface,_finish(material))
+		stage.queue_geometry(source)
+	for source: Node in world.find_children("*","MeshInstance3D",true,false):
+		if known.has(source) or source.has_meta("garage_opening_proxy") or source.has_meta("garage_opening_warm") or not source.is_visible_in_tree(): continue
+		if not stage.queue_geometry(source): continue
+		build([{"node":weakref(source)}])
+	sync_parameters()
+
+func sync_poses() -> void:
+	for item: Dictionary in items:
+		var source: Object=item.source.get_ref()
+		if not is_instance_valid(source) or not is_instance_valid(item.copy): continue
+		if item.copy.get_parent()!=source.get_parent():
+			item.copy.global_transform=source.global_transform
+			item.copy.visible=source.get_parent().is_visible_in_tree()
+		elif item.copy.transform!=source.transform: item.copy.transform=source.transform
+
+func sync_parameters() -> void:
+	sync_poses()
+	for original: Material in materials:
+		var target: ShaderMaterial=materials[original]
+		if original is ShaderMaterial:
+			for declaration: Dictionary in target.shader.get_shader_uniform_list():
+				var value: Variant=original.get_shader_parameter(declaration.name)
+				if value!=null and target.get_shader_parameter(declaration.name)!=value: target.set_shader_parameter(declaration.name,value)
+		else:
+			if target.get_shader_parameter("paint_color")!=original.albedo_color: target.set_shader_parameter("paint_color",original.albedo_color)
+
+func _finish(original: Material) -> Material:
+	if original==null: return null
+	if materials.has(original): return materials[original]
+	if original is ShaderMaterial and original.shader.code.contains("unshaded"): return original
+	var alpha: bool=original is StandardMaterial3D and original.transparency!=BaseMaterial3D.TRANSPARENCY_DISABLED
+	var cull: int=original.cull_mode if original is StandardMaterial3D else BaseMaterial3D.CULL_BACK
+	var key: String=str(alpha)+"-"+str(cull)
+	if not shaders.has(key):
+		var shader:=Shader.new()
+		# One common light finish retains the actual livery, stickers and wash
+		# volumes without creating a new lighting program for every room finish.
+		var code: String=preload("res://vehicle/vehicle_weathering.gdshader").code
+		code=code.replace("render_mode diffuse_burley, specular_schlick_ggx;","render_mode unshaded,"+("cull_front" if cull==BaseMaterial3D.CULL_FRONT else "cull_disabled" if cull==BaseMaterial3D.CULL_DISABLED else "cull_back")+";")
+		code=code.replace("void vertex() {","uniform vec4 opening_glow:source_color=vec4(0.0);\nuniform float opening_grow=0.0;\nvarying vec3 opening_normal;\nvoid vertex() {\n VERTEX+=NORMAL*opening_grow;\n opening_normal=MODEL_NORMAL_MATRIX*NORMAL;")
+		var end: int=code.rfind("}")
+		code=code.insert(end,"\n ALBEDO*=0.48+0.52*max(0.0,dot(normalize(opening_normal),normalize(vec3(-0.5,0.9,-0.4))));\n EMISSION=opening_glow.rgb;\n"+("ALPHA=paint_color.a;\n" if alpha else ""))
+		shader.code=code
+		shaders[key]=shader
+	var result:=ShaderMaterial.new()
+	result.shader=shaders[key]
+	if original is ShaderMaterial and (original.shader.code.contains("garage_paint_progress") or original.shader.code.contains("garage_kit_progress")):
+		var motion_code: String=original.shader.code.replace("render_mode ","render_mode unshaded,")
+		if not shaders.has(motion_code):
+			var motion_shader:=Shader.new()
+			motion_shader.code=motion_code
+			shaders[motion_code]=motion_shader
+		result.shader=shaders[motion_code]
+	result.set_shader_parameter("mesh_to_body",Transform3D.IDENTITY)
+	result.set_shader_parameter("mesh_to_wheel",Transform3D.IDENTITY)
+	if original is ShaderMaterial:
+		for declaration: Dictionary in result.shader.get_shader_uniform_list():
+			var value: Variant=original.get_shader_parameter(declaration.name)
+			if value!=null: result.set_shader_parameter(declaration.name,value)
+		var pigment: Variant=null
+		for parameter: String in ["paint_color","finish_color","timber_color","color"]:
+			pigment=original.get_shader_parameter(parameter)
+			if pigment!=null: break
+		result.set_shader_parameter("paint_color",pigment if pigment!=null else Color("53616b"))
+	else:
+		result.set_shader_parameter("paint_color",original.albedo_color)
+		result.set_shader_parameter("opening_glow",original.emission*original.emission_energy_multiplier if original.emission_enabled else Color.BLACK)
+		if original.get("grow")==true: result.set_shader_parameter("opening_grow",original.get("grow_amount"))
+	if original.next_pass!=null: result.next_pass=_finish(original.next_pass)
+	materials[original]=result
+	return result
+
+func restore() -> void:
+	for item: Dictionary in items:
+		var source: Object=item.source.get_ref()
+		if is_instance_valid(source):
+			source.layers=item.layers
+			source.show()
+		if is_instance_valid(item.copy):
+			if item.copy.get_parent()!=null: item.copy.get_parent().remove_child(item.copy)
+			item.copy.free()
+	items.clear()
+	materials.clear()
+	shaders.clear()
