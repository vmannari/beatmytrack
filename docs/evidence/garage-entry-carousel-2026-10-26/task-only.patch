+base = base[:start]+section+base[end:]
+(SCOPE/app_path).parent.mkdir(parents=True, exist_ok=True)
+(SCOPE/app_path).write_bytes(base.encode('utf-8'))
+for path in ('AGENTS.md', 'DEVELOPMENT_STATUS.md'):
