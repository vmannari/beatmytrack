+func run() -> void:
+	root.size = Vector2i(1280,720)
+	var world := Node3D.new()
+	root.add_child(world)
+	var began: int = Time.get_ticks_usec()
+	var car := CarVisual.new()
+	car.editable_kits = true
+	world.add_child(car)
+	print("PROFILE_CAR_MS ", (Time.get_ticks_usec()-began)/1000.0)
