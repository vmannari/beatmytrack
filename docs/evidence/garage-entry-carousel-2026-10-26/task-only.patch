+    without_note, count = re.subn(r'<!-- GARAGE-ENTRY-CAROUSEL-20261026 -->\r?\n.*?<!-- /GARAGE-ENTRY-CAROUSEL-20261026 -->\r?\n\r?\n', '', content, count=1, flags=re.S)
