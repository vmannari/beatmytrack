@@ -1,9 +1,37 @@
 shader_type canvas_item;
 render_mode unshaded;
 
+uniform bool backdrop = false;
+uniform bool compact_preview = false;
+uniform float atlas_columns = 5.0;
+
 void fragment() {
-	float shape = texture(TEXTURE,UV).a;
-	float grey = mix(0.64,0.46,UV.y);
