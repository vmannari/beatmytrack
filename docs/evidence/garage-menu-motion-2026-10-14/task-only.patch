+$evidence = 'res://../docs/evidence/garage-menu-motion-2026-10-14/' + $Renderer
+$logs = Join-Path $repoRoot ('docs/evidence/garage-menu-motion-2026-10-14/'+$Renderer+'/logs')
+New-Item -ItemType Directory -Force -Path $logs | Out-Null
