+from pathlib import Path
+import hashlib
+import json
+import struct
+import zlib
+
+root = Path(__file__).resolve().parents[1]
+evidence = root / 'docs/evidence/garage-menu-motion-2026-10-14'
+folder = evidence / 'gl_compatibility/motion'
+frames = [(folder / 'cars-960.png', 700, 1000)]
+frames += [(folder / f'select-960-{i:02d}.png', 2, 75) for i in range(1, 13)]
+frames += [(folder / 'selected-960.png', 700, 1000)]
+frames += [(folder / f'back-960-{i:02d}.png', 2, 75) for i in range(1, 13)]
+frames += [(folder / 'cars-960.png', 700, 1000)]
+
+def parse(path):
+    source = path.read_bytes()
+    assert source[:8] == b'\x89PNG\r\n\x1a\n'
+    parts, at = [], 8
+    while at < len(source):
+        length = struct.unpack('>I', source[at:at+4])[0]
+        kind = source[at+4:at+8]
+        data = source[at+8:at+8+length]
+        assert struct.unpack('>I', source[at+8+length:at+12+length])[0] == zlib.crc32(kind+data) & 0xffffffff
+        parts.append((kind, data))
+        at += length+12
+    return parts
+
+def chunk(kind, data):
+    return struct.pack('>I', len(data))+kind+data+struct.pack('>I', zlib.crc32(kind+data) & 0xffffffff)
+
+first = parse(frames[0][0])
+header = next(data for kind, data in first if kind == b'IHDR')
+width, height = struct.unpack('>II', header[:8])
+result = bytearray(b'\x89PNG\r\n\x1a\n')+chunk(b'IHDR', header)
+for kind, data in first:
+    if kind not in [b'IHDR', b'IDAT', b'IEND']: result += chunk(kind, data)
+result += chunk(b'acTL', struct.pack('>II', len(frames), 0))
+sequence = 0
+for index, (path, delay, denominator) in enumerate(frames):
+    parts = parse(path)
+    assert next(data for kind, data in parts if kind == b'IHDR') == header
+    result += chunk(b'fcTL', struct.pack('>IIIIIHHBB', sequence, width, height, 0, 0, delay, denominator, 0, 0))
+    sequence += 1
+    for kind, data in parts:
+        if kind != b'IDAT': continue
+        if index == 0: result += chunk(b'IDAT', data)
+        else:
+            result += chunk(b'fdAT', struct.pack('>I', sequence)+data)
+            sequence += 1
+result += chunk(b'IEND', b'')
+target = evidence / 'garage-menu-transition.png'
+target.write_bytes(result)
+(evidence / 'motion.json').write_text(json.dumps({
+    'artifact': str(target.relative_to(root)), 'width': width, 'height': height,
+    'rendered_transition_frames': 24, 'endpoint_holds': 3,
+    'seconds': sum(delay/denominator for _, delay, denominator in frames),
+    'bytes': len(result), 'sha256': hashlib.sha256(result).hexdigest(),
+    'note': 'Lossless APNG from actual pinned-Godot renders; production tween stepped deterministically over 0.32 seconds in each direction, with added review holds. Playback is not a frame-time measurement.'
+}, indent=2)+'\n', encoding='utf-8')
+print(f'Garage selection/Back APNG: {width}x{height}, {len(frames)} frames, {len(result)} bytes')
