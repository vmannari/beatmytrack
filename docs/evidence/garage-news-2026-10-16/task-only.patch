+	_refresh_button.icon = MenuIcon.texture("restart")
+	_refresh_button.tooltip_text = "Refresh news"
+	_refresh_button.custom_minimum_size = Vector2(52,52)
+	header.add_child(_refresh_button)
+	var tabs := HBoxContainer.new()
+	add_child(tabs)
+	for id: String in ["news","friends"]:
+		var button := MenuStyle.button(id.capitalize(),_select_tab.bind(id))
+		button.custom_minimum_size.y = 52
+		button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		tabs.add_child(button)
+		_tabs[id] = button
+	_add_row = HBoxContainer.new()
+	add_child(_add_row)
