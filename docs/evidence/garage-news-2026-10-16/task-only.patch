+	_open.call_deferred()
+
+func _active() -> bool:
+	return is_visible_in_tree() and is_instance_valid(page) and page.section == "news" and page.tools.is_ancestor_of(self)
+
+func _visibility_changed() -> void:
+	if not _active():
+		if is_instance_valid(_poll): _poll.stop()
+	else: _open.call_deferred()
+
+func _select_tab(id: String) -> void:
+	_tab = id
+	_poll.stop()
+	_render()
+	_open()
+
+func _open() -> void:
+	if not _active() or service == null: return
+	if service.busy:
+		_waiting = true
+		return
+	_poll_count = 0
+	if _tab == "friends": await service.load_friends()
+	else: await service.refresh()
+	if _active(): _changed()
+
+func _changed() -> void:
+	if not _active(): return
+	_render()
+	if _waiting and service != null and not service.busy:
+		_waiting = false
+		_open.call_deferred()
+		return
+	if _tab == "news" and service != null and service.refreshing and _poll.is_stopped() and _poll_count < 4:
+		_poll.start(pow(2.0,_poll_count+1))
+
+func _poll_once() -> void:
+	if not _active() or _tab != "news" or service == null: return
+	_poll_count += 1
+	await service.refresh(true)
+
+func _send_friend() -> void:
+	if not _active() or service == null or _entry.text.strip_edges().is_empty(): return
+	await service.friend_action("send",_entry.text.strip_edges())
+	if is_instance_valid(_entry) and service.error.is_empty(): _entry.clear()
+
+func _friend_action(action: String, id: String) -> void:
+	if _active() and service != null: await service.friend_action(action,id)
+
+func _text(parent: Node, value: String, pixels: int = 16, muted: bool = false) -> Label:
+	var label := MenuStyle.label(value,pixels,muted)
+	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	parent.add_child(label)
+	return label
+
+func _render() -> void:
+	if not is_instance_valid(_list): return
+	for child: Node in _list.get_children():
+		_list.remove_child(child)
+		child.queue_free()
+	for id: String in _tabs:
+		var button: Button = _tabs[id]
+		button.add_theme_color_override("font_color",MenuStyle.ACCENT if id == _tab else MenuStyle.MUTED)
+	_add_row.visible = _tab == "friends" and service != null and service.available()
+	_refresh_button.disabled = service != null and service.busy
+	if service == null or not service.client.signed_in():
+		_text(_list,"Sign in to see your news.",18,true)
+		_list.add_child(MenuStyle.button("Sign in",func() -> void: page.account_requested.emit(),true))
+		return
+	if not service.available():
+		_text(_list,"News is unavailable on this server.",18,true)
+		return
+	if not service.error.is_empty(): _text(_list,service.error,16,true)
+	if _tab == "friends":
+		if service.friends.is_empty(): _text(_list,"Add friends using their racing names.",18,true)
+		for item: Dictionary in service.friends: _friend_card(item)
+		return
+	if service.items.is_empty():
+		_text(_list,"Checking news…" if service.busy or service.refreshing else "No news yet",20,true)
+		if not service.busy and not service.refreshing: _text(_list,"Race, publish tracks and add friends.",16,true)
+	for item: Dictionary in service.items: _news_card(item)
+	if not service.next_cursor.is_empty():
+		var more := MenuStyle.button("More",func() -> void:
+			if _active(): await service.more())
+		more.disabled = service.busy
+		_list.add_child(more)
+
+func _card() -> VBoxContainer:
+	var panel := PanelContainer.new()
+	panel.add_theme_stylebox_override("panel",MenuStyle.box(Color("182c39"),12))
+	_list.add_child(panel)
+	var column := VBoxContainer.new()
+	column.add_theme_constant_override("separation",5)
+	panel.add_child(column)
+	return column
+
+func _news_card(item: Dictionary) -> void:
+	var column := _card()
+	var metric: String = "lap" if item.get("metric","") == "lap" else "track"
+	var title: String = ""
+	match str(item.get("kind","")):
+		"milestone": title = "%s racers" % _count(int(item.get("count",0)))
+		"world_record": title = "New %s world record" % metric
+		"friend_overtake": title = "%s beat your %s time" % [str(item.get("actor_name","A friend")),metric]
+		"percentile_drop": title = "Outside the top %d%%" % int(item.get("threshold",0))
+	_text(column,title,20)
+	_text(column,str(item.get("track_name","")),18)
+	var detail: String = "Have raced your track" if item.get("kind","") == "milestone" else ""
+	if item.get("kind","") == "world_record": detail = str(item.get("actor_name",""))
+	if item.get("kind","") == "percentile_drop": detail = "Your %s time" % metric
+	var vehicle: String = str(item.get("vehicle_id",""))
+	if not vehicle.is_empty(): detail += (" · " if not detail.is_empty() else "")+VehicleCatalog.title(vehicle)
+	if item.has("time_ticks"):
+		var seconds: float = float(item.time_ticks)/maxf(1.0,float(item.get("tick_rate",120)))
+		detail += (" · " if not detail.is_empty() else "")+"%d:%06.3f" % [int(seconds/60.0),fmod(seconds,60.0)]
+	if not detail.is_empty(): _text(column,detail,15,true)
+	_text(column,Time.get_date_string_from_unix_time(int(item.get("created_at",0))),14,true)
+
+func _friend_card(item: Dictionary) -> void:
+	var column := _card()
+	_text(column,str(item.get("display_name","")),18)
+	var status: String = str(item.get("status",""))
+	if status == "sent": _text(column,"Request sent",15,true)
+	var actions := HBoxContainer.new()
+	column.add_child(actions)
+	if status == "received":
+		var accept := MenuStyle.button("Accept",_friend_action.bind("accept",str(item.player_id)),true)
+		accept.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		accept.disabled = service.busy
+		actions.add_child(accept)
+	var remove := MenuStyle.button("Decline" if status == "received" else "Cancel" if status == "sent" else "Remove",_friend_action.bind("remove",str(item.player_id)))
+	remove.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	remove.disabled = service.busy
+	actions.add_child(remove)
+
+static func _count(value: int) -> String:
+	return "10,000" if value == 10000 else "1,000" if value == 1000 else str(value)
+
+func _exit_tree() -> void:
+	if service != null and service.changed.is_connected(_changed): service.changed.disconnect(_changed)
