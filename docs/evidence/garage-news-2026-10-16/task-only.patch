+extends SceneTree
+const Client = preload("res://backend/backend_client.gd")
+var checks: int = 0
+var failures: int = 0
+func _initialize() -> void: run.call_deferred()
+func check(value: bool, message: String) -> void:
+	checks += 1
+	if not value:
+		failures += 1
+		print("FAIL: "+message)
+
