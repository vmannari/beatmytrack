+extends SceneTree
+## Offline newspaper photographs. Fit actual mesh vertices, never runtime cars.
+const PHOTO_SIZE := Vector2i(640,400)
+const FILL: float = 0.80
+var failures: int = 0
+
+func _initialize() -> void: run.call_deferred()
+
+func vertices(node: Node, result: PackedVector3Array) -> void:
+	if node is Node3D and not node.is_visible_in_tree(): return
+	if node is MeshInstance3D and node.mesh != null:
+		for surface: int in range(node.mesh.get_surface_count()):
+			var arrays: Array = node.mesh.surface_get_arrays(surface)
+			for vertex: Vector3 in arrays[Mesh.ARRAY_VERTEX]: result.append(node.global_transform*vertex)
+	for child: Node in node.get_children(): vertices(child,result)
+
+func run() -> void:
+	if DisplayServer.get_name() == "headless":
+		push_error("Native rendering is required to bake news photographs.")
+		quit(1)
+		return
+	# Each chassis is built once; rest-scene caches add no value to this bake.
+	preload("res://vehicle/prepared_car_cache.gd").enabled = false
+	var directory: String = "res://assets/news/vehicles"
+	var evidence: String = "res://../docs/evidence/garage-news-centering-2026-10-16"
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(directory))
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(evidence))
+	var viewport := SubViewport.new()
+	viewport.size = PHOTO_SIZE
+	viewport.own_world_3d = true
+	viewport.msaa_3d = Viewport.MSAA_4X
+	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
+	root.add_child(viewport)
+	var report: Dictionary = {"renderer":RenderingServer.get_current_rendering_method(),"size":[PHOTO_SIZE.x,PHOTO_SIZE.y],"fill":FILL,"cars":[]}
+	for id: String in VehicleCatalog.IDS:
+		var world := Node3D.new()
+		viewport.add_child(world)
+		var car := CarVisual.new()
+		car.vehicle_id = id
+		car.livery = VehicleLivery.defaults(id)
+		car.livery.colors.body = GaragePage.LIVERY_COLORS[0][0]
+		car.livery.colors.accent = GaragePage.LIVERY_COLORS[0][1]
+		world.add_child(car)
+		ShowroomStudio.build(world,car)
+		var camera := Camera3D.new()
+		world.add_child(camera)
+		camera.current = true
+		camera.projection = Camera3D.PROJECTION_ORTHOGONAL
+		camera.keep_aspect = Camera3D.KEEP_HEIGHT
+		camera.position = Vector3(-5,5,-8).normalized()*10.0
+		camera.look_at(Vector3.ZERO)
+		var points := PackedVector3Array()
+		vertices(car,points)
+		var plane := Rect2(Vector2(camera.basis.x.dot(points[0]),camera.basis.y.dot(points[0])),Vector2.ZERO)
+		for point: Vector3 in points: plane = plane.expand(Vector2(camera.basis.x.dot(point),camera.basis.y.dot(point)))
+		camera.position += camera.basis.x*plane.get_center().x+camera.basis.y*plane.get_center().y
+		camera.size = maxf(plane.size.y,plane.size.x/(float(PHOTO_SIZE.x)/PHOTO_SIZE.y))/FILL
+		for frame: int in range(5): await process_frame
+		await RenderingServer.frame_post_draw
+		var projected := Rect2(camera.unproject_position(points[0]),Vector2.ZERO)
+		for point: Vector3 in points: projected = projected.expand(camera.unproject_position(point))
+		var error: Vector2 = projected.get_center()-Vector2(PHOTO_SIZE)*0.5
+		var margins: Array[float] = [projected.position.x,projected.position.y,PHOTO_SIZE.x-projected.end.x,PHOTO_SIZE.y-projected.end.y]
+		var centered: bool = error.length() <= 0.1 and margins.min() >= PHOTO_SIZE.y*0.099
+		if not centered: failures += 1
+		var pixels: Image = viewport.get_texture().get_image()
+		pixels.convert(Image.FORMAT_RGB8)
+		var path: String = directory.path_join(id+".png")
+		if pixels.save_png(path) != OK: failures += 1
+		report.cars.append({"vehicle_id":id,"path":path,"sha256":FileAccess.get_sha256(path),"vertices":points.size(),"bounds":[projected.position.x,projected.position.y,projected.size.x,projected.size.y],"center_error_px":[error.x,error.y],"margins_px":margins,"centered_unclipped":centered,"camera_transform":str(camera.transform),"camera_size":camera.size})
+		world.queue_free()
+		await process_frame
+	var file := FileAccess.open(evidence.path_join("framing.json"),FileAccess.WRITE)
+	file.store_string(JSON.stringify(report,"\t"))
+	file.close()
+	viewport.queue_free()
+	for frame: int in range(20): await process_frame
+	print("NEWS PHOTO FRAMING: %d cars, %d failures" % [report.cars.size(),failures])
+	quit(1 if failures else 0)
