--- a/game/ui/garage_news_art.gd
+++ b/game/ui/garage_news_art.gd
@@ -1,9 +1,11 @@
 extends Control
 ## Stationary desk, paper and circuit ink; no processing or animated noise.
+const MARKER_TEXTURE: Texture2D = preload("res://assets/news/race_marker_handdrawn_v1.png")
 var kind: String = "paper"
 var points := PackedVector2Array()
 func _ready() -> void:
 	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	if kind == "marker": texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
 	resized.connect(queue_redraw)
 func _draw() -> void:
 	if kind == "paper":
@@ -14,16 +16,9 @@
 		draw_rect(Rect2(fold-3,0,3,size.y),Color(0.28,0.21,0.12,0.025))
 		draw_line(Vector2(fold,0),Vector2(fold,size.y),Color(1,0.98,0.9,0.23),1)
 	elif kind == "marker":
-		# One stationary chisel-marker scribble, with uneven turns and soft ink bleed.
-		var zigzag := PackedVector2Array()
-		for step: int in range(23):
-			var x: float = lerpf(13.0,size.x-13.0,float(step)/22.0)
-			var y: float = size.y*0.5+(-12.0 if step%2 else 12.0)+sin(step*2.3)*1.8
-			zigzag.append(Vector2(x,y))
-		draw_polyline(zigzag,Color(0.78,0.61,0.13,0.10),9,true)
-		draw_polyline(zigzag,Color(0.91,0.75,0.22,0.57),6,true)
-		for endpoint: Vector2 in [zigzag[0],zigzag[zigzag.size()-1]]:
-			draw_circle(endpoint,3,Color(0.91,0.75,0.22,0.35),true,-1,true)
+		# Fit the ink itself behind the lettering, leaving its rough edges intact.
+		var source := Rect2(Vector2(44,158)/Vector2(2172,724)*MARKER_TEXTURE.get_size(),Vector2(2096,439)/Vector2(2172,724)*MARKER_TEXTURE.get_size())
+		draw_texture_rect_region(MARKER_TEXTURE,Rect2(Vector2(6,10),size-Vector2(12,20)),source,Color(1,1,1,0.78))
 	elif kind == "circuit" and points.size() >= 2:
 		var bounds := Rect2(points[0],Vector2.ZERO)
 		for point: Vector2 in points: bounds = bounds.expand(point)
@@ -37,3 +32,4 @@
 		draw_polyline(path,Color("303832"),4,true)
 		draw_circle(path[0],5,Color("a34330"),true,-1,true)
 		draw_circle(path[0],2,Color("eee7d4"),true,-1,true)
