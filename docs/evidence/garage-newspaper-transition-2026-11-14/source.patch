diff --git a/game/ui/garage_news_wait.gd b/game/ui/garage_news_wait.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/garage_news_wait.gd
@@ -0,0 +1,16 @@
+extends Control
+## A small pending-action cue; sleeps whenever the News button is not waiting.
+var _angle: float = 0.0
+
+func _ready() -> void:
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	visibility_changed.connect(func() -> void: set_process(is_visible_in_tree()))
+	set_process(is_visible_in_tree())
+
+func _process(delta: float) -> void:
+	_angle = fmod(_angle+delta*TAU,TAU)
+	queue_redraw()
+
+func _draw() -> void:
+	draw_circle(size*0.5,7.0,MenuStyle.ACCENT,true,-1,true)
+	draw_arc(size*0.5,4.5,_angle,_angle+TAU*0.7,20,MenuStyle.INK,1.8,true)
