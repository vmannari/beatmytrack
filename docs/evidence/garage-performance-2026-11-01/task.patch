diff --git a/game/tests/profile_garage_render_cost.gd b/game/tests/profile_garage_render_cost.gd
new file mode 100644
index 0000000000000000000000000000000000000000..a10bec3dddd3de0e3b6eb7ac932c743b98dd0fc6
--- /dev/null
+++ b/game/tests/profile_garage_render_cost.gd
@@ -0,0 +1,141 @@
+extends SceneTree
+## Isolated Garage component: no account, owner records or network adapters.
+var output: String = "res://../build/garage-render-cost"
+var report: Dictionary = {}
+var view: CarShowroom
+var control: bool = false
+var captures: Dictionary = {}
+
+func _initialize() -> void: run.call_deferred()
+
+func frames(count: int = 12) -> void:
+	for tick: int in range(count): await process_frame
+	if DisplayServer.get_name() != "headless": await RenderingServer.frame_post_draw
+
+func geometry(node: Node) -> Dictionary:
+	var result: Dictionary = {"meshes":0,"surfaces":0,"vertices":0,"triangles":0,"unindexed_vertices":0}
+	for part: Node in node.find_children("*","MeshInstance3D",true,false):
+		if part.mesh == null: continue
+		result.meshes += 1
+		for surface: int in range(part.mesh.get_surface_count()):
+			var arrays: Array = part.mesh.surface_get_arrays(surface)
+			var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
+			var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
+			result.surfaces += 1
+			result.vertices += vertices.size()
+			result.triangles += (vertices.size() if indices.is_empty() else indices.size())/3
+			if indices.is_empty(): result.unindexed_vertices += vertices.size()
+	return result
+
+func sample(label: String, moving: bool = false) -> Dictionary:
+	await frames()
+	var start_requests: int = view.render_requests
+	var reflections: PackedInt64Array = view.reflections.draw_requests.duplicate()
+	var samples: Array[float] = []
+	var draws: Array[float] = []
+	var primitives: Array[float] = []
+	for tick: int in range(60):
+		if moving: view.rotate_view(Vector2(1.5,0))
+		var began: int = Time.get_ticks_usec()
+		await process_frame
+		samples.append((Time.get_ticks_usec()-began)/1000.0)
+		draws.append(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME))
+		primitives.append(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME))
+	samples.sort(); draws.sort(); primitives.sort()
+	var result: Dictionary = {"requests":view.render_requests-start_requests,"reflection_requests":[view.reflections.draw_requests[0]-reflections[0],view.reflections.draw_requests[1]-reflections[1]],"frame_median_ms":samples[30],"frame_p95_ms":samples[57],"draws_median":draws[30],"primitives_median":primitives[30]}
+	print("GARAGE_SAMPLE ",label," ",JSON.stringify(result))
+	return result
+
+func capture(label: String) -> void:
+	if DisplayServer.get_name() != "headless" and not control:
+		view.showroom_viewport.mesh_lod_threshold = 0.0
+		for reflection: SubViewport in view.reflections.views: reflection.mesh_lod_threshold = 0.0
+		view.invalidate_render()
+		await frames()
+		view.showroom_viewport.get_texture().get_image().save_png(output.path_join("full-"+label+".png"))
+		captures["full-"+label] = await render_counts()
+		view.showroom_viewport.mesh_lod_threshold = 0.5
+		for reflection: SubViewport in view.reflections.views: reflection.mesh_lod_threshold = 0.5
+	view.invalidate_render()
+	await frames()
+	if DisplayServer.get_name() != "headless":
+		view.showroom_viewport.get_texture().get_image().save_png(output.path_join(label+".png"))
+		captures[label] = await render_counts()
+
+func render_counts() -> Dictionary:
+	var views: Array[SubViewport] = [view.showroom_viewport]
+	views.append_array(view.reflections.views)
+	for capture_view: SubViewport in views: capture_view.render_target_update_mode = SubViewport.UPDATE_ALWAYS
+	await frames(5)
+	var result: Dictionary = {}
+	for index: int in range(views.size()):
+		var rid: RID = views[index].get_viewport_rid()
+		result[["main","floor_reflection","car_reflection"][index]] = RenderingServer.viewport_get_render_info(rid,RenderingServer.VIEWPORT_RENDER_INFO_TYPE_VISIBLE,RenderingServer.VIEWPORT_RENDER_INFO_PRIMITIVES_IN_FRAME)
+		views[index].render_target_update_mode = SubViewport.UPDATE_DISABLED
+	return result
+
+func run() -> void:
+	create_timer(240).timeout.connect(func() -> void: print("FAIL: Garage render profile deadline"); quit(1))
+	for argument: String in OS.get_cmdline_user_args():
+		if argument.begins_with("--output="): output = argument.trim_prefix("--output=")
+		if argument == "--control": control = true
+	if control:
+		var script: Script = load("res://ui/car_showroom.gd")
+		script.source_code = script.source_code.replace("if _record_animation_visible():","if true:").replace("viewport.mesh_lod_threshold = 0.5","viewport.mesh_lod_threshold = 0.0")
+		assert(script.reload(true) == OK)
+	output = ProjectSettings.globalize_path(output)
+	DirAccess.make_dir_recursive_absolute(output)
+	root.size = Vector2i(1280,720)
+	Engine.max_fps = 60
+	var music: GameSoundtrack = GameSoundtrack.instance()
+	music.music_enabled = false
+	view = CarShowroom.new()
+	view.garage_mode = true
+	view.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	root.add_child(view)
+	while not view.showroom_ready: await process_frame
+	if control:
+		for reflection: SubViewport in view.reflections.views: reflection.mesh_lod_threshold = 0.0
+	report = {"renderer":RenderingServer.get_current_rendering_method(),"engine":Engine.get_version_info().string,"adapter":RenderingServer.get_video_adapter_name(),"resolution":[1280,720],"note":"Desktop component samples, not tablet FPS; capped at 60, cache and host load sensitive.","room":geometry(view.camera.get_parent().find_child("GarageArchitecture",true,false)),"cars":{}}
+	for id: String in VehicleCatalog.IDS:
+		if id != view.vehicle_id: view.replace_car(id,VehicleLivery.defaults(id),{})
+		view.finish_car_transition()
+		await capture(id+"-front")
+		report.cars[id] = geometry(view.car)
+		view.rotate_view(Vector2(180,0))
+		await capture(id+"-rear")
+		view.reset_view()
+		if not control:
+			view.set_zoom(CarShowroom.MIN_ZOOM)
+			await capture(id+"-close")
+			view.reset_view()
+		await frames()
+	report.idle = await sample("silent_idle")
+	var silence := AudioStreamWAV.new()
+	silence.mix_rate = 22050
+	silence.loop_mode = AudioStreamWAV.LOOP_FORWARD
+	silence.loop_end = 22050
+	var data := PackedByteArray(); data.resize(44100); silence.data = data
+	music.music_enabled = true
+	music.mode = "menu"
+	music.menu_target = 1.0
+	music.menu_player.stream = silence
+	music.menu_player.play()
+	music.menu_player.stream_paused = false
+	await frames()
+	report.music_car_view = await sample("music_car_view")
+	view.set_record_view(true)
+	await create_timer(1.0).timeout
+	report.music_record_view = await sample("music_record_view")
+	music.music_enabled = false
+	music.menu_target = 0.0
+	music.menu_player.stop()
+	view.set_record_view(false)
+	await create_timer(1.0).timeout
+	report.orbit = await sample("orbit",true)
+	report.captures = captures
+	FileAccess.open(output.path_join("report.json"),FileAccess.WRITE).store_string(JSON.stringify(report,"\t"))
+	print("GARAGE_GEOMETRY ",JSON.stringify({"room":report.room,"cars":report.cars}))
+	view.free()
+	await process_frame
+	quit()
diff --git a/game/tests/support/garage_mesh_lods.gd b/game/tests/support/garage_mesh_lods.gd
new file mode 100644
index 0000000000000000000000000000000000000000..fc8936b30e9d5819fea7c872c92d0995d7758a23
--- /dev/null
+++ b/game/tests/support/garage_mesh_lods.gd
@@ -0,0 +1,82 @@
+extends RefCounted
+## Offline-only index preparation. Runtime never runs mesh simplification.
+var meshes: Dictionary = {}
+var totals: Dictionary = {"meshes":0,"with_lods":0,"lods":0,"original_triangles":0,"smallest_triangles":0,"changed_vertex_streams":0}
+
+func full_detail(source: Mesh) -> Mesh:
+	if not source is ArrayMesh: return source
+	var surfaces: Array = source.get("_surfaces").duplicate(true)
+	for surface: Dictionary in surfaces: surface.erase("lods")
+	var result := ArrayMesh.new()
+	result.set("_surfaces",surfaces)
+	result.custom_aabb = source.custom_aabb
+	result.shadow_mesh = source.shadow_mesh
+	return result
+
+func prepare(source: Mesh) -> Mesh:
+	if meshes.has(source): return meshes[source]
+	if not source is ArrayMesh or source.get_blend_shape_count() != 0: return source
+	var importer := ImporterMesh.new()
+	for surface: int in range(source.get_surface_count()):
+		importer.add_surface(source.surface_get_primitive_type(surface),source.surface_get_arrays(surface),[],{},source.surface_get_material(surface))
+	importer.generate_lods(0.0,0.0,[])
+	var result := ArrayMesh.new()
+	var original_surfaces: Array = source.get("_surfaces").duplicate(true)
+	var count: int = 0
+	for surface: int in range(source.get_surface_count()):
+		var arrays: Array = source.surface_get_arrays(surface)
+		var generated: Array = importer.get_surface_arrays(surface)
+		var same: bool = true
+		for attribute: int in range(Mesh.ARRAY_INDEX):
+			if arrays[attribute] != generated[attribute]: same = false
+		var lods: Dictionary = {}
+		if same:
+			for index: int in range(importer.get_surface_lod_count(surface)):
+				lods[maxf(0.000001,importer.get_surface_lod_size(surface,index))] = importer.get_surface_lod_indices(surface,index)
+		else: totals.changed_vertex_streams += 1
+		var indices: int = arrays[Mesh.ARRAY_INDEX].size() if arrays[Mesh.ARRAY_INDEX] != null and not arrays[Mesh.ARRAY_INDEX].is_empty() else arrays[Mesh.ARRAY_VERTEX].size()
+		totals.original_triangles += indices/3
+		var smallest: int = indices
+		for level: PackedInt32Array in lods.values(): smallest = mini(smallest,level.size())
+		totals.smallest_triangles += smallest/3
+		totals.lods += lods.size()
+		count += lods.size()
+		result.add_surface_from_arrays(source.surface_get_primitive_type(surface),arrays,[],lods,source.surface_get_format(surface) & Mesh.ARRAY_FLAG_COMPRESS_ATTRIBUTES)
+		result.surface_set_material(surface,source.surface_get_material(surface))
+		result.surface_set_name(surface,source.surface_get_name(surface))
+	# Re-encoding compressed normals/tangents can round the original GPU bytes.
+	# Use the pinned engine's resource storage format to transfer only new LOD
+	# index buffers; positions, normals, UVs, colors and original indices stay exact.
+	var generated_surfaces: Array = result.get("_surfaces")
+	for surface: int in range(original_surfaces.size()):
+		if generated_surfaces[surface].has("lods"):
+			original_surfaces[surface].lods = generated_surfaces[surface].lods
+	var exact := ArrayMesh.new()
+	exact.set("_surfaces",original_surfaces)
+	exact.custom_aabb = source.custom_aabb
+	exact.shadow_mesh = source.shadow_mesh
+	for surface: int in range(source.get_surface_count()):
+		assert(exact.surface_get_arrays(surface) == source.surface_get_arrays(surface))
+	result.custom_aabb = source.custom_aabb
+	result.shadow_mesh = source.shadow_mesh
+	meshes[source] = exact if count > 0 else source
+	totals.meshes += 1
+	if count > 0: totals.with_lods += 1
+	return meshes[source]
+
+func bake(path: String) -> Error:
+	var scene: PackedScene = load(path)
+	var holder: Node = scene.instantiate()
+	for part: Node in holder.find_children("*","MeshInstance3D",true,false):
+		# Independently decimating close curved layers can make their triangles
+		# intersect. Keep the layered Hover cockpit/hull and all glazing exact.
+		var layered: bool = path.ends_with("/hovercraft.scn")
+		for surface: int in range(part.mesh.get_surface_count()):
+			var material: Material = part.get_active_material(surface)
+			if material is ShaderMaterial and material.shader != null and material.shader.resource_path in ["res://vehicle/electric_glass.gdshader","res://vehicle/window_reflection.gdshader"]: layered = true
+		part.mesh = full_detail(part.mesh) if layered else prepare(part.mesh)
+	var packed := PackedScene.new()
+	var error: Error = packed.pack(holder)
+	if error == OK: error = ResourceSaver.save(packed,path,ResourceSaver.FLAG_COMPRESS)
+	holder.free()
+	return error
