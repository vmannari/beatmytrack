+﻿extends SceneTree
+## Refresh only LOD indices; ordinary car/workshop bake tools also prepare them.
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	var lods = preload("res://tests/support/garage_mesh_lods.gd").new()
