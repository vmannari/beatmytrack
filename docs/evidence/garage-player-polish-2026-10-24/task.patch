+shader_type spatial;
+render_mode diffuse_burley, specular_schlick_ggx;
+uniform vec4 timber_tint : source_color = vec4(0.34, 0.19, 0.095, 1.0);
+varying vec3 grain_position;
+varying vec3 grain_normal;
+void vertex() {
+	grain_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	grain_normal = normalize(MODEL_NORMAL_MATRIX * NORMAL);
+}
+void fragment() {
+	// The station is turned against the side wall. Lengthwise veneer follows
+	// the cabinet instead of the old workshop-wide striped plank projection.
+	float across = mix(grain_position.y, grain_position.x, abs(grain_normal.y));
+	float along = grain_position.z;
+	float bend = sin(along * 5.0 + across * 2.0) * 0.9 + sin(along * 13.0) * 0.15;
+	float phase = across * 140.0 + bend;
+	float filtered = 1.0 - smoothstep(0.4, 2.0, fwidth(phase));
+	float grain = sin(phase) * filtered;
+	float broad = sin(across * 23.0 + bend * 0.7);
+	ALBEDO = timber_tint.rgb * (0.96 + grain * 0.022 + broad * 0.025);
+	ROUGHNESS = 0.46 + grain * 0.025;
+	SPECULAR = 0.32;
+}
