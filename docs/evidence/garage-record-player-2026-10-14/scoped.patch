+	check(music.menu_target==0 and (not music.output_enabled or music.menu_player.stream_paused),"focus return preserves LP stop")
+	page.records_menu._toggle_play()
+	music._process(1.0)
+	check(music.music_enabled and music.menu_target==1 and not music.menu_player.stream_paused,"play music restores LP with original volume")
