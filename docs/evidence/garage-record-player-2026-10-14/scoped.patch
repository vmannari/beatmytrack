+++ b/game/ui/garage_records_menu.gd
@@ -0,0 +1,204 @@
+extends VBoxContainer
+const Library = preload("res://soundtrack/record_library.gd")
+signal changed
+signal save_failed
+var records: LocalRecords
+var grid: GridContainer
+var status: Label
+var transport: Button
+var volume: HSlider
+var volume_value: Label
+var save_timer: Timer
+var file_dialog: FileDialog
+var remove_dialog: ConfirmationDialog
+var remove_button: Button
+var cards: Dictionary = {}
+
+func _ready() -> void:
+	name = "GarageRecordsWorkbench"
+	size_flags_vertical = Control.SIZE_EXPAND_FILL
+	add_theme_constant_override("separation",10)
+	add_child(MenuStyle.label("LP COLLECTION",24))
+	add_child(MenuStyle.label("Choose a record for the menus.",16,true))
+	var scroll := ScrollContainer.new()
+	scroll.name = "GarageRecordScroll"
+	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
+	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	add_child(scroll)
+	grid = GridContainer.new()
+	grid.columns = 2
+	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	grid.add_theme_constant_override("h_separation",10)
+	grid.add_theme_constant_override("v_separation",10)
+	scroll.add_child(grid)
+	status = MenuStyle.label("",15,true)
+	status.name = "GarageRecordStatus"
+	status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	add_child(status)
+	var level := HBoxContainer.new()
+	level.add_child(MenuStyle.label("Volume",16))
+	volume_value = MenuStyle.label("",16,true)
+	volume_value.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+	volume_value.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	level.add_child(volume_value)
+	add_child(level)
+	volume = HSlider.new()
+	volume.name = "GarageRecordVolume"
+	volume.min_value = 0
+	volume.max_value = 100
+	volume.step = 1
+	volume.custom_minimum_size.y = 30
+	volume.value = GameSoundtrack.preference(records.settings,"music_volume")*100
+	add_child(volume)
+	volume_value.text = "%d%%" % roundi(volume.value)
+	save_timer = Timer.new()
+	save_timer.one_shot = true
+	save_timer.wait_time = 0.25
+	add_child(save_timer)
+	save_timer.timeout.connect(_save_volume)
+	volume.value_changed.connect(_preview_volume)
+	transport = MenuStyle.button("",_toggle_play,true)
+	transport.name = "GarageRecordTransport"
+	add_child(transport)
+	remove_button = MenuStyle.button("Remove LP",_confirm_remove)
+	remove_button.name = "GarageRemoveLP"
+	add_child(remove_button)
+	file_dialog = FileDialog.new()
+	file_dialog.name = "GarageLPFileDialog"
+	file_dialog.access = FileDialog.ACCESS_FILESYSTEM
+	file_dialog.file_mode = FileDialog.FILE_MODE_OPEN_FILE
+	file_dialog.mode_overrides_title = false
+	file_dialog.title = "Add an LP"
+	file_dialog.add_filter("*.mp3,*.ogg,*.wav","Music recordings","audio/*")
+	file_dialog.use_native_dialog = true
+	file_dialog.set_customization_flag_enabled(FileDialog.CUSTOMIZATION_DELETE,false)
+	add_child(file_dialog)
+	file_dialog.file_selected.connect(_import_file)
+	remove_dialog = ConfirmationDialog.new()
+	remove_dialog.title = "Remove LP"
+	remove_dialog.ok_button_text = "Remove"
+	add_child(remove_dialog)
+	remove_dialog.confirmed.connect(_remove_selected)
+	visibility_changed.connect(_visibility_changed)
+	_refresh()
+
+func _refresh() -> void:
+	for child: Node in grid.get_children():
+		grid.remove_child(child)
+		child.queue_free()
+	cards.clear()
+	var selected: Dictionary = Library.selected(records.settings)
+	for entry: Dictionary in Library.entries(records.settings):
+		var button := MenuStyle.button("",_select.bind(entry.id),entry.id==selected.id)
+		button.name = "LP_" + entry.id
+		button.tooltip_text = entry.title
+		button.custom_minimum_size = Vector2(145,204)
+		button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		var content := VBoxContainer.new()
+		content.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		button.add_child(content)
+		MenuStyle.fill(content)
+		content.offset_left = 10
+		content.offset_top = 10
+		content.offset_right = -10
+		content.offset_bottom = -10
+		var art := TextureRect.new()
+		art.texture = Library.cover(entry.id)
+		art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+		art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
+		art.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
+		art.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		art.custom_minimum_size = Vector2(124,124)
+		art.size_flags_vertical = Control.SIZE_EXPAND_FILL
+		content.add_child(art)
+		var title := MenuStyle.label(entry.title,17)
+		title.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
+		title.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		title.add_theme_color_override("font_color",MenuStyle.INK if entry.id==selected.id else MenuStyle.TEXT)
+		content.add_child(title)
+		var subtitle := MenuStyle.label("On the turntable" if entry.id==selected.id else "Play LP",13,true)
+		subtitle.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		if entry.id==selected.id: subtitle.add_theme_color_override("font_color",MenuStyle.INK)
+		content.add_child(subtitle)
+		grid.add_child(button)
+		cards[entry.id] = button
+	var add := MenuStyle.button("+\nAdd an LP",_add_file)
+	add.name = "GarageAddLP"
+	add.custom_minimum_size = Vector2(145,204)
+	add.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	add.disabled = Library.entries(records.settings).size() >= Library.MAX_RECORDS+1
+	grid.add_child(add)
+	var enabled: bool = records.settings.get("music_enabled",true)
+	transport.text = "Stop music" if enabled else "Play music"
+	remove_button.disabled = selected.id == Library.DEFAULT_ID
+	status.text = ("Playing · " if enabled else "Stopped · ") + selected.title
+	changed.emit()
+
+func _select(id: String) -> void:
+	if not is_visible_in_tree(): return
+	for entry: Dictionary in Library.entries(records.settings):
+		if entry.id != id: continue
+		if not FileAccess.file_exists(Library.asset(entry)):
+			status.text = "This recording is missing. Add it again to restore the LP."
+			return
+		records.settings.music_record = id
+		records.settings.music_enabled = true
+		_commit()
+		return
+
+func _commit() -> bool:
+	if records.save_records() != OK:
+		GameSoundtrack.instance().apply_settings(records.settings)
+		status.text = "Could not save. Please try again."
+		save_failed.emit()
+		return false
+	GameSoundtrack.instance().apply_settings(records.settings)
+	_refresh()
+	return true
+
+func _toggle_play() -> void:
+	records.settings.music_enabled = not records.settings.get("music_enabled",true)
+	_commit()
+
+func _preview_volume(value: float) -> void:
+	volume_value.text = "%d%%" % roundi(value)
+	records.settings.music_volume = value/100.0
+	GameSoundtrack.instance().apply_settings(records.settings)
+	save_timer.start()
+
+func _save_volume() -> void:
+	_commit()
+
+func _add_file() -> void:
+	file_dialog.popup_centered_clamped(Vector2i(760,480),0.9)
+
+func _import_file(path: String) -> void:
+	if not is_visible_in_tree(): return
+	var result: Dictionary = Library.import_file(records,path)
+	if result.has("error"):
+		status.text = result.error
+		return
+	GameSoundtrack.instance().apply_settings(records.settings)
+	_refresh()
+
+func _confirm_remove() -> void:
+	remove_dialog.dialog_text = "Remove %s from your LP shelf?" % Library.selected(records.settings).title
+	remove_dialog.popup_centered()
+
+func _remove_selected() -> void:
+	if not is_visible_in_tree(): return
+	if Library.remove(records,Library.selected(records.settings).id) != OK:
+		status.text = "Could not remove this LP. Please try again."
+		return
+	GameSoundtrack.instance().apply_settings(records.settings)
+	_refresh()
+
+func finish() -> void:
+	if not save_timer.is_stopped():
+		save_timer.stop()
+		_save_volume()
+	file_dialog.hide()
+	remove_dialog.hide()
+
+func _visibility_changed() -> void:
+	if not is_visible_in_tree(): finish()
diff --git a/game/ui/garage_vinyl.gdshader b/game/ui/garage_vinyl.gdshader
new file mode 100644
index 0000000..f3c3ebb
--- /dev/null
+++ b/game/ui/garage_vinyl.gdshader
@@ -0,0 +1,14 @@
+shader_type spatial;
+render_mode diffuse_burley;
+varying vec3 local_vertex;
+void vertex() { local_vertex = VERTEX; }
+void fragment() {
+	float radius = length(local_vertex.xz);
+	float phase = radius * 3200.0;
+	float groove = 0.5 + 0.5 * cos(phase);
+	float filtered = mix(groove, 0.5, smoothstep(0.5, 2.0, fwidth(phase)));
+	float recorded = smoothstep(0.049, 0.055, radius) * (1.0 - smoothstep(0.145, 0.151, radius));
+	ALBEDO = vec3(0.013, 0.018, 0.020) + filtered * recorded * 0.014;
+	METALLIC = 0.08;
+	ROUGHNESS = mix(0.32, 0.44, filtered * recorded);
+}
