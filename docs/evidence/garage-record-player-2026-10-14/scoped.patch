+	page._show_section("cars")
+	await settle()
+	await capture("garage-overview")
+	page.queue_free()
+	await process_frame
+	music.apply_settings({})
+	print("GARAGE_RECORDS: %d checks, %d failures" % [checks,failures])
+	quit(1 if failures else 0)
