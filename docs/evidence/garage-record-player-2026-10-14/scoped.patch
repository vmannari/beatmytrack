+param([string]$ScriptName = 'test_garage_records', [string]$Renderer = 'gl_compatibility', [switch]$Headless)
+$ErrorActionPreference = 'Stop'
+$repoRoot = (Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$env:APPDATA = Join-Path $PSScriptRoot ('user-' + $Renderer)
+$env:BMT_API_URL = ''
+$evidence = 'res://../docs/evidence/garage-record-player-2026-10-14/' + $Renderer
+New-Item -ItemType Directory -Force -Path $env:APPDATA | Out-Null
+$logs = Join-Path $repoRoot 'docs/evidence/garage-record-player-2026-10-14/logs'
+New-Item -ItemType Directory -Force -Path $logs | Out-Null
+try {
+    & (Join-Path $repoRoot 'scripts/dev.ps1') -Action TestScript -ScriptPath ('res://tests/' + $ScriptName + '.gd') -Graphical:(-not $Headless) -RenderingMethod $Renderer -TestArgument ('--evidence-root=' + $evidence) -CommandTimeoutSeconds 120
+} finally {
+    $label = $ScriptName + '-' + $Renderer + '-' + $(if ($Headless) { 'headless' } else { 'graphical' }) + '-' + $PID + '.log'
+    Copy-Item -LiteralPath (Join-Path $repoRoot ('build/logs/TestScript-' + $PID + '/test-script.log')) -Destination (Join-Path $logs $label)
+}
