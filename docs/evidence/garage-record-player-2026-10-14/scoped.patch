+	music.apply_settings(records.settings)
+	music.show_menu()
+	check(music.menu_record=="exploration" and music.menu_player.stream is AudioStreamOggVorbis,"original selected menu recording remains default")
+	check(Library.valid_collection([]) and not Library.valid_collection([{"id":"../escape","title":"x","format":"wav"}]),"bounded validated collection rejects paths")
+	check(Library.import_file(records,"res://project.godot").has("error"),"non-audio cannot enter the LP shelf")
+	var sample := AudioStreamWAV.new()
+	sample.format = AudioStreamWAV.FORMAT_16_BITS
+	sample.mix_rate = 44100
+	var pcm := PackedByteArray()
+	pcm.resize(44100*4*2)
+	for frame: int in range(44100*4): pcm.encode_s16(frame*2,roundi(sin(frame*TAU*440/44100.0)*650))
+	sample.data = pcm
+	var wav_path: String = folder.path_join("Playback check.wav")
+	check(sample.save_to_wav(wav_path)==OK,"test-only PCM fixture")
+	var imported: Dictionary = Library.import_file(records,wav_path)
+	check(imported.has("entry"),"WAV becomes an actual LP with a copied recording")
+	var wav_id: String = imported.entry.id
+	var reload := LocalRecords.new(records.path)
+	reload.load_records()
+	check(reload.settings.music_record==wav_id and reload.settings.music_records.size()==1,"LP catalogue and selection survive reload")
+	check(FileAccess.get_sha256(Library.asset(imported.entry))==FileAccess.get_sha256(wav_path),"LP copy retains exact source bytes")
+	music.apply_settings(records.settings)
+	music._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
+	music._process(0.13)
+	music._process(0.30)
+	check(music.menu_record==wav_id and music.menu_player.stream is AudioStreamWAV,"LP selection changes the live menu stream")
+	if music.output_enabled:
+		music._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
+		check(await delivered_audio("selected-lp") > 0.001,"selected LP produces real audio output")
+	var owner := Node.new()
+	root.add_child(owner)
+	music.begin_race(owner,"desert",VehicleState.new())
