+	page._show_section("care")
+	await settle()
+	reload.load_records()
+	check(reload.settings.music_volume==0.31,"navigation flushes pending volume save")
+	check(view.camera.transform.is_equal_approx(car_pose) and not view.record_view,"return restores retained car view and zoom")
+	page._show_section("records")
