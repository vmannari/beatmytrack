+	owner.queue_free()
+	var ogg: Dictionary = Library.import_file(records,Library.DEFAULT_ASSET)
+	check(ogg.has("entry") and Library.stream(ogg.entry) is AudioStreamOggVorbis,"native OGG recording imports and loops")
+	var mp3: Dictionary = Library.import_file(records,"res://../archive/music/menu-exploration-2026-10-11/Exploration 3_take-3.mp3")
+	check(mp3.has("entry") and Library.stream(mp3.entry) is AudioStreamMP3,"owner-supplied MP3 imports and loops")
+	var duplicate: Dictionary = Library.import_file(records,wav_path)
+	check(duplicate.has("entry") and records.settings.music_records.size()==3,"same recording reselects without duplicate LP")
+	var failed := LocalRecords.new(folder.path_join("absent/records.json"))
+	check(Library.import_file(failed,wav_path).has("error") and failed.settings.is_empty(),"failed save preserves prior settings and existing recording")
+	root.size = Vector2i(1280,720)
+	var holder := MarginContainer.new()
+	holder.theme = MenuStyle.theme()
