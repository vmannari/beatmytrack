+	check(page.records_menu!=null and view.record_view and not view.trophy_view,"record rail opens the actual listening station")
+	check(view.record_station!=null and view.record_vinyl!=null,"actual player, stylus, speakers, vinyl and collection exist")
+	check(page.records_menu.cards.size()==4,"one original plus three actual imported LP choices")
+	check(view.car==car and view.showroom_viewport==viewport,"listening view retains actual car and viewport")
+	var station: Node3D = view.record_station
+	var sleeves: Node3D = station.find_child("GarageRecordSleeves",true,false)
+	check(sleeves.get_child_count()==4,"native shelves use exactly the real LP collection")
+	var same_sleeve: Node = sleeves.get_child(0)
+	view.update_records(records.settings)
+	check(sleeves.get_child(0)==same_sleeve,"unchanged collection does not rebuild geometry")
+	page.records_menu._select("exploration")
+	await settle()
+	check(records.settings.music_record=="exploration" and music.menu_record=="exploration","real record card sets saved and audible selection")
+	await capture("collection-1280")
+	for width: int in [960,1600]:
+		root.size = Vector2i(width,540 if width==960 else 720)
+		await settle()
+		check(page.get_global_rect().encloses(page.records_menu.get_global_rect()),"LP workbench fits "+str(width))
+		await capture("collection-"+str(width))
+	root.size = Vector2i(1280,720)
+	page.records_menu._toggle_play()
+	music._process(1.0)
+	check(not music.music_enabled and music.menu_target==0 and (not music.output_enabled or music.menu_player.stream_paused),"stop music follows saved off preference")
+	if music.output_enabled:
+		await create_timer(0.15).timeout
+		check(await delivered_audio("stopped-lp") == 0.0,"stopped LP has no delivered music samples after queued audio drains")
