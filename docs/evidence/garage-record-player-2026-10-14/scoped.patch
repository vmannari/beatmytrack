diff --git a/game/soundtrack/record_library.gd b/game/soundtrack/record_library.gd
new file mode 100644
index 0000000..e538ab7
--- /dev/null
+++ b/game/soundtrack/record_library.gd
@@ -0,0 +1,172 @@
+extends RefCounted
+## Local LP collection. Only owner-selected recordings; no retired score candidates.
+const DEFAULT_ID: String = "exploration"
+const DEFAULT_ASSET: String = "res://assets/audio/menu_exploration_v1/exploration_menu_loop.ogg"
+const DIRECTORY: String = "user://lp_records"
+const MAX_RECORDS: int = 12
+const MAX_FILE_BYTES: int = 24 * 1024 * 1024
+const MAX_COLLECTION_BYTES: int = 96 * 1024 * 1024
+static var covers: Dictionary = {}
+
+static func valid_id(value: Variant) -> bool:
+	if not value is String: return false
+	if value == DEFAULT_ID: return true
+	if value.length() != 64: return false
+	for letter: String in value:
+		if letter not in "0123456789abcdef": return false
+	return true
+
+static func valid_collection(value: Variant) -> bool:
+	if not value is Array or value.size() > MAX_RECORDS: return false
+	var ids: Dictionary = {}
+	for entry: Variant in value:
+		if not entry is Dictionary or entry.size() != 3: return false
+		if not valid_id(entry.get("id")) or entry.id == DEFAULT_ID or ids.has(entry.id): return false
+		if entry.get("format") not in ["mp3","ogg","wav"]: return false
+		var title: Variant = entry.get("title")
+		if not title is String or title.strip_edges().is_empty() or title.length() > 64: return false
+		for letter: String in title:
+			if letter.unicode_at(0) < 32: return false
+		ids[entry.id] = true
+	return true
+
+static func entries(settings: Dictionary) -> Array[Dictionary]:
+	var result: Array[Dictionary] = [{"id":DEFAULT_ID,"title":"Exploration","format":"ogg"}]
+	var custom: Variant = settings.get("music_records",[])
+	if valid_collection(custom):
+		for entry: Dictionary in custom: result.append(entry.duplicate())
+	return result
+
+static func selected(settings: Dictionary) -> Dictionary:
+	for entry: Dictionary in entries(settings):
+		if entry.id == settings.get("music_record",DEFAULT_ID): return entry
+	return entries({})[0]
+
+static func asset(entry: Dictionary) -> String:
+	return DEFAULT_ASSET if entry.id == DEFAULT_ID else DIRECTORY.path_join(entry.id + "." + entry.format)
+
+static func stream(entry: Dictionary) -> AudioStream:
+	if entry.id == DEFAULT_ID: return AudioLoop.prepare(load(DEFAULT_ASSET) as AudioStream)
+	var path: String = asset(entry)
+	var file := FileAccess.open(path,FileAccess.READ)
+	if file == null or file.get_length() > MAX_FILE_BYTES: return null
+	return decode(file.get_buffer(file.get_length()),entry.format)
+
+static func decode(bytes: PackedByteArray, format: String) -> AudioStream:
+	if bytes.size() < 12 or bytes.size() > MAX_FILE_BYTES: return null
+	var result: AudioStream
+	match format:
+		"ogg":
+			if bytes.slice(0,4).get_string_from_ascii() != "OggS": return null
+			result = AudioStreamOggVorbis.load_from_buffer(bytes)
+		"mp3":
+			if bytes.slice(0,3).get_string_from_ascii() != "ID3" and not (bytes[0] == 255 and bytes[1] & 224 == 224): return null
+			result = AudioStreamMP3.load_from_buffer(bytes)
+		"wav":
+			if bytes.slice(0,4).get_string_from_ascii() != "RIFF" or bytes.slice(8,12).get_string_from_ascii() != "WAVE": return null
+			result = AudioStreamWAV.load_from_buffer(bytes)
+		_: return null
+	if result == null or not is_finite(result.get_length()) or result.get_length() < 1.0 or result.get_length() > 600.0: return null
+	if result is AudioStreamMP3:
+		result.loop = true
+		result.loop_offset = 0.0
+		return result
+	if result is AudioStreamWAV and result.format != AudioStreamWAV.FORMAT_16_BITS:
+		if result.format != AudioStreamWAV.FORMAT_8_BITS: return null
+		var frame_bytes: int = 2 if result.stereo else 1
+		var pcm: PackedByteArray = result.data
+		if pcm.size() < frame_bytes or pcm.size() % frame_bytes != 0: return null
+		result.loop_mode = AudioStreamWAV.LOOP_FORWARD
+		result.loop_begin = 0
+		result.loop_end = pcm.size()/frame_bytes
+		pcm.append_array(pcm.slice(0,frame_bytes))
+		result.data = pcm
+		return result
+	return AudioLoop.prepare(result)
+
+static func import_file(records: LocalRecords, path: String) -> Dictionary:
+	var format: String = path.get_extension().to_lower()
+	if format not in ["mp3","ogg","wav"]: return {"error":"Choose an MP3, OGG or WAV recording."}
+	var source := FileAccess.open(path,FileAccess.READ)
+	if source == null: return {"error":"Could not open this recording."}
+	if source.get_length() > MAX_FILE_BYTES: return {"error":"Choose a recording smaller than 24 MB."}
+	var bytes: PackedByteArray = source.get_buffer(source.get_length())
+	var audio: AudioStream = decode(bytes,format)
+	if audio == null: return {"error":"Choose a playable recording between 1 second and 10 minutes."}
+	var digest := HashingContext.new()
+	digest.start(HashingContext.HASH_SHA256)
+	digest.update(bytes)
+	var id: String = digest.finish().hex_encode()
+	var custom: Array = records.settings.get("music_records",[]).duplicate(true)
+	for entry: Dictionary in custom:
+		if entry.id == id:
+			# Restore a missing local copy as well as selecting an existing LP.
+			return _commit_import(records,entry,custom,bytes)
+	if custom.size() >= MAX_RECORDS: return {"error":"Your LP shelf is full. Remove an LP to add another."}
+	var total: int = bytes.size()
+	var directory := DirAccess.open(DIRECTORY)
+	if directory != null:
+		for filename: String in directory.get_files():
+			var owned_name: String = filename.trim_suffix(".tmp")
+			if not valid_id(owned_name.get_basename()) or owned_name.get_extension() not in ["mp3","ogg","wav"]: continue
+			var existing := FileAccess.open(DIRECTORY.path_join(filename),FileAccess.READ)
+			if existing != null: total += existing.get_length()
+	if total > MAX_COLLECTION_BYTES: return {"error":"Your LP collection is full. Remove an LP to add another."}
+	var title: String = path.get_file().get_basename().replace("_"," ").strip_edges().left(64)
+	var entry: Dictionary = {"id":id,"title":title if not title.is_empty() else "Untitled","format":format}
+	custom.append(entry)
+	return _commit_import(records,entry,custom,bytes)
+
+static func _commit_import(records: LocalRecords, entry: Dictionary, custom: Array, bytes: PackedByteArray) -> Dictionary:
+	if not valid_collection(custom): return {"error":"This recording's name cannot be saved."}
+	if DirAccess.make_dir_recursive_absolute(DIRECTORY) != OK: return {"error":"Could not create the LP shelf."}
+	var destination: String = asset(entry)
+	var existed: bool = FileAccess.file_exists(destination)
+	if not existed:
+		var file := FileAccess.open(destination+".tmp",FileAccess.WRITE)
+		if file == null: return {"error":"Could not save this recording."}
+		file.store_buffer(bytes)
+		file.flush()
+		var error: Error = file.get_error()
+		file.close()
+		if error != OK or DirAccess.rename_absolute(destination+".tmp",destination) != OK:
+			DirAccess.remove_absolute(destination+".tmp")
+			return {"error":"Could not save this recording."}
+	records.settings.music_records = custom
+	records.settings.music_record = entry.id
+	records.settings.music_enabled = true
+	if records.save_records() != OK:
+		if not existed: DirAccess.remove_absolute(destination)
+		return {"error":"Could not save your LP selection."}
+	return {"entry":entry}
+
+static func remove(records: LocalRecords, id: String) -> Error:
+	var custom: Array = records.settings.get("music_records",[]).duplicate(true)
+	for index: int in range(custom.size()):
+		var entry: Dictionary = custom[index]
+		if entry.id != id: continue
+		custom.remove_at(index)
+		records.settings.music_records = custom
+		if records.settings.get("music_record",DEFAULT_ID) == id: records.settings.music_record = DEFAULT_ID
+		var error: Error = records.save_records()
+		if error == OK and FileAccess.file_exists(asset(entry)): DirAccess.remove_absolute(asset(entry))
+		covers.erase(id)
+		return error
+	return ERR_INVALID_PARAMETER
+
+static func palette(id: String) -> Array[Color]:
+	var palettes: Array = [["203d43","dfbc72"],["49343b","e4ab83"],["34415b","c6cdda"],["344639","d6c59b"],["423b50","c9b2db"]]
+	var colors: Array = palettes[0 if id == DEFAULT_ID else abs(id.hash()) % palettes.size()]
+	return [Color(colors[0]),Color(colors[1])]
+
+static func cover(id: String) -> Texture2D:
+	if covers.has(id): return covers[id]
+	var colors: Array[Color] = palette(id)
+	var svg: String = "<svg xmlns='http://www.w3.org/2000/svg' width='256' height='256'><rect width='256' height='256' fill='#%s'/><g stroke='#%s' fill='none' stroke-width='2'><circle cx='132' cy='130' r='90'/><circle cx='132' cy='130' r='72'/><circle cx='132' cy='130' r='54'/><circle cx='132' cy='130' r='36'/></g><path d='M0 202L256 90V158L0 256Z' fill='#%s'/><circle cx='132' cy='130' r='13' fill='#%s'/><rect x='18' y='18' width='50' height='5' fill='#%s'/></svg>" % [colors[0].to_html(false),colors[1].to_html(false),colors[1].to_html(false),colors[0].to_html(false),colors[1].to_html(false)]
+	var bitmap := Image.new()
+	bitmap.load_svg_from_string(svg)
+	bitmap.generate_mipmaps()
+	if covers.size() >= MAX_RECORDS+1: covers.erase(covers.keys()[0])
+	var texture := ImageTexture.create_from_image(bitmap)
+	covers[id] = texture
+	return texture
