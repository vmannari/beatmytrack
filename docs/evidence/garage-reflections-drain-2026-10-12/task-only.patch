+powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Action TestScript -ScriptPath res://tests/capture_garage_reference.gd -Graphical -TestArgument '--evidence-root=res://../docs/evidence/garage-reflections-drain-2026-10-12/overview'
+powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Action TestScript -ScriptPath res://tests/capture_garage_reference.gd -Graphical -RenderingMethod mobile -TestArgument '--evidence-root=res://../docs/evidence/garage-reflections-drain-2026-10-12/mobile/overview'
+powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Action TestScript -ScriptPath res://tests/test_garage_final_polish.gd -Graphical -TestArgument '--evidence-root=res://../docs/evidence/garage-reflections-drain-2026-10-12/contracts'
