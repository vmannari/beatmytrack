+func rail_snapshot() -> Array[Dictionary]:
+	var result: Array[Dictionary] = []
+	for button: Button in page.rail.get_children():
+		result.append({"id":button.get_instance_id(),"rect":button.get_global_rect(),"name":button.name})
+	return result
+
+func check_rail_snapshot(expected: Array[Dictionary], label: String) -> void:
+	check(page.rail.get_child_count()==expected.size(),"all rail buttons remain present "+label)
+	for item: Dictionary in expected:
+		var button: Button = page.rail.get_node_or_null(NodePath(item.name))
+		check(is_instance_valid(button) and button.get_instance_id()==item.id,"same rail button throughout motion "+label+" "+str(item.name))
+		if not is_instance_valid(button): continue
+		check(button.is_visible_in_tree() and button.get_global_rect().is_equal_approx(item.rect),"rail button stays visible in its exact slot "+label+" "+str(item.name))
+		check(button.mouse_filter!=Control.MOUSE_FILTER_IGNORE and button.focus_mode!=Control.FOCUS_NONE,"rail button remains interactive "+label+" "+str(item.name))
+
+func settle_with_fixed_rail(expected: Array[Dictionary], label: String) -> void:
+	var tween: Tween = page._menu_motion
+	check(tween!=null,"content transition starts "+label)
+	if tween==null: return
+	tween.pause()
+	for sample: int in range(9):
+		if sample>0: tween.custom_step(GaragePage.MENU_MOVE_SECONDS/8.0)
+		page._present_menu_layout()
+		await frame()
+		check_rail_snapshot(expected,label+" frame "+str(sample))
+		if sample in [0,3,5] and root.size.x==1280:
+			await capture("motion-"+label+"-"+str(sample))
+	tween.custom_step(0.001)
+	await settle()
+	check_rail_snapshot(expected,label+" settled")
 
