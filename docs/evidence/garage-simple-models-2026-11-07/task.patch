index 0000000000000000000000000000000000000000..4f1e7185e86c6988048eb25567098d725a74c091
--- /dev/null
+++ b/docs/evidence/garage-simple-models-2026-11-07/recipes/repair_assets.py
@@ -0,0 +1,50 @@
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+ROOT=Path(__file__).resolve().parents[2]
+WORK=Path(__file__).resolve().parent
+OUT=WORK/'asset-repair'
+OUT.mkdir(exist_ok=True)
+profile=OUT/'profile'
+(profile/'roaming/Circuit01Lab').mkdir(parents=True,exist_ok=True)
+(profile/'local').mkdir(exist_ok=True)
+(profile/'roaming/Circuit01Lab/backend.cfg').write_bytes(b'[backend]\nurl=""\n')
+env=dict(os.environ,APPDATA=str(profile/'roaming'),LOCALAPPDATA=str(profile/'local'),BMT_API_URL='')
+paths=set(json.loads((WORK/'assets/source-receipt.json').read_text(encoding='utf-8'))['after'])
+paths.update('game/ui/'+name+'.gd' for name in ['car_showroom','garage_page','garage_preloader','garage_preview_cache','garage_thumbnail_studio','garage_cleanliness','settings_page'])
+def sources():return {rel:hashlib.sha256((ROOT/rel).read_bytes()).hexdigest() for rel in sorted(paths)}
+before=sources()
+receipts=[]
+def run(label,args):
+    started=time.monotonic()
+    with (OUT/(label+'.log')).open('w',encoding='utf-8') as log:
+        result=subprocess.run(args,cwd=ROOT,env=env,stdout=log,stderr=subprocess.STDOUT,timeout=900)
+    receipts.append({'label':label,'command':args,'exit_code':result.returncode,'seconds':time.monotonic()-started})
+    (OUT/'commands.json').write_bytes((json.dumps(receipts,indent=2)+'\n').encode())
+    print(label,result.returncode,flush=True)
+    assert result.returncode==0,label
+def identity(label):
+    command=". ./scripts/build_identity.ps1; Write-ClientBuildIdentity (Get-Location).Path '"+OUT.as_posix().replace("'","''")+"'"
+    run(label,[sys.executable,str(ROOT/'scripts/run_no_crash_dialog.py'),'--','powershell','-NoProfile','-ExecutionPolicy','Bypass','-Command',command])
+def engine(label,script,*arguments,renderer='headless'):
+    args=[sys.executable,str(WORK/'run.py'),label,script,'--renderer',renderer,'--timeout','600']
+    if arguments:args+=['--']+list(arguments)
+    run(label,args)
+identity('identity-before')
+engine('repair-bases','res://tests/bake_modular_car_bases.gd','--vehicle=kart')
+engine('repair-kits','res://tests/bake_modular_car_kits.gd','--vehicle=kart')
+engine('repair-garage','res://tests/bake_garage_cars.gd','--vehicle=kart')
+engine('repair-pictures','res://../scripts/bake_garage_previews.gd',renderer='gl_compatibility')
+after=sources()
+receipt={'before':before,'after':after,'changed':[rel for rel in before if before[rel]!=after[rel]],'scope':'Only pre-existing stale Kart assets rebaked; all native photographs refreshed. Concurrent handling source is read, never edited.'}
+(OUT/'source-receipt.json').write_bytes((json.dumps(receipt,indent=2)+'\n').encode())
+assert before==after,'Source changed during selected repair'
+identity('identity-after')
+engine('repair-preflight','res://tests/check_prepared_assets.gd')
+run('picture-preflight',[sys.executable,str(ROOT/'scripts/check_garage_previews.py')])
+print('GARAGE_SIMPLE_ASSETS verified',flush=True)
diff --git a/docs/evidence/garage-simple-models-2026-11-07/recipes/run.py b/docs/evidence/garage-simple-models-2026-11-07/recipes/run.py
new file mode 100644
index 0000000000000000000000000000000000000000..a58786164ef8a61ee26bd2f464c64f49fe836851
--- /dev/null
+++ b/docs/evidence/garage-simple-models-2026-11-07/recipes/run.py
@@ -0,0 +1,56 @@
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[2]
+WORK = Path(__file__).resolve().parent
+p = argparse.ArgumentParser()
+p.add_argument("label")
+p.add_argument("script")
+p.add_argument("--renderer", default="headless")
+p.add_argument("--timeout", type=int, default=600)
+p.add_argument("--entry", action="store_true")
+p.add_argument("--check", action="store_true")
+p.add_argument("--pipeline", action="store_true")
+p.add_argument("arguments", nargs="*")
+args, extra = p.parse_known_args()
+args.arguments += [argument for argument in extra if argument != "--"]
+profile = WORK / "profile" / args.label
+for folder in (profile / "roaming/Circuit01Lab", profile / "local"):
+    folder.mkdir(parents=True, exist_ok=True)
+(profile / "roaming/Circuit01Lab/backend.cfg").write_bytes(b'[backend]\nurl=""\n')
+env = dict(os.environ, APPDATA=str(profile / "roaming"), LOCALAPPDATA=str(profile / "local"), BMT_API_URL="")
+wrapper = [sys.executable, str(ROOT / "scripts/run_no_crash_dialog.py"), "--"]
+godot = "C:/apps/Godot 4.7.2/Godot_v4.7.2-stable_win64_console.exe"
+if args.pipeline:
+    command = wrapper + [sys.executable, str(ROOT / "scripts/prepare_car_assets.py"), "--output", str(WORK / args.label)]
+elif args.entry:
+    command = wrapper + ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(ROOT / "scripts/dev.ps1"), "-Action", "TestScript", "-ScriptPath", args.script, "-CommandTimeoutSeconds", str(args.timeout)]
+    if args.arguments:
+        command += ["-TestArgument", ",".join(args.arguments)]
+else:
+    command = wrapper + [godot, "--path", str(ROOT / "game"), "--audio-driver", "Dummy", "--log-file", str(WORK / (args.label + "-godot.log"))]
+    if args.renderer == "headless":
+        command += ["--headless"]
+    else:
+        command += ["--rendering-method", args.renderer, "--position", "10000,10000"]
+    command += (["--check-only"] if args.check else []) + ["--script", args.script, "--"] + args.arguments
+started = time.monotonic()
+with (WORK / (args.label + ".log")).open("w", encoding="utf-8") as log:
+    process = subprocess.Popen(command, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT, creationflags=subprocess.CREATE_NO_WINDOW)
+    print(json.dumps({"label": args.label, "owned_pid": process.pid, "command": command}), flush=True)
+    try:
+        code = process.wait(timeout=args.timeout)
+    except subprocess.TimeoutExpired:
+        subprocess.run(["taskkill", "/PID", str(process.pid), "/T", "/F"], capture_output=True)
+        process.wait(timeout=30)
+        code = 124
+receipt = {"label": args.label, "command": command, "owned_pid": process.pid, "exit_code": code, "seconds": time.monotonic()-started}
+(WORK / (args.label + "-receipt.json")).write_bytes((json.dumps(receipt, indent=2)+"\n").encode())
+print(json.dumps(receipt), flush=True)
+print((WORK / (args.label + ".log")).read_text(encoding="utf-8", errors="replace")[-5000:])
+sys.exit(code)
diff --git a/docs/evidence/garage-simple-models-2026-11-07/recipes/seal.py b/docs/evidence/garage-simple-models-2026-11-07/recipes/seal.py
new file mode 100644
index 0000000000000000000000000000000000000000..e5ee0d01f83d7494c5358303e3f69669d19d0466
--- /dev/null
+++ b/docs/evidence/garage-simple-models-2026-11-07/recipes/seal.py
@@ -0,0 +1,43 @@
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+ROOT=Path(__file__).resolve().parents[2]
+WORK=Path(__file__).resolve().parent
+DEST=WORK/'frozen'
+native=subprocess.run(['git','-C',str(ROOT),'ls-files','--cached','--others','--exclude-standard','--','native'],capture_output=True,text=True,check=True).stdout.splitlines()
+for rel in native:
+    source=ROOT/rel
+    if source.is_file():
+        target=DEST/rel;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(source,target)
+types={'.gd','.gdshader','.gdshaderinc','.tres','.json','.ps1','.py','.godot','.cfg','.po','.pot','.cpp','.h','.txt','.gdextension'}
+paths=[]
+for folder in ['game','scripts','native']:
+    for base,folders,files in os.walk(ROOT/folder):
+        folders[:]=[x for x in folders if x not in ['.godot','__pycache__','android','build','.git']]
+        for name in files:
+            source=Path(base)/name
+            if source.suffix in types and (DEST/source.relative_to(ROOT)).is_file():paths.append(source.relative_to(ROOT).as_posix())
+def digest(path):return hashlib.sha256(path.read_bytes()).hexdigest()
+for attempt in range(4):
+    for rel in paths:
+        source=ROOT/rel;target=DEST/rel
+        assert target.resolve().is_relative_to(DEST.resolve())
+        temporary=target.with_name(target.name+'.snapshot-tmp')
+        shutil.copyfile(source,temporary);os.replace(temporary,target)
+    hashes={rel:digest(DEST/rel) for rel in paths}
+    changed=[rel for rel,value in hashes.items() if digest(ROOT/rel)!=value]
+    if not changed:break
+assert not changed,changed
+shutil.copyfile(ROOT/'.gitignore',DEST/'.gitignore')
+subprocess.run(['git','-C',str(DEST),'init','--quiet'],check=True)
+subprocess.run(['git','-C',str(DEST),'config','core.autocrlf','false'],check=True)
+receipt={'root':str(DEST),'source_sha256':hashes,'sealing_attempts':attempt+1,
+         'changed_at_seal':changed,'generated_outputs_are_independent_copies':True,
+         'source_files_are_independent_copies':True,'shader_cache_shared':False,
+         'reason':'Live concurrent physics/project edits; frozen validation does not mutate those sources.'}
+(WORK/'freeze-receipt.json').write_bytes((json.dumps(receipt,indent=2)+'\n').encode())
+print(json.dumps({'source_files':len(hashes),'sealing_attempts':attempt+1,'changed_at_seal':changed}))
