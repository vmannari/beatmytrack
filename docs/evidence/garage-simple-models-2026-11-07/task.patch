+func open_car(index: int) -> void:
+	if index < 0 or index >= VehicleCatalog.IDS.size(): return
+	preview_car(index)
+	_selected_vehicle_id = vehicle_id
+	_show_section("customise")
+	vehicle_selected.emit(index)
