diff --git a/game/ui/garage_preview_cache.gd b/game/ui/garage_preview_cache.gd
index 9376ffb83af50ae277b9d6ec84b72fae6b846b03..ecdcdfc7489f5b76f088ff82ebba996e6befe40f 100644
--- a/game/ui/garage_preview_cache.gd
