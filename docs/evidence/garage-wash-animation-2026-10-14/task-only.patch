+from pathlib import Path
+import hashlib
+import json
+import struct
+import zlib
+
+root = Path(__file__).resolve().parents[1]
+evidence = root / 'docs/evidence/garage-wash-animation-2026-10-14'
+
+def parse(path):
+    source = path.read_bytes()
+    assert source[:8] == b'\x89PNG\r\n\x1a\n'
+    parts, offset = [], 8
+    while offset < len(source):
+        size = struct.unpack('>I', source[offset:offset+4])[0]
+        kind = source[offset+4:offset+8]
+        data = source[offset+8:offset+8+size]
+        assert struct.unpack('>I', source[offset+8+size:offset+12+size])[0] == zlib.crc32(kind+data) & 0xffffffff
+        parts.append((kind, data))
+        offset += size+12
+    return parts
+
+def chunk(kind, data):
+    return struct.pack('>I', len(data))+kind+data+struct.pack('>I', zlib.crc32(kind+data) & 0xffffffff)
+
+for renderer in ('gl_compatibility', 'mobile'):
+    folder = evidence / renderer
+    paths = sorted((folder / 'motion').glob('frame-*.png'))
+    assert len(paths) == 72, f'Expected 72 actual frames for {renderer}'
+    first = parse(paths[0])
+    header = next(data for kind, data in first if kind == b'IHDR')
+    width, height = struct.unpack('>II', header[:8])
+    result = bytearray(b'\x89PNG\r\n\x1a\n')+chunk(b'IHDR', header)
+    for kind, data in first:
+        if kind not in (b'IHDR', b'IDAT', b'IEND'):
+            result += chunk(kind, data)
+    result += chunk(b'acTL', struct.pack('>II', len(paths), 0))
+    sequence = 0
+    for index, path in enumerate(paths):
+        parts = parse(path)
+        assert next(data for kind, data in parts if kind == b'IHDR') == header
+        result += chunk(b'fcTL', struct.pack('>IIIIIHHBB', sequence, width, height, 0, 0, 1, 30, 0, 0))
+        sequence += 1
+        for kind, data in parts:
+            if kind != b'IDAT': continue
+            if index == 0: result += chunk(b'IDAT', data)
+            else:
+                result += chunk(b'fdAT', struct.pack('>I', sequence)+data)
+                sequence += 1
+    result += chunk(b'IEND', b'')
+    target = folder / 'washing-animation.png'
+    target.write_bytes(result)
+    (folder/'motion.json').write_text(json.dumps({
+        'artifact': str(target.relative_to(root)), 'width': width, 'height': height,
+        'frames': len(paths), 'seconds': len(paths)/30, 'sha256': hashlib.sha256(result).hexdigest(),
+        'note': 'Lossless APNG of actual native renders, stepping production scrub/particle updates at 30 Hz; playback is not a frame-time measurement.'
+    }, indent=2)+'\n', encoding='utf-8')
+    print(renderer, len(paths), 'native frames', len(result), 'bytes')
