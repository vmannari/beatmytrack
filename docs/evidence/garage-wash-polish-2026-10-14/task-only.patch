+from pathlib import Path
+from PIL import Image, ImageDraw, ImageFont, ImageChops
+import hashlib
+import json
+
+root = Path(__file__).resolve().parents[1]
+evidence = root/'docs/evidence/garage-wash-polish-2026-10-14'
+receipts = []
+for renderer in ('gl_compatibility','mobile'):
+    before = evidence/renderer/'before'
+    after = evidence/renderer/'after'
+    paths = sorted((after/'motion').glob('frame-*.png'))
+    assert len(paths)==72, f'Expected 72 native frames for {renderer}'
+    frames = [Image.open(path).convert('RGB').resize((960,540),Image.Resampling.LANCZOS) for path in paths]
+    frames[0].save(after/'washing-animation.webp',save_all=True,append_images=frames[1:],duration=33,loop=0,lossless=True,method=4)
+    if before.exists() and (before/'washing-door.png').exists():
+        sheet = Image.new('RGB',(1280,760),'#172129')
+        draw = ImageDraw.Draw(sheet)
+        font_path = Path('C:/Windows/Fonts/segoeui.ttf')
+        font = ImageFont.truetype(str(font_path),16) if font_path.exists() else ImageFont.load_default()
+        for index,(folder,label) in enumerate(((before,'First pass'),(after,'Refined'),(before,'First pass'),(after,'Refined'))):
+            name = 'washing-door' if index<2 else 'washing-hood'
+            picture = Image.open(folder/(name+'.png')).convert('RGB').resize((640,360),Image.Resampling.LANCZOS)
+            x,y=(index%2)*640,(index//2)*380
+            sheet.paste(picture,(x,y))
+            draw.text((x+12,y+360),label,fill='#edf1f3',font=font)
+        sheet.save(after/'before-after.png')
+        baseline_pixels=Image.open(before/'cleaned-patch.png').convert('RGB')
+        current_pixels=Image.open(after/'cleaned-patch.png').convert('RGB')
+        clean_diff=ImageChops.difference(baseline_pixels,current_pixels)
+        receipts.append({'renderer':renderer,'cleared_patch_equal':clean_diff.getbbox() is None,'cleared_patch_difference_bounds':clean_diff.getbbox()})
+    receipts.append({'renderer':renderer,'frames':len(paths),'animation':str((after/'washing-animation.webp').relative_to(root)),
+                     'bytes':(after/'washing-animation.webp').stat().st_size,'sha256':hashlib.sha256((after/'washing-animation.webp').read_bytes()).hexdigest()})
+(evidence/'visual-review.json').write_text(json.dumps(receipts,indent=2)+'\n',encoding='utf-8')
+print(json.dumps(receipts,indent=2))
