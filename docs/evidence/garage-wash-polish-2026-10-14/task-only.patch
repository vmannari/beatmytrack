+from pathlib import Path
+import hashlib
+import json
+import re
+import subprocess
+
+root=Path(__file__).resolve().parents[1]
+out=root/'docs/evidence/garage-wash-polish-2026-10-14'
+repo=root/'build/garage-wash-polish-checkpoint'
+assert not repo.exists(), 'Preserve an existing checkpoint.'
+
+def read(name): return (root/name).read_text(encoding='utf-8')
+modified={name:(out/'before'/name).read_text(encoding='utf-8') for name in (
+    'game/ui/garage_wash_effect.gd','game/tests/test_garage_wash_animation.gd')}
+for name in ('AGENTS.md','DEVELOPMENT_STATUS.md','docs/PHASE_0_PLAN.md'):
+    source=read(name)
+    if name=='AGENTS.md':
+        stripped,count=re.subn(r'\n## Garage washing visual quality and connected foam override \(2026-10-14\)\n[^\n]+\n','',source)
+    else:
+        stripped,count=re.subn(r'^2026-10-14 GWP01-GWP04/[^\n]+\n\n?','',source,flags=re.M)
+    assert count==1,name
+    modified[name]=stripped
+added=[
+    'game/ui/garage_wash_geometry.gd','game/ui/garage_wash_geometry.gd.uid',
+    'game/ui/garage_wash_cloth.gdshader','game/ui/garage_wash_cloth.gdshader.uid',
+    'game/ui/garage_wash_lather.gdshader','game/ui/garage_wash_lather.gdshader.uid',
+    'game/ui/garage_wash_water.gdshader','game/ui/garage_wash_water.gdshader.uid',
+    'game/tests/test_garage_wash_polish.gd','game/tests/test_garage_wash_polish.gd.uid',
+    'docs/GARAGE_WASH_POLISH_2026_10_14.md','build/run_garage_wash_polish.ps1',
+    'build/encode_garage_wash_polish.py','build/checkpoint_garage_wash_polish.py',
+]
+repo.mkdir(parents=True)
+def git(*args): return subprocess.run(['git','-C',str(repo),*args],check=True,capture_output=True).stdout.decode().strip()
+git('init','-q')
+git('config','user.name','Codex task checkpoint')
+git('config','user.email','checkpoint@local.invalid')
+git('config','core.autocrlf','input')
+for name,text in modified.items():
+    target=repo/name
+    target.parent.mkdir(parents=True,exist_ok=True)
+    target.write_text(text,encoding='utf-8',newline='\n')
+git('add','-f','.')
+git('commit','-q','-m','Garage washing quality scoped baseline')
+base=git('rev-parse','HEAD')
+for name in list(modified)+added:
+    target=repo/name
+    target.parent.mkdir(parents=True,exist_ok=True)
+    target.write_text(read(name),encoding='utf-8',newline='\n')
+git('add','-f','.')
+git('commit','-q','-m','Refine Garage wash mitt water and connected frothy lather')
+git('diff','--check',base,'HEAD')
+patch=subprocess.run(['git','-C',str(repo),'diff','--binary',base,'HEAD'],check=True,capture_output=True).stdout
+(out/'task-only.patch').write_bytes(patch)
+ledger={
+    'requirements':['GWP01','GWP02','GWP03','GWP04','GWA01','GWA02','GWA03','CW13','CW15','CW16','V06','G01','R01','Q01'],
+    'repository':str(repo.relative_to(root)),'baseline':base,'checkpoint':git('rev-parse','HEAD'),
+    'patch_sha256':hashlib.sha256(patch).hexdigest(),
+    'files':[{'path':name,'sha256':hashlib.sha256((root/name).read_bytes()).hexdigest()} for name in list(modified)+added],
+    'evidence':[{'path':str(path.relative_to(root)),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()} for path in sorted(out.rglob('*')) if path.is_file() and path.suffix in ('.png','.webp','.log','.json') and 'before' not in path.parts and path.name!='checkpoint.json'],
