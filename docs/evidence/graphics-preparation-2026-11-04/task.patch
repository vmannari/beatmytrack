+	_warm_view.render_target_update_mode=SubViewport.UPDATE_DISABLED
+	add_child(_warm_view)
+	_warm_camera=Camera3D.new()
+	_warm_camera.cull_mask=8
+	_warm_view.add_child(_warm_camera)
+	_warm_camera.current=true
