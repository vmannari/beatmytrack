@@ -0,0 +1,46 @@
+"""Keep all attempts, assertions, errors and source scope beside the native proof."""
+import hashlib
+import json
+from pathlib import Path
+import re
+
+evidence = Path(__file__).resolve().parent
+root = evidence.parents[2]
+runtime = ['game/rendering/graphics_preparation.gd','game/race/world_render_preparation.gd',
+           'game/ui/garage_first_draw.gd','game/ui/garage_preloaded_studio.gd',
+           'game/ui/garage_opening_showroom.gd','game/ui/header_car_appearance_cache.gd',
+           'game/ui/garage_preview_cache.gd']
+current = {path:hashlib.sha256((root/path).read_bytes()).hexdigest() for path in runtime}
+summary = dict(runtime_sha256=current,runs={})
+for receipt_path in sorted(evidence.glob('*-receipt.json')):
+    label = receipt_path.name.removesuffix('-receipt.json')
+    receipt = json.loads(receipt_path.read_text(encoding='utf-8'))
+    result_path = evidence/(label+'.json')
+    if not result_path.exists(): result_path = evidence/label/'report.json'
+    result = json.loads(result_path.read_text(encoding='utf-8')) if result_path.exists() else {}
+    log = (evidence/(label+'.log')).read_text(encoding='utf-8',errors='replace')
+    checks,failures = result.get('checks'),result.get('failures')
+    if checks is None:
+        matches = re.findall(r'(\d+) checks,\s*(\d+) failures',log)
+        if matches: checks,failures = map(int,matches[-1])
+    summary['runs'][label] = dict(exit_code=receipt['exit_code'],checks=checks,failures=failures,
+        source_changes=receipt['changed_sources'],
+        runtime_changes=[path for path in runtime if receipt['before'].get(path)!=receipt['after'].get(path)],
+        matches_final_runtime=all(receipt['after'].get(path)==current[path] for path in runtime),
+        engine_errors=[line for line in log.splitlines() if 'ERROR:' in line or 'TIMEOUT' in line],
+        warnings=[line for line in log.splitlines() if 'WARNING:' in line],
+        rows=result.get('rows',result.get('samples',[])),first_laps=result.get('first_laps',[]))
+labels = ['final-components-compat','final-components-mobile','final-buckets','final-editor',
+          'final-warm','final-garage','final-header','final-thumbnails','final-entry',
+          'same-owner-race-final','final-compat-laps']
+selected = {label:summary['runs'].get(label) for label in labels}
+summary['selected_final'] = dict(labels=labels,
+    complete=all(run is not None for run in selected.values()),
+    assertions=sum(run['checks'] or 0 for run in selected.values() if run is not None),
+    all_pass=all(run is not None and run['exit_code']==0 and run['failures']==0
+                 and run['matches_final_runtime'] and not run['source_changes']
+                 and not run['warnings'] and all('root certificate store' in error for error in run['engine_errors'])
+                 for run in selected.values()))
+(evidence/'summary.json').write_text(json.dumps(summary,indent=2)+'\n',encoding='utf-8')
+print(json.dumps({label:{key:run[key] for key in ('exit_code','checks','failures','matches_final_runtime','runtime_changes')}
+                  for label,run in summary['runs'].items()},indent=2))
diff --git a/docs/evidence/graphics-preparation-2026-11-04/compare_pngs.py b/docs/evidence/graphics-preparation-2026-11-04/compare_pngs.py
new file mode 100644
--- /dev/null
+++ b/docs/evidence/graphics-preparation-2026-11-04/compare_pngs.py
@@ -0,0 +1,64 @@
+"""Read-only byte comparison of Godot RGBA8 PNG captures, using stdlib only."""
+import json
+from pathlib import Path
+import struct
+import sys
+import zlib
+
+def rgba(path):
+    content = path.read_bytes()
+    assert content[:8] == b'\x89PNG\r\n\x1a\n'
+    cursor, compressed = 8, bytearray()
+    width = height = 0
+    while cursor < len(content):
+        length = struct.unpack('>I',content[cursor:cursor+4])[0]
+        tag, data = content[cursor+4:cursor+8], content[cursor+8:cursor+8+length]
+        if tag == b'IHDR':
+            width,height,depth,kind,compression,filtering,interlace = struct.unpack('>IIBBBBB',data)
+            assert (depth,kind,compression,filtering,interlace)==(8,6,0,0,0)
+        if tag == b'IDAT': compressed.extend(data)
+        cursor += length+12
+    raw = zlib.decompress(compressed)
+    stride = width*4
+    previous, result, offset = bytearray(stride), bytearray(), 0
+    for _ in range(height):
+        kind = raw[offset]
+        row = bytearray(raw[offset+1:offset+1+stride])
+        offset += stride+1
+        for i in range(stride):
+            a = row[i-4] if i>=4 else 0
+            b = previous[i]
+            c = previous[i-4] if i>=4 else 0
+            if kind == 1: row[i] = (row[i]+a)&255
+            elif kind == 2: row[i] = (row[i]+b)&255
+            elif kind == 3: row[i] = (row[i]+(a+b)//2)&255
+            elif kind == 4:
+                p = a+b-c
+                pa,pb,pc = abs(p-a),abs(p-b),abs(p-c)
+                predictor = a if pa<=pb and pa<=pc else b if pb<=pc else c
+                row[i] = (row[i]+predictor)&255
+            else: assert kind == 0
+        result.extend(row)
+        previous = row
+    return width,height,result
+
+reference = Path(sys.argv[1])
+width,height,expected = rgba(reference)
+rows = []
+for name in sys.argv[2:]:
+    path = Path(name)
+    w,h,actual = rgba(path)
+    assert (w,h)==(width,height)
+    count = maximum = total = 0
+    left,top,right,bottom = width,height,-1,-1
+    for index,(a,b) in enumerate(zip(expected,actual)):
+        difference = abs(a-b)
+        if difference:
+            count += 1
+            total += difference
+            maximum = max(maximum,difference)
+            x,y = (index//4)%width,(index//4)//width
+            left,top,right,bottom = min(left,x),min(top,y),max(right,x),max(bottom,y)
+    rows.append(dict(path=str(path),changed_channels=count,max_channel_difference=maximum,
+                     total_difference=total,bounds=[left,top,right,bottom] if count else None))
+print(json.dumps(rows,indent=2))
diff --git a/docs/evidence/graphics-preparation-2026-11-04/checkpoint.py b/docs/evidence/graphics-preparation-2026-11-04/checkpoint.py
new file mode 100644
--- /dev/null
+++ b/docs/evidence/graphics-preparation-2026-11-04/checkpoint.py
@@ -0,0 +1,76 @@
+"""Check this task's patch in an owned directory without writing the main index."""
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import time
+
+evidence = Path(__file__).resolve().parent
+root = evidence.parents[2]
+runtime_changed = [
+    'game/race/world_render_preparation.gd',
+    'game/ui/garage_first_draw.gd',
+    'game/ui/garage_preloaded_studio.gd',
+    'game/ui/garage_opening_showroom.gd',
+    'game/ui/header_car_appearance_cache.gd',
+    'game/ui/garage_preview_cache.gd',
+    'game/tests/test_world_render_buckets.gd',
+]
+trackers = ['AGENTS.md','DEVELOPMENT_STATUS.md']
+added = ['game/rendering/graphics_preparation.gd','docs/SHARED_GRAPHICS_PREPARATION_2026_11_04.md']
+added += ['game/tests/'+name+'.gd' for name in (
+    'graphics_control_scene','profile_shared_graphics_preparation',
+    'test_shared_graphics_before_lap','test_shared_graphics_first_laps',
+    'test_shared_graphics_garage','test_shared_graphics_header',
+    'test_shared_graphics_lifecycle','test_shared_graphics_preparation',
+    'test_shared_graphics_race_pixels','test_shared_graphics_thumbnails')]
+added += [path.relative_to(root).as_posix() for path in sorted((evidence/'before').rglob('*')) if path.is_file()]
+added += [(evidence/name).relative_to(root).as_posix() for name in (
+    'run_check.py','run_final_checks.py','summarize.py','compare_pngs.py','checkpoint.py')]
+marker = '<!-- SHARED-GRAPHICS-PREPARATION-20261104 -->'
+end_marker = '<!-- /SHARED-GRAPHICS-PREPARATION-20261104 -->'
+before, after, parts = {}, {}, []
+for path in runtime_changed+trackers+added:
+    new = (root/path).read_bytes().replace(b'\r\n',b'\n')
+    old = b''
+    if path in runtime_changed:
+        old = (evidence/'before'/path).read_bytes().replace(b'\r\n',b'\n')
+    elif path in trackers:
+        # Preserve concurrent tracker updates identically on both patch sides.
+        text = new.decode('utf-8')
+        assert text.count(marker)==1 and text.count(end_marker)==1
+        start = text.index(marker)
+        end = text.index(end_marker)+len(end_marker)
+        if text[end:end+2]=='\n\n': end += 2
+        elif text[end:end+1]=='\n': end += 1
+        old = (text[:start]+text[end:]).encode('utf-8')
+    before[path], after[path] = old, new
+    parts.append(f'diff --git a/{path} b/{path}\n')
+    if path in added: parts.append('new file mode 100644\n')
+    parts.extend(difflib.unified_diff(old.decode().splitlines(keepends=True),new.decode().splitlines(keepends=True),
+        fromfile='/dev/null' if path in added else 'a/'+path,tofile='b/'+path))
+patch = evidence/'task.patch'
+patch.write_bytes(''.join(parts).encode())
+owned = root/'build/graphics-preparation-20261104'/('checkpoint-'+str(time.time_ns()))
+owned.mkdir(parents=True)
+assert owned.resolve().is_relative_to((root/'build/graphics-preparation-20261104').resolve())
+for path in runtime_changed+trackers:
+    target = owned/path
+    target.parent.mkdir(parents=True,exist_ok=True)
+    target.write_bytes(before[path])
+commands = []
+for arguments in (('--check',),(),('--reverse','--check'),('--reverse',)):
+    command = ['git','apply','--directory='+owned.relative_to(root).as_posix(),*arguments,str(patch)]
+    result = subprocess.run(command,cwd=root,capture_output=True,text=True)
+    commands.append(dict(command=command,exit_code=result.returncode,output=result.stdout+result.stderr))
+    assert result.returncode==0,result.stderr
+    if arguments==():
+        assert all((owned/path).read_bytes().replace(b'\r\n',b'\n')==after[path] for path in after)
+assert all((owned/path).read_bytes().replace(b'\r\n',b'\n')==before[path] for path in runtime_changed+trackers)
+assert all(not (owned/path).exists() for path in added)
+report = dict(files=list(after),forward_content_exact=True,reverse_content_exact=True,main_index_written=False,
+    patch_sha256=hashlib.sha256(patch.read_bytes()).hexdigest(),commands=commands,
+    source_sha256={path:hashlib.sha256(after[path]).hexdigest() for path in after})
+(evidence/'checkpoint.json').write_text(json.dumps(report,indent=2)+'\n',encoding='utf-8')
+print('Task-only patch forward/reverse/content checks pass; main index unchanged.')
