+		_outgoing.queue_free()
+	_outgoing = null
+
+func _change_finished() -> void:
+	_change = null
+	_clear_outgoing()
+	preview.modulate = Color.WHITE
+	preview.position = Vector2.ZERO
+	if is_visible_in_tree(): _change_picture()
