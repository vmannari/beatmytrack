+        sql("DROP TRIGGER lap_reset ON operation_state")
+        sql("DROP FUNCTION bmt_lap_revision()")
+        sql("DROP FUNCTION bmt_lap_reset()")
+    op.drop_column("boards", "lap_revision")
+    op.drop_table("histogram_snapshots")
