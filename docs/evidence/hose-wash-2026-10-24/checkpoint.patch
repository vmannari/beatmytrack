 extends RefCounted
 ## Original closed microfiber mitt/cuff and a shallow lather surface; shared menu meshes.
 static var meshes: Dictionary = {}
+
+static func nozzle() -> ArrayMesh:
+	if meshes.has("nozzle"): return meshes.nozzle
+	var tool := SurfaceTool.new()
+	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
+	for section: Vector3 in [Vector3(0.033,0.12,0.04),Vector3(0.044,0.055,-0.055),Vector3(0.027,0.035,-0.10)]:
+		var barrel := CylinderMesh.new()
+		barrel.top_radius = section.x*0.85
+		barrel.bottom_radius = section.x
+		barrel.height = section.y
+		barrel.radial_segments = 20
+		_append(tool,barrel,Transform3D(Basis(Vector3.RIGHT,PI*0.5),Vector3(0,0,section.z)))
+	tool.index()
+	meshes.nozzle = tool.commit()
+	return meshes.nozzle
+
+static func hose() -> ArrayMesh:
+	if meshes.has("hose"): return meshes.hose
+	var tool := SurfaceTool.new()
+	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var path: Array[Vector3] = []
+	for index: int in range(21):
+		var t: float = float(index)/20.0
+		path.append(Vector3(sin(t*PI)*0.16,-t*t*0.38,0.1+t*0.62))
+	for index: int in range(path.size()-1):
+		var direction: Vector3 = (path[index+1]-path[index]).normalized()
+		var side: Vector3 = direction.cross(Vector3.UP).normalized()
+		var up: Vector3 = side.cross(direction).normalized()
+		for ring: int in range(10):
+			var a: float = float(ring)*TAU/10.0
+			var b: float = float(ring+1)*TAU/10.0
+			var radial_a: Vector3 = (side*cos(a)+up*sin(a))*0.022
+			var radial_b: Vector3 = (side*cos(b)+up*sin(b))*0.022
+			_face(tool,[path[index]+radial_a,path[index]+radial_b,path[index+1]+radial_b,path[index+1]+radial_a],(radial_a+radial_b).normalized(),[Vector2.ZERO,Vector2.RIGHT,Vector2.ONE,Vector2.DOWN])
+	tool.index()
+	meshes.hose = tool.commit()
+	return meshes.hose
 
 static func mitt() -> ArrayMesh:
 	if meshes.has("mitt"): return meshes.mitt
