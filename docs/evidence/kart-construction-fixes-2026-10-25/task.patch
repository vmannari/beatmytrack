diff --git a/game/tests/review_kart_model.gd b/game/tests/review_kart_model.gd
index 21bd239..75558e8 100644
--- a/game/tests/review_kart_model.gd
+++ b/game/tests/review_kart_model.gd
@@ -89,6 +89,9 @@ func capture(label: String, position_model: Vector3, target_model: Vector3) -> v
 
 func run() -> void:
 	output = EVIDENCE.path_join(RenderingServer.get_current_rendering_method())
+	for argument: String in OS.get_cmdline_user_args():
+		if argument.begins_with("--evidence-root="): output = argument.trim_prefix("--evidence-root=")
+	if "--unbaked" in OS.get_cmdline_user_args(): preload("res://vehicle/kart_geometry.gd").use_baked = false
 	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output))
 	for file: String in ["kart_model.gd","kart_driver.gd","kart_helmet.gd","kart_geometry.gd"]: report.sources[file] = FileAccess.get_sha256("res://vehicle/"+file)
 	root.size = Vector2i(1280,960)
diff --git a/game/tests/test_kart_construction.gd b/game/tests/test_kart_construction.gd
new file mode 100644
index 0000000..eb5f5ba
--- /dev/null
+++ b/game/tests/test_kart_construction.gd
@@ -0,0 +1,118 @@
+extends SceneTree
+## Actual attachment, opaque lining and shared suit-boundary regressions.
+var checks: int = 0
+var failures: int = 0
+var output: String = "res://../docs/evidence/kart-construction-fixes-2026-10-25/construction"
+var measurements: Dictionary = {}
+
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		print("FAIL: "+label)
+
+func parts(car: CarVisual, prefix: String) -> Array[MeshInstance3D]:
+	var resources: Array[Mesh] = []
+	for key: String in preload("res://vehicle/kart_geometry.gd").meshes:
+		if key.get_slice("|",0).begins_with(prefix): resources.append(preload("res://vehicle/kart_geometry.gd").meshes[key])
+	var result: Array[MeshInstance3D] = []
+	for part: MeshInstance3D in car.find_children("*","MeshInstance3D",true,false):
