+		imported.free()
+		quit()
+		return
+	var viewport := SubViewport.new()
+	viewport.size = Vector2i(1100,850)
+	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
+	root.add_child(viewport)
+	var world := Node3D.new()
+	viewport.add_child(world)
+	var car := CarVisual.new()
+	car.vehicle_id = "kart"
+	car.simple_model = "--simple" in OS.get_cmdline_user_args()
+	car.batch_parts = prepared
+	preload("res://vehicle/modular_car_base.gd").enabled = prepared
+	preload("res://vehicle/prepared_car_cache.gd").enabled = prepared
+	preload("res://ui/garage_car_cache.gd").enabled = prepared
+	world.add_child(car)
+	while not car.model_ready: await process_frame
+	if not prepared:
+		# Preview the imported driver in the real kart before replacing production.
+		for child: Node in car.body.get_children():
+			var label: String = str(child.name)
+			if label.begins_with("TailoredRaceSuit") or label.begins_with("Collar") or label.begins_with("Balaclava") or label.begins_with("Suit") or label.begins_with("ContinuousTrouser") or label.begins_with("RaceBoot") or label.begins_with("BootSole") or label.begins_with("UpperSleeve") or label.begins_with("Sleeve") or label.begins_with("RacingGlove") or label.begins_with("GloveGrip") or label.begins_with("TrouserKnee") or label == "HelmetMount" or label == "TomkartDriver":
+				child.queue_free()
+		car.body.add_child(imported)
+	else:
+		imported.free()
+		var driver: MeshInstance3D = car.find_child("TomkartDriver",true,false)
+		assert(driver != null and driver.mesh.get_blend_shape_count() == 6)
+		assert(preload("res://vehicle/modular_car_base.gd").hits > 0)
+	ShowroomStudio.build(world,car)
+	var camera := Camera3D.new()
+	world.add_child(camera)
+	camera.current = true
+	camera.fov = 32
+	for shot: Array in [["front",Vector3(-1.8,1.35,-2.7),Vector3(0,.57,-.12)], ["side",Vector3(-2.3,.82,.15),Vector3(0,.53,-.12)], ["side-right",Vector3(2.3,.82,.15),Vector3(0,.53,-.12)], ["rear",Vector3(1.8,1.2,2.3),Vector3(0,.57,0)], ["overhead",Vector3(0,4.2,2.0),Vector3(0,.3,0)], ["feet",Vector3(1.1,.63,-1.3),Vector3(0,.27,-.83)], ["body",Vector3(1.1,.87,-.9),Vector3(0,.68,-.015)], ["knees",Vector3(0,1.6,-1.2),Vector3(0,.44,-.43)], ["wrists",Vector3(1.0,.95,-.9),Vector3(0,.56,-.25)], ["backrest",Vector3(1.25,.70,.35),Vector3(0,.49,.22)], ["shoulders-front",Vector3(0,1.0,-1.7),Vector3(0,.72,.28)], ["shoulders-rear",Vector3(0,1.05,1.9),Vector3(0,.69,.28)]]:
+		camera.position = shot[1]
+		camera.look_at(shot[2])
+		for frame: int in range(6):
+			await process_frame
+			await RenderingServer.frame_post_draw
+		assert(viewport.get_texture().get_image().save_png(OUT+("/cached-" if prepared else "/before-" if before else "/after-")+shot[0]+".png") == OK)
+	camera.current = false
+	var race := FollowCamera.new()
+	world.add_child(race)
+	race.current = true
+	race.speed_zoom_enabled = false
+	race.follow(Vector2.ZERO,Vector2.ZERO,0,0,true)
+	for frame: int in range(8): await process_frame; await RenderingServer.frame_post_draw
+	assert(viewport.get_texture().get_image().save_png(OUT+("/before-" if before else "/cached-" if prepared else "/after-")+"race-camera.png")==OK)
+	viewport.free()
+	quit()
diff --git a/game/tests/support/kart_driver_anatomy.gd b/game/tests/support/kart_driver_anatomy.gd
new file mode 100644
index 0000000..71ed521
--- /dev/null
+++ b/game/tests/support/kart_driver_anatomy.gd
@@ -0,0 +1,140 @@
+extends RefCounted
+## Offline anatomy enlargement. Contact points, topology and six poses stay fitted.
+const STEERING = preload("res://vehicle/kart_steering.gd")
+const REVISION = "race_readability_v1"
+const HELMET_SCALE: float = 1.20
+const COLUMNS: int = 17
+const ARM_VERTICES: int = 21*COLUMNS
+
+static func torso(point: Vector3) -> Vector3:
+	var front: float = 1-smoothstep(0.18,0.30,point.z)
+	var free_back: float = smoothstep(0.60,0.68,point.y)
+	var weight: float = smoothstep(0.46,0.68,point.y)*maxf(front,free_back)
+	return Vector3(point.x*(1+0.18*weight),point.y+maxf(0,point.y-0.60)*0.35,point.z-0.020*weight*front)
+
+static func center(t: float, root: Vector3, elbow: Vector3, wrist: Vector3) -> Vector3:
+	var entry: Vector3 = elbow+(root-elbow).normalized()*0.035
+	var exit: Vector3 = elbow+(wrist-elbow).normalized()*0.035
+	if t<=0.45: return root.lerp(entry,t/0.45)
+	if t>=0.55: return exit.lerp(wrist,(t-0.55)/0.45)
+	var u: float = (t-0.45)/0.10
+	return entry*(1-u)*(1-u)+elbow*2*u*(1-u)+exit*u*u
+
+static func frame(t: float, root: Vector3, elbow: Vector3, wrist: Vector3) -> Basis:
+	var tangent: Vector3 = (center(minf(1,t+0.001),root,elbow,wrist)-center(maxf(0,t-0.001),root,elbow,wrist)).normalized()
+	var across: Vector3 = (Vector3.RIGHT-tangent*tangent.x).normalized()
+	return Basis(across,tangent.cross(across).normalized(),tangent)
+
+static func arm(point: Vector3, t: float, side: float, input: float) -> Vector3:
+	var shoulder: Vector3 = STEERING.mirrored(STEERING.SHOULDER,side)
+	var root: Vector3 = shoulder+Vector3(-side*0.025,0,-0.015)
+	var wrist: Vector3 = STEERING.CENTER+(STEERING.wheel_basis(input)*STEERING.REST.inverse())*(STEERING.mirrored(STEERING.WRIST,side)-STEERING.SOURCE_CENTER)
+	var elbow: Vector3 = STEERING.elbow_for(shoulder,wrist,STEERING.mirrored(Vector3(0.23,0.52,0.10),side))
+	var offset: Vector3 = frame(t,root,elbow,wrist).transposed()*(point-center(t,root,elbow,wrist))
+	# Keep the elbow and distal axis: the glove grip and neutral wrist remain fitted.
+	var width: float = 1+0.16*(1-smoothstep(0.65,1,t))
+	offset.x *= width
+	offset.y *= width
+	return center(t,torso(root),elbow,wrist)+frame(t,torso(root),elbow,wrist)*offset
+
+static func normals(points: PackedVector3Array, indices: PackedInt32Array, fallback: PackedVector3Array) -> PackedVector3Array:
+	var sums: Dictionary = {}
+	var keys: Array[Vector3i] = []
+	for point: Vector3 in points: keys.append(Vector3i((point*100000).round()))
+	for corner: int in range(0,indices.size(),3):
+		var a: int = indices[corner]
+		var b: int = indices[corner+1]
+		var c: int = indices[corner+2]
+		var face: Vector3 = (points[c]-points[a]).cross(points[b]-points[a])
+		for vertex: int in [a,b,c]: sums[keys[vertex]] = sums.get(keys[vertex],Vector3.ZERO)+face
+	var result := PackedVector3Array()
+	for vertex: int in range(points.size()):
+		var normal: Vector3 = sums.get(keys[vertex],fallback[vertex])
+		result.append(normal.normalized() if normal.length_squared()>1e-20 else fallback[vertex])
+	return result
+
+static func suit(arrays: Array, prefix: int, input: float) -> Array:
+	var result: Array = arrays.duplicate(true)
+	var original: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
+	var points: PackedVector3Array = original.duplicate()
+	for vertex: int in range(prefix): points[vertex] = torso(original[vertex])
+	for side: int in range(2):
+		var offset: int = prefix+side*ARM_VERTICES
+		for vertex: int in range(ARM_VERTICES): points[offset+vertex] = arm(original[offset+vertex],float(vertex/COLUMNS)/20,-1 if side==0 else 1,input)
+	var first_joint: int = prefix+2*ARM_VERTICES
+	var split: int = first_joint
+	while split<points.size() and original[split].x<0: split += 1
+	for span: Vector3i in [Vector3i(first_joint,split,-1),Vector3i(split,points.size(),1)]:
+		var count: int = (span.y-span.x)/5
+		assert(count>8 and count*5==span.y-span.x)
+		for vertex: int in range(span.x,span.y):
+			var weight: float = [0.16,0.33,0.50,0.67,0.84][(vertex-span.x)/count]
+			points[vertex] = torso(original[vertex]).lerp(arm(original[vertex],0.10,span.z,input),weight)
+	# Fair only new shoulder patch interiors; the actual sewn boundaries stay fixed.
+	var neighbours: Dictionary = {}
+	var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
+	for corner: int in range(0,indices.size(),3):
+		for a: int in range(3):
+			var vertex: int = indices[corner+a]
+			if vertex<first_joint: continue
+			if not neighbours.has(vertex): neighbours[vertex] = {}
+			for b: int in range(3):
+				if a!=b: neighbours[vertex][indices[corner+b]] = true
+	for iteration: int in range(12):
+		var next: PackedVector3Array = points.duplicate()
+		for vertex: int in neighbours:
+			var average := Vector3.ZERO
+			for neighbour: int in neighbours[vertex]: average += points[neighbour]
+			next[vertex] = points[vertex].lerp(average/neighbours[vertex].size(),0.35)
+		points = next
+	result[Mesh.ARRAY_VERTEX] = points
+	result[Mesh.ARRAY_NORMAL] = normals(points,indices,arrays[Mesh.ARRAY_NORMAL])
+	return result
+
+static func resize(original: ArrayMesh) -> ArrayMesh:
+	if original.get_meta("kart_driver_anatomy","")==REVISION: return original
+	assert(original.get_surface_count()==6 and original.get_blend_shape_count()==6)
+	var result := ArrayMesh.new()
+	result.blend_shape_mode = original.blend_shape_mode
+	for shape: int in range(6): result.add_blend_shape(original.get_blend_shape_name(shape))
+	var prefix: int = original.get_meta("kart_suit_static_vertices")
+	var packets: Array = original.get("_surfaces").duplicate(true)
+	var bounds := AABB()
+	var first: bool = true
+	for surface: int in range(1,6):
+		var arrays: Array = original.surface_get_arrays(surface)
+		var targets: Array[Array] = original.surface_get_blend_shape_arrays(surface)
+		for pose: int in range(7):
+			var current: Array = arrays.duplicate(true)
+			if pose>0:
+				current[Mesh.ARRAY_VERTEX] = targets[pose-1][Mesh.ARRAY_VERTEX]
+				current[Mesh.ARRAY_NORMAL] = targets[pose-1][Mesh.ARRAY_NORMAL]
+			if surface==1:
+				var input: float = 0 if pose==0 else float((pose-1)%3+1)/3*(-1 if pose<=3 else 1)
+				current = suit(current,prefix,input)
+			else:
+				var points: PackedVector3Array = current[Mesh.ARRAY_VERTEX]
+				var pivot := Vector3(0,0.740213,0.388)
+				for vertex: int in range(points.size()): points[vertex] = torso(pivot)+(points[vertex]-pivot)*HELMET_SCALE
+				current[Mesh.ARRAY_VERTEX] = points
+			for point: Vector3 in current[Mesh.ARRAY_VERTEX]:
+				if first: bounds = AABB(point,Vector3.ZERO); first = false
+				else: bounds = bounds.expand(point)
+			if pose==0: arrays = current
+			else:
+				targets[pose-1][Mesh.ARRAY_VERTEX] = current[Mesh.ARRAY_VERTEX]
+				targets[pose-1][Mesh.ARRAY_NORMAL] = current[Mesh.ARRAY_NORMAL]
+		var rebuilt := ArrayMesh.new()
+		rebuilt.blend_shape_mode = original.blend_shape_mode
+		for shape: int in range(6): rebuilt.add_blend_shape(original.get_blend_shape_name(shape))
+		rebuilt.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays,targets)
+		var packet: Dictionary = rebuilt.get("_surfaces")[0]
+		packet.material = original.surface_get_material(surface)
+		packets[surface] = packet
+	for pose: Array in [original.surface_get_arrays(0)]+original.surface_get_blend_shape_arrays(0):
+		for point: Vector3 in pose[Mesh.ARRAY_VERTEX]: bounds = bounds.expand(point)
+	result.set("_surfaces",packets)
+	for key: StringName in original.get_meta_list(): result.set_meta(key,original.get_meta(key))
+	result.set_meta("kart_driver_anatomy",REVISION)
+	result.custom_aabb = bounds.grow(0.003)
+	return result
diff --git a/game/tests/test_kart_race_scale.gd b/game/tests/test_kart_race_scale.gd
new file mode 100644
index 0000000..2f12624
--- /dev/null
+++ b/game/tests/test_kart_race_scale.gd
@@ -0,0 +1,96 @@
+extends SceneTree
+## KRS01-KRS03: larger native anatomy with fixed contacts and camera projection.
+const OUT = "res://../docs/evidence/kart-driver-race-scale-2026-11-12"
+const ROOT = "res://assets/vehicles/kart_refined_v1/tomkart_driver_v1/"
+var checks: int = 0
+var failures: int = 0
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok: failures += 1; printerr("RACE_SCALE_FAIL ",label)
+func bounds(mesh: ArrayMesh) -> AABB:
+	var first: bool = true
+	var result := AABB()
+	for surface: int in range(mesh.get_surface_count()):
+		for point: Vector3 in mesh.surface_get_arrays(surface)[Mesh.ARRAY_VERTEX]:
+			if first: result = AABB(point,Vector3.ZERO); first = false
+			else: result = result.expand(point)
+	return result
+func centre(points: PackedVector3Array, offset: int, row: int) -> Vector3:
+	var result := Vector3.ZERO
+	for column: int in range(16): result += points[offset+row*17+column]
+	return result/16
+func projected(camera: Camera3D, mesh: ArrayMesh) -> Rect2:
+	var first: bool = true
+	var result := Rect2()
+	for surface: int in range(mesh.get_surface_count()):
+		for point: Vector3 in mesh.surface_get_arrays(surface)[Mesh.ARRAY_VERTEX]:
+			var pixel: Vector2 = camera.unproject_position(point*HandlingConfig.BODY_SCALE)
+			if first: result = Rect2(pixel,Vector2.ZERO); first = false
+			else: result = result.expand(pixel)
+	return result
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	root.size = Vector2i(1280,720)
+	var before: String = OUT+"/before/game/assets/vehicles/kart_refined_v1/tomkart_driver_v1/"
+	var old: ArrayMesh = load(before+"driver.res")
+	var old_head: ArrayMesh = load(before+"helmet_static.res")
+	var mesh: ArrayMesh = load(ROOT+"driver.res")
+	var head: ArrayMesh = load(ROOT+"helmet_static.res")
+	if "--before" in OS.get_cmdline_user_args(): mesh = old; head = old_head
+	check(mesh.get_faces().size()==old.get_faces().size() and head.get_faces().size()==old_head.get_faces().size(),"native triangle budget retained")
+	check(mesh.get_surface_count()==2 and head.get_surface_count()==4 and mesh.get_blend_shape_count()==6,"moving cloth and static helmet roles retained")
+	var old_packet: Dictionary = old.get("_surfaces")[0]
+	var packet: Dictionary = mesh.get("_surfaces")[0]
+	for key: String in ["vertex_data","attribute_data","index_data","blend_shapes"]: check(packet.get(key)==old_packet.get(key),"raw glove/contact packet retained "+key)
+	var arrays: Array = mesh.surface_get_arrays(1)
+	var prior: Array = old.surface_get_arrays(1)
+	for attribute: int in [Mesh.ARRAY_INDEX,Mesh.ARRAY_COLOR,Mesh.ARRAY_TEX_UV]: check(arrays[attribute]==prior[attribute],"sewn topology and cloth attributes retained "+str(attribute))
+	var prefix: int = mesh.get_meta("kart_suit_static_vertices")
+	var fixed: bool = true
+	var count: int = 0
+	for vertex: int in range(prefix):
+		var point: Vector3 = prior[Mesh.ARRAY_VERTEX][vertex]
+		if point.y<0.46 or (point.y<=0.60 and point.z>=0.30):
+			fixed = fixed and point==arrays[Mesh.ARRAY_VERTEX][vertex]
+			count += 1
+	check(fixed and count>600,"hips, legs, soles and supported back retain their fitted positions")
+	var poses: Array[Array] = [arrays]
+	poses.append_array(mesh.surface_get_blend_shape_arrays(1))
+	for pose: int in range(7):
+		var points: PackedVector3Array = poses[pose][Mesh.ARRAY_VERTEX]
+		var normals: PackedVector3Array = poses[pose][Mesh.ARRAY_NORMAL]
+		var finite: bool = points.size()==arrays[Mesh.ARRAY_VERTEX].size()
+		var still: bool = true
+		for vertex: int in range(points.size()): finite = finite and points[vertex].is_finite() and normals[vertex].is_finite() and normals[vertex].length_squared()>0.8 and mesh.custom_aabb.has_point(points[vertex])
+		for vertex: int in range(prefix): still = still and points[vertex]==arrays[Mesh.ARRAY_VERTEX][vertex]
+		check(finite,"finite equal-topology pose inside culling bounds "+str(pose))
+		check(still,"supported body stays fixed through steering "+str(pose))
+		for side: int in range(2):
+			var offset: int = prefix+side*21*17
+			var upper_a: Vector3 = centre(points,offset,2)
+			var upper_b: Vector3 = centre(points,offset,8)
