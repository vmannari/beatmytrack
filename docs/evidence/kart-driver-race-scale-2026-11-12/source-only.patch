+extends SceneTree
+## Offline source/pose preview; never reads owner records or contacts the backend.
+const OUT: String = "res://../docs/evidence/kart-driver-race-scale-2026-11-12"
+
+func _initialize() -> void: run.call_deferred()
+
+func run() -> void:
