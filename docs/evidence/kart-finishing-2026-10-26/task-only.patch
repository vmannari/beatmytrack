+
+static func mechanical(car: CarVisual, trim: Material, metal: Material, bright: Material) -> void:
+	var p: Node3D = car.body
+	var simple: bool = car.simple_model
+	var cast := CompactFinish.alloy(Color("535b5b"))
+	cast.roughness = 0.62
