+static func _sleeve_surface(origin: Vector3, outward: Vector3, sleeves: Array[MeshInstance3D]) -> Vector3:
+	# Project onto the outer union of the two tailored sleeve ellipsoids. This is
+	# evaluated only when creating immutable geometry, never during presentation.
+	var nearest: float = INF
+	for sleeve: MeshInstance3D in sleeves:
+		var inverse: Transform3D = sleeve.transform.affine_inverse()
+		var radii: Vector3 = sleeve.mesh.get_aabb().size*0.5
+		var local_origin: Vector3 = (inverse*origin)/radii
+		var local_direction: Vector3 = (inverse.basis*(-outward))/radii
+		var a: float = local_direction.length_squared()
+		var b: float = 2*local_origin.dot(local_direction)
+		var c: float = local_origin.length_squared()-1
+		var discriminant: float = b*b-4*a*c
+		if discriminant < 0: continue
+		var distance: float = (-b-sqrt(discriminant))/(2*a)
+		if distance >= 0: nearest = minf(nearest,distance)
+	assert(is_finite(nearest),"Sleeve trim must have cloth backing")
+	return origin-outward*nearest+outward*0.001
 
