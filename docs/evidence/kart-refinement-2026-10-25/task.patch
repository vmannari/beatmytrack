+	ALBEDO = mix(vec3(0.043,0.050,0.054),vec3(0.068,0.073,0.074),shoulder)+grain*0.0015-mould*0.005;
+	ROUGHNESS = 0.86-shoulder*0.08;
+	SPECULAR = 0.17;
+}
