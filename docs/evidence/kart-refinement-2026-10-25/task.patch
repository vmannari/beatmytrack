+shader_type spatial;
+// Original smooth racing rubber. Faint moulding/abrasion, no road-tyre tread.
+void fragment() {
+	float shoulder = smoothstep(0.1,0.35,UV.y)*(1.0-smoothstep(0.65,0.9,UV.y));
