+		var collar: MeshInstance3D = car.find_child("Collar",true,false)
+		var helmet_transform: Transform3D = car.body.global_transform.affine_inverse()*helmet.global_transform
+		var rear_hem: float = INF
+		for point: Vector3 in helmet.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]:
+			if absf(point.x) < 0.025 and point.z > 0.38: rear_hem = minf(rear_hem,(helmet_transform*point).y)
+		var collar_top: float = collar.position.y+collar.mesh.get_aabb().end.y
+		var visible_neck: float = rear_hem-collar_top
+		check(is_finite(visible_neck) and visible_neck >= 0.004 and visible_neck <= 0.030,label+" helmet sits close to collar with a short visible neck")
+		check(neck != null and neck.position.y+neck.mesh.get_aabb().end.y >= rear_hem+0.004 and neck.position.y+neck.mesh.get_aabb().position.y <= collar_top-0.004,label+" neck overlaps collar and helmet lining without a floating gap")
+		var head_crossings: Dictionary = {}
+		for part: MeshInstance3D in car.body.find_children("*","MeshInstance3D",true,false):
+			if not (str(part.name).begins_with("TailoredRaceSuit") or str(part.name).begins_with("UpperSleeve") or str(part.name) == "Collar"): continue
+			var to_helmet: Transform3D = helmet.global_transform.affine_inverse()*part.global_transform
+			var faces: PackedVector3Array = part.mesh.get_faces()
+			for triangle: int in range(faces.size()/3):
+				for edge: int in range(3):
+					var a: Vector3 = to_helmet*faces[triangle*3+edge]
+					var b: Vector3 = to_helmet*faces[triangle*3+(edge+1)%3]
+					var length: float = a.distance_to(b)
+					if length < 0.00001: continue
+					var hit: Dictionary = helmet_mesh.intersect_ray(a,(b-a)/length)
+					if not hit.is_empty() and a.distance_to(hit.position) < length-0.00001:
+						head_crossings[str(part.name)] = int(head_crossings.get(str(part.name),0))+1
+		check(head_crossings.is_empty(),label+" helmet clears the actual collar, torso and shoulder cloth "+JSON.stringify(head_crossings))
+		measurements[label] = {"chin_z":chin.get("position",Vector3.ZERO).z,"lowest_helmet_y":lowest,"seat_pan":pan.get("position"),"seat_back":back.get("position"),"torso_back_gap":back_gap,"cloth_edges":edges_tested,"seat_cloth_crossings":crossings,"visible_neck":visible_neck,"rear_helmet_hem":rear_hem,"collar_top":collar_top,"head_cloth_crossings":head_crossings}
 		car.free()
