diff --git a/backend/tests/test_earned_coins.py b/backend/tests/test_earned_coins.py
index 535c5976f..469947912 100644
--- a/backend/tests/test_earned_coins.py
+++ b/backend/tests/test_earned_coins.py
@@ -144,7 +144,7 @@ def test_catalog_matches_shipped_liveries_and_parts():
     catalog = json.loads((root / "backend/bmt_backend/vehicle_appearance_catalog.json").read_text())
