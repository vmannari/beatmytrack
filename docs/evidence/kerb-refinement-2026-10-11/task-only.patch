+manifest = {"schema":"vehicle-audio-bank-v1","revision":"all-loops-8","compact_revision":"engine-4-stable-idle","collision_revision":"owner-crash-3","scrape_revision":"pol-rail-5","kerb_revision":"recorded-rumble-2","rate":RATE,"channels":1,"bits":16,"sources":sources,"outputs":outputs}
 (OUT / "manifest.json").write_text(json.dumps(manifest,indent=2)+"\n",encoding="utf-8")
