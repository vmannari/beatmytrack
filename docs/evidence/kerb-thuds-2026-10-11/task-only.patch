diff --git a/scripts/kerb_audio_mastering.py b/scripts/kerb_audio_mastering.py
index aafdbf97..786ca76f 100644
--- a/scripts/kerb_audio_mastering.py
+++ b/scripts/kerb_audio_mastering.py
@@ -1,27 +1,29 @@
-"""Original clean tyre vibration, generated offline without a field recording."""
+"""Soft rubber/body thuds, synthesized offline without a field recording."""
 import numpy as np
 
 
 def render(read, steady, filter_audio, write, rate):
     count = 8*rate
-    rng = np.random.default_rng(2026101151)
-    hz = np.fft.rfftfreq(count,1/rate)
-    # Broad damped rubber/body resonances, excited by original noise. Wide
-    # bands avoid a pitched engine hum; the upper rolling band adds concrete
-    # texture without the hiss, traffic or engine of the rejected recording.
-    body_shape = (np.exp(-.5*((hz-135)/48)**2)
-                  +.70*np.exp(-.5*((hz-265)/85)**2)
-                  +.25*np.exp(-.5*((hz-490)/135)**2))
-    body = np.fft.irfft(np.fft.rfft(rng.normal(size=count))*body_shape,n=count)
-    rubber = filter_audio(rng.normal(size=count),low=300,high=1150)
-    body /= max(float(np.sqrt(np.mean(body**2))),1e-9)
-    rubber /= max(float(np.sqrt(np.mean(rubber**2))),1e-9)
-    time = np.arange(count,dtype=np.float64)/rate
-    # A shallow continuous flutter suggests tread loading over kerb ridges.
-    # It never closes into a gap or triggers a train of individual impacts.
-    # Slow phase/pressure variation keeps a short perfectly regular beat out.
-    phase = 8*time+.11*np.sin(2*np.pi*.625*time)+.07*np.sin(2*np.pi*1.375*time)
-    flutter = .82+.18*np.cos(2*np.pi*phase)
-    pressure = 1+.07*np.sin(2*np.pi*.375*time)+.04*np.sin(2*np.pi*.875*time)
-    rolling = (body*.86+rubber*.14)*flutter*pressure
-    write("kerb_roll",filter_audio(rolling,low=70,high=1400),[],rms=.15)
+    rng = np.random.default_rng(2026101153)
+    # A quiet low bed joins the tails without masking the separate thuds.
+    bed = filter_audio(rng.normal(size=count),low=90,high=520)
+    bed /= max(float(np.sqrt(np.mean(bed**2))),1e-9)
+    rolling = bed*.035
+    time = np.arange(round(.13*rate),dtype=np.float64)/rate
+    for index in range(48): # Six rounded thuds/s at native pitch.
+        # Quickly falling rubber/body resonance, with soft attack and a short
+        # damped tail. The noise transient is low-passed, never a bright click.
+        pitch = rng.uniform(.96,1.04)
+        phase = 2*np.pi*pitch*(105*time+45*.015*(1-np.exp(-time/.015)))
+        body = np.sin(phase)+.20*np.sin(1.85*phase+.35)
+        contact = filter_audio(rng.normal(size=len(time)),low=130,high=850)
+        contact /= max(float(np.sqrt(np.mean(contact**2))),1e-9)
+        attack = 1-np.exp(-time/.0025)
+        thud = attack*(body*np.exp(-time/.027)+.16*contact*np.exp(-time/.012))
+        thud[-round(.01*rate):] *= np.linspace(1,0,round(.01*rate))
+        offset = round(index*rate/6)
+        positions = (offset+np.arange(len(thud)))%count
+        rolling[positions] += thud*rng.uniform(.93,1.0)
+    # Preserve the thud envelope: shared mastering must not level individual
+    # attacks into the rejected continuous flutter/noise texture.
+    write("kerb_roll",filter_audio(rolling,low=65,high=1100),[],rms=.15)
