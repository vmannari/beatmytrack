+        "metric": metric,
+        "population": count,
+        "minimum_ticks": minimum,
+        "maximum_ticks": maximum,
+        "bins": [
+            {
+                "from_ticks": start + i * width,
+                "to_ticks_exclusive": start + (i + 1) * width,
+                "count": grouped.get(i, 0),
+            }
+            for i in range(occupied_bins)
+        ],
