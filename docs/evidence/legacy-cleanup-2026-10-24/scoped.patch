+func load_more() -> void:
+	if not paged_discovery_available(): return
+	_ensure_discovery_pages()
+	var numbers: Array = discovery_pages.pages.keys()
+	var page: int = 0 if numbers.is_empty() else int(numbers.max())+1
+	if page*20 < int(discovery_pages.total): await discovery_pages._fetch(page)
+
+func search(filters: Dictionary, append: bool = false) -> void:
+	if append: await load_more()
+	else: await query_discovery(filters,_discovery_favorites,_discovery_raced)
+
+func _ensure_discovery_pages() -> void:
+	if is_instance_valid(discovery_pages): return
+	discovery_pages = preload("res://backend/discovery_windows.gd").new()
+	discovery_pages.client = client
+	discovery_pages.cache_directory = cache_root().path_join("discovery")
+	add_child(discovery_pages)
+	discovery_pages.changed.connect(_discovery_changed)
diff --git a/game/backend/discovery_filters.gd b/game/backend/discovery_filters.gd
new file mode 100644
index 0000000000000000000000000000000000000000..0a7a99f369ab59fb16bf8b41cd48352e9ff87e4d
--- /dev/null
+++ b/game/backend/discovery_filters.gd
@@ -0,0 +1,22 @@
+extends RefCounted
+## Current discovery filter contract, shared by cursor windows and search.
+
+static func ids(values: Array) -> Array[String]:
+	var result: Array[String] = []
+	for value: Variant in values:
+		if str(value).begins_with("cloud_"): result.append(str(value).trim_prefix("cloud_"))
+	result.sort()
+	return result
+
+static func payload(filters: Dictionary, favorites: Array = [], raced: Array = []) -> Dictionary:
+	var body: Dictionary = {"search":str(filters.get("search","")),"search_kind":int(filters.get("search_kind",0)),
+		"theme":str(filters.get("theme","all")),"minimum_rating":float(filters.get("minimum_rating",0.0)),
+		"age_days":int(filters.get("age_days",0)),"race_count":str(filters.get("race_count","any")),
+		"race_history":str(filters.get("race_history","any")),"section":str(filters.get("section","all")),
+		"feed":str(filters.get("feed","recommended")),"sort":str(filters.get("sort","recommended"))}
+	if body.feed not in ["recommended","new","popular","trending","rated"]: body.feed = "recommended"
+	if body.sort not in ["recommended","name","creator","score","plays","new"]: body.sort = "recommended"
+	if body.section == "favorites": body.ids = ids(favorites)
+	if body.race_history != "any": body.raced_ids = ids(raced)
+	return body
+
