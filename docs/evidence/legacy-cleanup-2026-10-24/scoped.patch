+def test_fresh_queries_coalesce_across_cache_restart(catalogue):
+    domain = catalogue
+    pages = []
+    for _ in range(3):
+        response = query(domain, fresh=True)
+        assert response.status_code == 200 and len(response.json()["items"]) == 12
+        assert response.json()["total"] is None
