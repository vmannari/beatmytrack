+    path = OUT.parent/name/'result.json'
+    if path.exists() and name.startswith('graphics-app-'):
+        result = json.loads(path.read_text())
+        timings[name] = {'startup':result['startup'],'first':result['menus'][0],'repeat':result['menus'][1]}
+
