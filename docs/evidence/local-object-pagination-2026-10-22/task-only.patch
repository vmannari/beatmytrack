+    original = listing.os.scandir
+    advanced = 0
+
+    class Scan:
+        def __enter__(self):
+            self.stream = original(directory)
+            def rows():
+                nonlocal advanced
+                for row in self.stream:
+                    advanced += 1
+                    yield row
+            return rows()
+
+        def __exit__(self, *_args):
+            self.stream.close()
+
+    monkeypatch.setattr(listing.os, "scandir", lambda _path: Scan())
+    LocalBlobStore(str(tmp_path))
