+"""Overlay one API source on the approved image; preserve every other asset."""
+import hashlib
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/local-race-batch-recovery-2026-10-28'
+cfg=json.loads((ROOT/'.tools/gcp-staging/config.json').read_text(encoding='utf-8-sig'));docker=cfg['docker']
+parent=json.loads((ROOT/'build/backend-resource-optimisation-2026-10-28/release.private.json').read_text())['image']
+name='test_population_batch.py'
+def call(args):
+    r=subprocess.run([*docker,*args],capture_output=True,text=True,check=False,timeout=180)
+    if r.returncode:
+        (WORK/'build.private.log').write_text(r.stdout+r.stderr);raise RuntimeError('Scoped image build failed')
+    return r.stdout
+code="""import hashlib,json;from pathlib import Path;p=Path('/app/bmt_backend');q=Path('/opt/bmt');print(json.dumps({'package':{f.relative_to(p).as_posix():hashlib.sha256(f.read_bytes()).hexdigest() for f in p.rglob('*') if f.is_file() and '__pycache__' not in f.parts},'canonical':{f.relative_to(q).as_posix():hashlib.sha256(f.read_bytes()).hexdigest() for f in q.rglob('*') if f.is_file()}}))"""
+before=json.loads(call(['run','--rm','--network=none','--entrypoint','python',parent,'-c',code]))
+assert before['package'][name]==hashlib.sha256((WORK/'before/backend/bmt_backend'/name).read_bytes()).hexdigest()
+context=WORK/'context';context.mkdir(exist_ok=True)
+shutil.copyfile(ROOT/'backend/bmt_backend'/name,context/name)
+(context/'Dockerfile').write_text('FROM '+parent+'\nCOPY '+name+' /app/bmt_backend/'+name+'\n',newline='\n')
+image='bmt-batch-recovery:'+hashlib.sha256((context/name).read_bytes()).hexdigest()[:16]
+unix='/mnt/'+context.drive[0].lower()+context.as_posix()[2:]
+call(['build','--network=none','--pull=false','-t',image,unix])
+after=json.loads(call(['run','--rm','--network=none','--entrypoint','python',image,'-c',code]))
+assert before['canonical']==after['canonical']
+assert set(before['package'])==set(after['package'])
+assert [n for n in before['package'] if before['package'][n]!=after['package'][n]]==[name]
+result={'parent':parent,'image':image,'changed':[name],'unchanged':len(before['package'])-1,
+    'canonical_files_unchanged':len(before['canonical']),'hashes':after['package'],'schema_changed':False}
