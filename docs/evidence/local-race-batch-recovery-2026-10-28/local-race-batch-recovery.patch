@@ -0,0 +1,62 @@
+"""Task-only forward/reverse checkpoint; never touches the main Git index."""
+import ast
+import hashlib
+import json
+import re
+import secrets
+import shutil
+import subprocess
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/local-race-batch-recovery-2026-10-28'
+candidate=json.loads((WORK/'candidate.json').read_text())
+SCOPE=WORK/('checkpoint-'+secrets.token_hex(4));BEFORE=SCOPE/'before';AFTER=SCOPE/'after'
+BEFORE.mkdir(parents=True);AFTER.mkdir()
+existing=['backend/bmt_backend/test_population_batch.py','backend/deploy/local_artificial.py','scripts/artificial-races.ps1']
+added=['backend/tests/test_local_batch_recovery.py','docs/LOCAL_RACE_BATCH_RECOVERY_2026_10_28.md']
+helpers=[p.relative_to(ROOT).as_posix() for p in WORK.glob('*.py')]
+shared=['AGENTS.md','DEVELOPMENT_STATUS.md','docs/PHASE_0_PLAN.md']
+for name in existing:
+    target=BEFORE/name;target.parent.mkdir(parents=True,exist_ok=True)
+    shutil.copyfile(WORK/'before'/name,target)
+for name in shared:
+    marker='LOCAL-RACE-BATCH-RECOVERY-20261028'
+    value=(ROOT/name).read_bytes()
+    pattern=(r'<!-- '+marker+r' -->.*?<!-- /'+marker+r' -->\r?\n(?:\r?\n)?').encode()
+    original,count=re.subn(pattern,b'',value,flags=re.S);assert count==1
+    target=BEFORE/name;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(original)
+for name in existing+added+helpers:
+    if name.endswith('.py'):ast.parse((ROOT/name).read_text(encoding='utf-8-sig'))
+sources=existing+added+helpers+shared
+(OUT/'source-hashes.json').write_text(json.dumps({n:hashlib.sha256((ROOT/n).read_bytes()).hexdigest() for n in sources},indent=2))
+patch=OUT/'local-race-batch-recovery.patch'
+def hashes(folder):return {p.relative_to(folder).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in folder.rglob('*') if p.is_file()}
+def refresh():
+    evidence=[p.relative_to(ROOT).as_posix() for p in OUT.rglob('*') if p.is_file() and p!=patch]
+    for name in sources+evidence:
+        p=AFTER/name;p.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(ROOT/name,p)
+    r=subprocess.run(['git','-c','core.quotePath=false','diff','--no-index','--binary','--src-prefix=a/','--dst-prefix=b/','before','after'],
+        cwd=SCOPE,capture_output=True,check=False)
+    assert r.returncode==1,r.stderr
+    value=r.stdout
+    for side in (b'a/',b'b/'):
+        for folder in (b'before/',b'after/'):value=value.replace(side+folder,side)
+    patch.write_bytes(value)
+def verify(index):
+    target=SCOPE/('check-'+str(index));shutil.copytree(BEFORE,target)
+    for flags in (['--check'],[]):
+        r=subprocess.run(['git','apply',*flags,'--whitespace=nowarn','--directory='+target.relative_to(ROOT).as_posix(),str(patch)],
+            cwd=ROOT,capture_output=True,check=False)
+        assert r.returncode==0,r.stderr.decode('utf-8','replace')
+    assert hashes(target)==hashes(AFTER)
+    r=subprocess.run(['git','apply','--reverse','--check','--whitespace=nowarn',str(patch)],cwd=ROOT,capture_output=True,check=False)
+    assert r.returncode==0,r.stderr.decode('utf-8','replace')
+refresh();verify(1)
+report=json.loads((OUT/'report.json').read_text());report['checkpoint_verified']=True
+(OUT/'report.json').write_text(json.dumps(report,indent=2)+'\n',encoding='utf-8')
+(OUT/'checkpoint-checks.json').write_text(json.dumps({'forward_check':True,'exact_forward_application':True,'reverse_check_current_workspace':True,
+    'main_index_touched':False,'concurrent_shared_text_preserved':True,'runtime_existing_files':len(candidate['changed']),
+    'runtime_new_files':0,'canonical_game_files_in_patch':0,'scope':'Task runtime delta, local launchers/tests, safe evidence/diagnostics, report and task marker only'},indent=2))
+refresh();verify(2)
+print(json.dumps({'checkpoint_verified':True,'scoped_files':len(hashes(AFTER)),'patch_bytes':patch.stat().st_size,'main_index_touched':False}))
