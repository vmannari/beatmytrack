+"""Owned read-only operator probe, with no private row/hash export."""
+import importlib.util
+import json
+import secrets
+import sys
+import time
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/local-race-batch-recovery-2026-10-28'
+spec=importlib.util.spec_from_file_location('batch_cloud',ROOT/'build/studio-usage-deploy-2026-10-27/deploy.py')
+d=importlib.util.module_from_spec(spec);spec.loader.exec_module(d);d.WORK=WORK
+studio=d.describe(d.BASE+'-studio');template=studio['template'];container=template['containers'][0]
+name=d.BASE+'-batch-contract-'+secrets.token_hex(3)
+task={'serviceAccount':template['serviceAccount'],'timeout':'120s','maxRetries':0,
+    'containers':[{'image':container['image'],'command':['python'],'args':['-c',(WORK/'live_contract_probe.py').read_text()],
+        'env':container.get('env',[]),'resources':{'limits':{'cpu':'1','memory':'768Mi'}},
+        **({'volumeMounts':container['volumeMounts']} if container.get('volumeMounts') else {})}],
+    **({'volumes':template['volumes']} if template.get('volumes') else {})}
+resource={'labels':{'bmt-task':'local-batch-contract'},'template':{'taskCount':1,'parallelism':1,'template':task}}
+d.wait_operation(d.api('POST',f'https://run.googleapis.com/v2/projects/{d.PROJECT}/locations/{d.REGION}/jobs',params={'jobId':name},body=resource))
+(WORK/'probe.private.json').write_text(json.dumps({'name':name}))
+try:
+    d.gc('run','jobs','execute',name,'--region='+d.REGION,'--wait','--format=json',label='read-only-probe',timeout=180)
+    for _ in range(10):
+        entries=d.api('POST','https://logging.googleapis.com/v2/entries:list',body={'resourceNames':['projects/'+d.PROJECT],
+            'filter':'resource.type="cloud_run_job" AND resource.labels.job_name="'+name+'" AND jsonPayload.event="local_batch_contract_probe"',
+            'orderBy':'timestamp desc','pageSize':5})
+        if entries.get('entries'):break
+        time.sleep(2)
+    assert entries.get('entries'),'Read-only aggregate log not visible yet'
+    value=entries['entries'][0]['jsonPayload'];assert value['read_only']
+    file='live-contract-after.json' if '--after' in sys.argv else 'live-contract-diagnosis.json'
+    (OUT/file).write_text(json.dumps(value,indent=2));print(json.dumps(value),flush=True)
+finally:
+    current=d.describe(name,'jobs');assert current['labels']['bmt-task']=='local-batch-contract'
+    d.gc('run','jobs','delete',name,'--region='+d.REGION,label='owned-probe-cleanup')
+    (OUT/'diagnostic-cleanup.json').write_text(json.dumps({'owned_probe_removed':True,'private_rows_or_hashes_exported':False}))
