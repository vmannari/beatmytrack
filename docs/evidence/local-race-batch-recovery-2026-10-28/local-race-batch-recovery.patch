+    result=checks(route['uri'])
+    old=d.state['before']['api']['latestReadyRevision'].rsplit('/',1)[-1]
+    assert any(r.get('percent')==100 and r['revision'].rsplit('/',1)[-1]==old for r in current['trafficStatuses'])
+    d.state.update(tag=tag,revision=route['revision'],url=route['uri'],canary_passed=True);d.save()
+    d.write(OUT/'canary-checks.json',result);print(json.dumps({'candidate':route['revision'],'checks':result}),flush=True)
+def promote():
+    guard();assert d.state.get('canary_passed');checks(d.state['url'])
+    d.gc('run','services','update-traffic',d.BASE+'-api','--region='+d.REGION,
+        '--to-revisions='+d.state['revision'].rsplit('/',1)[-1]+'=100','--format=json',label='api-promote',timeout=180)
+    d.state['promoted']=True;d.save();print('API repair promoted; all other workloads remain unchanged.')
+def finish():
+    assert d.state.get('promoted');guard()
+    d.gc('run','services','update-traffic',d.BASE+'-api','--region='+d.REGION,'--remove-tags='+d.state['tag'],
+        '--format=json',label='tag-cleanup')
+    api=d.describe(d.BASE+'-api');normal=checks(api['uri']);compare(d.state['before']['api'],api)
+    assert any(r.get('percent')==100 and r['revision'].rsplit('/',1)[-1]==d.state['revision'].rsplit('/',1)[-1] for r in api['trafficStatuses'])
+    for kind in ('studio','worker'):
+        assert d.definition(d.describe(d.BASE+'-'+kind,'workerPools' if kind=='worker' else 'services'))==d.definition(d.state['before'][kind])
+    for job in d.state['jobs']:assert d.definition(d.describe(job['name'].rsplit('/',1)[-1],'jobs'))==d.definition(job)
+    policy=json.loads(d.gc('run','services','get-iam-policy',d.BASE+'-api','--region='+d.REGION,'--format=json',label='final-iam'))
+    assert policy==d.state['policy']
+    assert json.loads(d.LOCK.read_text())['task']==TASK;d.LOCK.unlink()
+    d.state.update(complete=True,finished_at=datetime.now(timezone.utc).isoformat());d.save()
+    receipt={'image':d.state['image'],'revision':d.state['revision'],'normal_checks':normal,'worker_studio_seven_jobs_unchanged':True,
+        'resources_iam_schema_canonical_unchanged':True,'tag_and_lock_removed':True,'finished_at':d.state['finished_at']}
+    d.write(OUT/'deployment.json',receipt);print(json.dumps(receipt))
+if __name__=='__main__':
+    parser=argparse.ArgumentParser();parser.add_argument('stage',choices=('prepare','push','canary','promote','finish'))
+    globals()[parser.parse_args().stage]()
