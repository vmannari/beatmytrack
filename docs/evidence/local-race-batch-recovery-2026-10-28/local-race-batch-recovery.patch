+"""One-file API repair; worker, Studio, jobs, game assets and schema stay exact."""
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+import secrets
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+import requests
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/local-race-batch-recovery-2026-10-28'
+spec=importlib.util.spec_from_file_location('batch_release',ROOT/'build/studio-usage-deploy-2026-10-27/deploy.py')
+d=importlib.util.module_from_spec(spec);spec.loader.exec_module(d)
+d.WORK=WORK;d.STATE=WORK/'release.private.json';d.OUT=OUT
+d.state=json.loads(d.STATE.read_text()) if d.STATE.exists() else {}
+candidate=json.loads((WORK/'candidate.json').read_text());TASK='local-race-batch-recovery-20261028'
+def compare(old,new):
+    a=copy.deepcopy(d.definition(old));b=copy.deepcopy(d.definition(new))
+    for value in (a,b):value.pop('traffic',None);value['template'].pop('revision',None)
+    b['template']['containers'][0]['image']=a['template']['containers'][0]['image'];assert a==b,'API settings changed beyond image'
+def guard():
+    assert not d.LOCK.exists() or json.loads(d.LOCK.read_text()).get('task')==TASK
+    current=d.describe(d.BASE+'-api');compare(d.state['before']['api'],current)
+    assert current['template']['containers'][0]['image'] in (candidate['parent'],d.state.get('image'))
+def prepare():
+    assert not d.state
+    before={k:d.describe(d.BASE+'-'+k,'workerPools' if k=='worker' else 'services') for k in ('api','studio','worker')}
+    assert before['api']['template']['containers'][0]['image']==candidate['parent']
+    jobs=d.api('GET',f'https://run.googleapis.com/v2/projects/{d.PROJECT}/locations/{d.REGION}/jobs')
+    jobs=[j for j in jobs.get('jobs',[]) if j['name'].rsplit('/',1)[-1].startswith(d.BASE+'-')];assert len(jobs)==7
+    policy=json.loads(d.gc('run','services','get-iam-policy',d.BASE+'-api','--region='+d.REGION,'--format=json',label='before-iam'))
+    d.state.update(before=before,jobs=jobs,policy=policy);d.save();print('API-only repair baseline captured.')
+def push():
+    guard();proof=json.loads((WORK/'tests-passed.json').read_text());assert proof['passed'] and proof['hashes']==candidate['hashes']
+    if not d.LOCK.exists():
+        with d.LOCK.open('x') as stream:json.dump({'task':TASK},stream)
+    registry=d.REGION+'-docker.pkg.dev';remote=registry+'/'+d.PROJECT+'/'+d.BASE+'-images/backend:batch-recovery-'+hashlib.sha256(json.dumps(candidate['hashes'],sort_keys=True).encode()).hexdigest()[:12]
+    auth=WORK/'registry.private';auth.mkdir(exist_ok=True)
+    try:
+        token=d.gc('auth','print-access-token',label='push-token')
+        d.command([*d.DOCKER,'--config',d.unix(auth),'login',registry,'--username=oauth2accesstoken','--password-stdin'],'registry-login',input_data=token)
+        d.command([*d.DOCKER,'tag',candidate['image'],remote],'tag')
+        d.command([*d.DOCKER,'--config',d.unix(auth),'push',remote],'push',timeout=300)
+        digests=json.loads(d.command([*d.DOCKER,'image','inspect',remote,'--format={{json .RepoDigests}}'],'digest'))
+        d.state['image']=next(v for v in digests if v.startswith(registry+'/'+d.PROJECT+'/'));d.save()
+    finally:
+        file=auth/'config.json'
+        if file.exists():file.unlink()
+    print(json.dumps({'image':d.state['image']}),flush=True)
+def checks(url):
+    result={}
+    for path,expected in [('/health',200),('/ready',200),('/v1/bootstrap',200),('/admin',404),
+        ('/v1/dev/test-drivers/batches/'+str(uuid.uuid4())+'/prepare-local',401)]:
+        response=requests.request('POST' if path.endswith('prepare-local') else 'GET',url+path,
+            verify=str(d.CA),timeout=(5,40),allow_redirects=False)
+        assert response.status_code==expected,(path,response.status_code)
+        result['prepare-local' if path.endswith('prepare-local') else path]=expected
+    return result
+def canary():
+    guard();tag='batch-fix-'+secrets.token_hex(3)
