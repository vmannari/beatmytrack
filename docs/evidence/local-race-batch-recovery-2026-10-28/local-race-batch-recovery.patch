+++ b/build/local-race-batch-recovery-2026-10-28/live_contract_probe.py
@@ -0,0 +1,53 @@
+"""Read only canonical build labels and synthetic-plan aggregates."""
+import json
+from collections import Counter
+
+from sqlalchemy import select, text
+
+from bmt_backend.app import create_admin_app
+from bmt_backend.contracts import build_contract
+from bmt_backend.track_models import OperationState, TrackVersion
+
+app=create_admin_app()
+try:
+    active=app.state.verifier.manifest()
+    with app.state.session_factory() as db:
+        db.execute(text('SET TRANSACTION READ ONLY'))
+        guard=db.get(OperationState,'test-population-active')
+        row=db.get(OperationState,'test-pop-batch:'+guard.details['batch_id']) if guard else None
+        result={'event':'local_batch_contract_probe','read_only':True,'batch_present':row is not None}
+        if row:
+            data=row.details;pinned=data['manifest'];vehicle=data['vehicle_id']
+            old,new=build_contract(pinned),build_contract(active)
+            versions=db.scalars(select(TrackVersion).where(TrackVersion.id.in_([t['version_id'] for t in data['tracks']]))).all()
+            jobs=db.scalars(select(OperationState.details).where(OperationState.id.startswith('test-pop-job:'),
+                OperationState.details['batch_id'].as_string()==data['batch_id'])).all()
+            selected=lambda manifest:{k:manifest.get('vehicles',{}).get(vehicle,{}).get(k) for k in ('handling_version','config_hash')}
+            result.update(vehicle_id=vehicle,batch_status=data.get('status'),batch_tracks=len(data['tracks']),
+                batch_drivers=data['count'],job_status_counts=dict(Counter(j['status'] for j in jobs)),
+                differing_build_fields=[k for k in new if old.get(k)!=new[k]],
+                changed_vehicles=[v for v in set(pinned.get('vehicles',{}))|set(active.get('vehicles',{}))
+                    if pinned.get('vehicles',{}).get(v)!=active.get('vehicles',{}).get(v)],
+                old_physics=pinned.get('physics_version'),active_physics=active.get('physics_version'),
+                old_rules=pinned.get('rules_key'),active_rules=active.get('rules_key'),
+                old_engine=pinned.get('engine_version'),active_engine=active.get('engine_version'),
+                old_selected_handling=selected(pinned)['handling_version'],active_selected_handling=selected(active)['handling_version'],
+                selected_vehicle_config_equal=selected(pinned)==selected(active),
+                track_builds_equal_batch=sum(build_contract(v.manifest)==old for v in versions),
+                track_builds_equal_active=sum(build_contract(v.manifest)==new for v in versions))
+            if data.get('continued_from'):
+                previous=db.get(OperationState,'test-pop-batch:'+data['continued_from'])
+                previous_jobs=db.scalars(select(OperationState.details).where(OperationState.id.startswith('test-pop-job:'),
+                    OperationState.details['batch_id'].as_string()==data['continued_from'])).all()
+                result.update(previous_batch_retained=previous is not None,
+                    previous_batch_status=previous.details['status'] if previous else None,
+                    same_driver_ids=previous is not None and previous.details['player_ids']==data['player_ids'],
+                    previous_job_status_counts=dict(Counter(j['status'] for j in previous_jobs)),
+                    cleared_test_records=data.get('cleared_test_records'))
+        db.rollback()
+    print(json.dumps(result),flush=True)
+except Exception as error:
+    print(json.dumps({'event':'local_batch_contract_probe_failed','error_class':type(error).__name__}),flush=True)
+    raise SystemExit(1) from None
+finally:
+    app.state.studio_reporting.close();app.state.verifier.close();app.state.engine.dispose()
