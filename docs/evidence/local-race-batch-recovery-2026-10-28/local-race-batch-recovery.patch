+"""Owned PostgreSQL fixture for actual optimisation/regression checks."""
+import argparse
+import json
+import os
+import secrets
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/local-race-batch-recovery-2026-10-28';OUT.mkdir(parents=True,exist_ok=True)
+cfg=json.loads((ROOT/'.tools/gcp-staging/config.json').read_text(encoding='utf-8-sig'));docker=cfg['docker']
+statefile=WORK/'test-database.private.json'
+
+
+def call(args):
+    r=subprocess.run([*docker,*args],capture_output=True,text=True,check=False,timeout=60)
+    if r.returncode:raise RuntimeError('Owned fixture command failed')
+    return r.stdout
+
+
+def start():
+    if statefile.exists():
+        state=json.loads(statefile.read_text());value=json.loads(call(['inspect',state['name']]))[0]
+        assert value['Config']['Labels'].get('bmt.optimisation')==state['label'] and value['State']['Running']
+        return state
+    label=secrets.token_hex(16);name='bmt-batch-recovery-'+label[:8];password=secrets.token_hex(24)
+    envfile=WORK/'postgres.private.env';envfile.write_text('POSTGRES_PASSWORD='+password+'\nPOSTGRES_DB=optimisation\n')
+    unix='/mnt/'+envfile.drive[0].lower()+envfile.as_posix()[2:]
+    call(['run','-d','--pull=never','--name',name,'--label','bmt.optimisation='+label,'--cpus=2','--memory=1536m',
+        '--pids-limit=128','--publish','127.0.0.1::5432','--tmpfs','/var/lib/postgresql/data:rw,size=1024m',
+        '--env-file',unix,'postgres:17-bookworm','postgres','-c','max_connections=64','-c','shared_buffers=64MB'])
+    details=json.loads(call(['inspect',name]))[0];port=details['NetworkSettings']['Ports']['5432/tcp'][0]
+    assert port['HostIp']=='127.0.0.1'
+    for _ in range(60):
+        r=subprocess.run([*docker,'exec',name,'pg_isready','-U','postgres'],capture_output=True,check=False,timeout=10)
+        if r.returncode==0:break
+        time.sleep(.25)
+    else:raise RuntimeError('Owned PostgreSQL readiness timeout')
+    state={'name':name,'label':label,'url':f"postgresql+psycopg://postgres:{password}@127.0.0.1:{port['HostPort']}/optimisation"}
+    statefile.write_text(json.dumps(state));return state
+
+
+def main():
+    parser=argparse.ArgumentParser();parser.add_argument('stage',choices=('start','test','stop'))
+    parser.add_argument('--label',default='tests');parser.add_argument('--baseline',action='store_true');args,selection=parser.parse_known_args()
+    if args.stage=='stop':
+        state=json.loads(statefile.read_text());value=json.loads(call(['inspect',state['name']]))[0]
+        assert value['Config']['Labels'].get('bmt.optimisation')==state['label']
+        call(['rm','--force',state['name']]);statefile.unlink()
+        (OUT/'fixture-cleanup.json').write_text(json.dumps({'owned_postgresql_removed':True,'live_database_used':False}))
+        print('Owned test database removed.');return
+    state=start()
+    if args.stage=='start':print('Owned PostgreSQL fixture ready.');return
+    env=os.environ.copy();env['BMT_TEST_DATABASE_URL']=state['url'];env['BMT_LIMITED_TEST_DATABASE_URL']=state['url']
+    test_root=WORK/'before/backend' if args.baseline else ROOT/'backend'
+    env['PYTHONPATH']=os.pathsep.join((str(test_root),str(ROOT)))
+    selection=[x for x in selection if x!='--']
+    result=subprocess.run([sys.executable,'-m','pytest',*selection,'--junitxml='+str(OUT/(args.label+'.xml'))],cwd=test_root,env=env,
+        capture_output=True,text=True,encoding='utf-8',errors='replace',check=False,timeout=600)
+    (OUT/(args.label+'.log')).write_text(result.stdout+result.stderr,encoding='utf-8')
+    print(result.stdout[-7000:]);raise SystemExit(result.returncode)
+
+
+if __name__=='__main__':main()
