+from pathlib import Path
+from urllib.parse import urlencode, urlsplit
+
+from playwright.sync_api import expect, sync_playwright
+
+ROOT = Path(__file__).resolve().parents[1]
+HEAD = "0030_studio_catalogue"
+MASK = ",".join((  # noqa: FLY002 - selector list, not interpolated text
+"#main .stc-id", "#main .mon-id", "#main .stc-avatar", "#main .stc-player-link strong",
+    "#main .stc-track-identity strong", "#main .stc-track-identity small", "#main tbody td a",
+    "#main .stc-facts dd", "#main .mon-facts dd", "#main .case-note", "#main .case-issue-reference",
+    "#main .case-title-link", "#main .stc-cases a", "#main .case-timeline h4", "#main h1",
+    "#main .stc-player-hero h2", "#main select[name=version]", "#main select[name=device_model]",
+    "#main select[name=os_version]", "#main select[name=build_id]", "#main .mon-proof-table td small"))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=ROOT / "docs/evidence/matching-verifier-deploy-2026-10-12/live-browser")
+    args = parser.parse_args()
+    spec = importlib.util.spec_from_file_location("monitor_verified_rollout", ROOT / ".tools/matching_verifier_rollout_20261012.py")
+    rollout = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(rollout)
+    tp = rollout.tp
+    assert tp.receipt.get("verify_live"), "Root must complete live API/image verification before this read-only browser check"
+    resource = tp.service.describe("api", tp.service.n["api"])
+    assert tp.stage.resource_image(resource) == tp.receipt["image"]
+    role, key = tp.prior.read_staff(resource)
+    origin = tp.receipt["url"]
+    output = args.output.resolve()
+    assert output.is_relative_to(ROOT.resolve())
