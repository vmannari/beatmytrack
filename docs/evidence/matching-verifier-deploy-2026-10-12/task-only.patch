+                writes.append({"method": request.method, "path": urlsplit(request.url).path})
+                route.abort()
+            elif not request.url.startswith(origin + "/"):
+                external.append(urlsplit(request.url).path)
+                route.abort()
+            else:
+                route.continue_()
