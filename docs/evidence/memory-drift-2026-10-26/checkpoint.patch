+Godot --headless --audio-driver Dummy --path game --script ../build/memory-drift-2026-10-26/accessibility_probe.gd -- --mode=accessibility --count=10000
+Godot --audio-driver Dummy --rendering-method gl_compatibility --path game --script ../build/memory-drift-2026-10-26/accessibility_probe.gd -- --mode=accessibility --count=10000
