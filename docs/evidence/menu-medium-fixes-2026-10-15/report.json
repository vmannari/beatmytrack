  "resolved_findings": [
    {
      "id": "MREV03",
      "priority": "P2",
      "title": "Tree-owned cancellable browser compilation",
      "implementation": "Reuse the existing Work job owner/reaper. The compiler callable is bound to the script and immutable request snapshot, never the closing Control. Departure cancels and drops the UI reference; only finished workers are reaped. Cloud/local compile paths forward cooperative cancellation and selection serials still fence replies."
    },
    {
      "id": "MREV04",
      "priority": "P2",
      "title": "Prepared native picking and exact wash batching",
      "implementation": "Prepare native Mesh TriangleMesh acceleration with the original covered showroom construction and kit/car replacements. Native nearest-ray intersections preserve current wheel/body frames and inverse-transpose normals. Batch all original up-to32 stroke samples into two persistent ImageTexture updates. Saved mask bytes and fractional scrub accumulators match the saved original implementation."
    },
    {
      "id": "MREV05",
      "priority": "P2",
      "title": "Retained Rivalry presentation",
      "implementation": "Keep the page and original native podium cars on unchanged/status notifications; score-only updates retain/reorder actual rows and update points/ranks/gaps in place. Project visible content rather than signed URL/clock metadata. Real topology changes rebuild the body under the same page with guarded focus and scroll restoration."
    },
    {
      "id": "MREV06",
      "priority": "P2",
      "title": "Passive Store previews and scoped read coalescing",
      "implementation": "Hidden preview preparation makes no requests. Active Stores share products/access reads within a60-second TTL and four scoped cache entries. Force Refresh and checkout recovery retain original behavior. Fresh preview controls hydrate without IO; account changes fence replies and stale readers cannot strand a new client."
    },
    {
      "id": "MREV07",
      "priority": "P2",
      "title": "Ordered background snapshot persistence",
      "implementation": "Preserve immediate bounded RAM snapshots and schema/scope/age validation. Coalesce latest values per path through one existing tree-owned Work job and original atomic JSON writer. At most16 pending paths; copy once per dispatch. Identical data refreshes RAM age immediately and checkpoints its disk timestamp at most once per minute (or half the TTL), rather than flushing per reply."
    },
    {
      "id": "MREV08",
      "priority": "P2",
      "title": "Bounded dirty Garage rendering",
      "implementation": "Retain completed main/reflection images; redraw only actual dirty state or LP/camera/car/snow/wash motion. Four bounded settling draws complete native sky/shadows before retention, including four covered preparation frames. Preserve both existing captures/caps/materials and explicit parent ordering. Final idle pixels equal the original same-world continuous renderer."
    },
    {
      "id": "MREV09",
      "priority": "P2",
      "title": "Bounded selected-record read model",
      "implementation": "Enforce32 entries and2MiB serialized payload bytes in RAM, touch reads as LRU, pin the actual selected rule key, reject an oversized individual payload and clear accounting/values on cache path or account replacement. Existing persistent cache bounds remain."
    }
  ],
