+extends SceneTree
+## Isolated behavior regressions and repeatable menu CPU measurements.
+var checks: int = 0
+var failures: int = 0
+var directory: String
+
+func _initialize() -> void: call_deferred("run")
+
+func check(value: bool, label: String) -> void:
+	checks += 1
+	if not value:
+		failures += 1
