diff --git a/game/ui/content_fit_button.gd b/game/ui/content_fit_button.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/content_fit_button.gd
@@ -0,0 +1,17 @@
+extends Button
+## Deferred fitting belongs to the button, so destruction cancels pending work.
+var _caption_path: NodePath
+var _caption_floor: float = 0.0
+var _caption_padding: float = 0.0
+
+func watch_content(content: Control, minimum_height: float, padding: float = 0.0) -> void:
+	_caption_path = get_path_to(content)
+	_caption_floor = minimum_height
+	_caption_padding = padding
+	content.minimum_size_changed.connect(_fit_content)
+	_fit_content.call_deferred()
+
+func _fit_content() -> void:
+	var content: Control = get_node_or_null(_caption_path)
+	if content != null:
+		custom_minimum_size.y = maxf(_caption_floor,content.get_combined_minimum_size().y+_caption_padding)
diff --git a/game/ui/garage_cached_thumbnail.gd b/game/ui/garage_cached_thumbnail.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/garage_cached_thumbnail.gd
@@ -0,0 +1,40 @@
+extends "res://ui/car_showroom.gd"
+## A photograph of this exact native preview; the interactive Garage stays live.
+var preview_service: Node
+var preview_key: String = ""
+var _image: TextureRect
+
+func _ready() -> void:
+	read_only = true
+	clip_contents = true
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_image = TextureRect.new()
+	_image.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+	_image.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
+	_image.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_image.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
+	add_child(_image)
+	MenuStyle.fill(_image)
+	set_process(false)
+	refresh_thumbnail()
+
+func refresh_thumbnail() -> void:
+	if _image == null or preview_service == null: return
+	var key: String = preview_service.identity(self)
+	if key == preview_key: return
+	preview_key = key
+	_image.texture = null # Never present another paint/kit/condition as current.
+	preview_service.request(self)
+
+func publish_preview(key: String, value: Texture2D) -> void:
+	if key == preview_key and _image != null: _image.texture = value
+
+func apply_livery(value: Dictionary) -> void:
+	livery = value.duplicate(true)
+	refresh_thumbnail()
+
+func apply_customisation(value: Dictionary) -> void:
+	customisation = value.duplicate(true)
+	refresh_thumbnail()
+
+func _exit_tree() -> void: pass
diff --git a/game/ui/garage_preview_cache.gd b/game/ui/garage_preview_cache.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/garage_preview_cache.gd
@@ -0,0 +1,110 @@
+extends Node
+## Seven photos, one temporary native renderer only on a cache miss. No account IO.
+const Build = preload("res://core/build_identity.gd")
+const VERSION: String = "garage-native-previews-v1"
+const MAX_FILES: int = 14
+var directory: String
+var queued: Array[Dictionary] = []
+var active: Dictionary = {}
+var renderer: CarShowroom
+var frames: int = 0
+var renders: int = 0
+var cache_hits: int = 0
+
+func identity(view: CarShowroom) -> String:
+	return JSON.stringify([VERSION,Build.ID,view.vehicle_id,view.livery,view.condition,view.customisation]).sha256_text()
+
+func request(view: CarShowroom) -> void:
+	var key: String = identity(view)
+	var saved: Texture2D = _cached(key)
+	if saved == null and _default(view):
+		var path: String = "res://assets/garage/previews_v1/"+view.vehicle_id+".png"
+		if ResourceLoader.exists(path): saved = load(path)
+	if saved != null:
+		cache_hits += 1
+		view.publish_preview(key,saved)
+		return
+	if DisplayServer.get_name() == "headless": return
+	for job: Dictionary in queued:
+		if job.key == key and job.view.get_ref() == view: return
+	queued.append({"view":weakref(view),"key":key,"vehicle":view.vehicle_id,"paint":view.livery.duplicate(true),"condition":view.condition.duplicate(true),"parts":view.customisation.duplicate(true)})
+
+func _default(view: CarShowroom) -> bool:
+	return view.livery == VehicleLivery.for_car({},view.vehicle_id) and view.condition.is_empty() and view.customisation == VehicleCustomisation.defaults()
+
+func _cached(key: String) -> Texture2D:
+	if directory.is_empty(): return null
+	var path: String = directory.path_join(key+".png")
+	if not FileAccess.file_exists(path): return null
+	var file := FileAccess.open(path,FileAccess.READ)
+	if file == null or file.get_length() > 8388608: return null
+	file.close()
+	var image := Image.new()
+	if image.load(path) != OK or image.get_size() != Vector2i(2048,512): return null
+	return ImageTexture.create_from_image(image)
+
+func _process(_delta: float) -> void:
+	if active.is_empty():
+		while not queued.is_empty():
+			var next: Dictionary = queued.pop_front()
+			var view: Object = next.view.get_ref()
+			if not is_instance_valid(view) or view.preview_key != next.key: continue
+			if not view.is_visible_in_tree():
+				queued.append(next)
+				return
+			active = next
+			renderer = CarShowroom.new()
+			renderer.read_only = true
+			renderer.garage_mode = true
+			renderer.vehicle_id = next.vehicle
+			renderer.livery = next.paint
+			renderer.condition = next.condition
+			renderer.customisation = next.parts
+			renderer.framing_scale = 0.84
+			renderer.position = Vector2(-16384,-16384)
+			renderer.size = Vector2(2048,512)
+			add_child(renderer)
+			frames = 4
+			renders += 1
+			break
+		return
+	var current: Object = active.view.get_ref()
+	if not is_instance_valid(current) or current.preview_key != active.key:
+		_finish()
+		return
+	frames -= 1
+	if frames >= 0:
+		renderer.showroom_viewport.render_target_update_mode = SubViewport.UPDATE_ONCE
+		renderer.reflections.request_draw()
+	elif not RenderingServer.frame_post_draw.is_connected(_capture):
+		RenderingServer.frame_post_draw.connect(_capture,CONNECT_ONE_SHOT)
+
+func _capture() -> void:
+	if active.is_empty() or not is_instance_valid(renderer): return
+	var view: Object = active.view.get_ref()
+	if is_instance_valid(view) and view.preview_key == active.key:
+		var image: Image = renderer.showroom_viewport.get_texture().get_image()
+		view.publish_preview(active.key,ImageTexture.create_from_image(image))
+		if not directory.is_empty() and DirAccess.make_dir_recursive_absolute(directory) == OK:
+			var temporary: String = directory.path_join(active.key+".tmp.png")
+			if image.save_png(temporary) == OK: DirAccess.rename_absolute(temporary,directory.path_join(active.key+".png"))
+			_trim()
+	_finish()
+
+func _finish() -> void:
+	if RenderingServer.frame_post_draw.is_connected(_capture): RenderingServer.frame_post_draw.disconnect(_capture)
+	if is_instance_valid(renderer):
+		remove_child(renderer)
+		renderer.queue_free()
+	renderer = null
+	active = {}
+
+func _trim() -> void:
+	var folder := DirAccess.open(directory)
+	if folder == null: return
+	var files: Array[Dictionary] = []
+	for name: String in folder.get_files():
+		if not name.ends_with(".png") or name.trim_suffix(".png").length()!=64 or not name.trim_suffix(".png").is_valid_hex_number(): continue
+		files.append({"name":name,"at":FileAccess.get_modified_time(directory.path_join(name))})
+	files.sort_custom(func(a: Dictionary,b: Dictionary) -> bool: return a.at < b.at)
+	while files.size() > MAX_FILES: DirAccess.remove_absolute(directory.path_join(files.pop_front().name))
diff --git a/game/race/input_record.gd b/game/race/input_record.gd
new file mode 100644
--- /dev/null
+++ b/game/race/input_record.gd
@@ -0,0 +1,47 @@
+extends RefCounted
+## One integer per immutable input, outside canonical simulation and wire formats.
+const MAX_INPUTS: int = 216000
+
+static func pack(frame: DriveFrame) -> int:
+	return (frame.steer & 255) | (frame.throttle << 8) | (frame.brake << 16) | (frame.handbrake << 24) | (frame.launch_start << 32)
+
+static func unpack(value: int, index: int = 0) -> Array[int]:
+	if value < 0 or value >> 34 != 0: return []
+	var steer: int = value & 255
+	if steer > 127: steer -= 256
+	var launch: int = value >> 32
+	if steer < -127 or launch > 2 or (launch > 0 and index != 0): return []
+	var result: Array[int] = [steer,(value >> 8) & 255,(value >> 16) & 255]
+	var handbrake: int = (value >> 24) & 255
+	if handbrake > 0 or launch > 0: result.append(handbrake)
+	if launch > 0: result.append(launch)
+	return result
+
+static func legacy(frames: Array) -> Array:
+	if frames.is_empty() or frames.size() > MAX_INPUTS: return []
+	var result: Array = []
+	for index: int in range(frames.size()):
+		var value: Variant = frames[index]
+		if value is int:
+			var row: Array[int] = unpack(value,index)
+			if row.is_empty(): return []
+			result.append(row)
+		elif value is Array:
+			# Existing diagnostic and pre-update input-only journals remain exact.
+			if value.size() < 3 or value.size() > 5: return []
+			for channel: int in range(value.size()):
+				if not value[channel] is int: return []
+				var low: int = -127 if channel == 0 else 1 if channel == 4 else 0
+				var high: int = 127 if channel == 0 else 2 if channel == 4 else 255
+				if value[channel] < low or value[channel] > high or (channel == 4 and index != 0): return []
+			result.append(value)
+		else: return []
+	return result
+
+static func count(recording: Dictionary) -> int:
+	if recording.get("frames") is Array:
+		return recording.frames.size() if recording.frames.size() <= MAX_INPUTS else 0
+	if recording.get("schema") != "bmt-local-trajectory-v1" or not recording.has("race_proof"): return 0
+	var value: Variant = recording.get("input_count")
+	if not (value is int or value is float) or not is_finite(float(value)) or float(value) != floorf(float(value)): return 0
+	return int(value) if value > 0 and value <= MAX_INPUTS else 0
diff --git a/game/diagnostics/support_report.gd b/game/diagnostics/support_report.gd
new file mode 100644
--- /dev/null
+++ b/game/diagnostics/support_report.gd
@@ -0,0 +1,40 @@
+extends RefCounted
+## Explicit local support export. Never called by telemetry or during startup.
+const Build = preload("res://core/build_identity.gd")
+const MAX_BYTES: int = 16384
+const MAX_NATIVE_BYTES: int = 65536
+
+static func capture(native: Object = null) -> String:
+	var report: Dictionary = {"schema":"bmt-support-v1","build":Build.ID,"source_sha256":Build.SOURCE_SHA256,"engine":Engine.get_version_info().string,"platform":OS.get_name(),"model":_bounded(OS.get_model_name()),"os_version":_bounded(OS.get_version()),"renderer":RenderingServer.get_current_rendering_method(),"site":"settings.help","exits":[]}
+	if native == null and OS.get_name() == "Android" and Engine.has_singleton("BmtGoogleSignIn"):
+		native = Engine.get_singleton("BmtGoogleSignIn")
+	if native != null and native.has_method("getSupportExits"):
+		var raw: String = str(native.call("getSupportExits"))
+		if raw.to_utf8_buffer().size() <= MAX_NATIVE_BYTES:
+			var exits: Variant = JSON.parse_string(raw)
+			if exits is Array:
+				for exit: Variant in exits.slice(0,4):
+					if not exit is Dictionary: continue
+					var reason: Variant = exit.get("reason")
+					if not (reason is int or reason is float) or not is_finite(float(reason)) or float(reason)!=floorf(float(reason)) or int(reason) not in [4,5,6]: continue
+					var safe: Dictionary = {"reason":int(exit.reason),"frames":[]}
+					if exit.get("at") is float or exit.get("at") is int: safe.at = int(exit.at)
+					if exit.get("frames") is Array:
+						for frame: Variant in exit.frames.slice(0,24):
+							if frame is String and _safe_frame(frame): safe.frames.append(frame)
+					report.exits.append(safe)
+					# Prefer recent exits and keep as many safe frames as fit the budget.
+					while JSON.stringify(report,"  ").to_utf8_buffer().size()>MAX_BYTES and not safe.frames.is_empty(): safe.frames.pop_back()
+					if JSON.stringify(report,"  ").to_utf8_buffer().size()>MAX_BYTES:
+						report.exits.pop_back()
+						break
+	var result: String = JSON.stringify(report,"  ")
+	return result if result.to_utf8_buffer().size() <= MAX_BYTES else JSON.stringify({"schema":"bmt-support-v1","build":Build.ID,"site":"report.limit"})
+
+static func _bounded(value: String) -> String:
+	return value.replace("\n"," ").replace("\r"," ").substr(0,80)
+
+static func _safe_frame(value: String) -> bool:
+	var pattern := RegEx.new()
+	pattern.compile("^(lib(?:godot_android|bmt_track_geometry)[A-Za-z0-9_.-]*\\.so@0x[0-9a-f]{1,16}(?:#[0-9a-f]{1,64})?|org\\.beatmytrack\\.[A-Za-z0-9_.$]+\\([A-Za-z0-9_$]+\\.java:[0-9]{1,7}\\))$")
+	return value.length() <= 220 and pattern.search(value) != null
diff --git a/game/tests/test_mobile_audit_fixes.gd b/game/tests/test_mobile_audit_fixes.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_mobile_audit_fixes.gd
@@ -0,0 +1,208 @@
+extends SceneTree
+## Actual App startup/cache/render lifecycle, exact compact controls and durable journals.
+const InputRecord = preload("res://race/input_record.gd")
+const Cloud = preload("res://backend/cloud_tracks.gd")
+const Support = preload("res://diagnostics/support_report.gd")
+var checks: int = 0
+var failures: int = 0
+var metrics: Dictionary = {}
+var output: String = "res://../build/mobile-audit-fixes-2026-10-26"
+
+class NativeFixture extends RefCounted:
+	var calls: int = 0
+	func getSupportExits() -> String:
+		calls += 1
+		return JSON.stringify([{"reason":5,"at":123,"frames":["libgodot_android.so@0x1abc#a123","/private/owner/token=secret","org.beatmytrack.signin.BmtGoogleSignIn.start(BmtGoogleSignIn.java:42)"],"token":"secret"},{"reason":99,"frames":[]}])
+
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		print("FAIL: ",label)
+func frames(count: int = 8) -> void:
+	for _i: int in range(count):
+		await process_frame
+		if DisplayServer.get_name() != "headless": await RenderingServer.frame_post_draw
+
+func controls() -> void:
+	var before: int = int(Performance.get_monitor(Performance.MEMORY_STATIC))
+	var compact: Array = []
+	var evidence = preload("res://race/attempt_evidence.gd").new()
+	for index: int in range(216000):
+		var frame := DriveFrame.new()
+		frame.steer = index % 255-127
+		frame.throttle = index % 256
+		frame.brake = (index*3) % 256
+		frame.handbrake = (index*7) % 256
+		if index == 0: frame.launch_start = 2
+		evidence.append_input(compact,frame)
+		if index % 997 == 0 or index == 0 or index == 215999:
+			check(InputRecord.unpack(compact[-1],index) == frame.packed(),"all control channels decode exactly "+str(index))
+	metrics.control_bytes = int(Performance.get_monitor(Performance.MEMORY_STATIC))-before
+	check(compact.size()==216000 and compact[0] is int,"recording remains scalar at the existing cap")
+	check(metrics.control_bytes < 8388608,"full control recording stays below 8 MiB")
+	evidence.append_input(compact,DriveFrame.new())
+	check(evidence.overflow and compact.size()==216000,"one overflow retains existing cap and recovery fence")
+	check(InputRecord.unpack(128).is_empty() and InputRecord.unpack(3 << 32).is_empty() and InputRecord.unpack(compact[0],1).is_empty(),"invalid steer/launch values fail closed")
+	var old: Array = [[0,0,0],[1,2,3,0]]
+	check(InputRecord.legacy(old)==old,"old diagnostic row shape remains exact")
+	var folder: String = "user://journal-"+TrackLibrary.unique_id()
+	var ticket: Dictionary = {"ticket_id":"proof-ticket","_submit_key":"fixed-key","_race_proof":{"schema":"fixture","samples":[[1,2,3]]},"_race_ghost":{"fixture":true}}
+	check(Cloud._queue_run_io(ticket,compact,"",[],folder,"fixture"),"new trajectory is durably saved at the cap")
+	var directory: String = folder.path_join("players").path_join("fixture".sha256_text()).path_join("runs")
+	var base: String = directory.path_join("proof-ticket".sha256_text())
+	var job: Dictionary = Cloud._read_file(base+".job.json")
+	var saved: Dictionary = Cloud._read_file(base+".replay.json")
+	var bytes: String = FileAccess.get_file_as_string(base+".replay.json")
+	check(not saved.has("frames") and InputRecord.count(saved)==216000 and saved.race_proof==JSON.parse_string(JSON.stringify(ticket._race_proof)) and saved.ghost==ticket._race_ghost,"new journal stores count, proof and ghost without unused controls")
+	check(job.key=="fixed-key" and bytes.sha256_text()==job.replay_hash,"journal preserves operation key and byte hash")
+	check(Cloud._queue_run_io(ticket,compact,"",[],folder,"fixture") and FileAccess.get_file_as_string(base+".replay.json")==bytes,"retry preserves journal bytes")
+	compact.pop_back()
+	check(not Cloud._queue_run_io(ticket,compact,"",[],folder,"fixture"),"same ticket cannot replace its saved input count")
+	ticket.ticket_id = "legacy-ticket"
+	ticket.erase("_race_proof")
+	ticket.erase("_race_ghost")
+	check(Cloud._queue_run_io(ticket,old,"",[],folder,"fixture"),"legacy input-only journal remains writable")
+	base = directory.path_join("legacy-ticket".sha256_text())
+	saved = Cloud._read_file(base+".replay.json")
+	check(saved.frames==JSON.parse_string(JSON.stringify(old)) and InputRecord.count(saved)==2,"legacy journal remains readable")
+	check(InputRecord.count({"schema":"bmt-local-trajectory-v1","race_proof":{},"input_count":1.5})==0,"fractional input count is rejected")
+
+func teardown_and_support() -> void:
+	for _index: int in range(32):
+		var pause: Control = preload("res://ui/race_pause_menu.gd").new()
+		var hud := PlaygroundHUD.new()
+		pause.hud = hud
+		root.add_child(pause)
+		pause.free() # Deferred callbacks must belong to the destroyed button.
+		hud.free()
+	await frames(2)
+	check(true,"immediate pause destruction completes without freed-capture errors")
+	var native := NativeFixture.new()
+	check(native.calls==0,"diagnostics do not read native traces before the explicit action")
+	var source: String = Support.capture(native)
+	var report: Dictionary = JSON.parse_string(source)
+	check(native.calls==1 and report.exits.size()==1 and report.exits[0].frames.size()==2,"explicit guest diagnostic action retains only validated first-party sites")
+	check(not source.contains("secret") and not source.contains("/private") and source.to_utf8_buffer().size()<=Support.MAX_BYTES,"support export is bounded and redacted")
+	check(report.has("build") and report.has("source_sha256") and not report.has("player"),"support sites have build mapping without account data")
+
+func run() -> void:
+	create_timer(150).timeout.connect(func() -> void: print("FAIL: audit-fix deadline"); quit(1))
+	for argument: String in OS.get_cmdline_user_args():
+		if argument.begins_with("--output="): output = argument.trim_prefix("--output=")
+	output = ProjectSettings.globalize_path(output)
+	DirAccess.make_dir_recursive_absolute(output)
+	controls()
+	await teardown_and_support()
+	root.size = Vector2i(1280,720)
+	var app: Node = load("res://core/app.tscn").instantiate()
+	var folder: String = "user://audit-fixes-"+TrackLibrary.unique_id()
+	app.records = LocalRecords.new(folder.path_join("records.json"))
+	app.records.settings.music_enabled = false
+	app.library = TrackLibrary.new(folder.path_join("tracks"))
+	app.cloud_root_override = folder.path_join("cloud")
+	var began: int = Time.get_ticks_usec()
+	root.add_child(app)
+	while not app.startup_complete: await process_frame
+	metrics.startup_ms = (Time.get_ticks_usec()-began)/1000.0
+	check(app.screen=="account" and not is_instance_valid(app._retained_garage),"fresh guest reaches Account without constructing Garage")
+	app._show_screen("tracks")
+	await frames(12)
+	check(not is_instance_valid(app._retained_garage),"Race neighbors do not secretly construct a cold Garage")
+	began = Time.get_ticks_usec()
+	app._show_screen("garage")
+	while app.screen != "garage": await process_frame
+	await frames(12)
+	metrics.first_garage_ms = (Time.get_ticks_usec()-began)/1000.0
+	var page: GaragePage = app._retained_garage
+	var view: CarShowroom = page.showroom
+	check(page.cached_carousel and page.thumbnails.size()==7,"production App uses all seven cached native cards")
+	metrics.garage_viewports = page.find_children("*","SubViewport",true,false).size()
+	check(metrics.garage_viewports==3,"retained Garage owns only main and two reflection viewports")
+	check(page._preview_service.renders==0 and page._preview_service.cache_hits==7,"all factory previews load without building a workshop")
+	for id: String in page.thumbnails:
+		var card: CarShowroom = page.thumbnails[id]
+		check(card._image.texture != null and card.car==null and card.showroom_viewport==null,"cached card has an image and no native world "+id)
+	if DisplayServer.get_name() != "headless":
+		root.get_texture().get_image().save_png(output.path_join("garage-cached.png"))
+		var music: GameSoundtrack = GameSoundtrack.instance()
+		var silence := AudioStreamWAV.new()
+		silence.mix_rate = 22050
+		silence.loop_mode = AudioStreamWAV.LOOP_FORWARD
+		silence.loop_end = 44100
+		var data := PackedByteArray(); data.resize(44100); silence.data = data
+		music.music_enabled = true
+		music.mode = "menu"
+		music.menu_player.stream = silence
+		music.menu_player.play()
+		await frames(12)
+		var before: PackedInt64Array = view.reflections.draw_requests.duplicate()
+		var rotation_before: float = view.record_vinyl.rotation.y
+		await frames(24)
+		metrics.vinyl_reflection_draws = [view.reflections.draw_requests[0]-before[0],view.reflections.draw_requests[1]-before[1]]
+		check(view.record_vinyl.rotation.y!=rotation_before and view.reflections.draw_requests[0]>before[0],"playing vinyl still animates with its room reflection")
+		check(view.reflections.draw_requests[1]==before[1],"playing vinyl never redraws unchanged car-only reflection")
+		view.rotate_view(Vector2(20,0))
+		await frames(8)
+		check(view.reflections.draw_requests[1]>before[1],"camera movement refreshes car reflections")
+		music.music_enabled = false
+		music.menu_player.stop()
+		# A changed finish renders once, caches by exact appearance, then reuses it.
+		var card: CarShowroom = page.thumbnails.compact
+		var factory_pixels: PackedByteArray = card._image.texture.get_image().get_data()
+		var paint: Dictionary = card.livery.duplicate(true)
+		paint.colors.body = "c72d34"
+		card.apply_livery(paint)
+		paint.colors.body = "d23735"
+		card.apply_livery(paint) # Supersede the queued first finish before it renders.
+		var deadline: int = Time.get_ticks_msec()+30000
+		while card._image.texture==null and Time.get_ticks_msec()<deadline: await frames(1)
+		check(card._image.texture!=null and page._preview_service.renders==1,"custom appearance is rendered once by one temporary showroom")
+		var custom_image: Image = card._image.texture.get_image()
+		var colours: Dictionary = {}
+		for y: int in range(8):
+			for x: int in range(16): colours[custom_image.get_pixel(x*128+64,y*64+32).to_html()] = true
+		check(custom_image.get_data()!=factory_pixels and colours.size()>20,"custom cache contains a detailed changed native image")
+		check(card.livery.colors.body=="d23735" and card.preview_key==page._preview_service.identity(card),"superseded finish cannot publish a stale preview")
+		await frames(3)
+		check(page._preview_service.renderer==null,"temporary native renderer is released after capture")
+		var hits: int = page._preview_service.cache_hits
+		page._preview_service.request(card)
+		check(page._preview_service.cache_hits==hits+1,"exact custom appearance reuses owned disk cache")
+	var retained: CarShowroom = view
+	app._show_screen("settings")
+	check(view.reflections.views.all(func(capture: SubViewport) -> bool: return capture.render_target_update_mode==SubViewport.UPDATE_DISABLED),"hidden retained Garage stops both reflection captures")
+	var settings: SettingsPage = app.root_ui.find_child("SettingsPage",true,false)
+	settings._show_section("help")
+	await frames(4)
+	var copy: Button = settings.find_child("CopyDiagnosticReport",true,false)
+	check(copy!=null and not copy.disabled and copy.size.y>=48,"guest Help exposes a normal diagnostic action")
+	if DisplayServer.get_name()!="headless":
+		var analytics_before: bool = bool(app.records.settings.get("optional_analytics",false))
+		var clipboard_before: String = DisplayServer.clipboard_get()
+		copy.pressed.emit()
+		var exported: Variant = JSON.parse_string(DisplayServer.clipboard_get())
+		check(exported is Dictionary and exported.get("schema")=="bmt-support-v1","actual Help action copies the local report")
+		check(bool(app.records.settings.get("optional_analytics",false))==analytics_before and not analytics_before,"support export does not change guest analytics consent")
+		DisplayServer.clipboard_set(clipboard_before)
+		await frames(2)
+		root.get_texture().get_image().save_png(output.path_join("settings-help-diagnostics.png"))
+	app._show_screen("garage")
+	await frames()
+	check(app._retained_garage==page and page.showroom==retained,"warm Settings round trip retains exact main showroom")
+	app.records = LocalRecords.new(folder.path_join("other-records.json"))
+	app._rebuild_profile_menu("account")
+	await frames()
+	check(not is_instance_valid(app._retained_garage) and app.screen=="account","owner change releases previews without constructing another Garage")
+	app._show_screen("garage")
+	app._show_screen("tracks")
+	await frames(8)
+	check(app.screen=="tracks" and not is_instance_valid(app._retained_garage),"navigation cancels an obsolete first-entry preparation before construction")
+	app.queue_free()
+	await frames(3)
+	metrics.checks = checks; metrics.failures = failures
+	var file := FileAccess.open(output.path_join("focused-"+DisplayServer.get_name()+".json"),FileAccess.WRITE)
+	file.store_string(JSON.stringify(metrics,"  "))
+	print("MOBILE_AUDIT_FIXES: ",checks," checks, ",failures," failures ",JSON.stringify(metrics))
+	quit(1 if failures else 0)
diff --git a/scripts/bake_garage_previews.gd b/scripts/bake_garage_previews.gd
new file mode 100644
--- /dev/null
+++ b/scripts/bake_garage_previews.gd
@@ -0,0 +1,58 @@
+extends SceneTree
+## Run with the pinned engine and a graphical renderer. Native game assets only.
+const NATIVE_UI: Array[String] = ["car_showroom.gd","garage_environment.gd","garage_reflections.gd","garage_details.gd","garage_drain.gd","garage_furnishings.gd","garage_materials.gd","garage_workshop.gd","garage_record_station.gd","garage_lp_box.gd","garage_plant.gd","garage_car_reveal.gd","garage_wash_effect.gd","garage_wash_geometry.gd","garage_wash_tool.gd","garage_hose_geometry.gd","garage_hose_rig.gd"]
+
+func _sources() -> Dictionary:
+	var sources: Dictionary = {}
+	for directory: String in ["res://vehicle","res://ui"]:
+		for name: String in DirAccess.get_files_at(directory):
+			if not name.ends_with(".gd") and not name.ends_with(".gdshader") and not name.ends_with(".gdshaderinc"): continue
+			if directory.ends_with("/ui") and not (name in NATIVE_UI or name.begins_with("showroom_") or name.begins_with("studio_") or (name.begins_with("garage_") and not name.ends_with(".gd"))): continue
+			var path: String = directory.path_join(name)
+			sources["game/"+path.trim_prefix("res://")] = FileAccess.get_sha256(path)
+	for name: String in DirAccess.get_files_at("res://resources/cars"):
+		if name.ends_with(".tres"): sources["game/resources/cars/"+name] = FileAccess.get_sha256("res://resources/cars/"+name)
+	for path: String in ["res://resources/original_slide.tres","res://soundtrack/record_library.gd"]:
+		sources["game/"+path.trim_prefix("res://")] = FileAccess.get_sha256(path)
+	return sources
+
+func _initialize() -> void: run.call_deferred()
+func run() -> void:
+	if DisplayServer.get_name()=="headless":
+		push_error("Garage previews require a graphical renderer")
+		quit(1)
+		return
+	var folder: String = ProjectSettings.globalize_path("res://assets/garage/previews_v1")
+	DirAccess.make_dir_recursive_absolute(folder)
+	var sources: Dictionary = _sources()
+	var hashes: Dictionary = {}
+	for id: String in VehicleCatalog.IDS:
+		var view := CarShowroom.new()
+		view.vehicle_id = id
+		view.read_only = true
+		view.garage_mode = true
+		view.framing_scale = 0.84
+		view.livery = VehicleLivery.for_car({},id)
+		view.customisation = VehicleCustomisation.defaults()
+		view.size = Vector2(2048,512)
+		root.add_child(view)
+		for index: int in range(5):
+			view.showroom_viewport.render_target_update_mode = SubViewport.UPDATE_ONCE
+			view.reflections.request_draw()
+			await process_frame
+			await RenderingServer.frame_post_draw
+		var pixels: Image = view.showroom_viewport.get_texture().get_image()
+		var path: String = folder.path_join(id+".png")
+		if pixels.save_png(path)!=OK: quit(1); return
+		hashes[id] = FileAccess.get_sha256(path)
+		print("NATIVE_THUMBNAIL ",id," ",pixels.get_size()," ",hashes[id])
+		view.queue_free()
+		await process_frame
+		await process_frame
+	if sources != _sources():
+		push_error("Native preview sources changed during the bake; repeat after those edits finish")
+		quit(1)
+		return
+	var output := FileAccess.open(folder.path_join("provenance.json"),FileAccess.WRITE)
+	output.store_string(JSON.stringify({"source":"Full original CarShowroom, default paint/kits, clean condition, original workshop and reflection settings","engine":Engine.get_version_info().string,"renderer":RenderingServer.get_current_rendering_method(),"size":[2048,512],"hashes":hashes,"sources":sources},"\t")+"\n")
+	quit()
diff --git a/scripts/check_garage_previews.py b/scripts/check_garage_previews.py
new file mode 100644
--- /dev/null
+++ b/scripts/check_garage_previews.py
@@ -0,0 +1,27 @@
+"""Reject stale/missing packaged native Garage previews before export."""
+import hashlib
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def check():
+    folder = ROOT / 'game/assets/garage/previews_v1'
+    provenance = json.loads((folder / 'provenance.json').read_text(encoding='utf-8'))
+    expected = {'compact', 'pickup', 'classic', 'formula', 'kart', 'forklift', 'electric'}
+    if set(provenance['hashes']) != expected:
+        raise ValueError('Seven native default previews are required')
+    if not provenance['sources']:
+        raise ValueError('Native preview source manifest is required')
+    for file, digest in provenance['sources'].items():
+        if hashlib.sha256((ROOT / file).read_bytes()).hexdigest() != digest:
+            raise ValueError(f'Stale Garage preview: {file}; rerun scripts/bake_garage_previews.gd')
+    for vehicle, digest in provenance['hashes'].items():
+        if hashlib.sha256((folder / f'{vehicle}.png').read_bytes()).hexdigest() != digest:
+            raise ValueError(f'Changed Garage preview: {vehicle}')
+    print(f'GARAGE_PREVIEWS: 7 exact native images, {len(provenance["sources"])} current source hashes')
+
+
+if __name__ == '__main__':
+    check()
diff --git a/scripts/retain_native_symbols.ps1 b/scripts/retain_native_symbols.ps1
new file mode 100644
--- /dev/null
+++ b/scripts/retain_native_symbols.ps1
@@ -0,0 +1,20 @@
+param([Parameter(Mandatory)][string]$Compiled,[Parameter(Mandatory)][string]$Objcopy,[Parameter(Mandatory)][string]$Strip,[string]$Source='')
+$ErrorActionPreference = 'Stop'
+$repoRoot = Split-Path -Parent $PSScriptRoot
+if (-not $Source) { $Source = Join-Path $repoRoot 'native/track_geometry/track_geometry.cpp' }
+$resolvedBinary = (Resolve-Path -LiteralPath $Compiled).Path
+$allowedBuild = [IO.Path]::GetFullPath((Join-Path $repoRoot 'build')) + [IO.Path]::DirectorySeparatorChar
+if (-not $resolvedBinary.StartsWith($allowedBuild,[StringComparison]::OrdinalIgnoreCase)) { throw 'Only freshly compiled workspace build outputs may be stripped.' }
+$debug = $resolvedBinary + '.debug'
+& $Objcopy '--only-keep-debug' $resolvedBinary $debug
+if ($LASTEXITCODE) { throw 'Native debug symbol extraction failed.' }
+& $Strip '--strip-unneeded' $resolvedBinary
+if ($LASTEXITCODE) { throw 'Native library strip failed.' }
+$binaryHash = (Get-FileHash -LiteralPath $resolvedBinary -Algorithm SHA256).Hash.ToLowerInvariant()
+$symbolHash = (Get-FileHash -LiteralPath $debug -Algorithm SHA256).Hash.ToLowerInvariant()
+$destination = Join-Path $repoRoot ('build/symbols/'+$binaryHash)
+New-Item -ItemType Directory -Path $destination -Force | Out-Null
+Copy-Item -LiteralPath $debug -Destination (Join-Path $destination (Split-Path -Leaf $debug)) -Force
+$identity = [IO.File]::ReadAllText((Join-Path $repoRoot 'game/core/build_identity.gd'))
+$receipt = [ordered]@{ schema='bmt-native-symbols-v1'; binary=(Split-Path -Leaf $resolvedBinary); binary_sha256=$binaryHash; symbols=(Split-Path -Leaf $debug); symbols_sha256=$symbolHash; source_sha256=(Get-FileHash -LiteralPath $Source -Algorithm SHA256).Hash.ToLowerInvariant(); build_identity=$identity; engine='4.7.2.stable.official.ed1daf0bf' }
+[IO.File]::WriteAllText((Join-Path $destination 'mapping.json'),($receipt | ConvertTo-Json -Depth 4),[Text.UTF8Encoding]::new($false))
