+			_open_rivalry()
+			return
+		_reset_rivalry_entry_view()
+	if menu_page_motion != null: _finish_menu_page_slide()
+	if not is_instance_valid(menu_body) or not menu_body.is_inside_tree() or not root_ui.is_ancestor_of(menu_body):
+		_show_screen(next)
+		return
