+	for field: String in ["_centers","_directions","_progress","_widths","_road_widths","_notice_reach","_route_hints","_layers","_notice_route_bins","_notice_approaches","_notice_route_layers","_notice_layer_offsets"]:
+		var malformed: Dictionary = track._race_gates.duplicate(true); malformed[field] = "wrong"
+		check(not ARTIFACT.validate(malformed,track,versions),"wrong type rejects "+field)
+	var malformed: Dictionary = track._race_gates.duplicate(true); malformed._notice_layer_offsets[0] = malformed._notice_route_layers.size()
+	check(not ARTIFACT.validate(malformed,track,versions),"invalid layer offset rejects")
+	malformed = track._race_gates.duplicate(true); malformed._notice_route_layers[0] = 2
+	check(not ARTIFACT.validate(malformed,track,versions),"invalid layer value rejects")
+	malformed = track._race_gates.duplicate(true); malformed._notice_route_bins[Vector2i.ZERO] = PackedInt32Array([0,0])
+	check(not ARTIFACT.validate(malformed,track,versions),"duplicate/unsorted route indices reject")
+	var saved_key: String = key
+	track.finish_center += Vector2(0.25,0)
+	check(CACHE.key_for(track,versions) != saved_key,"actual geometry invalidates unchanged declared content hash")
+	track.finish_center -= Vector2(0.25,0)
+	check(not DISK.write_entry(key,track._race_gates,track,versions,func() -> bool: return true),"cancelled worker does not write")
+	check(FileAccess.get_file_as_bytes(path) == original,"cancelled publication preserves existing complete artifact")
+	CACHE.trim_to()
+	var ticket: Dictionary = CACHE.read(key)
+	CACHE.trim_to()
+	CACHE.store(key,track._race_gates,ticket.generation)
+	check(CACHE.count() == 0 and not CACHE.current(ticket.generation),"pressure rejects stale generation")
+	var abandoned := ObservedSession.new()
+	track._race_gates = {}
+	abandoned.prepare_cached(track,func() -> bool: return true)
+	check(not abandoned.initialized and track._race_gates.is_empty(),"cancel before read never installs")
+	var cancelled_read := ObservedSession.new()
+	var cancelled_calls: Array[int] = [0]
+	cancelled_read.prepare_cached(track,func() -> bool:
+		cancelled_calls[0] += 1
+		return cancelled_calls[0] >= 2)
+	check(not cancelled_read.initialized and track._race_gates.is_empty() and CACHE.count() == 0,"cancel after disk read cannot install or retain")
+	var pressured := ObservedSession.new()
+	var calls: Array[int] = [0]
+	pressured.prepare_cached(track,func() -> bool:
+		calls[0] += 1
+		if calls[0] == 2: CACHE.trim_to()
+		return false)
+	check(pressured.initialized and pressured.builds == 1 and CACHE.count() == 0,"pressure during disk read cannot admit stale RAM layout")
+	check(var_to_bytes(track._race_gates) == expected,"pressure fallback preserves all prepared fields")
+	var isolated: String = DISK.directory
+	DISK.directory = "user://test-checkpoint-cancelled-write"
+	var write_calls: Array[int] = [0]
+	check(not DISK.write_entry(key,track._race_gates,track,versions,func() -> bool:
+		write_calls[0] += 1
+		return write_calls[0] >= 4),"cancellation after staging prevents rename")
+	check(DirAccess.get_files_at(DISK.directory).is_empty(),"cancelled staged write removes its temporary file")
+	DISK.directory = "user://test-checkpoint-eviction"
+	for i: int in range(DISK.MAX_FILES+3):
+		var other_key: String = str(i).sha256_text()
+		check(DISK.write_entry(other_key,track._race_gates,track,versions,func() -> bool: return false),"atomic retention write")
+	var files: PackedStringArray = DirAccess.get_files_at(DISK.directory)
+	check(files.size() == DISK.MAX_FILES,"disk retention limits complete artifacts")
+	check(not DISK._owned_filename("owner-save.json") and not DISK._owned_filename("../"+id+".gates"),"pruning owns only bounded cache filenames")
+	DISK.directory = isolated
+	var after_cancel: String = DISK.directory
+	DISK.directory = "user://test-checkpoint-cancelled-build"
+	track._race_gates = {}; CACHE.trim_to()
+	var cancelled_build := ObservedSession.new()
+	cancelled_calls[0] = 0
+	cancelled_build.prepare_cached(track,func() -> bool:
+		cancelled_calls[0] += 1
+		return cancelled_calls[0] >= 3)
+	check(cancelled_build.builds == 1 and CACHE.count() == 0 and not DirAccess.dir_exists_absolute(DISK.directory),"cancellation during construction retains neither RAM nor disk artifact")
+	DISK.directory = after_cancel
+	_write_bytes(path,original.slice(0,105))
+	track._race_gates = {}; CACHE.trim_to()
+	var rebuilt := ObservedSession.new()
+	rebuilt.prepare_cached(track,func() -> bool: return false)
+	check(rebuilt.builds == 1 and var_to_bytes(track._race_gates) == expected,"corrupt file falls back to unchanged builder")
+	check(var_to_bytes(DISK.read_entry(key,track,versions)) == expected,"fallback atomically repairs corrupt artifact")
+	track._race_gates._notice_route_bins[Vector2i(-999,-999)] = PackedInt32Array([0])
+	check(var_to_bytes(CACHE.read(key).layout) == expected,"installed track cannot mutate RAM receipt")
+	track._race_gates = {}; CACHE.trim_to()
+	var worker: RefCounted = preload("res://editor/work_job.gd").start(func(cancelled: Callable) -> Dictionary:
+		var loaded := ObservedSession.new()
+		loaded.prepare_cached(track,cancelled)
+		return {"builds":loaded.builds,"layout":var_to_bytes(track._race_gates)},self)
+	while not worker.done: await process_frame
+	check(worker.result.builds == 0 and worker.result.layout == expected,"actual worker installs exact persistent layout")
+
+func _write_bytes(path: String, bytes: PackedByteArray) -> void:
+	var file := FileAccess.open(path,FileAccess.WRITE)
+	file.store_buffer(bytes); file.flush(); file.close()
diff --git a/game/tests/test_feature_navigation.gd b/game/tests/test_feature_navigation.gd
new file mode 100644
index 0000000000000000000000000000000000000000..c73c4843143079cf5b1b871bc4d91499280e8e9f
--- /dev/null
+++ b/game/tests/test_feature_navigation.gd
@@ -0,0 +1,107 @@
+extends SceneTree
+## Actual App entry, cancellation and ownership in isolated offline storage.
+var app: Node
+var checks: int = 0
+var failures: int = 0
+var observations: Dictionary = {}
+
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool,label: String) -> void:
+	checks += 1
+	if not ok: failures += 1; printerr("FEATURE_NAV_FAIL ",label)
+func frames(count: int = 1) -> void:
+	for _i: int in range(count):
+		if is_instance_valid(app):
+			app._publishing_slots_foreground = true
+			if is_instance_valid(app._garage_preloader): app._garage_preloader.foreground = true
+		await process_frame
+func settle_requests() -> void:
+	var deadline: int = Time.get_ticks_msec()+30000
+	while app._feature_load_pending > 0 and Time.get_ticks_msec()<deadline: await frames()
+	check(app._feature_load_pending == 0,"requested resources settle without blocking")
+	await frames(2)
+func capture(label: String) -> void:
+	if DisplayServer.get_name() == "headless": return
+	await RenderingServer.frame_post_draw
+	var output: String = OS.get_environment("BMT_GRAPHICS_OUTPUT")
+	check(root.get_texture().get_image().save_png(output.path_join(label+".png")) == OK,"capture "+label)
+
+func run() -> void:
+	root.size = Vector2i(1280,720)
+	create_timer(180,true,false,true).timeout.connect(func() -> void: printerr("FEATURE_NAV_TIMEOUT"); quit(1))
+	app = load("res://core/app.gd").new()
+	app.name = "CircuitApp"
+	app.records = load("res://persistence/local_records.gd").new("user://feature-navigation/records.json")
+	app.records.settings.music_enabled = false
+	app.library = load("res://persistence/track_library.gd").new("user://feature-navigation/tracks")
+	app.cloud_root_override = "user://feature-navigation/cloud"
+	root.add_child(app)
+	while not app.startup_complete: await frames()
+	app._garage_preloader.set_process(false)
+	app._publishing_slots_foreground = false
+	check(app.screen == "account" and not app.online.configured,"private offline first menu")
+	check(app._feature_resources.is_empty(),"first menu keeps optional controllers unloaded")
+	var began: int = Time.get_ticks_usec()
+	app._show_screen("garage")
+	observations.garage_entry_call_ms = (Time.get_ticks_usec()-began)/1000.0
+	check(is_instance_valid(app._feature_loading) and app.screen == "account","cold Garage presents cover before resource load")
+	check(not app._feature_resources.has("res://core/features/garage.gd") and not is_instance_valid(app._retained_garage),"cover needs no Garage controller or scene")
+	await capture("garage-cover")
+	var escape := InputEventKey.new()
+	escape.keycode = KEY_ESCAPE
+	escape.physical_keycode = KEY_ESCAPE
+	escape.pressed = true
+	root.push_input(escape,true)
+	await frames(3)
+	check(not is_instance_valid(app._feature_loading) and app.screen == "account","Cancel preserves the previous menu")
+	await settle_requests()
+	check(not app._feature_resources.has("res://core/features/garage.gd") and not is_instance_valid(app._retained_garage),"cancelled load cannot publish a Garage")
+	app._show_screen("garage")
+	await frames()
+	app._show_screen("settings")
+	await settle_requests()
+	check(app.screen == "settings" and not is_instance_valid(app._retained_garage),"new navigation supersedes unfinished entry")
+	await app._show_screen("garage")
+	check(app.screen == "garage" and is_instance_valid(app._retained_garage),"retry installs one real Garage")
+	var garage: Node = app._retained_garage
+	app._show_screen("settings")
+	await app._show_screen("garage")
+	check(app._retained_garage == garage and not is_instance_valid(app._feature_loading),"warm Garage reuses page without a loading cover")
+	app._show_screen("account")
+	app.document = load("res://editor/track_document.gd").create_default()
+	var owner: RefCounted = app.records
+	app._show_screen("create")
+	check(is_instance_valid(app._feature_loading) and not is_instance_valid(app.canvas),"Editor cover precedes authoring controls")
+	await capture("editor-cover")
+	app.records = load("res://persistence/local_records.gd").new("user://feature-navigation/replaced-owner.json")
+	await settle_requests()
+	check(not is_instance_valid(app.canvas) and not is_instance_valid(app._feature_loading),"owner replacement cancels Editor entry")
+	app.records = owner
+	await app._show_screen("create")
+	check(app.screen == "create" and is_instance_valid(app.canvas) and app.canvas.document == app.document,"Editor retry preserves the exact document")
+	app._show_screen("account")
+	var track: RefCounted = load("res://track/native_track.gd").read("res://resources/tracks/ellipse.json")
+	track.metadata.cloud_version = "feature-navigation"
+	app.selected_track = track
+	check(not app._feature_resources.has("res://core/features/race.gd"),"race controller remains cold after menu entries")
+	began = Time.get_ticks_usec()
+	app._start_race(track,false,true)
+	observations.race_entry_call_ms = (Time.get_ticks_usec()-began)/1000.0
+	var loading: Node = app.race_loading
+	check(is_instance_valid(loading) and app.game == null,"race cover precedes race controller and Game loading")
+	check(not app._feature_resources.has("res://core/features/race.gd"),"race loading cover is shell-owned")
+	app._start_race(track,false,true)
+	check(app.race_loading == loading,"duplicate race tap owns one cover")
+	await capture("race-cover")
+	app._show_screen("settings")
+	await settle_requests()
+	check(app.game == null and app.race_loading == null and not app.cloud_starting and app.screen == "settings","navigation cancels a cold race without a hidden Game")
+	observations.checks = checks
+	observations.failures = failures
+	observations.feature_load_ms = app.feature_load_ms.duplicate()
+	FileAccess.open(OS.get_environment("BMT_LOADING_OUTPUT"),FileAccess.WRITE).store_string(JSON.stringify(observations,"  "))
+	print("FEATURE_NAVIGATION ",JSON.stringify(observations))
+	app.queue_free()
+	app = null
+	await frames(24)
+	quit(1 if failures else 0)
diff --git a/game/tests/test_garage_threaded_read_cleanup.gd b/game/tests/test_garage_threaded_read_cleanup.gd
new file mode 100644
index 0000000000000000000000000000000000000000..73a54e9f6543a79edbdaa12df902d0f955e004ee
--- /dev/null
+++ b/game/tests/test_garage_threaded_read_cleanup.gd
@@ -0,0 +1,79 @@
+extends SceneTree
+## Real blocked native resource reads; no owner state or threaded script loading.
+var checks: int = 0
+var failures: int = 0
+
+class BlockingFormat extends ResourceFormatLoader:
+	var entered := Semaphore.new()
+	var release := Semaphore.new()
+	var fail: bool = false
+	func _get_recognized_extensions() -> PackedStringArray: return PackedStringArray(["garagecleanupfixture"])
+	func _handles_type(type: StringName) -> bool: return type == &"Resource"
+	func _get_resource_type(path: String) -> String: return "Resource" if path.get_extension() == "garagecleanupfixture" else ""
+	func _load(_path: String,_original: String,_sub_threads: bool,_cache_mode: int) -> Variant:
+		entered.post()
+		release.wait()
+		if fail: return ERR_CANT_OPEN
+		var result := Resource.new()
+		result.resource_name = "worker finished"
+		return result
+
+func _initialize() -> void: run.call_deferred()
+
+func check(value: bool, message: String) -> void:
+	checks += 1
+	if not value:
+		failures += 1
+		print("FAIL: "+message)
+
+func _wait_entered(format: BlockingFormat) -> bool:
+	var deadline: int = Time.get_ticks_msec()+5000
+	while Time.get_ticks_msec() < deadline:
+		if format.entered.try_wait(): return true
+		await process_frame
+	return false
+
+func run() -> void:
+	var folder: String = "user://garage-read-cleanup-"+str(Time.get_ticks_usec())
+	check(DirAccess.make_dir_recursive_absolute(folder) == OK,"private fixture directory")
+	var script: GDScript = load("res://ui/garage_preloader.gd")
+	var format := BlockingFormat.new()
+	ResourceLoader.add_resource_format_loader(format,true)
+	for fail: bool in [false,true]:
+		format.fail = fail
+		for retiring: bool in [false,true]:
+			var path: String = folder.path_join("case-%s-%s.garagecleanupfixture" % [str(fail),str(retiring)])
+			var file := FileAccess.open(path,FileAccess.WRITE)
+			check(file != null,"owned fixture opens")
+			if file != null: file.store_string("owned fixture")
+			file = null
+			var preloader: Node = script.new()
+			preloader._tree_ref = weakref(self)
+			preloader._wanted.append(path)
+			check(ResourceLoader.load_threaded_request(path) == OK,"Garage fixture request starts")
+			preloader._pending.append(path)
+			check(await _wait_entered(format),"Garage fixture reaches worker gate")
+			if retiring:
+				preloader.free()
+				check(not is_instance_valid(preloader),"Garage retirement does not join unfinished worker")
+			else:
+				preloader._poll_loads()
+				check(preloader._pending.size() == 1,"Garage poll preserves unfinished worker")
+			check(ResourceLoader.load_threaded_get_status(path) == ResourceLoader.THREAD_LOAD_IN_PROGRESS,"worker remains blocked until explicitly released")
+			if fail: print("EXPECTED_FAILURE_BEGIN: Garage worker")
+			format.release.post()
+			var deadline: int = Time.get_ticks_msec()+5000
+			while ResourceLoader.load_threaded_get_status(path) != ResourceLoader.THREAD_LOAD_INVALID_RESOURCE and Time.get_ticks_msec() < deadline:
+				if not retiring: preloader._poll_loads()
+				await process_frame
+			if fail: print("EXPECTED_FAILURE_END: Garage worker")
+			check(ResourceLoader.load_threaded_get_status(path) == ResourceLoader.THREAD_LOAD_INVALID_RESOURCE,"Garage terminal request relinquishes engine token")
+			if not retiring:
+				check(preloader._pending.is_empty(),"completed request leaves pending queue")
+				if fail: check(preloader._failed.has(path) and not preloader._resources.has(path),"Garage failure never installs a null resource")
+				else: check(not preloader._failed.has(path) and preloader._resources.get(path).resource_name == "worker finished","Garage success retains requested asset")
+				preloader.free()
+	ResourceLoader.remove_resource_format_loader(format)
+	for frame: int in range(4): await process_frame
+	print("Garage threaded read cleanup: %d checks, %d failures" % [checks,failures])
+	quit(1 if failures else 0)
diff --git a/game/tests/test_header_staged_preparation.gd b/game/tests/test_header_staged_preparation.gd
new file mode 100644
index 0000000000000000000000000000000000000000..f8dcbeeaeede2e9983c21c928967f5ef05385ea6
--- /dev/null
+++ b/game/tests/test_header_staged_preparation.gd
@@ -0,0 +1,182 @@
+extends SceneTree
+## Actual header capture versus its retained native reference and gated teardown.
+const Cache = preload("res://ui/header_car_appearance_cache.gd")
+const Icons = preload("res://ui/header_car_icons.gd")
+const Profile = preload("res://ui/profile_car.gd")
+const Shared = preload("res://rendering/graphics_preparation.gd")
+const Before = preload("res://../docs/evidence/mobile-performance-implementation-2026-11-06/idle/before/game/ui/header_car_appearance_cache.gd")
+var checks: int = 0
+var failures: int = 0
+
+class Captured extends "res://ui/header_car_appearance_cache.gd":
+	var same_frame_exact: bool = false
+	var texture_roundtrip_exact: bool = false
+	var camera_stable: bool = true
+	var staging_frames: int = 0
+	var restored_geometry: bool = false
+	var original_camera: Transform3D
+	var original_fov: float
+	var geometry: Array[Dictionary] = []
+	func _prepare_header(generation: int, owner: WeakRef) -> void:
+		original_camera = studio.camera.global_transform
+		original_fov = studio.camera.fov
+		for bucket: Array in _preparation.pending.values():
+			for reference: WeakRef in bucket:
+				var mesh: GeometryInstance3D = reference.get_ref()
+				geometry.append({"node":reference,"margin":mesh.extra_cull_margin})
+		await super._prepare_header(generation,owner)
+		if not _preparation_current(generation,owner): return
+		restored_geometry = geometry.all(func(entry: Dictionary) -> bool: return is_instance_valid(entry.node.get_ref()) and entry.node.get_ref().is_visible_in_tree() and entry.node.get_ref().extra_cull_margin == entry.margin)
+	func _preparation_frame(generation: int, owner: WeakRef) -> bool:
+		staging_frames += 1
+		camera_stable = camera_stable and studio.camera.global_transform == original_camera and studio.camera.fov == original_fov
+		var result: bool = await super._preparation_frame(generation,owner)
+		if _preparation_current(generation,owner): camera_stable = camera_stable and studio.camera.global_transform == original_camera and studio.camera.fov == original_fov
+		return result
+	func _after_draw() -> void:
+		if canvas == null or _stage != "draw" or _draws != 1:
+			super._after_draw()
+			return
+		var image: Image = canvas.get_texture().get_image()
+		var key: String = _current.key
+		# Compare the actual operation added by this task in the same target.
+		# Publishing a mipmapped ImageTexture is an existing GPU round trip.
+		preload("res://rendering/graphics_preparation.gd").finish_capture(_graphics_ticket,studio.car.get_parent(),studio.viewport,studio.viewport.get_camera_3d())
+		same_frame_exact = image.get_data() == canvas.get_texture().get_image().get_data()
+		super._after_draw()
+		var texture: Texture2D = preload("res://ui/header_car_icons.gd").customized.get(key)
+		if texture != null:
+			var published: Image = texture.get_image()
+			published.clear_mipmaps()
+			texture_roundtrip_exact = image.get_data() == published.get_data()
+
+func appearance_difference(actual: Image, expected: Image) -> float:
+	# Retain the existing equipped-header reference invariant, including its
+	# straight/premultiplied alpha conversion. Separate native allocations are
+	# not bit deterministic: the archived unchanged-control comparison proves it.
+	var difference: float = 0.0
+	for y: int in range(0,Icons.SIZE.y,2):
+		for x: int in range(0,Icons.SIZE.x,2):
+			var a: Color = actual.get_pixel(x,y)
+			var b: Color = expected.get_pixel(x,y)
+			if b.a > 0 and b.a < 1: b = Color(minf(1,b.r/b.a),minf(1,b.g/b.a),minf(1,b.b/b.a),b.a)
+			difference += absf(a.r-b.r)+absf(a.g-b.g)+absf(a.b-b.b)+absf(a.a-b.a)
+	return difference/float(Icons.SIZE.x*Icons.SIZE.y)
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok: failures += 1; printerr("STAGED_HEADER_FAIL ",label)
+func frames(count: int = 5) -> void:
+	for _i: int in range(count): await process_frame
+func run() -> void:
+	create_timer(240,true,false,true).timeout.connect(func() -> void: printerr("STAGED_HEADER_TIMEOUT"); quit(1))
+	root.size = Vector2i(640,360)
+	Engine.time_scale = 0.0
+	var rows: Array = []
+	for id: String in VehicleCatalog.IDS:
+		var selected: String = ""
+		for argument: String in OS.get_cmdline_user_args():
+			if argument.begins_with("--vehicle="): selected = argument.trim_prefix("--vehicle=")
+		if not selected.is_empty() and id != selected: continue
+		var records := LocalRecords.new("user://graphics-header/"+id+"/records.json")
+		var paint: Dictionary = VehicleLivery.defaults(id)
+		paint.colors.body = "32b5d7"
+		paint.pattern = "offset_gt"
+		records.settings = {"vehicle_liveries":{id:paint},"selected_car":id}
+		VehicleCatalog.selected = id
+		var baseline_records := LocalRecords.new("user://graphics-header-before/"+id+"/records.json")
+		baseline_records.settings = records.settings.duplicate(true)
+		var baseline: Node = Before.new()
+		baseline.allowed = func() -> bool: return true
+		root.add_child(baseline)
+		baseline.bind_records(baseline_records)
+		while not baseline.idle(): await process_frame
+		var baseline_image: Image = Icons.texture(id,baseline_records).get_image()
+		baseline_image.clear_mipmaps()
+		baseline_image.save_png(OS.get_environment("BMT_GRAPHICS_EVIDENCE").path_join(id+"-before.png"))
+		baseline.queue_free()
+		await frames(8)
+		var repeated_records := LocalRecords.new("user://graphics-header-repeat/"+id+"/records.json")
+		repeated_records.settings = records.settings.duplicate(true)
+		var repeated: Node = Before.new()
+		repeated.allowed = func() -> bool: return true
+		root.add_child(repeated)
+		repeated.bind_records(repeated_records)
+		while not repeated.idle(): await process_frame
+		var repeated_image: Image = Icons.texture(id,repeated_records).get_image()
+		repeated_image.clear_mipmaps()
+		repeated_image.save_png(OS.get_environment("BMT_GRAPHICS_EVIDENCE").path_join(id+"-control-repeat.png"))
+		print("HEADER_UNCHANGED_CONTROL_EXACT ",id," ",baseline_image.get_data() == repeated_image.get_data())
+		repeated.queue_free()
+		await frames(8)
+		var service: Node = Captured.new()
+		var permission: Dictionary = {"allowed":true}
+		service.allowed = func() -> bool: return permission.allowed
+		root.add_child(service)
+		Shared.invalidate()
+		service.bind_records(records)
+		var began: int = Time.get_ticks_usec()
+		while not service.idle(): await process_frame
+		var elapsed: float = (Time.get_ticks_usec()-began)/1000.0
+		check(service.camera_stable and service.staging_frames > 0,"real staged draws preserve the exact camera "+id)
+		check(service.restored_geometry,"all geometry visibility and cull margins restored "+id)
+		check(service.captures == 1 and service.peak_worlds == 1 and service.canvas == null,"one owned exact capture "+id)
+		check(not Shared.warmed.is_empty(),"header contributes valid completed preparation "+id)
+		var actual: Image = Icons.texture(id,records).get_image()
+		actual.clear_mipmaps()
+		check(service.same_frame_exact,"shared bookkeeping preserves exact actual capture pixels "+id)
+		var canvas := SubViewport.new()
+		canvas.size = Icons.SIZE
+		canvas.disable_3d = true
+		canvas.transparent_bg = true
+		canvas.render_target_update_mode = SubViewport.UPDATE_ALWAYS
+		root.add_child(canvas)
+		var reference: Control = Profile.make_preview(id,paint,VehicleCustomisation.defaults())
+		reference.header_template = true
+		reference.cooperative_build = true
+		reference.cache_rest_pose = false
+		reference.size = Vector2(Icons.SIZE)
+		canvas.add_child(reference)
+		while not reference.presentation_ready: await process_frame
+		Profile.apply_presentation(reference)
+		for _i: int in range(7): await RenderingServer.frame_post_draw
+		var expected: Image = canvas.get_texture().get_image()
+		expected.save_png(OS.get_environment("BMT_GRAPHICS_EVIDENCE").path_join(id+"-reference.png"))
+		print("STAGED_HEADER_PIXEL_META ",id," ",actual.get_size(),"/",baseline_image.get_size(),"/",expected.get_size()," bytes ",actual.get_data().size(),"/",baseline_image.get_data().size(),"/",expected.get_data().size())
+		var difference: float = appearance_difference(actual,expected)
+		check(difference < 0.02,"retained native equipped-header appearance invariant "+id)
+		check(actual.save_png(OS.get_environment("BMT_GRAPHICS_EVIDENCE").path_join(id+".png")) == OK,"native header evidence "+id)
+		rows.append({"vehicle":id,"ms":elapsed,"programs":Shared.warmed.size(),"same_frame_exact":service.same_frame_exact,"texture_roundtrip_exact":service.texture_roundtrip_exact,"appearance_difference":difference,"baseline_exact":actual.get_data() == baseline_image.get_data(),"unchanged_control_exact":baseline_image.get_data() == repeated_image.get_data()})
+		canvas.queue_free()
+		service.queue_free()
+		await frames(8)
+	var records := LocalRecords.new("user://graphics-header/cancel/records.json")
+	var paint: Dictionary = VehicleLivery.defaults("compact")
+	paint.colors.body = "ff4411"
+	records.settings = {"vehicle_liveries":{"compact":paint}}
+	var service: Node = Cache.new()
+	var permission: Dictionary = {"allowed":false}
+	service.allowed = func() -> bool: return permission.allowed
+	root.add_child(service)
+	Shared.invalidate()
+	service.bind_records(records)
+	await frames(8)
+	check(service.canvas == null and Shared.warmed.is_empty(),"gated header never starts a renderer or publishes preparation")
+	permission.allowed = true
+	service.resume_pending()
+	while service._stage != "prepare": await process_frame
+	var generation: int = service._capture_generation
+	permission.allowed = false
+	await frames(3)
+	check(service.canvas == null and service.captures == 0 and not Icons.ready("compact",records),"closing the gate during real staging releases the world without publication")
+	check(service._capture_generation > generation and service._jobs.size() == 1,"interrupted preparation leaves one pinned retry and invalidates its continuation")
+	permission.allowed = true
+	service.resume_pending()
