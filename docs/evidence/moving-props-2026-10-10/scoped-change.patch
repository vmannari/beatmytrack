+func set_ghost_mode(value: String) -> Error:
+	if value not in PersonalGhostRun.MODES: return ERR_INVALID_PARAMETER
+	ghost_mode = value
+	if preference_records == null: return OK
+	preference_records.settings.ghost_mode = value
