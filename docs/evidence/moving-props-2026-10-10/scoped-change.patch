+var track_width: float = 1.52 * HandlingConfig.BODY_SCALE
+var dust_emitters: Array[GPUParticles3D] = []
+var tyre_emitters: Array[GPUParticles3D] = []
+var deck_dust_emitters: Array[GPUParticles3D] = []
