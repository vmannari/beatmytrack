+function networkRange(bins,limits,fraction=.95,unit='ms'){
+ const total=bins.reduce((a,b)=>a+b,0);if(!total)return 'Not observed';
+ let count=0;for(let i=0;i<bins.length;i++){count+=bins[i];if(count>=total*fraction)return limits[i]==null?`Over ${limits[i-1]} ${unit}`:`${i?limits[i-1]:0}-${limits[i]} ${unit}`;}
+ return 'Not observed';
