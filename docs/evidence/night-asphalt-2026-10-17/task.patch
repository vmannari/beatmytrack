+
+vec2 winter_road_uv(vec2 metres) { return metres.yx/vec2(5.0,9.0); }
+
+float winter_edge_frost(vec2 uv, vec2 p, float half_width) {
+	float tongues = (pigment(p*0.73+vec2(17.3,8.1))-0.5)*0.85;
