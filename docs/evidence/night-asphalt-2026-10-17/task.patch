+	vec3 b = texture(desert_road_albedo,uv+vec2(0.5,0.0),0.75).rgb;
+	vec3 c = texture(desert_road_albedo,uv+vec2(0.0,0.5),0.75).rgb;
+	vec3 d = texture(desert_road_albedo,uv+vec2(0.5,0.5),0.75).rgb;
