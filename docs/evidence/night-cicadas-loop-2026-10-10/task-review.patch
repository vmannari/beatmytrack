@@ -92,14 +92,19 @@ func capture(ambience: NightAmbience) -> void:
 	AudioServer.add_bus_effect(output_bus,record)
 	ambience.configure("pine")
 	ambience.configure("night_city")
+	# This isolated foreground capture must not become an OS-focus test when
+	# another desktop window activates. Focus/pause lifecycle is checked above.
+	ambience.notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
 	ambience.present(1,false,false)
 	await create_timer(0.2).timeout
 	var previous: float = 0.0
 	var wraps: int = 0
 	var began: int = Time.get_ticks_msec()
 	record.set_recording_active(true)
-	while Time.get_ticks_msec() - began < 37000:
+	while Time.get_ticks_msec() - began < 81000:
 		await process_frame
+		ambience.notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
+		ambience.present(0.016,false,false)
 		var cursor: float = ambience.player.get_playback_position()
 		if cursor + 0.1 < previous: wraps += 1
 		previous = cursor
