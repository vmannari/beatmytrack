+            run = session.get(Run,skipped["run_id"])
+            assert run.status == ("failed" if failure_mode == "failed" else "queued")
+            assert session.get(OperationState,"verify:"+run.id) is not None
+            run.lease_until = 0
+            session.commit()
+        if failure_mode == "failed":
