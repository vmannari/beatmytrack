+func _observe_surfaces(state: VehicleState, track: NativeTrack, incoming: Vector2, previous: Vector2, heading: float) -> void:
+	kerb_cooldown = maxf(0.0,kerb_cooldown-VehicleSimulation.STEP)
+	var old_grass: float = surface_model.grass
+	var grounded: bool = state.jump_height<=0.0 and state.roll_ticks==0
+	surface_model.sample_contacts(state,track,grounded)
+	var speed: float = maxf(incoming.length(),state.velocity.length())
+	var theme: String = str(track.metadata.get("theme","pine")) if track!=null else "pine"
+	_observe_snow(state,speed,theme,grounded)
+	if not grounded or theme=="desert" or surface_model.grass==0.0:
+		levels.grass = 0.0
+		(layers.grass as AudioStreamPlayer).volume_linear = 0.0
+	elif surface_model.grass>old_grass:
+		# Raise grass on the actual post-step wheel contact, before rendering.
+		(layers.grass as AudioStreamPlayer).stream_paused = false
+		_layer("grass",_grass_gain(state,speed),_grass_pitch(speed),VehicleSimulation.STEP,false)
+	if theme=="desert":
+		# Raised Desert borders are soft sand, never concrete/body impacts.
+		# Clear a queued hard contact too when the presentation theme changes.
+		pending_kerb = 0.0
+		kerb_hold = 0.0
+		held_kerb = 0.0
+		levels.kerb_roll = 0.0
+		(layers.kerb_roll as AudioStreamPlayer).volume_linear = 0.0
+	if track==null or theme=="desert" or state.track_elevated or state.jump_height>0.0 or state.roll_ticks>0:
+		_layer("kerb_roll",0.0,1.0,VehicleSimulation.STEP,true)
+		kerb_touching = false
+		return
+	var current: float = surface_model.kerb
+	var crossed: float = current
+	# A fast narrow crossing can occur between render samples. Sweep only when
+	# current/previous contact or canonical heave indicates a real kerb nearby.
+	if is_finite(previous.x) and is_finite(previous.y) and (current>0.0 or kerb_touching or state.kerb_velocity.x>.04):
+		var steps: int = clampi(ceili(previous.distance_to(state.position)/.15),1,8)
+		var from_heading: float = heading if is_finite(heading) else state.heading
+		for step: int in range(steps): # Current endpoint was already sampled above.
+			var weight: float = float(step)/steps
+			crossed = maxf(crossed,surface_model.kerb_at(previous.lerp(state.position,weight),lerp_angle(from_heading,state.heading,weight),track))
+	if crossed>0.0 and speed>.5:
+		pending_kerb = maxf(pending_kerb,crossed)
+		# Begin the continuous tyre/body contact on this real physics tick too.
+		# Render-side holds still bridge swept crossings and sparse presentation.
+		_layer("kerb_roll",_kerb_gain(speed,crossed),clampf(sqrt(speed/18.0),.65,1.35),VehicleSimulation.STEP,false)
+		if not kerb_touching and kerb_cooldown==0.0:
+			_event("chassis",lerpf(.15,.36,smoothstep(.5,24.0,speed))*(.65+.35*sqrt(crossed)),.78)
+			kerb_count += 1
+			kerb_cooldown = .08
+	kerb_touching = current>0.0
+	if crossed==0.0 or speed<=.5: _layer("kerb_roll",0.0,1.0,VehicleSimulation.STEP,true)
+
+func _kerb_gain(speed: float, contact: float) -> float:
+	return 1.5*smoothstep(.35,3.0,speed)*(.25+smoothstep(.4,22.0,speed)*.35)*sqrt(contact)
+
+func _ensure_snow() -> void:
+	if layers.has("snow"): return
+	# Winter owns one additional loop at most; other biomes keep their voices.
+	var player: AudioStreamPlayer = _player("Snow","Vehicle")
+	player.stream = _stream("snow",true)
+	layers.snow = player
+	_stream("snow_hit",false)
+	if output_enabled: player.play()
+
+func _snow_gain(speed: float) -> float:
+	var movement: float = smoothstep(.15,2.0,speed)
+	var rolling: float = smoothstep(.5,24.0,speed)
+	return movement*((.08+rolling*.12)*surface_model.snow+(.24+rolling*.36)*sqrt(maxf(surface_model.snow_bank,surface_model.snow_body)))
+
+func _snow_pitch(speed: float) -> float:
+	return .78+.36*smoothstep(.5,28.0,speed)
+
+func _observe_snow(state: VehicleState, speed: float, theme: String, grounded: bool) -> void:
+	snow_cooldown = maxf(0.0,snow_cooldown-VehicleSimulation.STEP)
+	if theme=="winter": _ensure_snow()
+	var contact: float = maxf(surface_model.snow_bank,surface_model.snow_body)
+	var touching: bool = grounded and theme=="winter" and not state.track_elevated and contact>.08
+	if touching and not snow_touching and speed>.6 and snow_cooldown==0.0:
+		# Recorded compressed snow, using the existing bounded event pool.
+		_event("snow_hit",lerpf(.16,.68,smoothstep(.6,22.0,speed))*sqrt(contact),.90)
+		snow_count += 1
+		snow_cooldown = .18
+	# The physical seven-point sampler can briefly clear between bumper and
+	# axle contacts on the same ridge. Rearm only after a short clear interval;
+	# the continuous layer still follows current contact without a stale tail.
+	if touching: snow_release = .35
+	else: snow_release = maxf(0.0,snow_release-VehicleSimulation.STEP)
+	snow_touching = touching or (snow_touching and snow_release>0.0)
+	if not grounded or theme!="winter" or state.track_elevated:
+		snow_touching = false
+		snow_release = 0.0
+	if not layers.has("snow"): return
+	var player: AudioStreamPlayer = layers.snow
+	player.stream_paused = false
+	_layer("snow",_snow_gain(speed),_snow_pitch(speed),VehicleSimulation.STEP,not grounded or theme!="winter" or state.track_elevated or speed<=.15 or (surface_model.snow==0.0 and contact==0.0))
+
+func _grass_gain(state: VehicleState, speed: float) -> float:
+	var movement: float = smoothstep(.35,3.0,speed)
+	var rolling: float = smoothstep(.4,22.0,speed)
+	return .20*movement*(.16+rolling*.44+TireAudio.scrub_amount(state)*.10+surface_model.drive*.08)*sqrt(surface_model.grass)
+
+func _grass_pitch(speed: float) -> float:
+	# Rustle pace rises with travel speed while preserving the recorded texture.
+	return .70+.65*smoothstep(.5,32.0,speed)
+
+func _observe_bridge(state: VehicleState, track: NativeTrack, incoming: Vector2, previous: Vector2, visual_impulse: Vector2) -> void:
+	var changed: bool = bridge_layer_known and bridge_layer!=state.track_elevated
+	bridge_layer = state.track_elevated
+	bridge_layer_known = true
+	if not changed or track==null or state.tick<=bridge_tick or state.jump_height>0.0 or state.roll_ticks>0: return
+	if state.collision_impulse!=Vector2.ZERO or visual_impulse!=Vector2.ZERO or visible_contact.touching: return
+	if not is_finite(previous.x) or not is_finite(previous.y) or previous.distance_squared_to(state.position)<.000001: return
+	var speed: float = maxf(incoming.length(),state.velocity.length())
+	if speed<=.5: return
+	var mouth: bool = false
+	for span: Dictionary in track.creator_bridges:
+		var a: Vector2 = CreatorBridges.local_point(span,previous)
+		var b: Vector2 = CreatorBridges.local_point(span,state.position)
+		for end: float in [0.0,float(span.length)]:
+			if (a.x<end and b.x>=end) or (a.x>end and b.x<=end):
+				var along: float = (end-a.x)/(b.x-a.x)
+				if absf(lerpf(a.y,b.y,along))<float(span.width)*.5: mouth = true
+	if track.creator_bridges.is_empty() and track.bridge_height>0.0:
+		mouth = absf((state.position-previous).normalized().dot(track.bridge_axis))>.75
+	if not mouth: return
+	# One quiet recorded body/suspension thump at each real ground/deck
+	# transition. It shares the existing event slots and has no glass source.
+	_event("chassis",lerpf(.09,.22,smoothstep(.5,26.0,speed)),.86)
+	bridge_tick = state.tick
+	bridge_count += 1
