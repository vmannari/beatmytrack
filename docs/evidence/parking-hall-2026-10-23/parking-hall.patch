+extends SceneTree
+## Actual Garage navigation/input with isolated per-car local saves and captures.
+var checks: int = 0
+var failures: int = 0
+var app: Node
+var page: GaragePage
+var gallery_motion: bool = false
+var output: String = "res://../docs/evidence/parking-hall-2026-10-23/legacy-original"
+
+func _initialize() -> void: _run.call_deferred()
+
+func check(value: bool, label: String) -> void:
+	checks += 1
+	if not value:
+		failures += 1
+		print("FAIL: " + label)
+
+func settle() -> void:
+	await create_timer(0.25).timeout
+	for i: int in range(4): await process_frame
+	if DisplayServer.get_name() != "headless": await RenderingServer.frame_post_draw
+
+func capture(label: String) -> void:
+	if DisplayServer.get_name() == "headless": return
+	await settle()
+	check(root.get_texture().get_image().save_png(output.path_join(label + ".png")) == OK, "capture " + label)
+
+func wash_exterior() -> void:
+	page.showroom.weathering.wash(Vector3(-0.9,0.5,0.1),0.1)
+	page._cleanliness.is_clean(page.showroom)
+	page.showroom.weathering.begin_wash_batch()
+	for point: Vector3 in page._cleanliness.points: page.showroom.weathering.wash(point,8.0)
+	page.showroom.weathering.end_wash_batch()
+	page._save_condition()
+	page._show_section("customise")
+
+func touch(point: Vector2, down: bool, canceled: bool = false) -> void:
+	var event := InputEventScreenTouch.new()
+	event.position = point
+	event.index = 0
+	event.pressed = down
+	event.canceled = canceled
+	root.push_input(event, true)
+
+func tap(control: Control) -> void:
+	var point: Vector2 = control.get_global_rect().get_center()
+	touch(point, true)
+	await process_frame
+	touch(point, false)
+	await settle()
+
+func swipe(control: Control, distance: float, canceled: bool = false) -> void:
+	var point: Vector2 = control.get_global_rect().get_center()
+	touch(point, true)
+	await process_frame
+	var event := InputEventScreenDrag.new()
+	event.index = 0
+	event.position = point + Vector2(distance, 0)
+	event.relative = Vector2(distance, 0)
+	root.push_input(event, true)
+	await process_frame
+	touch(event.position, false, canceled)
+	await settle()
+
+func _run() -> void:
