+func _section(parent: Control, id: String, color: Color) -> VBoxContainer:
+	var panel := PanelContainer.new()
+	panel.name = id
+	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	var style: StyleBoxFlat = MenuStyle.box(color,12)
+	style.set_corner_radius_all(10)
+	style.border_color = Color("304651")
+	style.set_border_width_all(1)
+	panel.add_theme_stylebox_override("panel",style)
+	parent.add_child(panel)
+	var column := VBoxContainer.new()
+	column.add_theme_constant_override("separation",6)
+	panel.add_child(column)
+	return column
+
+func _stat(parent: Control, caption: String, value: String) -> void:
+	var column: VBoxContainer = _section(parent,"PlayerProfile"+caption,Color("0a1720"))
+	var row := HBoxContainer.new()
+	row.add_theme_constant_override("separation",8)
+	column.add_child(row)
+	var number: Label = MenuStyle.label(value,28)
+	number.add_theme_color_override("font_color",MenuStyle.ACCENT)
+	row.add_child(number)
+	row.add_child(MenuStyle.label(caption,12,true))
+
+func _update_track_layout() -> void:
+	var empty: bool = track_count == 0
+	find_child("PlayerProfileTrackScroll",true,false).visible = not empty
+	track_status.size_flags_vertical = Control.SIZE_EXPAND_FILL if empty else Control.SIZE_SHRINK_BEGIN
+	track_status.custom_minimum_size.y = 100 if empty else 0
 
