+      "description": "x,y,heading,filtered curvature,target v,grip,resistance,left corridor,right corridor,elevated layer; s=index*spacing",
+      "type": "array", "minItems": 16, "maxItems": 8192,
+      "items": {
+        "type": "array", "minItems": 10, "maxItems": 10, "items": false,
+        "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number"}, {"type": "number", "maximum": 0}, {"type": "number", "minimum": 0}, {"enum": [0, 1]}]
