diff --git a/game/tests/bake_header_simple_compact.gd b/game/tests/bake_header_simple_compact.gd
index c525280..b443390 100644
--- a/game/tests/bake_header_simple_compact.gd
+++ b/game/tests/bake_header_simple_compact.gd
@@ -4,18 +4,26 @@ extends SceneTree
 func _initialize() -> void: run.call_deferred()
 
 func run() -> void:
-	var revision: String = ""
+	var revision: String = preload("res://ui/header_simple_cache.gd").geometry_revision()
 	for argument: String in OS.get_cmdline_user_args():
 		if argument.begins_with("--revision="): revision = argument.trim_prefix("--revision=")
 	if revision.length()!=64 or not revision.is_valid_hex_number():
 		push_error("A source-checked compact visual revision is required.")
 		quit(1); return
+	if revision != preload("res://ui/header_simple_cache.gd").geometry_revision():
+		push_error("Header revision must match the current prepared geometry identity.")
+		quit(1); return
+	preload("res://vehicle/modular_car_base.gd").enabled = false
+	preload("res://ui/garage_car_cache.gd").enabled = false
+	preload("res://vehicle/prepared_car_cache.gd").enabled = false
 	var car := CarVisual.new()
 	car.vehicle_id = "compact"
 	car.simple_model = true
 	car.livery = VehicleLivery.defaults("compact")
 	root.add_child(car)
 	while not car.model_ready: await process_frame
+	preload("res://vehicle/prepared_car_cache.gd").enabled = true
+	preload("res://vehicle/prepared_car_cache.gd").remember(car)
 	var error: Error = preload("res://ui/header_simple_cache.gd").bake(car,revision)
 	print("HEADER_SIMPLE_BAKE: ",error)
 	car.free()
diff --git a/game/tests/check_prepared_assets.gd b/game/tests/check_prepared_assets.gd
new file mode 100644
index 0000000..2803d37
--- /dev/null
+++ b/game/tests/check_prepared_assets.gd
@@ -0,0 +1,60 @@
+extends SceneTree
+## Export preflight: metadata and full dependency checks for every expected bake.
+const Base=preload("res://vehicle/modular_car_base.gd")
+const Kits=preload("res://vehicle/modular_car_kits.gd")
+const Garage=preload("res://ui/garage_car_cache.gd")
+const Header=preload("res://ui/header_simple_cache.gd")
+var checks: int=0
+var failures: int=0
+var resources: int=0
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool,label: String) -> void:
+	checks+=1
+	if not ok: failures+=1;printerr("PREPARED_ASSET_FAIL ",label)
+func inspect(path: String,metadata: String,key: Array,sources: Dictionary) -> void:
+	check(ResourceLoader.exists(path),"exists "+path)
+	if not ResourceLoader.exists(path): return
+	var packed: PackedScene=load(path)
+	check(packed!=null,"loads "+path)
+	if packed==null: return
+	var holder: Node=packed.instantiate()
+	var data: Dictionary=holder.get_meta(metadata,{})
+	resources+=1
+	check(data.get("key",[])==key,"current key "+path)
+	check(not sources.is_empty() and data.get("sources",{})==sources,"complete current sources "+path)
+	if metadata!="modular_kit": check(Base._valid_holder(holder,data),"complete articulation "+path)
+	holder.free()
+func run() -> void:
+	check(not preload("res://vehicle/prepared_asset_sources.gd").manifest().is_empty(),"dependency manifest available")
+	for id: String in VehicleCatalog.IDS:
+		var sources: Dictionary=Base.source_hashes(id)
+		var validation=preload("res://vehicle/prepared_asset_sources.gd")
+		check(validation.runtime_projection(sources)==validation.runtime_hashes(id),"runtime code/configuration guard covers every preserved leaf "+id)
+		for simple: bool in [false,true]:
+			for editable: bool in [false,true]:
+				if editable and not VehicleCustomisation.supported(id): continue
+				var car:=CarVisual.new()
+				car.vehicle_id=id;car.simple_model=simple;car.editable_kits=editable
+				check(Base._eligible(car),"base eligible "+id)
+				inspect(Base.path_for(car),"modular_car_base",Base.key_for(car),sources)
+				if editable:
+					for category: String in VehicleCustomisation.CATEGORIES:
+						for option: Array in VehicleCustomisation.options(category,id).slice(1):
+							inspect(Kits.path_for(car,category,option[0]),"modular_kit",Kits.key_for(car,category,option[0]),Kits.geometry_sources(id))
+				car.free()
+		var car:=CarVisual.new()
+		car.vehicle_id=id;car.editable_kits=VehicleCustomisation.supported(id)
+		inspect(Garage.DIRECTORY+id+".scn","garage_rest",Garage.geometry_key(car),Garage.geometry_sources(id))
+		car.free()
+	var car:=CarVisual.new()
+	car.simple_model=true
+	var path: String=Header.DIRECTORY+"compact.scn"
+	inspect(path,"garage_rest",Header.geometry_key(car),Header.geometry_sources())
+	if ResourceLoader.exists(path):
+		var packed: PackedScene=load(path)
+		var holder: Node=packed.instantiate()
+		check(Header.valid_data(holder.get_meta("garage_rest",{}),car,Header.geometry_revision()),"header engine and geometry revision")
+		holder.free()
+	car.free()
+	print("PREPARED_ASSETS ",resources," resources; ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
