@@ -0,0 +1,332 @@
+"""Frozen exact-image acceptance on owned local Docker resources; no cloud calls."""
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+import secrets
+import shutil
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+from datetime import datetime, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+CONTEXT = ROOT / "build/product-telemetry-deploy-2026-10-11/image"
+WORK = CONTEXT.parent / "acceptance"
+OUTPUT = ROOT / "docs/evidence/product-telemetry-deploy-2026-10-11"
+ROLLOUT = OUTPUT / "rollout.json"
+TASK_LABEL = "product-image-" + secrets.token_hex(12)
+SELECTED = [
+    "test_product_analytics.py", "test_product_domain_events.py", "test_admin.py",
+    "test_admin_support.py", "test_studio.py", "test_store_admin.py",
+    "test_lap_bests.py", "test_histogram_snapshots.py",
+]
+
+
+def hashes(folder):
+    return {p.relative_to(folder).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
+            for p in folder.rglob("*") if p.is_file() and "__pycache__" not in p.parts}
+
+
+def linux_path(path):
+    value = Path(path).resolve()
+    assert value.is_relative_to(ROOT.resolve())
+    return "/mnt/" + value.drive[0].lower() + value.as_posix()[2:]
+
+
+class OwnedDocker:
+    def __init__(self, docker, tag):
+        self.docker = docker
+        self.tag = tag
+        self.containers = set()
+        self.networks = set()
+        self.secrets = []
+
+    def clean(self, text):
+        for secret in self.secrets:
+            text = text.replace(secret, "[REDACTED]")
+        return text
+
+    def call(self, *args, timeout=300, check=True):
+        result = subprocess.run([*self.docker, *args], capture_output=True, text=True,
+                                timeout=timeout, check=False)
+        if check and result.returncode:
+            (WORK / "last-docker-error.private.log").write_text(result.stdout + result.stderr, encoding="utf-8")
+            raise RuntimeError("Owned Docker operation failed; private diagnostic retained")
+        return result
+
+    def labelled(self, kind, name):
+        args = ("network", "inspect") if kind == "network" else ("inspect",)
+        result = self.call(*args, name, "--format", "{{json .Labels}}" if kind == "network"
+                           else "{{json .Config.Labels}}", check=False)
+        return result.returncode == 0 and json.loads(result.stdout).get("bmt.task") == TASK_LABEL
+
+    def stop(self, name):
+        if name not in self.containers:
+            return
+        exists = self.call("inspect", name, "--format", "{{json .State.Running}}", check=False)
+        if exists.returncode == 0:
+            assert self.labelled("container", name), "Container ownership changed"
+            self.call("stop", "--time=15", name)
+        self.containers.discard(name)
+
+    def remove_network(self, name):
+        if name in self.networks:
+            assert self.labelled("network", name), "Network ownership changed"
+            self.call("network", "rm", name)
+            self.networks.discard(name)
+
+    def cleanup(self):
+        for name in tuple(self.containers):
+            self.stop(name)
+        for name in tuple(self.networks):
+            self.remove_network(name)
+
+
+def freeze():
+    WORK.mkdir(parents=True, exist_ok=True)
+    OUTPUT.mkdir(parents=True, exist_ok=True)
+    tests = WORK / "frozen-tests"
+    if not tests.exists():
+        shutil.copytree(ROOT / "backend/tests", tests,
+                        ignore=shutil.ignore_patterns("__pycache__", ".pytest_cache"))
+    driver = WORK / "product_console.py"
+    if not driver.exists():
+        shutil.copyfile(ROOT / "scripts/test_product_analytics_console.py", driver)
+    config = WORK / "pytest.ini"
+    if not config.exists():
+        config.write_text("[pytest]\nmarkers =\n    postgres: requires owned PostgreSQL\n"
+                          "    godot: requires exact pinned Godot\n", encoding="utf-8")
+    manifest = {
+        "test_files": hashes(tests), "selected": SELECTED,
+        "browser_driver_sha256": hashlib.sha256(driver.read_bytes()).hexdigest(),
+        "helper_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "maintenance_probe_sha256": hashlib.sha256((WORK / "candidate-maintenance-check.py").read_bytes()).hexdigest(),
+        "browser_server_wrapper_sha256": hashlib.sha256((WORK / "candidate-browser-server.py").read_bytes()).hexdigest(),
+    }
+    (OUTPUT / "exact-image-test-sources.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    return tests, driver, config, manifest
+
+
+def junit(path):
+    root = ET.parse(path).getroot()
+    suites = [root] if root.tag == "testsuite" else root.findall("testsuite")
+    result = {key: sum(int(node.attrib.get(key, "0")) for node in suites)
+              for key in ("tests", "failures", "errors", "skipped")}
+    result["passed"] = result["tests"] - result["failures"] - result["errors"] - result["skipped"]
+    result["seconds"] = sum(float(node.attrib.get("time", "0")) for node in suites)
+    return result
+
+
+def pytest_image(docker, tests, config, *, postgres=False, network=None, db_name=None, password=None):
+    kind = "postgres" if postgres else "sqlite"
+    scratch = WORK / kind
+    scratch.mkdir(exist_ok=True)
+    environment = scratch / "environment.private"
+    if postgres:
+        environment.write_text("BMT_TEST_DATABASE_URL=postgresql+psycopg://image_test:"
+                               + password + "@" + db_name + ":5432/image_test\n"
+                               "BMT_DEPLOYMENT_MAINTENANCE=false\n")
+    else:
+        environment.write_text("BMT_TEST_DATABASE_URL=\nBMT_DEPLOYMENT_MAINTENANCE=false\n")
+    name = "bmt-product-image-" + kind + "-" + secrets.token_hex(4)
+    args = ["run", "--rm", "--name", name, "--label", "bmt.task=" + TASK_LABEL,
+            "--network=" + (network if postgres else "none"),
+            "-v", linux_path(tests) + ":/frozen/backend/tests:ro",
+            "-v", linux_path(config) + ":/pytest.ini:ro",
+            "-v", linux_path(scratch) + ":/results",
+            "--env-file", linux_path(environment), "-e", "PYTHONPATH=/app:/frozen/backend/tests",
+            "--entrypoint=python", docker.tag, "-m", "pytest", "-c", "/pytest.ini",
+            *["/frozen/backend/tests/" + filename for filename in SELECTED],
+            "-q", "-p", "no:cacheprovider", "--tb=short", "--junitxml=/results/results.xml"]
+    if not postgres:
+        args.extend(["-k", "not postgres"])
+    docker.containers.add(name)
+    started = time.monotonic()
+    run = docker.call(*args, timeout=1200, check=False)
+    docker.containers.discard(name)  # --rm removes the completed test container.
+    output = docker.clean(run.stdout + run.stderr)
+    (OUTPUT / ("exact-image-" + kind + "-tests.log")).write_text(output, encoding="utf-8")
+    stats = junit(scratch / "results.xml") if (scratch / "results.xml").exists() else {}
+    stats.update(exit_code=run.returncode, wall_seconds=time.monotonic() - started)
+    print(kind + " exact-image tests: " + json.dumps(stats), flush=True)
+    if run.returncode:
+        print(output[-7000:], flush=True)
+    return stats
+
+
+def maintenance(docker):
+    probe = WORK / "candidate-maintenance-check.py"
+    assert probe.exists(), "Owned maintenance probe is not ready"
+    result = docker.call("run", "--rm", "--network=none", "--label", "bmt.task=" + TASK_LABEL,
+                         "-v", linux_path(probe) + ":/probe.py:ro", "-e", "PYTHONPATH=/app",
+                         "--entrypoint=python", docker.tag, "/probe.py")
+    (OUTPUT / "exact-image-maintenance.log").write_text(docker.clean(result.stdout + result.stderr))
+    value = json.loads(result.stdout.strip().splitlines()[-1])
+    assert value["ok"] and not value["failures"]
+    return value
+
+
+def browser_image(docker, tests, driver, network):
+    """Run the existing browser driver while replacing only its server launcher."""
+    # asyncio's Windows implementation subclasses Popen during import.
+    # Load browser dependencies before replacing the one fixture-server call.
+    importlib.import_module("httpx")
+    importlib.import_module("playwright.sync_api")
+    spec = importlib.util.spec_from_file_location("frozen_product_console", driver)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    original_popen = subprocess.Popen
+
+    class Server:
+        def __init__(self, name, log):
+            self.name, self.log = name, log
+
+        def poll(self):
+            result = docker.call("inspect", self.name, "--format", "{{json .State.Running}}", check=False)
+            if result.returncode == 0 and json.loads(result.stdout):
+                return None
+            self.capture()
+            return 1
+
+        def capture(self):
+            result = docker.call("logs", self.name, check=False)
+            text = docker.clean(result.stdout + result.stderr)
+            if not self.log.closed:
+                self.log.write(text)
+                self.log.flush()
+            (OUTPUT / "exact-image-browser-server.log").write_text(text, encoding="utf-8")
+
+        def terminate(self):
+            self.capture()
+            docker.stop(self.name)
+
+        def wait(self, timeout=None):
+            return 0
+
+    def launcher(args, *positional, **kwargs):
+        if len(args) > 2 and args[1] == str(driver.resolve()) and "--serve" in args:
+            folder = Path(args[args.index("--serve") + 1])
+            port = int(args[args.index("--port") + 1])
+            private = json.loads((folder / "config.private.json").read_text())
+            docker.secrets.extend(private.values())
+            name = "bmt-product-image-browser-" + secrets.token_hex(4)
+            result = docker.call("run", "-d", "--rm", "--name", name,
+                "--label", "bmt.task=" + TASK_LABEL, "--network=bridge",
+                "-p", f"127.0.0.1:{port}:8080",
+                "-v", linux_path(folder) + ":/fixture",
+                "-v", linux_path(tests) + ":/frozen/backend/tests:ro",
+                "-v", linux_path(driver) + ":/frozen/product_console.py:ro",
+                "-v", linux_path(WORK / "candidate-browser-server.py") + ":/browser-server.py:ro",
+                "-e", "PYTHONPATH=/app:/frozen/backend/tests",
+                "-e", "BMT_DEPLOYMENT_MAINTENANCE=false",
+                "--entrypoint=python", docker.tag, "/browser-server.py")
+            assert result.returncode == 0
+            docker.containers.add(name)
+            # Docker's published TCP proxy can accept connections before the
+            # seeded application has opened its listener, causing a reset rather
+            # than the host fixture's expected connection-refused startup state.
+            probe = ("import urllib.request;"
+                     "r=urllib.request.urlopen('http://127.0.0.1:8080/health',timeout=2);"
+                     "assert r.status==200")
+            for _attempt in range(120):
+                if docker.call("exec", name, "python", "-c", probe, check=False).returncode == 0:
+                    break
+                time.sleep(0.2)
+            else:
+                raise RuntimeError("Owned candidate browser listener did not become healthy")
+            return Server(name, kwargs["stdout"])
+        return original_popen(args, *positional, **kwargs)
+
+    old_args = sys.argv[:]
+    try:
+        subprocess.Popen = launcher
+        sys.argv = [str(driver), "--output", str(OUTPUT / "exact-image-browser")]
+        module.main()
+    finally:
+        subprocess.Popen = original_popen
+        sys.argv = old_args
+    value = json.loads((OUTPUT / "exact-image-browser/browser-receipt.json").read_text())
+    value["runtime"] = "Actual candidate Docker API and assets; no workspace backend imports."
+    return value
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--skip-browser", action="store_true")
+    parser.add_argument("--reuse-sqlite", action="store_true", help="Reuse exact same image/test hashes' successful SQLite receipt")
+    parser.add_argument("--reuse-tests", action="store_true", help="Reuse same image/test bytes' successful SQLite and PostgreSQL receipts")
+    args = parser.parse_args()
+    receipt = json.loads(ROLLOUT.read_text())
+    assert receipt.get("local_tag") and receipt.get("candidate_id")
+    assert receipt["frozen_files"] == hashes(CONTEXT), "Candidate source context changed"
+    config = json.loads((ROOT / ".tools/gcp-staging/config.json").read_text())
+    docker = OwnedDocker(config["docker"], receipt["local_tag"])
+    tests, driver, pytest_config, manifest = freeze()
+    image_id = docker.call("image", "inspect", docker.tag, "--format", "{{.Id}}").stdout.strip()
+    assert image_id == receipt["candidate_id"], "Candidate tag points at a different image"
+    result = {"image": docker.tag, "candidate_id": image_id, "source_hash": receipt["source_hash"],
+              "started_utc": datetime.now(timezone.utc).isoformat(),
+              "cloud_calls": 0, "owned_resources_only": True, "test_source_hashes": manifest}
+    network = "bmt-product-image-" + secrets.token_hex(4)
+    pg = "bmt-product-image-pg-" + secrets.token_hex(4)
+    password = secrets.token_urlsafe(24)
+    docker.secrets.append(password)
+    try:
+        if args.reuse_sqlite or args.reuse_tests:
+            reused = "tests-passed-browser-harness-failure.json" if args.reuse_tests else "initial-exact-image-acceptance.json"
+            previous = json.loads((OUTPUT / reused).read_text())
+            assert previous["candidate_id"] == image_id and previous["sqlite"]["exit_code"] == 0
+            assert previous["test_source_hashes"]["test_files"] == manifest["test_files"]
+            result["sqlite"] = previous["sqlite"]
+            result["sqlite_receipt_reused"] = reused + "; same image and test bytes"
+        else:
+            result["sqlite"] = pytest_image(docker, tests, pytest_config)
+        docker.call("network", "create", "--internal", "--label", "bmt.task=" + TASK_LABEL, network)
+        docker.networks.add(network)
+        if args.reuse_tests:
+            assert previous["postgres"]["exit_code"] == 0
+            result["postgres"] = previous["postgres"]
+            result["postgres_receipt_reused"] = reused + "; same image and test bytes"
+        else:
+            pg_env = WORK / "postgres.environment.private"
+            pg_env.write_text("POSTGRES_USER=image_test\nPOSTGRES_DB=image_test\nPOSTGRES_PASSWORD=" + password + "\n")
+            docker.call("run", "-d", "--rm", "--name", pg, "--label", "bmt.task=" + TASK_LABEL,
+                        "--network=" + network, "--env-file", linux_path(pg_env), "postgres:17")
+            docker.containers.add(pg)
+            for _attempt in range(60):
+                if docker.call("exec", pg, "pg_isready", "-U", "image_test", check=False).returncode == 0:
+                    break
+                time.sleep(0.5)
+            else:
+                raise RuntimeError("Owned PostgreSQL did not become ready")
+            result["postgres"] = pytest_image(docker, tests, pytest_config, postgres=True,
+                                              network=network, db_name=pg, password=password)
+        result["maintenance"] = maintenance(docker)
+        if not args.skip_browser:
+            result["browser"] = browser_image(docker, tests, driver, network)
+    finally:
+        docker.cleanup()
+        result["owned_resources_removed"] = not docker.containers and not docker.networks
+        result["finished_utc"] = datetime.now(timezone.utc).isoformat()
+        (OUTPUT / "exact-image-acceptance.json").write_text(json.dumps(result, indent=2) + "\n")
+    assert result["sqlite"]["exit_code"] == result["postgres"]["exit_code"] == 0, "Exact-image tests failed"
+    latest = json.loads(ROLLOUT.read_text())
+    assert latest["candidate_id"] == image_id and latest["source_hash"] == result["source_hash"]
+    latest["exact_image_tests"] = True
+    latest["exact_image_acceptance"] = "exact-image-acceptance.json"
+    latest["exact_image_browser"] = bool(result.get("browser"))
+    temporary = ROLLOUT.with_name("rollout.tests.tmp")
+    temporary.write_text(json.dumps(latest, indent=2) + "\n")
+    os.replace(temporary, ROLLOUT)
+    print(json.dumps({"exact_image_tests": True, "sqlite": result["sqlite"], "postgres": result["postgres"],
+                      "maintenance": result["maintenance"], "browser_checks": len(result.get("browser", {}).get("checks", [])),
+                      "owned_resources_removed": result["owned_resources_removed"]}), flush=True)
+
+
+if __name__ == "__main__":
+    main()
