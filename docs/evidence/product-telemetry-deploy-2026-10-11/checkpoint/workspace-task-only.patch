+def initialize_lap_projections():
+    assert receipt.get('migration_complete')
+    guard_target('job', service.n['smoke'], [receipt['image']])
+    code = '''import hashlib,json,time
+from sqlalchemy import select,text,update
+from bmt_backend.app import create_app
+from bmt_backend.lap_bests import backfill_one
+from bmt_backend.histogram_snapshots import refresh_one
+from bmt_backend.track_models import HistogramSnapshot
+a=create_app();f=a.state.session_factory
+began=time.monotonic();batches=inspected=invalid=0
+for _ in range(5000):
+ value=backfill_one(f,limit=200)
+ inspected+=value.get('inspected',0);invalid+=value.get('invalid_records',0)
+ if not value['worked']: break
+ batches+=1
+else: raise RuntimeError('Bounded initial lap backfill did not finish')
+with f() as s:
+ data={'backfill_batches':batches,'inspected':inspected,'invalid_records':invalid}
+ data['schema']=s.execute(text('SELECT version_num FROM alembic_version')).scalar()
+ data['incomplete_boards']=s.execute(text('SELECT count(*) FROM lap_best_state WHERE NOT complete')).scalar()
+ assert data['incomplete_boards']==0
+ lap_rows=s.execute(text('SELECT board_id,player_id,time_ticks FROM lap_personal_bests ORDER BY board_id,player_id')).all()
+ data['lap_minima']=len(lap_rows)
+ data['lap_hash']=hashlib.sha256(json.dumps([list(r) for r in lap_rows],separators=(',',':')).encode()).hexdigest()
+ visible=s.execute(text("""SELECT l.board_id,l.player_id,l.time_ticks FROM lap_personal_bests l
+ JOIN players p ON p.id=l.player_id JOIN boards b ON b.id=l.board_id
+ JOIN personal_bests pb ON pb.board_id=l.board_id AND pb.player_id=l.player_id
+ WHERE NOT p.disabled AND (b.manifest->>'test_population'='true' OR NOT p.is_test_driver)
+ ORDER BY l.board_id,l.player_id""")).all()
+ data['visible_lap_minima']=len(visible)
+ data['visible_lap_hash']=hashlib.sha256(json.dumps([list(r) for r in visible],separators=(',',':')).encode()).hexdigest()
+ rows=s.execute(text('SELECT board_id,player_id,run_id,time_ticks,achieved_at FROM personal_bests ORDER BY board_id,player_id')).all()
+ data['race_pb_hash']=hashlib.sha256(json.dumps([list(r) for r in rows],separators=(',',':')).encode()).hexdigest()
+ for table in ('runs','personal_bests','players','product_events'):
+  data[table]=s.execute(text('SELECT count(*) FROM '+table)).scalar()
+ data['app_role']=s.execute(text('SELECT current_user')).scalar()
+ data['table_privileges']={t:{p:s.execute(text('SELECT has_table_privilege(current_user,:t,:p)'),{'t':t,'p':p}).scalar()
+  for p in ('SELECT','INSERT','UPDATE','DELETE')} for t in ('product_events','product_state','lap_personal_bests','lap_best_state')}
+ data['role_superuser']=s.execute(text('SELECT rolsuper FROM pg_roles WHERE rolname=current_user')).scalar()
+ s.execute(update(HistogramSnapshot).values(next_refresh_at=int(time.time()),dirty=True));s.commit()
+data['backfill_parity_seconds']=round(time.monotonic()-began,3)
+refreshed=0;clock=int(time.time())
+for _ in range(3000):
+ if not refresh_one(a,clock=clock): break
+ refreshed+=1
+else: raise RuntimeError('Initial histogram refresh exceeded budget')
+with f() as s:
+ data['snapshots']=s.execute(text('SELECT count(*) FROM histogram_snapshots')).scalar()
+ data['snapshots_invalidated']=s.execute(text('SELECT count(*) FROM histogram_snapshots WHERE invalidated')).scalar()
+data['refreshed_snapshots']=refreshed;data['total_seconds']=round(time.monotonic()-began,3)
+a.state.engine.dispose();a.state.verifier.close()
+print('PRODUCT_INITIALIZE:'+json.dumps(data,separators=(',',':')))
+'''
+    result = execute_program('initialize-projections', code, 'PRODUCT_INITIALIZE:', timeout=600)
+    baseline = receipt['stopped_writer_check']
+    assert result['schema'] == '0025_product_telemetry' and result['incomplete_boards'] == 0
+    assert result['lap_minima'] == baseline['expected_lap_minima'] and result['lap_hash'] == baseline['expected_lap_hash']
+    assert result['visible_lap_minima'] == baseline['expected_visible_lap_minima'] and result['visible_lap_hash'] == baseline['expected_visible_lap_hash']
+    assert result['race_pb_hash'] == baseline['race_pb_hash'] and result['runs'] == baseline['runs']
+    assert result['personal_bests'] == baseline['personal_bests'] and result['players'] == baseline['players']
+    assert result['product_events'] == 0 and not result['role_superuser'] and all(all(v.values()) for v in result['table_privileges'].values())
+    receipt['initial_lap_projection_verified'] = True
+    save()
+    print(json.dumps({k:v for k,v in result.items() if k not in ('race_pb_hash','lap_hash','visible_lap_hash')}))
