+"""Owner-authorized GET-only acceptance of the promoted product Studio.
+
+Uses genuine aggregate responses and the existing staff credential in tab memory.
+No ingestion, races, accounts, purchases or successful response substitution.
+"""
+import hashlib
+import importlib.util
+import json
+import os
+from datetime import datetime, timezone
+from pathlib import Path
+from urllib.parse import urlparse
+
+from playwright.sync_api import expect, sync_playwright
+
+ROOT = Path(__file__).resolve().parents[1]
+ASSETS = (
+    "index.html", "app.js", "style.css", "studio.js", "support.js",
+    "commerce.js", "product_analytics.js",
+)
+PRODUCT_PATH = "/v1/admin/product-analytics"
+
+
+def load_rollout():
+    path = ROOT / ".tools/product_telemetry_rollout_20261011.py"
+    spec = importlib.util.spec_from_file_location("product_live_rollout", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def restrict_cloud_reads(service, calls):
+    original = service.call
+
+    def read_only(*args, **kwargs):
+        prefix = tuple(args[:3])
+        assert prefix in (
+            ("run", "services", "describe"), ("secrets", "versions", "access"),
+        ), "Live browser helper permits only service description and existing secret reads"
+        calls.append(" ".join(prefix))
+        return original(*args, **kwargs)
+
+    service.call = read_only
+
+
+def count_label(value, missing="Not observed"):
+    return f"{value:,}" if isinstance(value, int) and not isinstance(value, bool) else missing
+
+
+def validate_bundle(data):
+    assert data["schema"] == "bmt-product-analytics-v1"
+    assert data["telemetry_enabled"] is True
+    assert 1 <= data["days"] <= 90 and 1 <= len(data["daily"]) <= 91
+    assert data["store"]["fulfilled"] is None, "Paid outcomes must remain unavailable"
+    coverage = data["coverage"]
+    assert coverage["fact_retention_days"] == 180
+    assert "Guest coverage is unavailable" in " ".join(coverage["limitations"])
+    for row in data["daily"]:
+        if not row["observed"]:
+            assert row["active_players"] is None and row["accepted_races"] is None
+    for row in data["retention"]:
+        for day in ("d1", "d7"):
+            cell = row[day]
+            if not cell["mature"]:
+                assert cell["returned"] is None
+            if cell["returned"] is not None:
+                assert 0 <= cell["returned"] <= cell["eligible"]
+    for funnel in data["funnels"].values():
+        known = funnel["cohort_players"] is not None
+        if not known:
+            assert all(step["count"] is None for step in funnel["steps"])
+        else:
+            assert all(step["count"] is None or 0 <= step["count"] <= funnel["cohort_players"]
+                       for step in funnel["steps"])
+    assert data["funnels"]["first_race"]["steps"][-1]["name"] == "second_voluntary_race"
+    assert data["funnels"]["first_race"]["second_race_followup_seconds"] == 600
+
+
+def assert_presented_values(page, data):
+    latest = data["daily"][-1]
+    expect(page.locator("#pa-dau")).to_have_text(count_label(latest["active_players"]))
+    expect(page.locator("#pa-wau")).to_have_text(count_label(data["weekly_active_players"]))
+    expect(page.locator("#pa-period-active")).to_have_text(count_label(data["period_active_players"]))
+    expect(page.locator("#pa-store-opened")).to_have_text(count_label(data["store"]["opened"]))
+    if page.locator(".studio-chart-data").get_attribute("open") is None:
+        page.locator(".studio-chart-data summary").click()
+    rows = page.locator("#pa-daily-table tbody tr")
+    assert rows.count() == len(data["daily"])
+    for index, record in enumerate(data["daily"]):
+        expect(rows.nth(index).locator("td").nth(0)).to_have_text(count_label(record["active_players"]))
+        expect(rows.nth(index).locator("td").nth(1)).to_have_text(count_label(record["accepted_races"]))
+    observed = any(row["observed"] for row in data["daily"])
+    for name, selector in (("first_race", "#pa-first-race-funnel"),
+                           ("creator", "#pa-creator-funnel")):
+        funnel = data["funnels"][name]
+        fallback = "Not observed" if not observed else "Not mature" if not funnel["mature"] else "Unavailable"
+        steps = page.locator(selector + " .pa-step-count")
+        assert steps.count() == len(funnel["steps"])
+        for index, step in enumerate(funnel["steps"]):
+            text = steps.nth(index).inner_text().splitlines()[0]
+            assert text == count_label(step["count"], fallback)
+    retention = page.locator("#pa-retention-table tbody tr")
+    assert retention.count() == len(data["retention"])
+    for index, record in enumerate(data["retention"]):
+        for column, name in ((1, "d1"), (2, "d7")):
+            cell = record[name]
+            locator = retention.nth(index).locator("td").nth(column)
+            if not cell["mature"]:
+                expect(locator).to_have_text("Not mature")
+            elif cell["returned"] is None:
+                expect(locator).to_have_text("Unavailable")
+            elif not cell["eligible"]:
+                expect(locator).to_have_text("No eligible players")
+            else:
+                expect(locator.locator("small")).to_have_text(
+                    count_label(cell["returned"]) + " / " + count_label(cell["eligible"]))
+                percentage = locator.locator("strong").inner_text()
+                assert percentage.endswith("%")
+                assert abs(float(percentage[:-1]) - 100 * cell["returned"] / cell["eligible"]) <= 0.050001
+    for key in ("challenge_opened", "challenge_joined", "challenge_created", "share_clicked"):
+        expect(page.locator(f'[data-social-metric="{key}"]')).to_have_text(count_label(data["challenges"][key]))
+    for key in ("dropped_events", "rejected_events", "persistence_failures"):
+        expect(page.locator(f'[data-quality-metric="{key}"]')).to_have_text(count_label(data["quality"][key]))
+
+
+def main():
+    module = load_rollout()
+    receipt = module.receipt
+    assert receipt.get("deployed") and receipt.get("promoted") and receipt.get("verify_live"), \
+        "Run live browser acceptance only after promotion and the real live smoke check"
+    assert receipt.get("exact_image_tests") and receipt.get("exact_image_browser")
+    cloud_reads = []
+    restrict_cloud_reads(module.service, cloud_reads)
+    restrict_cloud_reads(module.prior.service, cloud_reads)
+    resource = module.service.describe("api", module.service.n["api"])
+    assert module.stage.resource_image(resource) == receipt["image"]
+    active = [route for route in resource["status"]["traffic"] if route.get("percent", 0)]
+    assert len(active) == 1 and active[0]["percent"] == 100
+    assert active[0]["revisionName"] == receipt["canary_revision"]
+    origin = receipt["url"]
