+def warm_private_snapshots():
+    assert receipt.get('initial_lap_projection_verified')
+    code = '''import json,time,secrets
+from dataclasses import replace
+from sqlalchemy import text,update
+from bmt_backend.app import create_app
+from bmt_backend.config import Settings
+from bmt_backend.histogram_snapshots import refresh_one
+from bmt_backend.track_models import HistogramSnapshot
+# This diagnostic opens no listener, signs in nobody and issues no session.
+# An ephemeral key satisfies the development-population configuration invariant.
+a=create_app(replace(Settings.from_env(),environment='development',dev_auth_enabled=True,
+ dev_auth_key=secrets.token_urlsafe(32),test_drivers_enabled=True));f=a.state.session_factory
+clock=int(time.time());started=time.monotonic()
+with f() as s:
+ s.execute(update(HistogramSnapshot).where(HistogramSnapshot.include_artificial.is_(True)).values(next_refresh_at=clock,dirty=True));s.commit()
+refreshed=0
+for _ in range(3000):
+ if not refresh_one(a,clock=clock):break
+ refreshed+=1
+else:raise RuntimeError('Private warm exceeded bounded budget')
+with f() as s:
+ result={'refreshed':refreshed,'seconds':round(time.monotonic()-started,3)}
+ result['published_invalidated']=s.execute(text("SELECT count(*) FROM histogram_snapshots h JOIN track_versions v ON v.id=h.version_id WHERE v.state='published' AND h.invalidated")).scalar()
+ result['remaining_nonpublished_invalidated']=s.execute(text("SELECT count(*) FROM histogram_snapshots h JOIN track_versions v ON v.id=h.version_id WHERE v.state<>'published' AND h.invalidated")).scalar()
+ result['incomplete_boards']=s.execute(text('SELECT count(*) FROM lap_best_state WHERE NOT complete')).scalar()
+a.state.engine.dispose();a.state.verifier.close()
+print('PRODUCT_PRIVATE_WARM:'+json.dumps(result,separators=(',',':')))
