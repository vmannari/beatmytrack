+def execute_program(name, code, prefix, *, timeout=600):
+    encoded = base64.b64encode(gzip.compress(code.encode())).decode()
+    boot = 'import base64,gzip; exec(gzip.decompress(base64.b64decode("' + encoded + '")).decode())'
+    assert len(boot) < 7400
+    existing = receipt.get(name + '_execution')
+    if existing is None:
+        value = json.loads(service.call('run', 'jobs', 'execute', service.n['smoke'], '--region=' + config['region'],
+            '--wait', '--task-timeout=' + str(timeout) + 's', '--args=^@^-c@' + boot, '--format=json'))
+        existing = value.get('metadata', {}).get('name') or value.get('name')
+        assert existing and '/' not in existing
+        receipt[name + '_execution'] = existing
+        save()
+    logs = json.loads(service.call('logging', 'read', 'resource.type="cloud_run_job" AND '
+        'resource.labels.job_name="' + service.n['smoke'] + '" AND labels."run.googleapis.com/execution_name"="'
+        + existing + '"', '--limit=100', '--format=json'))
+    (WORK / (name + '-logs.private.json')).write_text(json.dumps(logs), encoding='utf-8')
+    values = [entry.get('textPayload', '') for entry in logs if entry.get('textPayload', '').startswith(prefix)]
+    assert len(values) == 1, 'Diagnostic result log not visible yet; safe to reread the completed execution'
+    result = json.loads(values[0][len(prefix):])
+    (OUTPUT / (name + '.json')).write_text(json.dumps(result, indent=2) + '\n')
+    return result
