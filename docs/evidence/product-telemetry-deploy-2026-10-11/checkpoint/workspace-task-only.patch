+ data["active_run_jobs"]=c.execute(text("SELECT count(*) FROM runs WHERE status IN ('queued','verifying')")).scalar()
+ data["pending_track_jobs"]=c.execute(text("SELECT count(*) FROM track_validations WHERE status IN ('queued','validating')")).scalar()
+ rows=c.execute(text("SELECT board_id,player_id,run_id,time_ticks,achieved_at FROM personal_bests ORDER BY board_id,player_id")).all()
+ data["race_pb_hash"]=hashlib.sha256(json.dumps([list(r) for r in rows],separators=(',',':')).encode()).hexdigest()
+ boards={r.id:r for r in c.execute(text("""SELECT b.id,b.manifest,
+ coalesce((SELECT max((o.details->>'created_at')::integer) FROM operation_state o
+ WHERE o.id LIKE 'test-pop-batch:%' AND o.details#>>'{request,clear_test_records}'='true'
+ AND EXISTS(SELECT 1 FROM jsonb_array_elements(coalesce(o.details::jsonb->'tracks','[]'::jsonb)) entry
+ JOIN track_versions retired ON retired.id=entry->>'version_id'
+ JOIN track_versions current_version ON current_version.id=b.version_id
+ WHERE retired.track_id=current_version.track_id)),0) AS cutoff FROM boards b"""))}
+ players={r.id:r for r in c.execute(text("SELECT id,is_test_driver,disabled FROM players"))}
+ expected={}
+ for run in c.execute(text("SELECT board_id,player_id,lap_ticks,created_at FROM runs WHERE status='verified' AND time_ticks>0")):
+  board=boards[run.board_id]; player=players[run.player_id]; laps=run.lap_ticks
+  if board.manifest.get('purpose')=='creator_test' or not isinstance(laps,list) or len(laps)!=5 or any(type(t) is not int or not 1<=t<=216000 for t in laps): continue
+  if board.manifest.get('test_population') and player.is_test_driver and run.created_at<board.cutoff: continue
+  pair=(run.board_id,run.player_id); value=min(laps[1:]); expected[pair]=min(expected.get(pair,value),value)
+ members={(r[0],r[1]) for r in rows}
+ visible={pair:value for pair,value in expected.items() if pair in members
+  and not players[pair[1]].disabled and (boards[pair[0]].manifest.get('test_population') or not players[pair[1]].is_test_driver)}
+ data['expected_lap_minima']=len(expected)
+ data['expected_visible_lap_minima']=len(visible)
+ data['expected_lap_hash']=hashlib.sha256(json.dumps(sorted([*pair,value] for pair,value in expected.items()),separators=(',',':')).encode()).hexdigest()
+ data['expected_visible_lap_hash']=hashlib.sha256(json.dumps(sorted([*pair,value] for pair,value in visible.items()),separators=(',',':')).encode()).hexdigest()
+ print("PRODUCT_STOPPED:"+json.dumps(data,separators=(',',':')))
+e.dispose()
+'''
+    result = execute_program('stopped-writer', code, 'PRODUCT_STOPPED:', timeout=180)
+    assert result['schema'] == receipt['schema_before'] and result['active_run_jobs'] == result['pending_track_jobs'] == 0
+    assert all(result[key] == receipt['database_before'][key] for key in ('players','boards','runs','personal_bests','race_pb_hash'))
+    receipt['stopped_writer_check'] = result
