+def rollback_rollout():
+    # Never drop accepted data or redeploy a schema23 process against schema25.
+    code = '''import json
+from sqlalchemy import text
+from bmt_backend.config import Settings
+from bmt_backend.db import make_engine
+e=make_engine(Settings.from_env().database_url)
+with e.connect() as c:
+ c.execute(text('SET TRANSACTION READ ONLY'))
+ v=c.execute(text('SELECT version_num FROM alembic_version')).scalar()
+print('PRODUCT_ROLLBACK_SCHEMA:'+json.dumps({'schema':v}));e.dispose()
+'''
+    data = execute_program('rollback-schema',code,'PRODUCT_ROLLBACK_SCHEMA:',timeout=180)
+    if data['schema'] == receipt['schema_before']:
+        traffic=','.join(v['revisionName']+'='+str(v['percent']) for v in receipt['old_traffic'] if v.get('percent',0))
+        service.call('run','services','update-traffic',service.n['api'],'--region='+config['region'],'--to-revisions='+traffic,'--format=json')
+        service.call('run','worker-pools','update',service.n['worker'],'--region='+config['region'],
+            '--instances='+str(receipt.get('worker_instances_before',1)),'--format=json')
+        receipt['rollback_mode']='Original23 traffic restored; no database migration had committed'
+    else:
+        assert data['schema']=='0025_product_telemetry'
+        tag='product-fallback-'+receipt['source_hash'][:8]
+        service.call('run','services','update',service.n['api'],'--region='+config['region'],'--image='+receipt['image'],
+            '--no-traffic','--tag='+tag,telemetry_env_argument(False),'--format=json')
+        current=guard_target('api',service.n['api'],[receipt['image']])
+        route=next(v for v in current['status']['traffic'] if v.get('tag')==tag)
+        fetch(route['url'],'/ready')
+        assert fetch(route['url'],'/v1/bootstrap').json()['product_telemetry']['enabled'] is False
+        service.call('run','services','update-traffic',service.n['api'],'--region='+config['region'],
+            '--to-revisions='+route['revisionName']+'=100','--format=json')
+        service.call('run','worker-pools','update',service.n['worker'],'--region='+config['region'],
+            '--image='+receipt['image'],'--command=python','--args=-m,bmt_backend.service_worker',
+            telemetry_env_argument(False),'--instances='+str(receipt.get('worker_instances_before',1)),'--format=json')
+        receipt['rollback_mode']='Schema25-compatible candidate retained; collection/projector disabled; data preserved'
+    receipt['rolled_back']=True;save()
+    print(json.dumps({'rolled_back':True,'mode':receipt['rollback_mode'],'database_downgraded':False}))
