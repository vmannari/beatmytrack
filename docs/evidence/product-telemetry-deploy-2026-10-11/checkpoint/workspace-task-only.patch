+"""Owner-authorized retained-staging telemetry rollout; frozen parent and exact guards."""
+import argparse
+import ast
+import base64
+import copy
+import gzip
+import hashlib
+import importlib.util
+import json
+import os
+import shutil
+import subprocess
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+OUTPUT = ROOT / 'docs/evidence/product-telemetry-deploy-2026-10-11'
+WORK = ROOT / 'build/product-telemetry-deploy-2026-10-11'
+CONTEXT = WORK / 'image'
+OUTPUT.mkdir(parents=True, exist_ok=True)
+WORK.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location('prior_studio_utils', ROOT / '.tools/backend_studio_rollout_20261011.py')
+prior = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(prior)
+stage, config, DIRECTORY = prior.stage, prior.config, prior.DIRECTORY
+
+
+class PrivateRunner(stage.Runner):
+    def run(self, argv, *, input_data=None, allow_missing=False, cwd=None):
+        result = subprocess.run(argv, input=input_data, capture_output=True, text=True,
+                                cwd=cwd, timeout=1800, check=False)
+        if result.returncode:
+            if allow_missing and any(s in result.stderr.lower() for s in ('not_found', 'not found', 'does not exist', 'no such image', '404')):
+                return None
+            (WORK / 'last-error.private.log').write_text(result.stdout + result.stderr, encoding='utf-8')
+            raise RuntimeError('Cloud/container operation failed; private diagnostic retained')
+        return result.stdout.strip()
+
+
+service = stage.Staging(config, DIRECTORY, PrivateRunner())
+RECEIPT = OUTPUT / 'rollout.json'
+receipt = json.loads(RECEIPT.read_text()) if RECEIPT.exists() else {}
+env, container, staff_key, fetch = prior.env, prior.container, prior.staff_key, prior.fetch
+
+
+def save():
+    RECEIPT.write_text(json.dumps(receipt, indent=2) + '\n', encoding='utf-8')
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def builder():
+    settings = copy.deepcopy(config)
+    if '--cd' in settings['docker']:
+        settings['docker'][settings['docker'].index('--cd') + 1] = '/mnt/' + WORK.drive[0].lower() + WORK.as_posix()[2:]
+    return stage.Staging(settings, DIRECTORY, PrivateRunner())
+
+
+def targets():
+    return [('api', service.n['api']), ('worker', service.n['worker']), ('job', service.n['migrate']),
+            ('job', service.n['smoke']), ('job', 'bmt-stg-' + config['owner'][:8] + '-catalog')]
+
+
+def inspect_live():
+    old = json.loads((DIRECTORY / 'deployment.json').read_text())
+    resources = targets() + [('sql', service.n['sql']), ('bucket', service.n['bucket']), ('repo', service.n['repo'])]
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        values = list(pool.map(lambda item: (item, service.describe(*item)), resources))
+    found = {}
+    for (kind, name), value in values:
+        if value is None and name.endswith('-catalog'):
+            continue
+        assert value is not None
+        (WORK / ('before-' + name + '.private.json')).write_text(json.dumps(value), encoding='utf-8')
+        if kind in ('api', 'worker', 'job'):
+            assert stage.resource_image(value) == old['image'], 'Unreconciled live image: ' + name
+            found[name] = kind
+        if kind == 'sql':
+            assert value['settings']['deletionProtectionEnabled'] or value['settings'].get('deletionProtectionEnabled', False)
+        if kind == 'api':
+            assert env(value)['BMT_ENVIRONMENT']['value'] == 'development'
+            assert env(value)['BMT_DEV_AUTH_ENABLED']['value'] == 'true'
+            api_resource = value
+    origin = api_resource['status']['url']
+    assert origin == old['url']
+    key = staff_key(api_resource)
+    overview = fetch(origin, '/v1/admin/overview', key).json()
+    health = fetch(origin, '/v1/admin/competition-health', key).json()
+    bootstrap = fetch(origin, '/v1/bootstrap').json()
+    receipt.update(parent=old['image'], url=origin, owner=config['owner'], targets=found,
+                   schema_before=overview['schema'], initial_players=overview['players'],
+                   started_utc=datetime.now(timezone.utc).isoformat(), old_traffic=api_resource['status']['traffic'])
+    save()
+    public = {'parent': receipt['parent'], 'schema': receipt['schema_before'], 'players': receipt['initial_players'],
+        'health': health['status'], 'queue_depth': health['queue_depth'], 'available_workers': health['available_workers'],
+        'telemetry_advertised': bootstrap.get('features', {}).get('product_telemetry'),
+        'owner_verified': True, 'url': origin}
+    (OUTPUT / 'initial-readonly.json').write_text(json.dumps(public, indent=2) + '\n')
+    print(json.dumps(public))
+
+
+def extract_parent():
+    assert receipt.get('parent')
+    build = builder()
+    present = build.runner.run([*build.c['docker'], 'image', 'inspect', receipt['parent'],
+        '--format={{.Id}}'], allow_missing=True)
+    if present is None:
+        registry = config['region'] + '-docker.pkg.dev'
+        token = service.call('auth', 'print-access-token')
+        auth = WORK / 'pull-docker-private'
+        auth.mkdir(exist_ok=False)
+        try:
+            build.runner.run([*build.c['docker'], '--config=pull-docker-private', 'login', registry,
+                '--username=oauth2accesstoken', '--password-stdin'], input_data=token)
+            build.runner.run([*build.c['docker'], '--config=pull-docker-private', 'pull', receipt['parent']])
+        finally:
+            assert auth.resolve().parent == WORK.resolve() and WORK.resolve().is_relative_to(ROOT.resolve())
+            assert not auth.is_symlink() and all(not p.is_symlink() for p in auth.rglob('*'))
+            shutil.rmtree(auth)
+    if not (WORK / 'parent').exists():
+        name = 'bmt-product-parent-' + os.urandom(4).hex()
+        label = 'bmt.product-rollout=' + config['owner']
+        build.runner.run([*build.c['docker'], 'create', '--name=' + name, '--label=' + label, receipt['parent']])
+        try:
+            build.runner.run([*build.c['docker'], 'cp', name + ':/app/bmt_backend', './parent'])
+        finally:
+            labels = json.loads(build.runner.run([*build.c['docker'], 'inspect', name, '--format={{json .Config.Labels}}']))
+            assert labels.get('bmt.product-rollout') == config['owner']
+            build.runner.run([*build.c['docker'], 'rm', name])
+    assert (WORK / 'parent/migrations/versions/0023_operational_read_indexes.py').is_file()
+    baseline = ROOT / 'build/telemetry-analysis-2026-10-11/before'
+    comparison = {}
+    mapping = {'admin.py': 'admin.py', 'studio.py': 'studio.py', 'worker.py': 'worker.py', 'tracks.py': 'tracks.py',
+        'app.py': 'backend__bmt_backend__app.py', 'config.py': 'backend__bmt_backend__config.py',
+        'middleware.py': 'backend__bmt_backend__middleware.py', 'migrations/env.py': 'backend__bmt_backend__migrations__env.py'}
+    for name, saved in mapping.items():
+        live = (WORK / 'parent' / name).read_bytes().replace(b'\r\n', b'\n')
+        previous = (baseline / saved).read_bytes().replace(b'\r\n', b'\n')
+        comparison[name] = {'matches_telemetry_before': live == previous, 'live_sha256': digest(live),
+            'before_sha256': digest(previous)}
+    (OUTPUT / 'parent-source-comparison.json').write_text(json.dumps(comparison, indent=2) + '\n')
+    receipt['parent_extracted'] = True
+    save()
+    print(json.dumps({'parent_extracted': True, 'baseline_matches': {k: v['matches_telemetry_before'] for k, v in comparison.items()}}))
+
+
+def probe_database():
+    assert receipt.get('parent_extracted')
+    job = service.describe('job', service.n['smoke'])
+    assert stage.resource_image(job) == receipt['parent']
+    code = '''import hashlib,json
+from sqlalchemy import text
+from bmt_backend.config import Settings
+from bmt_backend.db import make_engine
+e=make_engine(Settings.from_env().database_url)
+with e.connect() as c:
+ c.execute(text("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY"))
+ counts={n:c.execute(text("SELECT count(*) FROM "+n)).scalar() for n in ("players","boards","runs","personal_bests","histogram_snapshots","operation_state")}
+ counts["verified_runs"]=c.execute(text("SELECT count(*) FROM runs WHERE status='verified'")).scalar()
+ counts["published_versions"]=c.execute(text("SELECT count(*) FROM track_versions WHERE state='published'")).scalar()
+ counts["run_bytes"]=c.execute(text("SELECT pg_total_relation_size('runs'::regclass)")).scalar()
+ counts["active_run_jobs"]=c.execute(text("SELECT count(*) FROM runs WHERE status IN ('queued','verifying')")).scalar()
