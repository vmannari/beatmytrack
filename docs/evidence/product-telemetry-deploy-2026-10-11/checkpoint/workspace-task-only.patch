+    assert overview['schema'] == '0025_product_telemetry' and overview['players'] == receipt['initial_players']
+    data = fetch(origin, '/v1/admin/product-analytics?days=7', key).json()
+    assert data['schema'] == 'bmt-product-analytics-v1' and data['telemetry_enabled']
+    assert data['coverage']['fact_retention_days'] == 180 and len(data['daily']) <= 8
+    assert 'Guest coverage is unavailable' in ' '.join(data['coverage']['limitations'])
+    assert all(not cell['d7']['mature'] for cell in data['retention'])
+    assert data['store']['fulfilled'] is None
+    pre = fetch(origin, '/v1/admin/product-analytics?since=1790812800&until=1790899200', key).json()
+    assert all(row['active_players'] is None for row in pre['daily'])
+    assert pre['weekly_active_players'] is None and pre['store']['opened'] is None
+    assets = {}
+    for name in ('index.html','app.js','style.css','studio.js','support.js','commerce.js','product_analytics.js'):
+        path = '/admin' if name == 'index.html' else '/admin/assets/' + name
+        raw = fetch(origin, path).content
+        frozen = CONTEXT / 'source/admin_ui' / name
+        expected = frozen.read_bytes() if frozen.exists() else (WORK / 'parent/admin_ui' / name).read_bytes()
+        assert raw == expected, 'Asset parity failure: ' + name
+        assets[name] = digest(raw)
+    return {'observed_at':datetime.now(timezone.utc).isoformat(), 'origin':origin, 'schema':overview['schema'],
+        'players_including_artificial':overview['players'], 'read_only':True, 'telemetry':telemetry,
+        'coverage':data['coverage'], 'daily_rows':len(data['daily']), 'client_cohorts':len(data['retention']),
+        'precollection_unknown':True, 'paid_outcomes_unavailable':True, 'assets':assets}
