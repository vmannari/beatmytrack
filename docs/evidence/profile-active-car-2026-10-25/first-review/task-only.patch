diff --git a/game/ui/profile_car.gd b/game/ui/profile_car.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/profile_car.gd
@@ -0,0 +1,35 @@
+extends Control
+## The selected car in the Rivalry podium's static studio presentation.
+var records: LocalRecords
+var preview: Control
+var _appearance: Dictionary = {}
+
+func _ready() -> void:
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	if records != null: records.appearance_committed.connect(refresh)
+	refresh()
+
+func refresh() -> void:
+	if not is_inside_tree(): return
+	var vehicle: String = VehicleCatalog.selected
+	var settings: Dictionary = records.settings if records != null else {}
+	var appearance: Dictionary = {
+		"vehicle_id":vehicle,
+		"livery":VehicleLivery.for_car(settings,vehicle),
+		"customisation":VehicleCustomisation.for_car(settings,vehicle),
+	}
+	if appearance == _appearance: return
+	_appearance = appearance.duplicate(true)
+	if is_instance_valid(preview):
+		remove_child(preview)
+		preview.queue_free()
+	preview = preload("res://ui/rivalry_victory_car.gd").new()
+	preview.name = "ProfileCarRender"
+	preview.vehicle_id = vehicle
+	preview.livery = appearance.livery
+	preview.customisation = appearance.customisation
+	preview.simple_model = true
+	preview.podium_presentation = true
+	preview.fit_to_frame = true
+	add_child(preview)
+	MenuStyle.fill(preview)
