+	check(app.game == null and not is_instance_valid(app.race_loading) and not app.cloud_starting,"navigation cancels CPU preparation without publishing a stale race")
+	var elapsed: float = (Time.get_ticks_usec()-started)/1000.0
+	app.free(); await process_frame
+	print("RACE_PREPARATION_REUSE: ",checks," checks, ",failures," failures; loading_frames=",loading_frames," ms=",elapsed)
+	quit(1 if failures else 0)
+
+func before_app() -> Node:
+	var code: String = FileAccess.get_file_as_string("res://core/app.gd")
+	code = code.replace('var effect_preparation = preload("res://vehicle/effect_render_preparation.gd")','var effect_preparation = preload("res://../docs/evidence/race-loading-implementation-2026-11-02/before/game/vehicle/effect_render_preparation.gd")')
+	code = code.replace('var editor_memory = preload("res://editor/editor_memory.gd").new()','var editor_memory = preload("res://../docs/evidence/race-loading-implementation-2026-11-02/before/game/editor/editor_memory.gd").new()')
+	code = code.replace('const SELECTED_PREPARATION = preload("res://race/selected_track_preparation.gd")','const SELECTED_PREPARATION = preload("res://../docs/evidence/race-loading-implementation-2026-11-02/before/game/race/selected_track_preparation.gd")')
+	var script := GDScript.new(); script.source_code = code
+	assert(script.reload() == OK)
+	return script.new()
