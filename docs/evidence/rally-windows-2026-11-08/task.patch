diff --git a/game/tests/bake_rally_glazing.gd b/game/tests/bake_rally_glazing.gd
new file mode 100644
index 0000000..4a89151
--- /dev/null
+++ b/game/tests/bake_rally_glazing.gd
@@ -0,0 +1,27 @@
+extends SceneTree
+## Rebuild only the four front glazing meshes; other authored surfaces stay exact.
+func _initialize() -> void: run.call_deferred()
+
+func run() -> void:
+	var glazing = preload("res://vehicle/compact_glazing.gd")
+	glazing.use_baked = false
+	glazing.sheets.clear()
+	var trim: Material = VisualGeometry.material(Color("263039"))
+	for simple: bool in [false, true]:
+		var car := CarVisual.new()
+		car.simple_model = simple
+		car.body = Node3D.new()
+		car.add_child(car.body)
+		glazing.sheet(car, true, trim)
+		for glass: bool in [false, true]:
+			var key: String = ("front_glass" if glass else "front_seal") + ("_simple" if simple else "")
+			var directory: String = RacingCarModels.COACH_ROOT if simple else CompactCoachwork.ASSET_ROOT
+			var path: String = directory.path_join(key + ".res")
+			var error: Error = ResourceSaver.save(glazing.sheets[key], path, ResourceSaver.FLAG_COMPRESS)
+			print("RALLY_GLAZING_BAKE ", path, " ", error)
+			if error != OK:
+				car.free()
+				quit(1)
+				return
+		car.free()
+	quit()
diff --git a/game/tests/check_rally_prepared.gd b/game/tests/check_rally_prepared.gd
new file mode 100644
index 0000000..23c3535
--- /dev/null
+++ b/game/tests/check_rally_prepared.gd
@@ -0,0 +1,40 @@
+extends "res://tests/check_prepared_assets.gd"
+## Scope the existing preflight to the assemblies affected by RW01/RW02.
+var reported_source_difference: bool = false
+
+func inspect(path: String, metadata: String, key: Array, sources: Dictionary) -> void:
+	super.inspect(path, metadata, key, sources)
+	if reported_source_difference or not ResourceLoader.exists(path): return
+	var holder: Node = (load(path) as PackedScene).instantiate()
+	var previous: Dictionary = holder.get_meta(metadata, {}).get("sources", {})
+	if previous != sources:
+		reported_source_difference = true
+		for source: String in sources:
+			if previous.get(source, "") != sources[source]: print("RALLY_SOURCE_DIFFERENCE ", source, " stored=", previous.get(source, ""), " current=", sources[source])
+	holder.free()
+
+func run() -> void:
+	var sources: Dictionary = Base.source_hashes("compact")
+	for simple: bool in [false, true]:
+		for editable: bool in [false, true]:
+			var car := CarVisual.new()
+			car.vehicle_id = "compact"
+			car.simple_model = simple
+			car.editable_kits = editable
+			inspect(Base.path_for(car), "modular_car_base", Base.key_for(car), sources)
+			if editable:
+				for category: String in VehicleCustomisation.CATEGORIES:
+					for option: Array in VehicleCustomisation.options(category, "compact").slice(1):
+						inspect(Kits.path_for(car, category, option[0]), "modular_kit", Kits.key_for(car, category, option[0]), Kits.geometry_sources("compact"))
+			car.free()
+	var car := CarVisual.new()
+	car.simple_model = false
+	car.editable_kits = true
+	inspect(Garage.DIRECTORY + "compact.scn", "garage_rest", Garage.geometry_key(car), Garage.geometry_sources("compact"))
+	car.free()
+	car = CarVisual.new()
+	car.simple_model = true
+	inspect(Header.DIRECTORY + "compact.scn", "garage_rest", Header.geometry_key(car), Header.geometry_sources())
+	car.free()
+	print("RALLY_PREPARED: ", resources, " resources; ", checks, " checks, ", failures, " failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/review_rally_windows.gd b/game/tests/review_rally_windows.gd
new file mode 100644
index 0000000..cdc2715
--- /dev/null
+++ b/game/tests/review_rally_windows.gd
@@ -0,0 +1,108 @@
+extends SceneTree
+## RW01/RW02: inspect the actual Rally glass in both mesh qualities.
+var output: String = "res://../docs/evidence/rally-windows-2026-11-08"
+var phase: String = "before"
+var prepared: bool = false
+var validate: bool = false
+var checks: int = 0
+var failures: int = 0
+
+func _initialize() -> void: run.call_deferred()
+
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		print("FAIL: ", label)
+
+func run() -> void:
+	OS.set_environment("BMT_API_URL", "")
+	for argument: String in OS.get_cmdline_user_args():
+		if argument.begins_with("--phase="): phase = argument.trim_prefix("--phase=")
+		if argument == "--prepared": prepared = true
+		if argument == "--validate": validate = true
+	output = ProjectSettings.globalize_path(output).path_join(phase)
+	DirAccess.make_dir_recursive_absolute(output)
+	preload("res://vehicle/modular_car_base.gd").enabled = false
+	preload("res://vehicle/prepared_car_cache.gd").enabled = false
+	preload("res://ui/garage_car_cache.gd").enabled = false
+	preload("res://vehicle/compact_glazing.gd").use_baked = prepared
+	root.size = Vector2i(1280, 720)
+	root.msaa_3d = Viewport.MSAA_4X
+	var world := Node3D.new()
+	root.add_child(world)
+	var camera := Camera3D.new()
+	camera.projection = Camera3D.PROJECTION_ORTHOGONAL
+	camera.size = 4.8
+	camera.current = true
+	world.add_child(camera)
+	var studio_built: bool = false
+	for simple: bool in [false, true]:
+		var car := CarVisual.new()
+		car.vehicle_id = "compact"
+		car.simple_model = simple
+		car.batch_parts = false
+		world.add_child(car)
+		while not car.model_ready: await process_frame
+		if not studio_built:
+			ShowroomStudio.build(world, car)
+			studio_built = true
+		else: ShowroomStudio._studio_glass(car, {})
+		for suffix: String in ["Left", "Right"]:
+			var door: MeshInstance3D = car.body.get_node("DoorWindow" + suffix + "Glass")
+			var quarter: MeshInstance3D = car.body.get_node("QuarterWindow" + suffix + "Glass")
+			var a: AABB = door.mesh.get_aabb()
+			var b: AABB = quarter.mesh.get_aabb()
+			check(absf(a.position.y-b.position.y)<0.001, "aligned lower glass edges " + suffix)
+			check(absf(a.end.y-b.end.y)<0.001, "aligned upper glass edges " + suffix)
+			check(b.position.z-a.end.z>0.055, "separate pillar " + suffix)
+			if validate:
+				check(a.position.y<1.055 and a.position.y>1.025, "glass reaches the lower cabin without crossing the belt " + suffix)
+				for window: MeshInstance3D in [door, quarter]:
+					var clearance: float = INF
+					for point: Vector3 in window.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]:
+						clearance = minf(clearance, absf(point.x)-CompactCoachwork.cabin_width((point.y-1.01)/0.47))
+					check(clearance>0.004, "side glass stays outside the body " + window.name)
+			print("WINDOW_BOUNDS simple=", simple, " ", suffix, " ", a, " quarter=", b)
+		for name: String in ["FrontGlassSheet", "RearGlassSheet"]:
+			var sheet: MeshInstance3D = car.body.get_node(name)
+			var arrays: Array = sheet.mesh.surface_get_arrays(0)
+			var valid: bool = true
+			for n: Vector3 in arrays[Mesh.ARRAY_NORMAL]:
+				valid = valid and n.is_finite() and n.length_squared()>0.9
+			check(valid, "finite glass normals " + name)
+			if validate and name == "FrontGlassSheet":
+				var clearance: float = INF
+				for point: Vector3 in arrays[Mesh.ARRAY_VERTEX]:
+					var height: float = (point.y-1.01)/0.47
+					var skin: Vector3 = CompactCoachwork.cabin_front_point(point.x/CompactCoachwork.cabin_width(height), height)
