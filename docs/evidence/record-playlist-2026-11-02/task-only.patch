new file mode 100644
index 0000000..aea31c2
--- /dev/null
+++ b/docs/evidence/record-playlist-2026-11-02/check_catalogues.py
@@ -0,0 +1,20 @@
+"""Verify only the directly authored playlist messages without rewriting catalogues."""
+from pathlib import Path
+import sys
+
+root = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(root / 'scripts'))
+import localization
+
+rows = [line.split('|') for line in (root / 'scripts/translations/record_playlist.tsv').read_text(encoding='utf-8').splitlines() if line]
+languages = ['en', 'fr', 'es', 'de', 'pt_BR', 'ja', 'ko', 'nl', 'it', 'fi', 'sv', 'nb']
+for index, language in enumerate(languages):
+    catalogue = localization.parse_po((root / f'game/localization/{language}.po').read_text(encoding='utf-8'))
+    for row in rows:
+        assert len(row) == len(languages)
+        value = catalogue[('', row[0])]['msgstr']
+        assert value == row[index], (language, row[0])
+        assert localization.placeholders(value) == localization.placeholders(row[0])
+source = localization.parse_po((root / 'game/localization/messages.pot').read_text(encoding='utf-8'))
+assert all(('', row[0]) in source for row in rows)
+print('Scoped playlist catalogues: 36 translations, 3 source messages, valid placeholders')
diff --git a/docs/evidence/record-playlist-2026-11-02/checkpoint.py b/docs/evidence/record-playlist-2026-11-02/checkpoint.py
new file mode 100644
index 0000000..06de9a1
--- /dev/null
+++ b/docs/evidence/record-playlist-2026-11-02/checkpoint.py
@@ -0,0 +1,56 @@
+"""Create and round-trip a task-only patch in an owned temporary Git repository."""
+from pathlib import Path
+import hashlib
+import json
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[3]
+out = Path(__file__).resolve().parent
+before = root / 'build/record-playlist-2026-11-02/before'
+files = ['game/soundtrack/record_library.gd', 'game/soundtrack/audio_world.gd',
+         'game/ui/garage_records_menu.gd', 'game/persistence/local_records.gd',
+         'game/tests/test_record_playlist.gd', 'scripts/translations/record_playlist.tsv',
+         'docs/RECORD_PLAYLIST_2026_11_02.md', 'AGENTS.md',
+         'docs/evidence/record-playlist-2026-11-02/run_native.py',
+         'docs/evidence/record-playlist-2026-11-02/check_catalogues.py',
+         'docs/evidence/record-playlist-2026-11-02/checkpoint.py',
+         'game/localization/messages.pot']
+files += ['game/localization/' + lang + '.po' for lang in ['en', 'fr', 'es', 'de', 'pt_BR', 'ja', 'ko', 'nl', 'it', 'fi', 'sv', 'nb']]
+
+def normalized(path):
+    return path.read_text(encoding='utf-8').encode('utf-8')
+
+old = {name: normalized(before / name) for name in files if (before / name).exists()}
+new = {name: normalized(root / name) for name in files}
+with tempfile.TemporaryDirectory(prefix='checkpoint-', dir=root / 'build/record-playlist-2026-11-02') as temporary:
+    repo = Path(temporary)
+    def git(*args):
+        return subprocess.run(['git', '-c', 'core.autocrlf=false', *args], cwd=repo, check=True, capture_output=True).stdout
+    def write(values):
+        for name, data in values.items():
+            path = repo / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(data)
+    git('init', '-q')
+    write(old)
+    git('add', '--all')
+    git('-c', 'user.name=Task checkpoint', '-c', 'user.email=checkpoint@localhost', 'commit', '-qm', 'Task-start sources')
+    write(new)
+    git('add', '--all')
+    patch = git('diff', '--cached', '--binary', '--no-ext-diff')
+    patch_path = out / 'task-only.patch'
+    patch_path.write_bytes(patch)
+    git('apply', '--reverse', '--check', str(patch_path))
+    git('apply', '--reverse', str(patch_path))
+    for name in files:
+        path = repo / name
+        assert (path.read_bytes() if path.exists() else None) == old.get(name), name
+    git('apply', '--check', str(patch_path))
+    git('apply', str(patch_path))
+    assert all((repo / name).read_bytes() == data for name, data in new.items())
+report = {'files': len(files), 'patch_sha256': hashlib.sha256(patch).hexdigest(),
+          'forward_reverse_equal': True,
+          'sources': {name: hashlib.sha256(data).hexdigest() for name, data in new.items()}}
+(out / 'checkpoint.json').write_text(json.dumps(report, indent=2) + '\n', encoding='utf-8')
+print(f'Task-only checkpoint: {len(files)} files, forward/reverse normalized-text equality passed')
diff --git a/docs/evidence/record-playlist-2026-11-02/run_native.py b/docs/evidence/record-playlist-2026-11-02/run_native.py
new file mode 100644
index 0000000..7ede831
--- /dev/null
+++ b/docs/evidence/record-playlist-2026-11-02/run_native.py
@@ -0,0 +1,36 @@
+"""Offline isolated playlist checks using the pinned engine and crash-dialog wrapper."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(__file__).resolve().parent
+script = next((arg for arg in sys.argv[1:] if not arg.startswith('--')), 'test_record_playlist')
+graphical = '--graphical' in sys.argv
+renderer = 'mobile' if '--mobile' in sys.argv else 'gl_compatibility'
+profile = root / 'build/record-playlist-2026-11-02' / (script + '-' + renderer)
+profile.mkdir(parents=True, exist_ok=True)
+env = dict(os.environ, APPDATA=str(profile), LOCALAPPDATA=str(profile), BMT_API_URL='',
+           BMT_PLAYLIST_EVIDENCE=str(out / renderer))
+(out / renderer).mkdir(parents=True, exist_ok=True)
+(root / 'build/soundtrack-2026-test').mkdir(parents=True, exist_ok=True)
+command = [sys.executable, str(root / 'scripts/run_no_crash_dialog.py'), '--',
+           r'C:\apps\Godot 4.7.2\Godot_v4.7.2-stable_win64_console.exe',
+           '--path', str(root / 'game'), '--rendering-method', renderer,
+           '--audio-driver', 'Dummy', '--script', 'res://tests/' + script + '.gd']
+if not graphical:
+    command.append('--headless')
+process = subprocess.Popen(command, cwd=root, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                           text=True, encoding='utf-8', errors='replace')
+try:
+    stdout, stderr = process.communicate(timeout=240)
+except subprocess.TimeoutExpired:
+    # The wrapper owns Godot; terminate this exact launched tree before draining pipes.
+    subprocess.run(['taskkill', '/PID', str(process.pid), '/T', '/F'], capture_output=True, check=False)
+    stdout, stderr = process.communicate(timeout=15)
+    stderr += '\nTask-owned native test exceeded 240 seconds.\n'
+output = stdout + stderr
+(out / (script + '-' + renderer + ('-native' if graphical else '-headless') + '.log')).write_text(output, encoding='utf-8')
+print(output)
+raise SystemExit(process.returncode)
