+func region_change(clean: Image, coated: Image, rectangle: Rect2i) -> float:
+	var total: float = 0.0
+	for y: int in range(rectangle.position.y, rectangle.end.y):
+		for x: int in range(rectangle.position.x, rectangle.end.x):
+			var a: Color = clean.get_pixel(x, y)
+			var b: Color = coated.get_pixel(x, y)
+			total += (absf(a.r-b.r) + absf(a.g-b.g) + absf(a.b-b.b)) / 3.0
+	return total / rectangle.get_area()
