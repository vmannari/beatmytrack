+func _panel(parent: Control, id: String) -> VBoxContainer:
+	var panel := PanelContainer.new()
+	panel.name = id
+	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	panel.size_flags_vertical = Control.SIZE_EXPAND_FILL
