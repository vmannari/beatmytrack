diff --git a/game/ui/rivalry_podium_backdrop.gd b/game/ui/rivalry_podium_backdrop.gd
--- /dev/null
+++ b/game/ui/rivalry_podium_backdrop.gd
@@ -0,0 +1,44 @@
+extends ColorRect
+## Static medal-lit stage, confined to the podium above its separate player footer.
+const STAGE: Shader = preload("res://ui/rivalry_podium_backdrop.gdshader")
+const WALL: Array[Color] = [Color("29200c"),Color("142b3b"),Color("361d15")]
+const FLOOR: Array[Color] = [Color("51401a"),Color("203e51"),Color("56311f")]
+const LIGHT: Array[Color] = [Color("ffc452"),Color("a0c5df"),Color("f29459")]
+const STRENGTH: Array[float] = [0.32,0.16,0.22]
+
+static func add_to(panel: Control, footer: Control, place: int) -> Control:
+	var stage := new()
+	stage.name = "RivalryPodiumBackdrop"
+	stage.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	var paint := ShaderMaterial.new()
+	paint.shader = STAGE
+	paint.set_shader_parameter("wall_color",WALL[place])
+	paint.set_shader_parameter("floor_color",FLOOR[place])
+	paint.set_shader_parameter("light_color",LIGHT[place])
+	paint.set_shader_parameter("light_strength",STRENGTH[place])
+	stage.material = paint
+	# Let PanelContainer fit a plain holder; only its child owns the stage inset.
+	var holder := Control.new()
+	holder.name = "RivalryPodiumStage"
+	holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	panel.add_child(holder,false,Node.INTERNAL_MODE_FRONT)
+	holder.add_child(stage)
+	stage.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	stage.offset_left = 1
+	stage.offset_top = 2
+	stage.offset_right = -1
+	holder.resized.connect(stage._layout_stage.bind(footer))
+	footer.item_rect_changed.connect(stage._layout_stage.bind(footer))
+	stage.resized.connect(stage._resize_stage)
+	stage._layout_stage(footer)
+	return stage
+
+func _layout_stage(footer: Control) -> void:
+	if not is_instance_valid(footer): return
+	var holder := get_parent() as Control
+	var footer_start: Vector2 = holder.get_global_transform().affine_inverse()*footer.global_position
+	offset_bottom = footer_start.y-holder.size.y
+	_resize_stage()
+
+func _resize_stage() -> void:
+	(material as ShaderMaterial).set_shader_parameter("stage_size",size.max(Vector2.ONE))
diff --git a/game/ui/rivalry_podium_backdrop.gdshader b/game/ui/rivalry_podium_backdrop.gdshader
--- /dev/null
+++ b/game/ui/rivalry_podium_backdrop.gdshader
@@ -0,0 +1,30 @@
+shader_type canvas_item;
+render_mode unshaded;
+
+uniform vec4 wall_color : source_color = vec4(0.12, 0.1, 0.04, 1.0);
+uniform vec4 floor_color : source_color = vec4(0.25, 0.19, 0.07, 1.0);
+uniform vec4 light_color : source_color = vec4(0.9, 0.65, 0.2, 1.0);
+uniform float light_strength = 0.3;
+uniform vec2 stage_size = vec2(180.0, 140.0);
+
+void fragment() {
+	vec2 uv = UV;
+	float floor_depth = smoothstep(0.59, 1.0, uv.y);
+	vec3 backdrop = mix(wall_color.rgb * (0.92 - uv.y * 0.25), floor_color.rgb, floor_depth);
+	// A low pool of medal-colored light grounds the existing native car cutout.
+	vec2 pool = (uv - vec2(0.5, 0.86)) * vec2(2.2, 5.4);
+	float illumination = exp(-dot(pool, pool) * 1.6);
+	vec2 halo = (uv - vec2(0.5, 0.72)) * vec2(2.2, 2.8);
+	backdrop += light_color.rgb * light_strength * (illumination + 0.17 * exp(-dot(halo, halo) * 2.5));
+	// Restrained perspective floor seams, fading towards the back of the stage.
+	float perspective = (uv.x - 0.5) / (0.28 + floor_depth * 0.95);
+	float seam_x = 1.0 - smoothstep(0.012, 0.03, abs(sin(perspective * 9.424778)));
+	float seam_y = max(1.0 - smoothstep(0.002, 0.009, abs(uv.y - 0.76)), 1.0 - smoothstep(0.002, 0.009, abs(uv.y - 0.94)));
+	backdrop += light_color.rgb * (seam_x + seam_y) * floor_depth * illumination * 0.045;
+	// Keep the stage edges quiet and let the car's real contact shadows read.
+	backdrop *= 1.0 - 0.27 * pow(abs(uv.x - 0.5) * 2.0, 2.0);
+	vec2 p = uv * stage_size;
+	vec2 q = abs(p - stage_size * 0.5) - stage_size * 0.5 + vec2(4.0);
+	float edge = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - 4.0;
+	COLOR = vec4(backdrop, 1.0 - smoothstep(-0.8, 0.0, edge));
+}
