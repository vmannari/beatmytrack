diff --git a/game/ui/rivalry_car_composite.gdshader b/game/ui/rivalry_car_composite.gdshader
new file mode 100644
index 0000000..396aa93
--- /dev/null
+++ b/game/ui/rivalry_car_composite.gdshader
@@ -0,0 +1,55 @@
+shader_type canvas_item;
+render_mode unshaded, blend_premul_alpha;
+varying vec4 canvas_tint;
+uniform bool linear_resolve = false;
+
+void vertex() { canvas_tint = COLOR; }
+
+vec3 to_linear(vec3 color) {
+	return mix(pow((color+vec3(0.055))/1.055,vec3(2.4)),color/12.92,step(color,vec3(0.04045)));
+}
+
+vec3 to_display(vec3 color) {
+	color = clamp(color,vec3(0.0),vec3(1.0));
+	return mix(1.055*pow(color,vec3(1.0/2.4))-vec3(0.055),color*12.92,step(color,vec3(0.0031308)));
+}
+
+vec4 coverage(sampler2D source, ivec2 pixel, ivec2 extent, vec3 matte) {
+	vec4 sample_color = texelFetch(source,clamp(pixel,ivec2(0),extent-ivec2(1)),0);
+	if (sample_color.a < 0.0001) return vec4(0.0);
+	if (sample_color.a > 0.9999) return sample_color;
+	// Resolve silhouette coverage from a neighbouring opaque colour before the
+	// renderer's tonemapped clear colour can contaminate subpixel edge samples.
+	vec4 interior = sample_color;
+	for (int y = -1; y <= 1; y++) {
+		for (int x = -1; x <= 1; x++) {
+			vec4 adjacent = texelFetch(source,clamp(pixel+ivec2(x,y),ivec2(0),extent-ivec2(1)),0);
+			if (adjacent.a > interior.a) interior = adjacent;
+		}
+	}
+	if (interior.a > 0.9999) {
+		sample_color.rgb = interior.rgb*sample_color.a;
+		return sample_color;
+	}
+	// Transparent 3D targets can retain their clear RGB under zero alpha.
+	// Remove that matte before filtering, including the contact-shadow pixels.
+	if (linear_resolve) {
+		vec3 pigment = max(vec3(0.0),to_linear(sample_color.rgb)-to_linear(matte)*(1.0-sample_color.a))/sample_color.a;
+		sample_color.rgb = to_display(pigment)*sample_color.a;
+	} else {
+		sample_color.rgb = max(vec3(0.0),sample_color.rgb-matte*(1.0-sample_color.a));
+	}
+	return sample_color;
+}
+
+void fragment() {
+	ivec2 extent = textureSize(TEXTURE,0);
+	vec3 matte = texelFetch(TEXTURE,ivec2(0),0).rgb;
+	vec2 pixel = UV*vec2(extent)-vec2(0.5);
+	ivec2 base = ivec2(floor(pixel));
+	vec2 weight = fract(pixel);
+	vec4 top = mix(coverage(TEXTURE,base,extent,matte),coverage(TEXTURE,base+ivec2(1,0),extent,matte),weight.x);
+	vec4 bottom = mix(coverage(TEXTURE,base+ivec2(0,1),extent,matte),coverage(TEXTURE,base+ivec2(1),extent,matte),weight.x);
+	COLOR = mix(top,bottom,weight.y)*canvas_tint;
+	COLOR.rgb *= canvas_tint.a;
+}
