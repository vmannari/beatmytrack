+﻿param([ValidateSet('headless','gl_compatibility','mobile','before','regression','parser')][string]$Mode = 'headless')
+$ErrorActionPreference = 'Continue'
+$repo = (Resolve-Path (Join-Path $PSScriptRoot '../../..')).Path
