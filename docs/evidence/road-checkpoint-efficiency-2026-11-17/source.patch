+static func request_saved_road_bake(track: NativeTrack, owner_tree: SceneTree) -> void:
+	preload("res://track/road_cache_bakes.gd").start(track,owner_tree)
+
+
+static func _admit_road_entry(entry: Dictionary) -> void:
+	if int(entry.bytes) <= 0 or int(entry.bytes) > ROAD_CACHE_BUDGET: return
+	for index: int in range(_road_mesh_cache.size()-1,-1,-1):
+		if _road_mesh_cache[index].key == entry.key or (not str(entry.get("geometry_key","")).is_empty() and _road_mesh_cache[index].get("geometry_key","") == entry.geometry_key): _road_mesh_cache.remove_at(index)
+	var total: int = int(entry.bytes)
+	for existing: Dictionary in _road_mesh_cache: total += int(existing.bytes)
+	while not _road_mesh_cache.is_empty() and (_road_mesh_cache.size() >= ROAD_CACHE_MAX_ENTRIES or total > ROAD_CACHE_BUDGET):
+		total -= int(_road_mesh_cache.pop_front().bytes)
+	_road_mesh_cache.append(entry)
+	EDITOR_ROADS.account_gpu(_road_mesh_cache)
+
+static func trim_editor_cache() -> void:
+	_road_mesh_cache.clear()
+	preload("res://editor/road_preparation.gd").account_gpu(_road_mesh_cache)
+	preload("res://editor/road_preparation.gd").trim_retained()
+
+static func trim_private_road_cache(release_bytes: int) -> void:
+	# Removing exact aliases saves nothing. Prefer independent older roads;
+	# live scenes retain their resources and verified disk fallback remains.
+	var released: int = 0
+	for entry: Dictionary in _road_mesh_cache.duplicate():
+		if released >= release_bytes: break
+		var private_bytes: int = maxi(0,int(entry.bytes)-PREPARED_WORLDS.shared_road_bytes([entry]))
+		if private_bytes == 0: continue
+		_road_mesh_cache.erase(entry)
+		released += private_bytes
+	EDITOR_ROADS.account_gpu(_road_mesh_cache)
+
+static func reserve_editor_sections() -> void:
+	# Bound the combined idle cache at its existing 32 MiB while reserving
+	# half for local CPU work. Live editor/race nodes still own their resources.
+	var bytes: int = 0
+	for entry: Dictionary in _road_mesh_cache: bytes += int(entry.bytes)
+	while not _road_mesh_cache.is_empty() and bytes > ROAD_CACHE_BUDGET/2:
+		bytes -= int(_road_mesh_cache.pop_front().bytes)
+	EDITOR_ROADS.account_gpu(_road_mesh_cache)
+	EDITOR_ROADS.reserve_sections()
