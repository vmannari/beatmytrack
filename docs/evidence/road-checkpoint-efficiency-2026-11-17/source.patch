+		if entry.key.slice(1) != key.slice(1): continue
+		if entry.key != key and (geometry_key.is_empty() or entry.get("geometry_key","") != geometry_key): continue
+		_road_mesh_cache.remove_at(index)
+		_road_mesh_cache.append(entry)
