+            if connection.scalar(
+                text("""SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n
+                ON n.oid=c.relnamespace WHERE n.nspname=:schema AND c.relowner=:oid LIMIT 1"""),
+                {"schema": schema, "oid": flags[0]},
