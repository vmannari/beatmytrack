+	var text: String = GameText.message("%s · %s · 5 laps · %s\n%s\nCode: %s") % [str(value.entry.name),time,VehicleCatalog.title(str(value.vehicle_id)),str(value.share_url),str(value.code)]
+	if ChallengesClient.is_series(value):
