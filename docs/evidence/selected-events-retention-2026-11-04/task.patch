+		app.rivalry_section = section
+		app._rivalry()
+		if not app.rivalry.model.sample: app.rivalry.refresh(false))
+	page.track_requested.connect(func(index: int) -> void:
+		app.rivalry_track = index
+		app.rivalry_section = "detail"
