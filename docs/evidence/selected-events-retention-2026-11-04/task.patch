+	guard.unlock()
+
+static func _erase_section(key: String) -> void:
+	section_bytes -= int(section_entries[key].bytes); section_entries.erase(key)
+	var role: String = key.get_slice("/",0)
+	section_counts[role] = int(section_counts.get(role,1))-1
+
