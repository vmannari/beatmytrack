diff --git a/docs/evidence/soft-snow-impact-2026-10-23/before/game/tests/capture_original_snow_impact.gd b/docs/evidence/soft-snow-impact-2026-10-23/before/game/tests/capture_original_snow_impact.gd
new file mode 100644
index 0000000..a4e21f5
--- /dev/null
+++ b/docs/evidence/soft-snow-impact-2026-10-23/before/game/tests/capture_original_snow_impact.gd
@@ -0,0 +1,52 @@
+extends SceneTree
+## Same live event pool, pitch, Vehicle compressor and Master limiter for each cut.
+const OUT: String = "res://../docs/evidence/original-snow-impact-2026-10-23/audition"
+var checks: int = 0
+var failures: int = 0
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		print("FAIL: "+label)
+
+func run() -> void:
+	check(DisplayServer.get_name()!="headless","audition uses the real desktop mixer")
+	if failures:
+		quit(1)
+		return
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT))
+	var world: GameSoundtrack = GameSoundtrack.instance()
+	world.begin_race(root,"winter",VehicleState.new())
+	world.apply_settings({"vehicle_volume":1.0})
+	var audio := VehicleAudio.new()
+	audio.use_windows_impacts = false # Record the tone; separate tests verify RAW events.
+	root.add_child(audio)
+	audio.configure("compact",VehicleCatalog.config("compact"))
+	var record := AudioEffectRecord.new()
+	AudioServer.add_bus_effect(0,record)
+	world.windows_output.sync_output()
+	for variant: String in ["before","packed","powder","bank"]:
+		var path: String = "res://../docs/evidence/original-snow-impact-2026-10-23/before/game/assets/audio/vehicles/snow_hit.wav" if variant=="before" else "res://../build/original-snow-impact-2026-10-23/variants/"+variant+".wav"
+		var stream: AudioStreamWAV = AudioStreamWAV.load_from_file(path)
+		check(stream!=null and stream.mix_rate==44100 and not stream.stereo,"valid mono entry: "+variant)
+		if stream==null: continue
+		audio.reset()
+		audio.streams.snow_hit = stream
+		await create_timer(.15).timeout
+		record.set_recording_active(true)
+		await create_timer(.15).timeout
+		audio._event("snow_hit",.65,.90)
+		await create_timer(.7).timeout
+		record.set_recording_active(false)
+		var capture: AudioStreamWAV = record.get_recording()
+		check(capture!=null and capture.save_to_wav(OUT.path_join(variant+".wav"))==OK,"native mastered event saved: "+variant)
+		check(audio.event_count==1 and not audio.events[0].playing,"one bounded event completes naturally: "+variant)
+	for index: int in range(AudioServer.get_bus_effect_count(0)):
+		if AudioServer.get_bus_effect(0,index)==record:
+			AudioServer.remove_bus_effect(0,index)
+			break
+	audio.free()
+	await create_timer(.15).timeout
+	print("ORIGINAL_SNOW_CAPTURE: %d checks, %d failures"%[checks,failures])
+	quit(1 if failures else 0)
diff --git a/docs/evidence/soft-snow-impact-2026-10-23/before/game/vehicle/vehicle_audio.gd b/docs/evidence/soft-snow-impact-2026-10-23/before/game/vehicle/vehicle_audio.gd
new file mode 100644
index 0000000..ba9b5a3
--- /dev/null
+++ b/docs/evidence/soft-snow-impact-2026-10-23/before/game/vehicle/vehicle_audio.gd
@@ -0,0 +1,591 @@
+class_name VehicleAudio
+extends Node
+## Recorded local sound bank. All state is presentation-only and scoped to this race.
+const BANK: String = "res://assets/audio/vehicles/"
+const COMPRESSED_LOOPS: Array[String] = ["road", "wind", "water", "sand_roll", "sand", "sand_debris", "kerb_roll", "loose", "grass"]
+const IMPACTS: Array[String] = ["impact_0","impact_1","impact_2"]
+const BODY_CLIPS: Array[String] = ["impact_0","impact_1","impact_2","chassis","snow_hit"]
+const GRIT: Array[String] = ["grit_0","grit_1","grit_2"]
+const GRIT_SPACING: Array[float] = [4.2,6.6,5.1,3.7]
+const STREAM_CACHE_BYTES: int = 24 * 1024 * 1024
+static var prepared_streams: Array[Dictionary] = []
+var model := VehicleAudioModel.new()
+var surface_model := SurfaceAudioModel.new()
+var engine_load: Array[AudioStreamPlayer] = []
+var engine_coast: Array[AudioStreamPlayer] = []
+var layers: Dictionary = {}
+var events: Array[AudioStreamPlayer] = []
+var debris_events: Array[AudioStreamPlayer] = []
+var streams: Dictionary = {}
+var levels: Dictionary = {}
+var active: bool = false
+var output_enabled: bool = DisplayServer.get_name() != "headless"
+var impact_cooldown: float = 0.0
+var chassis_cooldown: float = 0.0
+var event_index: int = 0
+var impact_index: int = 0
+var last_tick: int = -1
+var last_jump: float = 0.0
+var last_jump_velocity: float = 0.0
+var was_silent: bool = true
+var event_count: int = 0
+var engine_envelope: float = 0.0
+var grit_distance: float = 0.0
+var grit_cooldown: float = 0.0
+var grit_count: int = 0
+var pending_scrape: float = 0.0
+var pending_scrape_speed: float = 0.0
+var scrape_hold: float = 0.0
+var held_scrape: float = 0.0
+var held_scrape_speed: float = 0.0
+var contact_radius: float = 1.0
+var pending_kerb: float = 0.0
+var kerb_hold: float = 0.0
+var held_kerb: float = 0.0
+var kerb_touching: bool = false
+var kerb_cooldown: float = 0.0
+var kerb_count: int = 0
+var bridge_layer_known: bool = false
+var bridge_layer: bool = false
+var bridge_tick: int = -1
+var bridge_count: int = 0
+const RUBBING_SKIN: float = 0.025
+var debris_index: int = 0
+var impact_count: int = 0
+var countdown_active: bool = false
+var sand_frequency: float = 0.94
+var contact_enabled: bool = false
+var snow_touching: bool = false
+var snow_cooldown: float = 0.0
+var snow_count: int = 0
+var snow_release: float = 0.0
+var visible_contact := VisibleContactAudio.new()
+var use_windows_impacts: bool = true
+var windows_impacts := WindowsImpactAudio.new()
+var collision_trace_enabled: bool = false
+var last_impact_route: String = "none"
+
+func _ready() -> void:
+	name = "VehicleAudio"
+	collision_trace_enabled = OS.is_debug_build() and OS.get_cmdline_user_args().has("--collision-audio-trace")
+	for i: int in range(3):
+		engine_load.append(_player("EngineLoad%d"%i,"Engine"))
+		engine_coast.append(_player("EngineCoast%d"%i,"Engine"))
+	for layer: String in ["tire","road","loose","grass","wind","water","sand","sand_roll","sand_debris","scrape","kerb_roll"]:
+		var player: AudioStreamPlayer = _player(layer.capitalize(),"Tires" if layer in ["tire","road","loose","grass","water"] else "Vehicle")
+		layers[layer] = player
+		player.stream = _stream(layer,true)
+		levels[layer] = 0.0
+	for i: int in range(4): events.append(_player("BodyEvent%d"%i,"Vehicle"))
+	# Debris cannot steal a collision voice or truncate its settling tail.
+	for i: int in range(2): debris_events.append(_player("DebrisEvent%d"%i,"Vehicle"))
+	for clip: String in IMPACTS+GRIT+ ["chassis"]: _stream(clip,false)
+	levels.snow = 0.0
+	if use_windows_impacts:
+		var impact_samples: Array[AudioStreamWAV] = []
+		for clip: String in BODY_CLIPS: impact_samples.append(_stream(clip,false) as AudioStreamWAV)
+		windows_impacts.configure(impact_samples)
+
+func _exit_tree() -> void:
+	windows_impacts.close()
+	for child: Node in get_children():
+		if child is AudioStreamPlayer:
+			var player: AudioStreamPlayer = child as AudioStreamPlayer
+			player.stop()
+			player.stream = null
+	streams.clear()
+
+func _player(label: String, target_bus: String) -> AudioStreamPlayer:
+	var player := AudioStreamPlayer.new()
+	player.name = label
+	player.bus = target_bus
+	player.volume_linear = 0.0
+	add_child(player)
+	return player
+
+func _stream(clip: String, looping: bool) -> AudioStream:
+	if streams.has(clip): return streams[clip] as AudioStream
+	var key: Array = [clip,looping]
+	for index: int in range(prepared_streams.size()):
+		if prepared_streams[index].key != key: continue
+		var entry: Dictionary = prepared_streams.pop_at(index)
+		prepared_streams.append(entry)
+		streams[clip] = entry.stream
+		return entry.stream
+	var suffix: String = ".ogg" if clip in COMPRESSED_LOOPS else ".wav"
+	var source: AudioStream = load(BANK+clip+suffix) as AudioStream
+	var sample: AudioStream = AudioLoop.prepare(source) if looping else source.duplicate() as AudioStream
+	var bytes: int = 4096
+	if sample is AudioStreamWAV: bytes += sample.data.size()
+	else:
+		var file := FileAccess.open(BANK+clip+suffix,FileAccess.READ)
+		if file != null:
+			bytes += file.get_length()*2
+			file.close()
+	if bytes <= STREAM_CACHE_BYTES:
+		var total: int = bytes
+		for entry: Dictionary in prepared_streams: total += int(entry.bytes)
+		while not prepared_streams.is_empty() and (prepared_streams.size() >= 48 or total > STREAM_CACHE_BYTES): total -= int(prepared_streams.pop_front().bytes)
+		prepared_streams.append({"key":key,"stream":sample,"bytes":bytes})
+	streams[clip] = sample
+	return sample
+
+func configure(id: String, config: HandlingConfig, car: Node3D = null) -> void:
+	model.configure(id,config.maximum_speed)
+	surface_model.configure(config)
+	contact_radius = config.collision_radius
+	if car!=null: visible_contact.configure(car,car is CarVisual)
+	else: visible_contact.outline = PackedVector2Array()
+	# Only the selected vehicle's six engine loops are retained by this race.
+	for i: int in range(3):
+		engine_load[i].stream = _stream(model.vehicle_id+"_%d_load"%i,true)
+		engine_coast[i].stream = _stream(model.vehicle_id+"_%d_coast"%i,true)
+	reset()
+
+func reset() -> void:
+	windows_impacts.reset()
+	model.reset()
+	surface_model.reset()
+	snow_touching = false
+	snow_cooldown = 0.0
+	snow_count = 0
+	snow_release = 0.0
+	levels.snow = 0.0
+	impact_cooldown = 0.0
+	countdown_active = false
+	contact_enabled = false
+	visible_contact.reset()
+	sand_frequency = 0.94
+	chassis_cooldown = 0.0
+	event_index = 0
+	impact_index = 0
+	impact_count = 0
+	debris_index = 0
+	event_count = 0
+	engine_envelope = 0.0
+	grit_distance = 0.0
+	grit_cooldown = 0.0
+	grit_count = 0
+	pending_scrape = 0.0
+	pending_scrape_speed = 0.0
+	scrape_hold = 0.0
+	held_scrape = 0.0
+	held_scrape_speed = 0.0
+	pending_kerb = 0.0
+	kerb_hold = 0.0
+	held_kerb = 0.0
+	kerb_touching = false
+	kerb_cooldown = 0.0
+	kerb_count = 0
+	bridge_layer_known = false
+	bridge_layer = false
+	bridge_tick = -1
+	bridge_count = 0
+	last_tick = -1
+	last_jump = 0.0
+	last_jump_velocity = 0.0
+	was_silent = true
+	active = true
+	for i: int in range(3):
+		for player: AudioStreamPlayer in [engine_load[i],engine_coast[i]]:
+			player.stop()
+			player.volume_linear = 0.0
+			player.stream_paused = false
