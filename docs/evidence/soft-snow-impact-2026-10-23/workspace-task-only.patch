diff --git a/licenses/ASSETS.md b/licenses/ASSETS.md
index e2d22ea..bf449e7 100644
--- a/licenses/ASSETS.md
+++ b/licenses/ASSETS.md
@@ -1,3 +1,5 @@
+Challenge native graphics (2026-10-23, CNA01-CNA03): game/ui/challenge_graphic.gd contains original code-native circuit/search/planning and competition diagrams, using the existing game fonts and fictional MenuIcon set. Race and picker maps use their actual saved track points. These replace the generated challenge entry/format pictures and scenic challenge backgrounds after owner feedback. No new raster asset, third-party source, provider or dependency. Earlier PNGs and their provenance remain historical; they are no longer referenced by the challenge UI. Native views and exact source hashes: docs/evidence/challenge-native-art-2026-10-23/report.json.
+
 Garage sidebar artwork (2026-10-19, GSI01-GSI03): original project-authored SVG path data in game/ui/garage_mode_icons.gd for the car silhouette, paintbrush, cleaning droplet, wrench, musical notes, trophy and newspaper. Shared rounded strokes and native Godot SVG rasterisation; no downloaded/copied icon library, generated-provider image, external asset or new dependency. Actual native views and task-only checkpoint: docs/GARAGE_SIDEBAR_2026_10_19.md.
 
 Ice Compact sculpture (2026-10-19, ICS01-ICS03): original procedural derivative of the project fictional Compact analytical coachwork in game/vehicle/compact_coachwork.gd, authored in game/track/prop_ice_compact.gd. The snow-covered pedestal reuses the existing winter_snow_v1.png and world-snow shader treatment, retaining that asset's recorded provenance. Original carved ice finish, wheel/fitting details and pedestal geometry; no third-party model/bitmap, generated-provider asset, copied reference pixels or new dependency. Source/capture hashes and actual verification: docs/ICE_COMPACT_SCULPTURE_2026_10_19.md and its evidence/report.json.
@@ -267,6 +269,8 @@ Shared Windows mixed output v6 (2026-10-23, SAL01-SAL03): original native/window
 
 Original snow entry revision 3 (2026-10-23, OSI01-OSI03): three original composites use only existing Nox Sound Design Essentials Series CC0 snow recordings. The installed packed-snow entry layers the recorded landing and hard-snow run with peak alignment, resampling, 50-580Hz body shaping, rounded density control and short fades. Existing snow.wav remains exact. No Soundsnap audio is incorporated or attributed as listened to: the supplied catalogue guides the requested heavier snow-impact category, while its player did not return usable previews here. Exact source/derivative hashes and mastering are in game/assets/audio/vehicles/snow_manifest.json and scripts/build_snow_audio.py. Auditions, actual checks and limits: docs/ORIGINAL_SNOW_IMPACT_2026_10_23.md. No new asset download/dependency or runtime media service.
 
+Softer packed-snow entry revision 4 (2026-10-23, SSI01): same existing CC0 Nox sources and recorded body, gentler high detail and lower peak. Packed compression2400Hz, crumble0.16, attack1.2ms and final trim-1.5dB; actual onset0.408ms. Continuous/powder/heavy-bank samples stay exact. No new asset/dependency/reference audio. Source/derivative hashes: game/assets/audio/vehicles/snow_manifest.json. Actual mastered before/after, verification and limits: docs/SOFT_SNOW_IMPACT_2026_10_23.md.
+
 Desert reference sand density (2026-10-23, RSP01-RSP03): game/assets/textures/desert_wind_density_v1.png is original offline numerical 256x256 RGB density/warp/fine-breakup data, made with the existing pinned Godot/FastNoiseLite tool. Recipe: game/tests/bake_desert_wind_density.gd; seeds63143/92381/41773, frequencies0.020/0.065/0.31, FBM octaves4/3/2 and gain0.52. Lossless mipmapped data import; no colour photography, copied reference pixels, AI/provider output, runtime generation or new dependency. The owner photograph guides colour and movement only and is not exported. Asset hashes, native previews and acceptance limits: docs/DESERT_SAND_REFERENCE_2026_10_23.md and docs/evidence/desert-sand-reference-2026-10-23/report.json. Existing Godot dependencies retain their supplied licences.
 
 
diff --git a/scripts/build_snow_audio.py b/scripts/build_snow_audio.py
index 9a7942a..1bd48e0 100644
--- a/scripts/build_snow_audio.py
+++ b/scripts/build_snow_audio.py
@@ -79,16 +79,16 @@ def make_impact(clips, variant):
     """Original layered snow recordings; no third-party reference audio."""
     seconds = {"packed": .34, "powder": .38, "bank": .42}[variant]
     speed = {"packed": .76, "powder": .88, "bank": .62}[variant]
-    compression = impact_fragment(clips[3], speed, seconds, 65, 2900)
+    compression = impact_fragment(clips[3], speed, seconds, 65, 2400 if variant == "packed" else 2900)
     body = impact_fragment(clips[3], .48 if variant != "bank" else .42, seconds, 50, 580)
     crumble = impact_fragment(clips[2], .88, seconds, 220, 3600)
     powder = impact_fragment(clips[0], .85, seconds, 180, 2400)
-    if variant == "packed": values = compression*.64 + body*.44 + crumble*.30
+    if variant == "packed": values = compression*.64 + body*.44 + crumble*.16
     elif variant == "powder": values = compression*.55 + body*.30 + powder*.55
     else: values = compression*.65 + body*.65 + crumble*.18
     time = np.arange(len(values)) / RATE
     values *= np.exp(-time / (.20 if variant == "bank" else .16))
-    attack = round(RATE * .0005)
+    attack = round(RATE * (.0012 if variant == "packed" else .0005))
     release = round(RATE * .045)
     values[:attack] *= np.linspace(0, 1, attack)
     values[-release:] *= np.linspace(1, 0, release)
@@ -96,6 +96,7 @@ def make_impact(clips, variant):
     values *= target / max(1e-8, np.sqrt(np.mean(values ** 2)))
     # A rounded, bounded compression adds density without clipping the master.
     values = .86 * np.tanh(values / .86)
+    if variant == "packed": values *= 10 ** (-1.5 / 20)
     values[0] = values[-1] = 0
     strong = np.flatnonzero(abs(values) >= max(abs(values)) * .5)[0] / RATE
     if strong > .005: raise ValueError("Original snow compression must begin within 5 ms")
@@ -149,8 +150,8 @@ def main():
     hit, strong = make_impact(clips, args.impact_variant)
     outputs = [write("snow", bed, True, [item["filename"] for item in records[:2]]),
                write("snow_hit", hit, False, variants[args.impact_variant]["sources"])]
-    manifest = {"schema": "vehicle-snow-audio-v1", "revision": 3, "rate": RATE, "channels": 1, "bits": 16,
-                "design": "Unchanged dense recorded soft-snow loop. Original layered snow entry combines peak-aligned compression, a slower 50-580 Hz recorded body and recorded crumble, rounded density control and a short release. No synthetic noise or tones; no Soundsnap samples used.",
+    manifest = {"schema": "vehicle-snow-audio-v1", "revision": 4, "rate": RATE, "channels": 1, "bits": 16,
+                "design": "Unchanged dense recorded soft-snow loop. Original layered entry retains its slow 50-580 Hz recorded body. Packed snow softens compression to 2400 Hz, reduces crumble from .30 to .16, rounds the attack to 1.2 ms and eases final level by 1.5 dB. Other variants remain exact. No synthetic noise or tones; no Soundsnap samples used.",
                 "impact_variant": args.impact_variant, "reference_audio_used": False,
                 "entry_strong_onset_ms": float(strong * 1000),
                 "license_verified_on": "2026-10-22", "sources": records, "outputs": outputs}
