+static func keep_join_planes(contours_in: Array[PackedVector2Array], cuts: Array[Dictionary], margin: float) -> Array[PackedVector2Array]:
+	if margin >= 0.0 or cuts.is_empty(): return contours_in
+	var result: Array[PackedVector2Array] = []
+	for source: PackedVector2Array in contours_in:
+		var polygon: PackedVector2Array = source.duplicate()
+		for cut: Dictionary in cuts:
+			var inward: Vector2 = cut.normal
+			var across: Vector2 = inward.orthogonal()
+			var retained := PackedByteArray()
+			retained.resize(polygon.size())
+			for i: int in range(polygon.size()):
+				var next: int = (i+1)%polygon.size()
+				var a: Vector2 = polygon[i]-Vector2(cut.point)
+				var b: Vector2 = polygon[next]-Vector2(cut.point)
+				# Match a whole cap edge, including an asymmetric wider corner.
+				# Restrict its midpoint to the existing local mouth-cut region.
+				if absf(a.dot(inward)+margin)<0.002 and absf(b.dot(inward)+margin)<0.002 and absf(((a+b)*0.5).dot(across)) <= float(cut.span)*0.5+1.0+absf(margin):
+					retained[i] = 1; retained[next] = 1
+			for i: int in range(polygon.size()):
+				if retained[i] != 0: polygon[i] -= inward*(polygon[i]-Vector2(cut.point)).dot(inward)
+		result.append(polygon)
+	return result
+
