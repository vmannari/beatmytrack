{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified time histogram",
  "type": "object",
  "required": ["board_id", "metric", "population", "minimum_ticks", "maximum_ticks", "bins"],
  "properties": {
    "board_id": {"type": "string"},
    "metric": {"enum": ["race", "best_lap"]},
    "population": {"type": "integer", "minimum": 0},
    "minimum_ticks": {"type": ["integer", "null"], "minimum": 1},
    "maximum_ticks": {"type": ["integer", "null"], "minimum": 1},
    "test_population": {"type": "boolean"},
    "label": {"type": "string"},
    "vehicle_id": {"type": "string"},
    "bins": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["from_ticks", "to_ticks_exclusive", "count"],
        "properties": {
          "from_ticks": {"type": "integer", "minimum": 1},
          "to_ticks_exclusive": {"type": "integer", "minimum": 2},
          "count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "120 Hz canonical ticks. Race uses one verified race PB per driver; best_lap uses each driver's shortest verified flying lap across comparable attempts. Standing lap excluded. Empty populations have null extrema and no bins. Public and development populations remain separate."
}
