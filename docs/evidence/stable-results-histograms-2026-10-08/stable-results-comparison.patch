+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "Atomic results comparison",
+  "type": "object",
+  "required": ["board_id", "population_scope", "stats_revision", "race", "best_lap"],
+  "properties": {
+    "board_id": {"type": "string", "minLength": 1},
+    "population_scope": {"enum": ["public", "development"]},
+    "stats_revision": {"type": "integer", "minimum": 0},
+    "race": {"$ref": "time-histogram-v1.schema.json"},
+    "best_lap": {"$ref": "time-histogram-v1.schema.json"}
+  },
+  "additionalProperties": false,
+  "description": "One database snapshot and pinned board for both charts. Exact candidate placement uses other drivers' verified personal bests, replacing a retained self entry. Candidate ticks are display-only and never write records. No opponents means null comparison. Top ten display position; remaining positions display the upward-rounded top-percent threshold."
