+    public_id = digest({"version_id": version.id, **pinned})
+    if test_population:
+        pinned = {**pinned, "test_population": True}
+    board_id = digest({"version_id": version.id, **pinned})
+    field = BoardTimeCount.all_count if test_population else BoardTimeCount.public_count
+    race_entries = select(BoardTimeCount.time_ticks, field.label("count")).where(
+        BoardTimeCount.board_id == board_id, field > 0).subquery()
+    laps = best_lap_times(board_id, session, test_population=test_population)
+    lap_entries = select(laps.c.time_ticks, func.count().label("count")).group_by(laps.c.time_ticks).subquery()
+    race_own = session.scalar(select(PersonalBest.time_ticks).where(
+        PersonalBest.board_id == board_id, PersonalBest.player_id == player.id))
+    lap_own = session.scalar(select(laps.c.time_ticks).where(laps.c.player_id == player.id))
+    race_best, lap_best = race_own, lap_own
