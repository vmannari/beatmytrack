new file mode 100644
--- /dev/null
+++ b/game/core/app_memory.gd
@@ -0,0 +1,44 @@
+extends RefCounted
+## Lazy budget boundary. Startup owns no native editor/race/garage presenter.
+## Delegate the unchanged accounting policy once optional native resources exist.
+const RETAINED_BUDGET: int = 64 * 1024 * 1024
+const GARAGE_BUDGET: int = 96 * 1024 * 1024
+const PRESSURE_HISTORY: int = 2 * 1024 * 1024
+var _policy: RefCounted
+var _pressure_requested: bool = false
+var _next_sample: int = 0
+var pressure_requested: bool:
+	get: return _policy.pressure_requested if _policy != null else _pressure_requested
+	set(value):
+		_pressure_requested = value
+		if _policy != null: _policy.pressure_requested = value
+var next_sample: int:
+	get: return _policy.next_sample if _policy != null else _next_sample
+	set(value):
+		_next_sample = value
+		if _policy != null: _policy.next_sample = value
+var telemetry: Dictionary:
+	get: return _policy.telemetry if _policy != null else {}
+var trims: int:
+	get: return _policy.trims if _policy != null else 0
+
+func tick(app: Node) -> void:
+	if _policy == null:
+		var loader: Node = app._garage_preloader
+		var native_garage: bool = is_instance_valid(app._retained_garage) or (is_instance_valid(loader) and loader.studio != null)
+		if not native_garage and not is_instance_valid(app.canvas) and not is_instance_valid(app.game):
+			# Cold shell has only bounded pictures/public asset reads. There is no
+			# optional native cache to evict and no reason to load one to trim it.
+			_pressure_requested = false
+			return
+		activate()
+	_policy.tick(app)
+
+func activate() -> void:
+	if _policy != null: return
+	_policy = load("res://editor/editor_memory.gd").new()
+	_policy.pressure_requested = _pressure_requested
+	_policy.next_sample = _next_sample
+
+static func retained(app: Node) -> Dictionary:
+	return load("res://editor/editor_memory.gd").retained(app)
diff --git a/game/ui/profile_car_renderer.gd b/game/ui/profile_car_renderer.gd
new file mode 100644
--- /dev/null
+++ b/game/ui/profile_car_renderer.gd
@@ -0,0 +1,62 @@
+extends RefCounted
+## Native renderer factory, loaded only for a missing authored picture.
+
+class ProfilePreview extends "res://ui/rivalry_victory_car.gd":
+	func _fit_camera() -> void:
+		var camera: Camera3D = viewport.get_camera_3d()
+		if camera == null: return
+		# Center the visible model rather than the podium's fixed world target.
+		# Translate in the camera plane to retain the Rivalry viewing angle.
+		var points := PackedVector3Array()
+		var view: Transform3D = camera.global_transform.affine_inverse()
+		var depth_range := Vector2(INF,-INF)
+		for mesh: Node in car.find_children("*","MeshInstance3D",true,false):
+			if not mesh.is_visible_in_tree() or mesh.mesh == null: continue
+			var bounds: AABB = mesh.get_aabb()
+			for x: float in [bounds.position.x,bounds.end.x]:
+				for y: float in [bounds.position.y,bounds.end.y]:
+					for z: float in [bounds.position.z,bounds.end.z]:
+						var point: Vector3 = view*mesh.to_global(Vector3(x,y,z))
+						points.append(point)
+						depth_range.x = minf(depth_range.x,-point.z)
+						depth_range.y = maxf(depth_range.y,-point.z)
+		if points.is_empty(): return
+		var shift := Vector2.ZERO
+		for _pass: int in range(4):
+			var low := Vector2(INF,INF)
+			var high := Vector2(-INF,-INF)
+			for point: Vector3 in points:
+				var projected: Vector2 = (Vector2(point.x,point.y)-shift)/maxf(0.01,-point.z)
+				low = low.min(projected)
+				high = high.max(projected)
+			shift += (low+high)*0.5*(depth_range.x+depth_range.y)*0.5
+		camera.position += camera.basis*Vector3(shift.x,shift.y,0)
+		super._fit_camera()
+
+static func make_preview(vehicle: String, paint: Dictionary, parts: Dictionary) -> Control:
+	var result := ProfilePreview.new()
+	result.name = "ProfileCarRender"
+	result.vehicle_id = vehicle
+	result.livery = paint.duplicate(true)
+	result.customisation = parts.duplicate(true)
+	result.simple_model = true
+	result.podium_presentation = true
+	result.fit_to_frame = true
+	return result
+
+static func apply_presentation(view: Control) -> void:
+	var environment: WorldEnvironment = view.viewport.find_child("PodiumReflectionEnvironment",true,false)
+	environment.environment.ambient_light_energy = 0.7
+	var fill := DirectionalLight3D.new()
+	fill.name = "ProfileReadabilityFill"
+	fill.light_energy = 0.65
+	fill.rotation = view.viewport.get_camera_3d().rotation
+	view.car.get_parent().add_child(fill)
+	view._refresh()
+
+static func repaint_preview(view: Control, paint: Dictionary) -> void:
+	# Icon batches retain geometry, camera, lights and radiance. Only paint changes.
+	view.livery = paint.duplicate(true)
+	view.car.apply_livery(paint)
+	if view.car.vehicle_id!="compact":
+		preload("res://ui/rivalry_podium_studio.gd")._garage_paint(view.car)
