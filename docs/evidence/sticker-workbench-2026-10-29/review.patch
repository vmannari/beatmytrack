+"""Original Pit Creatures sticker illustrations, drawn as editable SVG paths.
+
+Small racing stories replace the former generic emblem collection. No downloaded
+art, installed fonts, trademark shapes, raster tracing, or generation service.
+The stable IDs belong to saved liveries; the public titles describe the new art.
+"""
+
+INK = '#1d2a35'
+PAPER = '#f7eedc'
+CORAL = '#df7656'
+TEAL = '#64aaa1'
+BLUE = '#7184ae'
+GOLD = '#dfb64f'
+OLIVE = '#94a465'
+
+
+def ink(d, colour, width=4):
+    return (f'<path d="{d}" fill="{colour}" stroke="{INK}" '
+            f'stroke-width="{width}" stroke-linecap="round" stroke-linejoin="round"/>')
+
+
+def cut(d, colour):
+    return (f'<path d="{d}" fill="{PAPER}" stroke="{PAPER}" '
+            'stroke-width="14" stroke-linejoin="round"/>' + ink(d, colour))
+
+
+def line(d, colour=INK, width=4):
+    return (f'<path d="{d}" fill="none" stroke="{colour}" '
+            f'stroke-width="{width}" stroke-linecap="round" stroke-linejoin="round"/>')
+
+
+def dot(x, y, r, colour=INK):
+    return f'<circle cx="{x}" cy="{y}" r="{r}" fill="{colour}"/>'
+
+
