diff --git a/scripts/build_storm_rain.py b/scripts/build_storm_rain.py
--- /dev/null
+++ b/scripts/build_storm_rain.py
@@ -0,0 +1,83 @@
+"""Fetch/master a cleared field-recorded rain loop; build tools only."""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import struct
+import urllib.request
+import wave
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "build/storm_rain_sources"
+OUT = ROOT / "game/assets/audio/ambience"
+PAGE = "https://bigsoundbank.com/rain-on-concrete-s1289.html"
+MEDIA = "https://bigsoundbank.com/UPLOAD/bwf-en/1289.wav"
+RATE = 44100
+SOURCE_SHA256 = "e4876e37514c40728637c6caaed6068209c00f77b80557752f237bb02c7bdbef"
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--fetch", action="store_true")
+    args = parser.parse_args()
+    SOURCE.mkdir(parents=True, exist_ok=True)
+    master = SOURCE / "rain-1289.wav"
+    if args.fetch:
+        html = urllib.request.urlopen(PAGE, timeout=30).read()
+        if b"CC0" not in html or b"Joseph SARDIN" not in html:
+            raise ValueError("Expected CC0 recording/author metadata")
+        (SOURCE / "license.html").write_bytes(html)
+        if not master.exists():
+            master.write_bytes(urllib.request.urlopen(MEDIA, timeout=45).read())
+    data = master.read_bytes()
+    if hashlib.sha256(data).hexdigest()!=SOURCE_SHA256:
+        raise ValueError("Rain source hash changed; review the source before rebuilding")
+    pos = 12
+    while pos + 8 <= len(data):
+        kind, count = struct.unpack_from("<4sI", data, pos)
+        body = data[pos+8:pos+8+count]
+        if kind == b"fmt ":
+            fmt, channels, rate, _, _, bits = struct.unpack_from("<HHIIHH", body)
+            if fmt == 65534: fmt = struct.unpack_from("<H", body, 24)[0]
+        elif kind == b"data": pcm = body
+        pos += 8 + count + (count & 1)
+    if fmt != 1 or bits not in [16,24]: raise ValueError("Expected recorded PCM")
+    if bits == 24:
+        raw = np.frombuffer(pcm,dtype=np.uint8).reshape(-1,3).astype(np.int32)
+        ints = raw[:,0] | (raw[:,1]<<8) | (raw[:,2]<<16)
+        values = ((ints ^ 0x800000)-0x800000)/8388608.0
+    else: values = np.frombuffer(pcm,dtype='<i2').astype(np.float64)/32768.0
+    values = values.reshape(-1,channels).mean(axis=1)
+    values = values[round(20*rate):round(40*rate)]
+    coordinates = np.arange(round(len(values)*RATE/rate),dtype=np.float64)*rate/RATE
+    values = np.interp(coordinates,np.arange(len(values),dtype=np.float64),values)
+    hz = np.fft.rfftfreq(len(values),1/RATE)
+    spectrum = np.fft.rfft(values)
+    spectrum *= (1-np.exp(-(hz/140)**4))*np.exp(-(hz/6500)**4)
+    values = np.fft.irfft(spectrum,n=len(values))
+    # Tame close-microphone drop transients so isolated drops do not set the
+    # entire loop's quietness or punctuate the background with sharp knocks.
+    values = np.tanh(values/max(np.sqrt(np.mean(values**2))*3.0,1e-8))
+    overlap = RATE
+    ramp = .5-.5*np.cos(np.linspace(0,np.pi,overlap))
+    joined = values[-overlap:]*(1-ramp)+values[:overlap]*ramp
+    values = np.concatenate([values[overlap:-overlap],joined])
+    values -= values.mean()
+    values *= min(.08/max(np.sqrt(np.mean(values**2)),1e-8),.5/max(np.max(np.abs(values)),1e-8))
+    pcm = np.rint(values*32767).astype('<i2')
+    OUT.mkdir(parents=True,exist_ok=True)
+    target = OUT/'storm_rain_recorded.wav'
+    with wave.open(str(target),'wb') as handle:
+        handle.setnchannels(1); handle.setsampwidth(2); handle.setframerate(RATE)
+        handle.writeframes(pcm.tobytes())
+    settings = target.with_suffix('.wav.import')
+    if not settings.exists(): settings.write_text('[remap]\nimporter="wav"\ntype="AudioStreamWAV"\n\n[params]\ncompress/mode=0\n',encoding='utf-8')
+    manifest = dict(file=target.name,source=PAGE,download=MEDIA,author='Joseph SARDIN',license='CC0-1.0',
+        source_sha256=hashlib.sha256(data).hexdigest(),sha256=hashlib.sha256(target.read_bytes()).hexdigest(),
+        rate=RATE,channels=1,bits=16,seconds=len(pcm)/RATE,bytes=target.stat().st_size,
+        edits='20-40s recording; mono; 44.1kHz; 140Hz-6.5kHz softening; soft drop-transient limiting; 1s cyclic crossfade; RMS .08, peak cap .5',
+        rms_dbfs=float(20*np.log10(np.sqrt(np.mean(values**2)))),peak_dbfs=float(20*np.log10(np.max(np.abs(values)))))
+    (OUT/'storm_rain_manifest.json').write_text(json.dumps(manifest,indent=2)+'\n',encoding='utf-8')
+    print(json.dumps(manifest,indent=2))
+
+if __name__ == '__main__': main()
diff --git a/scripts/review_storm_audio_balance.py b/scripts/review_storm_audio_balance.py
--- /dev/null
+++ b/scripts/review_storm_audio_balance.py
@@ -0,0 +1,58 @@
+"""Actual native mix levels and loop/silence checks for the storm correction."""
+from pathlib import Path
+import hashlib
+import json
+import math
+import wave
+import numpy as np
+from test_vehicle_audio_continuity import measure
+
+ROOT=Path(__file__).resolve().parents[1]
+OUT=ROOT/'docs/evidence/storm-audio-balance-2026-10-09'
+report={'captures':[],'failures':[]}
+def read(path):
+    with wave.open(str(path)) as handle:
+        rate=handle.getframerate(); channels=handle.getnchannels()
+        assert handle.getsampwidth()==2
+        pcm=np.frombuffer(handle.readframes(handle.getnframes()),dtype='<i2').astype(np.float64)/32768.0
+    return pcm.reshape(-1,channels),rate
+def db(values): return 20*math.log10(max(float(np.sqrt(np.mean(values**2))),1e-9))
+for scene in ['cruise-before','cruise-after','fast-after','formula-after','stopped','paused','rain-loop']:
+    row={'scene':scene}
+    for layer in ['mix','engine','wet','rain']:
+        pcm,rate=read(OUT/(scene+'-'+layer+'.wav'))
+        body=pcm[round(.15*rate):-round(.15*rate)]
+        row[layer+'_dbfs']=db(body)
+        row[layer+'_peak']=float(np.max(np.abs(body)))
+        if row[layer+'_peak']>=.95: report['failures'].append('Clipping/headroom: '+scene+' '+layer)
+        if scene=='paused' and row[layer+'_peak']!=0: report['failures'].append('Pause should be digitally silent: '+layer)
+        if layer=='wet' and scene in ['stopped','rain-loop'] and row[layer+'_peak']!=0: report['failures'].append('Stationary wet road should be silent')
+        if layer=='rain' and scene!='paused' and row[layer+'_dbfs'] < -65: report['failures'].append('Foreground background rain must be present: '+scene)
+    if scene in ['cruise-after','fast-after','formula-after']:
+        row['wet_relative_engine_db']=row['wet_dbfs']-row['engine_dbfs']
+        row['rain_relative_wet_db']=row['rain_dbfs']-row['wet_dbfs']
+        if row['wet_relative_engine_db'] < -10: report['failures'].append('Wet rolling too far below engine: '+scene)
+        if row['rain_relative_wet_db'] > -12: report['failures'].append('Rain should be substantially quieter than rolling: '+scene)
+    report['captures'].append(row)
+boost=report['captures'][1]['wet_dbfs']-report['captures'][0]['wet_dbfs']
+report['measured_wet_gain_db']=boost
+if not 9.0<boost<10.2: report['failures'].append('Native before/after rolling gain should be about 9.5dB')
+pcm,rate=read(OUT/'rain-loop-rain.wav')
+report['native_rain_continuity']=measure(pcm,rate)
+if report['native_rain_continuity']['maximum_dropout_ms']>=100: report['failures'].append('Native rain contains a sustained gap')
+bank=json.loads((OUT/'before/bank-hashes.json').read_text())
+report['preserved_vehicle_clips']=len(bank)
+for name,digest in bank.items():
+    if hashlib.sha256((ROOT/'game/assets/audio/vehicles'/name).read_bytes()).hexdigest()!=digest:
+        report['failures'].append('Existing vehicle WAV changed: '+name)
+manifest=json.loads((ROOT/'game/assets/audio/ambience/storm_rain_manifest.json').read_text())
+sample=ROOT/'game/assets/audio/ambience/storm_rain_recorded.wav'
+if hashlib.sha256(sample.read_bytes()).hexdigest()!=manifest['sha256']: report['failures'].append('Rain manifest hash mismatch')
+pcm,rate=read(sample)
+report['rain_asset_continuity']=measure(np.tile(pcm,(3,1)),rate)
+if report['rain_asset_continuity']['maximum_dropout_ms']>=100: report['failures'].append('Rain asset contains a sustained gap')
+(OUT/'review.json').write_text(json.dumps(report,indent=2)+'\n',encoding='utf-8')
+cards=''.join('<article><h2>'+label+'</h2><audio controls preload="metadata" src="'+name+'.wav"></audio></article>' for label,name in [('Previous wet level + quiet rain','cruise-before-mix'),('Stronger wet tires + quiet rain','cruise-after-mix'),('Faster driving','fast-after-mix'),('Formula car','formula-after-mix'),('Rain at the shipping background level','rain-loop-rain')])
+(OUT/'review.html').write_text('<!doctype html><meta charset="utf-8"><title>Storm audio balance</title><style>body{background:#111b2b;color:#eee;font:18px system-ui;max-width:900px;margin:40px auto}article{padding:16px;margin:12px 0;background:#1c2b40}h2{margin:0 0 10px}audio{width:100%}</style><h1>Wet tires and quiet rain</h1><p>Native engine/tire/rain mix at 57.6 and 115.2 km/h. Music is excluded. The rain recording is Joseph SARDIN\'s CC0 Rain on concrete from BigSoundBank.</p>'+cards,encoding='utf-8')
+print(json.dumps(report,indent=2))
+raise SystemExit(bool(report['failures']))
diff --git a/game/tests/capture_storm_audio_balance.gd b/game/tests/capture_storm_audio_balance.gd
--- /dev/null
+++ b/game/tests/capture_storm_audio_balance.gd
@@ -0,0 +1,106 @@
+extends SceneTree
+## Same-clock engine, wet tire, quiet rain and complete native mixer references.
+const OUT: String = "res://../docs/evidence/storm-audio-balance-2026-10-09"
+var checks: int = 0
+var failures: int = 0
+
+func _initialize() -> void: call_deferred("run")
+func check(ok: bool, message: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		print("FAIL: "+message)
+
+func run() -> void:
+	check(DisplayServer.get_name()!="headless","actual audio driver required")
+	if DisplayServer.get_name()=="headless":
+		quit(1)
+		return
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT))
+	var track: NativeTrack = NativeTrack.read("res://resources/tracks/starter_circuit.json")
+	track.metadata.theme = "storm"
+	track.cells.fill(0)
+	var audio := VehicleAudio.new()
+	audio.use_windows_impacts = false
+	root.add_child(audio)
+	var full_wet: AudioStreamWAV = audio._stream("wet_road",true)
+	var baseline_wet: AudioStreamWAV = full_wet.duplicate()
+	var baseline_pcm: PackedByteArray = baseline_wet.data
+	for offset: int in range(0,baseline_pcm.size(),2):
+		baseline_pcm.encode_s16(offset,roundi(float(baseline_pcm.decode_s16(offset))/3.0))
+	baseline_wet.data = baseline_pcm
+	var weather := StormWeather.new()
+	root.add_child(weather)
+	weather.until_lightning = 9999.0
+	var buses: Array[int] = [0,AudioServer.get_bus_index("Engine")]
+	for label: String in ["WetRoadReview","RainReview"]:
+		var bus: int = AudioServer.get_bus_count()
+		AudioServer.add_bus()
+		AudioServer.set_bus_name(bus,label)
+		AudioServer.set_bus_send(bus,"Tires" if label=="WetRoadReview" else "Vehicle")
+		buses.append(bus)
+	(audio.layers.road as AudioStreamPlayer).bus = "WetRoadReview"
+	weather.rain_audio.bus = "RainReview"
+	var records: Array[AudioEffectRecord] = []
+	for bus: int in buses:
+		var record := AudioEffectRecord.new()
+		record.format = AudioStreamWAV.FORMAT_16_BITS
+		AudioServer.add_bus_effect(bus,record)
+		records.append(record)
+	var names: Array[String] = ["mix","engine","wet","rain"]
+	var rows: Array[Dictionary] = []
+	for scene: String in ["cruise-before","cruise-after","fast-after","formula-after","stopped","paused","rain-loop"]:
+		# The only old/new wet difference is a factor of three. Apply its inverse
+		# to this private PCM copy for a stable old-level reference, avoiding
+		# temporary volume writes racing the audio thread between present calls.
+		audio.streams.wet_road = baseline_wet if scene=="cruise-before" else full_wet
+		audio.configure("formula" if scene=="formula-after" else "compact",VehicleCatalog.config("formula" if scene=="formula-after" else "compact"))
+		var state := VehicleState.new()
+		state.position = track.spawn
+		state.velocity = Vector2(0,32 if scene in ["fast-after","formula-after"] else 16)
+		if scene in ["stopped","rain-loop"]: state.velocity = Vector2.ZERO
+		var input := DriveFrame.sample(0,0.7,0)
+		# This fixture models foreground driving; external test windows can
+		# steal actual desktop focus. Focus suspension is checked separately.
+		weather._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
+		for tick: int in range(30):
+			audio.present(state,input,track,.05,scene=="paused")
+			weather.advance(.05,scene=="paused")
+		# Compare identical source regions; other phases may have left the player
+		# at a different cursor despite the same held presentation state.
+		(audio.layers.road as AudioStreamPlayer).play(0.0)
+		await create_timer(.25).timeout
+		for record: AudioEffectRecord in records: record.set_recording_active(true)
+		var elapsed: float = 0.0
+		var last_us: int = Time.get_ticks_usec()
+		var previous_cursor: float = weather.rain_audio.get_playback_position()
+		var wraps: int = 0
+		while elapsed<(21.0 if scene=="rain-loop" else 7.0 if scene in ["cruise-before","cruise-after"] else 3.0):
+			await process_frame
+			var now: int = Time.get_ticks_usec()
+			var dt: float = float(now-last_us)/1000000.0
+			last_us = now
+			elapsed += dt
+			state.tick += 1
+			weather._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
+			audio.present(state,input,track,dt,scene=="paused")
+			weather.advance(dt,scene=="paused")
+			var cursor: float = weather.rain_audio.get_playback_position()
+			if cursor+.5<previous_cursor: wraps += 1
+			previous_cursor = cursor
+		for i: int in range(records.size()):
+			records[i].set_recording_active(false)
+			check(records[i].get_recording().save_to_wav(OUT.path_join(scene+"-"+names[i]+".wav"))==OK,"native reference: "+scene+" "+names[i])
+		if scene=="rain-loop": check(wraps>=1,"continuous recorded rain crosses a real playback wrap")
+		rows.append({"scene":scene,"speed_mps":state.velocity.length(),"road_gain":audio.levels.road,"rain_gain":weather.rain_gain,"rain_wraps":wraps,"foreground_fixture":not weather.suspended})
+	var report := FileAccess.open(OUT.path_join("capture.json"),FileAccess.WRITE)
+	report.store_string(JSON.stringify(rows,"\t")+"\n")
+	report.close()
+	audio.free()
+	weather.free()
+	await create_timer(.15).timeout
+	for bus: int in buses: AudioServer.remove_bus_effect(bus,AudioServer.get_bus_effect_count(bus)-1)
+	AudioServer.remove_bus(buses[3])
+	AudioServer.remove_bus(buses[2])
+	print("STORM_AUDIO_BALANCE_CAPTURE: %d checks, %d failures"%[checks,failures])
+	quit(1 if failures>0 else 0)
