+backend=Path('/app/bmt_backend');game=Path('/opt/bmt');source=Path('/tmp/expansion-source')
+old=hashes(backend);canonical=hashes(game);expected=json.loads(Path('/tmp/expansion-expected.json').read_text())
+for name,value in expected.items():
+ p=source/name;assert hashlib.sha256(p.read_bytes()).hexdigest()==value
+ target=backend/name;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,target)
+new=hashes(backend);changed=sorted(name for name,value in new.items() if old.get(name)!=value)
+assert changed==sorted(expected);assert hashes(game)==canonical
+assert all(new[k]==v for k,v in old.items() if k not in changed)
+sys.path.insert(0,'/app')
+from bmt_backend.config import Settings
+from bmt_backend.app import create_app
+from bmt_backend.migrate import upgrade,SCHEMA_HEAD
+from bmt_backend.cloud_smoke import check_comparison_route
+assert SCHEMA_HEAD=='0027_client_quality'
+a=create_app(Settings(environment='test',database_url='sqlite://',telemetry_enabled=True,client_quality_enabled=True))
