+def patch_saved(name):
+    before = (ROOT / 'build/studio-expansion-2026-10-11/before' / ('backend__bmt_backend__'+name.replace('/','__'))).read_text(encoding='utf-8')
+    after = (ROOT / 'backend/bmt_backend' / name).read_text(encoding='utf-8')
+    source = (WORK / 'parent' / name).read_text(encoding='utf-8')
+    # Apply each unique before/after context to the deployed file, preserving any
+    # unrelated differences between the deployed parent and the dirty workspace.
+    matcher = difflib.SequenceMatcher(None,before.splitlines(True),after.splitlines(True),autojunk=False)
+    for group in matcher.get_grouped_opcodes(3):
+        old = ''.join(before.splitlines(True)[group[0][1]:group[-1][2]])
+        new = ''.join(after.splitlines(True)[group[0][3]:group[-1][4]])
+        assert source.count(old)==1, 'Ambiguous deployed-parent patch: '+name
+        source = source.replace(old,new,1)
+    return source
+
+
+def prepare():
+    assert tp.receipt.get('parent_extracted') and not CONTEXT.exists()
+    manifest = json.loads((ROOT/'docs/evidence/studio-expansion-2026-10-11/checkpoint.json').read_text())
+    frozen = {v['path']:v['after_sha256'] for v in manifest['files']}
+    for name in DIRECT+PATCHED+['app.py','migrations/env.py']:
+        path=ROOT/'backend/bmt_backend'/name
+        assert tp.digest(path.read_bytes())==frozen['backend/bmt_backend/'+name], 'Workspace source changed since reviewed checkpoint: '+name
+    CONTEXT.mkdir()
+    expected={}
+    def write(name,value):
+        compile(value,name,'exec') if name.endswith('.py') else None
+        path=CONTEXT/'source'/name;path.parent.mkdir(parents=True,exist_ok=True)
+        path.write_text(value,encoding='utf-8',newline='\n');expected[name]=tp.digest(path.read_bytes())
+    for name in DIRECT:
+        write(name,(ROOT/'backend/bmt_backend'/name).read_text(encoding='utf-8'))
+    for name in PATCHED:
+        write(name,patch_saved(name))
+    source=(WORK/'parent/app.py').read_text(encoding='utf-8')
+    source=tp.replace_once(source,'    from . import telemetry, product_analytics\n',
+        '    from . import telemetry, product_analytics, quality, studio_cases, studio_competitions\n')
+    source=tp.replace_once(source,'    app.include_router(product_analytics.router)\n',
