+"""Exact-image regression using saved parent tests plus reviewed expansion tests."""
+import importlib.util
+import json
+import shutil
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[1]
+spec=importlib.util.spec_from_file_location('expansion_exact_tests',ROOT/'.tools/product_telemetry_image_tests_20261011.py')
+tests=importlib.util.module_from_spec(spec);spec.loader.exec_module(tests)
+tests.CONTEXT=ROOT/'build/studio-expansion-deploy-2026-10-11/image'
+tests.WORK=tests.CONTEXT.parent/'acceptance';tests.WORK.mkdir(parents=True,exist_ok=True)
+tests.OUTPUT=ROOT/'docs/evidence/studio-expansion-deploy-2026-10-11'
+tests.ROLLOUT=tests.OUTPUT/'rollout.json'
+ADDED=['test_studio_operations.py','test_studio_moderation.py','test_studio_expansion_postgres.py','test_client_quality.py','test_provider_proofs.py']
+tests.SELECTED += ADDED
+parent=ROOT/'build/product-telemetry-deploy-2026-10-11/acceptance'
+destination=tests.WORK/'frozen-tests'
+if not destination.exists():
+    shutil.copytree(parent/'frozen-tests',destination)
+    checkpoint=json.loads((ROOT/'docs/evidence/studio-expansion-2026-10-11/checkpoint.json').read_text())
+    frozen={v['path']:v['after_sha256'] for v in checkpoint['files']}
+    for name in ADDED:
+        source=ROOT/'backend/tests'/name
+        assert tests.hashes(source.parent)[name]==frozen['backend/tests/'+name]
+        shutil.copyfile(source,destination/name)
+for name in ['candidate-browser-server.py','candidate-maintenance-check.py','product_console.py']:
+    source=parent/name;target=tests.WORK/name
+    if not target.exists():shutil.copyfile(source,target)
+if __name__=='__main__':tests.main()
