+            request_hash="a" * 64, authoring_id="alarm-fixture", name="Failed publication",
+            content_hash="b" * 64, replay_hash="c" * 64, vehicle_id="compact", contract={},
+            status="failed", created_at=AT-600, finished_at=AT-1)
