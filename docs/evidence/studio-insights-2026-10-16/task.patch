+'use strict';
+const alarmLabels={open:'Needs action',acknowledged:'Acknowledged',recovered:'Ready to clear',cleared:'Cleared',unknown:'Check unavailable',inactive:'No active condition'};
+let alarmWorkspace=null;
+function insightSourceError(error){if(error.name==='AbortError'||error.status===401)throw error;return {error:error.message};}
+function alarmCounts(data){
+ const items=data?.items||[],active=items.filter(item=>item.active===true);
+ return {active:active.length,critical:active.filter(item=>item.severity==='critical').length,
+  open:items.filter(item=>item.status==='open').length,acknowledged:items.filter(item=>item.status==='acknowledged').length,
+  recovered:items.filter(item=>item.status==='recovered').length,unknown:data?.unknown_checks||0};
+}
+function alarmBadge(item){return `<span class="alarm-badge ${item.active?esc(item.severity):'neutral'}">${item.active?esc(item.severity):item.active===null?'Unknown':item.status==='inactive'?'Inactive':'Recovered'}</span>`;}
