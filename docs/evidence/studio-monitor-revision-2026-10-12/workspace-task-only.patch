+}
+function catalogueBackHref(section,params) {
+ const target=params.get('catalogue_return');
+ return target&&target.startsWith(section+'?')&&target.length<2500?'#'+esc(target):scopedHref(section,params);
+}
+function catalogueHref(section, params, extra={}) {
