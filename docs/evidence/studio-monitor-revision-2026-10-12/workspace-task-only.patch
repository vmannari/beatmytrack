+"""Current monitor/publication/diagnostic tests in a newly owned PostgreSQL17."""
+import argparse
+import json
+import os
+import secrets
+import socket
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[1]
+
+
