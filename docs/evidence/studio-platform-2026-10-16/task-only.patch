+            settings.studio_monitor_webhook_url,
+            data=raw,
+            headers={
+                "Content-Type": "application/json",
+                "Idempotency-Key": identity,
+                "X-BMT-Timestamp": str(at),
+                "X-BMT-Signature": signature,
+            },
+            timeout=10,
+            allow_redirects=False,
