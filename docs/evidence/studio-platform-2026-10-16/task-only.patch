+                                "race_finished": 2,
+                                "race_accepted": 2,
+                                "foreground_ms": 180000,
+                                "quality_attempts": 3,
+                                "quality_slow_frames": 40,
+                            },
+                        )
+                    )
+            for build, races, slow in [("release-a", 20, 40), ("release-b", 10, 10)]:
+                db.add(
+                    RaceStatisticsDay(
+                        day=day,
+                        dimension=digest({"build": build}),
+                        track_version_id=fixture["version_id"],
+                        build_id=build,
+                        platform="android",
