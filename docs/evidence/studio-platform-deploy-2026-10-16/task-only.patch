+report_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+
+files = [".tools/studio_platform_rollout_20261016.py", ".tools/studio_platform_release_diagnostics.py",
+         ".tools/studio_platform_deploy_evidence_20261016.py", "docs/STUDIO_PLATFORM_DEPLOY_2026_10_16.md"]
+patch, hashes = [], {}
+for name in [*files, *additions]:
+    current = (ROOT / name).read_text(encoding="utf-8")
+    original = current.replace(additions[name], "", 1) if name in additions else ""
+    patch += difflib.unified_diff(original.splitlines(True), current.splitlines(True),
+        fromfile="a/" + name if original else "/dev/null", tofile="b/" + name)
+    hashes[name] = hashlib.sha256((ROOT / name).read_bytes()).hexdigest()
+(OUT / "task-only.patch").write_text("".join(patch), encoding="utf-8", newline="\n")
+(OUT / "checkpoint-files.json").write_text(json.dumps(hashes, indent=2) + "\n", encoding="utf-8")
+print(json.dumps({"completed": True, "schema": receipt["schema"], "checkpoint_files": len(hashes), "report": str(report_path.relative_to(ROOT))}))
