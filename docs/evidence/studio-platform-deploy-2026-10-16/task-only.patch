+        "unconfigured; this rollout does not establish continuous monitoring or live provider integration.\n",
+}
+for name, addition in additions.items():
+    path = ROOT / name
+    value = path.read_text(encoding="utf-8")
+    if addition in value:
+        continue
+    if name == "DEVELOPMENT_STATUS.md":
+        value = addition + value
+    else:
+        position = value.index("\n") + 1
+        value = value[:position] + addition + value[position:]
+    path.write_text(value, encoding="utf-8", newline="\n")
+
+report_path = OUT / "report.json"
+report = json.loads(report_path.read_text())
+report["remaining"].append("Initial PG legacy friend-publication empty-feed deviation was not reproduced in20 paired isolated repetitions or the128-pass image rerun; root cause is not established")
