+with e.connect() as c:
+ c.execute(text('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY'))
+ stats={t:c.execute(text('SELECT count(*) FROM '+t)).scalar() for t in ['players','product_events','studio_analysis_people','runs','studio_incidents','studio_finance_events']}
+ templates=c.execute(text("SELECT b.id,b.version_id,b.vehicle_id,b.manifest,count(*) AS samples,min(r.time_ticks) AS best FROM runs r JOIN boards b ON b.id=r.board_id WHERE r.status='verified' AND r.time_ticks>0 GROUP BY b.id ORDER BY samples DESC LIMIT 16")).mappings().all()
+ print('LATEST_RESULT='+json.dumps({'counts':stats,'templates':[dict(r) for r in templates]}))
+e.dispose()
+'''
+    result=d.execute('initial-data',code)
+    print(json.dumps({'counts':result['counts'],'recording_templates':[{'samples':r['samples'],'physics':r['manifest'].get('physics_version'),'test_board':bool(r['manifest'].get('test_population'))} for r in result['templates']]}))
+
+def prepare():
+    assert not d.CONTEXT.exists();d.CONTEXT.mkdir()
+    files={}
+    for name in ['studio_simulator.py','studio_simulator_scenarios.py']:
+        source=ROOT/'backend/bmt_backend'/name
+        (d.CONTEXT/name).write_bytes(source.read_bytes());files[name]=d.digest(source.read_bytes())
+    frozen=d.WORK/'tests';shutil.copytree(ROOT/'backend/tests',frozen,ignore=shutil.ignore_patterns('__pycache__'))
+    (d.CONTEXT/'Dockerfile').write_text('FROM '+d.r['parent']+'\nUSER root\nCOPY studio_simulator.py studio_simulator_scenarios.py /app/bmt_backend/\nUSER 10001:10001\n',encoding='utf-8')
+    d.r['source_hash']=d.digest(json.dumps(files,sort_keys=True).encode());d.r['files']=files;d.save()
+    print(json.dumps({'module_files':files,'parent':d.r['parent']}))
+
+def build():
+    assert all(d.digest((d.CONTEXT/name).read_bytes())==sha for name,sha in d.r['files'].items())
+    b=d.builder();tag='bmt-studio-simulator:'+d.r['source_hash'][:16]
+    output=b.runner.run([*b.c['docker'],'build','--network=none','--pull=false','--file=image/Dockerfile','--tag='+tag,'image'])
+    (d.WORK/'build.private.log').write_text(output,encoding='utf-8')
+    code='import json;from bmt_backend.migrate import SCHEMA_HEAD;from bmt_backend.studio_simulator import Plan;assert SCHEMA_HEAD=="0040_studio_platform";print(json.dumps({"schema":SCHEMA_HEAD,"simulator_import":True}))'
+    print(b.runner.run([*b.c['docker'],'run','--rm','--network=none','--entrypoint=python',tag,'-c',code]))
