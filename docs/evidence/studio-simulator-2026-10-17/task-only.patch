+def identity(*parts):
+    """Stable UUID4-shaped receipt IDs, accepted by the real telemetry contracts."""
+    return str(
+        UUID(bytes=hashlib.sha256(json.dumps(parts, separators=(",", ":")).encode()).digest()[:16], version=4)
+    )
+
