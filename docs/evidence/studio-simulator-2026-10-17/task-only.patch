+    (d.CONTEXT/'Dockerfile').write_text('FROM '+d.r['parent']+'\nUSER root\nCOPY studio_simulator.py studio_simulator_scenarios.py race_statistics.py /app/bmt_backend/\nUSER 10001:10001\n',encoding='utf-8')
+    for name in ['test_studio_simulator.py','test_race_statistics.py']:
+        shutil.copyfile(ROOT/'backend/tests'/name,d.WORK/'tests'/name)
+    d.r['source_hash']=d.digest(json.dumps(d.r['files'],sort_keys=True).encode());d.save()
+    lock=d.DIRECTORY/'update.lock';value=json.loads(lock.read_text())
+    assert value['source_hash']==d.r['previous_source_hash'] and value['task']=='latest-backend-ui-20261016'
+    lock.write_text(json.dumps({**value,'source_hash':d.r['source_hash']}))
+    print(json.dumps({'uuid_fix_prepared':True,'failed_execution_recorded':d.r['failed_execution']}))
+
+def sync_fixed():
