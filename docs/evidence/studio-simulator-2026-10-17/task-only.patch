+    d.r['files']={name:d.digest((d.CONTEXT/name).read_bytes()) for name in d.r['files']}
+    d.r['source_hash']=d.digest(json.dumps(d.r['files'],sort_keys=True).encode());d.r.pop('exact_image_tests',None);d.save()
+    lock=d.DIRECTORY/'update.lock';value=json.loads(lock.read_text());assert value['source_hash']==old_hash
+    lock.write_text(json.dumps({**value,'source_hash':d.r['source_hash']}))
+    print(json.dumps({'fixed_source_frozen':d.r['source_hash']}))
+
+def test():
+    import secrets,time
+    b=d.builder();docker=b.c['docker'];suffix=secrets.token_hex(4);pg='bmt-studio-sim-pg-'+suffix;network='bmt-studio-sim-test-'+suffix
+    owner=d.config['owner'];password=secrets.token_urlsafe(24)
+    b.runner.run([*docker,'network','create','--internal','--label=bmt.simulator-owner='+owner,network]);created=False
+    try:
+        b.runner.run([*docker,'run','--rm','-d','--name='+pg,'--network='+network,'--label=bmt.simulator-owner='+owner,
+            '-e','POSTGRES_USER=sim_test','-e','POSTGRES_DB=sim_test','-e','POSTGRES_PASSWORD='+password,'postgres:17']);created=True
+        for _ in range(30):
+            try:output=b.runner.run([*docker,'exec',pg,'pg_isready','-U','sim_test'])
+            except RuntimeError:output=''
+            if 'accepting connections' in output:break
+            time.sleep(.3)
+        else:raise RuntimeError('Owned simulator test database did not become ready')
+        tests='/mnt/'+d.WORK.drive[0].lower()+d.WORK.as_posix()[2:]+'/tests'
+        code=[*docker,'run','--rm','--network='+network,'--label=bmt.simulator-owner='+owner,'--entrypoint=python',
+            '--mount=type=bind,source='+tests+',target=/test-work/backend/tests,readonly','-e','PYTHONPATH=/app:/test-work/backend/tests',
+            '-e','BMT_TEST_DATABASE_URL=postgresql+psycopg://sim_test:'+password+'@'+pg+':5432/sim_test',d.r['local_tag'],
+            '-m','pytest','/test-work/backend/tests/test_studio_simulator.py',
+            '/test-work/backend/tests/test_race_statistics.py','-q','--tb=short','--show-capture=no','-c','/app/pyproject.toml','-o','cache_dir=/tmp/sim-pytest']
+        output=b.runner.run(code);(d.OUTPUT/'exact-image-tests.log').write_text(output+'\n',encoding='utf-8')
+        d.r['exact_image_tests']=True;d.save();print(output[-1800:])
+    finally:
+        if created:
+            labels=json.loads(b.runner.run([*docker,'inspect',pg,'--format={{json .Config.Labels}}']));assert labels.get('bmt.simulator-owner')==owner
+            b.runner.run([*docker,'stop',pg])
+        labels=json.loads(b.runner.run([*docker,'network','inspect',network,'--format={{json .Labels}}']));assert labels.get('bmt.simulator-owner')==owner
+        b.runner.run([*docker,'network','rm',network])
+
+def preserve(stage):
+    code='''import hashlib,json
+from uuid import UUID
+from sqlalchemy import inspect,text,bindparam
+from bmt_backend.config import Settings
+from bmt_backend.db import make_engine
+e=make_engine(Settings.from_env().database_url)
+ids=[str(UUID(bytes=hashlib.sha256(json.dumps(('studio-october','player',i),separators=(',',':')).encode()).digest()[:16],version=4)) for i in range(600)]
+with e.connect() as c:
+ c.execute(text('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY'));i=inspect(c);result={}
+ for table,field in [('players','id'),('identities','player_id'),('tracks','owner_id'),('track_versions',None),('runs','player_id'),('personal_bests','player_id'),('lap_personal_bests','player_id'),('purchases','player_id'),('resume_wallets','player_id')]:
+  order=i.get_pk_constraint(table)['constrained_columns'];query='SELECT * FROM '+table+(' WHERE '+field+' NOT IN :ids' if field else '')+' ORDER BY '+','.join(order)
+  q=text(query).bindparams(bindparam('ids',expanding=True)) if field else text(query)
+  rows=c.execute(q,{'ids':ids} if field else {});h=hashlib.sha256();count=0
+  for row in rows:h.update(json.dumps(list(row),sort_keys=True,separators=(',',':'),default=str).encode()+b'\\n');count+=1
+  result[table]={'rows':count,'sha256':h.hexdigest()}
+ print('LATEST_RESULT='+json.dumps(result))
+e.dispose()
+'''
+    result=d.execute('original-data-'+stage,code)
+    if stage=='after':
+        before=json.loads((d.OUTPUT/'original-data-before.json').read_text())
+        assert all(before[k]==v for k,v in result.items() if k!='track_versions'),'Original non-track data changed; review fingerprints'
+        if before['track_versions']!=result['track_versions']:
+            program='''import hashlib,json
+from sqlalchemy import select,func,text,inspect
+from bmt_backend.config import Settings
+from bmt_backend.db import make_engine,make_session_factory
+from bmt_backend.studio_simulator import Plan
+from bmt_backend.track_models import OperationState,VersionFinisher
+e=make_engine(Settings.from_env().database_url)
+with make_session_factory(e)() as db:
+ db.execute(text('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY'))
+ p=Plan(**db.get(OperationState,'studio-simulator:studio-october').details['plan'])
+ ids=[p.person(i)['id'] for i in range(p.players)]
+ increments=dict(db.execute(select(VersionFinisher.version_id,func.count()).where(VersionFinisher.player_id.in_(ids)).group_by(VersionFinisher.version_id)).all())
+ columns=[c['name'] for c in inspect(db.connection()).get_columns('track_versions')];index=columns.index('verified_finishers')
+ h=hashlib.sha256();count=0
