+    shutil.copyfile(ROOT/'backend/tests/test_studio_simulator.py',d.WORK/'tests/test_studio_simulator.py')
+    d.r['files']={name:d.digest((d.CONTEXT/name).read_bytes()) for name in d.r['files']}
+    d.r['source_hash']=d.digest(json.dumps(d.r['files'],sort_keys=True).encode());d.save()
+    print(json.dumps({'refreshed_source':d.r['source_hash']}))
+
+def uuid_fix():
+    assert d.r.get('job_executed') and not d.r.get('population_complete')
+    old=json.loads((d.WORK/'execution.private.json').read_text())
+    assert old['status'].get('failedCount')==1 and not old['status'].get('runningCount')
+    shutil.copyfile(d.WORK/'execution-logs.private.json',d.WORK/'failed-execution-logs.private.json')
+    shutil.copyfile(d.WORK/'execution.private.json',d.WORK/'failed-execution.private.json')
