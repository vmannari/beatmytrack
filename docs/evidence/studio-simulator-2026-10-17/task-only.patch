+        try:return super().run(argv,**kwargs)
+        except RuntimeError:
+            diagnostic=(d.WORK/'last-error.private.log').read_text(encoding='utf-8')
+            if kwargs.get('allow_missing') and 'Cannot find job [' in diagnostic:return None
+            raise
