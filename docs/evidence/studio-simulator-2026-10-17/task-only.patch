  (!d.money.length?pNotice('Monetary revenue is unavailable','No provider revenue entries exist in this scope. Product prices, purchase requests and Coins are not revenue.','warning'):'')+
- card('Provider earnings',pTable(['Provider','Currency','Accounting basis','Amount','Last import'],d.money.map(r=>[esc(r.provider),esc(r.currency),esc(r.basis),(r.amount_micros/1000000).toFixed(2),esc(date(r.last_import_at))])))+
+ card('Provider earnings',pTable(['Provider','Type','Currency','Accounting basis','Amount','Last import'],d.money.map(r=>[esc(r.provider),esc(r.kind.replaceAll('_',' ')),esc(r.currency),esc(r.basis),(r.amount_micros/1000000).toFixed(2),esc(date(r.last_import_at))])))+
  `<div class="platform-grid">${card('Coin sources and sinks',pTable(['Movement','Coins','Entries'],d.coins.map(r=>[esc(r.kind),pNumber(r.amount),pNumber(r.entries)]))+`<p>Current wallets: ${pNumber(d.wallets.count)} · total balance ${pNumber(d.wallets.balance)} Coins. Opening balances are excluded from earnings.</p>`)}${card('Source connections',`<dl class="platform-definitions"><dt>Google Play verification</dt><dd>${d.sources.play_configured?'Configured':'Not configured'}</dd><dt>AdMob network reports</dt><dd>${d.sources.admob_configured?'Configured':'Not configured'}</dd><dt>Latest money import</dt><dd>${esc(date(d.sources.latest_import_at))}</dd><dt>Player LTV / ARPDAU</dt><dd>Unavailable until attributable value and population coverage exist</dd></dl>`+pLink('economy?tab=delivery','Inspect purchase delivery',params))}</div><p class="platform-method">${esc(d.coverage)}</p>`;
 }
 
