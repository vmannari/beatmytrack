diff --git a/scripts/studio_usage_cloud_preview.py b/scripts/studio_usage_cloud_preview.py
new file mode 100644
index 000000000..9eeec469d
--- /dev/null
+++ b/scripts/studio_usage_cloud_preview.py
@@ -0,0 +1,91 @@
+"""Read-only operator preview using an existing gcloud identity, without deployment.
+
+Only resource configuration and provider metric aggregates are written. No SQL,
+secret values, individual request logs or player records are read.
+"""
+import argparse
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "backend"))
+
+
+def main():
+    from datetime import datetime, timezone
+
+    import requests
+    from bmt_backend.config import Settings
+    from bmt_backend.studio_usage import cloud_capacity
+    from bmt_backend.studio_usage_cloud import ProviderUnavailable, UsageCloud
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, required=True, help="Existing operator project/region/gcloud configuration")
+    parser.add_argument("--prefix", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--inspect-billing", action="store_true", help="Discover export-table metadata only; never query billing rows")
+    args = parser.parse_args()
+    config = json.loads(args.config.read_text(encoding="utf-8-sig"))
+    cert = args.config.parent / "windows-trust.pem"
+    env = os.environ.copy()
+    if cert.exists():
+        env["CLOUDSDK_CORE_CUSTOM_CA_CERTS_FILE"] = str(cert.resolve())
+    result = subprocess.run([*config["gcloud"], "auth", "print-access-token", "--quiet"],
+        capture_output=True, text=True, encoding="utf-8", env=env, timeout=30, check=False)
+    if result.returncode:
+        raise SystemExit("Existing operator credential unavailable; no cloud data read")
+    token = result.stdout.strip()
+    errors = []
+    def transport(method, url, **kwargs):
+        # Only the bounded summary-log read may use POST. No mutations or
+        # BigQuery query jobs are permitted by this operator preview.
+        if method != "GET" and not (method == "POST" and url == "https://logging.googleapis.com/v2/entries:list"):
+            raise ProviderUnavailable("preview_is_read_only")
+        response = requests.request(method, url, headers={"Authorization":"Bearer " + token},
+            verify=str(cert.resolve()) if cert.exists() else True, timeout=(3,8), allow_redirects=False, **kwargs)
+        if not response.ok:
+            body = response.json().get("error", {})
+            errors.append({"host":url.split('/')[2],"status":response.status_code,
+                "metric":kwargs.get("params",{}).get("filter"),"message":str(body.get("message", ""))[:500]})
+            raise ProviderUnavailable("provider_read_denied")
+        return response.json()
+    settings = Settings(environment="test", studio_usage_project=config["project"], studio_usage_region=config["region"],
+        studio_usage_resources=json.dumps({"services":[args.prefix+"-api",args.prefix+"-studio"],
+            "workerPools":[args.prefix+"-worker"],"instances":[args.prefix+"-db"]}))
+    at = int(datetime.now(timezone.utc).timestamp())
+    cloud = UsageCloud(settings,transport=transport).collect((at//86400-6)*86400,at+1)
+    billing_discovery = {"status":"not_requested"}
+    if args.inspect_billing:
+        try:
+            datasets = transport("GET", "https://bigquery.googleapis.com/bigquery/v2/projects/"+config["project"]+"/datasets",
+                params={"maxResults":20})
+            count = 0
+            if datasets.get("nextPageToken"):
+                raise ProviderUnavailable("dataset_metadata_limit")
+            for dataset in datasets.get("datasets", []):
+                dataset_id=dataset["datasetReference"]["datasetId"]
+                tables=transport("GET", "https://bigquery.googleapis.com/bigquery/v2/projects/"+config["project"]
+                    +"/datasets/"+dataset_id+"/tables",params={"maxResults":100})
+                if tables.get("nextPageToken"):
+                    raise ProviderUnavailable("table_metadata_limit")
+                count += sum(t["tableReference"]["tableId"].startswith("gcp_billing_export_resource_v1_") for t in tables.get("tables", []))
+            billing_discovery={"status":"observed","detailed_export_table_count":count,
+                "scope":"Dataset/table metadata only; no billing rows queried or export created"}
+        except ProviderUnavailable:
+            billing_discovery={"status":"unavailable"}
+    rows, traffic = cloud_capacity(cloud,settings,at)
+    payload={"captured_at":at,"scope":"Provider metadata/metrics and bounded application aggregate summaries; existing operator identity; read-only",
+        "project":config["project"],"cloud":cloud,"resources":rows,"traffic":traffic,"provider_errors":errors,
+        "billing_discovery":billing_discovery}
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_text(json.dumps(payload,indent=2))
+    print(json.dumps({"resource_rows":len(rows),"sources":cloud["sources"],
+        "provider_errors":errors,"billing_discovery":billing_discovery,"pressure":[{"label":r["label"],"status":r["status"],"used_percent":r["used_percent"]}
+            for r in rows if r["status"] in ("warning","critical")]}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/test_studio_usage_console.py b/scripts/test_studio_usage_console.py
new file mode 100644
index 000000000..5b2123178
--- /dev/null
+++ b/scripts/test_studio_usage_console.py
@@ -0,0 +1,165 @@
+"""Exercise the real Usage & costs page in Edge against an owned synthetic server."""
+import argparse
+import json
+import secrets
+import socket
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(ROOT / "backend"), str(ROOT / "backend/tests")]
+
+
+def serve(folder, port):
+    from types import SimpleNamespace
+
+    import uvicorn
+    from bmt_backend.app import create_app
+    from bmt_backend.config import Settings
+    from bmt_backend.identity_models import Player
+    from bmt_backend.migrate import upgrade
+    from bmt_backend.studio_platform_models import AnalysisDay, AnalysisState
+    from bmt_backend.studio_reporting import StudioReporting
+    from bmt_backend.track_models import now
+    from sqlalchemy import select
+    from test_domains import FakeVerifier
+    from test_studio_usage import cloud_fixture
+
+    config = json.loads((folder / "config.private.json").read_text())
+    settings = Settings(environment="test", workload_role="admin", studio_legacy_keys_enabled=True,
+        admin_owner_key=config["owner"], admin_analyst_key=config["analyst"],
+        database_url="sqlite:///" + (folder / "database.sqlite").as_posix(), object_dir=str(folder / "objects"),
+        studio_usage_project="fixture-project", studio_usage_resources='{"services":["fixture-api"]}')
+    app = create_app(settings, verifier=FakeVerifier())
+    upgrade(app.state.engine)
+    app.state.studio_reporting.close()
+    app.state.studio_reporting = StudioReporting(settings, engine=app.state.engine)
+    mode = {"value":"observed"}
+    def observed(*args):
+        if mode["value"] == "missing":
+            return {"status":"not_configured","resources":[],"metrics":{},"sources":[],
+                "billing":{"status":"not_configured","rows":[]}}
+        return cloud_fixture(now()-901 if mode["value"] == "stale" else None)
+    app.state.studio_usage_cloud = SimpleNamespace(collect=observed)
+    @app.post("/fixture/usage-mode")
+    def fixture_mode(value: str):
+        assert value in ("observed","missing","stale")
+        mode["value"] = value
+        return {"fixture_mode":value}
+    with app.state.session_factory() as db:
+        ville, other = Player(display_name="Ville"), Player(display_name="Other")
+        db.add_all((ville, other))
+        db.flush()
+        for p, count in ((ville, 20), (other, 80)):
+            db.add(AnalysisDay(day=now() // 86400, player_id=p.id, dimension="a" * 64,
+                first_at=now()-300, last_at=now(), counters={"active":1,"network_attempts":count}))
+        db.get(AnalysisState, 1).processed_through = now()
+        db.get(AnalysisState, 1).started_at = (now() // 86400 - 14) * 86400
+        db.commit()
+        assert db.scalar(select(Player.id).where(Player.display_name == "Ville"))
+    uvicorn.run(app, host="127.0.0.1", port=port, log_level="warning")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--serve", type=Path)
+    parser.add_argument("--port", type=int)
+    parser.add_argument("--output", type=Path, default=ROOT / "docs/evidence/studio-usage-costs-2026-10-27")
+    args = parser.parse_args()
+    if args.serve:
+        return serve(args.serve, args.port)
+    import httpx
+    from playwright.sync_api import expect, sync_playwright
+
+    folder = ROOT / "build/studio-usage-costs-2026-10-27" / ("browser-" + secrets.token_hex(4))
+    folder.mkdir(parents=True, exist_ok=True)
+    args.output.mkdir(parents=True, exist_ok=True)
+    config = {k:secrets.token_urlsafe(32) for k in ("owner", "analyst")}
+    (folder / "config.private.json").write_text(json.dumps(config))
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        port = sock.getsockname()[1]
+    errors, checks = [], []
+    with (folder / "server.log").open("w", encoding="utf-8") as log:
+        process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--serve", str(folder), "--port", str(port)],
+            stdout=log, stderr=log, creationflags=subprocess.CREATE_NO_WINDOW)
+        try:
+            with httpx.Client(base_url=f"http://127.0.0.1:{port}",timeout=10) as client:
+                for _ in range(100):
+                    if process.poll() is not None:
+                        raise RuntimeError("Owned fixture stopped; inspect browser/server.log")
+                    try:
+                        if client.get("/health").status_code == 200:
+                            break
+                    except httpx.ConnectError:
+                        pass
+                    time.sleep(.2)
+                else:
+                    raise RuntimeError("Fixture startup timeout")
+                with sync_playwright() as driver:
+                    browser = driver.chromium.launch(headless=True,
+                        executable_path="C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe")
+                    page = browser.new_page(viewport={"width":1440,"height":1100})
+                    page.on("pageerror",lambda e:errors.append(str(e)))
+                    page.goto(f"http://127.0.0.1:{port}/admin#usage")
+                    page.locator("#key").fill(config["owner"])
+                    page.locator("#login button").click()
+                    expect(page.get_by_role("heading",name="Usage & costs",exact=True)).to_be_visible()
+                    expect(page.locator('.console-nav[data-route="usage"]')).to_have_attribute("aria-current","page")
+                    checks.append("real authenticated route and selected navigation")
+                    expect(page.locator(".usage-summary")).to_contain_text("needs attention")
+                    expect(page.locator(".usage-resource.critical")).to_have_count(1)
+                    expect(page.locator(".usage-resource.warning")).to_have_count(1)
+                    expect(page.locator(".usage-stats")).to_contain_text("Ville only")
+                    expect(page.locator("#main")).to_contain_text("1 active player in this scope")
+                    checks.append("critical CPU, warning memory, Ville denominator and cost rendered")
+                    page.screenshot(path=str(args.output/"usage-desktop.png"),full_page=True)
+                    page.locator(".usage-resource details summary").first.click()
+                    expect(page.locator(".usage-resource details[open]")).to_have_count(1)
+                    checks.append("resource measurement disclosure works")
+                    page.locator("#refresh").click()
+                    expect(page.get_by_role("heading",name="Usage & costs",exact=True)).to_be_visible()
+                    checks.append("manual refresh retains route")
+                    client.post("/fixture/usage-mode?value=missing").raise_for_status()
+                    page.locator("#refresh").click()
+                    expect(page.locator(".usage-stats .platform-stat").nth(2)).to_contain_text("Unavailable")
+                    expect(page.locator(".usage-summary")).to_contain_text("unknown")
+                    page.screenshot(path=str(args.output/"usage-unavailable.png"),full_page=True)
+                    checks.append("missing billing and metrics show unavailable and unknown, not zero")
+                    client.post("/fixture/usage-mode?value=stale").raise_for_status()
+                    page.locator("#refresh").click()
+                    expect(page.locator(".usage-table")).to_contain_text("Stale")
+                    expect(page.locator(".usage-resource.critical")).to_have_count(0)
+                    checks.append("stale cloud readings lose current headroom assessments")
+                    client.post("/fixture/usage-mode?value=observed").raise_for_status()
+                    page.locator("#refresh").click()
+                    expect(page.locator(".usage-resource.critical")).to_have_count(1)
+                    page.set_viewport_size({"width":390,"height":844})
+                    page.screenshot(path=str(args.output/"usage-narrow.png"),full_page=True)
+                    assert page.evaluate("document.documentElement.scrollWidth <= innerWidth + 1")
+                    checks.append("390px page fits; data tables scroll within cards")
+                    page.locator("#menu").click()
+                    page.locator('.console-nav[data-route="studio"]').click()
+                    expect(page.get_by_role("heading",name="Administration",exact=True)).to_be_visible()
+                    page.locator("#menu").click()
+                    page.locator('.console-nav[data-route="usage"]').click()
+                    expect(page.get_by_role("heading",name="Usage & costs",exact=True)).to_be_visible()
+                    checks.append("navigation away and back")
+                    page.locator("#logout").click()
+                    expect(page.locator("#login")).to_be_visible()
+                    assert "Cost per active player" not in page.locator("#main").inner_text()
+                    checks.append("locking removes usage and player data")
+                    browser.close()
+            assert not errors, errors
+        finally:
+            process.terminate()
+            process.wait(timeout=15)
+            (args.output/"browser.json").write_text(json.dumps({"checks":checks,"page_errors":errors,
+                "scope":"Synthetic local fixture; Edge desktop/narrow width, no physical device or cloud writes"},indent=2))
+    print(json.dumps({"checks":len(checks),"page_errors":errors}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/test_studio_usage_postgres.py b/scripts/test_studio_usage_postgres.py
new file mode 100644
index 000000000..02fd529b7
--- /dev/null
+++ b/scripts/test_studio_usage_postgres.py
@@ -0,0 +1,76 @@
+"""Run Studio regressions on a newly owned, bounded synthetic PostgreSQL server."""
+import argparse
+import json
+import os
+import secrets
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "docs/evidence/studio-usage-costs-2026-10-27"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--focused", action="store_true")
+    args = parser.parse_args()
+    config = json.loads((ROOT / ".tools/gcp-staging/config.json").read_text(encoding="utf-8-sig"))
+    docker = config["docker"]
+    def call(*args):
+        return subprocess.run([*docker,*args],capture_output=True,text=True,check=False,timeout=30)
+    label, password = secrets.token_hex(16), secrets.token_hex(24)
+    name = "bmt-usage-" + label[:10]
+    image = call("image","inspect","postgres:17-bookworm")
+    if image.returncode:
+        raise RuntimeError("Cached PostgreSQL image unavailable; no pull or existing service mutation")
+    started = call("run","--detach","--pull=never","--name",name,"--label","bmt.usage="+label,
+        "--cpus=2","--memory=1536m","--pids-limit=128","--shm-size=256m",
+        "--publish","127.0.0.1::5432","--tmpfs","/var/lib/postgresql/data:rw,size=768m",
+        "--env","POSTGRES_PASSWORD="+password,"--env","POSTGRES_DB=studio_usage",
+        json.loads(image.stdout)[0]["Id"],"postgres","-c","max_connections=40","-c","shared_buffers=64MB")
+    if started.returncode:
+        raise RuntimeError("Owned fixture could not start")
+    identity = started.stdout.strip()
+    exit_code = 1
+    try:
+        details = json.loads(call("inspect",identity).stdout)[0]
+        ports = details["NetworkSettings"]["Ports"]["5432/tcp"]
+        assert len(ports)==1 and ports[0]["HostIp"]=="127.0.0.1"
+        port=ports[0]["HostPort"]
+        for _ in range(80):
+            if call("exec",identity,"pg_isready","-U","postgres","-d","studio_usage").returncode==0:
+                break
+            time.sleep(.25)
+        else:
+            raise RuntimeError("Owned fixture readiness timeout")
+        env=os.environ.copy()
+        env["BMT_TEST_DATABASE_URL"]=f"postgresql+psycopg://postgres:{password}@127.0.0.1:{port}/studio_usage"
+        env["BMT_LIMITED_TEST_DATABASE_URL"]=env["BMT_TEST_DATABASE_URL"]
+        OUT.mkdir(parents=True,exist_ok=True)
+        selection = ["tests/test_studio_usage.py::test_postgres_ville_aggregation_and_database_connection_limit",
+            "tests/test_studio_usage.py::test_retained_read_only_snapshot_with_explicit_admin_workload",
+            "tests/test_studio_shared_reporting.py"] if args.focused else ["tests/test_studio_usage.py","tests/test_studio.py",
+                "tests/test_studio_shared_reporting.py","tests/test_studio_platform.py","tests/test_public_website.py",
+                "--deselect=tests/test_studio.py::test_postgres_snapshot_is_read_only_and_does_not_mix_worker_completion"]
