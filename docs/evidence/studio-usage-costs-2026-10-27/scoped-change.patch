index 000000000..ca40ca799
--- /dev/null
+++ b/backend/bmt_backend/admin_ui/usage.js
@@ -0,0 +1,43 @@
+'use strict';
+function usageNumber(v,unit='count'){
+ if(v==null||!Number.isFinite(Number(v)))return 'Unknown';
+ if(unit==='ratio')return (Number(v)*100).toFixed(1)+'%';
+ if(unit==='bytes'){const n=Number(v);return n>=1073741824?(n/1073741824).toFixed(2)+' GiB':n>=1048576?(n/1048576).toFixed(1)+' MiB':n.toLocaleString()+' B';}
+ return Number(v).toLocaleString(undefined,{maximumFractionDigits:2});
+}
+function usageMoney(v,currency){
+ if(v==null)return 'Unavailable';
+ try{return new Intl.NumberFormat(undefined,{style:'currency',currency,maximumFractionDigits:4}).format(v);}
+ catch{return usageNumber(v)+' '+esc(currency);}
+}
+function usageResource(row){
+ const known=row.used_percent!=null,kind=['critical','warning','normal'].includes(row.status)?row.status:'unknown';
+ return `<tr class="usage-resource ${kind}"><th scope="row">${esc(row.label)}<small>${esc(row.source)} · ${row.observed_at?esc(date(row.observed_at)):'No observation'}${row.observed_at&&!row.fresh?' · Stale':''}</small><details><summary>Measurement details</summary><p>${esc(row.note)}</p></details></th><td>${usageNumber(row.current,row.unit)}</td><td>${row.peak_is_lower_bound?'≥ ':''}${usageNumber(row.peak,row.unit)}</td><td>${usageNumber(row.limit,row.unit)}</td><td>${usageNumber(row.remaining,row.unit)}<small>from latest sample</small></td><td><span class="usage-status ${kind}">${kind==='normal'?'Within observed limits':kind==='unknown'?'Unknown':kind==='critical'?'Critical':'Approaching limit'}</span>${known?`<div class="usage-bar" role="img" aria-label="${esc(row.used_percent)} percent of limit at highest observation"><span style="width:${Math.min(100,Math.max(0,row.used_percent))}%"></span></div><small>${usageNumber(row.used_percent)}% at highest observation</small>`:'<small>Headroom cannot be established</small>'}</td></tr>`;
+}
+function usageTrend(costs){
+ const currencies=[...new Set((costs.daily||[]).map(r=>r.currency))];
+ if(!currencies.length)return '<p class="console-note">Daily cost history appears when billing observations are available.</p>';
+ return currencies.map(currency=>{
+  const rows=costs.daily.filter(r=>r.currency===currency),max=Math.max(...rows.map(r=>Math.abs(r.net)),0.000001);
+  return `<div class="usage-trend"><h4>${esc(currency)} · Exported daily charges</h4>${rows.map(r=>`<div class="usage-day"><time>${esc(r.day)}</time><div class="usage-trend-track"><span style="width:${Math.abs(r.net)/max*100}%" class="${r.net<0?'credit':''}"></span></div><strong>${usageMoney(r.net,currency)}</strong></div>`).join('')}</div>`;
+ }).join('');
+}
+async function studioUsage(params){
+ const query=new URLSearchParams();for(const k of ['since','until'])if(params.has(k))query.set(k,params.get(k));
+ const d=await api('usage-costs?'+query),s=d.summary,c=d.costs,a=d.activity,e=d.endpoints;
+ const cloud=d.cloud_status==='not_configured'?'<div class="platform-notice warning"><strong>Cloud resource measurements are not connected.</strong><p>Application limits are shown below. Cloud CPU, memory, scaling limits and provider quotas need the configured Google Cloud inventory and read access.</p></div>':d.cloud_status==='collecting'?'<div class="platform-notice warning">Cloud observations are being collected. Refresh to load the result.</div>':'';
+ const total=c.totals.length?c.totals.map(r=>usageMoney(r.net,r.currency)).join('<br>'):'Unavailable';
+ const ville=c.ville_estimates.filter(r=>r.per_active_player!=null);
+ const villeCost=ville.length?ville.map(r=>usageMoney(r.per_active_player,r.currency)).join('<br>'):'Unavailable';
+ const critical=d.resources.find(r=>r.status==='critical'||r.status==='warning');
+ const title=critical?`${critical.label} needs attention`:s.unknown?'Some resource headroom is unknown':'Observed resources are within limits';
+ return intro('Usage & costs','Resource headroom across the backend, with a cost-per-active-player estimate restricted to Ville.','OPERATE')+cloud+
+ `<div class="usage-summary" role="status"><strong>${esc(title)}</strong><span>${s.critical} critical · ${s.warning} approaching limit · ${s.unknown} unknown</span></div>`+
+ `<div class="platform-stats usage-stats"><article class="platform-stat"><span>Resource limits</span><strong>${s.critical+s.warning}</strong><small>need attention · ${s.unknown} unknown</small></article><article class="platform-stat"><span>Exported backend cost</span><strong>${total}</strong><small>Selected dates · credits included</small></article><article class="platform-stat"><span>Cost per active player · Ville only</span><strong>${villeCost}</strong><small>Partial API allocation estimate</small></article><article class="platform-stat"><span>Ville activity</span><strong>${a.active_players==null?'Unavailable':a.active_players?'Active':'No observed activity'}</strong><small>${a.active_days==null?'Activity reporting is unavailable':usageNumber(a.active_days)+' active UTC days'}${a.fresh===false?' · Stale':''}</small></article></div>`+
+ card('How close are we to the limits?',`<p class="console-note">Latest samples and peaks or conservative bounds over the last hour. Utilization distributions report their latest mean. Warning at 75%, critical at 90%. Selected dates apply to costs and activity. Sampled peaks can miss brief spikes.</p><div class="console-table usage-table"><table><thead><tr><th>Resource</th><th>Latest</th><th>Peak or bound</th><th>Limit</th><th>Remaining</th><th>Assessment</th></tr></thead><tbody>${d.resources.map(usageResource).join('')}</tbody></table></div><p class="console-note">Unknown means a measurement or limit is missing, stale or incomplete. Provider quotas shown do not cover every possible service limit.</p>`)+
+ `<div class="platform-grid">${card('Ville cost estimate',`<p><strong>Eligible player: Ville only</strong> · ${a.active_players==null?'Denominator unavailable':a.active_players+' active player in this scope'}</p><dl class="platform-definitions"><dt>Reported requests</dt><dd>${usageNumber(a.requests)}</dd><dt>Share of reported client requests</dt><dd>${c.request_share==null?'Unavailable':usageNumber(c.request_share,'ratio')}</dd><dt>Projection observed through</dt><dd>${esc(date(a.processed_through))}</dd></dl>${!ville.length?'<p class="platform-notice warning">A cost estimate needs observed Ville activity, fresh client reports, billing data and identifiable request-billed API charges. Missing inputs stay unavailable.</p>':''}<p>${esc(c.method)}</p><p class="console-note">${esc(a.coverage||'The selected real account and its reporting facts must be available. Other players never replace Ville in this figure.')}</p>`)}${card('Backend cost breakdown',c.services.length?`<div class="console-table"><table><thead><tr><th>Service</th><th>Exported net charge</th></tr></thead><tbody>${c.services.map(r=>`<tr><td>${esc(r.service)}</td><td>${usageMoney(r.net,r.currency)}</td></tr>`).join('')}</tbody></table></div>${c.ville_estimates.map(r=>`<p>Unallocated backend cost: <strong>${usageMoney(r.unallocated,r.currency)}</strong></p>`).join('')}<p class="console-note">${esc(c.coverage)}</p>`:`<p>Billing status: <strong>${esc(c.status.replaceAll('_',' '))}</strong></p><p class="console-note">${esc(c.coverage)}</p>`)}</div>`+
+ card('Daily cost history',usageTrend(c))+
+ card('Requests, transfer and billed instance time',`<p class="console-note">Last hour · provider observations across configured services and workers; all players and background traffic remain included.</p><div class="console-table"><table><thead><tr><th>Resource</th><th>Measurement</th><th>Observed total</th><th>Latest observation</th></tr></thead><tbody>${d.traffic.map(r=>`<tr><td>${esc(r.resource)}</td><td>${esc(({requests:'Requests',sent_bytes:'Sent bytes',billable_seconds:'Billable instance seconds'})[r.metric]||r.metric)}</td><td>${usageNumber(r.value,r.metric==='sent_bytes'?'bytes':'count')}</td><td>${esc(date(r.observed_at))}</td></tr>`).join('')||'<tr><td colspan="4">Cloud usage is unavailable.</td></tr>'}</tbody></table></div>`)+
+ card('Which API endpoints do the work?',`<p class="console-note">${esc(e.coverage||'Endpoint summaries are unavailable until the aggregate application logs can be read.')}</p><div class="console-table"><table><thead><tr><th>Endpoint</th><th>HTTP status</th><th>Requests</th><th>Response bytes</th><th>Total elapsed time</th></tr></thead><tbody>${e.rows.map(r=>`<tr><td>${esc(r.method)} ${esc(r.route)}</td><td>${usageNumber(r.status)}</td><td>${usageNumber(r.requests)}</td><td>${usageNumber(r.response_wire_bytes,'bytes')}</td><td>${usageNumber(r.duration_ms/1000)} s</td></tr>`).join('')||'<tr><td colspan="5">No complete endpoint summary observations are available.</td></tr>'}</tbody></table></div><p class="console-note">Elapsed request time includes waiting; it is not CPU time or a monetary charge.</p>`)+
+ card('Source coverage',`<p class="console-note">${d.project?'Project '+esc(d.project):'No cloud project configured'} · Manual refresh · Cloud observations cached for 60 seconds</p><div class="usage-sources">${d.sources.map(r=>`<div><span>${esc(r.source)}</span><strong>${esc(r.status.replaceAll('_',' '))}</strong></div>`).join('')}</div><details><summary>Definitions and limits</summary><ul>${d.limits.map(v=>`<li>${esc(v)}</li>`).join('')}</ul></details>`);
+}
