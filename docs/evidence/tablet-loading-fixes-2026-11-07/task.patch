+	_telemetry_observe("share_clicked",{"challenge_id":str(value.get("id","")),"reason":"share"})
+	var time: String = GameText.message("%.3f s") % (float(value.target_ms)/1000.0) if value.get("target_ms") != null else "Join my group challenge"
