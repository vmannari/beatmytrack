+	var row: Dictionary = {"kind":"menu","page":page,"cycle":cycle,"dispatch_ms":(dispatched-began)/1000.0,"first_draw_ms":(first-began)/1000.0,"ready_ms":(Time.get_ticks_usec()-began)/1000.0,"success":ready,"frames":frame_stats()}
+	if page == "create":
