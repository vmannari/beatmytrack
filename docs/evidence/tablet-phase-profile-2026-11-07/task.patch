+"""Publish measured tablet observations and update only this task's status block."""
+import json
+from pathlib import Path
+from statistics import median
+
+E=Path(__file__).resolve().parent
+ROOT=E.parents[2]
+S=json.loads((E/'summary.json').read_text())
+P=json.loads((E/'package.json').read_text())
+R=json.loads((E/'restoration.json').read_text())
+assert S['checks']==280 and R['personal_bests_unchanged'] and R['authored_tracks_unchanged']
+
+def seconds(value):return f'{value/1000:.3f}'
+
+menu=['| Menu | First visit, median seconds | Repeat, median seconds |','|---|---:|---:|']
+for name,values in S['menus'].items():
+    menu.append(f"| {'Editor' if name=='create' else name.capitalize()} | {seconds(values['0']['median_ready_ms'])} | {seconds(values['1']['median_ready_ms'])} |")
+race=['| Local fixture/theme | Run A first entry, s | Run B first entry, s | Repeat entries, range s |','|---|---:|---:|---:|']
+for fixture,theme in [('oval',t) for t in ['pine','winter','desert','night_city','storm']]+[('star','pine')]:
+    rows=[r for r in S['races'] if r['fixture']==fixture and r['theme']==theme]
+    first=[r['ready_ms'] for r in rows if r['cycle']==0]
+    warm=[r['ready_ms'] for r in rows if r['cycle']==1]
+    race.append(f'| {fixture}/{theme} | {seconds(first[0])} | {seconds(first[1])} | {seconds(min(warm))}–{seconds(max(warm))} |')
