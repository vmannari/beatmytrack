+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "bmt-product-events-v1",
+  "title": "Authenticated product-observation batch",
+  "description": "Valid client batches for POST /v1/telemetry/batches. Bearer authentication supplies player identity and artificial classification; client observations cannot authorize game results, purchases or grants. This strict authoring schema validates every event. Runtime ingress intentionally validates event rows separately and returns accepted/duplicate/rejected acknowledgements instead of rejecting all valid siblings.",
+  "$comment": "The server enforces at most 50 events and a 65536-byte compact UTF-8 serialization of the normalized batch model, including defaults; JSON Schema cannot express that encoded-size limit. Wire integer values must be integer JSON tokens: the Python event parser rejects booleans and floating-point values, including 1.0. The relative timestamp window and persisted event-ID conflicts require server context and are not JSON Schema checks. UUID patterns specify canonical representations; the parser normalizes UUIDs. No authentication key or identity subject belongs in this payload.",
+  "x-max-canonical-bytes": 65536,
+  "x-max-event-age-seconds": 604800,
+  "x-future-allowance-seconds": 300,
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema",
+    "purpose_policy",
+    "build_id",
+    "platform",
+    "events"
+  ],
+  "properties": {
+    "schema": {
+      "const": "bmt-product-events-v1"
+    },
+    "purpose_policy": {
+      "const": "bmt-product-telemetry-v1"
+    },
+    "build_id": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 80,
+      "pattern": "^[A-Za-z0-9._:\\-]+$"
+    },
+    "platform": {
+      "enum": [
+        "android",
+        "windows",
+        "linux",
+        "ios"
+      ]
+    },
+    "clock_quality": {
+      "enum": [
+        "client_clock",
+        "server_estimate"
+      ],
+      "default": "client_clock"
+    },
+    "batch_id": {
+      "anyOf": [
+        {
+          "$ref": "#/$defs/uuid4"
+        },
+        {
+          "type": "null"
+        }
+      ],
+      "default": null
+    },
+    "install_id": {
+      "anyOf": [
+        {
+          "$ref": "#/$defs/uuid4"
+        },
+        {
+          "type": "null"
+        }
+      ],
+      "default": null
+    },
+    "events": {
+      "type": "array",
+      "minItems": 1,
+      "maxItems": 50,
+      "items": {
+        "$ref": "#/$defs/event"
+      }
+    }
+  },
+  "$defs": {
+    "uuid": {
+      "type": "string",
+      "minLength": 36,
+      "maxLength": 36,
+      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
+    },
+    "uuid4": {
+      "type": "string",
+      "minLength": 36,
+      "maxLength": 36,
+      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
+    },
+    "event": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "id",
+        "name",
+        "occurred_at",
+        "session_id",
+        "seq",
+        "monotonic_ms",
+        "properties"
+      ],
+      "properties": {
+        "id": {
+          "$ref": "#/$defs/uuid4"
+        },
+        "name": {
+          "enum": [
+            "app_first_open",
