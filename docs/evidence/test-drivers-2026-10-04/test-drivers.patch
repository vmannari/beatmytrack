+
+
+def test_test_group_isolated_fill_and_normal_scope_rejected(drivers):
+    f = fleet(drivers)
+    real, test = group(drivers, False), group(drivers)
+    assert real["group_id"] != test["group_id"] and test["test_population"]
+    for _ in range(2):
