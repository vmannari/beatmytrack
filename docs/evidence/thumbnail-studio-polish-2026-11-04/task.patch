+	create_timer(180).timeout.connect(func() -> void: printerr("THUMBNAIL_APP_TIMEOUT"); quit(1))
+	root.size = Vector2i(1920,900)
+	var folder: String = "user://thumbnail-studio-polish-"+TrackLibrary.unique_id()
