+extends "res://tests/test_editor_t01_t04.gd"
+class TimedVisual extends NativeTrackVisual:
+	var phases: Dictionary = {}
+	func _prepare_road_piece(track: NativeTrack, index: int, ctx: Dictionary) -> Dictionary:
+		var began: int = Time.get_ticks_usec(); var result: Dictionary = await super._prepare_road_piece(track,index,ctx)
+		phases["piece_us"] = int(phases.get("piece_us",0))+Time.get_ticks_usec()-began
+		return result
+	func _build_kerbs(track: NativeTrack, arrays: Array = []) -> void:
+		var began: int = Time.get_ticks_usec(); await super._build_kerbs(track,arrays)
+		phases["kerbs_us"] = int(phases.get("kerbs_us",0))+Time.get_ticks_usec()-began
+	func _commit_creator_road(tool: SurfaceTool, color: Color, mask: Texture2D, road_mask: Texture2D, extent: Vector2, gravel: bool = false, grass: bool = false, kerb: bool = false, asphalt_surface: bool = false, edge_fringe: bool = false, road_marking: bool = false, arrays: Array = [], relief: String = "") -> void:
+		var began: int = Time.get_ticks_usec()
+		await super._commit_creator_road(tool,color,mask,road_mask,extent,gravel,grass,kerb,asphalt_surface,edge_fringe,road_marking,arrays,relief)
+		phases["commit_inclusive_us"] = int(phases.get("commit_inclusive_us",0))+Time.get_ticks_usec()-began
+func run() -> void:
+	var doc: Dictionary = circuit(96)
+	var track: NativeTrack = TrackCompiler.compile(doc)
+	var began: int = Time.get_ticks_usec()
+	var ground: Dictionary = preload("res://race/race_ground_preparation.gd").run(func() -> bool: return false,track)
+	print("EDITOR_PHASE ground_cpu_ms=",(Time.get_ticks_usec()-began)/1000.0)
+	var script := GDScript.new()
+	script.source_code = FileAccess.get_file_as_string("res://editor/road_preparation.gd").replace("var builder := NativeTrackVisual.new()","var builder := preload(\"res://tests/profile_editor_phases.gd\").TimedVisual.new()")
+	script.source_code = script.source_code.replace("var size: int = 0\n\tfor part: Dictionary in packet.parts:","print(\"EDITOR_PHASE road_stages \",JSON.stringify(builder.phases))\n\tvar size: int = 0\n\tfor part: Dictionary in packet.parts:")
+	check(script.reload() == OK,"timed CPU builder loads")
+	for planning: bool in [true,false]:
+		began = Time.get_ticks_usec()
+		var result: Dictionary = script.prepare(track,true,false,Callable(),planning)
+		print("EDITOR_PHASE planning=",planning," ms=",(Time.get_ticks_usec()-began)/1000.0," parts=",result.get("parts",[]).size())
+	print("EDITOR_PHASE_COMPLETE")
+	quit(1 if failures else 0)
diff --git a/game/tests/review_editor_fixed_items.gd b/game/tests/review_editor_fixed_items.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/review_editor_fixed_items.gd
@@ -0,0 +1,37 @@
+extends "res://tests/review_track_editor_2026_10_28.gd"
+## Actual editor views using disposable storage, with the original capture path.
+func run() -> void:
+	if DisplayServer.get_name() == "headless": quit(2); return
+	folder = ProjectSettings.globalize_path("res://../docs/evidence/track-editor-fixes-2026-10-28/native/"+RenderingServer.get_current_rendering_method())
+	DirAccess.make_dir_recursive_absolute(folder)
+	source_before = source_hashes(); root.size = Vector2i(1280,720); root.content_scale_size = Vector2i(1280,720)
+	app = load("res://core/app.tscn").instantiate()
+	app.library = TrackLibrary.new(folder+"/disposable-storage")
+	app.records = LocalRecords.new(folder+"/disposable-storage/records.json")
+	app.cloud_root_override = folder+"/disposable-cloud"; root.add_child(app)
+	while not app.startup_complete: await process_frame
+	var doc: Dictionary = circuit()
+	await show(doc)
+	app.canvas.zoom = 0.5; app.canvas.selected_piece = 0; app._build_editor_tools()
+	await shot("01-separated-road-controls")
+	doc.theme = "night_city"; await show(doc)
+	await shot("02-night-authoring")
+	app.editor_map_panel.show()
+	await shot("03-night-lighting-toggle")
+	var toggle: Button = app.editor_map_panel.find_child("EditorRaceLighting",true,false)
+	if toggle == null: failures += 1
+	else: toggle.button_pressed = true; toggle.toggled.emit(true)
+	app.editor_map_panel.hide()
+	await shot("04-night-race-preview")
+	if toggle != null: toggle.button_pressed = false; toggle.toggled.emit(false)
+	app.canvas.choose_piece("straight"); app._share_dialog()
+	await shot("05-share-preview-resolution")
+	for dialog: Node in app.root_ui.find_children("*","AcceptDialog",true,false): dialog.hide(); dialog.queue_free()
+	app._discard_editor_previews(); app._editor_hint("Keep the whole road section inside the map.")
+	await shot("06-visible-rejection")
+	var after: Dictionary = source_hashes()
+	var file := FileAccess.open(folder+"/results.json",FileAccess.WRITE)
+	file.store_string(JSON.stringify({"failures":failures,"observations":observations,"source_before":source_before,"source_after":after,"source_stable":source_before == after},"\t")); file.close()
+	app.queue_free(); await frames(2)
+	print("EDITOR_FIXED_VIEWS: %d captures, %d failures" % [observations.size(),failures])
+	quit(1 if failures else 0)
