+	DirAccess.make_dir_recursive_absolute(output)
+	viewport = SubViewport.new(); viewport.size = Vector2i(640,360); viewport.own_world_3d = true; viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
