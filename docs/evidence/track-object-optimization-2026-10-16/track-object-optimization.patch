+
+static func _cluster(tool: SurfaceTool, kit: Node, p: Vector3, size: Vector3, angle: float, color: Color) -> void:
+	BeforeCreatorPropVisual._crown(tool,kit,p,size,angle,color)
+	# Folded sprays sit on upper surfaces and break the broad crown into leaf masses.
+	for i: int in range(8):
+		var a: float = i*2.4+angle
+		var leaf_p: Vector3 = p+Vector3(cos(a)*size.x*0.53,size.y*(0.59+(i%3)*0.08),sin(a)*size.z*0.53)
+		var reach := Vector3(cos(a)*0.18,0.015,sin(a)*0.18)
+		var side := Vector3(-sin(a)*0.065,0,cos(a)*0.065)
+		BeforePropGeometry.face(tool,[leaf_p-reach*0.3,leaf_p+side,leaf_p+reach+Vector3.UP*0.04,leaf_p-side],color.lightened(0.18+(i%2)*0.05))
+
+static func _blade(tool: SurfaceTool, base: Vector3, lean: Vector3, height: float, width: float, color: Color, angle: float) -> void:
+	var side := Vector3(cos(angle)*width,0,sin(angle)*width)
+	var mid: Vector3 = base+lean*0.28+Vector3.UP*height*0.58
+	var tip: Vector3 = base+lean+Vector3.UP*height
+	BeforePropGeometry.face(tool,[base-side,base+side,mid+side*0.63,mid-side*0.63],color)
+	BeforePropGeometry.face(tool,[mid-side*0.63,mid+side*0.63,tip],color.lightened(0.13))
+	BeforePropGeometry.face(tool,[base,mid+Vector3(0.01,0,0.01),tip],color.darkened(0.14))
+
+static func _log(tool: SurfaceTool) -> void:
+	var ends: Array = []
+	for side: float in [-1.0,1.0]:
+		var ring: Array[Vector3] = []
+		for i: int in range(16):
+			var a: float = TAU*i/16
+			var radius: float = 0.365+0.022*sin(i*2.1)
+			ring.append(Vector3(side*1.99,0.40+cos(a)*radius,sin(a)*radius))
+		ends.append(ring)
+	for i: int in range(16):
+		var j: int = (i+1)%16
+		BeforePropGeometry.face(tool,[ends[0][i],ends[0][j],ends[1][j],ends[1][i]],Color("66543e").lightened((i%3)*0.07))
+		var a: Vector3 = ends[0][i].lerp(ends[0][j],0.24)
+		var b: Vector3 = ends[1][i].lerp(ends[1][j],0.35)
+		BeforePropGeometry.beam(tool,a+Vector3(-0.003,0.002,0.002),b+Vector3(0.003,0.002,0.002),0.017,0.008,Color("443b2e"))
+	for side: float in [-1.0,1.0]:
+		BeforePropGeometry.tube(tool,Vector3(side*2.001,0.40,0),Vector3(side*2.008,0.40,0),0.329,0.329,Color("b79b71"),16)
+		for radius: float in [0.12,0.23,0.29]: BeforePropGeometry.ring(tool,Vector3(side*2.012,0.40,0),Vector3.RIGHT,radius,radius-0.012,0.004,Color("957b55"),20)
+		BeforePropGeometry.beam(tool,Vector3(side*2.017,0.39,0),Vector3(side*2.017,0.62,0.14),0.011,0.003,Color("66523b"))
+	for x: float in [-0.75,0.68]:
+		BeforePropGeometry.tube(tool,Vector3(x,0.59,-0.14),Vector3(x+0.12,0.80,-0.22),0.095,0.053,Color("6a563e"),8)
+		BeforePropGeometry.tube(tool,Vector3(x+0.12,0.80,-0.22),Vector3(x+0.13,0.81,-0.22),0.046,0.046,Color("b89a6e"),8)
