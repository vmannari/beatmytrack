+		var found: bool = BeforePropNature.append(local,kit,kind,Vector3.ZERO,1,0)
+		if not found: found = BeforePropEquipment.append(local,kit,kind,Vector3.ZERO,1,0,length,paint)
+		if not found: found = BeforePropStructures.append(local,kit,kind,Vector3.ZERO,1,0)
+		if not found: found = BeforePropEgypt.append(local,kind,Vector3.ZERO,1,0)
