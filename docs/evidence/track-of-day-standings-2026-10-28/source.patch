+var _serial: int = 0
+var _expired: bool = false
+var _dirty: bool = false
+var _page: int = 0
+var _cursors: Array[String] = [""]
+var _next_cursor: String = ""
+var _rows: VBoxContainer
+var _own: VBoxContainer
+var _status: Label
