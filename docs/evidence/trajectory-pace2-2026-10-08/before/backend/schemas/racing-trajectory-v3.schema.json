{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private derived racing trajectory cache v3",
  "description": "Computed from immutable geometry and a canonical vehicle contract. Not a track document, race result or public API payload. SI units; reference time is an estimate.",
  "type": "object",
  "required": [
    "version",
    "key",
    "length",
    "spacing",
    "reference_seconds",
    "curvature_before",
    "curvature_after",
    "blocked_samples",
    "strategy",
    "pilot_ticks",
    "pilot_candidates",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "racing-trajectory-3"
    },
    "key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "length": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "spacing": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reference_seconds": {
      "type": "number",
      "minimum": 0
    },
    "curvature_before": {
      "type": "number",
      "minimum": 0
    },
    "curvature_after": {
      "type": "number",
      "minimum": 0
    },
    "blocked_samples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8192
    },
    "strategy": {
      "enum": [
        "minimum_curvature",
        "smoothing",
        "center",
        "minimum_time"
      ]
    },
    "pilot_ticks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15000
    },
    "pilot_candidates": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "strategy",
          "finished",
          "ticks",
          "contacts",
          "missed_gate",
          "standing_ticks",
          "flying_ticks",
          "estimated_race_ticks",
          "diagnostic_laps"
        ],
        "additionalProperties": false,
        "properties": {
          "strategy": {
            "enum": [
              "minimum_curvature",
              "smoothing",
              "center",
              "minimum_time"
            ]
          },
          "finished": {
            "type": "boolean"
          },
          "ticks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          },
          "contacts": {
            "type": "integer",
            "minimum": 0
          },
          "missed_gate": {
            "type": "integer",
            "minimum": -1
          },
          "standing_ticks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          },
          "flying_ticks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          },
          "estimated_race_ticks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 150000
          },
          "diagnostic_laps": {
            "const": 2
          }
        }
      }
    },
    "rows": {
      "description": "x,y,heading,filtered curvature,target v,grip,resistance,left corridor,right corridor,elevated layer; s=index*spacing",
      "type": "array",
      "minItems": 16,
      "maxItems": 8192,
      "items": {
        "type": "array",
        "minItems": 10,
        "maxItems": 10,
        "items": false,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number",
            "exclusiveMinimum": 0
          },
          {
            "type": "number",
            "exclusiveMinimum": 0
          },
          {
            "type": "number"
          },
          {
            "type": "number",
            "maximum": 0
          },
          {
            "type": "number",
            "minimum": 0
          },
          {
            "enum": [
              0,
              1
            ]
          }
        ]
      }
    }
  }
}
