msgstr "Løpstiden din er ditt neste mål. Rull til Kjør igjen for å prøve å sette personlig rekord."

#: game/ui/account_panel.gd:68
msgid "Your racing name"
msgstr "Førernavnet ditt"

#: game/ui/account_panel.gd:152 game/ui/account_panel.gd:45
