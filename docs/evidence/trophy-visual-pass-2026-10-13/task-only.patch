+static func _leaf_patch(tool: SurfaceTool, points: Array[Vector3]) -> void:
+	# Relief geometry needs its folded face normals, rather than a flat mural normal.
+	for indices: Vector3i in [Vector3i(0,1,2),Vector3i(0,2,3)]:
