+extends RefCounted
+## Plausibility + every ordered road gate. Does not reproduce tire/collision forces.
+## Uncertain trajectories return to the canonical replay, never reject a legal race.
+
+static func check(track: NativeTrack, proof: Dictionary, initial: VehicleState, config: HandlingConfig, frames: int, info: Dictionary, capture_ghost: bool) -> Dictionary:
+	var samples: Array = proof.get("samples",[])
+	if samples.size() < 2: return {}
+	var first: Array = samples[0]
+	if int(first[0]) != 0 or Vector2(first[1],first[2]).distance_to(initial.position) > 0.05: return {}
+	if Vector2(first[4],first[5]).length() > 0.05 or int(first[6]) != int(initial.track_elevated): return {}
+	var state := VehicleState.new()
+	var session := TrackSession.new()
+	session._configure(track)
+	var ghost := PersonalGhostRun.new()
+	var bridge: BridgeElevation = BridgeElevation.new(track) if capture_ghost else null
+	var previous: Vector2 = initial.position
+	var previous_tick: int = 0
+	var previous_layer: int = int(initial.track_elevated)
+	var previous_speed: float = 0.0
+	var previous_velocity := Vector2.ZERO
+	var lap_ticks: Array[int] = []
+	var last_lap: int = 0
+	var hint: int = initial.route_index
+	for index: int in range(samples.size()):
+		var sample: Array = samples[index]
+		var tick: int = int(sample[0])
+		var position := Vector2(sample[1],sample[2])
+		var velocity := Vector2(sample[4],sample[5])
+		var layer: int = int(sample[6])
+		if index > 0:
+			var elapsed: float = float(tick-previous_tick)/VehicleSimulation.TICK_RATE
+			var speed: float = velocity.length()
+			# Broad tolerance for launch, impacts and sampling. Never accept a
+			# teleport or sustained overspeed through this fast path.
+			if tick <= previous_tick or tick-previous_tick > 6 or session.finished: return {}
+			if speed > config.maximum_speed+0.1 or previous.distance_to(position) > config.maximum_speed*elapsed+0.05: return {}
+			if (position-previous-(velocity+previous_velocity)*elapsed*0.5).length() > 0.15: return {}
+			if speed-previous_speed > config.engine_force/config.mass*1.5*elapsed+0.15: return {}
+			if position.abs().x > track.half_extent.x or position.abs().y > track.half_extent.y: return {}
+			hint = track.nearest_route(position,hint)
+			session.elapsed_ticks = tick-1
+			session.advance(track,previous,position,hint,layer == 1,previous_layer)
+			if session.completed_laps > lap_ticks.size():
+				lap_ticks.append(tick-last_lap)
+				last_lap = tick
+			previous_speed = speed
+		state.tick = tick
+		state.position = position
+		state.heading = float(sample[3])
+		state.velocity = velocity
+		state.track_elevated = layer == 1
+		state.route_index = hint
+		state.jump_height = float(sample[7])
+		if capture_ghost: ghost.capture(state,session,track,bridge,config,true)
+		previous = position
+		previous_tick = tick
+		previous_layer = layer
+		previous_velocity = velocity
+	if not session.finished or session.completed_laps != RaceRules.LAPS or previous_tick != frames: return {}
+	return {"time_ticks":frames,"time_ms":roundi(session.race_time_seconds()*1000.0),
+		"lap_ticks":lap_ticks,"manifest":info,"ghost":ghost.recording("race") if capture_ghost else {},"verification_method":"movement-proof-v1"}
