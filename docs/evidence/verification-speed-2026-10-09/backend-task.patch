+extends RefCounted
+## Small movement evidence for the owner-approved lightweight server check.
+const STRIDE: int = 6
+var samples: Array = []
+var _laps: int = 0
+
+func capture(state: VehicleState, session: TrackSession, force: bool = false) -> void:
+	var boundary: bool = session.completed_laps > _laps
