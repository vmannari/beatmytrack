+          {"type": "number", "minimum": -100000, "maximum": 100000},
+          {"type": "number", "minimum": -100000, "maximum": 100000},
+          {"type": "number", "minimum": -100000, "maximum": 100000},
+          {"type": "number", "minimum": -100000, "maximum": 100000},
