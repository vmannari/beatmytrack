diff --git a/game/tests/test_kart_material_finish.gd b/game/tests/test_kart_material_finish.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_kart_material_finish.gd
@@ -0,0 +1,96 @@
+extends SceneTree
+## VQR03: native driver material bindings preserve mesh/morph data and isolation.
+const DRIVER = preload("res://vehicle/kart_driver.gd")
+const STEERING = preload("res://vehicle/kart_steering.gd")
+const ROOT: String = "res://assets/vehicles/kart_refined_v1/tomkart_driver_v1/"
+var checks: int = 0
+var failures: int = 0
+
+func _initialize() -> void: run.call_deferred()
+
+func check(ok: bool, message: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		printerr("KART_FINISH_FAIL ",message)
+
+func geometry(mesh: ArrayMesh) -> PackedByteArray:
+	var arrays: Array = []
+	for surface: int in range(mesh.get_surface_count()):
+		arrays.append(mesh.surface_get_arrays(surface))
+		arrays.append(mesh.surface_get_blend_shape_arrays(surface))
+	return var_to_bytes(arrays)
+
+func suit_parts(driver: MeshInstance3D) -> Array[MeshInstance3D]:
+	var result: Array[MeshInstance3D] = [driver]
+	var fixed := driver.get_node_or_null("DriverStaticSuit") as MeshInstance3D
+	if fixed != null: result.append(fixed)
+	return result
+
+func own(node: Node, owner: Node) -> void:
+	for child: Node in node.get_children():
+		child.owner = owner
+		own(child,owner)
+
+func run() -> void:
+	var hashes: Dictionary = {}
+	var original: Dictionary = {}
+	for file: String in ["driver.res","driver_steering.res","driver_static.res","helmet_static.res"]:
+		hashes[file] = FileAccess.get_sha256(ROOT+file)
+		original[file] = geometry(load(ROOT+file))
+	var containers: Array[Node3D] = []
+	var materials: Array[Material] = []
+	for simple: bool in [false,true]:
+		var body := Node3D.new()
+		root.add_child(body)
+		containers.append(body)
+		DRIVER.build(body,CompactFinish.rubber(Color("20272a")),simple)
+		var driver := body.get_node("TomkartDriver") as MeshInstance3D
+		check(driver.mesh == load(ROOT+("driver_steering.res" if simple else "driver.res")),"original native driver resource retained")
+		check(driver.mesh.get_blend_shape_count() == STEERING.STEPS*2,"all steering samples retained")
+		var suit: Material
+		for part: MeshInstance3D in suit_parts(driver):
+			for surface: int in range(part.mesh.get_surface_count()):
+				var source: Material = part.mesh.surface_get_material(surface)
+				var active: Material = part.get_active_material(surface)
+				check(active != source,"finish uses instance binding")
+				check(source is StandardMaterial3D,"imported native material remains unchanged")
+				check(active.resource_name == source.resource_name,"material role preserved")
+				if source.resource_name == "RT_DriverSuit":
+					check(active is ShaderMaterial and active.shader == DRIVER.CLOTH,"garment finish used")
+					check(suit == null or suit == active,"static and moving panels share finish")
+					suit = active
+				elif source.resource_name == "RT_Gloves":
+					check(active is StandardMaterial3D and active.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED,"glove remains opaque")
+		materials.append(suit)
+		var helmet := driver.get_node("HelmetStatic") as MeshInstance3D
+		check(helmet.mesh == load(ROOT+"helmet_static.res"),"helmet native resource retained")
+		for surface: int in range(helmet.mesh.get_surface_count()):
+			var source: Material = helmet.mesh.surface_get_material(surface)
+			if source.resource_name == "HelmetVisor":
+				var visor := helmet.get_active_material(surface) as StandardMaterial3D
+				check(visor != null and visor != source,"visor uses instance finish")
+				check(visor.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED and is_equal_approx(visor.albedo_color.a,1.0),"visor stays opaque")
+			else:
+				check(helmet.get_active_material(surface) == source,"shell, hardware and seals preserve original finish")
+		for input: float in [-1.0,-0.65,0.0,0.65,1.0]:
+			STEERING.present(null,driver,input)
+			check(driver.get_active_material(1) == suit,"material binding remains during steering")
+		# Prepared bases serialize these exact per-surface bindings.
+		own(body,body)
+		var packed := PackedScene.new()
+		check(packed.pack(body) == OK,"finished driver packs")
+		var restored := packed.instantiate()
+		var restored_driver := restored.get_node("TomkartDriver") as MeshInstance3D
+		check(restored_driver.get_active_material(1) is ShaderMaterial,"garment finish survives prepared scene roundtrip")
+		var restored_helmet := restored_driver.get_node("HelmetStatic") as MeshInstance3D
+		check(restored_helmet.get_surface_override_material(2) != null,"visor finish survives prepared scene roundtrip")
+		restored.free()
+	check(materials[0] != materials[1],"separate cars do not share mutable finish instances")
+	for file: String in hashes:
+		check(FileAccess.get_sha256(ROOT+file) == hashes[file],"native mesh file is byte exact "+file)
+		check(geometry(load(ROOT+file)) == original[file],"positions, normals, UVs, colours, topology and all morph arrays unchanged "+file)
+	for body: Node3D in containers: body.free()
+	await process_frame
+	print("KART_MATERIAL_FINISH: ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/test_vehicle_material_finish.gd b/game/tests/test_vehicle_material_finish.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_vehicle_material_finish.gd
@@ -0,0 +1,142 @@
+extends SceneTree
+## VQR03: real material bindings, saved pigment and per-view glass isolation.
+const FINISH = preload("res://vehicle/compact_finish.gd")
+const ELECTRIC_GLASS = preload("res://vehicle/electric_glass.gdshader")
+const WINDOW_GLASS = preload("res://vehicle/window_reflection.gdshader")
+const RACE_GLASS = preload("res://race/electric_glass_lighting.gd")
+var checks: int = 0
+var failures: int = 0
+
+func _initialize() -> void: run.call_deferred()
+
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+		printerr("MATERIAL_FINISH_FAIL ",label)
+
+func finite_response(material: StandardMaterial3D) -> bool:
+	for value: float in [material.roughness,material.metallic,material.metallic_specular,material.clearcoat,material.clearcoat_roughness]:
+		if not is_finite(value) or value < 0.0 or value > 1.0: return false
+	return true
+
+func opaque(material: StandardMaterial3D) -> bool:
+	return material.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED and is_equal_approx(material.albedo_color.a,1.0)
+
+func glass_bindings(car: CarVisual) -> Array[Dictionary]:
+	var result: Array[Dictionary] = []
+	for mesh: MeshInstance3D in car.find_children("*","MeshInstance3D",true,false):
+		if mesh.mesh == null: continue
+		for surface: int in range(mesh.mesh.get_surface_count()):
+			var material := mesh.get_active_material(surface) as ShaderMaterial
+			if material != null and material.shader in [ELECTRIC_GLASS,WINDOW_GLASS]:
+				result.append({"mesh":mesh,"surface":surface,"material":material})
+	return result
+
+func is_bound(car: CarVisual, material: Material) -> bool:
+	for mesh: MeshInstance3D in car.find_children("*","MeshInstance3D",true,false):
+		if mesh.mesh == null: continue
+		for surface: int in range(mesh.mesh.get_surface_count()):
+			if mesh.get_active_material(surface) == material: return true
+	return false
+
+func configuration_hashes() -> Dictionary:
+	var result: Dictionary = {}
+	for file: String in DirAccess.get_files_at("res://resources/cars"):
+		if file.ends_with(".tres"):
+			var path: String = "res://resources/cars/"+file
+			result[path] = FileAccess.get_sha256(path)
+	for path: String in HandlingSelection.PROFILE_PATHS:
+		result[path] = FileAccess.get_sha256(path)
+	return result
+
+func create_car(id: String, livery: Dictionary) -> CarVisual:
+	var car := CarVisual.new()
+	car.vehicle_id = id
+	car.livery = livery.duplicate(true)
+	car.cache_rest_pose = false
+	root.add_child(car)
+	while not car.model_ready: await process_frame
+	return car
+
+func run() -> void:
+	# This gate checks current source, independent of pending prepared refreshes.
+	preload("res://vehicle/prepared_car_cache.gd").enabled = false
+	preload("res://vehicle/modular_car_base.gd").enabled = false
+	preload("res://vehicle/modular_car_kits.gd").enabled = false
+	preload("res://ui/garage_car_cache.gd").enabled = false
+	var config_before: Dictionary = configuration_hashes()
+	var pigment := Color("9a3e50")
+	var finishes: Dictionary = {"paint":FINISH.paint(pigment),"rubber":FINISH.rubber(pigment),
+		"alloy":FINISH.alloy(pigment),"glass":FINISH.glass(pigment),
+		"industrial":FINISH.industrial_paint(pigment),"polymer":FINISH.polymer(pigment)}
+	for role: String in finishes:
+		var material: StandardMaterial3D = finishes[role]
+		check(opaque(material),role+" opaque")
+		check(finite_response(material),role+" finite physical response")
+		check(material.albedo_color == pigment,role+" preserves caller pigment")
+		check(material.specular_mode == BaseMaterial3D.SPECULAR_SCHLICK_GGX,role+" enables GGX specular")
+	check(finishes.glass.roughness < finishes.paint.roughness and finishes.paint.roughness < finishes.rubber.roughness,"glass/paint/rubber roughness separates surfaces")
+	check(finishes.polymer.roughness > finishes.industrial.roughness and finishes.industrial.clearcoat < finishes.paint.clearcoat,"seat polymer and industrial paint separate")
+	check(finishes.alloy.metallic > finishes.paint.metallic and finishes.rubber.metallic == 0.0,"metal versus dielectric response")
+	check(finishes.glass.cull_mode == BaseMaterial3D.CULL_DISABLED,"opaque glazing remains double sided")
+	check(FINISH.glass(Color(pigment,0.2)).albedo_color == pigment,"glass rejects accidental transparency without changing RGB")
+	var alpha_write := RegEx.new()
+	alpha_write.compile("\\bALPHA\\s*=")
+	for shader: Shader in [WINDOW_GLASS,ELECTRIC_GLASS]:
+		check(alpha_write.search(shader.code) == null,"analytic glass does not enter transparent pipeline "+shader.resource_path)
+	var cars: Dictionary = {}
+	for id: String in VehicleCatalog.IDS:
+		var user_livery: Dictionary = VehicleLivery.defaults(id)
+		user_livery.colors = {"body":"9a3e50","accent":"e4b74c","detail":"507794"}
+		var saved: PackedByteArray = var_to_bytes(user_livery)
+		var car: CarVisual = await create_car(id,user_livery)
+		cars[id] = car
+		check(var_to_bytes(user_livery) == saved and var_to_bytes(car.livery) == saved,id+" saved pigment unchanged during construction")
+		for role: String in car.paint_materials:
+			var material: StandardMaterial3D = car.paint_materials[role]
+			check(material.albedo_color == Color(str(user_livery.colors[role])) and opaque(material),id+" opaque exact user pigment "+role)
+			check(finite_response(material),id+" finite finish "+role)
+		check(car.paint_materials.body != car.paint_materials.accent,id+" body/accent materials separated")
+		var bindings: Array[Dictionary] = glass_bindings(car)
+		if id in ["compact","electric","hovercraft"]:
+			check(not bindings.is_empty(),id+" native analytic glass is bound")
+			ShowroomStudio._studio_glass(car,{})
+			for binding: Dictionary in bindings:
+				var active: ShaderMaterial = binding.mesh.get_active_material(binding.surface)
+				check(active != binding.material and active.get_shader_parameter("studio_mode") == true,id+" showroom owns glass copy")
+				check(binding.material.get_shader_parameter("studio_mode") != true,id+" showroom preserves source/race glass")
+		if id == "super_rally":
+			var materials: Dictionary = SuperRallyModel._materials(car)
+			check(is_bound(car,materials.glass),"Challenger opaque glass is actually bound")
+			check(opaque(materials.glass) and materials.glass.specular_mode == BaseMaterial3D.SPECULAR_SCHLICK_GGX,"Challenger glass opacity and active specular")
+			check(materials.glass != materials.paint and materials.rubber != materials.paint and materials.chrome != materials.paint,"Challenger material roles separated")
+		if id == "forklift":
+			check(is_equal_approx(car.paint_materials.body.roughness,finishes.industrial.roughness),"Forklift uses industrial finish")
+			check(is_equal_approx(car.paint_materials.body.clearcoat,finishes.industrial.clearcoat),"Forklift retains restrained coating")
+	# A fresh race car must remain independent of an already styled showroom.
+	var race: CarVisual = await create_car("electric",VehicleLivery.defaults("electric"))
+	var race_bindings: Array[Dictionary] = glass_bindings(race)
+	check(not race_bindings.is_empty(),"fresh race has electric glass")
+	check(race.paint_materials.body != cars.electric.paint_materials.body,"per-car user paint isolation")
+	var showroom_color: Color = cars.electric.paint_materials.body.albedo_color
+	var race_livery: Dictionary = VehicleLivery.defaults("electric")
+	race_livery.colors.body = "164b86"
+	race.apply_livery(race_livery)
+	check(cars.electric.paint_materials.body.albedo_color == showroom_color,"race repaint preserves showroom pigment")
+	var lighting = RACE_GLASS.new()
+	lighting.configure(race,"night_city")
+	for binding: Dictionary in race_bindings:
+		var active: ShaderMaterial = binding.mesh.get_active_material(binding.surface)
+		check(active != binding.material and active.get_shader_parameter("night_mode") == true,"night glass owns copy")
+		check(active.get_shader_parameter("studio_mode") != true,"race uses world reflection instead of studio")
+		check(binding.material.get_shader_parameter("night_mode") != true and binding.material.get_shader_parameter("studio_mode") != true,"night/studio leave shared source untouched")
+	lighting.reset()
+	for binding: Dictionary in race_bindings:
+		check(binding.mesh.get_active_material(binding.surface) == binding.material,"day reset restores original glass binding")
+	check(configuration_hashes() == config_before,"all car and Compact profile files unchanged by model/material operations")
+	race.free()
+	for car: CarVisual in cars.values(): car.free()
+	await process_frame
+	print("VEHICLE_MATERIAL_FINISH: ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/game/tests/test_panel_contours.gd b/game/tests/test_panel_contours.gd
new file mode 100644
--- /dev/null
+++ b/game/tests/test_panel_contours.gd
@@ -0,0 +1,93 @@
+extends SceneTree
+## Verify actual flush backing and pixel coverage attributes at both detail tiers.
+const CONTOUR = preload("res://vehicle/panel_contour.gd")
+var checks: int = 0
+var failures: int = 0
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool,label: String) -> void:
+	checks += 1
+	if not ok: failures += 1; push_error(label)
+func run() -> void:
+	preload("res://vehicle/modular_car_base.gd").enabled=false
+	preload("res://vehicle/modular_car_kits.gd").enabled=false
+	preload("res://vehicle/prepared_car_cache.gd").enabled=false
+	preload("res://vehicle/electric_reference_mesh.gd").use_baked=false
+	for reduced: bool in [false,true]:
+		for id: String in ["electric","super_rally"]:
+			var car:=CarVisual.new()
+			car.vehicle_id=id;car.simple_model=reduced;car.batch_parts=false
+			root.add_child(car)
+			while not car.model_ready:await process_frame
+			var marked: int=0
+			for part: MeshInstance3D in car.find_children("*","MeshInstance3D",true,false):
+				var material: Material=part.material_override
+				if not material is ShaderMaterial or material.shader!=CONTOUR.SHADER:continue
+				marked+=1
+				var label: String=id+" "+str(part.name)+" reduced="+str(reduced)
+				check(part.cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_OFF,label+" markings do not cast artificial shadows")
+				var arrays: Array=part.mesh.surface_get_arrays(0)
+				var p: PackedVector3Array=arrays[Mesh.ARRAY_VERTEX]
+				var uv: PackedVector2Array=arrays[Mesh.ARRAY_TEX_UV]
+				var tangent: PackedFloat32Array=arrays[Mesh.ARRAY_TANGENT]
+				check(uv.size()==p.size() and tangent.size()==p.size()*4,label+" every contour vertex has coverage data")
+				var valid: bool=true
+				for i: int in range(p.size()):
+					valid=valid and absf(uv[i].x)==1.0 and uv[i].y>0.0 and uv[i].y<0.006
+				check(valid,label+" physical ribbon width stays below12mm with paired sides")
+				if id=="super_rally":
+					var source: ArrayMesh=load("res://assets/vehicles/challenger_hellcat_v1/"+("simple" if reduced else "full")+"_body_contour.res")
+					var original: Array=source.surface_get_arrays(0)
+					var original_p: PackedVector3Array=original[Mesh.ARRAY_VERTEX]
+					var original_indices: PackedInt32Array=original[Mesh.ARRAY_INDEX]
+					check(p.slice(0,original_p.size())==original_p and arrays[Mesh.ARRAY_INDEX].slice(0,original_indices.size())==original_indices,label+" original marking geometry remains exact")
+					check(p.size()-original_p.size()==200 and arrays[Mesh.ARRAY_INDEX].size()-original_indices.size()==600,label+" bonnet adds exactly100segments/200triangles")
+					check_bonnet(part,source,reduced,label)
+					continue
+				var skin: MeshInstance3D=car.find_child("ReferenceHood" if "Bonnet" in str(part.name) else "ReferenceSide-1_0" if "-1_0" in str(part.name) else "ReferenceSide1_0",true,false)
+				check(skin!=null,label+" matching backing exists")
+				if skin==null:continue
+				var tree: TriangleMesh=skin.mesh.generate_triangle_mesh()
+				var faces: PackedVector3Array=part.mesh.get_faces()
+				var buried: int=0;var minimum: float=INF
+				for offset: int in range(0,faces.size(),3):
+					var point: Vector3=(faces[offset]+faces[offset+1]+faces[offset+2])/3.0
+					var outward:=Vector3.UP if "Bonnet" in str(part.name) else Vector3(signf(point.x),0,0)
+					var hit: Dictionary=tree.intersect_ray(point+outward*0.1,-outward)
+					if hit.is_empty():continue
+					var gap: float=(point-hit.position).dot(outward)
+					minimum=minf(minimum,gap)
+					if gap<0.0:buried+=1
+				check(buried==0,label+" no contour triangle centroid sinks below the exterior; min_mm="+str(minimum*1000.0))
+			check(marked==(15 if id=="electric" else 1),id+" expected independent unbatched contour surfaces")
+			car.free();await process_frame
+	print("PANEL_CONTOURS: %d checks, %d failures" % [checks,failures])
+	quit(1 if failures else 0)
+
+func check_bonnet(part: MeshInstance3D,source: ArrayMesh,reduced: bool,label: String) -> void:
+	var outline: Dictionary=preload("res://assets/vehicles/challenger_hellcat_v1/bonnet_contour.json").data
+	var source_path: String="res://assets/vehicles/challenger_hellcat_v1/"+str(outline.source_mesh)
+	check(FileAccess.get_sha256(source_path)==outline.source_sha256,label+" outline provenance matches immutable native bonnet")
+	check(outline.points.size()==100 and float(outline.maximum_boundary_error_metres)<0.000875,label+" measured boundary fit stays below0.875mm")
+	var arrays: Array=part.mesh.surface_get_arrays(0)
+	var p: PackedVector3Array=arrays[Mesh.ARRAY_VERTEX]
+	var first: int=source.surface_get_arrays(0)[Mesh.ARRAY_VERTEX].size()
+	var fit: bool=true
+	for i: int in range(100):
+		var center: Vector3=(p[first+i*2]+p[first+i*2+1])*0.5
+		var target: Array=outline.points[i]
+		fit=fit and Vector2(center.x,center.z).distance_to(Vector2(target[0],target[2]))<0.000001
+	check(fit,label+" fitted marking retains measured bonnet boundary in plan")
+	var tier: String="simple" if reduced else "full"
+	var hood: TriangleMesh=(load("res://assets/vehicles/challenger_hellcat_v1/"+tier+"_hood_paint.res") as ArrayMesh).generate_triangle_mesh()
+	var body: TriangleMesh=(load("res://assets/vehicles/challenger_hellcat_v1/"+tier+"_body_paint.res") as ArrayMesh).generate_triangle_mesh()
+	var faces: PackedVector3Array=part.mesh.get_faces()
+	var original_faces: int=source.get_faces().size()
+	var buried: int=0;var minimum: float=INF
+	for offset: int in range(original_faces,faces.size(),3):
+		var center: Vector3=(faces[offset]+faces[offset+1]+faces[offset+2])/3.0
+		for skin: TriangleMesh in [hood,body]:
+			var hit: Dictionary=skin.intersect_ray(center+Vector3.UP*0.03,Vector3.DOWN)
+			if hit.is_empty():continue
+			minimum=minf(minimum,center.y-hit.position.y)
+			if center.y<hit.position.y:buried+=1
+	check(buried==0,label+" bonnet marking stays above both existing skins; minimum_mm="+str(minimum*1000.0))
