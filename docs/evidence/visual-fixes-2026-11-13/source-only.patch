+extends SceneTree
+## Actual six-car Garage/race integration in disposable local storage.
+var checks: int = 0
+var failures: int = 0
+var output: String
+func _initialize() -> void: run.call_deferred()
+func check(ok: bool, label: String) -> void:
+	checks+=1
+	if not ok: failures+=1; printerr("VISUAL_FINISH_APP_FAIL ",label)
+func settle(frames: int = 10) -> void:
+	for frame: int in range(frames):
+		await process_frame
+		await RenderingServer.frame_post_draw
+func triangles(node: Node) -> int:
+	var count: int = 0
+	if node is MeshInstance3D and node.is_visible_in_tree() and node.cast_shadow!=GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY: count+=node.mesh.get_faces().size()/3
+	for child: Node in node.get_children(): count+=triangles(child)
+	return count
+func run() -> void:
+	OS.set_environment("BMT_API_URL","")
+	output="res://../docs/evidence/visual-fixes-2026-11-13/app-"+RenderingServer.get_current_rendering_method()
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output))
+	root.size=Vector2i(1280,720)
+	for id: String in ["compact","kart","forklift","electric","hovercraft","super_rally"]:
+		var folder: String = ProjectSettings.globalize_path("res://../build/visual-fixes-2026-11-13/app/"+TrackLibrary.unique_id())
+		DirAccess.make_dir_recursive_absolute(folder)
+		var app: Node = load("res://core/app.tscn").instantiate()
+		app.records=LocalRecords.new(folder.path_join("records.json"))
+		app.records.settings.selected_car=id
+		app.library=TrackLibrary.new(folder)
+		app.cloud_root_override=folder.path_join("cloud")
+		root.add_child(app)
+		while not app.startup_complete: await process_frame
+		VehicleCatalog.selected=id
+		app._show_screen("garage")
+		await settle()
+		var page: GaragePage = app.root_ui.find_child("GaragePage",true,false)
+		check(page!=null,"actual Garage loads "+id)
+		page.open_car(VehicleCatalog.IDS.find(id))
+		while not page.showroom.showroom_ready or not page.showroom.car.model_ready: await process_frame
+		while page.showroom.get("preparing")==true: await process_frame
+		await settle(30)
+		check(page.showroom.car.vehicle_id==id,"Garage car identity "+id)
+		var direct := CarVisual.new()
+		direct.vehicle_id=id
+		root.add_child(direct)
+		while not direct.model_ready: await process_frame
+		check(triangles(page.showroom.car)==triangles(direct),"current Garage/direct geometry "+id)
+		var expected_triangles: int = triangles(direct)
+		direct.free()
+		check(root.get_texture().get_image().save_png(output+"/"+id+"-garage.png")==OK,"Garage capture "+id)
+		var track: NativeTrack = NativeTrack.read("res://resources/tracks/ellipse.json")
+		await app._start_race(track,true,true)
+		await settle(20)
+		var game: Node = app.game
+		game.set_physics_process(false)
+		game.countdown_label.hide()
+		check(game.handling.vehicle_id==id and game.car.vehicle_id==id,"race car and handling identity "+id)
+		check(game.handling.snapshot()==VehicleCatalog.config(id).snapshot(),"complete canonical race tune "+id)
+		check(triangles(game.car)==expected_triangles,"race retains current production geometry "+id)
+		if id=="kart":
+			var wheel: Node3D = game.car.find_child("SteeringAssembly",true,false)
+			var driver: MeshInstance3D = game.car.find_child("TomkartDriver",true,false)
+			for input: float in [-1.0,0.0,1.0,0.0]:
+				# A window can lose focus during parallel native runs. Advance the
+				# fixture tick so the paused-presentation cache sees changed state.
+				game.sim.state.tick+=1
+				game.sim.state.steering=input
+				game._present_frame(1.0/60.0)
+				check(wheel.basis.is_equal_approx(preload("res://vehicle/kart_steering.gd").REST*Basis(Vector3.UP,-input*PI/3)),"actual race steering wheel")
+				var weight: float = 0
+				for shape: int in range(driver.mesh.get_blend_shape_count()): weight+=driver.get_blend_shape_value(shape)
+				check(is_equal_approx(weight,absf(input)),"actual race ten-pose driver")
+		check(root.get_texture().get_image().save_png(output+"/"+id+"-race.png")==OK,"race capture "+id)
+		app.free()
+		await settle(12)
+		print("VISUAL_FINISH_APP_CAR ",id)
+	FileAccess.open(output+"/report.json",FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures}))
+	print("VISUAL_FINISH_APP ",checks," checks, ",failures," failures")
+	quit(1 if failures else 0)
diff --git a/docs/evidence/visual-fixes-2026-11-13/tooling/parse_production.gd b/docs/evidence/visual-fixes-2026-11-13/tooling/parse_production.gd
new file mode 100644
--- /dev/null
+++ b/docs/evidence/visual-fixes-2026-11-13/tooling/parse_production.gd
@@ -0,0 +1,33 @@
+extends SceneTree
+## Compile every project script in one engine process; never instantiate test entrypoints.
+var checked: int = 0
+var failed: bool = false
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func run() -> void:
+	scan("res://")
+	print("SCRIPT_PARSE: %d scripts, %d failures" % [checked,1 if failed else 0])
+	quit(1 if failed or checked == 0 else 0)
+
+func scan(path: String) -> void:
+	var directory := DirAccess.open(path)
+	if directory == null:
+		failed = true
+		return
+	# Match Godot's resource import boundary. Android's ignored Gradle template
+	# includes vendor instrumented-test assets that are not project scripts.
+	if directory.file_exists(".gdignore"): return
+	for filename: String in directory.get_files():
+		if not filename.ends_with(".gd") or filename == "test_script_parse.gd": continue
+		checked += 1
+		var script: GDScript = load(path.path_join(filename))
+		# Loading compiles the script and its dependencies. Reloading an autoload
+		# or another script with live instances is prohibited by the engine.
+		if script == null or not script.can_instantiate():
+			failed = true
+			print("FAIL: "+path.path_join(filename))
+	for child: String in directory.get_directories():
+		if child.begins_with(".") or child == "tests": continue
+		scan(path.path_join(child))
diff --git a/docs/evidence/visual-fixes-2026-11-13/tooling/bake_static.gd b/docs/evidence/visual-fixes-2026-11-13/tooling/bake_static.gd
new file mode 100644
--- /dev/null
+++ b/docs/evidence/visual-fixes-2026-11-13/tooling/bake_static.gd
@@ -0,0 +1,79 @@
+extends SceneTree
+const R = preload("res://vehicle/car_static_reduction.gd")
+const Base = preload("res://vehicle/modular_car_base.gd")
+const Kits = preload("res://vehicle/modular_car_kits.gd")
+const Cache = preload("res://vehicle/prepared_car_cache.gd")
+const OUT = "res://../docs/evidence/visual-fixes-2026-11-13"
+var baker = preload("res://tests/support/car_static_reduction_bake.gd").new()
+
+func _initialize() -> void: run.call_deferred()
+
+func car_for(id: String, editable: bool, batch: bool = true) -> CarVisual:
+	var car := CarVisual.new()
+	car.vehicle_id=id
+	car.simple_model=true
+	car.editable_kits=editable
+	car.batch_parts=batch
+	car.cache_rest_pose=false
+	car.livery=VehicleLivery.defaults(id)
+	car.customisation=VehicleCustomisation.defaults()
+	return car
+
+func hover_far(editable: bool) -> void:
+	R.enabled=false
+	var near_car: CarVisual = car_for("hovercraft",editable)
+	root.add_child(near_car)
+	while not near_car.model_ready: await process_frame
+	var far_car: CarVisual = car_for("hovercraft",editable,false)
+	root.add_child(far_car)
+	while not far_car.model_ready: await process_frame
+	for part: MeshInstance3D in far_car.find_children("*","MeshInstance3D",true,false):
+		if str(part.name).begins_with("SportSkirtSeam"): part.mesh=baker.half_seam(part.mesh)
+	await VisualGeometry.batch_static_parts(far_car)
+	await VisualGeometry.batch_car_parts(far_car)
+	Cache._stable_names(near_car)
+	Cache._stable_names(far_car)
+	var reductions: int = 0
+	for part: MeshInstance3D in near_car.find_children("*","MeshInstance3D",true,false):
+		if not part.mesh is ArrayMesh or part.cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY: continue
+		var other: MeshInstance3D = far_car.get_node_or_null(near_car.get_path_to(part))
+		assert(other!=null,"Far model must retain every attachment")
+		if other.mesh.get_faces().size()==part.mesh.get_faces().size(): continue
+		var result: ArrayMesh = preload("res://rendering/mesh_vertex_packing.gd").with_detail(part.mesh,other.mesh,0.005)
+		assert(result!=part.mesh,"Hover far sampling must be installed")
+		result.set_meta("car_authored_far",true)
+		baker.publish(part.mesh,result,"hovercraft")
+		reductions+=1
+	assert(reductions>0)
+	near_car.free()
+	far_car.free()
+	R.enabled=true
+
+func run() -> void:
+	Base.enabled=false
+	Kits.enabled=false
+	Cache.enabled=false
+	preload("res://ui/garage_car_cache.gd").enabled=false
+	R.offline=baker.create
+	for id: String in ["compact","kart","electric"]:
+		for editable: bool in [false,true]:
+			var car: CarVisual = car_for(id,editable)
+			root.add_child(car)
+			while not car.model_ready: await process_frame
+			if editable:
+				for category: String in VehicleCustomisation.CATEGORIES:
+					for option: Array in VehicleCustomisation.options(category,id):
+						var choices: Dictionary = car.customisation.duplicate()
+						choices[category]=option[0]
+						car.change_kit_parts(choices)
+					var choices: Dictionary = car.customisation.duplicate()
+					choices[category]="stock"
+					car.change_kit_parts(choices)
+			car.free()
+			await process_frame
+		print("CAR_STATIC_BAKE ",id)
+	R.offline=Callable()
+	for editable: bool in [false,true]: await hover_far(editable)
+	FileAccess.open(OUT+"/static-bake.json",FileAccess.WRITE).store_string(JSON.stringify({"resources":baker.observations},"\t"))
+	print("CAR_STATIC_BAKE resources=",baker.observations.size())
+	quit()
