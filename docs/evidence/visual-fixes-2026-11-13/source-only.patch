new file mode 100644
--- /dev/null
+++ b/game/vehicle/kart_driver_cloth.gdshader
@@ -0,0 +1,53 @@
+shader_type spatial;
+render_mode diffuse_burley, specular_schlick_ggx;
+
+// Imported garment colours and UVs remain attached to every steering pose.
+// Fine weave fades before becoming subpixel; there is no animated noise,
+// displacement, extra draw pass or texture allocation.
+varying vec3 garment_position;
+
+vec3 display_to_linear(vec3 colour) {
+	return mix(colour / 12.92, pow((colour + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), colour));
+}
+
+void vertex() {
+	garment_position = VERTEX;
+}
+
+void fragment() {
+	vec3 source = COLOR.rgb;
+	vec3 pigment = clamp(vec3(0.29, 0.35, 0.38) + (source - vec3(0.2745, 0.3451, 0.3804)) * 1.50, vec3(0.05), vec3(0.70));
+	float front = smoothstep(0.055, 0.115, garment_position.z)
+		* (1.0 - smoothstep(0.34, 0.40, garment_position.z));
+	// Broad tailored torso insert. The mask stays within the fixed chest, away
+	// from the moving sleeves and their existing cuff/elbow colour panels.
+	float chest = (1.0 - smoothstep(0.12, 0.17, abs(garment_position.x)))
+		* smoothstep(0.52, 0.60, garment_position.y)
+		* (1.0 - smoothstep(0.74, 0.79, garment_position.y))
+		* front;
+	pigment = mix(pigment, pigment * 1.16, chest);
+	float yoke = smoothstep(0.705, 0.725, garment_position.y)
+		* (1.0 - smoothstep(0.785, 0.805, garment_position.y))
+		* (1.0 - smoothstep(0.17, 0.22, abs(garment_position.x))) * front;
+	pigment = mix(pigment, vec3(0.46, 0.50, 0.50), yoke * 0.82);
+	// Sewn torso panel edges are a few millimetres wide and softly filtered.
+	float edge_width = max(fwidth(garment_position.x), 0.0015);
+	float edge = 1.0 - smoothstep(0.002, 0.0035 + edge_width, abs(abs(garment_position.x) - 0.123));
+	edge *= smoothstep(0.53, 0.58, garment_position.y)
+		* (1.0 - smoothstep(0.70, 0.74, garment_position.y)) * front;
+	pigment = mix(pigment, vec3(0.45, 0.49, 0.50), edge * 0.48);
+	// The lower boot is part of the original suit surface. Separate its rubber
+	// and leather response without splitting, moving or rebuilding that mesh.
+	float boot = (1.0 - smoothstep(0.28, 0.34, garment_position.y))
+		* (1.0 - smoothstep(-0.64, -0.54, garment_position.z));
+	pigment = mix(pigment, vec3(0.105, 0.14, 0.155), boot);
+	vec2 weave_uv = UV * 220.0;
+	vec2 footprint = fwidth(weave_uv);
+	float resolved = 1.0 - smoothstep(0.18, 0.50, max(footprint.x, footprint.y));
+	float weave = sin(weave_uv.x * 6.2831853) * sin(weave_uv.y * 6.2831853);
+	pigment *= 1.0 + weave * 0.035 * resolved * (1.0 - boot);
+	ALBEDO = OUTPUT_IS_SRGB ? pigment : display_to_linear(pigment);
+	METALLIC = 0.0;
+	ROUGHNESS = mix(0.93, 0.72, boot);
+	SPECULAR = mix(0.14, 0.22, boot);
+}
diff --git a/game/vehicle/panel_contour.gd b/game/vehicle/panel_contour.gd
new file mode 100644
--- /dev/null
+++ b/game/vehicle/panel_contour.gd
@@ -0,0 +1,102 @@
+extends RefCounted
+## Pixel-integrated flush contours. Positions and centre lines remain exact.
+const SHADER = preload("res://vehicle/panel_contour.gdshader")
+static var meshes: Dictionary = {}
+static var materials: Dictionary = {}
+
+static func material(source: StandardMaterial3D) -> ShaderMaterial:
+	var color: Color = source.albedo_color
+	if not materials.has(color):
+		if materials.size() >= 16: materials.clear()
+		var result := ShaderMaterial.new()
+		result.shader = SHADER
+		result.set_shader_parameter("contour_color", color)
+		materials[color] = result
+	return materials[color]
+
+static func mesh(source: ArrayMesh) -> ArrayMesh:
+	if source.has_meta("pixel_integrated_contour"): return source
+	if meshes.has(source): return meshes[source]
+	if meshes.size() >= 128: meshes.clear()
+	var result := ArrayMesh.new()
+	for surface: int in range(source.get_surface_count()):
+		var arrays: Array = source.surface_get_arrays(surface)
+		var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
+		var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
+		if indices.is_empty():
+			indices.resize(vertices.size())
+			for i: int in range(vertices.size()): indices[i] = i
+		# Imported strips can duplicate a position for corner normals. Weld only
+		# the topology lookup; the actual render buffers keep those normals.
+		var canonical := PackedInt32Array()
+		canonical.resize(vertices.size())
+		var positions: Dictionary = {}
+		for i: int in range(vertices.size()):
+			var p: Vector3 = vertices[i].snapped(Vector3.ONE*0.000001)
+			if not positions.has(p): positions[p] = i
+			canonical[i] = positions[p]
+		var edge_counts: Dictionary = {}
+		for offset: int in range(0,indices.size(),3):
+			for corner: int in range(3):
+				var a: int = canonical[indices[offset+corner]]
+				var b: int = canonical[indices[offset+(corner+1)%3]]
+				var edge := Vector2i(mini(a,b),maxi(a,b))
+				edge_counts[edge] = int(edge_counts.get(edge,0))+1
+		var partner := PackedInt32Array()
+		partner.resize(vertices.size()); partner.fill(-1)
+		var distance := PackedFloat64Array()
+		distance.resize(vertices.size()); distance.fill(INF)
+		for edge: Vector2i in edge_counts:
+			# In a closed ribbon the one-face edges run along its boundaries.
+			# Paired edges and diagonals are internal; the pair is the shorter.
+			if int(edge_counts[edge]) != 2: continue
+			var a: int = edge.x; var b: int = edge.y
+			var squared: float = vertices[a].distance_squared_to(vertices[b])
+			if squared < 1e-14: continue
+			if squared < distance[a]: distance[a] = squared; partner[a] = b
+			if squared < distance[b]: distance[b] = squared; partner[b] = a
+		var pairs: Dictionary = {}
+		var member := PackedInt32Array()
+		member.resize(vertices.size()); member.fill(-1)
+		for a: int in range(vertices.size()):
+			var original: int = canonical[a]
+			var b: int = partner[original]
+			assert(b >= 0 and partner[b] == original, "Contour topology requires paired ribbon edges")
+			var key: int = mini(original, b)
+			member[a] = key
+			if not pairs.has(key): pairs[key] = {"a":key,"b":maxi(original,b),"neighbors":[],"sign":0.0}
+		for offset: int in range(0, indices.size(), 3):
+			for corner: int in range(3):
+				var a: int = member[indices[offset + corner]]
+				var b: int = member[indices[offset + (corner + 1) % 3]]
+				if a != b and b not in pairs[a].neighbors: pairs[a].neighbors.append(b)
+		for start: int in pairs:
+			if pairs[start].sign != 0.0: continue
+			pairs[start].sign = 1.0
+			var queue: Array[int] = [start]
+			var cursor: int = 0
+			while cursor < queue.size():
+				var a: Dictionary = pairs[queue[cursor]]; cursor += 1
+				var direction: Vector3 = (vertices[a.b] - vertices[a.a]) * float(a.sign)
+				for next: int in a.neighbors:
+					var b: Dictionary = pairs[next]
+					if b.sign != 0.0: continue
+					b.sign = 1.0 if direction.dot(vertices[b.b] - vertices[b.a]) >= 0.0 else -1.0
+					queue.append(next)
+		var uv := PackedVector2Array()
+		uv.resize(vertices.size())
+		var tangents := PackedFloat32Array()
+		tangents.resize(vertices.size() * 4)
+		for i: int in range(vertices.size()):
+			var half: Vector3 = (vertices[i] - vertices[partner[canonical[i]]]) * 0.5
+			var direction: Vector3 = half.normalized()
+			var pair: Dictionary = pairs[member[i]]
+			uv[i] = Vector2(float(pair.sign) * (-1.0 if canonical[i] == pair.a else 1.0), half.length())
+			for axis: int in range(3): tangents[i * 4 + axis] = direction[axis]
+			tangents[i * 4 + 3] = 1.0
+		arrays[Mesh.ARRAY_TEX_UV] = uv
+		arrays[Mesh.ARRAY_TANGENT] = tangents
+		result.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+	result.set_meta("pixel_integrated_contour", true)
+	meshes[source] = result
+	return result
diff --git a/game/vehicle/panel_contour.gdshader b/game/vehicle/panel_contour.gdshader
new file mode 100644
--- /dev/null
+++ b/game/vehicle/panel_contour.gdshader
@@ -0,0 +1,30 @@
+shader_type spatial;
+render_mode blend_mix, depth_draw_never, cull_disabled;
+
+// The original ribbon width is integrated over a pixel rather than sampled
+// as alternating covered/uncovered pixels. The support is presentation-only.
+uniform vec4 contour_color : source_color = vec4(0.08, 0.11, 0.13, 1.0);
+varying float across_pixels;
+varying float half_width_pixels;
+
+void vertex() {
+	vec4 edge = PROJECTION_MATRIX * MODELVIEW_MATRIX * vec4(VERTEX, 1.0);
+	vec3 center_position = VERTEX - TANGENT.xyz * UV.y;
+	vec4 center = PROJECTION_MATRIX * MODELVIEW_MATRIX * vec4(center_position, 1.0);
+	vec2 delta_pixels = (edge.xy / edge.w - center.xy / center.w) * VIEWPORT_SIZE * 0.5;
+	float original_half = length(delta_pixels);
+	float support_half = max(original_half + 0.65, 1.0);
+	vec2 direction = delta_pixels / max(original_half, 0.00001);
+	edge.xy += direction * (support_half - original_half) * 2.0 / VIEWPORT_SIZE * edge.w;
+	POSITION = edge;
+	across_pixels = UV.x * support_half;
+	half_width_pixels = original_half;
+}
+
+void fragment() {
+	float coverage = clamp(half_width_pixels + 0.5 - abs(across_pixels), 0.0, min(1.0, half_width_pixels * 2.0));
+	ALBEDO = contour_color.rgb;
+	ROUGHNESS = 0.9;
+	SPECULAR = 0.0;
+	ALPHA = contour_color.a * coverage;
+}
diff --git a/game/vehicle/challenger_panel_contours.gd b/game/vehicle/challenger_panel_contours.gd
new file mode 100644
--- /dev/null
+++ b/game/vehicle/challenger_panel_contours.gd
@@ -0,0 +1,61 @@
+extends RefCounted
+## Flush marking over the native bonnet gap; original exterior stays immutable.
+const CONTOUR = preload("res://vehicle/panel_contour.gd")
+const OUTLINE = preload("res://assets/vehicles/challenger_hellcat_v1/bonnet_contour.json")
+static var meshes: Dictionary = {}
+
+static func mesh(source: ArrayMesh,simple: bool) -> ArrayMesh:
+	if meshes.has(source): return meshes[source]
+	if meshes.size() >= 4: meshes.clear()
+	var base: ArrayMesh = CONTOUR.mesh(source)
+	var arrays: Array = base.surface_get_arrays(0)
+	var p: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
+	var n: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL]
+	var uv: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV]
+	var tangent: PackedFloat32Array = arrays[Mesh.ARRAY_TANGENT]
+	var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
+	var first: int = p.size()
+	var outline: Array = OUTLINE.data.points
+	var count: int = outline.size()
+	var tier: String = "simple" if simple else "full"
+	var hood: TriangleMesh = (load("res://assets/vehicles/challenger_hellcat_v1/"+tier+"_hood_paint.res") as ArrayMesh).generate_triangle_mesh()
+	var body: TriangleMesh = (load("res://assets/vehicles/challenger_hellcat_v1/"+tier+"_body_paint.res") as ArrayMesh).generate_triangle_mesh()
+	for i: int in range(count):
+		var previous: Array = outline[posmod(i-1,count)]
+		var current: Array = outline[i]
+		var next: Array = outline[(i+1)%count]
+		var direction := Vector3(next[0]-previous[0],next[1]-previous[1],next[2]-previous[2])
+		var across: Vector3 = direction.cross(Vector3.UP).normalized()
+		var center := Vector3(current[0],current[1],current[2])
+		var row: Array[Vector3] = []
+		for side: float in [-1.0,1.0]:
+			var point: Vector3 = center+across*side*0.00125
+			# Border returns and bonnet are separate native skins. Fit to the
+			# outer one at each edge, retaining their existing physical join.
+			for skin: TriangleMesh in [hood,body]:
+				var hit: Dictionary = skin.intersect_ray(point+Vector3.UP*0.03,Vector3.DOWN)
+				if not hit.is_empty(): point.y=maxf(point.y,hit.position.y)
+			point.y+=0.0018
+			row.append(point)
+		var half: Vector3 = (row[1]-row[0])*0.5
+		for index: int in range(2):
+			var side: float = -1.0 if index == 0 else 1.0
+			p.append(row[index])
+			n.append(Vector3.UP)
+			uv.append(Vector2(side,half.length()))
+			var t: Vector3 = half.normalized()*side
+			tangent.append_array(PackedFloat32Array([t.x,t.y,t.z,1.0]))
+		var a: int = first+i*2
+		var b: int = first+((i+1)%count)*2
+		indices.append_array(PackedInt32Array([a,b+1,a+1,a,b,b+1]))
+	arrays[Mesh.ARRAY_VERTEX]=p; arrays[Mesh.ARRAY_NORMAL]=n
+	arrays[Mesh.ARRAY_TEX_UV]=uv; arrays[Mesh.ARRAY_TANGENT]=tangent
+	arrays[Mesh.ARRAY_INDEX]=indices
+	arrays[Mesh.ARRAY_COLOR]=null; arrays[Mesh.ARRAY_TEX_UV2]=null
+	var result := ArrayMesh.new()
+	result.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
+	result.set_meta("pixel_integrated_contour",true)
+	result.set_meta("original_contour_vertices",first)
+	result.set_meta("bonnet_segments",count)
+	meshes[source]=result
+	return result
