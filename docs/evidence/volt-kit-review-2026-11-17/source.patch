+    files={name:dict(before_sha256=digest(before[name]) if name in before else None,sha256=digest(data)) for name,data in after.items()},
+    scope='Authored Volt kit surface fitting, hood field and source bank, rear coverage and wing/disc repairs, tooling, regressions and task documentation. Derived scenes/pictures require rebuilding after reversal. Concurrent work excluded.')
+(OUT/'source-checkpoint.json').write_text(json.dumps(receipt,indent=2)+'\n')
+print(json.dumps({k:v for k,v in receipt.items() if k!='files'}))
