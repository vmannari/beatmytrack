+		var p: Vector3=cap_point(true,u,0.55)+Vector3(0,0,-0.024)
+		rounded(car.body,"PlateBolt"+str(u),Vector3(0.009,0.009,0.004),p,0.003,metal)
+	cap_band(car,"RearDiffuser",true,0.12,0.88,0.028,0.15,trim,0.008)
+	for x: float in [-0.54,-0.27,0.27,0.54]: rounded(car.body,"DiffuserVane"+str(x),Vector3(0.009,0.053,0.16),Vector3(x,0.300,rear_z(x,0.300)-0.06),0.003,trim)
+	for side: float in [-1.0,1.0]:
+		cap_band(car,"RearReflector"+str(side),true,0.075 if side<0 else 0.85,0.15 if side<0 else 0.925,0.16,0.174,car.brake_material,0.002)
+	for index: int in range(4):
+		var mark: Vector3=cap_point(true,0.5+(index-1.5)*0.016,0.68)+Vector3.BACK*0.003
+		rounded(car.body,"TailSignature"+str(index),Vector3(0.022,0.018,0.004),mark,0.005,metal)
+
+static func door_outline(front_door: bool) -> Array[Vector2]:
+	var points: Array[Vector2]=[]
+	var b: float=canopy_point(1,0.465).z
+	var a: float=canopy_point(1,0.045).z if front_door else b
+	var c: float=b if front_door else canopy_point(1,SIDE_GLASS_END).z
+	points.assign([Vector2(a,shoulder_height(a)),Vector2(-0.73-WINDSCREEN_ADVANCE if front_door else b,0.39),Vector2(b if front_door else 0.89,0.39),Vector2(c,shoulder_height(c))])
+	return points
+
+static func door_lower_edge(points: Array[Vector2],edge: int,t: float) -> Vector2:
+	var start: Vector2=points[edge]
+	var finish: Vector2=points[edge+1]
+	if edge>0: start+=(finish-start).normalized()*0.035
+	if edge==2: return start.lerp(finish,t)
+	var before: Vector2=finish+(points[edge]-finish).normalized()*0.035
+	var after: Vector2=finish+(points[edge+2]-finish).normalized()*0.035
+	if t<0.84: return start.lerp(before,t/0.84)
+	var q: float=(t-0.84)/0.16
+	return before*pow(1-q,2)+2*finish*q*(1-q)+after*q*q
+
+static func door_boundary(side: float,boundary: int,h: float) -> Vector3:
+	var u: float=lerpf(FRONT_GLASS_LEAD-0.01,FRONT_GLASS_TOP-0.01,clampf((h-0.13)/0.77,0,1)) if boundary==0 else 0.465 if boundary==1 else SIDE_GLASS_END
+	return cabin_side(side,u,h)+Vector3(side*0.0018,0.0018,0)
+
+static func doors(car: CarVisual,side: float,trim: Material,metal: Material) -> void:
+	for front_door: bool in [true,false]:
+		var points: Array[Vector2]=door_outline(front_door)
+		for index: int in range(3):
+			ribbon(car.body,"DoorCut"+str(side)+str(front_door)+str(index),func(t: float)->Vector3:
+				var p: Vector2=door_lower_edge(points,index,t)
+				return side_point(side,p.x,p.y)+Vector3(side*0.0008,0.0018,0),24,0.0014,trim,car.simple_model)
+		ribbon(car.body,"DoorRoofCut"+str(side)+str(front_door),func(t: float)->Vector3:
+			return cabin_side(side,lerpf(FRONT_GLASS_TOP-0.01 if front_door else 0.465,0.465 if front_door else SIDE_GLASS_END,t),0.97)+Vector3(side*0.0018,0.0018,0),24,0.0014,trim,car.simple_model)
+		var z: float=points[3].x-0.17
+		patch(car.body,"FlushHandle"+str(side)+str(front_door),16,4,func(u: float,v: float)->Vector3:
+			var yy: float=0.874+0.013*(2*v-1)*sqrt(maxf(0.001,1-pow(2*u-1,8)))
+			return side_point(side,z+lerpf(-0.072,0.072,u),yy)+Vector3(side*0.002,0,0),trim,Vector3(side,0,0),car.simple_model)
+		patch(car.body,"HandleFace"+str(side)+str(front_door),12,2,func(u: float,v: float)->Vector3:
+			return side_point(side,z+lerpf(-0.060,0.060,u),0.874+lerpf(-0.004,0.004,v))+Vector3(side*0.003,0,0),metal,Vector3(side,0,0),car.simple_model)
+	for boundary: int in range(3):
+		ribbon(car.body,"DoorPillarCut"+str(side)+str(boundary),func(t: float)->Vector3:return door_boundary(side,boundary,0.97*t),24,0.0014,trim,car.simple_model)
+
+static func mirror(car: CarVisual,side: float,accent: Material,trim: Material,glass: Material) -> void:
+	rounded(car.body,"MirrorStalk"+str(side),Vector3(0.10,0.025,0.07),Vector3(side*0.883,1.014,-0.65-WINDSCREEN_ADVANCE),0.010,trim)
+	patch(car.body,"MirrorShell"+str(side),32,16,func(u: float,v: float)->Vector3:
+		var theta: float=TAU*u
+		var phi: float=PI*v
+		return Vector3(side*1.00+0.139*sin(phi)*cos(theta),1.058+0.047*cos(phi),-0.635-WINDSCREEN_ADVANCE+0.101*sin(phi)*sin(theta)),accent,Vector3(side,0.3,-0.3),car.simple_model,Callable(),func(u: float,v: float)->Vector3:return Vector3(sin(PI*v)*cos(TAU*u)/0.139,cos(PI*v)/0.047,sin(PI*v)*sin(TAU*u)/0.101).normalized())
+	patch(car.body,"MirrorGlass"+str(side),16,8,func(u: float,v: float)->Vector3:
+		var a: float=2*u-1
+		return Vector3(side*1.00+0.112*a,1.057+0.033*(2*v-1)*sqrt(maxf(0.001,1-a*a)),-0.550-WINDSCREEN_ADVANCE+0.004*a*a),glass,Vector3.BACK,car.simple_model)
