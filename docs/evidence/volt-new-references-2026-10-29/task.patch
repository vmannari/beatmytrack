+static func cabin_side(side: float,u: float,v: float) -> Vector3:
+	var p: Vector3=cabin_section(side,u,v)
+	var z: float=p.z
+	# The waist belongs to the body and must not sag with the rear canopy.
+	var old_sill: Vector3=cabin_section(side,u,0.13)
+	var sill:=Vector3(side*(top_width(z)-0.025),shoulder_height(z)+0.035,z)
+	var blend: float=ease5(v/0.13) if v<=0.13 else 1-ease5((v-0.13)/0.87)
+	p+=(sill-old_sill)*blend*ease5((u-0.015)/0.04)*(1-ease5((u-0.90)/0.10))
+	return p
