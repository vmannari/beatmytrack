+	var after: Vector2=q+(next-q).normalized()*radius
+	if t<0.84: return start.lerp(before,t/0.84)
+	var v: float=(t-0.84)/0.16
+	return before*pow(1-v,2)+2*q*v*(1-v)+after*v*v
