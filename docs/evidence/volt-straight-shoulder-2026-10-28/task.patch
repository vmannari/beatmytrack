+static func rear_apron_point(u: float,t: float) -> Vector3:
+	var a: float=2*u-1
+	var start: Vector3=rear_window_bottom(u)
+	var x: float=a*0.86
+	var end:=Vector3(x,deck_height(x,REAR_DECK_JOIN),REAR_DECK_JOIN)
+	var h: float=0.001
+	var q: float=x/top_width(REAR_DECK_JOIN)
