+						tool.set_uv(t)
+						tool.add_vertex(p[index])
+		tool.index()
+		tool.generate_tangents()
+		meshes[key]=tool.commit()
+	var node:=MeshInstance3D.new()
+	node.name=label
+	node.mesh=meshes[key]
+	node.material_override=material
+	parent.add_child(node)
