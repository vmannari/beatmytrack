+	for row: Dictionary in model.standing(): _table_row(rows,row,str(row.points)+" pts")
+	var context: VBoxContainer = _card(parent,"winter",26)
+	_copy(context,"THE CHAMPIONSHIP",18,MenuStyle.MUTED)
