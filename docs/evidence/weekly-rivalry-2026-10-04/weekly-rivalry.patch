+	_route(scene,selected,100)
+	_copy(scene,"5 laps · "+VehicleCatalog.title(model.vehicle_id),18,MenuStyle.MUTED)
+	var board: VBoxContainer = _card(parent,"",14)
+	_copy(board,"YOUR POSITION",18,MenuStyle.MUTED)
