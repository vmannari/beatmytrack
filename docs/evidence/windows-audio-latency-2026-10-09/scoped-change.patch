diff --git a/scripts/review_windows_audio_export.py b/scripts/review_windows_audio_export.py
new file mode 100644
index 00000000..313f7d03
--- /dev/null
+++ b/scripts/review_windows_audio_export.py
@@ -0,0 +1,18 @@
+"""Verify that the actual Android content export excludes native Windows audio."""
+from pathlib import Path
+import json,zipfile
+ROOT=Path(__file__).resolve().parents[1]
+archive=ROOT/"build/windows_audio/android-content.zip"
+with zipfile.ZipFile(archive) as z:
+    names=z.namelist()
+    windows=[name for name in names if "platform/windows/" in name or name.endswith(".dll") or name.endswith(".gdextension")]
+    assert not windows,windows
+    assert "platform/windows_impact_audio.gdc" in names,"safe platform guard must remain available to VehicleAudio"
+    assert "vehicle/vehicle_audio.gdc" in names,"ordinary cross-platform vehicle sound code must remain"
+    extension_list=[name for name in names if name.endswith("extension_list.cfg")]
+    for name in extension_list:
+        assert b"platform/windows" not in z.read(name)
+report=dict(checks=3+len(extension_list),failures=0,zip_bytes=archive.stat().st_size,files=len(names),windows_files=windows,extension_lists=extension_list,
+            limits="Local Android content ZIP only; no APK export/install or physical Android audio test.")
+(ROOT/"build/windows_audio/export-review.json").write_text(json.dumps(report,indent=2)+"\n",encoding="utf-8")
+print(json.dumps(report,indent=2))
diff --git a/scripts/review_windows_audio_output.py b/scripts/review_windows_audio_output.py
new file mode 100644
index 00000000..b8d2c522
--- /dev/null
+++ b/scripts/review_windows_audio_output.py
@@ -0,0 +1,49 @@
+"""Compare own-process WASAPI packet timestamps with Godot collision requests."""
+from pathlib import Path
+import csv
+import json
+import sys
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = Path(sys.argv[1]).resolve() if len(sys.argv)>1 else ROOT / "build/audio-output-2026-10-09"
+events = json.loads((OUT / "events.json").read_text())
+samples = np.frombuffer((OUT / "loopback.pcm").read_bytes(),dtype="<i2").astype(np.float64).reshape(-1,2)/32768.0
+with (OUT / "packets.csv").open() as handle:
+    packets = list(csv.DictReader(handle))
+rate = 48000
+rows = []
+for event in events:
+    request = event["unix_us"]
+    found = []
+    pretrigger_peak = 0.0
+    for packet in packets:
+        if int(packet["flags"]) & 4:
+            continue # Invalid timestamp is never accepted as timing evidence.
+        offset,count = int(packet["frame_offset"]),int(packet["frames"])
+        start = float(packet["utc_us"])
+        if start+count/rate*1e6<request-50000 or start>request+500000:
+            continue
+        values = np.max(np.abs(samples[offset:offset+count]),axis=1)
+        timestamps = start+np.arange(count)/rate*1e6
+        before = (timestamps>=request-50000)&(timestamps<request)
+        if before.any(): pretrigger_peak = max(pretrigger_peak,float(np.max(values[before])))
+        threshold = .01
+        indexes = np.flatnonzero(values>threshold)
+        for index in indexes:
+            timestamp = start+float(index)/rate*1e6
+            if request<=timestamp<=request+500000:
+                found.append(timestamp)
+                break
+    if pretrigger_peak>.01:
+        raise ValueError("Pre-trigger audio contaminates trial "+str(event["trial"])+": "+str(pretrigger_peak))
+    if not found:
+        raise ValueError("No valid own-process output near trial "+str(event["trial"]))
+    onset = min(found)
+    rows.append(dict(trial=event["trial"],request_unix_us=request,output_unix_us=onset,latency_ms=(onset-request)/1000.0,
+                     engine_reported_ms=event["reported_latency_ms"],next_mix_ms=event["next_mix_ms"]))
+report = dict(process_only=True,microphone=False,other_application_audio=False,rows=rows,
+              median_ms=float(np.median([x["latency_ms"] for x in rows])),minimum_ms=min(x["latency_ms"] for x in rows),maximum_ms=max(x["latency_ms"] for x in rows),
+              limits="Windows process-loopback, before physical speaker/headphone/Bluetooth hardware.")
+(OUT / "timing-report.json").write_text(json.dumps(report,indent=2)+"\n",encoding="utf-8")
+print(json.dumps(report,indent=2))
diff --git a/scripts/review_windows_impact_controls.py b/scripts/review_windows_impact_controls.py
new file mode 100644
index 00000000..5e028a34
--- /dev/null
+++ b/scripts/review_windows_impact_controls.py
@@ -0,0 +1,32 @@
+"""Actual Windows process output checks, including mute and overlapping peaks."""
+from pathlib import Path
+import csv,json
+import numpy as np
+ROOT=Path(__file__).resolve().parents[1]
+OUT=ROOT/"build/audio-output-2026-10-09/controls"
+events=json.loads((OUT/"events.json").read_text())
+audio=np.frombuffer((OUT/"loopback.pcm").read_bytes(),dtype="<i2").reshape(-1,2)/32768.0
+with (OUT/"packets.csv").open() as f:
+    packets=list(csv.DictReader(f))
+rows=[]
+for event in events:
+    sections=[]
+    for packet in packets:
+        if int(packet["flags"])&4: continue
+        offset,count=int(packet["frame_offset"]),int(packet["frames"])
+        timestamps=float(packet["utc_us"])+np.arange(count)/48000*1e6
+        selected=(timestamps>=event["unix_us"]+20000)&(timestamps<event["unix_us"]+600000)
+        if selected.any(): sections.append(audio[offset:offset+count][selected])
+    data=np.concatenate(sections)
+    rows.append(dict(mode=event["mode"],peak=float(np.max(np.abs(data))),rms=float(np.sqrt(np.mean(data**2))),full_scale_samples=int(np.sum(np.abs(data)>=.999)),native=event["native"]))
+by={r["mode"]:r for r in rows}
+for mode in ["vehicle-mute","master-mute","paused","countdown"]:
+    assert by[mode]["peak"]<1e-4,(mode,by[mode])
+assert .26<by["volume-30"]["rms"]/by["full"]["rms"]<.34,"actual output must follow 30% Vehicle gain"
+assert by["full"]["peak"]>.1,"full impact must produce actual output"
+assert by["overlap"]["peak"]<=.795,"four-voice output retains the impact ceiling"
+assert all(r["full_scale_samples"]==0 for r in rows),"mixed engine/impact output must not clip"
+assert by["engine-mix"]["rms"]>0.01,"real engine/impact mix is present"
+report=dict(checks=9,failures=0,rows=rows,limits="Own-process Windows output, not an acoustic microphone measurement.")
+(OUT/"review.json").write_text(json.dumps(report,indent=2)+"\n",encoding="utf-8")
+print(json.dumps(report,indent=2))
diff --git a/scripts/windows_native_audio_pulse.cs b/scripts/windows_native_audio_pulse.cs
