@@ -0,0 +1,86 @@
+"""Original harsh winter gale sound design, rendered offline into lossless loops."""
+from pathlib import Path
+import hashlib
+import json
+import wave
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+BANK = ROOT / "game/assets/audio/ambience"
+RATE = 44100
+
+
+def texture(rng, count, low, high):
+    hz = np.fft.rfftfreq(count, 1 / RATE)
+    spectrum = np.fft.rfft(rng.standard_normal(count))
+    spectrum *= (1 - np.exp(-(hz / low) ** 4)) * np.exp(-(hz / high) ** 4)
+    result = np.fft.irfft(spectrum, n=count)
+    return result / np.sqrt(np.mean(result ** 2))
+
+
+def envelope(rng, count, seconds, floor):
+    time = np.arange(count, dtype=np.float64) / RATE
+    values = sum(np.sin(2 * np.pi * harmonic * time / seconds + rng.uniform(0, 2 * np.pi)) / harmonic
+                 for harmonic in range(1, 5))
+    return floor + (1 - floor) * (values - values.min()) / (values.max() - values.min())
+
+
+def gale(seconds, seed, sharper):
+    rng = np.random.default_rng(seed)
+    count = seconds * RATE
+    roar = texture(rng, count, 75, 1000)
+    cutting_air = texture(rng, count, 700 if sharper else 500, 7300 if sharper else 6200)
+    hz = np.fft.rfftfreq(count, 1 / RATE)
+    howl = np.fft.rfft(rng.standard_normal(count))
+    howl *= np.exp(-((hz - (800 if sharper else 620)) / 95) ** 2) + 0.60 * np.exp(-((hz - 1850) / 190) ** 2)
+    howl = np.fft.irfft(howl, n=count)
+    howl /= np.sqrt(np.mean(howl ** 2))
+    values = (roar * 0.42 * envelope(rng, count, seconds, 0.85)
+              + cutting_air * 0.58 * envelope(rng, count, seconds, 0.82)
+              + howl * 0.20 * envelope(rng, count, seconds, 0.70))
+    values -= values.mean()
+    values *= min(10 ** (-23 / 20) / np.sqrt(np.mean(values ** 2)), 10 ** (-7 / 20) / np.max(np.abs(values)))
+    pcm = np.round(values * 32767).astype("<i2")
+    # All spectra/envelopes are periodic. Choose a zero-step PCM seam with local
+    # energy matching its neighbors; never fade the bed out at loop boundaries.
+    candidates = np.flatnonzero((pcm == np.roll(pcm, -1)) & (np.abs(values) < 0.004))
+    size = round(0.05 * RATE)
+    seam = None
+    for candidate in candidates:
+        origin = int(candidate) + 1
+        join = values[(origin + np.arange(-size // 2, size // 2)) % count]
+        neighbors = values[(origin + np.r_[np.arange(-2 * size, -size), np.arange(size, 2 * size)]) % count]
+        ratio = np.sqrt(np.mean(join ** 2)) / np.sqrt(np.mean(neighbors ** 2))
+        if 0.9 < ratio < 1.1:
+            seam = origin
+            break
+    if seam is None: raise ValueError("No continuous winter-gale seam")
+    return np.roll(pcm, -seam)
+
+
+def main():
+    BANK.mkdir(parents=True, exist_ok=True)
+    clips = []
+    for filename, seconds, seed, sharper in [("winter_gale_a.wav", 30, 2026101101, False),
+                                             ("winter_gale_b.wav", 34, 2026101102, True)]:
+        pcm = gale(seconds, seed, sharper)
+        path = BANK / filename
+        with wave.open(str(path), "wb") as wav:
+            wav.setnchannels(1)
+            wav.setsampwidth(2)
+            wav.setframerate(RATE)
+            wav.writeframes(pcm.tobytes())
+        values = pcm.astype(np.float64) / 32768
+        clips.append(dict(filename=filename, seconds=seconds, rate=RATE, channels=1, seed=seed,
+                          sha256=hashlib.sha256(path.read_bytes()).hexdigest(), bytes=path.stat().st_size,
+                          peak_dbfs=float(20 * np.log10(np.max(np.abs(values)))),
+                          rms_dbfs=float(20 * np.log10(np.sqrt(np.mean(values ** 2)))), seam_step=0.0))
+    manifest = dict(author="Beat my track original offline sound design", origin="Original filtered noise; no third-party recording or AI service",
+                    design="Low gale roar, broad cutting air and noisy whistling resonances; bounded slow periodic envelopes; level-matched long loops and zero-step energy-balanced seams. Mono44.1kHz16-bit PCM; no cyclic silence fades.",
+                    clips=clips, total_bytes=sum(item["bytes"] for item in clips))
+    (BANK / "winter_wind_manifest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(manifest, indent=2))
+
+
+if __name__ == "__main__": main()
