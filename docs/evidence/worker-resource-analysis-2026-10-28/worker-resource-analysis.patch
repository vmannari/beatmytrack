+"""Cold/warm controller comparison on the image's synthetic acceptance oval."""
+import hashlib
+import json
+import resource
+import time
+from pathlib import Path
+
+from bmt_backend.config import Settings
+from bmt_backend.test_driver_generator import generate
+
+fixture=json.loads(Path('/opt/bmt/acceptance/verified_oval.json').read_text())
+settings=Settings(environment='test',godot_bin='/usr/local/bin/godot',game_project='/opt/bmt/game',object_dir='/tmp/probe-cache/objects')
+traits={'version':'test-driver-1','seed':1,'skill':.5,'consistency':1.,'aggression':.5,'learning':.5,'strengths':{}}
+rows=[];results=[]
+for label in ('cold','warm'):
+    start=time.monotonic();cpu=time.process_time();child=resource.getrusage(resource.RUSAGE_CHILDREN)
+    result=generate(settings,fixture['document'],'compact',traits)
+    after=resource.getrusage(resource.RUSAGE_CHILDREN);results.append(result)
+    rows.append({'phase':label,'wall_seconds':time.monotonic()-start,'python_cpu_seconds':time.process_time()-cpu,
+        'child_cpu_seconds':after.ru_utime+after.ru_stime-child.ru_utime-child.ru_stime,'diagnostics':result['diagnostics'],
+        'time_ticks':result['time_ticks'],'input_count':result['replay']['input_count']})
+same=results[0]['replay']==results[1]['replay'] and results[0]['manifest']==results[1]['manifest'] and results[0]['time_ticks']==results[1]['time_ticks']
+assert same,'Cold/warm controller evidence must remain exactly equal'
+cache=list(Path('/tmp/probe-cache/driver-trajectories').glob('*.json'))
+payload={'scope':'Exact deployed image, synthetic short oval, one CPU, network disabled. Timing is local and not a live-track forecast.',
+    'measurements':rows,'exact_replay_manifest_and_ticks_equal':same,'cache_files':len(cache),'cache_bytes':sum(p.stat().st_size for p in cache)}
+Path('/results/cold-warm-generation.json').write_text(json.dumps(payload,indent=2))
+print(json.dumps(payload))
