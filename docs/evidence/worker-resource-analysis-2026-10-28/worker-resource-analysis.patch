+"""Reduce worker diagnostics to fixed failure categories and aggregate durations."""
+import importlib.util
+import json
+import re
+from collections import Counter
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2]
+WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/worker-resource-analysis-2026-10-28'
+spec=importlib.util.spec_from_file_location('cloud',ROOT/'build/studio-usage-deploy-2026-10-27/deploy.py')
