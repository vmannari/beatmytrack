+"""Read the deployed immutable image locally; never overlay current game work."""
+import hashlib
+import io
+import json
+import subprocess
+import tarfile
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2];WORK=Path(__file__).resolve().parent
+cfg=json.loads((ROOT/'.tools/gcp-staging/config.json').read_text(encoding='utf-8-sig'))
+obs=json.loads((ROOT/'docs/evidence/worker-resource-analysis-2026-10-28/live-observations.json').read_text())
+image=next(v['image'] for v in obs['resources'] if v['kind']=='workerPools')
+program="""import sys,tarfile
+from pathlib import Path
+with tarfile.open(fileobj=sys.stdout.buffer,mode='w|') as t:
+ t.add('/app/bmt_backend',arcname='bmt_backend')
+ for p in Path('/opt/bmt/game').rglob('*'):
+  if p.is_file() and (p.suffix=='.gd' or p.name=='project.godot'):t.add(p,arcname='game/'+p.relative_to('/opt/bmt/game').as_posix())
+ t.add('/opt/bmt/acceptance/verified_oval.json',arcname='verified_oval.json')
+"""
+r=subprocess.run([*cfg['docker'],'run','--rm','--pull=never','--network=none','--cpus=1','--memory=256m','--entrypoint=python',image,'-c',program],capture_output=True,check=True,timeout=60)
+dest=WORK/'frozen';dest.mkdir(exist_ok=True)
+with tarfile.open(fileobj=io.BytesIO(r.stdout)) as archive:
+ for v in archive.getmembers():assert (dest/v.name).resolve().is_relative_to(dest.resolve()) and (v.isfile() or v.isdir())
+ archive.extractall(dest)
+hashes={p.relative_to(dest).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in dest.rglob('*') if p.is_file() and '__pycache__' not in p.parts}
+out=ROOT/'docs/evidence/worker-resource-analysis-2026-10-28/frozen-source-hashes.json'
+out.write_text(json.dumps({'image':image,'files':hashes},indent=2))
+print(json.dumps({'image':image,'extracted_files':len(hashes)}))
