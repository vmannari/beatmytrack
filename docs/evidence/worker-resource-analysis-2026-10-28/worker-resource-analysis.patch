+"""Read-only cloud configuration, metric aggregates and sanitized workload log counts."""
+import importlib.util
+import json
+import math
+import time
+from collections import Counter, defaultdict
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime, timezone
+from pathlib import Path
+
+import requests
+
+ROOT=Path(__file__).resolve().parents[2]
+WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/worker-resource-analysis-2026-10-28'
+OUT.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('cloud_helpers',ROOT/'build/studio-usage-deploy-2026-10-27/deploy.py')
+d=importlib.util.module_from_spec(spec);spec.loader.exec_module(d)
+d.WORK=WORK
+token=d.gc('auth','print-access-token',label='read-token')
+at=int(time.time());first=at-21600
+
+
+def call(method,url,**kw):
+    r=requests.request(method,url,headers={'Authorization':'Bearer '+token},verify=str(d.CA),
+        timeout=(5,30),allow_redirects=False,**kw)
+    if not r.ok:
+        return {'read_error':r.status_code,'status':r.json().get('error',{}).get('status')}
+    return r.json()
+
+
+def utc(t):
+    return datetime.fromtimestamp(t,timezone.utc).isoformat()
+
+
+def config(kind,name):
+    value=call('GET',f'https://run.googleapis.com/v2/projects/{d.PROJECT}/locations/{d.REGION}/{kind}/{name}')
+    template=value.get('template',{});container=template.get('containers',[{}])[0]
+    allowed={'BMT_ENVIRONMENT','BMT_DEV_AUTH_ENABLED','BMT_TEST_DRIVERS_ENABLED','BMT_PERSISTENT_VERIFIER',
+        'BMT_VERIFIER_RECYCLE_JOBS','BMT_GODOT_BIN','BMT_GAME_PROJECT','BMT_WORKLOAD_ROLE','BMT_OBJECT_BACKEND',
+        'BMT_OBJECT_PACKING_ENABLED','BMT_DATABASE_POOL_SIZE','BMT_DATABASE_POOL_OVERFLOW'}
+    return {'kind':kind,'name':name,'revision':value.get('latestReadyRevision'),'image':container.get('image'),
+        'command':container.get('command'),'args':container.get('args'),'limits':container.get('resources',{}).get('limits'),
+        'scaling':value.get('scaling'),'safe_environment':{e['name']:e.get('value') for e in container.get('env',[]) if e['name'] in allowed},
+        'read_error':value.get('read_error')}
+
+
+def metric(suffix):
+    metric_type='run.googleapis.com/'+suffix
+    params={'filter':'metric.type="'+metric_type+'" AND resource.labels.location="'+d.REGION+'"',
+        'interval.startTime':utc(first),'interval.endTime':utc(at),'pageSize':1000}
+    rows=[];error=None
+    for _ in range(3):
+        value=call('GET',f'https://monitoring.googleapis.com/v3/projects/{d.PROJECT}/timeSeries',params=params)
+        error=value.get('read_error')
+        rows.extend(value.get('timeSeries',[]))
+        if not value.get('nextPageToken'):break
+        params['pageToken']=value['nextPageToken']
+    else:error='page_limit'
+    return suffix,{'series':rows,'read_error':error}
+
+
+configs=[]
+with ThreadPoolExecutor(max_workers=4) as pool:
+    configs=list(pool.map(lambda item:config(*item),[('services',d.BASE+'-api'),('services',d.BASE+'-studio'),('workerPools',d.BASE+'-worker')]))
+descriptors=call('GET',f'https://monitoring.googleapis.com/v3/projects/{d.PROJECT}/metricDescriptors',params={'filter':'metric.type = starts_with("run.googleapis.com/container/")','pageSize':200})
+safe_descriptors=[{k:v.get(k) for k in ('type','metricKind','valueType','unit','description','labels')} for v in descriptors.get('metricDescriptors',[])]
+metric_names=['container/cpu/utilizations','container/memory/utilizations','container/instance_count','container/billable_instance_time']
+for descriptor in safe_descriptors:
+    kind=descriptor['type']
+    if kind.endswith(('/cpu/usage','/memory/usage','/cpu/allocation_time','/memory/allocation_time')):
+        metric_names.append(kind.removeprefix('run.googleapis.com/'))
+with ThreadPoolExecutor(max_workers=4) as pool:
+    metrics=dict(pool.map(metric,metric_names))
+
+# Logs are reduced in memory to allowlisted event/phase, duration and hourly
+# counts. No player/run/track/group identifiers or raw messages are exported.
+log_counts=Counter();severity=Counter();hours=defaultdict(Counter);durations=defaultdict(list)
+log_filter='resource.type="cloud_run_worker_pool" AND resource.labels.worker_pool_name="'+d.BASE+'-worker" AND timestamp>="'+utc(first)+'" AND timestamp<"'+utc(at)+'"'
