+ return r.stdout
+
+
+envfile=WORK/'profile.private.env';pgenv=WORK/'pg.private.env'
+envfile.write_text('BMT_ENVIRONMENT=test\nBMT_DATABASE_URL=postgresql+psycopg://postgres:'+password+'@'+pg+':5432/profile\nBMT_WORKLOAD_ROLE=worker\nBMT_TELEMETRY_ENABLED=true\nBMT_TEST_DRIVERS_ENABLED=false\nBMT_OBJECT_BACKEND=local\nBMT_OBJECT_DIR=/tmp/objects\nBMT_DATABASE_POOL_SIZE=2\nBMT_DATABASE_POOL_OVERFLOW=0\nBMT_PERSISTENT_VERIFIER=true\n',encoding='utf-8')
+pgenv.write_text('POSTGRES_PASSWORD='+password+'\nPOSTGRES_DB=profile\n',encoding='utf-8')
+pg_created=False;profile_created=False
+call(['network','create','--internal','--label','bmt.cpu-mem='+label,network])
+try:
+ call(['run','-d','--rm','--pull=never','--name',pg,'--network',network,'--label','bmt.cpu-mem='+label,
+       '--cpus=1','--memory=768m','--env-file',unix(pgenv),'--tmpfs','/var/lib/postgresql/data:rw,size=512m','postgres:17-bookworm']);pg_created=True
+ for _ in range(60):
+  r=subprocess.run([*docker,'exec',pg,'pg_isready','-U','postgres'],capture_output=True,check=False,timeout=10)
+  if r.returncode==0:break
+  time.sleep(.25)
+ else:raise RuntimeError('Synthetic PostgreSQL did not become ready')
+ call(['run','-d','--name',profile,'--pull=never','--network',network,'--label','bmt.cpu-mem='+label,
+       '--cpus=1','--memory=1536m','--pids-limit=256','--env-file',unix(envfile),
+       '--mount','type=bind,src='+unix(WORK/'container_profile.py')+',dst=/analysis/container_profile.py,readonly',
+       '--mount','type=bind,src='+unix(OUT)+',dst=/results','--entrypoint','python',image,'/analysis/container_profile.py']);profile_created=True
