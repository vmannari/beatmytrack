+"""Task-only analysis checkpoint; no shipping-source or main-index mutation."""
+import ast
+import hashlib
+import json
+import secrets
+import shutil
+import subprocess
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2]
+WORK=Path(__file__).resolve().parent
+OUT=ROOT/'docs/evidence/worker-resource-analysis-2026-10-28'
+SCOPE=WORK/('checkpoint-'+secrets.token_hex(4));BEFORE=SCOPE/'before';AFTER=SCOPE/'after'
+BEFORE.mkdir(parents=True);AFTER.mkdir()
+SHARED=['AGENTS.md','DEVELOPMENT_STATUS.md','docs/PHASE_0_PLAN.md']
+SOURCES=[p.relative_to(ROOT).as_posix() for p in WORK.glob('*.py')]+['docs/WORKER_RESOURCE_ANALYSIS_2026_10_28.md']
+for name in SOURCES:
+    if name.endswith('.py'):ast.parse((ROOT/name).read_text(encoding='utf-8'))
+(OUT/'analysis-source-hashes.json').write_text(json.dumps({n:hashlib.sha256((ROOT/n).read_bytes()).hexdigest() for n in SOURCES},indent=2))
+for name in SHARED:
+    current=(ROOT/name).read_bytes();start=current.index(b'<!-- WORKER-RESOURCE-ANALYSIS-20261028 -->')
+    end=current.index(b'<!-- /WORKER-RESOURCE-ANALYSIS-20261028 -->')+len(b'<!-- /WORKER-RESOURCE-ANALYSIS-20261028 -->')
+    while current[end:end+1] in (b'\n',b'\r'):end+=1
+    target=BEFORE/name;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(current[:start]+current[end:])
+
+
+def refresh():
+    names=SOURCES+SHARED+[p.relative_to(ROOT).as_posix() for p in OUT.iterdir() if p.is_file() and p.name!='worker-resource-analysis.patch']
+    for name in names:
+        p=AFTER/name;p.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(ROOT/name,p)
+    result=subprocess.run(['git','-c','core.quotePath=false','diff','--no-index','--binary','--src-prefix=a/','--dst-prefix=b/','before','after'],cwd=SCOPE,capture_output=True,check=False)
+    assert result.returncode==1,result.stderr
+    value=result.stdout
+    for side in (b'a/',b'b/'):
+        for folder in (b'before/',b'after/'):value=value.replace(side+folder,side)
+    (OUT/'worker-resource-analysis.patch').write_bytes(value)
+
+
+def hashes(folder):
+    return {p.relative_to(folder).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in folder.rglob('*') if p.is_file()}
+
+
+def verify(index):
+    target=SCOPE/('check'+str(index));shutil.copytree(BEFORE,target)
+    patch=str(OUT/'worker-resource-analysis.patch')
+    for flags in (['--check'],[]):
+        r=subprocess.run(['git','apply',*flags,'--whitespace=nowarn','--directory='+target.relative_to(ROOT).as_posix(),patch],cwd=ROOT,capture_output=True,check=False)
+        assert r.returncode==0,r.stderr.decode('utf-8','replace')
+    assert hashes(target)==hashes(AFTER)
+    r=subprocess.run(['git','apply','--reverse','--check','--whitespace=nowarn',patch],cwd=ROOT,capture_output=True,check=False)
+    assert r.returncode==0,r.stderr.decode('utf-8','replace')
+
+
+refresh();verify(1)
+report=json.loads((OUT/'report.json').read_text());report['checkpoint_verified']=True
+(OUT/'report.json').write_text(json.dumps(report,indent=2)+'\n',encoding='utf-8')
+(OUT/'checkpoint-checks.json').write_text(json.dumps({'forward_check':True,'exact_forward_application':True,'reverse_check_current_workspace':True,
+    'shipping_sources_included':False,'main_index_touched':False,'concurrent_shared_text_preserved':True,
+    'scope':'New read-only diagnostic sources, aggregate/native-profile evidence, report and this task marker only'},indent=2))
+refresh();verify(2)
+print(json.dumps({'checkpoint_verified':True,'scoped_files':len(hashes(AFTER)),
+    'patch_bytes':(OUT/'worker-resource-analysis.patch').stat().st_size,'shipping_source_changes':0,'main_index_touched':False}))
