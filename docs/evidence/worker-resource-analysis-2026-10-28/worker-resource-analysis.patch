@@ -0,0 +1,139 @@
+"""Process/PSS accounting of the exact image on a disposable empty database."""
+import json
+import os
+import signal
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+HZ=os.sysconf('SC_CLK_TCK')
+
+
+def processes():
+    result=[]
+    for p in Path('/proc').iterdir():
+        if not p.name.isdigit():continue
+        try:
+            command=(p/'cmdline').read_bytes().replace(b'\0',b' ').decode('utf-8','replace')
+            stat=(p/'stat').read_text().rsplit(')',1)[1].split()
+            if 'bmt_backend.service_worker' in command:role='supervisor'
+            elif 'bmt_backend.publication_worker' in command:role='publication_python'
+            elif 'bmt_backend.discovery_worker' in command:role='discovery_python'
+            elif 'bmt_backend.product_worker' in command:role='telemetry_python'
+            elif 'bmt_backend.worker' in command:role='race_python'
+            elif 'generate_test_driver.gd' in command:role='godot_test_driver'
+            elif 'backend/runner.gd' in command:role='godot_persistent_verifier'
+            elif 'generator_wrapper.py' in command:role='diagnostic_generator_wrapper'
+            elif 'container_profile.py' in command:role='diagnostic_sampler'
+            else:continue
+            memory={}
+            for line in (p/'smaps_rollup').read_text().splitlines():
+                parts=line.split()
+                if parts[0] in ('Pss:','Rss:','Private_Dirty:','Private_Clean:','Shared_Clean:'):
+                    memory[parts[0][:-1]]=int(parts[1])*1024
+            result.append({'pid':int(p.name),'ppid':int(stat[1]),'role':role,'cpu_seconds':(int(stat[11])+int(stat[12]))/HZ,
+                'threads':int(stat[17]),'memory':memory})
+        except (OSError,ValueError,IndexError):continue
+    return result
+
+
+def cgroup():
+    result={}
+    for name in ('memory.current','memory.stat','memory.events','cpu.stat'):
+        path=Path('/sys/fs/cgroup')/name
+        if not path.exists():continue
+        value=path.read_text()
+        result[name]=int(value) if name.endswith('current') else {k:int(v) for k,v in (line.split() for line in value.splitlines())}
+    return result
+
+
+def sample():return {'at':time.monotonic(),'processes':processes(),'cgroup':cgroup()}
+
+
+def summarize(label,values):
+    first,last=values[0],values[-1];elapsed=last['at']-first['at'];initial={r['pid']:r for r in first['processes']}
+    roles={}
+    for row in last['processes']:
+        item=roles.setdefault(row['role'],{'processes':0,'rss_bytes':0,'pss_bytes':0,'cpu_seconds':0,'threads':0})
+        item['processes']+=1;item['rss_bytes']+=row['memory'].get('Rss',0);item['pss_bytes']+=row['memory'].get('Pss',0);item['threads']+=row['threads']
+        if row['pid'] in initial:item['cpu_seconds']+=max(0,row['cpu_seconds']-initial[row['pid']]['cpu_seconds'])
+    for row in roles.values():row['cpu_percent_one_core']=row['cpu_seconds']/elapsed*100 if elapsed else None
+    return {'phase':label,'elapsed_seconds':elapsed,'roles':roles,'last_cgroup':last['cgroup'],
+        'max_cgroup_memory_bytes':max(v['cgroup'].get('memory.current',0) for v in values),'samples':len(values)}
+
+
+def main():
+    # This database is a newly owned synthetic PostgreSQL instance on an
+    # internal Docker network; no cloud settings/credentials enter the container.
+    from bmt_backend.db import make_engine
+    from bmt_backend.migrate import upgrade
+    engine=make_engine(os.environ['BMT_DATABASE_URL']);upgrade(engine);engine.dispose()
+    out=Path('/results');phases=[];raw=[]
+    with Path('/tmp/service.log').open('w') as log:
+        service=subprocess.Popen([sys.executable,'-m','bmt_backend.service_worker'],stdout=log,stderr=log,start_new_session=True)
+        generator=None
+        try:
+            time.sleep(20)
+            start=time.monotonic();points=[]
+            while time.monotonic()-start<15:
+                assert service.poll() is None,'Synthetic idle service stopped'
+                points.append(sample());time.sleep(1)
+            phases.append(summarize('empty_database_idle',points));raw+=points
+            wrapper=Path('/tmp/generator_wrapper.py')
+            wrapper.write_text('''import json,os,time
+from pathlib import Path
+from bmt_backend.config import Settings
+from bmt_backend.test_driver_generator import generate
+fixture=json.loads(Path('/opt/bmt/acceptance/verified_oval.json').read_text())
+settings=Settings(environment='test',workload_role='worker',godot_bin='/usr/local/bin/godot',game_project='/opt/bmt/game',object_dir='/tmp/driver-cache/objects')
+traits={'version':'test-driver-1','seed':1,'skill':.5,'consistency':1.,'aggression':.5,'learning':.5,'strengths':{}}
+started=time.monotonic()
+try:
+ result=generate(settings,fixture['document'],'compact',traits)
+ value={'status':'completed','elapsed_seconds':time.monotonic()-started,'diagnostics':result.get('diagnostics'),'input_count':result.get('replay',{}).get('input_count')}
+except Exception as e:value={'status':'failed','elapsed_seconds':time.monotonic()-started,'exception_type':type(e).__name__}
+Path('/results/generator-outcome.json').write_text(json.dumps(value,indent=2))
+''')
+            with Path('/tmp/generator.log').open('w') as genlog:
+                generator=subprocess.Popen([sys.executable,str(wrapper)],stdout=genlog,stderr=genlog,start_new_session=True)
+                time.sleep(5)
+                start=time.monotonic();points=[]
+                while time.monotonic()-start<60 and generator.poll() is None:
+                    assert service.poll() is None,'Synthetic service stopped during generation'
+                    points.append(sample());time.sleep(1)
+                if len(points)>1:phases.append(summarize('same_service_plus_synthetic_compact_generation',points))
+                raw+=points
+                # Keep the long operation running for a bounded independent
+                # completion measurement while reporting intermediate samples.
+                (out/'local-process-profile.json').write_text(json.dumps({'phases':phases,'scope':'Exact deployed image; empty synthetic database; same four shipping roles; one CPU; 1536MiB diagnostic ceiling; wrapper/sampler overhead listed separately; local measurements are not remote process measurements'},indent=2))
+                print(json.dumps({'intermediate_phases':phases}),flush=True)
+                deadline=time.monotonic()+430
+                while generator.poll() is None and time.monotonic()<deadline:
+                    time.sleep(2)
+                if generator.poll() is None:raise RuntimeError('Bounded controller measurement exceeded expected timeout')
+            time.sleep(3)
+            start=time.monotonic();points=[]
+            while time.monotonic()-start<10:
+                points.append(sample());time.sleep(1)
+            phases.append(summarize('after_generator_exit',points));raw+=points
+            (out/'local-process-profile.json').write_text(json.dumps({'phases':phases,'scope':'Exact deployed image; empty synthetic database; one CPU; 1536MiB diagnostic ceiling; wrapper/sampler overhead separate; not a live per-process measurement'},indent=2))
+            (out/'local-samples.json').write_text(json.dumps(raw,indent=2))
+            print(json.dumps({'phases':phases,'generator_outcome':json.loads((out/'generator-outcome.json').read_text())}),flush=True)
+        finally:
+            if generator is not None and generator.poll() is None:
+                os.killpg(generator.pid,signal.SIGKILL);generator.wait()
+            if service.poll() is None:
+                service.send_signal(signal.SIGTERM)
+                try:service.wait(timeout=12)
+                except subprocess.TimeoutExpired:os.killpg(service.pid,signal.SIGKILL);service.wait()
+            # Export only fixed event/error category counts from this synthetic
+            # fixture; full logs stay inside its disposable filesystem.
+            text=Path('/tmp/service.log').read_text()
+            (out/'local-service-health.json').write_text(json.dumps({'service_exit_code':service.returncode,
+                'worker_iteration_failed':text.count('worker_iteration_failed'),'service_child_exited':text.count('service_child_exited'),
+                'discovery_projection_failed':text.count('discovery_projection_failed'),'syntax_errors':text.count('SyntaxError')},indent=2))
+
+
+if __name__=='__main__':main()
