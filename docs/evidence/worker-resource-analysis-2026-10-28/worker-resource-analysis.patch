+for _ in range(8):
+    data=call('POST','https://logging.googleapis.com/v2/entries:list',json=params)
+    if data.get('read_error'):break
+    for entry in data.get('entries',[]):
+        log_entries+=1;severity[entry.get('severity','DEFAULT')]+=1
+        payload=entry.get('jsonPayload',{})
+        event=payload.get('event') or payload.get('message') or ''
+        if event not in allowed_events:event='other_structured_event' if payload else 'unstructured_or_platform'
+        log_counts[event]+=1;hours[entry.get('timestamp','')[:13]][event]+=1
+        for key in ('generation_seconds','verification_seconds','queue_wait_seconds','shutdown_seconds'):
+            value=payload.get(key)
+            if isinstance(value,(int,float)) and math.isfinite(value) and value>=0:durations[key].append(value)
+    if not data.get('nextPageToken'):complete=True;break
+    params['pageToken']=data['nextPageToken']
+
+result={'captured_at':at,'since':first,'until':at,'project':d.PROJECT,'scope':'Read-only resource configuration/Monitoring; bounded logs aggregated in memory; no raw private records exported',
+    'resources':configs,'metric_descriptors':safe_descriptors,'descriptor_listing_complete':not bool(descriptors.get('nextPageToken')),
+    'metrics':metrics,'logs':{'entries':log_entries,'complete':complete,'counts':dict(log_counts),'severities':dict(severity),
+    'hourly':{k:dict(v) for k,v in hours.items()},'durations':{k:{'count':len(v),'sum':sum(v),'min':min(v),'max':max(v)} for k,v in durations.items()}}}
+(OUT/'live-observations.json').write_text(json.dumps(result,indent=2),encoding='utf-8')
+print(json.dumps({'captured_at':at,'resources':configs,'metric_series':{k:len(v['series']) for k,v in metrics.items()},'logs':result['logs']}))
