+ started=time.monotonic()
+ while time.monotonic()-started<600:
+  details=json.loads(call(['inspect',profile]))[0]
+  if not details['State']['Running']:
+   output=call(['logs',profile]);(OUT/'local-profile-console.log').write_text(output,encoding='utf-8')
+   assert details['State']['ExitCode']==0 and not details['State'].get('OOMKilled'),'Local diagnostic failed; inspect owned fixture logs'
+   print(output[-4500:],flush=True);break
+  if (OUT/'local-process-profile.json').exists() and not (WORK/'intermediate-notified').exists():
+   (WORK/'intermediate-notified').touch();print('Intermediate idle and generation process accounting is available.',flush=True)
+  time.sleep(3)
+ else:raise RuntimeError('Owned profile exceeded 600-second diagnostic bound')
+finally:
+ for name,created in ((profile,profile_created),(pg,pg_created)):
