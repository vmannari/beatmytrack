{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal native surface-grid-v2 track",
  "description": "Trusted authored fixtures, not a public UGC format. Rectangles are grid-cell coordinates; route/spawn/checkpoints/finish are metres. Origin is top-left; grid rows increase towards simulation -Y. 0 asphalt, 1 grass, 2 dirt, 3 deep water, 4 solid, 5 curb, 6 ford, 7 drive-through rough; deck -1 is absent.",
  "type": "object",
  "required": ["schema", "identity", "version", "cell_size", "grid_size", "origin", "surfaces", "deck", "bridges", "spawn", "spawn_heading", "finish", "route", "checkpoints"],
  "properties": {
    "schema": {"const": "surface-grid-v2"},
    "identity": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "cell_size": {"type": "number", "exclusiveMinimum": 0},
    "grid_size": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
    "origin": {"$ref": "#/$defs/point"},
    "spawn": {"$ref": "#/$defs/point"},
    "spawn_heading": {"type": "number"},
    "surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rectangle"}},
    "deck": {"type": "array", "items": {"$ref": "#/$defs/rectangle"}},
    "route": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point"}},
    "checkpoints": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}},
    "bridges": {"type": "array", "maxItems": 1, "items": {"type": "object", "required": ["axis", "height"], "properties": {"axis": {"$ref": "#/$defs/point"}, "height": {"type": "number", "exclusiveMinimum": 0}}}},
    "finish": {"type": "object", "required": ["center", "heading", "half_width"], "properties": {"center": {"$ref": "#/$defs/point"}, "heading": {"type": "number"}, "half_width": {"type": "number", "exclusiveMinimum": 0}}},
    "debug": {"type": "object", "description": "Optional development provenance overlay, ignored by simulation."},
    "provenance": {"type": "object"},
    "corrections": {"type": "object"}
  },
  "$defs": {
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "rectangle": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": -1, "maximum": 7}], "minItems": 5, "maxItems": 5}
  }
}
