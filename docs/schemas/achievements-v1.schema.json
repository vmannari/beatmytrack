{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beatmytrack.invalid/schemas/achievements-v1.schema.json",
  "title": "Permanent achievement collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "states",
    "rarity",
    "tracking"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "tracking": {
      "const": "since_launch"
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "race": {
          "$ref": "#/$defs/state"
        },
        "creator": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "rarity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "minimum",
        "definition",
        "unlocks"
      ],
      "properties": {
        "eligible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimum": {
          "const": 100
        },
        "definition": {
          "type": "string",
          "maxLength": 256
        },
        "unlocks": {
          "type": "object",
          "maxProperties": 122,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "unlocked",
        "featured",
        "revision"
      ],
      "properties": {
        "metrics": {
          "type": "object",
          "maxProperties": 80,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "unlocked": {
          "type": "object",
          "maxProperties": 122,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "featured": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "races",
              "distance",
              "clean",
              "race_pb",
              "lap_pb",
              "precision",
              "tracks",
              "fleet",
              "biomes",
              "race_pine",
              "clean_pine",
              "race_desert",
              "clean_desert",
              "race_winter",
              "clean_winter",
              "race_storm",
              "clean_storm",
              "race_night_city",
              "clean_night_city",
              "rivalry_wins",
              "rivalry_podiums",
              "rivalry_weeks",
              "challenge_wins",
              "friends",
              "publications",
              "creator_plays",
              "creator_reach",
              "pb_streak",
              "untouchable",
              "perfectionist",
              "king",
              "odds",
              "seasons",
              "comeback",
              "legend",
              "unbeaten",
              "full_grid",
              "scholar"
            ]
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
