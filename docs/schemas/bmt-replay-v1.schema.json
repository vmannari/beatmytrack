{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bmt-replay-v1",
  "title": "Quantized replay with rules-v18 launch marker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "frames"
  ],
  "properties": {
    "schema": {
      "const": "bmt-replay-v1"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 216000,
      "prefixItems": [
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -127,
              "maximum": 127
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "enum": [
                1,
                2
              ]
            }
          ],
          "items": false
        }
      ],
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 4,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": -127,
            "maximum": 127
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        ],
        "items": false
      }
    }
  }
}
