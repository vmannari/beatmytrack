{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Native built-in track catalog",
  "type":"object",
  "required":["schema","entries","failures","archives"],
  "properties":{
    "schema":{"const":"builtin-track-catalog-v1"},
    "entries":{"type":"array","minItems":1,"items":{
      "type":"object","required":["id","name","creator","creator_kind","source_author","theme","path","source_sha256","native_sha256","notes"],
      "properties":{
        "id":{"type":"string","pattern":"^slicks_[a-z0-9_-]+_test$"},
        "name":{"type":"string","minLength":1},
        "creator":{"type":"string","minLength":1},
        "creator_kind":{"enum":["source","fictional"]},
        "source_author":{"type":"string"},
        "theme":{"enum":["pine","coast","desert"]},
        "path":{"type":"string","pattern":"^res://resources/tracks/slicks_[a-z0-9_-]+_test\\.json$"},
        "source_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "native_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "notes":{"type":"array","items":{"type":"string"}}
      }
    }},
    "failures":{"type":"array","maxItems":0},
    "archives":{"type":"array","minItems":1}
  }
}
