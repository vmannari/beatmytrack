{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native built-in track catalog",
  "type": "object",
  "required": [
    "schema",
    "entries",
    "failures",
    "archives"
  ],
  "properties": {
    "schema": {
      "const": "builtin-track-catalog-v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "creator",
          "creator_kind",
          "theme",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "creator": {
            "type": "string",
            "minLength": 1
          },
          "creator_kind": {
            "enum": [
              "original"
            ]
          },
          "source_author": {
            "type": "string"
          },
          "theme": {
            "enum": [
              "pine",
              "coast",
        "night_city",
        "winter",
        "storm",
              "desert"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^res://resources/tracks/[a-z0-9_]+\\.json$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "native_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "maxItems": 0
    },
    "archives": {
      "type": "array"
    }
  }
}
