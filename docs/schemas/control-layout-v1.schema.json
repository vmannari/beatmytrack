{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beat my track control layout v1 (local_records.settings.control_layout)",
  "type": "object",
  "required": [
    "version",
    "steering_type",
    "buttons",
    "horizontal",
    "joystick",
    "accelerator",
    "brake"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "steering_type": {
      "enum": [
        "buttons",
        "horizontal",
        "joystick"
      ]
    },
    "buttons": {
      "$ref": "#/$defs/control"
    },
    "horizontal": {
      "$ref": "#/$defs/control"
    },
    "joystick": {
      "$ref": "#/$defs/control"
    },
    "accelerator": {
      "$ref": "#/$defs/control"
    },
    "brake": {
      "$ref": "#/$defs/control"
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": [
        "x",
        "y",
        "scale",
        "opacity"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.6
        },
        "opacity": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1
        }
      }
    }
  }
}
