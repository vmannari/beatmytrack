{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local creator track v1",
  "description": "At most 16384 UTF-8 bytes. Structure only: TrackDocument.validate additionally proves route length, turn radius and road separation. Coordinates are metres in simulation X/Y. Unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "theme", "width", "surface", "points"],
  "properties": {
    "schema": {"const": "creator-track-v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9_]+$", "not": {"pattern": "^(con|prn|aux|nul|com[1-9]|lpt[1-9])$"}},
    "name": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "theme": {"enum": ["pine", "coast", "desert"]},
    "width": {"type": "number", "minimum": 8, "maximum": 14},
    "surface": {"enum": ["asphalt", "dirt"]},
    "points": {
      "type": "array", "minItems": 4, "maxItems": 24,
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -120, "maximum": 120}}
    }
  }
}
