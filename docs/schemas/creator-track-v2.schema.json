{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local creator track v2",
  "description": "At most 16384 UTF-8 bytes. TrackDocument additionally checks matching per-node arrays, finite values, bounds and centreline crossings. Sharp turns and touching shoulders are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "theme",
    "width",
    "surface",
    "points",
    "widths",
    "corners",
    "objects"
  ],
  "properties": {
    "schema": {
      "const": "creator-track-v2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z0-9_]+$",
      "not": {
        "pattern": "^(con|prn|aux|nul|com[1-9]|lpt[1-9])$"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "theme": {
      "enum": [
        "pine",
        "coast",
        "desert"
      ]
    },
    "width": {
      "type": "number",
      "minimum": 6,
      "maximum": 20
    },
    "surface": {
      "enum": [
        "asphalt",
        "dirt"
      ]
    },
    "points": {
      "type": "array",
      "minItems": 4,
      "maxItems": 24,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": -120,
          "maximum": 120
        }
      }
    },
    "widths": {
      "type": "array",
      "minItems": 4,
      "maxItems": 24,
      "items": {
        "type": "number",
        "minimum": 6,
        "maximum": 20
      }
    },
    "corners": {
      "type": "array",
      "minItems": 4,
      "maxItems": 24,
      "items": {
        "enum": [
          "sharp",
          "smooth"
        ]
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "position",
          "rotation"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tree",
              "rock",
              "barrier",
              "dirt",
              "water"
            ]
          },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -110,
              "maximum": 110
            }
          },
          "rotation": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        }
      }
    },
    "creator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
