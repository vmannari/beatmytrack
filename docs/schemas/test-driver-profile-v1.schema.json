{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bmt:test-driver-profile-v1",
  "title": "Development test driver traits v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "seed", "skill", "consistency", "aggression", "activity", "utc_hour", "learning", "strengths"],
  "properties": {
    "version": {"const": "test-driver-1"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "skill": {"type": "number", "minimum": 0, "maximum": 1},
    "consistency": {"type": "number", "minimum": 0, "maximum": 1},
    "aggression": {"type": "number", "minimum": 0, "maximum": 1},
    "activity": {"type": "number", "minimum": 0, "maximum": 1},
    "learning": {"type": "number", "minimum": 0, "maximum": 1},
    "utc_hour": {"type": "integer", "minimum": 0, "maximum": 23},
    "strengths": {
      "type": "object", "additionalProperties": false,
      "required": ["pine", "winter", "desert", "night_city", "storm"],
      "properties": {
        "pine": {"type": "number", "minimum": -0.07, "maximum": 0.07},
        "winter": {"type": "number", "minimum": -0.07, "maximum": 0.07},
        "desert": {"type": "number", "minimum": -0.07, "maximum": 0.07},
        "night_city": {"type": "number", "minimum": -0.07, "maximum": 0.07},
        "storm": {"type": "number", "minimum": -0.07, "maximum": 0.07}
      }
    }
  }
}
