{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-scoped local draft archive intent (workflow archive.json)",
  "type": "object",
  "required": ["id", "scope", "key", "synced"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9_]+$"},
    "scope": {"type": "string", "minLength": 1},
    "key": {"type": "string", "minLength": 8, "maxLength": 128},
    "synced": {"type": "boolean"}
  }
}
