          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "size": {
          "maximum": 0.95,
          "minimum": 0.2,
          "title": "Size",
          "type": "number"
        },
        "rotation": {
          "maximum": 180,
          "minimum": -180,
          "title": "Rotation",
          "type": "number"
        }
