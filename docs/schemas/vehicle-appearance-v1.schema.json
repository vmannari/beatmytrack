        "hood",
        "aero",
        "rims",
        "body"
      ],
      "title": "Parts",
      "type": "object"
    },
    "Pigments": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "pattern": "^[0-9a-f]{6}$",
          "title": "Body",
          "type": "string"
        },
        "accent": {
          "pattern": "^[0-9a-f]{6}$",
          "title": "Accent",
          "type": "string"
