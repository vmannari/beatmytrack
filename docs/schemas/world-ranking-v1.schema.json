{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bmt:world-ranking-v1",
  "title": "Published World Ranking page or player breakdown",
  "type": "object",
  "required": ["policy", "car", "state", "best_results", "rolling_weeks", "launch_week"],
  "properties": {
    "policy": {"const": "compact-circuit-v1"},
    "car": {"const": "compact"},
    "state": {"enum": ["not_started", "published", "unranked", "country_required"]},
    "best_results": {"const": 12},
    "rolling_weeks": {"const": 26},
    "launch_week": {"type": "integer", "minimum": 0},
    "snapshot_id": {"type": "integer", "minimum": 1},
    "week_start": {"type": "integer", "minimum": 0},
    "field_size": {"type": "integer", "minimum": 0},
    "ranked_count": {"type": "integer", "minimum": 0},
    "scope": {"enum": ["world", "country", "friends", "season"]},
    "next_cursor": {"type": "string", "maxLength": 400},
    "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/standing"}},
    "world_rank": {"type": ["integer", "null"], "minimum": 1},
    "points": {"type": "integer", "minimum": 0, "maximum": 12000},
    "earned": {"type": "integer", "minimum": 0, "maximum": 1000},
    "points_at_risk": {"type": "integer", "minimum": 0, "maximum": 1000},
    "season_points": {"type": "integer", "minimum": 0, "maximum": 6000},
    "results": {"type": "array", "maxItems": 26, "items": {"$ref": "#/$defs/result"}},
    "career": {"type": "object", "maxProperties": 7}
  },
  "oneOf": [
    {"required": ["items", "next_cursor", "scope"]},
    {"required": ["world_rank", "points", "results", "career", "earned", "net_change", "movement", "points_at_risk"]}
  ],
  "$defs": {
    "result": {
      "type": "object", "required": ["week_start", "weekly_place", "points", "counting"],
      "additionalProperties": false,
      "properties": {
        "week_start": {"type": "integer", "minimum": 0},
        "weekly_place": {"type": "integer", "minimum": 1},
        "points": {"type": "integer", "minimum": 0, "maximum": 1000},
        "counting": {"type": "boolean"}
      }
    },
    "standing": {
      "type": "object", "required": ["player_id", "name", "country", "rank", "world_rank", "points", "season_points", "season_rank"],
      "properties": {
        "player_id": {"type": "string", "maxLength": 36},
        "name": {"type": "string", "maxLength": 80},
        "country": {"type": "string", "pattern": "^([A-Z]{2})?$"},
        "rank": {"type": "integer", "minimum": 1},
        "world_rank": {"type": "integer", "minimum": 1},
        "points": {"type": "integer", "minimum": 0, "maximum": 12000},
        "season_points": {"type": "integer", "minimum": 0, "maximum": 6000},
        "season_rank": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
