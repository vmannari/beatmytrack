[configuration]
entry_symbol = "bmt_music_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://music/bin/bmt_music_v4.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://music/bin/bmt_music_v4.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://music/bin/libbmt_music_v4.android.template_debug.arm64.so"
android.release.arm64 = "res://music/bin/libbmt_music_v4.android.template_release.arm64.so"
