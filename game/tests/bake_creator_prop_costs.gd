extends SceneTree
const BATCHES = preload("res://editor/placed_object_batches.gd")
const BYTES = preload("res://editor/cache_bytes.gd")
func _initialize() -> void: run.call_deferred()
func run() -> void:
	var costs: Dictionary = {}
	for theme: String in TrackTheme.IDS:
		for kind: String in CreatorObjects.KINDS:
			var object: Dictionary = {"kind":kind,"position":[0.0,0.0],"rotation":0.0}
			if kind in ObjectRuns.CONTINUOUS: object["length"] = 18.0; object["scale"] = 0.5
			var kit := NativeTrackVisual.new(); kit.theme_id = theme; kit.colors = TrackTheme.palette(theme); kit.editor_preview = true; kit._suppress_night_fx = true
			root.add_child(kit)
			var track := NativeTrack.new(); track.metadata = {"creator_document":{"objects":[object]},"scenery_objects":[]}; track.tyre_origins = LooseTyres.positions(track.metadata.creator_document)
			await kit._build_placed_objects(track)
			var cost: int = BYTES.scene(kit)+1024
			if kind not in CreatorCatalog.SOFT and kind not in ["oil","puddle","jump","speed_bump"]:
				var planner = BATCHES.new(); var model: Dictionary = planner._model(kit,object,kind)
				var retained: int = 1024
				for part: Dictionary in model.parts:
					if part.baked:
						retained += part.arrays[Mesh.ARRAY_VERTEX].size()*192+part.hidden.size()*16
						if part.arrays[Mesh.ARRAY_INDEX] != null: retained += part.arrays[Mesh.ARRAY_INDEX].size()*12
					else: retained += BYTES.mesh(part.mesh)
				cost = maxi(cost,retained)
			costs[theme+"/"+kind] = cost
			kit.free()
		await process_frame
	var out := FileAccess.open("res://editor/creator_prop_costs.gd",FileAccess.WRITE)
	out.store_string("extends RefCounted\n## Generated by tests/bake_creator_prop_costs.gd; maximum continuous span.\n## Conservative live stream estimates, not measured process memory.\nconst BYTES: Dictionary = "+JSON.stringify(costs,"\t",true)+"\n"); out.close()
	print("PROP_COSTS ",costs.size()," grass=",costs["pine/grass_clump"]," tree=",costs["pine/tree"]," castle=",costs["winter/snow_castle"])
	quit()
