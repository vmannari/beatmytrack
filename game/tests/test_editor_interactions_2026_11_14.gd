extends "res://tests/review_editor_interactions_2026_11_14.gd"
## Regression sequences for EUI01-EUI08. Every save is workspace-owned.

func direct_probes() -> void:
	var doc: Dictionary = TrackDocument.create_blank()
	doc.objects = [object(0,0)]
	var c: EditorCanvas = canvas(doc,"place"); c.stamp_kind = "crate"
	tap(c,c.to_screen(Vector2.ZERO))
	check(c.mode == "place" and doc.objects.size() == 1,"EUI04 occupied placement neither changes mode nor duplicates an object")
	tap(c,c.to_screen(Vector2(20,0)))
	check(c.mode == "place" and doc.objects.size() == 2,"EUI04 next empty tap still places")
	check(c.selected_object == -1,"EUI02 placement does not retain an editable object selection")
	c.free()
	doc = TrackDocument.create_blank(); doc.pieces = [road(0),road(8)]
	c = canvas(doc,"road"); c.zoom = 0.35
	tap(c,c.to_screen(Vector2.ZERO))
	check(c.selected_piece == 0,"EUI03 exact road center wins over a later neighbor")
	tap(c,c.to_screen(Vector2(0,8)))
	record("road_selection",{"selected":c.selected_piece,"geometry_drag":c.geometry_drag,"endpoint_drag":c.endpoint_drag,"candidates":c.road_candidates(c.to_screen(Vector2(0,8)))})
	check(c.selected_piece == 1,"EUI03 nearest road wins over the existing selection")
	c.cycle_piece(); check(c.selected_piece == 0,"Layer still reaches the other tolerance candidate")
	c.ghost = RoadPieces.create("curve",Vector2(20,20)); var ghost: Dictionary = c.ghost.duplicate(true)
	c.cycle_piece(); check(c.ghost == ghost,"EUI07 cycling never discards a road preview")
	var handle: Vector2 = c.geometry_controls(c.ghost).width
	touch(c,handle,true)
	check(c.geometry_drag == "width","road preview geometry handles remain editable")
	touch(c,handle,false)
	c.free()
	doc = TrackDocument.create_blank(); doc.pieces = [road(0),road(0)]
	c = canvas(doc,"road"); tap(c,c.to_screen(Vector2.ZERO))
	check(c.selected_piece == 1,"coincident roads retain deterministic topmost selection")
	c.cycle_piece(); check(c.selected_piece == 0,"Layer cycles coincident roads")
	c.free()
	doc = TrackDocument.create_blank(); c = canvas(doc,"paint"); c.paint_mode = "area"
	c.paint_points = [[0.0,0.0],[10.0,0.0],[10.0,10.0]]
	var original_points: Array = c.paint_points.duplicate(true)
	c.notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	check(c.paint_points == original_points,"EUI01 passive focus changes preserve a finished preview")
	from_paint_drag(c,original_points)
	c.free()
	doc = TrackDocument.create_blank(); doc.objects = [object(0.49,0.49)]
	c = canvas(doc,"objects"); var saved: Dictionary = doc.duplicate(true)
	var from: Vector2 = c.to_screen(Vector2(0.49,0.49))
	touch(c,from,true); drag(c,from+Vector2(1,0)); touch(c,from+Vector2(1,0),false)
	check(doc == saved,"EUI05 one-pixel jitter is selection only")
	touch(c,from,true); drag(c,from+Vector2(12,0)); touch(c,from+Vector2(12,0),false)
	var moved := Vector2(doc.objects[0].position[0],doc.objects[0].position[1])
	check(moved.is_equal_approx(Vector2(2.49,0.49)),"EUI05 a deliberate drag snaps its delta and retains the unmoved axis")
	from = c.to_screen(moved); touch(c,from,true); drag(c,from+Vector2(32,0)); c.cancel_gesture()
	check(Vector2(doc.objects[0].position[0],doc.objects[0].position[1]).is_equal_approx(moved),"cancelled deliberate drag restores the object")
	c.free()
	doc = TrackDocument.create_blank(); doc.objects = [object(110,0)]
	c = canvas(doc,"objects"); var edits: Array[int] = [0]
	c.edit_started.connect(func() -> void: edits[0] += 1)
	from = c.to_screen(Vector2(110,0)); touch(c,from,true); drag(c,from+Vector2(32,0)); touch(c,from+Vector2(32,0),false)
	record("boundary_drag",{"position":doc.objects[0].position,"edits":edits[0]})
	check(doc.objects[0].position == [110.0,0.0] and edits[0] == 0,"a drag blocked by the map boundary creates no edit transaction")
	c.free()

func copy_coverage() -> void:
	for language: String in ["en","fr","es","de","pt_BR","ja","ko","nl","it","fi","sv","nb"]:
		var catalogue: Translation = load("res://localization/"+language+".po")
		for source: String in ["Choose Select to edit an existing object.","Choose a paint mode to continue.","Confirm or discard the pending previews before changing tools."]:
			var translated: String = catalogue.get_message(source)
			check(not translated.is_empty(),language+" has the new interaction message")
			check(language == "en" or translated != source,language+" has authored copy rather than English fallback")

func from_paint_drag(c: EditorCanvas, original_points: Array) -> void:
	var at: Vector2 = c.to_screen(Vector2.ZERO)
	touch(c,at,true); drag(c,at+Vector2(24,0))
	c.notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	check(c.paint_points == original_points and c.active_pointer == -99,"passive cancellation rolls back a draft handle without discarding the area")

func app_probes() -> void:
	app = load("res://core/app.tscn").instantiate()
	var storage: String = ProjectSettings.globalize_path("res://../build/editor-interaction-fixes-2026-11-14/storage-"+str(OS.get_process_id()))
	app.library = TrackLibrary.new(storage.path_join("tracks")); app.records = LocalRecords.new(storage.path_join("records.json"))
	app.cloud_root_override = storage.path_join("cloud"); root.add_child(app)
	while not app.startup_complete: await process_frame
	await show_fixture(); await choose_crate()
	await click(app.canvas.to_screen(Vector2(0,14)))
	check(app.canvas.mode == "place" and app.document.objects.size() == 1,"EUI04 actual occupied click preserves placement")
	await click(app.canvas.to_screen(Vector2(30,14)))
	check(app.canvas.mode == "place" and app.document.objects.size() == 2,"EUI04 actual following click places")
	await show_fixture(); await choose_crate(); await click(app.canvas.to_screen(Vector2(30,14)))
	check(app.document.objects.size() == 2,"independent placement-orientation fixture places its object")
	await settle(); var prior: Array = app.document.objects.duplicate(true); var undo_count: int = app.history.size()
	await click_named("ObjectOrientation"); await click_named("Face_90")
	check(app.document.objects == prior and app.canvas.stamp_rotation == 90.0 and app.history.size() == undo_count,"EUI02 placement orientation changes only the next placement")
	await click_named("ObjectControlsBack")
	await click_named("ObjectPlaceMode")
	check((app.root_ui.find_child("ObjectPlaceMode",true,false) as Button).button_pressed and app.document.objects == prior,"reselecting Place keeps its indicator and document unchanged")
	await shot("01-place-mode")
	await click_named("ObjectSelectMode")
	check(app.canvas.mode == "objects","explicit Select switches to object selection")
	await click(app.canvas.to_screen(Vector2(0,14)))
	check(app.canvas.selected_object == 0,"explicit Select can select an existing object")
	await click_named("ObjectSelectMode")
	check(app.canvas.selected_object == 0 and (app.root_ui.find_child("ObjectSelectMode",true,false) as Button).button_pressed,"reselecting Select preserves the selection and indicator")
	await click_named("ObjectOrientation"); await click_named("Face_90")
	check(app.document.objects[0].rotation == 90.0 and app.history.size() == undo_count+1,"selected-object orientation remains an undoable edit")
	app._undo(); await settle()
	check(app.document.objects == prior,"Undo restores only the selected-object rotation")
	await key(KEY_ESCAPE); await key(KEY_DELETE)
	check(app.canvas.mode == "objects" and app.canvas.selected_object == -1 and app.document.objects == prior,"EUI06 Escape clears selection before Delete")
	await click_named("ObjectPlaceMode")
	check(app.canvas.mode == "place","explicit Place resumes the existing asset")
	await key(KEY_ESCAPE); await click(app.canvas.to_screen(Vector2(20,0)))
	check(app.canvas.mode == "objects" and app.document.objects == prior,"EUI06 Escape disarms placement before the next click")
	await shot("02-select-mode")
	await show_fixture(); app._editor_category("paint"); await frames(); await click_named("PaintMode_area")
	for point: Vector2 in [Vector2(10,-6),Vector2(25,-6),Vector2(25,-17)]: await click(app.canvas.to_screen(point))
	var pending: Array = app.canvas.paint_points.duplicate(true)
	check(pending.size() == 3,"area preview has three points")
	await click_named("PaintMode_area")
	check(app.canvas.paint_points == pending and app._has_pending_editor_work(),"EUI01 reselecting Area preserves all preview points")
	await click_text("Map")
	check(app.editor_map_panel.visible and app.canvas.paint_points == pending,"EUI01 opening Map preserves the area")
	await click_text("Map"); await shot("03-area-preserved")
	await key(KEY_TAB)
	check(app.canvas.mode == "paint" and app.canvas.paint_points == pending and app.surface_toolbar.visible,"EUI07 Tab preserves the surface tool and its preview")
	await click_named("PaintMode_line")
	var dialog: ConfirmationDialog = app.root_ui.find_child("PendingPreviewDialog",true,false) as ConfirmationDialog
	check(dialog != null and dialog.visible and app.canvas.paint_points == pending,"changing paint tools resolves an unfinished preview explicitly")
	if dialog != null: dialog.canceled.emit(); await frames()
	check(app.canvas.paint_mode == "area" and app.canvas.paint_points == pending,"Cancel preserves the original paint tool and area")
	await key(KEY_4)
	check(app.canvas.mode == "start_line" and app._has_pending_editor_work(),"start-line shortcut preserves the hidden area preview")
	app._editor_category("paint"); await frames()
	check(app.canvas.paint_points == pending,"returning to Surfaces restores its area after start-line placement")
	await click_named("AreaConfirm"); await settle()
	check(app.document.paint.size() == 1 and app.canvas.paint_points.is_empty(),"preserved area still confirms normally")
	app._undo(); await settle(); check(app.document.paint.is_empty(),"confirmed area is one undoable edit")
	await key(KEY_ESCAPE)
	var before_click: Dictionary = app.document.duplicate(true)
	await click(app.canvas.to_screen(Vector2(10,-6)))
	check(app.canvas.mode == "pan" and app.document == before_click and app.canvas.paint_points.is_empty(),"EUI06 Escape disarms surface authoring")
	await show_fixture(); await choose_crate(); await click_named("ObjectSelectMode")
	var at: Vector2 = app.canvas.to_screen(Vector2(0,14))
	touch(app.canvas,at,true); drag(app.canvas,at+Vector2(40,0))
	check(app.document.objects[0].position != [0.0,14.0],"drag fixture moves before Escape")
	await key(KEY_ESCAPE)
	check(app.document.objects[0].position == [0.0,14.0] and app.history.is_empty() and app.canvas.active_pointer == -99,"EUI06 first Escape rolls back an active drag without saving movement")
	await settle()
	check(app.library.load_wip(app.document.id).objects == app.document.objects,"cancelled drag recovery contains the original object position")
	await show_fixture(); app.canvas.choose_piece("curve"); var preview: Dictionary = app.canvas.ghost.duplicate(true)
	app._editor_category("objects"); app._editor_category("road")
	check(app.canvas.ghost == preview,"category round trip retains pending road geometry")
	check(app.editor_status.is_visible_in_tree() and not app.editor_guidance.is_empty(),"EUI08 normal tool guidance is visible")
	await shot("04-road-guidance")
	for dimensions: Vector2i in [Vector2i(960,540),Vector2i(1280,720)]:
		root.size = dimensions; root.content_scale_size = dimensions; await frames(8)
		check(not app.editor_status.get_global_rect().intersects(app.root_ui.find_child("EditorRailPanel",true,false).get_global_rect()),"guidance stays clear of the rail at "+str(dimensions))
	await settle(); app.queue_free(); await frames(6)
	if is_instance_valid(GameSoundtrack.instance()): GameSoundtrack.instance().queue_free()
	await frames(3); await create_timer(0.25).timeout

func run() -> void:
	out = ProjectSettings.globalize_path("res://../build/editor-interaction-fixes-2026-11-14/default")
	for argument: String in OS.get_cmdline_user_args():
		if argument.begins_with("--review-out="): out = argument.trim_prefix("--review-out=")
	DirAccess.make_dir_recursive_absolute(out)
	OS.set_environment("BMT_API_URL",""); OS.set_environment("BMT_DEV_AUTH_KEY","")
	root.size = Vector2i(1280,720); root.content_scale_size = root.size; root.gui_embed_subwindows = true
	before_hashes = hashes(); copy_coverage(); direct_probes()
	if "--direct-only" not in OS.get_cmdline_user_args(): await app_probes()
	check(hashes() == before_hashes,"production sources stay stable throughout the run")
	var file := FileAccess.open(out.path_join("report.json"),FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":fixture_checks,"failures":fixture_failures,"sources":before_hashes,"renderer":RenderingServer.get_current_rendering_method(),"display":DisplayServer.get_name()},"\t")); file.close()
	print("EDITOR_INTERACTION_FIXES ",fixture_checks," checks / ",fixture_failures," failures")
	quit(0 if fixture_failures == 0 else 1)
