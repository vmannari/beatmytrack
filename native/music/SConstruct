env = SConscript('../../.tools/godot-cpp-music/SConstruct')
env.Append(CPPPATH=['.'], CXXFLAGS=['-std=c++17'] if env['platform'] != 'windows' or env.get('use_mingw') else ['/std:c++17'])
prefix = 'lib' if env['platform'] == 'android' else ''
library = env.SharedLibrary('../../game/music/bin/' + prefix + 'bmt_music_v6' + env['suffix'] + env['SHLIBSUFFIX'], ['extension.cpp'])
Default(library)
